-- A regular-expression engine for the POSIX basic (BRE) and extended (ERE)
-- syntaxes used by grep, sed and expr, with the GNU extensions \w \W \s \S
-- \b \B \< \> and back-references \1..\9. The pattern is compiled to a
-- Pike-style instruction set and executed by a thread-list (Pike VM) matcher
-- that implements leftmost-longest matching the way GNU grep/sed/expr (glibc
-- regex) do: the match starting earliest wins, among those the longest; the
-- subexpression spans are those of the first path, in alternative order, that
-- reaches that match, and an iteration of a repeated group that matches the
-- empty string never overwrites the capture of an earlier iteration.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'

global regex = @record{}

local OP_CHAR: byte <comptime> = 1
local OP_ANY: byte <comptime> = 2
local OP_CLASS: byte <comptime> = 3
local OP_SPLIT: byte <comptime> = 4
local OP_JMP: byte <comptime> = 5
local OP_SAVE: byte <comptime> = 6
local OP_MATCH: byte <comptime> = 7
local OP_BOL: byte <comptime> = 8
local OP_EOL: byte <comptime> = 9
local OP_BACKREF: byte <comptime> = 10
local OP_WORDB: byte <comptime> = 11
local OP_NWORDB: byte <comptime> = 12
local OP_WSTART: byte <comptime> = 13
local OP_WEND: byte <comptime> = 14

global regex.Inst = @record{ op: byte, c: byte, x: integer, y: integer }
global regex.Set = @record{ bits: [32]byte }
global regex.Caps = @record{ at: [20]isize }

-- One VM thread: program counter, progress inside a back-reference being
-- consumed byte by byte, and the captures gathered so far.
-- `dirty`: the path passed an anchor since it last consumed a byte (only
-- tracked under glibc_halt, see compile_posix).
-- `neednl` (glibc_halt only): the path passed a `$` that glibc's matcher
-- accepts because the next byte, a newline, is consumed by the match.
local Thread = @record{ pc: integer, k: isize, caps: regex.Caps, dirty: boolean, neednl: boolean }

global regex.Prog = @record{
  code: sequence(regex.Inst),
  sets: sequence(regex.Set),
  nsub: integer,
  icase: boolean,
  hasref: boolean,      -- program contains a back-reference
  nlanchor: boolean,    -- ^ and $ also match after/before a newline (sed M)
  toocomplex: boolean,  -- last execution exceeded the thread bound
  noteol: boolean,      -- $ does not match at the end of the subject (REG_NOTEOL)
  glibc_halt: boolean,  -- prefer a match whose path ends without passing an anchor
  nlquirk: boolean,     -- glibc's newline contexts inside a match (see addthread)
  -- Executor scratch, allocated on first use and kept for the program's life.
  clist: sequence(Thread),
  nlist: sequence(Thread),
  mark: sequence(integer),   -- per pc: step stamp (dedup without back-references)
  epsvis: sequence(isize),   -- per pc: position of the current epsilon path (back-references)
  tabgen: sequence(int32),   -- hash table over the list being built (back-references)
  tabidx: sequence(int32),
  gen: integer,
}

local Frag = @sequence(regex.Inst)

local function lower(b: byte): byte
  if b >= 65 and b <= 90 then return b + 32 end
  return b
end

local function isword(b: byte): boolean
  return (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95
end

function regex.Set:add(b: byte)
  self.bits[b >> 3] = self.bits[b >> 3] | (1 << (b & 7))
end

function regex.Set:has(b: byte): boolean
  return (self.bits[b >> 3] & (1 << (b & 7))) ~= 0
end

local function set_addrange(s: *regex.Set, lo: integer, hi: integer, icase: boolean)
  for b = lo, hi do
    s:add((@byte)(b))
    if icase then
      if b >= 65 and b <= 90 then s:add((@byte)(b + 32)) end
      if b >= 97 and b <= 122 then s:add((@byte)(b - 32)) end
    end
  end
end

local function set_named(s: *regex.Set, name: string): boolean
  if name == 'alpha' then set_addrange(s, 65, 90, false); set_addrange(s, 97, 122, false)
  elseif name == 'digit' then set_addrange(s, 48, 57, false)
  elseif name == 'alnum' then set_addrange(s, 65, 90, false); set_addrange(s, 97, 122, false); set_addrange(s, 48, 57, false)
  elseif name == 'upper' then set_addrange(s, 65, 90, false)
  elseif name == 'lower' then set_addrange(s, 97, 122, false)
  elseif name == 'space' then set_addrange(s, 9, 13, false); s:add(32)
  elseif name == 'blank' then s:add(9); s:add(32)
  elseif name == 'punct' then
    set_addrange(s, 33, 47, false); set_addrange(s, 58, 64, false)
    set_addrange(s, 91, 96, false); set_addrange(s, 123, 126, false)
  elseif name == 'print' then set_addrange(s, 32, 126, false)
  elseif name == 'graph' then set_addrange(s, 33, 126, false)
  elseif name == 'cntrl' then set_addrange(s, 0, 31, false); s:add(127)
  elseif name == 'xdigit' then set_addrange(s, 48, 57, false); set_addrange(s, 65, 70, false); set_addrange(s, 97, 102, false)
  else return false end
  return true
end

-- Parser state (no closures in Nelua, so everything lives on the record).
local Parser = @record{
  pat: string,
  pos: usize,       -- 1-based index of the next byte
  ere: boolean,
  icase: boolean,
  nsub: integer,
  sets: sequence(regex.Set),
  err: string,
  depth: integer,
  newline: boolean, -- REG_NEWLINE: '.' and [^...] do not match a newline
  empty_ranges: boolean, -- a range like z-a is empty instead of an error
  glibc_errors: boolean, -- glibc's re_compile_pattern diagnostics (expr)
}

function Parser:peek(): byte
  if self.pos > self.pat.size then return 0 end
  return self.pat:byte(self.pos)
end

function Parser:peek2(): byte
  if self.pos + 1 > self.pat.size then return 0 end
  return self.pat:byte(self.pos + 1)
end

function Parser:more(): boolean return self.pos <= self.pat.size end

local function inst(op: byte, c: byte, x: integer, y: integer): regex.Inst
  return (@regex.Inst){op = op, c = c, x = x, y = y}
end

-- Append src to dst, relocating jump targets.
local function append(dst: *Frag, src: Frag)
  local base = #dst
  for i = 1, #src do
    local ins = src[i]
    if ins.op == OP_SPLIT or ins.op == OP_JMP then
      ins.x = ins.x + base
      if ins.op == OP_SPLIT then ins.y = ins.y + base end
    end
    dst:push(ins)
  end
end

local function frag_copy(src: Frag): Frag
  local out: Frag
  for i = 1, #src do out:push(src[i]) end
  return out
end

-- Repetition builders; targets are 0-based offsets inside the fragment.
local function rep_star(f: Frag): Frag
  local out: Frag
  out:push(inst(OP_SPLIT, 0, 1, #f + 2))
  append(&out, f)
  out:push(inst(OP_JMP, 0, 0, 0))
  return out
end

local function rep_quest(f: Frag): Frag
  local out: Frag
  out:push(inst(OP_SPLIT, 0, 1, #f + 1))
  append(&out, f)
  return out
end

local function rep_plus(f: Frag): Frag
  local out: Frag
  append(&out, f)
  out:push(inst(OP_SPLIT, 0, 0, #f + 1))
  return out
end

local function rep_count(f: Frag, lo: integer, hi: integer): Frag
  -- hi < 0 means unbounded
  local out: Frag
  for _ = 1, lo do append(&out, f) end
  if hi < 0 then
    append(&out, rep_star(f))
  else
    -- nested optionals: (f(f(f)?)?)?
    local tail: Frag
    for _ = lo + 1, hi do
      local inner: Frag
      append(&inner, f)
      append(&inner, tail)
      tail = rep_quest(inner)
    end
    append(&out, tail)
  end
  return out
end

-- Is the byte at pos the start of an operator in this syntax?
function Parser:at_alt(): boolean
  if self.ere then return self:peek() == 124 end
  return self:peek() == 92 and self:peek2() == 124
end

function Parser:at_close(): boolean
  if self.ere then return self:peek() == 41 end
  return self:peek() == 92 and self:peek2() == 41
end

-- glibc parse_dup_op/fetch_number for a BRE \{...\}: status 0 ok,
-- 1 REG_BADBR, 2 REG_EBRACE (the pattern ended inside), 3 REG_ESIZE (over
-- RE_DUP_MAX). "\{,n\}" is "\{0,n\}".
local RE_DUP_MAX: integer <comptime> = 0x7fff
function Parser:parse_interval_glibc(): (integer, integer, integer)
  -- fetch_number: digits up to "\}" or ','; -1 missing, -2 error
  local function fetch(p: *Parser): (integer, integer)
    local num: integer = -1
    while true do
      if not p:more() then return -2, 0 end
      local c = p:peek()
      if c == 92 and p:peek2() == 125 then p.pos = p.pos + 2; return num, 1 end
      if c == 44 then p.pos = p.pos + 1; return num, 2 end
      -- "\," is the character ',' to glibc's tokenizer
      if c == 92 and p:peek2() == 44 then p.pos = p.pos + 2; return num, 2 end
      local tokc = c
      if c == 92 then
        p.pos = p.pos + 1
        if not p:more() then return -2, 0 end
        tokc = 0 -- an escaped character is not a digit token
      end
      p.pos = p.pos + 1
      if tokc < 48 or tokc > 57 or num == -2 then num = -2
      elseif num == -1 then num = tokc - 48
      else
        num = num * 10 + (tokc - 48)
        if num > RE_DUP_MAX + 1 then num = RE_DUP_MAX + 1 end
      end
    end
    return num, 0
  end
  local start, tok = fetch(self)
  if start == -2 and tok == 0 then return 0, 0, 2 end
  if start == -1 then
    if tok == 2 then start = 0 else return 0, 0, 1 end
  end
  local stop: integer = -2
  if start ~= -2 then
    if tok == 1 then stop = start
    elseif tok == 2 then
      local t2: integer
      stop, t2 = fetch(self)
      if stop == -2 and t2 == 0 then return 0, 0, 2 end
      tok = t2
    end
  end
  if start == -2 or stop == -2 then return 0, 0, 1 end
  if (stop ~= -1 and start > stop) or tok ~= 1 then return 0, 0, 1 end
  if (stop == -1 and start or stop) > RE_DUP_MAX then return 0, 0, 3 end
  return start, stop, 0
end

function Parser:parse_bracket(): Frag
  -- self.pos is just past '['
  local s: regex.Set
  local negate = false
  if self:peek() == 94 then negate = true; self.pos = self.pos + 1 end
  local first = true
  local out: Frag
  if self.glibc_errors and not self:more() then self.err = 'Invalid regular expression'; return out end
  while true do
    if not self:more() then self.err = 'Unmatched [, [^, [:, [., or [='; return out end
    local c = self:peek()
    if c == 93 and not first then self.pos = self.pos + 1; break end
    first = false
    if c == 91 and self:peek2() == 58 then
      -- [:name:]
      local close = self.pat:find(':]', self.pos + 2, true)
      if close <= 0 then self.err = 'Unmatched [, [^, [:, [., or [='; return out end
      local name = self.pat:sub(self.pos + 2, close - 1)
      if not set_named(&s, name) then self.err = 'Invalid character class name'; return out end
      self.pos = (@usize)(close) + 2
      continue
    end
    local lo: integer = c
    self.pos = self.pos + 1
    if self:peek() == 45 and self:peek2() ~= 93 and self:peek2() ~= 0 then
      local hi: integer = self:peek2()
      self.pos = self.pos + 2
      if hi < lo then
        if not self.empty_ranges then self.err = 'Invalid range end'; return out end
      else
        set_addrange(&s, lo, hi, self.icase)
      end
    else
      set_addrange(&s, lo, lo, self.icase)
    end
  end
  if negate then
    for i = 0, 31 do s.bits[i] = ~s.bits[i] end
    -- with REG_NEWLINE (sed's M flag) a negated set does not match newline
    if self.newline then s.bits[10 >> 3] = s.bits[10 >> 3] & ~(1 << (10 & 7)) end
  end
  self.sets:push(s)
  out:push(inst(OP_CLASS, 0, #self.sets, 0))
  return out
end

-- Forward declarations for the mutually recursive parser.
function Parser:parse_concat(): Frag <forwarddecl> end
function Parser:parse_atom(start: boolean): (Frag, boolean) <forwarddecl> end
function Parser:parse_interval(): (integer, integer, boolean) <forwarddecl> end

function Parser:parse_alt(): Frag
  local left = self:parse_concat()
  if self.err.size > 0 then return left end
  while self:at_alt() do
    self.pos = self.pos + (self.ere and 1 or 2)
    local right = self:parse_concat()
    if self.err.size > 0 then return left end
    local out: Frag
    out:push(inst(OP_SPLIT, 0, 1, #left + 2))
    append(&out, left)
    out:push(inst(OP_JMP, 0, #left + #right + 2, 0))
    append(&out, right)
    left = out
  end
  return left
end

function Parser:parse_concat(): Frag
  local out: Frag
  local start = true
  while self:more() and not self:at_alt() and not self:at_close() do
    local atom, ok = self:parse_atom(start)
    if self.err.size > 0 then return out end
    if not ok then break end
    start = false
    -- postfix repetitions
    while self:more() do
      local c = self:peek()
      if c == 42 then
        self.pos = self.pos + 1; atom = rep_star(atom)
      elseif self.ere and c == 43 then
        self.pos = self.pos + 1; atom = rep_plus(atom)
      elseif self.ere and c == 63 then
        self.pos = self.pos + 1; atom = rep_quest(atom)
      elseif not self.ere and c == 92 and self:peek2() == 43 then
        self.pos = self.pos + 2; atom = rep_plus(atom)
      elseif not self.ere and c == 92 and self:peek2() == 63 then
        self.pos = self.pos + 2; atom = rep_quest(atom)
      elseif (self.ere and c == 123) or (not self.ere and c == 92 and self:peek2() == 123) then
        local save = self.pos
        self.pos = self.pos + (self.ere and 1 or 2)
        local lo: integer, hi: integer, ok2: boolean
        if self.glibc_errors and not self.ere then
          local status: integer
          lo, hi, status = self:parse_interval_glibc()
          ok2 = status == 0
          if status == 1 then self.err = 'Invalid content of \\{\\}'; return out
          elseif status == 2 then self.err = 'Unmatched \\{'; return out
          elseif status == 3 then self.err = 'Regular expression too big'; return out end
        else
          lo, hi, ok2 = self:parse_interval()
        end
        if not ok2 then
          if self.ere then self.pos = save; break end
          if #self.err == 0 then self.err = 'Invalid content of \\{\\}' end
          return out
        end
        atom = rep_count(atom, lo, hi)
      else
        break
      end
    end
    append(&out, atom)
  end
  return out
end

function Parser:parse_interval(): (integer, integer, boolean)
  local lo: integer = -1
  local hi: integer = -1
  local n: integer = 0
  local have = false
  while self:more() and self:peek() >= 48 and self:peek() <= 57 do
    n = n * 10 + (self:peek() - 48); self.pos = self.pos + 1; have = true
  end
  if not have then return 0, 0, false end
  lo = n
  if self:peek() == 44 then
    self.pos = self.pos + 1
    n = 0; have = false
    while self:more() and self:peek() >= 48 and self:peek() <= 57 do
      n = n * 10 + (self:peek() - 48); self.pos = self.pos + 1; have = true
    end
    if have then hi = n else hi = -1 end
  else
    hi = lo
  end
  if self.ere then
    if self:peek() ~= 125 then return 0, 0, false end
    self.pos = self.pos + 1
  else
    if self:peek() ~= 92 or self:peek2() ~= 125 then return 0, 0, false end
    self.pos = self.pos + 2
  end
  if hi >= 0 and hi < lo then return 0, 0, false end
  if lo > 255 or hi > 255 then self.err = 'Regular expression too big'; return 0, 0, false end
  return lo, hi, true
end

function Parser:single(c: byte): Frag
  local out: Frag
  if self.icase then c = lower(c) end
  out:push(inst(OP_CHAR, c, 0, 0))
  return out
end

function Parser:class_frag(s: regex.Set): Frag
  local out: Frag
  self.sets:push(s)
  out:push(inst(OP_CLASS, 0, #self.sets, 0))
  return out
end

-- Parse one atom. `start` is true at the beginning of a branch, where BRE
-- treats '*' as a literal and '^' as an anchor.
function Parser:parse_atom(start: boolean): (Frag, boolean)
  local out: Frag
  local c = self:peek()
  if c == 94 then
    -- '^' anchors at the start of a BRE branch; anywhere in ERE
    if self.ere or start then
      self.pos = self.pos + 1
      out:push(inst(OP_BOL, 0, 0, 0))
      return out, true
    end
    self.pos = self.pos + 1
    return self:single(94), true
  elseif c == 36 then
    self.pos = self.pos + 1
    if self.ere or not self:more() or self:at_alt() or self:at_close() then
      out:push(inst(OP_EOL, 0, 0, 0))
      return out, true
    end
    return self:single(36), true
  elseif c == 46 then
    self.pos = self.pos + 1
    if self.newline then
      local s: regex.Set
      for i = 0, 31 do s.bits[i] = 0xff end
      s.bits[10 >> 3] = s.bits[10 >> 3] & ~(1 << (10 & 7))
      return self:class_frag(s), true
    end
    out:push(inst(OP_ANY, 0, 0, 0))
    return out, true
  elseif c == 91 then
    self.pos = self.pos + 1
    return self:parse_bracket(), true
  elseif c == 42 then
    if start and not self.ere then self.pos = self.pos + 1; return self:single(42), true end
    if self.ere then self.pos = self.pos + 1; return self:single(42), true end
    self.err = 'Invalid preceding regular expression'; return out, false
  elseif self.ere and (c == 43 or c == 63) and start then
    self.pos = self.pos + 1
    return self:single(c), true
  elseif self.ere and c == 123 and start then
    self.pos = self.pos + 1
    return self:single(123), true
  elseif (self.ere and c == 40) or (not self.ere and c == 92 and self:peek2() == 40) then
    self.pos = self.pos + (self.ere and 1 or 2)
    local idx: integer = 0
    if self:peek() == 63 and self:peek2() == 58 then
      self.pos = self.pos + 2   -- (?: non-capturing group (internal extension)
    else
      self.nsub = self.nsub + 1
      idx = self.nsub
    end
    self.depth = self.depth + 1
    local inner = self:parse_alt()
    self.depth = self.depth - 1
    if self.err.size > 0 then return out, false end
    if not self:at_close() then self.err = (self.ere or self.glibc_errors) and 'Unmatched ( or \\(' or 'Unmatched \\(' ; return out, false end
    self.pos = self.pos + (self.ere and 1 or 2)
    if idx >= 1 and idx <= 9 then out:push(inst(OP_SAVE, 0, 2 * idx, 0)) end
    append(&out, inner)
    if idx >= 1 and idx <= 9 then out:push(inst(OP_SAVE, 0, 2 * idx + 1, 0)) end
    return out, true
  elseif c == 92 then
    local e = self:peek2()
    if e == 0 then self.err = 'Trailing backslash'; return out, false end
    self.pos = self.pos + 2
    if e == 119 then local s: regex.Set; set_named(&s, 'alnum'); s:add(95); return self:class_frag(s), true end
    if e == 87 then
      local s: regex.Set; set_named(&s, 'alnum'); s:add(95)
      for i = 0, 31 do s.bits[i] = ~s.bits[i] end
      return self:class_frag(s), true
    end
    if e == 115 then local s: regex.Set; set_named(&s, 'space'); return self:class_frag(s), true end
    if e == 83 then
      local s: regex.Set; set_named(&s, 'space')
      for i = 0, 31 do s.bits[i] = ~s.bits[i] end
      return self:class_frag(s), true
    end
    -- GNU \` and \' anchor at the ends of the whole buffer, even with M
    if e == 96 then out:push(inst(OP_BOL, 1, 0, 0)); return out, true end
    if e == 39 then out:push(inst(OP_EOL, 1, 0, 0)); return out, true end
    if e == 98 then out:push(inst(OP_WORDB, 0, 0, 0)); return out, true end
    if e == 66 then out:push(inst(OP_NWORDB, 0, 0, 0)); return out, true end
    if e == 60 then out:push(inst(OP_WSTART, 0, 0, 0)); return out, true end
    if e == 62 then out:push(inst(OP_WEND, 0, 0, 0)); return out, true end
    if e >= 49 and e <= 57 then
      local n = e - 48
      if n > self.nsub then self.err = 'Invalid back reference'; return out, false end
      out:push(inst(OP_BACKREF, 0, n, 0)); return out, true
    end
    if e == 110 then return self:single(10), true end
    if e == 116 then return self:single(9), true end
    return self:single(e), true
  end
  self.pos = self.pos + 1
  return self:single(c), true
end

-- Compile a pattern. Returns the program and an error message ("" on success).
-- `newline` is REG_NEWLINE as GNU sed's M flag sets it ('.' and [^...] skip
-- newline); `nlanchor` makes ^ and $ match at embedded newlines too.
global regex.EMPTY_RANGES: integer <comptime> = 1
global regex.GLIBC_ERRORS: integer <comptime> = 2

-- compile_nl with option bits: EMPTY_RANGES (glibc without
-- RE_NO_EMPTY_RANGES) and GLIBC_ERRORS (re_compile_pattern's messages for
-- a pattern ending after "[" or "[^", unbalanced \{ and \( \)).
function regex.compile_opts(pat: string, ere: boolean, icase: boolean, newline: boolean, nlanchor: boolean,
                            flags: integer): (regex.Prog, string)
  local p: Parser = {pat = pat, pos = 1, ere = ere, icase = icase, newline = newline,
                     empty_ranges = (flags & regex.EMPTY_RANGES) ~= 0, glibc_errors = (flags & regex.GLIBC_ERRORS) ~= 0}
  local prog: regex.Prog
  prog.icase = icase
  prog.nlanchor = nlanchor
  local body = p:parse_alt()
  if p.err.size == 0 and p:more() then
    if p:at_close() then p.err = (ere or p.glibc_errors) and 'Unmatched ) or \\)' or 'Unmatched \\)' else p.err = 'Invalid regular expression' end
  end
  if p.err.size > 0 then return prog, p.err end
  prog.code:push(inst(OP_SAVE, 0, 0, 0))
  append(&prog.code, body)
  prog.code:push(inst(OP_SAVE, 0, 1, 0))
  prog.code:push(inst(OP_MATCH, 0, 0, 0))
  prog.nsub = p.nsub
  prog.sets = p.sets
  for i = 1, #prog.code do
    if prog.code[i].op == OP_BACKREF then prog.hasref = true end
  end
  return prog, ''
end

-- glibc regcomp.c's parser for RE_SYNTAX_POSIX_BASIC / RE_SYNTAX_POSIX_EXTENDED
-- (with RE_NO_EMPTY_RANGES and without RE_DOT_NOT_NULL), as GNU sed builds
-- its syntax: peek_token/fetch_token, parse_reg_exp, parse_branch,
-- parse_expression, parse_sub_exp, parse_dup_op with fetch_number,
-- parse_bracket_exp with C-locale collating symbols and equivalence
-- classes, and glibc's error codes, in glibc's order. It emits the same
-- instructions as the parser above, so matching is unchanged. Options:
-- RPAREN_ORD (RE_UNMATCHED_RIGHT_PAREN_ORD), NO_GNU_OPS (RE_NO_GNU_OPS),
-- LIMITED_OPS (RE_LIMITED_OPS; BRE only in practice).
global regex.RPAREN_ORD: integer <comptime> = 1
global regex.NO_GNU_OPS: integer <comptime> = 2
global regex.LIMITED_OPS: integer <comptime> = 4

local GT_CHAR: byte <comptime> = 1
local GT_END: byte <comptime> = 2
local GT_BACKSLASH: byte <comptime> = 3
local GT_ALT: byte <comptime> = 4
local GT_BACKREF: byte <comptime> = 5
local GT_ANCHOR: byte <comptime> = 6
local GT_WORD: byte <comptime> = 7
local GT_NOTWORD: byte <comptime> = 8
local GT_SPACE: byte <comptime> = 9
local GT_NOTSPACE: byte <comptime> = 10
local GT_OPEN: byte <comptime> = 11
local GT_CLOSE: byte <comptime> = 12
local GT_STAR: byte <comptime> = 13
local GT_PLUS: byte <comptime> = 14
local GT_QUEST: byte <comptime> = 15
local GT_OPEN_DUP: byte <comptime> = 16
local GT_CLOSE_DUP: byte <comptime> = 17
local GT_BRACKET: byte <comptime> = 18
local GT_PERIOD: byte <comptime> = 19
-- bracket tokens
local GT_RANGE: byte <comptime> = 20
local GT_CLOSE_BRACKET: byte <comptime> = 21
local GT_NON_MATCH: byte <comptime> = 22
local GT_OPEN_COLL: byte <comptime> = 23
local GT_OPEN_EQUIV: byte <comptime> = 24
local GT_OPEN_CLASS: byte <comptime> = 25

local GTok = @record{ t: byte, c: byte, op: byte, len: integer }

local GParser = @record{
  pat: string,
  pos: integer,       -- 0-based
  ere: boolean,
  icase: boolean,
  newline: boolean,   -- REG_NEWLINE: '.' and [^...] do not match newline
  rparen_ord: boolean,
  no_gnu_ops: boolean,
  limited_ops: boolean,
  nsub: integer,
  completed: integer,
  sets: sequence(regex.Set),
  err: string,
}

local function g_tr(p: *GParser, c: byte): byte
  if p.icase then return lower(c) end
  return c
end

-- peek_token: the token at p.pos; caret is RE_CARET_ANCHORS_HERE.
local function g_peek_at(p: *GParser, at: integer, caret: boolean): GTok
  local tok: GTok
  local n: integer = (@integer)(p.pat.size)
  if at >= n then tok.t = GT_END; tok.len = 0; return tok end
  local c = g_tr(p, p.pat.data[at])
  tok.c = c
  if c == 92 then
    if at + 1 >= n then tok.t = GT_BACKSLASH; tok.len = 1; return tok end
    local c2 = p.pat.data[at + 1]   -- re_string_peek_byte_case: untranslated
    tok.c = c2; tok.t = GT_CHAR; tok.len = 2
    if c2 == 124 then
      if not p.limited_ops and not p.ere then tok.t = GT_ALT end
    elseif c2 >= 49 and c2 <= 57 then
      tok.t = GT_BACKREF; tok.op = c2 - 49; tok.c = 0
    elseif c2 == 60 or c2 == 62 or c2 == 98 or c2 == 66 or c2 == 96 or c2 == 39 then
      if not p.no_gnu_ops then tok.t = GT_ANCHOR; tok.op = c2; tok.c = 0 end
    elseif c2 == 119 then if not p.no_gnu_ops then tok.t = GT_WORD end
    elseif c2 == 87 then if not p.no_gnu_ops then tok.t = GT_NOTWORD end
    elseif c2 == 115 then if not p.no_gnu_ops then tok.t = GT_SPACE end
    elseif c2 == 83 then if not p.no_gnu_ops then tok.t = GT_NOTSPACE end
    elseif c2 == 40 then if not p.ere then tok.t = GT_OPEN end
    elseif c2 == 41 then if not p.ere then tok.t = GT_CLOSE end
    elseif c2 == 43 then if not p.limited_ops and not p.ere then tok.t = GT_PLUS end
    elseif c2 == 63 then if not p.limited_ops and not p.ere then tok.t = GT_QUEST end
    elseif c2 == 123 then if not p.ere then tok.t = GT_OPEN_DUP end
    elseif c2 == 125 then if not p.ere then tok.t = GT_CLOSE_DUP end
    end
    return tok
  end
  tok.t = GT_CHAR; tok.len = 1
  if c == 124 then
    if not p.limited_ops and p.ere then tok.t = GT_ALT end
  elseif c == 42 then tok.t = GT_STAR
  elseif c == 43 then if not p.limited_ops and p.ere then tok.t = GT_PLUS end
  elseif c == 63 then if not p.limited_ops and p.ere then tok.t = GT_QUEST end
  elseif c == 123 then if p.ere then tok.t = GT_OPEN_DUP end
  elseif c == 125 then if p.ere then tok.t = GT_CLOSE_DUP end
  elseif c == 40 then if p.ere then tok.t = GT_OPEN end
  elseif c == 41 then if p.ere then tok.t = GT_CLOSE end
  elseif c == 91 then tok.t = GT_BRACKET
  elseif c == 46 then tok.t = GT_PERIOD
  elseif c == 94 then
    if p.ere or caret or at == 0 then tok.t = GT_ANCHOR; tok.op = 94 end
  elseif c == 36 then
    if p.ere or at + 1 == n then
      tok.t = GT_ANCHOR; tok.op = 36
    else
      local nx = g_peek_at(p, at + 1, false)
      if nx.t == GT_ALT or nx.t == GT_CLOSE then tok.t = GT_ANCHOR; tok.op = 36 end
    end
  end
  return tok
end

local function g_fetch(p: *GParser, caret: boolean): GTok
  local t = g_peek_at(p, p.pos, caret)
  p.pos = p.pos + t.len
  return t
end

local function g_peek_bracket(p: *GParser): GTok
  local tok: GTok
  local n: integer = (@integer)(p.pat.size)
  if p.pos >= n then tok.t = GT_END; tok.len = 0; return tok end
  local c = g_tr(p, p.pat.data[p.pos])
  tok.c = c; tok.len = 1; tok.t = GT_CHAR
  if c == 91 then
    local c2: byte = 0
    if p.pos + 1 < n then c2 = g_tr(p, p.pat.data[p.pos + 1]) end
    tok.c = c2; tok.len = 2
    if c2 == 46 then tok.t = GT_OPEN_COLL
    elseif c2 == 61 then tok.t = GT_OPEN_EQUIV
    elseif c2 == 58 then tok.t = GT_OPEN_CLASS
    else tok.t = GT_CHAR; tok.c = c; tok.len = 1 end
    return tok
  end
  if c == 45 then tok.t = GT_RANGE
  elseif c == 93 then tok.t = GT_CLOSE_BRACKET
  elseif c == 94 then tok.t = GT_NON_MATCH end
  return tok
end

-- A bracket element: kind 1 SB_CHAR, 2 COLL_SYM, 3 EQUIV_CLASS, 4 CHAR_CLASS.
local GElem = @record{ kind: byte, ch: byte, name: string }

local function g_bracket_symbol(p: *GParser, tok: GTok, e: *GElem): boolean
  local n: integer = (@integer)(p.pat.size)
  local delim = tok.c
  if p.pos >= n then p.err = 'Unmatched [, [^, [:, [., or [='; return false end
  local start = p.pos
  local i = 0
  while true do
    if i >= 32 then p.err = 'Unmatched [, [^, [:, [., or [='; return false end
    local ch = p.pat.data[p.pos]
    if tok.t ~= GT_OPEN_CLASS then ch = g_tr(p, ch) end
    p.pos = p.pos + 1
    if p.pos >= n then p.err = 'Unmatched [, [^, [:, [., or [='; return false end
    if ch == delim and p.pat.data[p.pos] == 93 then break end
    i = i + 1
  end
  local sb: stringbuilder
  for k = start, start + i - 1 do
    local ch = p.pat.data[k]
    if tok.t ~= GT_OPEN_CLASS then ch = g_tr(p, ch) end
    sb:writebyte(ch)
  end
  e.name = sb:promote()
  p.pos = p.pos + 1
  if tok.t == GT_OPEN_COLL then e.kind = 2 elseif tok.t == GT_OPEN_EQUIV then e.kind = 3 else e.kind = 4 end
  return true
end

local function g_bracket_element(p: *GParser, tok: GTok, accept_hyphen: boolean, e: *GElem): boolean
  p.pos = p.pos + tok.len
  if tok.t == GT_OPEN_COLL or tok.t == GT_OPEN_CLASS or tok.t == GT_OPEN_EQUIV then
    return g_bracket_symbol(p, tok, e)
  end
  if tok.t == GT_RANGE and not accept_hyphen then
    local t2 = g_peek_bracket(p)
    if t2.t ~= GT_CLOSE_BRACKET then p.err = 'Invalid range end'; return false end
  end
  e.kind = 1; e.ch = tok.c
  return true
end

-- strlen of a name that may hold a NUL byte from the pattern
local function g_cstrlen(s: string): integer
  for i: usize = 0, < s.size do if s.data[i] == 0 then return (@integer)(i) end end
  return (@integer)(s.size)
end

local function g_parse_bracket(p: *GParser): Frag
  local out: Frag
  local s: regex.Set
  local non_match = false
  local tok = g_peek_bracket(p)
  if tok.t == GT_END then p.err = 'Invalid regular expression'; return out end
  if tok.t == GT_NON_MATCH then
    non_match = true
    if p.newline then s:add(10) end
    p.pos = p.pos + tok.len
    tok = g_peek_bracket(p)
    if tok.t == GT_END then p.err = 'Invalid regular expression'; return out end
  end
  if tok.t == GT_CLOSE_BRACKET then tok.t = GT_CHAR end
  local first = true
  while true do
    local st: GElem
    local en: GElem
    local is_range = false
    local tok2: GTok
    if not g_bracket_element(p, tok, first, &st) then return out end
    first = false
    tok = g_peek_bracket(p)
    if st.kind ~= 4 and st.kind ~= 3 then
      if tok.t == GT_END then p.err = 'Unmatched [, [^, [:, [., or [='; return out end
      if tok.t == GT_RANGE then
        p.pos = p.pos + tok.len
        tok2 = g_peek_bracket(p)
        if tok2.t == GT_END then p.err = 'Unmatched [, [^, [:, [., or [='; return out end
        if tok2.t == GT_CLOSE_BRACKET then
          p.pos = p.pos - tok.len
          tok.t = GT_CHAR
        else
          is_range = true
        end
      end
    end
    if is_range then
      if not g_bracket_element(p, tok2, true, &en) then return out end
      tok = g_peek_bracket(p)
      if st.kind == 3 or st.kind == 4 or en.kind == 3 or en.kind == 4 then p.err = 'Invalid range end'; return out end
      if (st.kind == 2 and g_cstrlen(st.name) > 1) or (en.kind == 2 and g_cstrlen(en.name) > 1) then
        p.err = 'Invalid collation character'; return out
      end
      local lo: integer = st.ch
      if st.kind == 2 then lo = st.name.size > 0 and st.name.data[0] or 0 end
      local hi: integer = en.ch
      if en.kind == 2 then hi = en.name.size > 0 and en.name.data[0] or 0 end
      if lo > hi then p.err = 'Invalid range end'; return out end
      for b = lo, hi do s:add((@byte)(b)) end
    else
      if st.kind == 1 then
        s:add(st.ch)
      elseif st.kind == 2 or st.kind == 3 then
        if g_cstrlen(st.name) ~= 1 then p.err = 'Invalid collation character'; return out end
        s:add(st.name.data[0])
      else
        local name = st.name
        if p.icase and (name == 'upper' or name == 'lower') then name = 'alpha' end
        local cs: regex.Set
        if g_cstrlen(name) ~= (@integer)(name.size) or not set_named(&cs, name) then
          p.err = 'Invalid character class name'; return out
        end
        for b = 0, 255 do
          if cs:has((@byte)(b)) then s:add(g_tr(p, (@byte)(b))) end
        end
      end
    end
    if tok.t == GT_END then p.err = 'Unmatched [, [^, [:, [., or [='; return out end
    if tok.t == GT_CLOSE_BRACKET then break end
  end
  p.pos = p.pos + tok.len
  if non_match then for i = 0, 31 do s.bits[i] = ~s.bits[i] end end
  -- matching translates the input: the set holds every byte whose
  -- translation is in it
  local f: regex.Set
  for b = 0, 255 do
    if s:has(g_tr(p, (@byte)(b))) then f:add((@byte)(b)) end
  end
  p.sets:push(f)
  out:push(inst(OP_CLASS, 0, #p.sets, 0))
  return out
end

local function g_class(p: *GParser, name: string, extra: integer, negate: boolean): Frag
  local s: regex.Set
  set_named(&s, name)
  if extra >= 0 then s:add((@byte)(extra)) end
  if negate then for i = 0, 31 do s.bits[i] = ~s.bits[i] end end
  local out: Frag
  p.sets:push(s)
  out:push(inst(OP_CLASS, 0, #p.sets, 0))
  return out
end

local function g_fetch_number(p: *GParser): (integer, GTok)
  local num: integer = -1
  local tok: GTok
  while true do
    tok = g_fetch(p, false)
    local c = tok.c
    if tok.t == GT_END then return -2, tok end
    if tok.t == GT_CLOSE_DUP or c == 44 then break end
    if tok.t ~= GT_CHAR or c < 48 or c > 57 or num == -2 then num = -2
    elseif num == -1 then num = c - 48
    else
      num = num * 10 + (c - 48)
      if num > RE_DUP_MAX + 1 then num = RE_DUP_MAX + 1 end
    end
  end
  return num, tok
end

local function g_parse_reg_exp(p: *GParser, tok: *GTok, nest: integer): Frag <forwarddecl> end

local function g_parse_sub_exp(p: *GParser, tok: *GTok, nest: integer): Frag
  local cur = p.nsub
  p.nsub = p.nsub + 1
  $tok = g_fetch(p, true)
  local inner: Frag
  if tok.t ~= GT_CLOSE then
    inner = g_parse_reg_exp(p, tok, nest)
    if p.err.size == 0 and tok.t ~= GT_CLOSE then p.err = 'Unmatched ( or \\(' end
    if p.err.size > 0 then return inner end
  end
  if cur <= 8 then p.completed = p.completed | (1 << cur) end
  local out: Frag
  local idx = cur + 1
  if idx <= 9 then out:push(inst(OP_SAVE, 0, 2 * idx, 0)) end
  append(&out, inner)
  if idx <= 9 then out:push(inst(OP_SAVE, 0, 2 * idx + 1, 0)) end
  return out
end

-- parse_dup_op: tok is the operator; on return it is the next token.
local function g_parse_dup(p: *GParser, elem: Frag, tok: *GTok, isgroup: boolean): Frag
  local start: integer, stop: integer
  local empty: Frag
  if tok.t == GT_OPEN_DUP then
    stop = 0
    local t: GTok
    start, t = g_fetch_number(p)
    $tok = t
    if start == -1 then
      if tok.t == GT_CHAR and tok.c == 44 then start = 0
      else p.err = 'Invalid content of \\{\\}'; return empty end
    end
    if start ~= -2 then
      if tok.t == GT_CLOSE_DUP then stop = start
      elseif tok.t == GT_CHAR and tok.c == 44 then
        stop, t = g_fetch_number(p)
        $tok = t
      else stop = -2 end
    end
    if start == -2 or stop == -2 then
      if tok.t == GT_END then p.err = 'Unmatched \\{' else p.err = 'Invalid content of \\{\\}' end
      return empty
    end
    if (stop ~= -1 and start > stop) or tok.t ~= GT_CLOSE_DUP then
      p.err = 'Invalid content of \\{\\}'; return empty
    end
    if (stop == -1 and start or stop) > RE_DUP_MAX then p.err = 'Regular expression too big'; return empty end
  else
    start = tok.t == GT_PLUS and 1 or 0
    stop = tok.t == GT_QUEST and 1 or -1
  end
  $tok = g_fetch(p, false)
  if #elem == 0 then return elem end
  if start == 0 and stop == 0 then return empty end
  -- glibc records an empty first iteration of a group (update_regs keeps
  -- it unless an earlier iteration matched): (G)* behaves as ((G)+)?
  if start == 0 and stop == -1 then
    if isgroup then return rep_quest(rep_plus(elem)) end
    return rep_star(elem)
  end
  if start == 1 and stop == -1 then return rep_plus(elem) end
  if start == 0 and stop == 1 then return rep_quest(elem) end
  return rep_count(elem, start, stop)
end

local function g_parse_expression(p: *GParser, tok: *GTok, nest: integer): Frag
  local out: Frag
  local t = tok.t
  if t == GT_CHAR or t == GT_CLOSE_DUP then
    local c = tok.c
    if p.icase then c = lower(c) end
    out:push(inst(OP_CHAR, c, 0, 0))
  elseif t == GT_OPEN then
    out = g_parse_sub_exp(p, tok, nest + 1)
    if p.err.size > 0 then return out end
  elseif t == GT_BRACKET then
    out = g_parse_bracket(p)
    if p.err.size > 0 then return out end
  elseif t == GT_BACKREF then
    if (p.completed & (1 << tok.op)) == 0 then p.err = 'Invalid back reference'; return out end
    out:push(inst(OP_BACKREF, 0, tok.op + 1, 0))
  elseif t == GT_OPEN_DUP or t == GT_STAR or t == GT_PLUS or t == GT_QUEST or t == GT_CLOSE then
    if t == GT_OPEN_DUP and not p.ere then p.err = 'Invalid preceding regular expression'; return out end
    if t ~= GT_CLOSE and p.ere then p.err = 'Invalid preceding regular expression'; return out end
    if t == GT_CLOSE and not p.rparen_ord then p.err = 'Unmatched ) or \\)'; return out end
    local c = tok.c
    if p.icase then c = lower(c) end
    out:push(inst(OP_CHAR, c, 0, 0))
  elseif t == GT_ANCHOR then
    local op = tok.op
    if op == 94 then out:push(inst(OP_BOL, 0, 0, 0))
    elseif op == 36 then out:push(inst(OP_EOL, 0, 0, 0))
    elseif op == 96 then out:push(inst(OP_BOL, 1, 0, 0))
    elseif op == 39 then out:push(inst(OP_EOL, 1, 0, 0))
    elseif op == 98 then out:push(inst(OP_WORDB, 0, 0, 0))
    elseif op == 66 then out:push(inst(OP_NWORDB, 0, 0, 0))
    elseif op == 60 then out:push(inst(OP_WSTART, 0, 0, 0))
    else out:push(inst(OP_WEND, 0, 0, 0)) end
    -- an anchor is never the operand of a repetition
    $tok = g_fetch(p, false)
    return out
  elseif t == GT_PERIOD then
    if p.newline then
      local s: regex.Set
      for i = 0, 31 do s.bits[i] = 0xff end
      s.bits[10 >> 3] = s.bits[10 >> 3] & ~(1 << (10 & 7))
      p.sets:push(s)
      out:push(inst(OP_CLASS, 0, #p.sets, 0))
    else
      out:push(inst(OP_ANY, 0, 0, 0))
    end
  elseif t == GT_WORD then out = g_class(p, 'alnum', 95, false)
  elseif t == GT_NOTWORD then out = g_class(p, 'alnum', 95, true)
  elseif t == GT_SPACE then out = g_class(p, 'space', -1, false)
  elseif t == GT_NOTSPACE then out = g_class(p, 'space', -1, true)
  elseif t == GT_ALT or t == GT_END then
    return out
  elseif t == GT_BACKSLASH then
    p.err = 'Trailing backslash'; return out
  end
  $tok = g_fetch(p, false)
  local isgroup = t == GT_OPEN
  while tok.t == GT_STAR or tok.t == GT_PLUS or tok.t == GT_QUEST or tok.t == GT_OPEN_DUP do
    out = g_parse_dup(p, out, tok, isgroup)
    isgroup = false
    if p.err.size > 0 then return out end
    -- in a BRE consecutive repetitions are invalid (RE_CONTEXT_INVALID_DUP)
    if not p.ere and (tok.t == GT_STAR or tok.t == GT_OPEN_DUP) then
      p.err = 'Invalid preceding regular expression'; return out
    end
  end
  return out
end

local function g_parse_branch(p: *GParser, tok: *GTok, nest: integer): Frag
  local out = g_parse_expression(p, tok, nest)
  if p.err.size > 0 then return out end
  while tok.t ~= GT_ALT and tok.t ~= GT_END and (nest == 0 or tok.t ~= GT_CLOSE) do
    local e = g_parse_expression(p, tok, nest)
    if p.err.size > 0 then return out end
    append(&out, e)
  end
  return out
end

function g_parse_reg_exp(p: *GParser, tok: *GTok, nest: integer): Frag
  -- a back-reference may only name a group completed before this
  -- alternation or earlier in its own branch
  local initial = p.completed
  local left = g_parse_branch(p, tok, nest)
  if p.err.size > 0 then return left end
  while tok.t == GT_ALT do
    $tok = g_fetch(p, true)
    local right: Frag
    if tok.t ~= GT_ALT and tok.t ~= GT_END and (nest == 0 or tok.t ~= GT_CLOSE) then
      local accumulated = p.completed
      p.completed = initial
      right = g_parse_branch(p, tok, nest)
      if p.err.size > 0 then return left end
      p.completed = p.completed | accumulated
    end
    local out: Frag
    out:push(inst(OP_SPLIT, 0, 1, #left + 2))
    append(&out, left)
    out:push(inst(OP_JMP, 0, #left + #right + 2, 0))
    append(&out, right)
    left = out
  end
  return left
end

-- Compile with glibc's POSIX syntax (see above). `newline` is REG_NEWLINE's
-- effect on '.' and [^...]; `nlanchor` is re_pattern_buffer.newline_anchor.
-- Returns the program, an error message ("" on success) and re_nsub.
function regex.compile_posix(pat: string, ere: boolean, icase: boolean, newline: boolean, nlanchor: boolean,
                             flags: integer): (regex.Prog, string, integer)
  local p: GParser = {pat = pat, pos = 0, ere = ere, icase = icase, newline = newline,
                      rparen_ord = (flags & regex.RPAREN_ORD) ~= 0,
                      no_gnu_ops = (flags & regex.NO_GNU_OPS) ~= 0,
                      limited_ops = (flags & regex.LIMITED_OPS) ~= 0}
  local prog: regex.Prog
  prog.icase = icase
  prog.nlanchor = nlanchor
  -- glibc chooses among equally long matches the path that reaches its
  -- END_OF_RE node with the lowest index: a path whose last stretch
  -- after the final byte passes an anchor reaches a constrained copy of
  -- that node (calc_eclosure's duplicate_node_closure) and loses
  prog.glibc_halt = true
  prog.nlquirk = true
  local tok = g_fetch(&p, true)
  local body = g_parse_reg_exp(&p, &tok, 0)
  if p.err.size > 0 then return prog, p.err, 0 end
  prog.code:push(inst(OP_SAVE, 0, 0, 0))
  append(&prog.code, body)
  prog.code:push(inst(OP_SAVE, 0, 1, 0))
  prog.code:push(inst(OP_MATCH, 0, 0, 0))
  prog.nsub = p.nsub
  prog.sets = p.sets
  for i = 1, #prog.code do
    if prog.code[i].op == OP_BACKREF then prog.hasref = true end
  end
  return prog, '', p.nsub
end

function regex.compile_nl(pat: string, ere: boolean, icase: boolean, newline: boolean, nlanchor: boolean): (regex.Prog, string)
  return regex.compile_opts(pat, ere, icase, newline, nlanchor, 0)
end

function regex.compile(pat: string, ere: boolean, icase: boolean): (regex.Prog, string)
  return regex.compile_nl(pat, ere, icase, false, false)
end

-- Programs from a postfix token list ----------------------------------------
--
-- grep parses its patterns with ports of dfa.c's and glibc regcomp's parsers
-- and hands the result over as postfix tokens: T_CSET leaves (x is a 1-based
-- index into `sets`, the bytes the leaf matches), the zero-width T_BEGLINE
-- T_ENDLINE (subject ends; $ obeys noteol), T_BEGBUF T_ENDBUF, the word
-- assertions, T_BACKREF x, T_EMPTY, and the operators T_CAT T_OR (binary),
-- T_STAR T_PLUS T_QMARK and T_GROUP x (unary; group x is captured when
-- x <= 9). `icase` makes back-references compare ASCII case-insensitively.
global regex.Tok = @record{ kind: byte, x: integer }
global regex.T_CSET: byte <comptime> = 1
global regex.T_BEGLINE: byte <comptime> = 2
global regex.T_ENDLINE: byte <comptime> = 3
global regex.T_BEGBUF: byte <comptime> = 4
global regex.T_ENDBUF: byte <comptime> = 5
global regex.T_BEGWORD: byte <comptime> = 6
global regex.T_ENDWORD: byte <comptime> = 7
global regex.T_LIMWORD: byte <comptime> = 8
global regex.T_NOTLIMWORD: byte <comptime> = 9
global regex.T_BACKREF: byte <comptime> = 10
global regex.T_EMPTY: byte <comptime> = 11
global regex.T_CAT: byte <comptime> = 12
global regex.T_OR: byte <comptime> = 13
global regex.T_STAR: byte <comptime> = 14
global regex.T_PLUS: byte <comptime> = 15
global regex.T_QMARK: byte <comptime> = 16
global regex.T_GROUP: byte <comptime> = 17

function regex.from_postfix(toks: *sequence(regex.Tok), sets: sequence(regex.Set), icase: boolean): regex.Prog
  local prog: regex.Prog
  prog.icase = icase
  local stack: sequence(Frag)
  local nsub: integer = 0
  for i = 1, #toks do
    local t = toks[i]
    local k = t.kind
    if k == regex.T_CSET then
      local f: Frag
      f:push(inst(OP_CLASS, 0, t.x, 0))
      stack:push(f)
    elseif k >= regex.T_BEGLINE and k <= regex.T_BACKREF then
      local f: Frag
      if k == regex.T_BEGLINE then f:push(inst(OP_BOL, 0, 0, 0))
      elseif k == regex.T_ENDLINE then f:push(inst(OP_EOL, 0, 0, 0))
      elseif k == regex.T_BEGBUF then f:push(inst(OP_BOL, 1, 0, 0))
      elseif k == regex.T_ENDBUF then f:push(inst(OP_EOL, 1, 0, 0))
      elseif k == regex.T_BEGWORD then f:push(inst(OP_WSTART, 0, 0, 0))
      elseif k == regex.T_ENDWORD then f:push(inst(OP_WEND, 0, 0, 0))
      elseif k == regex.T_LIMWORD then f:push(inst(OP_WORDB, 0, 0, 0))
      elseif k == regex.T_NOTLIMWORD then f:push(inst(OP_NWORDB, 0, 0, 0))
      else f:push(inst(OP_BACKREF, 0, t.x, 0)); prog.hasref = true end
      stack:push(f)
    elseif k == regex.T_EMPTY then
      local f: Frag
      stack:push(f)
    elseif k == regex.T_CAT or k == regex.T_OR then
      local b = stack:pop()
      local a = stack:pop()
      if k == regex.T_CAT then
        append(&a, b)
        b:destroy()
        stack:push(a)
      else
        local out: Frag
        out:push(inst(OP_SPLIT, 0, 1, #a + 2))
        append(&out, a)
        out:push(inst(OP_JMP, 0, #a + #b + 2, 0))
        append(&out, b)
        a:destroy(); b:destroy()
        stack:push(out)
      end
    else
      local a = stack:pop()
      local out: Frag
      if k == regex.T_STAR then out = rep_star(a)
      elseif k == regex.T_PLUS then out = rep_plus(a)
      elseif k == regex.T_QMARK then out = rep_quest(a)
      else
        if t.x > nsub then nsub = t.x end
        if t.x >= 1 and t.x <= 9 then out:push(inst(OP_SAVE, 0, 2 * t.x, 0)) end
        append(&out, a)
        if t.x >= 1 and t.x <= 9 then out:push(inst(OP_SAVE, 0, 2 * t.x + 1, 0)) end
      end
      a:destroy()
      stack:push(out)
    end
  end
  prog.code:push(inst(OP_SAVE, 0, 0, 0))
  if #stack > 0 then append(&prog.code, stack[#stack]) end
  prog.code:push(inst(OP_SAVE, 0, 1, 0))
  prog.code:push(inst(OP_MATCH, 0, 0, 0))
  for i = 1, #stack do stack[i]:destroy() end
  stack:destroy()
  prog.nsub = nsub
  prog.sets = sets
  return prog
end

-- Executor ------------------------------------------------------------------
--
-- A Pike VM: at every text position the live threads are kept in a list in
-- priority order (first alternative first, greedy repetition first). Without
-- back-references two threads at the same pc have the same future, so only
-- the first is kept; that yields glibc's capture choice (the first path in
-- alternative order reaching the longest match) and cuts empty loop
-- iterations. With back-references a thread's future also depends on its
-- captures, so threads are deduplicated by (pc, captures, progress) instead,
-- empty epsilon cycles are cut per path, and the number of simultaneous
-- threads is bounded (toocomplex is set when the bound is hit).

local MAXTHREADS: integer <comptime> = 65536
local TABBITS: integer <comptime> = 17
local TABSIZE: integer <comptime> = 1 << TABBITS

local function caps_clear(c: *regex.Caps)
  for i = 0, 19 do c.at[i] = -1 end
end

local function zw_ok(prog: *regex.Prog, ins: regex.Inst, text: string, pos: isize): boolean
  local op = ins.op
  local n: isize = (@isize)(text.size)
  if op == OP_BOL then return pos == 0 or (ins.c == 0 and prog.nlanchor and text.data[pos - 1] == 10) end
  if op == OP_EOL then
    if pos == n then return ins.c ~= 0 or not prog.noteol end
    return ins.c == 0 and prog.nlanchor and text.data[pos] == 10
  end
  local before = pos > 0 and isword(text.data[pos - 1])
  local after = pos < n and isword(text.data[pos])
  if op == OP_WORDB then return before ~= after end
  if op == OP_NWORDB then return before == after end
  if op == OP_WSTART then return (not before) and after end
  return before and not after
end

local function thread_hash(pc: integer, k: isize, caps: *regex.Caps, dirty: boolean, neednl: boolean): usize
  local h: usize = 0xcbf29ce484222325
  h = (h ~ (@usize)(pc)) * 0x100000001b3
  if dirty then h = (h ~ 0x5bd1e995) * 0x100000001b3 end
  if neednl then h = (h ~ 0x27d4eb2f) * 0x100000001b3 end
  h = (h ~ (@usize)(k)) * 0x100000001b3
  for i = 0, 19 do h = (h ~ (@usize)(caps.at[i])) * 0x100000001b3 end
  return h
end

local function caps_equal(a: *regex.Caps, b: *regex.Caps): boolean
  for i = 0, 19 do
    if a.at[i] ~= b.at[i] then return false end
  end
  return true
end

local function ensure_scratch(prog: *regex.Prog)
  local ncode = #prog.code
  if #prog.mark < 4 * ncode then
    prog.mark:resize(4 * ncode)
    prog.clist:reserve(ncode)
    prog.nlist:reserve(ncode)
    if prog.hasref then
      prog.epsvis:resize(4 * ncode)
      for i = 1, 4 * ncode do prog.epsvis[i] = -1 end
      prog.tabgen:resize(TABSIZE)
      prog.tabidx:resize(TABSIZE)
    end
  end
end

-- Append a thread to `list` unless an identical one is already there.
local function materialize(prog: *regex.Prog, list: *sequence(Thread), n: *integer, pc: integer, k: isize, caps: *regex.Caps, dirty: boolean, neednl: boolean)
  if prog.hasref then
    local slot = (@integer)(thread_hash(pc, k, caps, dirty, neednl) & (TABSIZE - 1))
    while prog.tabgen[slot + 1] == prog.gen do
      local t = &list[prog.tabidx[slot + 1] + 1]
      if t.pc == pc and t.k == k and t.dirty == dirty and t.neednl == neednl and caps_equal(&t.caps, caps) then return end
      slot = (slot + 1) & (TABSIZE - 1)
    end
    if $n >= MAXTHREADS then prog.toocomplex = true; return end
    prog.tabgen[slot + 1] = (@int32)(prog.gen)
    prog.tabidx[slot + 1] = (@int32)($n)
  end
  local t: Thread = {pc = pc, k = k, caps = $caps, dirty = dirty, neednl = neednl}
  if $n < #list then list[$n + 1] = t else list:push(t) end
  $n = $n + 1
end

-- Follow epsilon transitions from pc at pos and add the resulting consuming
-- (or MATCH) threads to `list` in priority order.
local function addthread(prog: *regex.Prog, list: *sequence(Thread), n: *integer, pc: integer, pos: isize, text: string, caps: *regex.Caps, dirty: boolean, neednl: boolean)
  if prog.toocomplex then return end
  local vi = pc + 1
  if dirty then vi = vi + #prog.code end
  if neednl then vi = vi + 2 * #prog.code end
  if prog.hasref then
    if prog.epsvis[vi] == pos then return end
  else
    if prog.mark[vi] == prog.gen then return end
    prog.mark[vi] = prog.gen
  end
  local ins = prog.code[pc + 1]
  local op = ins.op
  local epsilon = op == OP_JMP or op == OP_SPLIT or op == OP_SAVE or op == OP_BOL or op == OP_EOL
    or op == OP_WORDB or op == OP_NWORDB or op == OP_WSTART or op == OP_WEND
  if op == OP_BACKREF then
    local s, e = caps.at[2 * ins.x], caps.at[2 * ins.x + 1]
    if s < 0 or e < 0 then return end
    if e == s then epsilon = true end
  end
  if not epsilon then
    materialize(prog, list, n, pc, 0, caps, dirty, neednl)
    return
  end
  local old: isize = 0
  if prog.hasref then old = prog.epsvis[vi]; prog.epsvis[vi] = pos end
  if op == OP_JMP then
    addthread(prog, list, n, ins.x, pos, text, caps, dirty, neednl)
  elseif op == OP_SPLIT then
    addthread(prog, list, n, ins.x, pos, text, caps, dirty, neednl)
    addthread(prog, list, n, ins.y, pos, text, caps, dirty, neednl)
  elseif op == OP_SAVE then
    local o = caps.at[ins.x]
    caps.at[ins.x] = pos
    addthread(prog, list, n, pc + 1, pos, text, caps, dirty, neednl)
    caps.at[ins.x] = o
  elseif op == OP_BACKREF then
    addthread(prog, list, n, pc + 1, pos, text, caps, dirty, neednl)
  else
    if zw_ok(prog, ins, text, pos) then
      addthread(prog, list, n, pc + 1, pos, text, caps, dirty or prog.glibc_halt, neednl)
    elseif prog.nlquirk and ins.c == 0 then
      -- glibc's matcher enters a newline context after consuming a
      -- newline, and lets `$` stand before one that the match consumes
      if op == OP_BOL and pos > 0 and caps.at[0] >= 0 and pos > caps.at[0] and text.data[pos - 1] == 10 then
        addthread(prog, list, n, pc + 1, pos, text, caps, true, neednl)
      elseif op == OP_EOL and pos < (@isize)(text.size) and text.data[pos] == 10 then
        addthread(prog, list, n, pc + 1, pos, text, caps, true, true)
      end
    end
  end
  if prog.hasref then prog.epsvis[vi] = old end
end

-- Run the program over text from `start`. With `anchored` only matches that
-- begin at `start` count; otherwise the leftmost start wins. Among matches
-- from the winning start the longest wins, ties going to the earlier path.
local function execute(prog: *regex.Prog, text: string, start: isize, anchored: boolean, caps: *regex.Caps): boolean
  ensure_scratch(prog)
  prog.toocomplex = false
  local n: isize = (@isize)(text.size)
  local cn: integer = 0
  local nn: integer = 0
  local found = false
  local best: regex.Caps
  local bestend: isize = -1
  local bestdirty = false
  local pos = start
  local init: regex.Caps
  caps_clear(&init)
  prog.gen = prog.gen + 1
  addthread(prog, &prog.clist, &cn, 0, pos, text, &init, false, false)
  while true do
    prog.gen = prog.gen + 1
    nn = 0
    for i = 1, cn do
      local t = &prog.clist[i]
      if found and t.caps.at[0] > best.at[0] then continue end
      local ins = prog.code[t.pc + 1]
      local op = ins.op
      if t.neednl and (op == OP_MATCH or pos >= n or text.data[pos] ~= 10) then continue end
      if op == OP_MATCH then
        if not found or t.caps.at[0] < best.at[0] or pos > bestend
           or (bestdirty and not t.dirty and pos == bestend and t.caps.at[0] == best.at[0]) then
          found = true
          best = t.caps
          bestend = pos
          bestdirty = t.dirty
        end
      elseif pos >= n then
        -- nothing left to consume
      elseif op == OP_CHAR then
        local b = text.data[pos]
        if prog.icase then b = lower(b) end
        if b == ins.c then addthread(prog, &prog.nlist, &nn, t.pc + 1, pos + 1, text, &t.caps, false, false) end
      elseif op == OP_ANY then
        addthread(prog, &prog.nlist, &nn, t.pc + 1, pos + 1, text, &t.caps, false, false)
      elseif op == OP_CLASS then
        if prog.sets[ins.x]:has(text.data[pos]) then
          addthread(prog, &prog.nlist, &nn, t.pc + 1, pos + 1, text, &t.caps, false, false)
        end
      elseif op == OP_BACKREF then
        local s, e = t.caps.at[2 * ins.x], t.caps.at[2 * ins.x + 1]
        local a, b = text.data[s + t.k], text.data[pos]
        if prog.icase then a, b = lower(a), lower(b) end
        if a == b then
          if t.k + 1 == e - s then
            addthread(prog, &prog.nlist, &nn, t.pc + 1, pos + 1, text, &t.caps, false, false)
          else
            materialize(prog, &prog.nlist, &nn, t.pc, t.k + 1, &t.caps, false, false)
          end
        end
      end
    end
    if prog.toocomplex then return false end
    if pos >= n then break end
    pos = pos + 1
    if not found and not anchored then
      caps_clear(&init)
      addthread(prog, &prog.nlist, &nn, 0, pos, text, &init, false, false)
    end
    local tmp = prog.clist
    prog.clist = prog.nlist
    prog.nlist = tmp
    cn = nn
    if cn == 0 and (found or anchored) then break end
  end
  if found then
    $caps = best
    return true
  end
  return false
end

-- Anchored match at `pos`. caps.at[0..1] receive the match bounds.
function regex.Prog:matchat(text: string, pos: isize, caps: *regex.Caps): boolean
  caps_clear(caps)
  return execute(self, text, pos, true, caps)
end

-- Search from `start`; the leftmost match wins, then the longest.
function regex.Prog:search(text: string, start: isize, caps: *regex.Caps): boolean
  caps_clear(caps)
  if #self.code > 1 and self.code[2].op == OP_BOL and (self.code[2].c == 1 or not self.nlanchor) then
    if start > 0 then return false end
    return execute(self, text, 0, true, caps)
  end
  return execute(self, text, start, false, caps)
end

-- Convenience: does the pattern match anywhere in text?
function regex.Prog:test(text: string): boolean
  local caps: regex.Caps
  return self:search(text, 0, &caps)
end
