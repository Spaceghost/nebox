-- ls, dir and vdir: a port of GNU coreutils 9.1 src/ls.c in the C locale.
--
-- The functions keep ls.c's names and control flow: decode_switches,
-- parse_ls_color/get_funky_string, gobble_file (the same stat/lstat
-- decisions, -L/-H/--dereference-command-line-symlink-to-dir), print_dir
-- (readdir order, -R with the dev/ino loop check and its marker entries,
-- the one-per-line -U streaming case), extract_dirs_from_files, the eight
-- sort-function variants over gnulib's mpsort, calculate_columns and the
-- column printers, print_long_format with GNU's width bookkeeping, the
-- "total" line, --dired offsets, --hyperlink (file:// URLs with the host
-- name and RFC 3986 escaping), quote_name/quote_name_buf over gnulib
-- quotearg, LS_COLORS with every indicator and extension, and the signal
-- handling that restores colors. Unibyte paths only: the C locale.
--
-- Capabilities are read from the security.capability xattr (ls built
-- with libcap), SELinux contexts from security.selinux, ACLs from the
-- POSIX ACL xattrs as gnulib's file_has_acl does on Linux.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.clock'
require 'nebox.quotearg'
require 'nebox.human'
require 'nebox.canonicalize'

local function c_exit(status: cint) <cimport 'exit', cinclude '<stdlib.h>', noreturn> end
local function c_getxattr(p: cstring, name: cstring, buf: pointer, n: csize): clong <cimport 'getxattr', cinclude '<sys/xattr.h>'> end
local function c_lgetxattr(p: cstring, name: cstring, buf: pointer, n: csize): clong <cimport 'lgetxattr', cinclude '<sys/xattr.h>'> end
local function c_fnmatch(pat: cstring, s: cstring, flags: cint): cint <cimport 'fnmatch', cinclude '<fnmatch.h>'> end
local function c_dirfd(d: *sys.DIR): cint <cimport 'dirfd', cinclude '<dirent.h>'> end
local function c_statx(dirfd: cint, path: cstring, flags: cint, mask: cuint, buf: pointer): cint <cimport 'statx', cinclude '<sys/stat.h>'> end
local Passwd <cimport 'passwd', cinclude '<pwd.h>', nodecl, ctypedef 'passwd'> = @record{
  pw_name: cstring, pw_passwd: cstring, pw_uid: cuint, pw_gid: cuint, pw_gecos: cstring, pw_dir: cstring, pw_shell: cstring,
}
local Group <cimport 'group', cinclude '<grp.h>', nodecl, ctypedef 'group'> = @record{
  gr_name: cstring, gr_passwd: cstring, gr_gid: cuint, gr_mem: *cstring,
}
local function c_getpwuid(uid: cuint): *Passwd <cimport 'getpwuid', cinclude '<pwd.h>'> end
local function c_getgrgid(gid: cuint): *Group <cimport 'getgrgid', cinclude '<grp.h>'> end
local SigSet = @record{bits: [16]culong}
local function c_sigprocmask(how: cint, set: *SigSet, old: *SigSet): cint <cimport 'sigprocmask', cinclude '<signal.h>'> end

-- struct statx (the Linux UAPI layout, 256 bytes)
local StatxTs = @record{tv_sec: int64, tv_nsec: uint32, reserved: int32}
local Statx = @record{
  stx_mask: uint32, stx_blksize: uint32, stx_attributes: uint64, stx_nlink: uint32, stx_uid: uint32,
  stx_gid: uint32, stx_mode: uint16, spare0: uint16, stx_ino: uint64, stx_size: uint64, stx_blocks: uint64,
  stx_attributes_mask: uint64, stx_atime: StatxTs, stx_btime: StatxTs, stx_ctime: StatxTs, stx_mtime: StatxTs,
  rest: [16]uint64,
}
local STATX_BTIME: cuint <comptime> = 0x800
