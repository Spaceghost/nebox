-- Text applets: echo cat head tail wc uniq tee tr cut rev yes seq printf nl
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.longopts'
require 'nebox.regex'


-- cat: GNU coreutils 9.1 cat.c. -b -n -s -v -E -T -A -e -t (-u ignored);
-- line numbers, squeezing and a pending CR carry across files; a regular
-- input that is also the output (and not yet at its end) is refused.
local cat_newlines: integer
local cat_pending_cr: boolean
local cat_lineno: integer

local function cat_number()
  cat_lineno = cat_lineno + 1
  util.writef('%6d\t', cat_lineno)
end

local function cat_chunk(buf: *[0]byte, n: integer, show_nonprinting: boolean, show_tabs: boolean,
                         number: boolean, number_nonblank: boolean, show_ends: boolean, squeeze_blank: boolean)
  local i: integer = 0
  while i < n do
    local ch = buf[i]
    i = i + 1
    if ch == 10 then
      cat_newlines = cat_newlines + 1
      if cat_newlines > 0 then
        if cat_newlines >= 2 then
          cat_newlines = 2
          if squeeze_blank then continue end
        end
        if number and not number_nonblank then cat_number() end
      end
      if show_ends then
        if cat_pending_cr then util.write('^M'); cat_pending_cr = false end
        util.writebyte(36)
      end
      util.writebyte(10)
      continue
    end
    if cat_pending_cr then util.writebyte(13); cat_pending_cr = false end
    if cat_newlines >= 0 and number then cat_number() end
    cat_newlines = -1
    if show_nonprinting then
      if ch >= 32 then
        if ch < 127 then util.writebyte(ch)
        elseif ch == 127 then util.write('^?')
        else
          util.write('M-')
          if ch >= 128 + 32 then
            if ch < 128 + 127 then util.writebyte(ch - 128) else util.write('^?') end
          else
            util.writebyte(94); util.writebyte(ch - 128 + 64)
          end
        end
      elseif ch == 9 and not show_tabs then util.writebyte(9)
      else util.writebyte(94); util.writebyte(ch + 64) end
    else
      if ch == 9 and show_tabs then util.write('^I')
      elseif ch == 13 and show_ends and (i >= n or buf[i] == 10) then
        if i >= n then cat_pending_cr = true else util.write('^M') end
      else util.writebyte(ch) end
    end
  end
end

global function applet_cat(args: sequence(string)): integer
  local o = util.parsel(args, 'benstuvAET', &longopts.cat, #longopts.cat)
  if not o:ok() then return util.optfail(o) end
  local number, number_nonblank, squeeze_blank = false, false, false
  local show_ends, show_nonprinting, show_tabs = false, false, false
  for _, c in ipairs(o.order) do
    if c == 98 then number = true; number_nonblank = true
    elseif c == 101 then show_ends = true; show_nonprinting = true
    elseif c == 110 then number = true
    elseif c == 115 then squeeze_blank = true
    elseif c == 116 then show_tabs = true; show_nonprinting = true
    elseif c == 118 then show_nonprinting = true
    elseif c == 65 then show_nonprinting = true; show_ends = true; show_tabs = true
    elseif c == 69 then show_ends = true
    elseif c == 84 then show_tabs = true end
  end
  local simple = not (number or show_ends or show_nonprinting or show_tabs or squeeze_blank)
  cat_newlines = 0; cat_pending_cr = false; cat_lineno = 0
  local ost: sys.Stat
  local out_isreg = false
  if sys.fstat(1, &ost) == 0 then out_isreg = (ost.st_mode & sys.S_IFMT) == sys.S_IFREG end
  if #o.operands == 0 then o.operands:push('-') end
  local ok = true
  local buf: [65536]byte
  for _, infile in ipairs(o.operands) do
    local reading_stdin = infile == '-'
    local fd: cint = 0
    if not reading_stdin then
      fd = sys.open(infile, sys.O_RDONLY, 0)
      if fd < 0 then util.err(util.quotef(infile) .. ': ' .. sys.errstr()); ok = false; continue end
    end
    local st: sys.Stat
    if sys.fstat(fd, &st) ~= 0 then
      util.err(util.quotef(infile) .. ': ' .. sys.errstr()); ok = false
    elseif out_isreg and st.st_dev == ost.st_dev and st.st_ino == ost.st_ino
           and sys.lseek(fd, 0, sys.SEEK_CUR) < st.st_size then
      util.err(util.quotef(infile) .. ': input file is output file'); ok = false
    else
      while true do
        util.flush()
        local n = sys.read(fd, &buf, #buf)
        if n < 0 then
          if sys.errno() == sys.EINTR then continue end
          util.err(util.quotef(infile) .. ': ' .. sys.errstr()); ok = false
          break
        end
        if n == 0 then break end
        if simple then util.writebytes(&buf, (@usize)(n))
        else cat_chunk(&buf, n, show_nonprinting, show_tabs, number, number_nonblank, show_ends, squeeze_blank) end
      end
    end
    if not reading_stdin then sys.close(fd) end
  end
  if cat_pending_cr then util.writebyte(13) end
  util.flush()
  return ok and 0 or 1
end

-- head/tail share operand handling: "-n N", "-c N", legacy "-N".




-- head streams: it must stop reading after N lines so `yes | head` ends.



-- gnulib filevercmp (filenvercmp over a counted string), shared by sort -V
-- and ls -v.
-- Byte at 0-based index i, or 0 past the end.
local function at(s: string, i: integer): integer
  if i < 0 or i >= (@integer)(s.size) then return 0 end
  return (@integer)(s.data[i])
end

local function sdigit(c: integer): boolean return c >= 48 and c <= 57 end
local function salpha(c: integer): boolean return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) end
local function salnum(c: integer): boolean return sdigit(c) or salpha(c) end

-- gnulib filevercmp: length of s without its (\.[A-Za-z~][A-Za-z0-9~]*)*$ suffix.
local function file_prefixlen(s: string): integer
  local n = (@integer)(s.size)
  local prefixlen: integer = 0
  local i: integer = 0
  while true do
    if i == n then return prefixlen end
    i = i + 1
    prefixlen = i
    while i + 1 < n and at(s, i) == 46 and (salpha(at(s, i + 1)) or at(s, i + 1) == 126) do
      i = i + 2
      while i < n and (salnum(at(s, i)) or at(s, i) == 126) do i = i + 1 end
    end
  end
  return prefixlen
end

local function verorder(s: string, pos: integer, len: integer): integer
  if pos == len then return -1 end
  local c = at(s, pos)
  if sdigit(c) then return 0 end
  if salpha(c) then return c end
  if c == 126 then return -2 end
  return c + 256
end

local function verrevcmp(s1: string, l1: integer, s2: string, l2: integer): integer
  local p1, p2: integer = 0, 0
  while p1 < l1 or p2 < l2 do
    local first_diff: integer = 0
    while (p1 < l1 and not sdigit(at(s1, p1))) or (p2 < l2 and not sdigit(at(s2, p2))) do
      local c1, c2 = verorder(s1, p1, l1), verorder(s2, p2, l2)
      if c1 ~= c2 then return c1 - c2 end
      p1 = p1 + 1; p2 = p2 + 1
    end
    while p1 < l1 and at(s1, p1) == 48 do p1 = p1 + 1 end
    while p2 < l2 and at(s2, p2) == 48 do p2 = p2 + 1 end
    while p1 < l1 and p2 < l2 and sdigit(at(s1, p1)) and sdigit(at(s2, p2)) do
      if first_diff == 0 then first_diff = at(s1, p1) - at(s2, p2) end
      p1 = p1 + 1; p2 = p2 + 1
    end
    if p1 < l1 and sdigit(at(s1, p1)) then return 1 end
    if p2 < l2 and sdigit(at(s2, p2)) then return -1 end
    if first_diff ~= 0 then return first_diff end
  end
  return 0
end

global function filevercmp(a: string, b: string): integer
  local alen, blen = (@integer)(a.size), (@integer)(b.size)
  if alen == 0 then return blen ~= 0 and -1 or 0 end
  if blen == 0 then return 1 end
  if at(a, 0) == 46 then
    if at(b, 0) ~= 46 then return -1 end
    local adot, bdot = alen == 1, blen == 1
    if adot then return bdot and 0 or -1 end
    if bdot then return 1 end
    local adotdot = at(a, 1) == 46 and alen == 2
    local bdotdot = at(b, 1) == 46 and blen == 2
    if adotdot then return bdotdot and 0 or -1 end
    if bdotdot then return 1 end
  elseif at(b, 0) == 46 then
    return 1
  end
  local aprefix, bprefix = file_prefixlen(a), file_prefixlen(b)
  local one_pass = aprefix == alen and bprefix == blen
  local result = verrevcmp(a, aprefix, b, bprefix)
  if result ~= 0 or one_pass then return result end
  return verrevcmp(a, alen, b, blen)
end




-- tr: expand a set with ranges and escapes into bytes
local function class_bytes(name: string, out: *sequence(byte)): boolean
  local lo: integer, hi: integer = 0, 255
  if name == 'alpha' then for b = 65, 90 do out:push((@byte)(b)) end; for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'digit' then for b = 48, 57 do out:push((@byte)(b)) end
  elseif name == 'alnum' then for b = 48, 57 do out:push((@byte)(b)) end; for b = 65, 90 do out:push((@byte)(b)) end; for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'upper' then for b = 65, 90 do out:push((@byte)(b)) end
  elseif name == 'lower' then for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'space' then for b = 9, 13 do out:push((@byte)(b)) end; out:push(32)
  elseif name == 'blank' then out:push(9); out:push(32)
  elseif name == 'punct' then
    for b = 33, 47 do out:push((@byte)(b)) end; for b = 58, 64 do out:push((@byte)(b)) end
    for b = 91, 96 do out:push((@byte)(b)) end; for b = 123, 126 do out:push((@byte)(b)) end
  elseif name == 'print' then for b = 32, 126 do out:push((@byte)(b)) end
  elseif name == 'graph' then for b = 33, 126 do out:push((@byte)(b)) end
  elseif name == 'cntrl' then for b = 0, 31 do out:push((@byte)(b)) end; out:push(127)
  elseif name == 'xdigit' then for b = 48, 57 do out:push((@byte)(b)) end; for b = 65, 70 do out:push((@byte)(b)) end; for b = 97, 102 do out:push((@byte)(b)) end
  else return false end
  local _ = lo + hi
  return true
end



-- cut: field/char lists like "1,3-5,7-"
local Range = @record{lo: integer, hi: integer}

local function parse_list(s: string): (sequence(Range), boolean)
  local out: sequence(Range)
  local start: usize = 1
  for i: usize = 1, s.size + 1 do
    if i > s.size or s:byte(i) == 44 then
      local part = s:sub(start, i - 1)
      start = i + 1
      if part.size == 0 then return out, false end
      local dash = part:find('-', 1, true)
      local r: Range = {1, 0x7fffffff}
      if dash == 0 then
        local v, ok = util.toint(part); if not ok or v < 1 then return out, false end
        r.lo, r.hi = v, v
      else
        if dash > 1 then local v, ok = util.toint(part:sub(1, dash - 1)); if not ok then return out, false end; r.lo = v end
        if dash < (@isize)(part.size) then local v, ok = util.toint(part:sub(dash + 1)); if not ok then return out, false end; r.hi = v end
        if r.lo < 1 or r.hi < r.lo then return out, false end
      end
      out:push(r)
    end
  end
  return out, #out > 0
end

local function inlist(list: sequence(Range), n: integer): boolean
  for _, r in ipairs(list) do if n >= r.lo and n <= r.hi then return true end end
  return false
end


global function applet_rev(args: sequence(string)): integer
  if #args == 0 then args:push('-') end
  local rc: integer = 0
  for _, path in ipairs(args) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    local start: usize = 0
    for i: usize = 0, data.size do
      if i == data.size or data.data[i] == 10 then
        local j: isize = (@isize)(i) - 1
        while j >= (@isize)(start) do util.writebyte(data.data[j]); j = j - 1 end
        if i < data.size then util.writebyte(10) end
        start = i + 1
      end
    end
  end
  return rc
end

global function applet_yes(args: sequence(string)): integer
  local s: string = 'y'
  if #args > 0 then
    local sb: stringbuilder
    for i, a in ipairs(args) do if i > 1 then sb:writebyte(32) end; sb:write(a) end
    s = sb:promote()
  end
  -- flush after every line so a closed pipe ends the loop
  while true do
    util.line(s)
    if not util.flush() then return 1 end
  end
  return 0
end

local function c_snprintf(buf: cstring, n: csize, fmt: cstring, ...: cvarargs): cint <cimport 'snprintf', cinclude '<stdio.h>'> end

-- One floating conversion through the C library.
local function printf_float(spec: string, v: float64): string
  local buf: [512]byte
  local n = c_snprintf((@cstring)(&buf[0]), 512, spec, v)
  if n < 0 then return '' end
  if n < 512 then return string.copy((@string){data = &buf[0], size = (@usize)(n)}) end
  local s = string.create((@usize)(n))
  c_snprintf((@cstring)(s.data), (@usize)(n) + 1, spec, v)
  return s
end

-- Floating operand: a strtod number (leading/trailing blanks aside), or a
-- 'c / "c character constant.
local function printf_tofloat(a: string): (float64, boolean)
  if a.size == 0 then return 0, true end
  if a:byte(1) == 39 or a:byte(1) == 34 then return a.size > 1 and a:byte(2) or 0, true end
  local c = string.copy(a)
  local endp: cstring
  local v = sys.strtod(c, &endp)
  local used = (@usize)((@isize)(endp) - (@isize)(c.data))
  while used < a.size and (a:byte(used + 1) == 32 or a:byte(used + 1) == 9) do used = used + 1 end
  local ok = used == a.size and (@isize)(endp) ~= (@isize)(c.data)
  c:destroy()
  return v, ok
end

-- seq, after GNU seq 9.1: operands are long doubles, the default format is
-- %.PLf with P the larger number of fraction digits of FIRST and INCREMENT
-- (%Lg for hex or 'p' operands), -w pads to the widest operand, -f takes one
-- e/f/g/a conversion. All-digit operands (and integral ones that print as
-- plain digits) with a small positive step count in decimal strings, so
-- they stay exact past 2^64 and `seq N inf` runs forever, as GNU's fast
-- path does.
local SEQ_NOPREC: integer <comptime> = 0x7fffffff

local SeqOperand = @record{value: clongdouble, width: integer, precision: integer}

local function seq_isdigit(c: byte): boolean return c >= '0'_b and c <= '9'_b end
local function seq_isspace(c: byte): boolean return c == 32 or (c >= 9 and c <= 13) end
local function seq_finite(v: clongdouble): boolean return v == v and v - v == 0 end

-- Format one long double; returns the bytes in buf, or an allocated
-- string when they do not fit.
local function seq_fmt(fmt: string, v: clongdouble, buf: *[512]byte): string
  local n = c_snprintf((@cstring)(&buf[0]), 512, fmt, v)
  if n < 0 then return '' end
  if n < 512 then return (@string){data = &buf[0], size = (@usize)(n)} end
  local s = string.create((@usize)(n))
  c_snprintf((@cstring)(s.data), (@usize)(n) + 1, fmt, v)
  return s
end

-- gnulib xstrtold: the whole operand must be a number; overflow is an
-- error, underflow is not.
local function seq_strtold(a: string): (clongdouble, boolean)
  local c = string.copy(a)
  local endp: cstring
  local v = sys.strtold(c, &endp)
  local used = (@usize)((@isize)(endp) - (@isize)(c.data))
  local ok = used > 0 and used == a.size
  if ok and v == v and not seq_finite(v) then
    -- an infinity is fine only when it was written as one
    local i: usize = 1
    while i <= a.size and (seq_isspace(a:byte(i)) or a:byte(i) == '+'_b or a:byte(i) == '-'_b) do i = i + 1 end
    ok = i <= a.size and (a:byte(i) == 'i'_b or a:byte(i) == 'I'_b)
  end
  c:destroy()
  return v, ok
end

local function seq_usage_fail(msg: string): integer
  util.err(msg)
  util.flush()
  local tm = "Try 'seq --help' for more information.\n"
  sys.write(2, tm.data, tm.size)
  return 1
end

-- strspn-style count of bytes from `set` starting at i
local function seq_span(s: string, i: usize, set: string): usize
  local j = i
  while j <= s.size and set:find(string.char(s:byte(j)), 1, true) > 0 do j = j + 1 end
  return j
end

-- coreutils scan_arg: value plus the width and precision the operand's
-- spelling implies.
local function seq_scan(arg: string): (SeqOperand, boolean)
  local r: SeqOperand = {value = 0, width = 0, precision = SEQ_NOPREC}
  local v, ok = seq_strtold(arg)
  if not ok then
    seq_usage_fail("invalid floating point argument: '" .. arg .. "'"); return r, false
  end
  if v ~= v then
    seq_usage_fail("invalid 'not-a-number' argument: '" .. arg .. "'"); return r, false
  end
  r.value = v
  local k: usize = 1
  while k <= arg.size and (seq_isspace(arg:byte(k)) or arg:byte(k) == '+'_b) do k = k + 1 end
  local s = arg:sub(k)
  local dp = s:find('.', 1, true)
  if dp == 0 and s:find('p', 1, true) == 0 then r.precision = 0 end
  if s:find('x', 1, true) == 0 and s:find('X', 1, true) == 0 and seq_finite(v) then
    local fraction_len: integer = 0
    r.width = (@integer)(s.size)
    if dp > 0 then
      local j = dp + 1
      while j <= (@isize)(s.size) and s:byte(j) ~= 'e'_b and s:byte(j) ~= 'E'_b do j = j + 1 end
      fraction_len = (@integer)(j - dp - 1)
      r.precision = fraction_len
      if fraction_len == 0 then r.width = r.width - 1
      elseif dp == 1 or not seq_isdigit(s:byte(dp - 1)) then r.width = r.width + 1 end
    end
    local e = s:find('e', 1, true)
    if e == 0 then e = s:find('E', 1, true) end
    if e > 0 then
      -- strtol of the exponent
      local j = e + 1
      while j <= (@isize)(s.size) and seq_isspace(s:byte(j)) do j = j + 1 end
      local eneg = false
      if j <= (@isize)(s.size) and (s:byte(j) == '-'_b or s:byte(j) == '+'_b) then eneg = s:byte(j) == '-'_b; j = j + 1 end
      local exponent: integer = 0
      while j <= (@isize)(s.size) and seq_isdigit(s:byte(j)) do
        if exponent < 0x7fffffff then exponent = exponent * 10 + (s:byte(j) - '0'_b) end
        j = j + 1
      end
      if eneg then exponent = -exponent end
      if exponent < 0 then r.precision = r.precision - exponent
      else r.precision = r.precision - (r.precision < exponent and r.precision or exponent) end
      r.width = r.width - ((@integer)(s.size) - (@integer)(e - 1))
      if exponent < 0 then
        if dp > 0 then
          if e == dp + 1 then r.width = r.width + 1 end
        else
          r.width = r.width + 1
        end
        exponent = -exponent
      else
        if dp > 0 and r.precision == 0 and fraction_len > 0 then r.width = r.width - 1 end
        exponent = exponent - (fraction_len < exponent and fraction_len or exponent)
      end
      r.width = r.width + exponent
    end
  end
  return r, true
end

local function at(s: string, i: usize): byte
  if i > s.size then return 0 end
  return s:byte(i)
end

-- coreutils long_double_format: check -f's FORMAT and add the L modifier.
-- Returns the format, the output length of its prefix and suffix, and an
-- error message.
local function seq_ldformat(fmt: string): (string, integer, integer, string)
  local i: usize = 1
  local prefix: integer = 0
  while not (at(fmt, i) == '%'_b and at(fmt, i + 1) ~= '%'_b) do
    if at(fmt, i) == 0 then return '', 0, 0, "format '" .. fmt .. "' has no % directive" end
    prefix = prefix + 1
    i = i + (at(fmt, i) == '%'_b and 2 or 1)
  end
  i = i + 1
  local flags_start = i
  i = seq_span(fmt, i, "-+#0 '")
  local flags = fmt:sub(flags_start, i - 1)
  local rest_start = i
  i = seq_span(fmt, i, '0123456789')
  if at(fmt, i) == '.'_b then i = seq_span(fmt, i + 1, '0123456789') end
  local lmo = i
  local hasL = at(fmt, i) == 'L'_b
  if hasL then i = i + 1 end
  local conv = at(fmt, i)
  if conv == 0 then return '', 0, 0, "format '" .. fmt .. "' ends in %" end
  if ('efgaEFGA'):find(string.char(conv), 1, true) == 0 then
    return '', 0, 0, "format '" .. fmt .. "' has unknown %" .. string.char(conv) .. ' directive'
  end
  i = i + 1
  local suffix: integer = 0
  while at(fmt, i) ~= 0 do
    if at(fmt, i) == '%'_b and at(fmt, i + 1) ~= '%'_b then
      return '', 0, 0, "format '" .. fmt .. "' has too many % directives"
    end
    suffix = suffix + 1
    i = i + (at(fmt, i) == '%'_b and 2 or 1)
  end
  -- the ' flag (thousands grouping) does nothing in the C locale
  local sb: stringbuilder
  for k: usize = 1, flags.size do if flags:byte(k) ~= 39 then sb:writebyte(flags:byte(k)) end end
  local ldfmt = fmt:sub(1, flags_start - 1) .. sb:promote() .. fmt:sub(rest_start, lmo - 1) .. 'L' ..
    fmt:sub(lmo + (hasL and 1 or 0))
  return ldfmt, prefix, suffix, ''
end

local function seq_print(fmt: string, prefix: integer, suffix: integer, first: clongdouble, step: clongdouble,
    last: clongdouble, sep: string)
  local out_of_range: boolean
  if step < 0 then out_of_range = first < last else out_of_range = last < first end
  if out_of_range then return end
  local buf: [512]byte
  local x = first
  local i: clongdouble = 1
  while true do
    local x0 = x
    util.write(seq_fmt(fmt, x, &buf))
    if out_of_range then break end
    x = first + i * step
    i = i + 1
    if step < 0 then out_of_range = x < last else out_of_range = last < x end
    if out_of_range then
      -- print one more number when it prints as LAST and differently from
      -- the previous one (rounding: seq 0 0.1 1 ends with 1.0)
      local extra = false
      local xs = string.copy(seq_fmt(fmt, x, &buf))
      local xv, ok = seq_strtold(xs:sub((@usize)(prefix) + 1, xs.size - (@usize)(suffix)))
      if ok and xv == last then
        local x0s = seq_fmt(fmt, x0, &buf)
        extra = x0s:sub(1, x0s.size - (@usize)(suffix)) ~= xs:sub(1, xs.size - (@usize)(suffix))
      end
      if not extra then break end
    end
    util.write(sep)
    if (@integer)(i) & 1023 == 0 and not util.flush() then return end
  end
  util.writebyte(10)
end

local function seq_all_digits(s: string): boolean
  if s.size == 0 then return false end
  for i: usize = 1, s.size do if not seq_isdigit(s:byte(i)) then return false end end
  return true
end

-- Compare two digit strings without leading zeros.
local function seq_cmp(a: sequence(byte), b: string): integer
  if (@usize)(#a) ~= b.size then return #a < (@integer)(b.size) and -1 or 1 end
  for i: usize = 1, b.size do
    if a[i] ~= b:byte(i) then return a[i] < b:byte(i) and -1 or 1 end
  end
  return 0
end

-- coreutils seq_fast: decimal strings from A to B (or "inf") by STEP.
local function seq_fast(a: string, b: string, step: integer, sep: string)
  local inf = b == 'inf'
  local ia: usize = 1
  while ia < a.size and a:byte(ia) == '0'_b do ia = ia + 1 end
  local ib: usize = 1
  while ib < b.size and b:byte(ib) == '0'_b do ib = ib + 1 end
  local q = b:sub(ib)
  local p: sequence(byte)
  for k: usize = ia, a.size do p:push(a:byte(k)) end
  if not inf and seq_cmp(p, q) > 0 then return end
  for k = 1, #p do util.writebyte(p[k]) end
  local count: integer = 0
  while true do
    -- p += step
    local carry: integer = step
    local k = #p
    while carry > 0 and k >= 1 do
      local d = (p[k] - '0'_b) + carry
      p[k] = (@byte)('0'_b + d % 10)
      carry = d // 10
      k = k - 1
    end
    while carry > 0 do p:insert(1, (@byte)('0'_b + carry % 10)); carry = carry // 10 end
    if not inf and seq_cmp(p, q) > 0 then break end
    util.write(sep)
    for j = 1, #p do util.writebyte(p[j]) end
    count = count + 1
    if count & 1023 == 0 and not util.flush() then return end
  end
  util.writebyte(10)
end

global function applet_seq(args: sequence(string)): integer
  local sep: string = '\n'
  local fmt: string = ''
  local has_fmt = false
  local equal = false
  local i: integer = 1
  -- getopt "+f:s:w" with long options; "-5" and "-.5" are operands
  while i <= #args do
    local a = args[i]
    if a.size < 2 or a:byte(1) ~= '-'_b then break end
    if a:byte(2) == '.'_b or seq_isdigit(a:byte(2)) then break end
    if a == '--' then i = i + 1; break end
    if a:byte(2) == '-'_b then
      local body = a:sub(3)
      local name, value = body, ''
      local eq = body:find('=', 1, true)
      local has_value = eq > 0
      if has_value then name = body:sub(1, eq - 1); value = body:sub(eq + 1) end
      local longs: [3]string = {'equal-width', 'format', 'separator'}
      local match: string = ''
      local count = 0
      for _, l in ipairs(longs) do
        if l == name then match = l; count = 1; break end
        if name.size > 0 and l:sub(1, name.size) == name then match = l; count = count + 1 end
      end
      if count ~= 1 then
        return seq_usage_fail((count == 0 and "unrecognized option '" or "option '") .. a ..
          (count == 0 and "'" or "' is ambiguous"))
      end
      if match == 'equal-width' then
        if has_value then return seq_usage_fail("option '--equal-width' doesn't allow an argument") end
        equal = true
      else
        if not has_value then
          i = i + 1
          if i > #args then return seq_usage_fail("option '--" .. match .. "' requires an argument") end
          value = args[i]
        end
        if match == 'format' then fmt = value; has_fmt = true else sep = value end
      end
      i = i + 1
      continue
    end
    local j: usize = 2
    while j <= a.size do
      local c = a:byte(j)
      if c == 'w'_b then
        equal = true; j = j + 1
      elseif c == 'f'_b or c == 's'_b then
        local v: string
        if j < a.size then v = a:sub(j + 1)
        else
          i = i + 1
          if i > #args then return seq_usage_fail("option requires an argument -- '" .. string.char(c) .. "'") end
          v = args[i]
        end
        if c == 'f'_b then fmt = v; has_fmt = true else sep = v end
        break
      else
        return seq_usage_fail("invalid option -- '" .. string.char(c) .. "'")
      end
    end
    i = i + 1
  end
  local ops: sequence(string)
  while i <= #args do ops:push(args[i]); i = i + 1 end
  local n = #ops
  if n < 1 then return seq_usage_fail('missing operand') end
  if n > 3 then return seq_usage_fail("extra operand '" .. ops[4] .. "'") end
  if has_fmt and equal then
    return seq_usage_fail('format string may not be specified when printing equal width strings')
  end
  local plain = not equal and not has_fmt and sep.size == 1
  -- fast path for digit-only operands
  local fast_step_ok = true
  if n == 3 then
    local sv, sok = seq_strtold(ops[2])
    fast_step_ok = seq_all_digits(ops[2]) and sok and 0 < sv and sv <= 200
  end
  if plain and seq_all_digits(ops[1]) and (n == 1 or seq_all_digits(ops[2])) and
      (n < 3 or (fast_step_ok and seq_all_digits(ops[3]))) then
    local stepv: integer = 1
    if n == 3 then local sv, _ = util.toint(ops[2]); stepv = sv end
    seq_fast(n == 1 and '1' or ops[1], ops[n], stepv, sep)
    return util.flush() and 0 or 1
  end
  local first: SeqOperand = {value = 1, width = 1, precision = 0}
  local step: SeqOperand = {value = 1, width = 1, precision = 0}
  local last: SeqOperand
  local ok: boolean
  if n == 1 then
    last, ok = seq_scan(ops[1]); if not ok then return 1 end
  else
    first, ok = seq_scan(ops[1]); if not ok then return 1 end
    if n == 3 then
      step, ok = seq_scan(ops[2]); if not ok then return 1 end
      if step.value == 0 then return seq_usage_fail("invalid Zero increment value: '" .. ops[2] .. "'") end
    end
    last, ok = seq_scan(ops[n]); if not ok then return 1 end
  end
  -- fast path for integral values that print as plain digits
  if plain and seq_finite(first.value) and first.precision == 0 and step.precision == 0 and
      last.precision == 0 and 0 <= first.value and 0 <= last.value and 0 < step.value and step.value <= 200 then
    local buf: [512]byte
    local s1 = string.copy(seq_fmt('%0.Lf', first.value, &buf))
    local s2: string = 'inf'
    if seq_finite(last.value) then s2 = string.copy(seq_fmt('%0.Lf', last.value, &buf)) end
    if s1:byte(1) ~= '-'_b and s2:byte(1) ~= '-'_b then
      seq_fast(s1, s2, (@integer)(step.value), sep)
      return util.flush() and 0 or 1
    end
  end
  local prefix, suffix: integer = 0, 0
  if has_fmt then
    local err: string
    fmt, prefix, suffix, err = seq_ldformat(fmt)
    if err.size > 0 then return util.die(err) end
  else
    local prec = first.precision > step.precision and first.precision or step.precision
    fmt = '%Lg'
    if prec ~= SEQ_NOPREC and last.precision ~= SEQ_NOPREC then
      if equal then
        local fw = first.width + (prec - first.precision)
        local lw = last.width + (prec - last.precision)
        if last.precision ~= 0 and prec == 0 then lw = lw - 1 end
        if last.precision == 0 and prec ~= 0 then lw = lw + 1 end
        if first.precision == 0 and prec ~= 0 then fw = fw + 1 end
        fmt = string.format('%%0%d.%dLf', fw > lw and fw or lw, prec)
      else
        fmt = string.format('%%.%dLf', prec)
      end
    end
  end
  seq_print(fmt, prefix, suffix, first.value, step.value, last.value, sep)
  return util.flush() and 0 or 1
end


