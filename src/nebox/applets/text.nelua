-- Text applets: echo cat head tail wc sort uniq tee grep tr cut rev yes seq printf nl
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.regex'

global function applet_echo(args: sequence(string)): integer
  local i: integer = 1
  local newline, escapes = true, false
  while i <= #args do
    local a = args[i]
    if a == '-n' then newline = false
    elseif a == '-e' then escapes = true
    elseif a == '-E' then escapes = false
    elseif a == '-ne' or a == '-en' then newline = false; escapes = true
    else break end
    i = i + 1
  end
  local stop = false
  for j: integer = i, #args do
    if j > i then util.writebyte(32) end
    if escapes then
      local s, c = util.unescape(args[j])
      util.write(s)
      if c then stop = true; break end
    else
      util.write(args[j])
    end
  end
  if newline and not stop then util.writebyte(10) end
  return 0
end

global function applet_cat(args: sequence(string)): integer
  local o = util.parse(args, 'nbuEvTAs')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then o.operands:push('-') end
  local rc: integer = 0
  local number = o:has('n') or o:has('b')
  local lineno: integer = 0
  for _, path in ipairs(o.operands) do
    local fd = util.openin(path)
    if fd < 0 then rc = 1; continue end
    if number then
      local data, ok = util.readfd(fd)
      if not ok then util.perror(path); rc = 1 end
      local start: usize = 0
      for i: usize = 0, < data.size do
        if data.data[i] == 10 then
          local line = (@string){data=&data.data[start], size=i - start}
          if o:has('b') and line.size == 0 then util.writebyte(10)
          else lineno = lineno + 1; util.writef('%6d\t', lineno); util.line(line) end
          start = i + 1
        end
      end
      if start < data.size then
        lineno = lineno + 1
        util.writef('%6d\t', lineno)
        util.write((@string){data=&data.data[start], size=data.size - start})
      end
    else
      if not util.copyfd(fd) then util.perror(path); rc = 1 end
    end
    if fd ~= 0 then sys.close(fd) end
  end
  return rc
end

-- head/tail share operand handling: "-n N", "-c N", legacy "-N".
local count_plus: boolean = false  -- "+N" was given (tail: from the Nth item)

local tail_follow = false

local function count_args(args: sequence(string)): (sequence(string), boolean, integer, boolean, boolean)
  -- returns operands, bytes-mode, count, verbose, ok
  local rest: sequence(string)
  local bytes = false
  local count: integer = 10
  local quiet, verbose = false, false
  count_plus = false
  tail_follow = false
  local i: integer = 1
  while i <= #args do
    local a = args[i]
    if a == '--' then i = i + 1; break end
    if a.size < 2 or a:byte(1) ~= 45 then break end
    local c = a:byte(2)
    if c == 110 or c == 99 then
      local v: string
      if a.size > 2 then v = a:sub(3) else i = i + 1; if i > #args then return rest, false, 0, false, false end; v = args[i] end
      local n, ok = util.tosize(v)
      if not ok then util.err("invalid number of " .. (c == 110 and "lines" or "bytes") .. ": '" .. v .. "'"); return rest, false, 0, false, false end
      count = n
      count_plus = v:byte(1) == 43
      bytes = c == 99
    elseif c >= 48 and c <= 57 then
      local n, ok = util.tosize(a:sub(2))
      if not ok then return rest, false, 0, false, false end
      count = n
    elseif a == '-q' then quiet = true
    elseif a == '-v' then verbose = true
    elseif a == '-f' or a == '-F' then tail_follow = true
    else
      util.err("invalid option -- '" .. a:sub(2, 2) .. "'")
      return rest, false, 0, false, false
    end
    i = i + 1
  end
  while i <= #args do rest:push(args[i]); i = i + 1 end
  if #rest > 1 and not quiet then verbose = true end
  return rest, bytes, count, verbose, true
end

local function header(path: string, first: boolean)
  if not first then util.writebyte(10) end
  util.write('==> ')
  util.write(path == '-' and 'standard input' or path)
  util.line(' <==')
end

-- head streams: it must stop reading after N lines so `yes | head` ends.
local function head_stream(fd: cint, path: string, bytes: boolean, n: integer): boolean
  local chunk: [65536]byte
  local remaining = n
  while remaining > 0 do
    local want: usize = #chunk
    if bytes and (@usize)(remaining) < want then want = (@usize)(remaining) end
    local r = sys.read(fd, &chunk[0], want)
    if r < 0 then
      if sys.errno() == sys.EINTR then continue end
      util.perror(path)
      return false
    end
    if r == 0 then break end
    local got = (@usize)(r)
    if bytes then
      util.writebytes(&chunk[0], got)
      remaining = remaining - (@integer)(got)
    else
      local stop = got
      for i: usize = 0, < got do
        if chunk[i] == 10 then
          remaining = remaining - 1
          if remaining == 0 then stop = i + 1; break end
        end
      end
      util.writebytes(&chunk[0], stop)
    end
  end
  return true
end

global function applet_head(args: sequence(string)): integer
  local files, bytes, count, verbose, ok = count_args(args)
  if not ok then return 1 end
  if #files == 0 then files:push('-') end
  local rc: integer = 0
  for idx, path in ipairs(files) do
    if verbose then header(path, idx == 1) end
    if count >= 0 then
      local fd = util.openin(path)
      if fd < 0 then rc = 1; continue end
      if not head_stream(fd, path, bytes, count) then rc = 1 end
      if fd ~= 0 then sys.close(fd) end
      util.flush()
      continue
    end
    -- negative count: all but the last N; needs the whole input
    local data, rok = util.readfile(path)
    if not rok then rc = 1; continue end
    local n = count
    if bytes then
      n = (@integer)(data.size) + n; if n < 0 then n = 0 end
      util.writebytes(data.data, (@usize)(n))
    else
      local total: integer = 0
      for i: usize = 0, < data.size do if data.data[i] == 10 then total = total + 1 end end
      if data.size > 0 and data.data[data.size - 1] ~= 10 then total = total + 1 end
      n = total + n; if n < 0 then n = 0 end
      local seen: integer = 0
      local stop: usize = data.size
      if n < total then
        stop = 0
        for i: usize = 0, < data.size do
          if data.data[i] == 10 then
            seen = seen + 1
            if seen == n then stop = i + 1; break end
          end
        end
      end
      util.writebytes(data.data, stop)
    end
  end
  return rc
end

global function applet_tail(args: sequence(string)): integer
  local files, bytes, count, verbose, ok = count_args(args)
  if not ok then return 1 end
  if #files == 0 then files:push('-') end
  local rc: integer = 0
  local sizes: sequence(integer)
  for idx, path in ipairs(files) do
    local data, rok = util.readfile(path)
    if not rok then rc = 1; sizes:push(0); continue end
    if verbose then header(path, idx == 1) end
    if bytes then
      local n = count
      if n < 0 then n = -n end
      local start: integer = 0
      if count_plus then start = n - 1 else start = (@integer)(data.size) - n end
      if start < 0 then start = 0 end
      if start > (@integer)(data.size) then start = (@integer)(data.size) end
      util.writebytes(&data.data[start], data.size - (@usize)(start))
    else
      -- count newlines from the end
      local n = count
      if n < 0 then n = -n end
      if count_plus then
        -- "+N": start at line N
        local want = n
        local line: integer = 1
        local start: usize = 0
        while line < want and start < data.size do
          if data.data[start] == 10 then line = line + 1 end
          start = start + 1
        end
        util.writebytes(&data.data[start], data.size - start)
      else
        if n == 0 then continue end
        local i: isize = (@isize)(data.size) - 1
        if i >= 0 and data.data[i] == 10 then i = i - 1 end
        local seen: integer = 0
        while i >= 0 do
          if data.data[i] == 10 then
            seen = seen + 1
            if seen == n then break end
          end
          i = i - 1
        end
        local start: usize = (@usize)(i + 1)
        util.writebytes(&data.data[start], data.size - start)
      end
    end
    if tail_follow then sizes:push((@integer)(data.size)) else sizes:push(0) end
  end
  if tail_follow and rc == 0 then
    -- poll each file for growth once a second, as GNU does without inotify
    local tick: sys.Timespec = {tv_sec = 1, tv_nsec = 0}
    local last: integer = -1
    while true do
      util.flush()
      sys.nanosleep(&tick, nilptr)
      for idx, path in ipairs(files) do
        if path == '-' then continue end
        local st: sys.Stat
        if sys.stat(path, &st) ~= 0 then continue end
        if st.st_size < sizes[idx] then sizes[idx] = 0 end
        if st.st_size > sizes[idx] then
          local fd = sys.open(path, sys.O_RDONLY, 0)
          if fd < 0 then continue end
          sys.lseek(fd, sizes[idx], 0)
          if #files > 1 and last ~= idx then header(path, false); last = idx end
          local data, _ = util.readfd(fd)
          sys.close(fd)
          util.write(data)
          sizes[idx] = sizes[idx] + (@integer)(data.size)
        end
      end
    end
  end
  return rc
end

local WcShow = @record{wl: boolean, ww: boolean, wc: boolean, wL: boolean, width: integer}

function WcShow:col(first: boolean, v: integer)
  if not first then util.writebyte(32) end
  util.write(string.format('%' .. string.format('%d', self.width) .. 'd', v))
end

function WcShow:line(l: integer, w: integer, c: integer, L: integer, name: string)
  local first = true
  if self.wl then self:col(first, l); first = false end
  if self.ww then self:col(first, w); first = false end
  if self.wc then self:col(first, c); first = false end
  if self.wL then self:col(first, L); first = false end
  if name ~= '-' then util.write(' '); util.write(name) end
  util.writebyte(10)
end

global function applet_wc(args: sequence(string)): integer
  local o = util.parse(args, 'lwcmL')
  if not o:ok() then return util.optfail(o) end
  local wl, ww, wc = o:has('l'), o:has('w'), o:has('c') or o:has('m')
  local wL = o:has('L')
  if not (wl or ww or wc or wL) then wl, ww, wc = true, true, true end
  if #o.operands == 0 then o.operands:push('-') end
  local tl, tw, tc, tL: integer = 0, 0, 0, 0
  local rc: integer = 0
  -- GNU widths: 1 when a single count prints; else digits of the total
  -- size when every input is a regular file; else 7.
  local counts: integer = 0
  if wl then counts = counts + 1 end
  if ww then counts = counts + 1 end
  if wc then counts = counts + 1 end
  if wL then counts = counts + 1 end
  local width: integer = 7
  if counts == 1 then width = 1
  else
    local regular = true
    local total: integer = 0
    for _, path in ipairs(o.operands) do
      local st: sys.Stat
      local r: cint
      if path == '-' then r = sys.fstat(0, &st) else r = sys.stat(path, &st) end
      if r ~= 0 or (st.st_mode & sys.S_IFMT) ~= sys.S_IFREG then regular = false; break end
      total = total + (@integer)(st.st_size)
    end
    if regular then
      width = 1
      while total >= 10 do total = total // 10; width = width + 1 end
    end
  end
  local show: WcShow = {wl, ww, wc, wL, width}
  for _, path in ipairs(o.operands) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    local l, w, L, cur: integer = 0, 0, 0, 0
    local inword = false
    for i: usize = 0, < data.size do
      local b = data.data[i]
      if b == 10 then l = l + 1; if cur > L then L = cur end; cur = 0 else cur = cur + 1 end
      -- GNU wc: whitespace ends a word, a printable byte starts one, and
      -- other bytes (controls, high bytes in the C locale) do neither.
      local space = b == 32 or (b >= 9 and b <= 13)
      if space then inword = false
      elseif b >= 33 and b <= 126 then
        if not inword then inword = true; w = w + 1 end
      end
    end
    if cur > L then L = cur end
    show:line(l, w, (@integer)(data.size), L, path)
    tl = tl + l; tw = tw + w; tc = tc + (@integer)(data.size); if L > tL then tL = L end
  end
  if #o.operands > 1 then show:line(tl, tw, tc, tL, 'total') end
  return rc
end

local function lower(b: byte): byte
  if b >= 65 and b <= 90 then return b + 32 end
  return b
end

local function cmp_fold(a: string, b: string): integer
  local n = a.size < b.size and a.size or b.size
  for i: usize = 0, < n do
    local x, y = lower(a.data[i]), lower(b.data[i])
    if x ~= y then return x < y and -1 or 1 end
  end
  if a.size == b.size then return 0 end
  return a.size < b.size and -1 or 1
end

-- sort: GNU coreutils semantics in the C locale. Keys, field positions and
-- the numeric, human-numeric and version comparisons follow sort.c,
-- strnumcmp-in.h and gnulib filevercmp.c byte for byte.

local SortKey = @record{
  sword: integer, schar: integer,   -- 0-based start field / char; sword -1 = line start
  eword: integer, echar: integer,   -- 0-based end field / char; eword -1 = line end
  skipsblanks: boolean, skipeblanks: boolean,
  numeric: boolean, human: boolean, version: boolean,
  fold: boolean,                    -- -f: translate to upper case
  ignore: integer,                  -- 0 none, 1 nonprinting (-i), 2 nondictionary (-d)
  reverse: boolean,
}
local sort_keys: sequence(SortKey)
local sort_reverse, sort_stable, sort_unique: boolean = false, false, false
local sort_sep: integer = -1   -- -t byte, or -1 for blank runs
local sort_eol: byte = 10

-- Byte at 0-based index i, or 0 past the end (GNU NUL-terminates keys).
local function at(s: string, i: integer): integer
  if i < 0 or i >= (@integer)(s.size) then return 0 end
  return (@integer)(s.data[i])
end
local function sblank(c: integer): boolean return c == 32 or c == 9 or c == 10 end
local function sdigit(c: integer): boolean return c >= 48 and c <= 57 end
local function salpha(c: integer): boolean return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) end
local function salnum(c: integer): boolean return sdigit(c) or salpha(c) end
local function sprint(c: integer): boolean return c >= 32 and c <= 126 end

local function key_ignored(k: SortKey, c: integer): boolean
  if k.ignore == 2 then return not salnum(c) and not sblank(c) end
  if k.ignore == 1 then return not sprint(c) end
  return false
end
local function key_xlate(k: SortKey, c: integer): integer
  if k.fold and c >= 97 and c <= 122 then return c - 32 end
  return c
end

-- begfield: offset where key k starts in line.
local function begfield(line: string, k: SortKey): integer
  local n = (@integer)(line.size)
  local p: integer = 0
  local sword = k.sword
  if sort_sep >= 0 then
    while p < n and sword > 0 do
      sword = sword - 1
      while p < n and at(line, p) ~= sort_sep do p = p + 1 end
      if p < n then p = p + 1 end
    end
  else
    while p < n and sword > 0 do
      sword = sword - 1
      while p < n and sblank(at(line, p)) do p = p + 1 end
      while p < n and not sblank(at(line, p)) do p = p + 1 end
    end
  end
  if k.skipsblanks then while p < n and sblank(at(line, p)) do p = p + 1 end end
  p = p + k.schar
  if p > n then p = n end
  return p
end

-- limfield: offset one past the end of key k in line.
local function limfield(line: string, k: SortKey): integer
  local n = (@integer)(line.size)
  local p: integer = 0
  local eword, echar = k.eword, k.echar
  if echar == 0 then eword = eword + 1 end
  if sort_sep >= 0 then
    while p < n and eword > 0 do
      eword = eword - 1
      while p < n and at(line, p) ~= sort_sep do p = p + 1 end
      if p < n and (eword > 0 or echar > 0) then p = p + 1 end
    end
  else
    while p < n and eword > 0 do
      eword = eword - 1
      while p < n and sblank(at(line, p)) do p = p + 1 end
      while p < n and not sblank(at(line, p)) do p = p + 1 end
    end
  end
  if echar ~= 0 then
    if k.skipeblanks then while p < n and sblank(at(line, p)) do p = p + 1 end end
    p = p + echar
    if p > n then p = n end
  end
  return p
end

local function key_view(line: string, k: SortKey): string
  local n = (@integer)(line.size)
  local lim = n
  if k.eword >= 0 then lim = limfield(line, k) end
  local beg: integer = 0
  if k.sword >= 0 then beg = begfield(line, k)
  elseif k.skipsblanks then
    while beg < lim and sblank(at(line, beg)) do beg = beg + 1 end
  end
  if lim < beg then lim = beg end
  if lim == beg then return '' end
  return (@string){data=&line.data[beg], size=(@usize)(lim - beg)}
end

-- Copy of s with ignored bytes dropped and -f translation applied.
local function key_filtered(s: string, k: SortKey): string
  local sb: stringbuilder
  for i: usize = 0, < s.size do
    local c = (@integer)(s.data[i])
    if not key_ignored(k, c) then sb:writebyte((@byte)(key_xlate(k, c))) end
  end
  return sb:promote()
end

-- gnulib fraccompare: compare fractional parts starting at a[ai], b[bi].
local function fraccompare(a: string, ai: integer, b: string, bi: integer): integer
  if at(a, ai) == 46 and at(b, bi) == 46 then
    while true do
      ai = ai + 1; bi = bi + 1
      if at(a, ai) ~= at(b, bi) then break end
      if not sdigit(at(a, ai)) then return 0 end
    end
    if sdigit(at(a, ai)) and sdigit(at(b, bi)) then return at(a, ai) - at(b, bi) end
    if sdigit(at(a, ai)) then
      while at(a, ai) == 48 do ai = ai + 1 end
      return sdigit(at(a, ai)) and 1 or 0
    end
    if sdigit(at(b, bi)) then
      while at(b, bi) == 48 do bi = bi + 1 end
      return sdigit(at(b, bi)) and -1 or 0
    end
    return 0
  elseif at(a, ai) == 46 then
    ai = ai + 1
    while at(a, ai) == 48 do ai = ai + 1 end
    return sdigit(at(a, ai)) and 1 or 0
  elseif at(b, bi) == 46 then
    bi = bi + 1
    while at(b, bi) == 48 do bi = bi + 1 end
    return sdigit(at(b, bi)) and -1 or 0
  end
  return 0
end

-- gnulib strnumcmp (C locale: '.' decimal point, no thousands separator).
local function strnumcmp(a: string, ai: integer, b: string, bi: integer): integer
  local tmpa, tmpb = at(a, ai), at(b, bi)
  if tmpa == 45 then
    repeat ai = ai + 1; tmpa = at(a, ai) until tmpa ~= 48
    if tmpb ~= 45 then
      if tmpa == 46 then repeat ai = ai + 1; tmpa = at(a, ai) until tmpa ~= 48 end
      if sdigit(tmpa) then return -1 end
      while tmpb == 48 do bi = bi + 1; tmpb = at(b, bi) end
      if tmpb == 46 then repeat bi = bi + 1; tmpb = at(b, bi) until tmpb ~= 48 end
      return sdigit(tmpb) and -1 or 0
    end
    repeat bi = bi + 1; tmpb = at(b, bi) until tmpb ~= 48
    while tmpa == tmpb and sdigit(tmpa) do
      ai = ai + 1; tmpa = at(a, ai)
      bi = bi + 1; tmpb = at(b, bi)
    end
    if (tmpa == 46 and not sdigit(tmpb)) or (tmpb == 46 and not sdigit(tmpa)) then
      return fraccompare(b, bi, a, ai)
    end
    local tmp = tmpb - tmpa
    local loga, logb: integer = 0, 0
    while sdigit(tmpa) do loga = loga + 1; ai = ai + 1; tmpa = at(a, ai) end
    while sdigit(tmpb) do logb = logb + 1; bi = bi + 1; tmpb = at(b, bi) end
    if loga ~= logb then return loga < logb and 1 or -1 end
    if loga == 0 then return 0 end
    return tmp
  elseif tmpb == 45 then
    repeat bi = bi + 1; tmpb = at(b, bi) until tmpb ~= 48
    if tmpb == 46 then repeat bi = bi + 1; tmpb = at(b, bi) until tmpb ~= 48 end
    if sdigit(tmpb) then return 1 end
    while tmpa == 48 do ai = ai + 1; tmpa = at(a, ai) end
    if tmpa == 46 then repeat ai = ai + 1; tmpa = at(a, ai) until tmpa ~= 48 end
    return sdigit(tmpa) and 1 or 0
  end
  while tmpa == 48 do ai = ai + 1; tmpa = at(a, ai) end
  while tmpb == 48 do bi = bi + 1; tmpb = at(b, bi) end
  while tmpa == tmpb and sdigit(tmpa) do
    ai = ai + 1; tmpa = at(a, ai)
    bi = bi + 1; tmpb = at(b, bi)
  end
  if (tmpa == 46 and not sdigit(tmpb)) or (tmpb == 46 and not sdigit(tmpa)) then
    return fraccompare(a, ai, b, bi)
  end
  local tmp = tmpa - tmpb
  local loga, logb: integer = 0, 0
  while sdigit(tmpa) do loga = loga + 1; ai = ai + 1; tmpa = at(a, ai) end
  while sdigit(tmpb) do logb = logb + 1; bi = bi + 1; tmpb = at(b, bi) end
  if loga ~= logb then return loga < logb and -1 or 1 end
  if loga == 0 then return 0 end
  return tmp
end

local function skip_blanks(s: string): integer
  local i: integer = 0
  while sblank(at(s, i)) do i = i + 1 end
  return i
end

local function numcompare(a: string, b: string): integer
  return strnumcmp(a, skip_blanks(a), b, skip_blanks(b))
end

-- -h: order of magnitude of the unit suffix (k K M G T P E Z Y).
local function unit_order(c: integer): integer
  if c == 75 or c == 107 then return 1 end
  if c == 77 then return 2 end
  if c == 71 then return 3 end
  if c == 84 then return 4 end
  if c == 80 then return 5 end
  if c == 69 then return 6 end
  if c == 90 then return 7 end
  if c == 89 then return 8 end
  return 0
end

local function find_unit_order(s: string, i: integer): integer
  local neg = at(s, i) == 45
  if neg then i = i + 1 end
  local maxd: integer = 0
  local ch = at(s, i); i = i + 1
  while sdigit(ch) do
    if ch > maxd then maxd = ch end
    ch = at(s, i); i = i + 1
  end
  if ch == 46 then
    ch = at(s, i); i = i + 1
    while sdigit(ch) do
      if ch > maxd then maxd = ch end
      ch = at(s, i); i = i + 1
    end
  end
  if maxd > 48 then
    local o = unit_order(ch)
    return neg and -o or o
  end
  return 0
end

local function human_numcompare(a: string, b: string): integer
  local ai, bi = skip_blanks(a), skip_blanks(b)
  local diff = find_unit_order(a, ai) - find_unit_order(b, bi)
  if diff ~= 0 then return diff end
  return strnumcmp(a, ai, b, bi)
end

-- gnulib filevercmp: length of s without its (\.[A-Za-z~][A-Za-z0-9~]*)*$ suffix.
local function file_prefixlen(s: string): integer
  local n = (@integer)(s.size)
  local prefixlen: integer = 0
  local i: integer = 0
  while true do
    if i == n then return prefixlen end
    i = i + 1
    prefixlen = i
    while i + 1 < n and at(s, i) == 46 and (salpha(at(s, i + 1)) or at(s, i + 1) == 126) do
      i = i + 2
      while i < n and (salnum(at(s, i)) or at(s, i) == 126) do i = i + 1 end
    end
  end
  return prefixlen
end

local function verorder(s: string, pos: integer, len: integer): integer
  if pos == len then return -1 end
  local c = at(s, pos)
  if sdigit(c) then return 0 end
  if salpha(c) then return c end
  if c == 126 then return -2 end
  return c + 256
end

local function verrevcmp(s1: string, l1: integer, s2: string, l2: integer): integer
  local p1, p2: integer = 0, 0
  while p1 < l1 or p2 < l2 do
    local first_diff: integer = 0
    while (p1 < l1 and not sdigit(at(s1, p1))) or (p2 < l2 and not sdigit(at(s2, p2))) do
      local c1, c2 = verorder(s1, p1, l1), verorder(s2, p2, l2)
      if c1 ~= c2 then return c1 - c2 end
      p1 = p1 + 1; p2 = p2 + 1
    end
    while p1 < l1 and at(s1, p1) == 48 do p1 = p1 + 1 end
    while p2 < l2 and at(s2, p2) == 48 do p2 = p2 + 1 end
    while p1 < l1 and p2 < l2 and sdigit(at(s1, p1)) and sdigit(at(s2, p2)) do
      if first_diff == 0 then first_diff = at(s1, p1) - at(s2, p2) end
      p1 = p1 + 1; p2 = p2 + 1
    end
    if p1 < l1 and sdigit(at(s1, p1)) then return 1 end
    if p2 < l2 and sdigit(at(s2, p2)) then return -1 end
    if first_diff ~= 0 then return first_diff end
  end
  return 0
end

local function filevercmp(a: string, b: string): integer
  local alen, blen = (@integer)(a.size), (@integer)(b.size)
  if alen == 0 then return blen ~= 0 and -1 or 0 end
  if blen == 0 then return 1 end
  if at(a, 0) == 46 then
    if at(b, 0) ~= 46 then return -1 end
    local adot, bdot = alen == 1, blen == 1
    if adot then return bdot and 0 or -1 end
    if bdot then return 1 end
    local adotdot = at(a, 1) == 46 and alen == 2
    local bdotdot = at(b, 1) == 46 and blen == 2
    if adotdot then return bdotdot and 0 or -1 end
    if bdotdot then return 1 end
  elseif at(b, 0) == 46 then
    return 1
  end
  local aprefix, bprefix = file_prefixlen(a), file_prefixlen(b)
  local one_pass = aprefix == alen and bprefix == blen
  local result = verrevcmp(a, aprefix, b, bprefix)
  if result ~= 0 or one_pass then return result end
  return verrevcmp(a, alen, b, blen)
end

-- Plain byte comparison as GNU does it (memcmp, then length).
local function bytecmp(a: string, b: string): integer
  if a.size == 0 then return b.size ~= 0 and -1 or 0 end
  if b.size == 0 then return 1 end
  local n = a.size < b.size and a.size or b.size
  for i: usize = 0, < n do
    local x, y = (@integer)(a.data[i]), (@integer)(b.data[i])
    if x ~= y then return x - y end
  end
  if a.size == b.size then return 0 end
  return a.size < b.size and -1 or 1
end

local function compare_key(a: string, b: string, k: SortKey): integer
  local ka, kb = key_view(a, k), key_view(b, k)
  local diff: integer = 0
  if k.numeric or k.human or k.version then
    if k.ignore ~= 0 or k.fold then ka = key_filtered(ka, k); kb = key_filtered(kb, k) end
    if k.numeric then diff = numcompare(ka, kb)
    elseif k.human then diff = human_numcompare(ka, kb)
    else diff = filevercmp(ka, kb) end
  elseif k.ignore ~= 0 then
    local na, nb = (@integer)(ka.size), (@integer)(kb.size)
    local i, j: integer = 0, 0
    while true do
      while i < na and key_ignored(k, at(ka, i)) do i = i + 1 end
      while j < nb and key_ignored(k, at(kb, j)) do j = j + 1 end
      if not (i < na and j < nb) then break end
      diff = key_xlate(k, at(ka, i)) - key_xlate(k, at(kb, j))
      if diff ~= 0 then break end
      i = i + 1; j = j + 1
    end
    if diff == 0 then diff = (i < na and 1 or 0) - (j < nb and 1 or 0) end
  elseif k.fold then
    local na, nb = (@integer)(ka.size), (@integer)(kb.size)
    if na == 0 then diff = nb ~= 0 and -1 or 0
    elseif nb == 0 then diff = 1
    else
      local i: integer = 0
      while i < na and i < nb do
        diff = key_xlate(k, at(ka, i)) - key_xlate(k, at(kb, i))
        if diff ~= 0 then break end
        i = i + 1
      end
      if diff == 0 then diff = na < nb and -1 or (na ~= nb and 1 or 0) end
    end
  else
    diff = bytecmp(ka, kb)
  end
  return k.reverse and -diff or diff
end

-- GNU compare(): keys first, then the whole line unless -s or -u.
local function sort_compare(a: string, b: string): integer
  if #sort_keys > 0 then
    for i = 1, #sort_keys do
      local diff = compare_key(a, b, sort_keys[i])
      if diff ~= 0 then return diff end
    end
    if sort_unique or sort_stable then return 0 end
  end
  local diff = bytecmp(a, b)
  return sort_reverse and -diff or diff
end

local function sort_less(a: string, b: string): boolean
  return sort_compare(a, b) < 0
end

-- Split on the line terminator; a final unterminated line still counts.
local function sort_lines(data: string): sequence(string)
  local out: sequence(string)
  local start: usize = 0
  for i: usize = 0, < data.size do
    if data.data[i] == sort_eol then
      out:push((@string){data=&data.data[start], size=i - start})
      start = i + 1
    end
  end
  if start < data.size then
    out:push((@string){data=&data.data[start], size=data.size - start})
  end
  return out
end

local function badfieldspec(spec: string, msg: string): integer
  util.err(msg .. ": invalid field specification '" .. spec .. "'")
  return 2
end

-- Ordering letters shared by the global options and key modifiers.
-- where: 0 = both blank sides (global), 1 = key start, 2 = key end.
local function set_ordering(k: *SortKey, c: integer, where: integer): boolean
  if c == 98 then
    if where ~= 2 then k.skipsblanks = true end
    if where ~= 1 then k.skipeblanks = true end
  elseif c == 100 then k.ignore = 2
  elseif c == 102 then k.fold = true
  elseif c == 104 then k.human = true
  elseif c == 105 then if k.ignore == 0 then k.ignore = 1 end
  elseif c == 110 then k.numeric = true
  elseif c == 114 then k.reverse = true
  elseif c == 86 then k.version = true
  else return false end
  return true
end

local function default_key_compare(k: SortKey): boolean
  return not (k.ignore ~= 0 or k.fold or k.skipsblanks or k.skipeblanks or k.numeric or k.human or k.version)
end

local function keynum(spec: string, start: integer): (integer, integer, boolean)
  local v: integer = 0
  local j = start
  local n = (@integer)(spec.size)
  while j < n and sdigit(at(spec, j)) do v = v * 10 + (at(spec, j) - 48); j = j + 1 end
  return v, j, j > start
end

-- Parse POS1[,POS2] into k; returns 0 or an exit status after a diagnostic.
local function parse_keyspec(spec: string, k: *SortKey): integer
  local i: integer = 0
  local n = (@integer)(spec.size)
  local v: integer, ok: boolean
  v, i, ok = keynum(spec, 0)
  if not ok then return badfieldspec(spec, 'invalid number at field start') end
  if v == 0 then return badfieldspec(spec, 'field number is zero') end
  k.sword = v - 1; k.schar = 0
  if at(spec, i) == 46 then
    v, i, ok = keynum(spec, i + 1)
    if not ok then return badfieldspec(spec, "invalid number after '.'") end
    if v == 0 then return badfieldspec(spec, 'character offset is zero') end
    k.schar = v - 1
  end
  if k.sword == 0 and k.schar == 0 then k.sword = -1 end
  while i < n and at(spec, i) ~= 44 do
    if not set_ordering(k, at(spec, i), 1) then return badfieldspec(spec, 'stray character in field spec') end
    i = i + 1
  end
  k.eword = -1; k.echar = 0
  if i < n then
    v, i, ok = keynum(spec, i + 1)
    if not ok then return badfieldspec(spec, "invalid number after ','") end
    if v == 0 then return badfieldspec(spec, 'field number is zero') end
    k.eword = v - 1
    if at(spec, i) == 46 then
      v, i, ok = keynum(spec, i + 1)
      if not ok then return badfieldspec(spec, "invalid number after '.'") end
      k.echar = v
    end
    while i < n do
      if not set_ordering(k, at(spec, i), 2) then return badfieldspec(spec, 'stray character in field spec') end
      i = i + 1
    end
  end
  return 0
end

local function sort_emit(l: string)
  util.write(l)
  util.writebyte(sort_eol)
end

global function applet_sort(args: sequence(string)): integer
  local o = util.parse(args, 'bcCdfhimnrsuVzo:k:t:')
  if not o:ok() then util.optfail(o); return 2 end
  local gkey: SortKey
  gkey.sword = -1; gkey.eword = -1
  local flags = 'bdfhinrV'
  for i: usize = 1, flags.size do
    if o:has(flags:sub(i, i)) then set_ordering(&gkey, (@integer)(flags:byte(i)), 0) end
  end
  sort_reverse, sort_stable, sort_unique = o:has('r'), o:has('s'), o:has('u')
  if o:has('z') then sort_eol = 0 else sort_eol = 10 end
  sort_sep = -1
  sort_keys:clear()
  if o:has('t') then
    local t = o:get('t')
    if t.size == 0 then util.err('empty tab'); return 2 end
    if t == '\\0' then sort_sep = 0
    elseif t.size ~= 1 then util.err("multi-character tab '" .. t .. "'"); return 2
    else sort_sep = t:byte(1) end
  end
  for _, spec in ipairs(o:all('k')) do
    local k: SortKey
    local rc = parse_keyspec(spec, &k)
    if rc ~= 0 then return rc end
    sort_keys:push(k)
  end
  -- Keys without ordering options of their own inherit the global ones.
  for i = 1, #sort_keys do
    local k = &sort_keys[i]
    if default_key_compare($k) and not k.reverse then
      k.ignore = gkey.ignore; k.fold = gkey.fold
      k.skipsblanks = gkey.skipsblanks; k.skipeblanks = gkey.skipeblanks
      k.numeric = gkey.numeric; k.human = gkey.human; k.version = gkey.version
      k.reverse = gkey.reverse
    end
  end
  if #sort_keys == 0 and not default_key_compare(gkey) then sort_keys:push(gkey) end
  for i = 1, #sort_keys do
    local k = sort_keys[i]
    local kinds = (k.numeric and 1 or 0) + (k.human and 1 or 0) + (k.version and 1 or 0)
    if kinds > 1 then
      local s: string = (k.numeric and 'n' or '') .. (k.human and 'h' or '') .. (k.version and 'V' or '')
      util.err("options '-" .. s .. "' are incompatible"); return 2
    end
  end
  local check = o:has('c') or o:has('C')
  if check and o:has('o') then
    util.err("options '-" .. (o:has('c') and 'c' or 'C') .. "o' are incompatible"); return 2
  end
  if #o.operands == 0 then o.operands:push('-') end
  if check and #o.operands > 1 then
    util.err("extra operand '" .. o.operands[2] .. "' not allowed with -" .. (o:has('c') and 'c' or 'C')); return 2
  end
  local inputs: sequence(sequence(string))
  for _, path in ipairs(o.operands) do
    local data, ok = util.readfile(path)
    if not ok then return 2 end
    inputs:push(sort_lines(data))
  end
  if check then
    local all = inputs[1]
    for i = 2, #all do
      local r = sort_compare(all[i - 1], all[i])
      if r > 0 or (sort_unique and r == 0) then
        if o:has('c') then util.errf('%s:%d: disorder: %s', o.operands[1], i, all[i]) end
        return 1
      end
    end
    return 0
  end
  local all: sequence(string)
  if o:has('m') then
    -- GNU mergefps: take the smallest head, earlier file first on ties.
    local pos: sequence(integer)
    for i = 1, #inputs do pos:push(1) end
    while true do
      local best: integer = 0
      for f = 1, #inputs do
        if pos[f] <= #inputs[f] then
          if best == 0 or sort_compare(inputs[f][pos[f]], inputs[best][pos[best]]) < 0 then best = f end
        end
      end
      if best == 0 then break end
      all:push(inputs[best][pos[best]])
      pos[best] = pos[best] + 1
    end
  else
    for f = 1, #inputs do
      for _, l in ipairs(inputs[f]) do all:push(l) end
    end
    util.sort(all, sort_less)
  end
  if o:has('o') then
    local fd = sys.open(o:get('o'), sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, 0x1B6)
    if fd < 0 then util.perror(o:get('o')); return 2 end
    util.setout(fd)
  end
  local prev: string
  local have = false
  for _, l in ipairs(all) do
    if sort_unique and have and sort_compare(prev, l) == 0 then continue end
    sort_emit(l)
    prev = l
    have = true
  end
  util.flush()
  util.setout(1)
  return 0
end

global function applet_uniq(args: sequence(string)): integer
  local o = util.parse(args, 'cdui')
  if not o:ok() then return util.optfail(o) end
  local inpath = #o.operands >= 1 and o.operands[1] or '-'
  local data, ok = util.readfile(inpath)
  if not ok then return 1 end
  if #o.operands >= 2 then
    local fd = sys.open(o.operands[2], sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, 0x1B6)
    if fd < 0 then util.perror(o.operands[2]); return 1 end
    util.setout(fd)
  end
  local lines = util.lines(data)
  local fold, onlydup, onlyuniq, count = o:has('i'), o:has('d'), o:has('u'), o:has('c')
  local i: integer = 1
  while i <= #lines do
    local j = i
    while j + 1 <= #lines do
      local same: boolean
      if fold then same = cmp_fold(lines[j + 1], lines[i]) == 0 else same = lines[j + 1] == lines[i] end
      if not same then break end
      j = j + 1
    end
    local n = j - i + 1
    local skip = (onlydup and n < 2) or (onlyuniq and n > 1)
    if not skip then
      if count then util.writef('%7d ', n) end
      util.line(lines[i])
    end
    i = j + 1
  end
  util.flush()
  util.setout(1)
  return 0
end

global function applet_tee(args: sequence(string)): integer
  local o = util.parse(args, 'ai')
  if not o:ok() then return util.optfail(o) end
  local fds: sequence(cint)
  local rc: integer = 0
  local flags = sys.O_WRONLY | sys.O_CREAT | (o:has('a') and sys.O_APPEND or sys.O_TRUNC)
  for _, path in ipairs(o.operands) do
    local fd = sys.open(path, flags, 0x1B6)
    if fd < 0 then util.perror(path); rc = 1 else fds:push(fd) end
  end
  local chunk: [65536]byte
  while true do
    local r = sys.read(0, &chunk[0], #chunk)
    if r < 0 then if sys.errno() == sys.EINTR then continue end; break end
    if r == 0 then break end
    util.writebytes(&chunk[0], (@usize)(r))
    util.flush()
    for _, fd in ipairs(fds) do
      local done: clong = 0
      while done < r do
        local w = sys.write(fd, &chunk[done], (@usize)(r - done))
        if w < 0 then rc = 1; break end
        done = done + w
      end
    end
  end
  for _, fd in ipairs(fds) do sys.close(fd) end
  return rc
end

-- grep: fixed-string matching only (no regular expressions yet).
local function find_fold(hay: string, needle: string): boolean
  if needle.size == 0 then return true end
  if needle.size > hay.size then return false end
  for i: usize = 0, hay.size - needle.size do
    local ok = true
    for j: usize = 0, < needle.size do
      if lower(hay.data[i + j]) ~= lower(needle.data[j]) then ok = false; break end
    end
    if ok then return true end
  end
  return false
end

local function isword(b: byte): boolean
  return (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95
end

local function find_word(hay: string, needle: string, fold: boolean): boolean
  if needle.size == 0 or needle.size > hay.size then return false end
  for i: usize = 0, hay.size - needle.size do
    local ok = true
    for j: usize = 0, < needle.size do
      local a, b = hay.data[i + j], needle.data[j]
      if fold then a, b = lower(a), lower(b) end
      if a ~= b then ok = false; break end
    end
    if ok then
      local before = i == 0 or not isword(hay.data[i - 1])
      local after = i + needle.size >= hay.size or not isword(hay.data[i + needle.size])
      if before and after then return true end
    end
  end
  return false
end

-- Build one regex covering every pattern, honouring -w / -x by wrapping.
local function grep_compile(patterns: sequence(string), ere: boolean, icase: boolean, word: boolean, whole: boolean): (regex.Prog, string)
  local sb: stringbuilder
  -- (?: groups are an internal non-capturing extension so user back-references keep their numbers
  local open: string = ere and '(?:' or '\\(?:'
  local close: string = ere and ')' or '\\)'
  local bar: string = ere and '|' or '\\|'
  for i, p in ipairs(patterns) do
    if i > 1 then sb:write(bar) end
    sb:write(open); sb:write(p); sb:write(close)
  end
  local body = sb:promote()
  if whole then body = '^' .. open .. body .. close .. '$'
  elseif word then body = open .. '^' .. bar .. '[^[:alnum:]_]' .. close .. open .. body .. close .. open .. '[^[:alnum:]_]' .. bar .. '$' .. close end
  return regex.compile(body, ere, icase)
end

global function applet_grep(args: sequence(string)): integer
  local o = util.parse(args, 'ivnclqHhFEGwxe:srom:')
  if not o:ok() then return util.optfail(o) + 1 end
  local patterns: sequence(string)
  local operands = o.operands
  if o:has('e') then
    for _, e in ipairs(o:all('e')) do
      for _, p in ipairs(util.lines(e)) do patterns:push(p) end
      if e.size == 0 then patterns:push('') end
    end
  else
    if #operands == 0 then util.err('usage: grep [-ivnclqHhFEGwxors] [-e] PATTERN [FILE...]'); return 2 end
    for _, p in ipairs(util.lines(operands[1])) do patterns:push(p) end
    if operands[1].size == 0 then patterns:push('') end
    operands:remove(1)
  end
  if o:has('r') and #operands == 0 then operands:push('.') end
  if #operands == 0 then operands:push('-') end
  local fold, invert = o:has('i'), o:has('v')
  local fixed = o:has('F')
  local prog: regex.Prog
  if not fixed then
    local err: string
    prog, err = grep_compile(patterns, o:has('E'), fold, o:has('w'), o:has('x'))
    if err.size > 0 then util.err(err); return 2 end
  end
  local maxcount: integer = -1
  if o:has('m') then
    local v, ok = util.toint(o:get('m'))
    if not ok then util.err('invalid max count'); return 2 end
    maxcount = v
  end
  -- expand -r directories into files
  if o:has('r') then
    local expanded: sequence(string)
    local stack: sequence(string)
    for _, p in ipairs(operands) do stack:push(p) end
    local i: integer = 1
    while i <= #stack do
      local p = stack[i]
      if util.isdir(p) then
        local names, ok = util.readnames(p, true)
        if ok then
          for _, n in ipairs(names) do
            if n ~= '.' and n ~= '..' then stack:push(p == '.' and n or util.join(p, n)) end
          end
        end
      else
        expanded:push(p)
      end
      i = i + 1
    end
    operands = expanded
  end
  local withname = (#operands > 1 or o:has('H') or o:has('r')) and not o:has('h')
  local anymatch = false
  local rc: integer = 0
  local caps: regex.Caps
  for _, path in ipairs(operands) do
    local data, ok = util.readfile(path)
    if not ok then rc = 2; continue end
    local count: integer = 0
    local n: integer = 0
    for _, line in ipairs(util.lines(data)) do
      n = n + 1
      local m = false
      if fixed then
        for _, p in ipairs(patterns) do
          if o:has('x') then
            m = fold and cmp_fold(line, p) == 0 or line == p
          elseif o:has('w') then
            m = find_word(line, p, fold)
          elseif fold then
            m = find_fold(line, p)
          else
            m = line:find(p, 1, true) > 0
          end
          if m then break end
        end
      else
        m = prog:search(line, 0, &caps)
        if prog.toocomplex then util.err('pattern too complex'); return 2 end
      end
      if m ~= invert then
        count = count + 1
        anymatch = true
        if o:has('q') then return 0 end
        if o:has('l') then break end
        if not o:has('c') then
          if o:has('o') and not fixed and not invert then
            local pos: isize = 0
            while pos <= (@isize)(line.size) and prog:search(line, pos, &caps) do
              if caps.at[1] > caps.at[0] then
                if withname then util.write(path); util.writebyte(58) end
                if o:has('n') then util.writef('%d:', n) end
                util.line(line:sub(caps.at[0] + 1, caps.at[1]))
                pos = caps.at[1]
              else
                pos = caps.at[0] + 1
              end
            end
            if prog.toocomplex then util.err('pattern too complex'); return 2 end
          else
            if withname then util.write(path); util.writebyte(58) end
            if o:has('n') then util.writef('%d:', n) end
            util.line(line)
          end
        end
        if maxcount >= 0 and count >= maxcount then break end
      end
    end
    if o:has('l') then
      if count > 0 then util.line(path) end
    elseif o:has('c') then
      if withname then util.write(path); util.writebyte(58) end
      util.writef('%d\n', count)
    end
  end
  if rc ~= 0 then return rc end
  return anymatch and 0 or 1
end

-- tr: expand a set with ranges and escapes into bytes
local function class_bytes(name: string, out: *sequence(byte)): boolean
  local lo: integer, hi: integer = 0, 255
  if name == 'alpha' then for b = 65, 90 do out:push((@byte)(b)) end; for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'digit' then for b = 48, 57 do out:push((@byte)(b)) end
  elseif name == 'alnum' then for b = 48, 57 do out:push((@byte)(b)) end; for b = 65, 90 do out:push((@byte)(b)) end; for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'upper' then for b = 65, 90 do out:push((@byte)(b)) end
  elseif name == 'lower' then for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'space' then for b = 9, 13 do out:push((@byte)(b)) end; out:push(32)
  elseif name == 'blank' then out:push(9); out:push(32)
  elseif name == 'punct' then
    for b = 33, 47 do out:push((@byte)(b)) end; for b = 58, 64 do out:push((@byte)(b)) end
    for b = 91, 96 do out:push((@byte)(b)) end; for b = 123, 126 do out:push((@byte)(b)) end
  elseif name == 'print' then for b = 32, 126 do out:push((@byte)(b)) end
  elseif name == 'graph' then for b = 33, 126 do out:push((@byte)(b)) end
  elseif name == 'cntrl' then for b = 0, 31 do out:push((@byte)(b)) end; out:push(127)
  elseif name == 'xdigit' then for b = 48, 57 do out:push((@byte)(b)) end; for b = 65, 70 do out:push((@byte)(b)) end; for b = 97, 102 do out:push((@byte)(b)) end
  else return false end
  local _ = lo + hi
  return true
end

-- Expand a tr set: ranges, [:class:], [c*n] repeats, and escapes. `fill` is
-- the length to pad [c*] repeats to (the size of set1), or 0.
local function expand_set(s: string, fill: integer): sequence(byte)
  local out: sequence(byte)
  local u = util.unescape(s)
  local i: usize = 1
  while i <= u.size do
    local c = u:byte(i)
    if c == 91 and i + 1 <= u.size and u:byte(i + 1) == 58 then
      local close = u:find(':]', i + 2, true)
      if close > 0 and class_bytes(u:sub(i + 2, close - 1), &out) then
        i = (@usize)(close) + 2
        continue
      end
    end
    if c == 91 and i + 2 <= u.size and u:byte(i + 2) == 42 then
      local close = u:find(']', i + 3, true)
      if close > 0 then
        local ch = u:byte(i + 1)
        local cnt, ok = util.toint(u:sub(i + 3, close - 1))
        if close == (@isize)(i) + 3 then cnt = fill - (@integer)(#out); ok = true end
        if ok then
          for _ = 1, cnt do out:push(ch) end
          i = (@usize)(close) + 1
          continue
        end
      end
    end
    if i + 2 <= u.size and u:byte(i + 1) == 45 then
      local hi = u:byte(i + 2)
      if hi >= c then
        for b: integer = c, hi do out:push((@byte)(b)) end
        i = i + 3
        continue
      end
    end
    out:push(c)
    i = i + 1
  end
  return out
end

global function applet_tr(args: sequence(string)): integer
  local o = util.parse(args, 'dsc')
  if not o:ok() then return util.optfail(o) end
  if #o.operands < 1 then util.err('missing operand'); return 1 end
  local set1 = expand_set(o.operands[1], 0)
  local in1: [256]boolean
  for _, b in ipairs(set1) do in1[b] = true end
  if o:has('c') then for b: integer = 0, 255 do in1[b] = not in1[b] end end
  local map: [256]byte
  for b: integer = 0, 255 do map[b] = (@byte)(b) end
  local deleting = o:has('d')
  if not deleting and o:has('s') and #o.operands == 1 then
    -- squeeze only
  elseif not deleting then
    if #o.operands < 2 then util.err('missing operand after \'' .. o.operands[1] .. '\''); return 1 end
    local set2 = expand_set(o.operands[2], #set1)
    if #set2 == 0 then util.err('when not truncating set1, string2 must be non-empty'); return 1 end
    if o:has('c') then
      local last = set2[#set2]
      for b: integer = 0, 255 do if in1[b] then map[b] = last end end
    else
      for i: integer = 1, #set1 do
        local j = i <= #set2 and i or #set2
        map[set1[i]] = set2[j]
      end
    end
  end
  local data, ok = util.readfd(0)
  if not ok then return 1 end
  local squeeze = o:has('s')
  local last: integer = -1
  for i: usize = 0, < data.size do
    local b = data.data[i]
    if deleting and in1[b] then continue end
    local outb = map[b]
    if squeeze and in1[b] and (@integer)(outb) == last then continue end
    util.writebyte(outb)
    last = in1[b] and (@integer)(outb) or -1
  end
  return 0
end

-- cut: field/char lists like "1,3-5,7-"
local Range = @record{lo: integer, hi: integer}

local function parse_list(s: string): (sequence(Range), boolean)
  local out: sequence(Range)
  local start: usize = 1
  for i: usize = 1, s.size + 1 do
    if i > s.size or s:byte(i) == 44 then
      local part = s:sub(start, i - 1)
      start = i + 1
      if part.size == 0 then return out, false end
      local dash = part:find('-', 1, true)
      local r: Range = {1, 0x7fffffff}
      if dash == 0 then
        local v, ok = util.toint(part); if not ok or v < 1 then return out, false end
        r.lo, r.hi = v, v
      else
        if dash > 1 then local v, ok = util.toint(part:sub(1, dash - 1)); if not ok then return out, false end; r.lo = v end
        if dash < (@isize)(part.size) then local v, ok = util.toint(part:sub(dash + 1)); if not ok then return out, false end; r.hi = v end
        if r.lo < 1 or r.hi < r.lo then return out, false end
      end
      out:push(r)
    end
  end
  return out, #out > 0
end

local function inlist(list: sequence(Range), n: integer): boolean
  for _, r in ipairs(list) do if n >= r.lo and n <= r.hi then return true end end
  return false
end

global function applet_cut(args: sequence(string)): integer
  local o = util.parse(args, 'b:c:f:d:sn')
  if not o:ok() then return util.optfail(o) end
  local mode: string = ''
  local spec: string
  if o:has('f') then mode = 'f'; spec = o:get('f')
  elseif o:has('c') then mode = 'c'; spec = o:get('c')
  elseif o:has('b') then mode = 'c'; spec = o:get('b') end
  if mode == '' then util.err('you must specify a list of bytes, characters, or fields'); return 1 end
  local list, ok = parse_list(spec)
  if not ok then util.err("invalid list '" .. spec .. "'"); return 1 end
  local delim: byte = 9
  if o:has('d') then
    local d = o:get('d')
    if d.size ~= 1 then util.err('the delimiter must be a single character'); return 1 end
    delim = d:byte(1)
  end
  if #o.operands == 0 then o.operands:push('-') end
  local rc: integer = 0
  for _, path in ipairs(o.operands) do
    local data, rok = util.readfile(path)
    if not rok then rc = 1; continue end
    for _, line in ipairs(util.lines(data)) do
      if mode == 'c' then
        for i: usize = 0, < line.size do
          if inlist(list, (@integer)(i) + 1) then util.writebyte(line.data[i]) end
        end
        util.writebyte(10)
      else
        local hasdelim = false
        for i: usize = 0, < line.size do if line.data[i] == delim then hasdelim = true; break end end
        if not hasdelim then
          if not o:has('s') then util.line(line) end
          continue
        end
        local field: integer = 1
        local start: usize = 0
        local first = true
        for i: usize = 0, line.size do
          if i == line.size or line.data[i] == delim then
            if inlist(list, field) then
              if not first then util.writebyte(delim) end
              util.writebytes(&line.data[start], i - start)
              first = false
            end
            field = field + 1
            start = i + 1
          end
        end
        util.writebyte(10)
      end
    end
  end
  return rc
end

global function applet_rev(args: sequence(string)): integer
  if #args == 0 then args:push('-') end
  local rc: integer = 0
  for _, path in ipairs(args) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    local start: usize = 0
    for i: usize = 0, data.size do
      if i == data.size or data.data[i] == 10 then
        local j: isize = (@isize)(i) - 1
        while j >= (@isize)(start) do util.writebyte(data.data[j]); j = j - 1 end
        if i < data.size then util.writebyte(10) end
        start = i + 1
      end
    end
  end
  return rc
end

global function applet_yes(args: sequence(string)): integer
  local s: string = 'y'
  if #args > 0 then
    local sb: stringbuilder
    for i, a in ipairs(args) do if i > 1 then sb:writebyte(32) end; sb:write(a) end
    s = sb:promote()
  end
  -- flush after every line so a closed pipe ends the loop
  while true do
    util.line(s)
    if not util.flush() then return 1 end
  end
  return 0
end

global function applet_seq(args: sequence(string)): integer
  -- options by hand: "-2" is a number, not an option
  local sep: string = '\n'
  local pad = false
  local operands: sequence(string)
  local i: integer = 1
  while i <= #args do
    local a = args[i]
    if a == '--' then i = i + 1; break end
    if a.size >= 2 and a:byte(1) == 45 and (a:byte(2) == 115 or a:byte(2) == 119) then
      if a:byte(2) == 119 then pad = true
      elseif a.size > 2 then sep = a:sub(3)
      else
        i = i + 1
        if i > #args then return util.die("option requires an argument -- 's'") end
        sep = args[i]
      end
    elseif a.size >= 2 and a:byte(1) == 45 and not (a:byte(2) >= 48 and a:byte(2) <= 57) and a:byte(2) ~= 46 then
      return util.die("invalid option -- '" .. a:sub(2, 2) .. "'")
    else
      break
    end
    i = i + 1
  end
  while i <= #args do operands:push(args[i]); i = i + 1 end
  local n = #operands
  if n < 1 or n > 3 then util.err(n == 0 and 'missing operand' or 'extra operand'); return 1 end
  local first, inc, last: integer = 1, 1, 0
  local ok: boolean
  if n == 1 then last, ok = util.toint(operands[1])
  elseif n == 2 then
    first, ok = util.toint(operands[1]); if not ok then util.err("invalid argument: '" .. operands[1] .. "'"); return 1 end
    last, ok = util.toint(operands[2])
  else
    first, ok = util.toint(operands[1]); if not ok then util.err("invalid argument: '" .. operands[1] .. "'"); return 1 end
    inc, ok = util.toint(operands[2]); if not ok then util.err("invalid argument: '" .. operands[2] .. "'"); return 1 end
    last, ok = util.toint(operands[3])
  end
  if not ok then util.err("invalid argument: '" .. operands[n] .. "'"); return 1 end
  if inc == 0 then util.err('invalid zero increment value'); return 1 end
  local width: integer = 0
  if pad then
    local a, b = string.format('%d', first), string.format('%d', last)
    width = (@integer)(a.size > b.size and a.size or b.size)
  end
  local v = first
  local any = false
  while (inc > 0 and v <= last) or (inc < 0 and v >= last) do
    if any then util.write(sep) end
    if width > 0 then
      local s = string.format('%d', v)
      local neg = v < 0
      if neg then util.writebyte(45); s = s:sub(2) end
      for _ = (@integer)(s.size) + (neg and 1 or 0), width - 1 do util.writebyte(48) end
      util.write(s)
    else
      util.writef('%d', v)
    end
    any = true
    v = v + inc
  end
  if any then util.writebyte(10) end
  return 0
end

-- printf with %s %d %i %u %x %X %o %c %% and width/precision flags; the
-- format is reused while arguments remain, as coreutils does.
global function applet_printf(args: sequence(string)): integer
  if #args == 0 then util.err('usage: printf FORMAT [ARGUMENT...]'); return 1 end
  local fmt = args[1]
  local ai: integer = 2
  local rc: integer = 0
  repeat
    local before = ai
    local i: usize = 1
    while i <= fmt.size do
      local c = fmt:byte(i)
      if c == 92 then
        -- escape: hand a two-byte slice (or more for octal/hex) to unescape
        local j = i + 1
        while j <= fmt.size and j < i + 4 and fmt:byte(j) >= 48 and fmt:byte(j) <= 55 do j = j + 1 end
        if j == i + 1 and i + 1 <= fmt.size then j = i + 2 end
        if i + 1 <= fmt.size and fmt:byte(i + 1) == 120 then j = i + 2; while j <= fmt.size and j < i + 4 do j = j + 1 end end
        local s, stop = util.unescape(fmt:sub(i, j - 1))
        util.write(s)
        if stop then return rc end
        i = j
      elseif c == 37 then
        if i + 1 <= fmt.size and fmt:byte(i + 1) == 37 then util.writebyte(37); i = i + 2; continue end
        local j = i + 1
        while j <= fmt.size do
          local d = fmt:byte(j)
          if d == 45 or d == 43 or d == 32 or d == 35 or d == 48 or d == 46 or (d >= 49 and d <= 57) then j = j + 1 else break end
        end
        if j > fmt.size then util.err('missing conversion in format'); return 1 end
        local conv = fmt:byte(j)
        local spec = fmt:sub(i, j - 1)
        local a: string = ''
        if ai <= #args then a = args[ai]; ai = ai + 1 end
        if conv == 115 then
          util.write(string.format(spec .. 's', a))
        elseif conv == 99 then
          util.write(string.format(spec .. 's', a.size > 0 and a:sub(1, 1) or ''))
        elseif conv == 100 or conv == 105 or conv == 117 or conv == 120 or conv == 88 or conv == 111 then
          local v: integer = 0
          if a.size > 0 then
            local ok: boolean
            if a:byte(1) == 39 or a:byte(1) == 34 then v = a.size > 1 and a:byte(2) or 0; ok = true
            else
              local base = 10
              local body = a
              if a.size > 2 and a:byte(1) == 48 and (a:byte(2) == 120 or a:byte(2) == 88) then base = 16; body = a:sub(3)
              elseif a.size > 1 and a:byte(1) == 48 then base = 8; body = a:sub(2) end
              if base == 10 then v, ok = util.toint(a)
              else
                ok = true; v = 0
                for k: usize = 1, body.size do
                  local d = body:byte(k)
                  local dv: integer = -1
                  if d >= 48 and d <= 57 then dv = d - 48 elseif d >= 97 and d <= 102 then dv = d - 87 elseif d >= 65 and d <= 70 then dv = d - 55 end
                  if dv < 0 or dv >= base then ok = false; break end
                  v = v * base + dv
                end
              end
            end
            if not ok then util.err("'" .. a .. "': expected a numeric value"); rc = 1; v = 0 end
          end
          local letter = conv == 105 and 'd' or string.char(conv)
          util.write(string.format(spec .. letter, v))
        else
          util.err('%' .. string.char(conv) .. ': invalid conversion specification'); return 1
        end
        i = j + 1
      else
        util.writebyte(c)
        i = i + 1
      end
    end
  until ai > #args or ai == before
  return rc
end

global function applet_nl(args: sequence(string)): integer
  local o = util.parse(args, 'b:s:w:')
  if not o:ok() then return util.optfail(o) end
  local style = o:has('b') and o:get('b') or 't'
  local sep = o:has('s') and o:get('s') or '\t'
  local width: integer = 6
  if o:has('w') then local v, ok = util.toint(o:get('w')); if not ok or v < 1 then util.err('invalid line number field width'); return 1 end; width = v end
  if #o.operands == 0 then o.operands:push('-') end
  local n: integer = 0
  local rc: integer = 0
  for _, path in ipairs(o.operands) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    for _, line in ipairs(util.lines(data)) do
      local number = style == 'a' or (style == 't' and line.size > 0)
      if number then
        n = n + 1
        util.write(string.format('%' .. string.format('%d', width) .. 'd', n))
        util.write(sep)
      else
        for _ = 1, width + (@integer)(sep.size) do util.writebyte(32) end
      end
      util.line(line)
    end
  end
  return rc
end
