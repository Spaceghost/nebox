-- Text applets: echo cat head tail wc sort uniq tee grep tr cut rev yes seq printf nl
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.longopts'
require 'nebox.regex'


-- cat: GNU coreutils 9.1 cat.c. -b -n -s -v -E -T -A -e -t (-u ignored);
-- line numbers, squeezing and a pending CR carry across files; a regular
-- input that is also the output (and not yet at its end) is refused.
local cat_newlines: integer
local cat_pending_cr: boolean
local cat_lineno: integer

local function cat_number()
  cat_lineno = cat_lineno + 1
  util.writef('%6d\t', cat_lineno)
end

local function cat_chunk(buf: *[0]byte, n: integer, show_nonprinting: boolean, show_tabs: boolean,
                         number: boolean, number_nonblank: boolean, show_ends: boolean, squeeze_blank: boolean)
  local i: integer = 0
  while i < n do
    local ch = buf[i]
    i = i + 1
    if ch == 10 then
      cat_newlines = cat_newlines + 1
      if cat_newlines > 0 then
        if cat_newlines >= 2 then
          cat_newlines = 2
          if squeeze_blank then continue end
        end
        if number and not number_nonblank then cat_number() end
      end
      if show_ends then
        if cat_pending_cr then util.write('^M'); cat_pending_cr = false end
        util.writebyte(36)
      end
      util.writebyte(10)
      continue
    end
    if cat_pending_cr then util.writebyte(13); cat_pending_cr = false end
    if cat_newlines >= 0 and number then cat_number() end
    cat_newlines = -1
    if show_nonprinting then
      if ch >= 32 then
        if ch < 127 then util.writebyte(ch)
        elseif ch == 127 then util.write('^?')
        else
          util.write('M-')
          if ch >= 128 + 32 then
            if ch < 128 + 127 then util.writebyte(ch - 128) else util.write('^?') end
          else
            util.writebyte(94); util.writebyte(ch - 128 + 64)
          end
        end
      elseif ch == 9 and not show_tabs then util.writebyte(9)
      else util.writebyte(94); util.writebyte(ch + 64) end
    else
      if ch == 9 and show_tabs then util.write('^I')
      elseif ch == 13 and show_ends and (i >= n or buf[i] == 10) then
        if i >= n then cat_pending_cr = true else util.write('^M') end
      else util.writebyte(ch) end
    end
  end
end

global function applet_cat(args: sequence(string)): integer
  local o = util.parsel(args, 'benstuvAET', &longopts.cat, #longopts.cat)
  if not o:ok() then return util.optfail(o) end
  local number, number_nonblank, squeeze_blank = false, false, false
  local show_ends, show_nonprinting, show_tabs = false, false, false
  for _, c in ipairs(o.order) do
    if c == 98 then number = true; number_nonblank = true
    elseif c == 101 then show_ends = true; show_nonprinting = true
    elseif c == 110 then number = true
    elseif c == 115 then squeeze_blank = true
    elseif c == 116 then show_tabs = true; show_nonprinting = true
    elseif c == 118 then show_nonprinting = true
    elseif c == 65 then show_nonprinting = true; show_ends = true; show_tabs = true
    elseif c == 69 then show_ends = true
    elseif c == 84 then show_tabs = true end
  end
  local simple = not (number or show_ends or show_nonprinting or show_tabs or squeeze_blank)
  cat_newlines = 0; cat_pending_cr = false; cat_lineno = 0
  local ost: sys.Stat
  local out_isreg = false
  if sys.fstat(1, &ost) == 0 then out_isreg = (ost.st_mode & sys.S_IFMT) == sys.S_IFREG end
  if #o.operands == 0 then o.operands:push('-') end
  local ok = true
  local buf: [65536]byte
  for _, infile in ipairs(o.operands) do
    local reading_stdin = infile == '-'
    local fd: cint = 0
    if not reading_stdin then
      fd = sys.open(infile, sys.O_RDONLY, 0)
      if fd < 0 then util.err(util.quotef(infile) .. ': ' .. sys.errstr()); ok = false; continue end
    end
    local st: sys.Stat
    if sys.fstat(fd, &st) ~= 0 then
      util.err(util.quotef(infile) .. ': ' .. sys.errstr()); ok = false
    elseif out_isreg and st.st_dev == ost.st_dev and st.st_ino == ost.st_ino
           and sys.lseek(fd, 0, sys.SEEK_CUR) < st.st_size then
      util.err(util.quotef(infile) .. ': input file is output file'); ok = false
    else
      while true do
        util.flush()
        local n = sys.read(fd, &buf, #buf)
        if n < 0 then
          if sys.errno() == sys.EINTR then continue end
          util.err(util.quotef(infile) .. ': ' .. sys.errstr()); ok = false
          break
        end
        if n == 0 then break end
        if simple then util.writebytes(&buf, (@usize)(n))
        else cat_chunk(&buf, n, show_nonprinting, show_tabs, number, number_nonblank, show_ends, squeeze_blank) end
      end
    end
    if not reading_stdin then sys.close(fd) end
  end
  if cat_pending_cr then util.writebyte(13) end
  util.flush()
  return ok and 0 or 1
end

-- head/tail share operand handling: "-n N", "-c N", legacy "-N".




-- head streams: it must stop reading after N lines so `yes | head` ends.



local function lower(b: byte): byte
  if b >= 65 and b <= 90 then return b + 32 end
  return b
end

local function cmp_fold(a: string, b: string): integer
  local n = a.size < b.size and a.size or b.size
  for i: usize = 0, < n do
    local x, y = lower(a.data[i]), lower(b.data[i])
    if x ~= y then return x < y and -1 or 1 end
  end
  if a.size == b.size then return 0 end
  return a.size < b.size and -1 or 1
end

-- sort: GNU coreutils semantics in the C locale. Keys, field positions and
-- the numeric, human-numeric and version comparisons follow sort.c,
-- strnumcmp-in.h and gnulib filevercmp.c byte for byte.

local SortKey = @record{
  sword: integer, schar: integer,   -- 0-based start field / char; sword -1 = line start
  eword: integer, echar: integer,   -- 0-based end field / char; eword -1 = line end
  skipsblanks: boolean, skipeblanks: boolean,
  numeric: boolean, human: boolean, version: boolean,
  general: boolean, month: boolean, -- -g, -M
  fold: boolean,                    -- -f: translate to upper case
  ignore: integer,                  -- 0 none, 1 nonprinting (-i), 2 nondictionary (-d)
  reverse: boolean,
}
local sort_keys: sequence(SortKey)
local sort_reverse, sort_stable, sort_unique: boolean = false, false, false
local sort_sep: integer = -1   -- -t byte, or -1 for blank runs
local sort_eol: byte = 10

-- Byte at 0-based index i, or 0 past the end (GNU NUL-terminates keys).
local function at(s: string, i: integer): integer
  if i < 0 or i >= (@integer)(s.size) then return 0 end
  return (@integer)(s.data[i])
end
local function sblank(c: integer): boolean return c == 32 or c == 9 or c == 10 end
local function sdigit(c: integer): boolean return c >= 48 and c <= 57 end
local function salpha(c: integer): boolean return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) end
local function salnum(c: integer): boolean return sdigit(c) or salpha(c) end
local function sprint(c: integer): boolean return c >= 32 and c <= 126 end

local function key_ignored(k: SortKey, c: integer): boolean
  if k.ignore == 2 then return not salnum(c) and not sblank(c) end
  if k.ignore == 1 then return not sprint(c) end
  return false
end
local function key_xlate(k: SortKey, c: integer): integer
  if k.fold and c >= 97 and c <= 122 then return c - 32 end
  return c
end

-- begfield: offset where key k starts in line.
local function begfield(line: string, k: SortKey): integer
  local n = (@integer)(line.size)
  local p: integer = 0
  local sword = k.sword
  if sort_sep >= 0 then
    while p < n and sword > 0 do
      sword = sword - 1
      while p < n and at(line, p) ~= sort_sep do p = p + 1 end
      if p < n then p = p + 1 end
    end
  else
    while p < n and sword > 0 do
      sword = sword - 1
      while p < n and sblank(at(line, p)) do p = p + 1 end
      while p < n and not sblank(at(line, p)) do p = p + 1 end
    end
  end
  if k.skipsblanks then while p < n and sblank(at(line, p)) do p = p + 1 end end
  p = p + k.schar
  if p > n then p = n end
  return p
end

-- limfield: offset one past the end of key k in line.
local function limfield(line: string, k: SortKey): integer
  local n = (@integer)(line.size)
  local p: integer = 0
  local eword, echar = k.eword, k.echar
  if echar == 0 then eword = eword + 1 end
  if sort_sep >= 0 then
    while p < n and eword > 0 do
      eword = eword - 1
      while p < n and at(line, p) ~= sort_sep do p = p + 1 end
      if p < n and (eword > 0 or echar > 0) then p = p + 1 end
    end
  else
    while p < n and eword > 0 do
      eword = eword - 1
      while p < n and sblank(at(line, p)) do p = p + 1 end
      while p < n and not sblank(at(line, p)) do p = p + 1 end
    end
  end
  if echar ~= 0 then
    if k.skipeblanks then while p < n and sblank(at(line, p)) do p = p + 1 end end
    p = p + echar
    if p > n then p = n end
  end
  return p
end

local function key_view(line: string, k: SortKey): string
  local n = (@integer)(line.size)
  local lim = n
  if k.eword >= 0 then lim = limfield(line, k) end
  local beg: integer = 0
  if k.sword >= 0 then beg = begfield(line, k)
  elseif k.skipsblanks then
    while beg < lim and sblank(at(line, beg)) do beg = beg + 1 end
  end
  if lim < beg then lim = beg end
  if lim == beg then return '' end
  return (@string){data=&line.data[beg], size=(@usize)(lim - beg)}
end

-- Copy of s with ignored bytes dropped and -f translation applied.
local function key_filtered(s: string, k: SortKey): string
  local sb: stringbuilder
  for i: usize = 0, < s.size do
    local c = (@integer)(s.data[i])
    if not key_ignored(k, c) then sb:writebyte((@byte)(key_xlate(k, c))) end
  end
  return sb:promote()
end

-- gnulib fraccompare: compare fractional parts starting at a[ai], b[bi].
local function fraccompare(a: string, ai: integer, b: string, bi: integer): integer
  if at(a, ai) == 46 and at(b, bi) == 46 then
    while true do
      ai = ai + 1; bi = bi + 1
      if at(a, ai) ~= at(b, bi) then break end
      if not sdigit(at(a, ai)) then return 0 end
    end
    if sdigit(at(a, ai)) and sdigit(at(b, bi)) then return at(a, ai) - at(b, bi) end
    if sdigit(at(a, ai)) then
      while at(a, ai) == 48 do ai = ai + 1 end
      return sdigit(at(a, ai)) and 1 or 0
    end
    if sdigit(at(b, bi)) then
      while at(b, bi) == 48 do bi = bi + 1 end
      return sdigit(at(b, bi)) and -1 or 0
    end
    return 0
  elseif at(a, ai) == 46 then
    ai = ai + 1
    while at(a, ai) == 48 do ai = ai + 1 end
    return sdigit(at(a, ai)) and 1 or 0
  elseif at(b, bi) == 46 then
    bi = bi + 1
    while at(b, bi) == 48 do bi = bi + 1 end
    return sdigit(at(b, bi)) and -1 or 0
  end
  return 0
end

-- gnulib strnumcmp (C locale: '.' decimal point, no thousands separator).
local function strnumcmp(a: string, ai: integer, b: string, bi: integer): integer
  local tmpa, tmpb = at(a, ai), at(b, bi)
  if tmpa == 45 then
    repeat ai = ai + 1; tmpa = at(a, ai) until tmpa ~= 48
    if tmpb ~= 45 then
      if tmpa == 46 then repeat ai = ai + 1; tmpa = at(a, ai) until tmpa ~= 48 end
      if sdigit(tmpa) then return -1 end
      while tmpb == 48 do bi = bi + 1; tmpb = at(b, bi) end
      if tmpb == 46 then repeat bi = bi + 1; tmpb = at(b, bi) until tmpb ~= 48 end
      return sdigit(tmpb) and -1 or 0
    end
    repeat bi = bi + 1; tmpb = at(b, bi) until tmpb ~= 48
    while tmpa == tmpb and sdigit(tmpa) do
      ai = ai + 1; tmpa = at(a, ai)
      bi = bi + 1; tmpb = at(b, bi)
    end
    if (tmpa == 46 and not sdigit(tmpb)) or (tmpb == 46 and not sdigit(tmpa)) then
      return fraccompare(b, bi, a, ai)
    end
    local tmp = tmpb - tmpa
    local loga, logb: integer = 0, 0
    while sdigit(tmpa) do loga = loga + 1; ai = ai + 1; tmpa = at(a, ai) end
    while sdigit(tmpb) do logb = logb + 1; bi = bi + 1; tmpb = at(b, bi) end
    if loga ~= logb then return loga < logb and 1 or -1 end
    if loga == 0 then return 0 end
    return tmp
  elseif tmpb == 45 then
    repeat bi = bi + 1; tmpb = at(b, bi) until tmpb ~= 48
    if tmpb == 46 then repeat bi = bi + 1; tmpb = at(b, bi) until tmpb ~= 48 end
    if sdigit(tmpb) then return 1 end
    while tmpa == 48 do ai = ai + 1; tmpa = at(a, ai) end
    if tmpa == 46 then repeat ai = ai + 1; tmpa = at(a, ai) until tmpa ~= 48 end
    return sdigit(tmpa) and 1 or 0
  end
  while tmpa == 48 do ai = ai + 1; tmpa = at(a, ai) end
  while tmpb == 48 do bi = bi + 1; tmpb = at(b, bi) end
  while tmpa == tmpb and sdigit(tmpa) do
    ai = ai + 1; tmpa = at(a, ai)
    bi = bi + 1; tmpb = at(b, bi)
  end
  if (tmpa == 46 and not sdigit(tmpb)) or (tmpb == 46 and not sdigit(tmpa)) then
    return fraccompare(a, ai, b, bi)
  end
  local tmp = tmpa - tmpb
  local loga, logb: integer = 0, 0
  while sdigit(tmpa) do loga = loga + 1; ai = ai + 1; tmpa = at(a, ai) end
  while sdigit(tmpb) do logb = logb + 1; bi = bi + 1; tmpb = at(b, bi) end
  if loga ~= logb then return loga < logb and -1 or 1 end
  if loga == 0 then return 0 end
  return tmp
end

local function skip_blanks(s: string): integer
  local i: integer = 0
  while sblank(at(s, i)) do i = i + 1 end
  return i
end

local function numcompare(a: string, b: string): integer
  return strnumcmp(a, skip_blanks(a), b, skip_blanks(b))
end

-- -h: order of magnitude of the unit suffix (k K M G T P E Z Y).
local function unit_order(c: integer): integer
  if c == 75 or c == 107 then return 1 end
  if c == 77 then return 2 end
  if c == 71 then return 3 end
  if c == 84 then return 4 end
  if c == 80 then return 5 end
  if c == 69 then return 6 end
  if c == 90 then return 7 end
  if c == 89 then return 8 end
  return 0
end

local function find_unit_order(s: string, i: integer): integer
  local neg = at(s, i) == 45
  if neg then i = i + 1 end
  local maxd: integer = 0
  local ch = at(s, i); i = i + 1
  while sdigit(ch) do
    if ch > maxd then maxd = ch end
    ch = at(s, i); i = i + 1
  end
  if ch == 46 then
    ch = at(s, i); i = i + 1
    while sdigit(ch) do
      if ch > maxd then maxd = ch end
      ch = at(s, i); i = i + 1
    end
  end
  if maxd > 48 then
    local o = unit_order(ch)
    return neg and -o or o
  end
  return 0
end

local function human_numcompare(a: string, b: string): integer
  local ai, bi = skip_blanks(a), skip_blanks(b)
  local diff = find_unit_order(a, ai) - find_unit_order(b, bi)
  if diff ~= 0 then return diff end
  return strnumcmp(a, ai, b, bi)
end

-- gnulib filevercmp: length of s without its (\.[A-Za-z~][A-Za-z0-9~]*)*$ suffix.
local function file_prefixlen(s: string): integer
  local n = (@integer)(s.size)
  local prefixlen: integer = 0
  local i: integer = 0
  while true do
    if i == n then return prefixlen end
    i = i + 1
    prefixlen = i
    while i + 1 < n and at(s, i) == 46 and (salpha(at(s, i + 1)) or at(s, i + 1) == 126) do
      i = i + 2
      while i < n and (salnum(at(s, i)) or at(s, i) == 126) do i = i + 1 end
    end
  end
  return prefixlen
end

local function verorder(s: string, pos: integer, len: integer): integer
  if pos == len then return -1 end
  local c = at(s, pos)
  if sdigit(c) then return 0 end
  if salpha(c) then return c end
  if c == 126 then return -2 end
  return c + 256
end

local function verrevcmp(s1: string, l1: integer, s2: string, l2: integer): integer
  local p1, p2: integer = 0, 0
  while p1 < l1 or p2 < l2 do
    local first_diff: integer = 0
    while (p1 < l1 and not sdigit(at(s1, p1))) or (p2 < l2 and not sdigit(at(s2, p2))) do
      local c1, c2 = verorder(s1, p1, l1), verorder(s2, p2, l2)
      if c1 ~= c2 then return c1 - c2 end
      p1 = p1 + 1; p2 = p2 + 1
    end
    while p1 < l1 and at(s1, p1) == 48 do p1 = p1 + 1 end
    while p2 < l2 and at(s2, p2) == 48 do p2 = p2 + 1 end
    while p1 < l1 and p2 < l2 and sdigit(at(s1, p1)) and sdigit(at(s2, p2)) do
      if first_diff == 0 then first_diff = at(s1, p1) - at(s2, p2) end
      p1 = p1 + 1; p2 = p2 + 1
    end
    if p1 < l1 and sdigit(at(s1, p1)) then return 1 end
    if p2 < l2 and sdigit(at(s2, p2)) then return -1 end
    if first_diff ~= 0 then return first_diff end
  end
  return 0
end

global function filevercmp(a: string, b: string): integer
  local alen, blen = (@integer)(a.size), (@integer)(b.size)
  if alen == 0 then return blen ~= 0 and -1 or 0 end
  if blen == 0 then return 1 end
  if at(a, 0) == 46 then
    if at(b, 0) ~= 46 then return -1 end
    local adot, bdot = alen == 1, blen == 1
    if adot then return bdot and 0 or -1 end
    if bdot then return 1 end
    local adotdot = at(a, 1) == 46 and alen == 2
    local bdotdot = at(b, 1) == 46 and blen == 2
    if adotdot then return bdotdot and 0 or -1 end
    if bdotdot then return 1 end
  elseif at(b, 0) == 46 then
    return 1
  end
  local aprefix, bprefix = file_prefixlen(a), file_prefixlen(b)
  local one_pass = aprefix == alen and bprefix == blen
  local result = verrevcmp(a, aprefix, b, bprefix)
  if result ~= 0 or one_pass then return result end
  return verrevcmp(a, alen, b, blen)
end

-- Plain byte comparison as GNU does it (memcmp, then length).
local function bytecmp(a: string, b: string): integer
  if a.size == 0 then return b.size ~= 0 and -1 or 0 end
  if b.size == 0 then return 1 end
  local n = a.size < b.size and a.size or b.size
  for i: usize = 0, < n do
    local x, y = (@integer)(a.data[i]), (@integer)(b.data[i])
    if x ~= y then return x - y end
  end
  if a.size == b.size then return 0 end
  return a.size < b.size and -1 or 1
end

local function c_strtold(s: cstring, e: *cstring): clongdouble <cimport 'strtold', cinclude '<stdlib.h>'> end
local function c_memcmp(a: pointer, b: pointer, n: csize): cint <cimport 'memcmp', cinclude '<string.h>'> end

-- A NUL-terminated copy of a key for the C conversions.
local function key_cstr(k: string, buf: *[4096]byte): (cstring, boolean)
  if k.size < 4096 then
    for i: usize = 0, < k.size do buf[i] = k.data[i] end
    buf[k.size] = 0
    return (@cstring)(&buf[0]), false
  end
  return (@cstring)(k:copy().data), true
end

-- sort.c general_numcompare: conversion errors first, then NaNs (by bit
-- pattern), then numbers, with -0 == +0.
local function general_numcompare(a: string, b: string): integer
  local ba: [4096]byte
  local bb: [4096]byte
  local sa, fa = key_cstr(a, &ba)
  local sb, fb = key_cstr(b, &bb)
  local ea: cstring
  local eb: cstring
  local x = c_strtold(sa, &ea)
  local y = c_strtold(sb, &eb)
  local r: integer
  if sa == ea then r = sb == eb and 0 or -1
  elseif sb == eb then r = 1
  elseif x < y then r = -1
  elseif x > y then r = 1
  elseif x == y then r = 0
  elseif y == y then r = -1
  elseif x == x then r = 1
  else
    local na: [2]uint64
    local nb: [2]uint64
    $(@*clongdouble)(&na) = c_strtold(sa, nilptr)
    $(@*clongdouble)(&nb) = c_strtold(sb, nilptr)
    na[1] = na[1] & 0xffff; nb[1] = nb[1] & 0xffff
    r = c_memcmp(&na, &nb, 16)
  end
  if fa then (@string){data = (@*[0]byte)(sa), size = a.size}:destroy() end
  if fb then (@string){data = (@*[0]byte)(sb), size = b.size}:destroy() end
  return r
end

-- sort.c getmonth over the C locale's abbreviated month names.
local month_names: [12]string = {'APR', 'AUG', 'DEC', 'FEB', 'JAN', 'JUL', 'JUN', 'MAR', 'MAY', 'NOV', 'OCT', 'SEP'}
local month_vals: [12]integer = {4, 8, 12, 2, 1, 7, 6, 3, 5, 11, 10, 9}

local function getmonth(m: string): integer
  local i: integer = 0
  while sblank(at(m, i)) do i = i + 1 end
  local lo, hi = 0, 12
  repeat
    local ix = (lo + hi) // 2
    local n = month_names[ix]
    local j = 0
    while true do
      if j >= #n then return month_vals[ix] end
      local c = at(m, i + j)
      if c >= 97 and c <= 122 then c = c - 32 end
      local nc = n:byte(j + 1)
      if c < nc then hi = ix; break
      elseif c > nc then lo = ix + 1; break end
      j = j + 1
    end
  until not (lo < hi)
  return 0
end

local function compare_key(a: string, b: string, k: SortKey): integer
  local ka, kb = key_view(a, k), key_view(b, k)
  local diff: integer = 0
  if k.numeric or k.human or k.version or k.general or k.month then
    if k.ignore ~= 0 or k.fold then ka = key_filtered(ka, k); kb = key_filtered(kb, k) end
    if k.numeric then diff = numcompare(ka, kb)
    elseif k.general then diff = general_numcompare(ka, kb)
    elseif k.human then diff = human_numcompare(ka, kb)
    elseif k.month then diff = getmonth(ka) - getmonth(kb)
    else diff = filevercmp(ka, kb) end
  elseif k.ignore ~= 0 then
    local na, nb = (@integer)(ka.size), (@integer)(kb.size)
    local i, j: integer = 0, 0
    while true do
      while i < na and key_ignored(k, at(ka, i)) do i = i + 1 end
      while j < nb and key_ignored(k, at(kb, j)) do j = j + 1 end
      if not (i < na and j < nb) then break end
      diff = key_xlate(k, at(ka, i)) - key_xlate(k, at(kb, j))
      if diff ~= 0 then break end
      i = i + 1; j = j + 1
    end
    if diff == 0 then diff = (i < na and 1 or 0) - (j < nb and 1 or 0) end
  elseif k.fold then
    local na, nb = (@integer)(ka.size), (@integer)(kb.size)
    if na == 0 then diff = nb ~= 0 and -1 or 0
    elseif nb == 0 then diff = 1
    else
      local i: integer = 0
      while i < na and i < nb do
        diff = key_xlate(k, at(ka, i)) - key_xlate(k, at(kb, i))
        if diff ~= 0 then break end
        i = i + 1
      end
      if diff == 0 then diff = na < nb and -1 or (na ~= nb and 1 or 0) end
    end
  else
    diff = bytecmp(ka, kb)
  end
  return k.reverse and -diff or diff
end

-- GNU compare(): keys first, then the whole line unless -s or -u.
local function sort_compare(a: string, b: string): integer
  if #sort_keys > 0 then
    for i = 1, #sort_keys do
      local diff = compare_key(a, b, sort_keys[i])
      if diff ~= 0 then return diff end
    end
    if sort_unique or sort_stable then return 0 end
  end
  local diff = bytecmp(a, b)
  return sort_reverse and -diff or diff
end

local function sort_less(a: string, b: string): boolean
  return sort_compare(a, b) < 0
end

-- Split on the line terminator; a final unterminated line still counts.
local function sort_lines(data: string): sequence(string)
  local out: sequence(string)
  local start: usize = 0
  for i: usize = 0, < data.size do
    if data.data[i] == sort_eol then
      out:push((@string){data=&data.data[start], size=i - start})
      start = i + 1
    end
  end
  if start < data.size then
    out:push((@string){data=&data.data[start], size=data.size - start})
  end
  return out
end

local function badfieldspec(spec: string, msg: string): integer
  util.err(msg .. ": invalid field specification '" .. spec .. "'")
  return 2
end

-- Ordering letters shared by the global options and key modifiers.
-- where: 0 = both blank sides (global), 1 = key start, 2 = key end.
local function set_ordering(k: *SortKey, c: integer, where: integer): boolean
  if c == 98 then
    if where ~= 2 then k.skipsblanks = true end
    if where ~= 1 then k.skipeblanks = true end
  elseif c == 100 then k.ignore = 2
  elseif c == 102 then k.fold = true
  elseif c == 103 then k.general = true
  elseif c == 104 then k.human = true
  elseif c == 105 then if k.ignore == 0 then k.ignore = 1 end
  elseif c == 77 then k.month = true
  elseif c == 110 then k.numeric = true
  elseif c == 114 then k.reverse = true
  elseif c == 86 then k.version = true
  else return false end
  return true
end

local function default_key_compare(k: SortKey): boolean
  return not (k.ignore ~= 0 or k.fold or k.skipsblanks or k.skipeblanks or k.numeric or k.human or k.version
              or k.general or k.month)
end

local function keynum(spec: string, start: integer): (integer, integer, boolean)
  local v: integer = 0
  local j = start
  local n = (@integer)(spec.size)
  while j < n and sdigit(at(spec, j)) do v = v * 10 + (at(spec, j) - 48); j = j + 1 end
  return v, j, j > start
end

-- Parse POS1[,POS2] into k; returns 0 or an exit status after a diagnostic.
local function parse_keyspec(spec: string, k: *SortKey): integer
  local i: integer = 0
  local n = (@integer)(spec.size)
  local v: integer, ok: boolean
  v, i, ok = keynum(spec, 0)
  if not ok then return badfieldspec(spec, 'invalid number at field start') end
  if v == 0 then return badfieldspec(spec, 'field number is zero') end
  k.sword = v - 1; k.schar = 0
  if at(spec, i) == 46 then
    v, i, ok = keynum(spec, i + 1)
    if not ok then return badfieldspec(spec, "invalid number after '.'") end
    if v == 0 then return badfieldspec(spec, 'character offset is zero') end
    k.schar = v - 1
  end
  if k.sword == 0 and k.schar == 0 then k.sword = -1 end
  while i < n and at(spec, i) ~= 44 do
    if not set_ordering(k, at(spec, i), 1) then return badfieldspec(spec, 'stray character in field spec') end
    i = i + 1
  end
  k.eword = -1; k.echar = 0
  if i < n then
    v, i, ok = keynum(spec, i + 1)
    if not ok then return badfieldspec(spec, "invalid number after ','") end
    if v == 0 then return badfieldspec(spec, 'field number is zero') end
    k.eword = v - 1
    if at(spec, i) == 46 then
      v, i, ok = keynum(spec, i + 1)
      if not ok then return badfieldspec(spec, "invalid number after '.'") end
      k.echar = v
    end
    while i < n do
      if not set_ordering(k, at(spec, i), 2) then return badfieldspec(spec, 'stray character in field spec') end
      i = i + 1
    end
  end
  return 0
end

local function sort_emit(l: string)
  util.write(l)
  util.writebyte(sort_eol)
end

global function applet_sort(args: sequence(string)): integer
  local o = util.parsel(args, 'bcCdfghiMmnrsuVzo:k:t:', &longopts.sort, #longopts.sort)
  if not o:ok() then util.optfail(o); return 2 end
  if o.set[200] then
    -- --check[=quiet|silent|diagnose-first]: the last of -c, -C, --check wins
    local a = o.value[200]
    local has = false
    for _, k in ipairs(o.keys) do if k == 200 then has = true end end
    local letter: byte = 99
    if has then
      local function is_prefix(x: string, full: string): boolean
        return #x > 0 and #x <= #full and full:sub(1, #x) == x
      end
      local q, si, d = is_prefix(a, 'quiet'), is_prefix(a, 'silent'), is_prefix(a, 'diagnose-first')
      if q or si then letter = 67
      elseif d then letter = 99
      else
        util.err("invalid argument '" .. a .. "' for '--check'")
        local m = "Valid arguments are:\n  - 'quiet', 'silent'\n  - 'diagnose-first'\nTry 'sort --help' for more information.\n"
        util.flush(); sys.write(2, m.data, m.size)
        return 1
      end
    end
    o.set[letter] = true
  end
  -- --sort=WORD is the matching ordering letter (no 'random' in nebox)
  for idx, k in ipairs(o.keys) do
    if k == 204 then
      local names: []string = {'general-numeric', 'human-numeric', 'month', 'numeric', 'random', 'version'}
      local values: []integer = {103, 104, 77, 110, 82, 86}
      local v = util.argmatch('--sort', o.vals[idx], &names, &values, 6)
      if v < 0 then
        util.flush()
        local m = "Try 'sort --help' for more information.\n"
        sys.write(2, m.data, m.size)
        return 1
      end
      if v == 82 then util.err("option '--sort=random' is not supported"); return 2 end
      o.set[v] = true
    end
  end
  local gkey: SortKey
  gkey.sword = -1; gkey.eword = -1
  local flags = 'bdfghiMnrV'
  for i: usize = 1, flags.size do
    if o:has(flags:sub(i, i)) then set_ordering(&gkey, (@integer)(flags:byte(i)), 0) end
  end
  sort_reverse, sort_stable, sort_unique = o:has('r'), o:has('s'), o:has('u')
  if o:has('z') then sort_eol = 0 else sort_eol = 10 end
  sort_sep = -1
  sort_keys:clear()
  if o:has('t') then
    local t = o:get('t')
    if t.size == 0 then util.err('empty tab'); return 2 end
    if t == '\\0' then sort_sep = 0
    elseif t.size ~= 1 then util.err("multi-character tab '" .. t .. "'"); return 2
    else sort_sep = t:byte(1) end
  end
  for _, spec in ipairs(o:all('k')) do
    local k: SortKey
    local rc = parse_keyspec(spec, &k)
    if rc ~= 0 then return rc end
    sort_keys:push(k)
  end
  -- Keys without ordering options of their own inherit the global ones.
  for i = 1, #sort_keys do
    local k = &sort_keys[i]
    if default_key_compare($k) and not k.reverse then
      k.ignore = gkey.ignore; k.fold = gkey.fold
      k.skipsblanks = gkey.skipsblanks; k.skipeblanks = gkey.skipeblanks
      k.numeric = gkey.numeric; k.human = gkey.human; k.version = gkey.version
      k.general = gkey.general; k.month = gkey.month
      k.reverse = gkey.reverse
    end
  end
  if #sort_keys == 0 and not default_key_compare(gkey) then sort_keys:push(gkey) end
  -- sort.c check_ordering_compatibility: one of n g h M and (V or an
  -- ignore option); the message lists key_to_opts without b and r
  for i = 1, #sort_keys do
    local k = sort_keys[i]
    local kinds = (k.numeric and 1 or 0) + (k.general and 1 or 0) + (k.human and 1 or 0) + (k.month and 1 or 0)
      + ((k.version or k.ignore ~= 0) and 1 or 0)
    if kinds > 1 then
      local s: string = (k.ignore == 2 and 'd' or '') .. (k.fold and 'f' or '') .. (k.general and 'g' or '')
        .. (k.human and 'h' or '') .. (k.ignore == 1 and 'i' or '') .. (k.month and 'M' or '')
        .. (k.numeric and 'n' or '') .. (k.version and 'V' or '')
      util.err("options '-" .. s .. "' are incompatible"); return 2
    end
  end
  local check = o:has('c') or o:has('C')
  if check and o:has('o') then
    util.err("options '-" .. (o:has('c') and 'c' or 'C') .. "o' are incompatible"); return 2
  end
  if #o.operands == 0 then o.operands:push('-') end
  if check and #o.operands > 1 then
    util.err("extra operand '" .. o.operands[2] .. "' not allowed with -" .. (o:has('c') and 'c' or 'C')); return 2
  end
  local inputs: sequence(sequence(string))
  for _, path in ipairs(o.operands) do
    local data, ok = util.readfile(path)
    if not ok then return 2 end
    inputs:push(sort_lines(data))
  end
  if check then
    local all = inputs[1]
    for i = 2, #all do
      local r = sort_compare(all[i - 1], all[i])
      if r > 0 or (sort_unique and r == 0) then
        if o:has('c') then util.errf('%s:%d: disorder: %s', o.operands[1], i, all[i]) end
        return 1
      end
    end
    return 0
  end
  local all: sequence(string)
  if o:has('m') then
    -- GNU mergefps: take the smallest head, earlier file first on ties.
    local pos: sequence(integer)
    for i = 1, #inputs do pos:push(1) end
    while true do
      local best: integer = 0
      for f = 1, #inputs do
        if pos[f] <= #inputs[f] then
          if best == 0 or sort_compare(inputs[f][pos[f]], inputs[best][pos[best]]) < 0 then best = f end
        end
      end
      if best == 0 then break end
      all:push(inputs[best][pos[best]])
      pos[best] = pos[best] + 1
    end
  else
    for f = 1, #inputs do
      for _, l in ipairs(inputs[f]) do all:push(l) end
    end
    util.sort(all, sort_less)
  end
  if o:has('o') then
    local fd = sys.open(o:get('o'), sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, 0x1B6)
    if fd < 0 then util.perror(o:get('o')); return 2 end
    util.setout(fd)
  end
  local prev: string
  local have = false
  for _, l in ipairs(all) do
    if sort_unique and have and sort_compare(prev, l) == 0 then continue end
    sort_emit(l)
    prev = l
    have = true
  end
  util.flush()
  util.setout(1)
  return 0
end



-- Build one regex covering every pattern, honouring -w / -x by wrapping.
local function grep_compile(patterns: sequence(string), ere: boolean, icase: boolean, word: boolean, whole: boolean): (regex.Prog, string)
  local sb: stringbuilder
  -- (?: groups are an internal non-capturing extension so user back-references keep their numbers
  local open: string = ere and '(?:' or '\\(?:'
  local close: string = ere and ')' or '\\)'
  local bar: string = ere and '|' or '\\|'
  for i, p in ipairs(patterns) do
    if i > 1 then sb:write(bar) end
    sb:write(open); sb:write(p); sb:write(close)
  end
  local body = sb:promote()
  if whole then body = '^' .. open .. body .. close .. '$'
  elseif word then
    -- the trailing delimiter is a capturing group, numbered after the user's
    -- groups, so that -o can print the word without it
    local copen: string = ere and '(' or '\\('
    body = open .. '^' .. bar .. '[^[:alnum:]_]' .. close .. open .. body .. close .. copen .. '[^[:alnum:]_]' .. bar .. '$' .. close
  end
  return regex.compile(body, ere, icase)
end

-- grep -F: a fixed string as a BRE that matches it literally.
local function bre_quote(s: string): string
  local sb: stringbuilder
  for i: usize = 0, < s.size do
    local c = s.data[i]
    if c == 92 or c == 46 or c == 91 or c == 93 or c == 42 or c == 94 or c == 36 then sb:writebyte(92) end
    sb:writebyte(c)
  end
  return sb:promote()
end

-- A context length as GNU grep's context_length_arg reads it: a decimal
-- intmax_t, at least 0; an overflow means "unlimited".
local function grep_context(s: string): (integer, boolean)
  local i: usize = 1
  while i <= s.size and (s:byte(i) == 32 or (s:byte(i) >= 9 and s:byte(i) <= 13)) do i = i + 1 end
  if i <= s.size and (s:byte(i) == 43 or s:byte(i) == 45) then
    if s:byte(i) == 45 then return 0, false end
    i = i + 1
  end
  if i > s.size then return 0, false end
  local v: integer = 0
  while i <= s.size do
    local c = s:byte(i)
    if c < 48 or c > 57 then return 0, false end
    if v > (0x7fffffffffffffff - (c - 48)) // 10 then v = 0x7fffffffffffffff else v = v * 10 + (c - 48) end
    i = i + 1
  end
  return v, true
end

-- Output state shared by every file, as in GNU grep's prtext/prline.
local Grep = @record{
  prog: regex.Prog, caps: regex.Caps,
  invert: boolean, only: boolean, withname: boolean, lineno: boolean, byteoff: boolean,
  word: boolean,                   -- -w: matches are wrapped in delimiter groups
  nullname: boolean,               -- -Z: a NUL after file names
  nopattern: boolean,              -- -f with no patterns at all: nothing matches
  eol: byte,                       -- record terminator: '\n', or NUL with -z
  before: integer, after: integer, -- -1 when unset
  used: boolean,                   -- some group has been output (for "--")
  path: string,
}

function Grep:head(sep: byte, n: integer, off: integer)
  if self.withname then util.write(self.path); util.writebyte(self.nullname and 0 or sep) end
  if self.lineno then util.writef('%d', n); util.writebyte(sep) end
  if self.byteoff then util.writef('%d', off); util.writebyte(sep) end
end

-- prline: `selected` lines get ':', context lines '-'. With -o only the
-- matches of lines that do match the pattern are printed.
function Grep:prline(line: string, n: integer, off: integer, selected: boolean): boolean
  if not self.only then
    self:head(selected and 58 or 45, n, off)
    util.write(line); util.writebyte(self.eol)
    return true
  end
  if selected ~= self.invert and not self.nopattern then
    local sep: byte = self.invert and 45 or 58
    local pos: isize = 0
    local tg = self.prog.nsub          -- -w: the trailing delimiter group
    while pos <= (@isize)(line.size) and self.prog:search(line, pos, &self.caps) do
      local s, e = self.caps.at[0], self.caps.at[1]
      if self.word then
        -- the leading delimiter is one byte except at the start of the line,
        -- the trailing one is the last group (empty at the end of the line)
        if s > 0 then s = s + 1 end
        if tg >= 1 and tg <= 9 and self.caps.at[2 * tg] >= 0 then e = self.caps.at[2 * tg] end
      end
      if e > s then
        self:head(sep, n, off + s)
        util.write(line:sub(s + 1, e)); util.writebyte(self.eol)
      end
      -- resume at the end of the word, so its delimiter can start the next match
      local nextpos = e > s and e or s + 1
      if nextpos <= pos then nextpos = pos + 1 end
      pos = nextpos
    end
    if self.prog.toocomplex then return false end
  end
  return true
end

-- Input records: lines, or NUL-terminated records with -z. A final record
-- without its terminator still counts; nothing follows a final terminator.
local function grep_records(data: string, eol: byte): sequence(string)
  if eol == 10 then return util.lines(data) end
  local out: sequence(string)
  local start: usize = 0
  for i: usize = 0, < data.size do
    if data.data[i] == eol then
      out:push(data:sub((@isize)(start + 1), (@isize)(i)))
      start = i + 1
    end
  end
  if start < data.size then out:push(data:sub((@isize)(start + 1))) end
  return out
end

local GREP_NOOP: integer <comptime> = 200
local GREP_COLOR: integer <comptime> = 201
local U: integer <comptime> = 255
-- GNU grep 3.8's long options; the ones nebox lacks are refused by name.
local grep_longs: []util.LongOpt = {
  {'basic-regexp', 0, 71}, {'extended-regexp', 0, 69}, {'fixed-regexp', 0, 70}, {'fixed-strings', 0, 70},
  {'perl-regexp', 0, U}, {'after-context', 1, 65}, {'before-context', 1, 66}, {'binary-files', 1, U},
  {'byte-offset', 0, 98}, {'context', 1, 67}, {'color', 2, GREP_COLOR}, {'colour', 2, GREP_COLOR},
  {'count', 0, 99}, {'devices', 1, U}, {'directories', 1, U}, {'dereference-recursive', 0, U},
  {'exclude', 1, U}, {'exclude-from', 1, U}, {'exclude-dir', 1, U}, {'file', 1, 102},
  {'files-with-matches', 0, 108}, {'files-without-match', 0, 76}, {'group-separator', 1, U},
  {'help', 0, U}, {'include', 1, U}, {'ignore-case', 0, 105}, {'no-ignore-case', 0, U},
  {'initial-tab', 0, U}, {'label', 1, U}, {'line-buffered', 0, GREP_NOOP}, {'line-number', 0, 110},
  {'line-regexp', 0, 120}, {'max-count', 1, 109}, {'no-filename', 0, 104}, {'no-group-separator', 0, U},
  {'no-messages', 0, 115}, {'null', 0, 90}, {'null-data', 0, 122}, {'only-matching', 0, 111},
  {'quiet', 0, 113}, {'recursive', 0, 114}, {'regexp', 1, 101}, {'invert-match', 0, 118},
  {'silent', 0, 113}, {'text', 0, U}, {'binary', 0, U}, {'version', 0, U},
  {'with-filename', 0, 72}, {'word-regexp', 0, 119},
}

global function applet_grep(args: sequence(string)): integer
  -- -NUM context options: consecutive digits in one argument accumulate
  -- into a context length (GNU grep's get_nondigit_option); the last -C or
  -- -NUM sets the default that -A and -B override.
  local o: util.Opts
  do
    local gg = util.getopt(args, '0123456789ivnclLqHhFEGwxe:f:srom:A:B:C:bzZ', &grep_longs, #grep_longs)
    gg.quiet = true
    local digits: string = ''
    local was_digit = false
    local last_elem: integer = -1
    while true do
      local c = gg:next()
      if c >= 48 and c <= 57 then
        if was_digit and gg.arg_index == last_elem then
          if digits == '0' then digits = '' end
        else
          digits = ''
        end
        digits = digits .. string.char(c)
        was_digit = true
        last_elem = gg.arg_index
        continue
      end
      if #digits > 0 then
        o.set[67] = true; o.order:push(67); o.keys:push(67); o.vals:push(digits)
        digits = ''
      end
      was_digit = false
      if c == -1 then break end
      if c == 63 and #gg.errmsg > 0 then o.bad = gg.errmsg; break end
      if c == U then o.bad = "option '--" .. gg.longname .. "' is not supported"; break end
      if c == GREP_NOOP then continue end
      if c == GREP_COLOR then
        -- GNU grep compares the WHEN argument case-insensitively
        local w = gg.optarg
        local lw: stringbuilder
        for k = 1, #w do
          local ch = w:byte(k)
          if ch >= 65 and ch <= 90 then ch = ch + 32 end
          lw:writebyte(ch)
        end
        local l = lw:promote()
        if gg.has_optarg and (l == 'always' or l == 'yes' or l == 'force') then
          o.bad = "option '--" .. gg.longname .. "=" .. w .. "' is not supported"; break
        end
        if gg.has_optarg and not (l == 'never' or l == 'no' or l == 'none' or l == 'auto' or l == 'tty' or l == 'if-tty') then
          util.flush()
          local m = "Usage: grep [OPTION]... PATTERNS [FILE]...\nTry 'grep --help' for more information.\n"
          sys.write(2, m.data, m.size)
          return 2
        end
        continue
      end
      o.set[c] = true
      o.order:push((@byte)(c))
      if gg.has_optarg then o.value[c] = gg.optarg; o.keys:push((@byte)(c)); o.vals:push(gg.optarg) end
    end
    if o.bad.size == 0 then o.operands = gg:operands() end
  end
  if not o:ok() then return util.optfail(o) + 1 end
  local g: Grep = {before = -1, after = -1, invert = o:has('v'), only = o:has('o'),
    lineno = o:has('n'), byteoff = o:has('b'), word = o:has('w') and not o:has('x'),
    nullname = o:has('Z'), eol = o:has('z') and 0 or 10}
  local silent = o:has('s')
  -- -C and -NUM set a default that an explicit -A or -B overrides; the
  -- last of them wins, as in GNU grep.
  local defctx: integer = -1
  for idx, k in ipairs(o.keys) do
    if k == 65 or k == 66 or k == 67 then
      local v, ok = grep_context(o.vals[idx])
      if not ok then util.err(o.vals[idx] .. ': invalid context length argument'); return 2 end
      if k == 65 then g.after = v elseif k == 66 then g.before = v else defctx = v end
    end
  end
  if g.after < 0 then g.after = defctx end
  if g.before < 0 then g.before = defctx end
  local patterns: sequence(string)
  local operands = o.operands
  if o:has('e') or o:has('f') then
    -- -e and -f patterns in command-line order; a pattern file holds one
    -- pattern per line, and an empty file contributes none
    for idx, k in ipairs(o.keys) do
      if k == 101 then
        local e = o.vals[idx]
        for _, p in ipairs(util.lines(e)) do patterns:push(p) end
        if e.size == 0 then patterns:push('') end
      elseif k == 102 then
        local data, ok = util.readfile(o.vals[idx])
        if not ok then return 2 end
        for _, p in ipairs(util.lines(data)) do patterns:push(p) end
      end
    end
    if #patterns == 0 then g.nopattern = true end
  else
    if #operands == 0 then util.err('usage: grep [-ivnclLqHhFEGwxorsbzZ] [-A N] [-B N] [-C N] [-e PATTERN | -f FILE] PATTERN [FILE...]'); return 2 end
    for _, p in ipairs(util.lines(operands[1])) do patterns:push(p) end
    if operands[1].size == 0 then patterns:push('') end
    operands:remove(1)
  end
  -- with no operand, -r searches "." but names files without "./" (GNU)
  local implicit_dot = o:has('r') and #operands == 0
  if implicit_dot then operands:push('.') end
  if #operands == 0 then operands:push('-') end
  local ere = o:has('E')
  if o:has('F') then
    for i = 1, #patterns do patterns[i] = bre_quote(patterns[i]) end
    ere = false
  end
  local err: string
  g.prog, err = grep_compile(patterns, ere, o:has('i'), o:has('w'), o:has('x'))
  if err.size > 0 then util.err(err); return 2 end
  -- -l and -L: the last one given wins (GNU grep)
  local list_with, list_without = false, false
  for _, k in ipairs(o.order) do
    if k == 108 then list_with, list_without = true, false
    elseif k == 76 then list_with, list_without = false, true end
  end
  local maxcount: integer = -1
  if o:has('m') then
    local v, ok = util.toint(o:get('m'))
    if not ok then util.err('invalid max count'); return 2 end
    maxcount = v
  end
  -- expand -r directories into files
  if o:has('r') then
    local expanded: sequence(string)
    local stack: sequence(string)
    for _, p in ipairs(operands) do stack:push(p) end
    local i: integer = 1
    while i <= #stack do
      local p = stack[i]
      if util.isdir(p) then
        local names, ok = util.readnames(p, true)
        if ok then
          for _, n in ipairs(names) do
            if n ~= '.' and n ~= '..' then stack:push((implicit_dot and i == 1) and n or util.join(p, n)) end
          end
        end
      else
        expanded:push(p)
      end
      i = i + 1
    end
    operands = expanded
  end
  g.withname = (#operands > 1 or o:has('H') or o:has('r')) and not o:has('h')
  -- -c, -l, -L and -q print no lines, so they take no context
  local quiet = o:has('c') or list_with or list_without or o:has('q')
  local ctx = g.before >= 0 or g.after >= 0
  local anymatch = false
  local rc: integer = 0
  for _, path in ipairs(operands) do
    local fd: cint = 0
    if path ~= '-' then fd = sys.open(path, sys.O_RDONLY | sys.O_CLOEXEC, 0) end
    if fd < 0 then
      if not silent then util.perror(path) end
      rc = 2; continue
    end
    local data, ok = util.readfd(fd)
    if fd > 0 then sys.close(fd) end
    if not ok then
      if not silent then util.perror(path) end
      rc = 2; continue
    end
    g.path = path
    local count: integer = 0
    local outleft = maxcount
    local lastout: integer = 0  -- last line printed in this file, 0 for none
    local pending: integer = 0  -- trailing context still to print
    local lines = grep_records(data, g.eol)
    local offs: sequence(integer)
    local off: integer = 0
    for _, line in ipairs(lines) do offs:push(off); off = off + (@integer)(line.size) + 1 end
    for n = 1, #lines do
      local line = lines[n]
      if outleft == 0 then
        -- -m reached: only the trailing context of the last match remains
        if pending <= 0 or quiet then break end
        if not g:prline(line, n, offs[n], false) then util.err('pattern too complex'); return 2 end
        lastout = n; pending = pending - 1
        continue
      end
      local m = not g.nopattern and g.prog:search(line, 0, &g.caps)
      if g.prog.toocomplex then util.err('pattern too complex'); return 2 end
      if m == g.invert then
        if pending > 0 and not quiet then
          if not g:prline(line, n, offs[n], false) then util.err('pattern too complex'); return 2 end
          lastout = n; pending = pending - 1
        end
        continue
      end
      count = count + 1
      anymatch = true
      if o:has('q') then return 0 end
      if list_with or list_without then break end
      if not quiet then
        local p = n
        if g.before > 0 then
          p = n - g.before
          if p < lastout + 1 then p = lastout + 1 end
          if p < 1 then p = 1 end
        end
        if ctx and g.used and (lastout == 0 or p ~= lastout + 1) then util.line('--') end
        for k = p, n - 1 do
          if not g:prline(lines[k], k, offs[k], false) then util.err('pattern too complex'); return 2 end
        end
        if not g:prline(line, n, offs[n], true) then util.err('pattern too complex'); return 2 end
        lastout = n
        pending = g.after > 0 and g.after or 0
        g.used = true
      end
      if outleft > 0 then outleft = outleft - 1 end
    end
    if list_with or list_without then
      if (count > 0) == list_with then util.write(path); util.writebyte(g.nullname and 0 or 10) end
    elseif o:has('c') then
      if g.withname then util.write(path); util.writebyte(g.nullname and 0 or 58) end
      util.writef('%d\n', count)
    end
  end
  if rc ~= 0 then return rc end
  return anymatch and 0 or 1
end

-- tr: expand a set with ranges and escapes into bytes
local function class_bytes(name: string, out: *sequence(byte)): boolean
  local lo: integer, hi: integer = 0, 255
  if name == 'alpha' then for b = 65, 90 do out:push((@byte)(b)) end; for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'digit' then for b = 48, 57 do out:push((@byte)(b)) end
  elseif name == 'alnum' then for b = 48, 57 do out:push((@byte)(b)) end; for b = 65, 90 do out:push((@byte)(b)) end; for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'upper' then for b = 65, 90 do out:push((@byte)(b)) end
  elseif name == 'lower' then for b = 97, 122 do out:push((@byte)(b)) end
  elseif name == 'space' then for b = 9, 13 do out:push((@byte)(b)) end; out:push(32)
  elseif name == 'blank' then out:push(9); out:push(32)
  elseif name == 'punct' then
    for b = 33, 47 do out:push((@byte)(b)) end; for b = 58, 64 do out:push((@byte)(b)) end
    for b = 91, 96 do out:push((@byte)(b)) end; for b = 123, 126 do out:push((@byte)(b)) end
  elseif name == 'print' then for b = 32, 126 do out:push((@byte)(b)) end
  elseif name == 'graph' then for b = 33, 126 do out:push((@byte)(b)) end
  elseif name == 'cntrl' then for b = 0, 31 do out:push((@byte)(b)) end; out:push(127)
  elseif name == 'xdigit' then for b = 48, 57 do out:push((@byte)(b)) end; for b = 65, 70 do out:push((@byte)(b)) end; for b = 97, 102 do out:push((@byte)(b)) end
  else return false end
  local _ = lo + hi
  return true
end



-- cut: field/char lists like "1,3-5,7-"
local Range = @record{lo: integer, hi: integer}

local function parse_list(s: string): (sequence(Range), boolean)
  local out: sequence(Range)
  local start: usize = 1
  for i: usize = 1, s.size + 1 do
    if i > s.size or s:byte(i) == 44 then
      local part = s:sub(start, i - 1)
      start = i + 1
      if part.size == 0 then return out, false end
      local dash = part:find('-', 1, true)
      local r: Range = {1, 0x7fffffff}
      if dash == 0 then
        local v, ok = util.toint(part); if not ok or v < 1 then return out, false end
        r.lo, r.hi = v, v
      else
        if dash > 1 then local v, ok = util.toint(part:sub(1, dash - 1)); if not ok then return out, false end; r.lo = v end
        if dash < (@isize)(part.size) then local v, ok = util.toint(part:sub(dash + 1)); if not ok then return out, false end; r.hi = v end
        if r.lo < 1 or r.hi < r.lo then return out, false end
      end
      out:push(r)
    end
  end
  return out, #out > 0
end

local function inlist(list: sequence(Range), n: integer): boolean
  for _, r in ipairs(list) do if n >= r.lo and n <= r.hi then return true end end
  return false
end


global function applet_rev(args: sequence(string)): integer
  if #args == 0 then args:push('-') end
  local rc: integer = 0
  for _, path in ipairs(args) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    local start: usize = 0
    for i: usize = 0, data.size do
      if i == data.size or data.data[i] == 10 then
        local j: isize = (@isize)(i) - 1
        while j >= (@isize)(start) do util.writebyte(data.data[j]); j = j - 1 end
        if i < data.size then util.writebyte(10) end
        start = i + 1
      end
    end
  end
  return rc
end

global function applet_yes(args: sequence(string)): integer
  local s: string = 'y'
  if #args > 0 then
    local sb: stringbuilder
    for i, a in ipairs(args) do if i > 1 then sb:writebyte(32) end; sb:write(a) end
    s = sb:promote()
  end
  -- flush after every line so a closed pipe ends the loop
  while true do
    util.line(s)
    if not util.flush() then return 1 end
  end
  return 0
end

local function c_snprintf(buf: cstring, n: csize, fmt: cstring, ...: cvarargs): cint <cimport 'snprintf', cinclude '<stdio.h>'> end

-- One floating conversion through the C library.
local function printf_float(spec: string, v: float64): string
  local buf: [512]byte
  local n = c_snprintf((@cstring)(&buf[0]), 512, spec, v)
  if n < 0 then return '' end
  if n < 512 then return string.copy((@string){data = &buf[0], size = (@usize)(n)}) end
  local s = string.create((@usize)(n))
  c_snprintf((@cstring)(s.data), (@usize)(n) + 1, spec, v)
  return s
end

-- Floating operand: a strtod number (leading/trailing blanks aside), or a
-- 'c / "c character constant.
local function printf_tofloat(a: string): (float64, boolean)
  if a.size == 0 then return 0, true end
  if a:byte(1) == 39 or a:byte(1) == 34 then return a.size > 1 and a:byte(2) or 0, true end
  local c = string.copy(a)
  local endp: cstring
  local v = sys.strtod(c, &endp)
  local used = (@usize)((@isize)(endp) - (@isize)(c.data))
  while used < a.size and (a:byte(used + 1) == 32 or a:byte(used + 1) == 9) do used = used + 1 end
  local ok = used == a.size and (@isize)(endp) ~= (@isize)(c.data)
  c:destroy()
  return v, ok
end

-- seq, after GNU seq 9.1: operands are long doubles, the default format is
-- %.PLf with P the larger number of fraction digits of FIRST and INCREMENT
-- (%Lg for hex or 'p' operands), -w pads to the widest operand, -f takes one
-- e/f/g/a conversion. All-digit operands (and integral ones that print as
-- plain digits) with a small positive step count in decimal strings, so
-- they stay exact past 2^64 and `seq N inf` runs forever, as GNU's fast
-- path does.
local SEQ_NOPREC: integer <comptime> = 0x7fffffff

local SeqOperand = @record{value: clongdouble, width: integer, precision: integer}

local function seq_isdigit(c: byte): boolean return c >= '0'_b and c <= '9'_b end
local function seq_isspace(c: byte): boolean return c == 32 or (c >= 9 and c <= 13) end
local function seq_finite(v: clongdouble): boolean return v == v and v - v == 0 end

-- Format one long double; returns the bytes in buf, or an allocated
-- string when they do not fit.
local function seq_fmt(fmt: string, v: clongdouble, buf: *[512]byte): string
  local n = c_snprintf((@cstring)(&buf[0]), 512, fmt, v)
  if n < 0 then return '' end
  if n < 512 then return (@string){data = &buf[0], size = (@usize)(n)} end
  local s = string.create((@usize)(n))
  c_snprintf((@cstring)(s.data), (@usize)(n) + 1, fmt, v)
  return s
end

-- gnulib xstrtold: the whole operand must be a number; overflow is an
-- error, underflow is not.
local function seq_strtold(a: string): (clongdouble, boolean)
  local c = string.copy(a)
  local endp: cstring
  local v = sys.strtold(c, &endp)
  local used = (@usize)((@isize)(endp) - (@isize)(c.data))
  local ok = used > 0 and used == a.size
  if ok and v == v and not seq_finite(v) then
    -- an infinity is fine only when it was written as one
    local i: usize = 1
    while i <= a.size and (seq_isspace(a:byte(i)) or a:byte(i) == '+'_b or a:byte(i) == '-'_b) do i = i + 1 end
    ok = i <= a.size and (a:byte(i) == 'i'_b or a:byte(i) == 'I'_b)
  end
  c:destroy()
  return v, ok
end

local function seq_usage_fail(msg: string): integer
  util.err(msg)
  util.flush()
  local tm = "Try 'seq --help' for more information.\n"
  sys.write(2, tm.data, tm.size)
  return 1
end

-- strspn-style count of bytes from `set` starting at i
local function seq_span(s: string, i: usize, set: string): usize
  local j = i
  while j <= s.size and set:find(string.char(s:byte(j)), 1, true) > 0 do j = j + 1 end
  return j
end

-- coreutils scan_arg: value plus the width and precision the operand's
-- spelling implies.
local function seq_scan(arg: string): (SeqOperand, boolean)
  local r: SeqOperand = {value = 0, width = 0, precision = SEQ_NOPREC}
  local v, ok = seq_strtold(arg)
  if not ok then
    seq_usage_fail("invalid floating point argument: '" .. arg .. "'"); return r, false
  end
  if v ~= v then
    seq_usage_fail("invalid 'not-a-number' argument: '" .. arg .. "'"); return r, false
  end
  r.value = v
  local k: usize = 1
  while k <= arg.size and (seq_isspace(arg:byte(k)) or arg:byte(k) == '+'_b) do k = k + 1 end
  local s = arg:sub(k)
  local dp = s:find('.', 1, true)
  if dp == 0 and s:find('p', 1, true) == 0 then r.precision = 0 end
  if s:find('x', 1, true) == 0 and s:find('X', 1, true) == 0 and seq_finite(v) then
    local fraction_len: integer = 0
    r.width = (@integer)(s.size)
    if dp > 0 then
      local j = dp + 1
      while j <= (@isize)(s.size) and s:byte(j) ~= 'e'_b and s:byte(j) ~= 'E'_b do j = j + 1 end
      fraction_len = (@integer)(j - dp - 1)
      r.precision = fraction_len
      if fraction_len == 0 then r.width = r.width - 1
      elseif dp == 1 or not seq_isdigit(s:byte(dp - 1)) then r.width = r.width + 1 end
    end
    local e = s:find('e', 1, true)
    if e == 0 then e = s:find('E', 1, true) end
    if e > 0 then
      -- strtol of the exponent
      local j = e + 1
      while j <= (@isize)(s.size) and seq_isspace(s:byte(j)) do j = j + 1 end
      local eneg = false
      if j <= (@isize)(s.size) and (s:byte(j) == '-'_b or s:byte(j) == '+'_b) then eneg = s:byte(j) == '-'_b; j = j + 1 end
      local exponent: integer = 0
      while j <= (@isize)(s.size) and seq_isdigit(s:byte(j)) do
        if exponent < 0x7fffffff then exponent = exponent * 10 + (s:byte(j) - '0'_b) end
        j = j + 1
      end
      if eneg then exponent = -exponent end
      if exponent < 0 then r.precision = r.precision - exponent
      else r.precision = r.precision - (r.precision < exponent and r.precision or exponent) end
      r.width = r.width - ((@integer)(s.size) - (@integer)(e - 1))
      if exponent < 0 then
        if dp > 0 then
          if e == dp + 1 then r.width = r.width + 1 end
        else
          r.width = r.width + 1
        end
        exponent = -exponent
      else
        if dp > 0 and r.precision == 0 and fraction_len > 0 then r.width = r.width - 1 end
        exponent = exponent - (fraction_len < exponent and fraction_len or exponent)
      end
      r.width = r.width + exponent
    end
  end
  return r, true
end

local function at(s: string, i: usize): byte
  if i > s.size then return 0 end
  return s:byte(i)
end

-- coreutils long_double_format: check -f's FORMAT and add the L modifier.
-- Returns the format, the output length of its prefix and suffix, and an
-- error message.
local function seq_ldformat(fmt: string): (string, integer, integer, string)
  local i: usize = 1
  local prefix: integer = 0
  while not (at(fmt, i) == '%'_b and at(fmt, i + 1) ~= '%'_b) do
    if at(fmt, i) == 0 then return '', 0, 0, "format '" .. fmt .. "' has no % directive" end
    prefix = prefix + 1
    i = i + (at(fmt, i) == '%'_b and 2 or 1)
  end
  i = i + 1
  local flags_start = i
  i = seq_span(fmt, i, "-+#0 '")
  local flags = fmt:sub(flags_start, i - 1)
  local rest_start = i
  i = seq_span(fmt, i, '0123456789')
  if at(fmt, i) == '.'_b then i = seq_span(fmt, i + 1, '0123456789') end
  local lmo = i
  local hasL = at(fmt, i) == 'L'_b
  if hasL then i = i + 1 end
  local conv = at(fmt, i)
  if conv == 0 then return '', 0, 0, "format '" .. fmt .. "' ends in %" end
  if ('efgaEFGA'):find(string.char(conv), 1, true) == 0 then
    return '', 0, 0, "format '" .. fmt .. "' has unknown %" .. string.char(conv) .. ' directive'
  end
  i = i + 1
  local suffix: integer = 0
  while at(fmt, i) ~= 0 do
    if at(fmt, i) == '%'_b and at(fmt, i + 1) ~= '%'_b then
      return '', 0, 0, "format '" .. fmt .. "' has too many % directives"
    end
    suffix = suffix + 1
    i = i + (at(fmt, i) == '%'_b and 2 or 1)
  end
  -- the ' flag (thousands grouping) does nothing in the C locale
  local sb: stringbuilder
  for k: usize = 1, flags.size do if flags:byte(k) ~= 39 then sb:writebyte(flags:byte(k)) end end
  local ldfmt = fmt:sub(1, flags_start - 1) .. sb:promote() .. fmt:sub(rest_start, lmo - 1) .. 'L' ..
    fmt:sub(lmo + (hasL and 1 or 0))
  return ldfmt, prefix, suffix, ''
end

local function seq_print(fmt: string, prefix: integer, suffix: integer, first: clongdouble, step: clongdouble,
    last: clongdouble, sep: string)
  local out_of_range: boolean
  if step < 0 then out_of_range = first < last else out_of_range = last < first end
  if out_of_range then return end
  local buf: [512]byte
  local x = first
  local i: clongdouble = 1
  while true do
    local x0 = x
    util.write(seq_fmt(fmt, x, &buf))
    if out_of_range then break end
    x = first + i * step
    i = i + 1
    if step < 0 then out_of_range = x < last else out_of_range = last < x end
    if out_of_range then
      -- print one more number when it prints as LAST and differently from
      -- the previous one (rounding: seq 0 0.1 1 ends with 1.0)
      local extra = false
      local xs = string.copy(seq_fmt(fmt, x, &buf))
      local xv, ok = seq_strtold(xs:sub((@usize)(prefix) + 1, xs.size - (@usize)(suffix)))
      if ok and xv == last then
        local x0s = seq_fmt(fmt, x0, &buf)
        extra = x0s:sub(1, x0s.size - (@usize)(suffix)) ~= xs:sub(1, xs.size - (@usize)(suffix))
      end
      if not extra then break end
    end
    util.write(sep)
    if (@integer)(i) & 1023 == 0 and not util.flush() then return end
  end
  util.writebyte(10)
end

local function seq_all_digits(s: string): boolean
  if s.size == 0 then return false end
  for i: usize = 1, s.size do if not seq_isdigit(s:byte(i)) then return false end end
  return true
end

-- Compare two digit strings without leading zeros.
local function seq_cmp(a: sequence(byte), b: string): integer
  if (@usize)(#a) ~= b.size then return #a < (@integer)(b.size) and -1 or 1 end
  for i: usize = 1, b.size do
    if a[i] ~= b:byte(i) then return a[i] < b:byte(i) and -1 or 1 end
  end
  return 0
end

-- coreutils seq_fast: decimal strings from A to B (or "inf") by STEP.
local function seq_fast(a: string, b: string, step: integer, sep: string)
  local inf = b == 'inf'
  local ia: usize = 1
  while ia < a.size and a:byte(ia) == '0'_b do ia = ia + 1 end
  local ib: usize = 1
  while ib < b.size and b:byte(ib) == '0'_b do ib = ib + 1 end
  local q = b:sub(ib)
  local p: sequence(byte)
  for k: usize = ia, a.size do p:push(a:byte(k)) end
  if not inf and seq_cmp(p, q) > 0 then return end
  for k = 1, #p do util.writebyte(p[k]) end
  local count: integer = 0
  while true do
    -- p += step
    local carry: integer = step
    local k = #p
    while carry > 0 and k >= 1 do
      local d = (p[k] - '0'_b) + carry
      p[k] = (@byte)('0'_b + d % 10)
      carry = d // 10
      k = k - 1
    end
    while carry > 0 do p:insert(1, (@byte)('0'_b + carry % 10)); carry = carry // 10 end
    if not inf and seq_cmp(p, q) > 0 then break end
    util.write(sep)
    for j = 1, #p do util.writebyte(p[j]) end
    count = count + 1
    if count & 1023 == 0 and not util.flush() then return end
  end
  util.writebyte(10)
end

global function applet_seq(args: sequence(string)): integer
  local sep: string = '\n'
  local fmt: string = ''
  local has_fmt = false
  local equal = false
  local i: integer = 1
  -- getopt "+f:s:w" with long options; "-5" and "-.5" are operands
  while i <= #args do
    local a = args[i]
    if a.size < 2 or a:byte(1) ~= '-'_b then break end
    if a:byte(2) == '.'_b or seq_isdigit(a:byte(2)) then break end
    if a == '--' then i = i + 1; break end
    if a:byte(2) == '-'_b then
      local body = a:sub(3)
      local name, value = body, ''
      local eq = body:find('=', 1, true)
      local has_value = eq > 0
      if has_value then name = body:sub(1, eq - 1); value = body:sub(eq + 1) end
      local longs: [3]string = {'equal-width', 'format', 'separator'}
      local match: string = ''
      local count = 0
      for _, l in ipairs(longs) do
        if l == name then match = l; count = 1; break end
        if name.size > 0 and l:sub(1, name.size) == name then match = l; count = count + 1 end
      end
      if count ~= 1 then
        return seq_usage_fail((count == 0 and "unrecognized option '" or "option '") .. a ..
          (count == 0 and "'" or "' is ambiguous"))
      end
      if match == 'equal-width' then
        if has_value then return seq_usage_fail("option '--equal-width' doesn't allow an argument") end
        equal = true
      else
        if not has_value then
          i = i + 1
          if i > #args then return seq_usage_fail("option '--" .. match .. "' requires an argument") end
          value = args[i]
        end
        if match == 'format' then fmt = value; has_fmt = true else sep = value end
      end
      i = i + 1
      continue
    end
    local j: usize = 2
    while j <= a.size do
      local c = a:byte(j)
      if c == 'w'_b then
        equal = true; j = j + 1
      elseif c == 'f'_b or c == 's'_b then
        local v: string
        if j < a.size then v = a:sub(j + 1)
        else
          i = i + 1
          if i > #args then return seq_usage_fail("option requires an argument -- '" .. string.char(c) .. "'") end
          v = args[i]
        end
        if c == 'f'_b then fmt = v; has_fmt = true else sep = v end
        break
      else
        return seq_usage_fail("invalid option -- '" .. string.char(c) .. "'")
      end
    end
    i = i + 1
  end
  local ops: sequence(string)
  while i <= #args do ops:push(args[i]); i = i + 1 end
  local n = #ops
  if n < 1 then return seq_usage_fail('missing operand') end
  if n > 3 then return seq_usage_fail("extra operand '" .. ops[4] .. "'") end
  if has_fmt and equal then
    return seq_usage_fail('format string may not be specified when printing equal width strings')
  end
  local plain = not equal and not has_fmt and sep.size == 1
  -- fast path for digit-only operands
  local fast_step_ok = true
  if n == 3 then
    local sv, sok = seq_strtold(ops[2])
    fast_step_ok = seq_all_digits(ops[2]) and sok and 0 < sv and sv <= 200
  end
  if plain and seq_all_digits(ops[1]) and (n == 1 or seq_all_digits(ops[2])) and
      (n < 3 or (fast_step_ok and seq_all_digits(ops[3]))) then
    local stepv: integer = 1
    if n == 3 then local sv, _ = util.toint(ops[2]); stepv = sv end
    seq_fast(n == 1 and '1' or ops[1], ops[n], stepv, sep)
    return util.flush() and 0 or 1
  end
  local first: SeqOperand = {value = 1, width = 1, precision = 0}
  local step: SeqOperand = {value = 1, width = 1, precision = 0}
  local last: SeqOperand
  local ok: boolean
  if n == 1 then
    last, ok = seq_scan(ops[1]); if not ok then return 1 end
  else
    first, ok = seq_scan(ops[1]); if not ok then return 1 end
    if n == 3 then
      step, ok = seq_scan(ops[2]); if not ok then return 1 end
      if step.value == 0 then return seq_usage_fail("invalid Zero increment value: '" .. ops[2] .. "'") end
    end
    last, ok = seq_scan(ops[n]); if not ok then return 1 end
  end
  -- fast path for integral values that print as plain digits
  if plain and seq_finite(first.value) and first.precision == 0 and step.precision == 0 and
      last.precision == 0 and 0 <= first.value and 0 <= last.value and 0 < step.value and step.value <= 200 then
    local buf: [512]byte
    local s1 = string.copy(seq_fmt('%0.Lf', first.value, &buf))
    local s2: string = 'inf'
    if seq_finite(last.value) then s2 = string.copy(seq_fmt('%0.Lf', last.value, &buf)) end
    if s1:byte(1) ~= '-'_b and s2:byte(1) ~= '-'_b then
      seq_fast(s1, s2, (@integer)(step.value), sep)
      return util.flush() and 0 or 1
    end
  end
  local prefix, suffix: integer = 0, 0
  if has_fmt then
    local err: string
    fmt, prefix, suffix, err = seq_ldformat(fmt)
    if err.size > 0 then return util.die(err) end
  else
    local prec = first.precision > step.precision and first.precision or step.precision
    fmt = '%Lg'
    if prec ~= SEQ_NOPREC and last.precision ~= SEQ_NOPREC then
      if equal then
        local fw = first.width + (prec - first.precision)
        local lw = last.width + (prec - last.precision)
        if last.precision ~= 0 and prec == 0 then lw = lw - 1 end
        if last.precision == 0 and prec ~= 0 then lw = lw + 1 end
        if first.precision == 0 and prec ~= 0 then fw = fw + 1 end
        fmt = string.format('%%0%d.%dLf', fw > lw and fw or lw, prec)
      else
        fmt = string.format('%%.%dLf', prec)
      end
    end
  end
  seq_print(fmt, prefix, suffix, first.value, step.value, last.value, sep)
  return util.flush() and 0 or 1
end


