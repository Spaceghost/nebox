-- cut: a port of GNU coreutils 9.1 src/cut.c and set-fields.c. -b/-c
-- (bytes; -n is ignored as in GNU), -f with -d, -s, --complement,
-- --output-delimiter (empty means NUL), -z, GNU's list syntax and errors,
-- and its handling of -d$'\n' and lines without a trailing delimiter.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'

local UMAX: uint64 <comptime> = 0xffffffffffffffff

local Range = @record{lo: uint64, hi: uint64}

local frp: sequence(Range)
local cur: integer          -- index into frp (1-based)
local suppress_non_delimited: boolean
local complement: boolean
local delim: byte
local line_delim: byte
local out_delim: string
local out_delim_given: boolean

local Input = @record{fd: cint, buf: [65536]byte, pos: integer, len: integer, eof: boolean, err: cint, back: integer}

local function getc(r: *Input): integer
  if r.back >= 0 then local c = r.back; r.back = -1; return c end
  if r.pos >= r.len then
    if r.eof then return -1 end
    local n: clong
    repeat n = sys.read(r.fd, &r.buf[0], #r.buf) until not (n < 0 and sys.errno() == sys.EINTR)
    if n < 0 then r.err = sys.errno(); r.eof = true; return -1 end
    if n == 0 then r.eof = true; return -1 end
    r.pos = 0; r.len = n
  end
  local c = r.buf[r.pos]
  r.pos = r.pos + 1
  return c
end

local function ungetc(r: *Input, c: integer)
  r.back = c
end

local function next_item(idx: *uint64)
  $idx = $idx + 1
  if $idx > frp[cur].hi then cur = cur + 1 end
end

local function print_kth(k: uint64): boolean return frp[cur].lo <= k end
local function is_range_start_index(k: uint64): boolean return k == frp[cur].lo end

local function usage_fail(msg: string): integer
  util.err(msg)
  util.flush()
  local m = "Try 'cut --help' for more information.\n"
  sys.write(2, m.data, m.size)
  return 1
end

-- set_fields; returns an error message or ''.
local function set_fields(fieldstr: string, pos_msgs: boolean): string
  local initial: uint64 = 1
  local value: uint64 = 0
  local lhs, rhs, dash_found, in_digits = false, false, false, false
  local num_start = 0
  local i = 1
  frp:clear()
  while true do
    local c: byte = i <= #fieldstr and fieldstr:byte(i) or 0
    if c == 45 then
      in_digits = false
      if dash_found then return pos_msgs and 'invalid byte or character range' or 'invalid field range' end
      dash_found = true
      i = i + 1
      if lhs and value == 0 then
        return pos_msgs and 'byte/character positions are numbered from 1' or 'fields are numbered from 1'
      end
      initial = lhs and value or 1
      value = 0
    elseif c == 44 or c == 32 or c == 9 or c == 0 then
      in_digits = false
      if dash_found then
        dash_found = false
        if not lhs and not rhs then return 'invalid range with no endpoint: -' end
        if not rhs then frp:push({initial, UMAX})
        else
          if value < initial then return 'invalid decreasing range' end
          frp:push({initial, value})
        end
        value = 0
      else
        if value == 0 then
          return pos_msgs and 'byte/character positions are numbered from 1' or 'fields are numbered from 1'
        end
        frp:push({value, value})
        value = 0
      end
      if c == 0 then break end
      i = i + 1
      lhs = false; rhs = false
    elseif c >= 48 and c <= 57 then
      if not in_digits or num_start == 0 then num_start = i end
      in_digits = true
      if dash_found then rhs = true else lhs = true end
      local d: uint64 = c - 48
      if value > (UMAX - d) // 10 or value * 10 + d == UMAX then
        local e = num_start
        while e <= #fieldstr and fieldstr:byte(e) >= 48 and fieldstr:byte(e) <= 57 do e = e + 1 end
        local bad = fieldstr:sub(num_start, e - 1)
        return (pos_msgs and 'byte/character offset ' or 'field number ') .. util.quote(bad) .. ' is too large'
      end
      value = value * 10 + d
      i = i + 1
    else
      return (pos_msgs and 'invalid byte/character position ' or 'invalid field value ') .. util.quote(fieldstr:sub(i))
    end
  end
  if #frp == 0 then return pos_msgs and 'missing list of byte/character positions' or 'missing list of fields' end
  -- qsort by lo compared as int, as GNU's compare_ranges does
  local n = #frp
  for a = 2, n do
    local v = frp[a]
    local key = (@int32)(v.lo)
    local b = a - 1
    while b >= 1 and (@int32)(frp[b].lo) > key do frp[b + 1] = frp[b]; b = b - 1 end
    frp[b + 1] = v
  end
  local k = 1
  while k <= #frp do
    local j = k + 1
    while j <= #frp do
      if frp[j].lo <= frp[k].hi then
        local r = frp[k]
        if frp[j].hi > r.hi then r.hi = frp[j].hi end
        frp[k] = r
        frp:remove(j)
      else
        break
      end
    end
    k = k + 1
  end
  if complement then
    local c: sequence(Range)
    for q = 1, #frp do c:push(frp[q]) end
    frp:clear()
    if c[1].lo > 1 then frp:push({1, c[1].lo - 1}) end
    for q = 2, #c do
      if c[q - 1].hi + 1 ~= c[q].lo then frp:push({c[q - 1].hi + 1, c[q].lo - 1}) end
    end
    if c[#c].hi < UMAX then frp:push({c[#c].hi + 1, UMAX}) end
    c:destroy()
  end
  frp:push({UMAX, UMAX})
  return ''
end

local function cut_bytes(r: *Input)
  local byte_idx: uint64 = 0
  local print_delimiter = false
  cur = 1
  while true do
    local c = getc(r)
    if c == line_delim then
      util.writebyte((@byte)(c))
      byte_idx = 0; print_delimiter = false; cur = 1
    elseif c == -1 then
      if byte_idx > 0 then util.writebyte(line_delim) end
      break
    else
      next_item(&byte_idx)
      if print_kth(byte_idx) then
        if out_delim_given then
          if print_delimiter and is_range_start_index(byte_idx) then util.write(out_delim) end
          print_delimiter = true
        end
        util.writebyte((@byte)(c))
      end
    end
  end
end

local function cut_fields(r: *Input)
  local field_idx: uint64 = 1
  local found_any = false
  cur = 1
  local c = getc(r)
  if c == -1 then return end
  ungetc(r, c)
  c = 0
  local buffer_first_field = suppress_non_delimited ~= (not print_kth(1))
  local field1: sequence(byte)
  while true do
    if field_idx == 1 and buffer_first_field then
      -- getndelim2: up to and including delim or line_delim
      field1:clear()
      while true do
        local ch = getc(r)
        if ch == -1 then break end
        field1:push((@byte)(ch))
        if ch == delim or ch == line_delim then break end
      end
      if #field1 == 0 then break end
      local n = #field1
      c = 0
      if field1[n] ~= delim then
        if not suppress_non_delimited then
          util.writebytes(&field1[1], (@usize)(n))
          if field1[n] ~= line_delim then util.writebyte(line_delim) end
          c = line_delim
        end
        continue
      end
      if print_kth(1) then
        if n > 1 then util.writebytes(&field1[1], (@usize)(n - 1)) end
        if delim == line_delim then
          local last_c = getc(r)
          if last_c ~= -1 then ungetc(r, last_c); found_any = true end
        else
          found_any = true
        end
      end
      next_item(&field_idx)
    end
    local prev_c = c
    if print_kth(field_idx) then
      if found_any then util.write(out_delim) end
      found_any = true
      while true do
        c = getc(r)
        if c == delim or c == line_delim or c == -1 then break end
        util.writebyte((@byte)(c))
        prev_c = c
      end
    else
      while true do
        c = getc(r)
        if c == delim or c == line_delim or c == -1 then break end
        prev_c = c
      end
    end
    if delim == line_delim and c == delim then
      local last_c = getc(r)
      if last_c ~= -1 then ungetc(r, last_c) else c = last_c end
    end
    if c == delim then
      next_item(&field_idx)
    elseif c == line_delim or c == -1 then
      if found_any or not (suppress_non_delimited and field_idx == 1) then
        if c == line_delim or prev_c ~= line_delim or delim == line_delim then util.writebyte(line_delim) end
      end
      if c == -1 then break end
      field_idx = 1
      cur = 1
      found_any = false
    end
  end
  field1:destroy()
end

local OUTPUT_DELIMITER_OPTION: integer <comptime> = 200
local COMPLEMENT_OPTION: integer <comptime> = 201
local cut_longs: []util.LongOpt = {
  {'bytes', 1, 98}, {'characters', 1, 99}, {'fields', 1, 102}, {'delimiter', 1, 100},
  {'only-delimited', 0, 115}, {'output-delimiter', 1, OUTPUT_DELIMITER_OPTION},
  {'complement', 0, COMPLEMENT_OPTION}, {'zero-terminated', 0, 122},
  {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
}

global function applet_cut(args: sequence(string)): integer
  suppress_non_delimited = false; complement = false
  delim = 0; line_delim = 10
  out_delim = ''; out_delim_given = false
  local delim_specified = false
  local byte_mode = false
  local spec: string = ''
  local have_spec = false
  local g = util.getopt(args, 'b:c:d:f:nsz', &cut_longs, #cut_longs)
  g.quiet = true
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 63 then return usage_fail(g.errmsg) end
    if c == util.UNSUPPORTED then return usage_fail("option '--" .. g.longname .. "' is not supported") end
    if c == 98 or c == 99 or c == 102 then
      if c ~= 102 then byte_mode = true end
      if have_spec then return usage_fail('only one list may be specified') end
      spec = g.optarg; have_spec = true
    elseif c == 100 then
      local a = g.optarg
      if #a > 1 then return usage_fail('the delimiter must be a single character') end
      delim = #a == 1 and a:byte(1) or 0
      delim_specified = true
    elseif c == OUTPUT_DELIMITER_OPTION then
      out_delim = #g.optarg == 0 and string.char(0) or g.optarg
      out_delim_given = true
    elseif c == 115 then suppress_non_delimited = true
    elseif c == 122 then line_delim = 0
    elseif c == COMPLEMENT_OPTION then complement = true end
  end
  if not have_spec then return usage_fail('you must specify a list of bytes, characters, or fields') end
  if byte_mode then
    if delim_specified then return usage_fail('an input delimiter may be specified only when operating on fields') end
    if suppress_non_delimited then
      return usage_fail('suppressing non-delimited lines makes sense\n\tonly when operating on fields')
    end
  end
  local e = set_fields(spec, byte_mode)
  if #e > 0 then return usage_fail(e) end
  if not delim_specified then delim = 9 end
  if not out_delim_given then out_delim = string.char(delim) end
  local operands = g:operands()
  if #operands == 0 then operands:push('-') end
  local ok = true
  for _, file in ipairs(operands) do
    local r: Input
    r.back = -1
    if file == '-' then r.fd = 0
    else
      r.fd = sys.open(file, sys.O_RDONLY, 0)
      if r.fd < 0 then util.err(util.quotef(file) .. ': ' .. sys.errstr()); ok = false; continue end
    end
    if byte_mode then cut_bytes(&r) else cut_fields(&r) end
    if r.fd ~= 0 then sys.close(r.fd) end
    if r.err ~= 0 then util.err(util.quotef(file) .. ': ' .. sys.strerror(r.err)); ok = false end
  end
  util.flush()
  return ok and 0 or 1
end
