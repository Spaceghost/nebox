-- find: a port of GNU findutils 4.9.0 find in the C locale: ftsfind.c (the
-- traversal over gnulib fts with FTS_NOSTAT|FTS_TIGHT_CYCLE_CHECK|FTS_CWDFD|
-- FTS_VERBATIM, src/nebox/gfts.nelua), parser.c (every option, test and
-- action with its argument checks, warnings and messages), tree.c (the
-- precedence parser, the implicit "( ... ) -print", cost estimates,
-- opt_expr's reordering at -O0..-O3 and the arm swaps, the -D tree/opt
-- dumps), pred.c (the predicates), print.c (-printf/-fprintf with every
-- directive, flag, width and escape, format_date's nanosecond insertion),
-- exec.c and lib/buildcmd.c (-exec/-execdir/-ok/-okdir with ";" and "+",
-- argument batches of 128 KiB, run_in_dir), util.c (get_statinfo,
-- digest_mode, the -H/-L/-P stat functions, -D and -O, error reporting
-- with one stat error per file), fstype.c (-fstype from the mount list),
-- sharefile.c (-fprint and friends sharing a stream per file), and lib/
-- listfile.c (-ls/-fls), printquoted.c, regextype.c, safe-atoi.c. Regular
-- expressions go through regex.compile_syntax (glibc re_compile_pattern
-- with the -regextype syntax bits), patterns through a port of glibc
-- fnmatch, dates for -newerXt through util.parse_datetime2. Streams are
-- buffered as glibc buffers them (4096 bytes, line buffered on a tty,
-- stderr unbuffered); exit runs GNU's close_stdout.
## pragmas.nogc = true

