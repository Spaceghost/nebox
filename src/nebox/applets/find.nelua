  add_entry(ARG_PUNCTUATION, 'a', parse_and, P_AND)
  add_entry(ARG_TEST, 'amin', parse_amin, P_AMIN)
  add_entry(ARG_PUNCTUATION, 'and', parse_and, P_AND)
