local start_points: CStrs = nilptr
local num_start_points: integer = 0

local function matches_start_point(glob: cstring, foldcase: boolean): boolean
  local flags = foldcase and fnmatch.CASEFOLD or 0
  if num_start_points > 0 then
    for i = 0, num_start_points - 1 do
      if fnmatch.match(view(glob), view(start_points[i]), flags) == 0 then return true end
    end
    return false
  end
  return fnmatch.match(view(glob), '.', flags) == 0
end

local function is_feasible_path_argument(arg: cstring, foldcase: boolean): boolean
  local s = (@Bytes)(arg)
  local n = cstrlen(s)
  local last = -1
  for i = 0, n - 1 do if s[i] == 47 then last = i end end
  if last >= 0 and s[last + 1] == 0 then
    return matches_start_point(arg, foldcase)
  end
  return true
end

local function insert_path_check(entry: integer, argv: CStrs, arg_ptr: *integer, predicate_name: string, pred: integer): boolean
  local foldcase = pred == P_IPATH
  local ok, name = collect_arg(argv, arg_ptr)
  if ok then
    local p = insert_primary_withpred(entry, pred, name)
    p.need_stat = false
    p.need_type = false
    p.str = name
    p.rate = estimate_pattern_match_rate(name, false)
    if not options.posixly_correct and not is_feasible_path_argument(name, foldcase) then
      error0('warning: -' .. predicate_name .. ' ' .. view(name) .. ' will not match anything because it ends with /.')
      p.rate = 1.0e-8_f32
    end
    return true
  end
  return false
end

local function parse_path(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_path_check(entry, argv, arg_ptr, 'path', P_PATH)
end
local function parse_wholename(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_path_check(entry, argv, arg_ptr, 'wholename', P_PATH)
end
local function parse_ipath(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_path_check(entry, argv, arg_ptr, 'ipath', P_IPATH)
end
local function parse_iwholename(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_path_check(entry, argv, arg_ptr, 'iwholename', P_IPATH)
end

local function parse_perm(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local ok, perm_expr = collect_arg(argv, arg_ptr)
  if not ok then return false end
  local pe = (@Bytes)(perm_expr)
  local mode_start = 0
  local kind = PERM_EXACT
  local rate: float32
  if pe[0] == 45 then mode_start = 1; kind = PERM_AT_LEAST; rate = 0.2_f32
  elseif pe[0] == 47 then mode_start = 1; kind = PERM_ANY; rate = 0.3_f32
  else mode_start = 0; kind = PERM_EXACT; rate = 0.01_f32 end
  local changes, cok = modechange.compile(view((@cstring)(&pe[mode_start])))
  if not cok or (pe[0] == 43 and pe[1] >= 48 and pe[1] < 56) then
    die('invalid mode ' .. q(view(perm_expr)))
  end
  local v0 = modechange.adjust(0, false, 0, changes)
  local v1 = modechange.adjust(0, true, 0, changes)
  changes:destroy()
  if pe[0] == 47 and v0 == 0 and v1 == 0 then
    error0('warning: you have specified a mode pattern ' .. view(perm_expr) ..
           ' (which is equivalent to /000). The meaning of -perm /000 has now been changed to be consistent with -perm -000; that is, while it used to match no files, it now matches all files.')
    kind = PERM_AT_LEAST
    rate = 0.9986_f32
  end
  local p = insert_primary(entry, perm_expr)
  p.rate = rate
  p.perm_kind = kind
  p.perm_val[0] = v0
  p.perm_val[1] = v1
  return true
end

local function parse_print(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_primary_noarg(entry)
  p.side_effects = true
  p.no_default_print = true
  p.need_stat = false
  p.need_type = false
  open_stdout(&p.fmt)
  return true
end

local function parse_print0(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_fprint(entry, nilptr)
end

local function parse_printf(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local saved = $arg_ptr
  local ok, format = collect_arg(argv, arg_ptr)
  if ok then
    local fmt: FormatVal
    open_stdout(&fmt)
    if insert_fprintf(&fmt, entry, format) then return true end
    $arg_ptr = saved
    return false
  end
  return false
end

local function parse_fprintf(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local saved = $arg_ptr
  local ok, filename = collect_arg(argv, arg_ptr)
  if ok then
    local ok2, format = collect_arg(argv, arg_ptr)
    if ok2 then
      local fmt: FormatVal
      open_output_file(filename, &fmt)
      saved = $arg_ptr
      if insert_fprintf(&fmt, entry, format) then return true end
    end
  end
  $arg_ptr = saved
  return false
end

local function parse_prune(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_primary_noarg(entry)
  if not options.do_dir_first then
    p.need_stat = false
    p.need_type = false
  end
  p.side_effects = true
  p.no_default_print = false
  return true
end

local function parse_quit(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_primary_noarg(entry)
  p.need_stat = false
  p.need_type = false
  p.side_effects = true
  p.no_default_print = false
  p.rate = 1.0_f32
  return true
end

local regex_names: [13]string = {
  'findutils-default', 'ed', 'emacs', 'gnu-awk', 'grep', 'posix-awk', 'awk', 'posix-basic',
  'posix-egrep', 'egrep', 'posix-extended', 'posix-minimal-basic', 'sed',
}

local function regex_flags(i: integer): uint64
  local common = regex.RE_CHAR_CLASSES | regex.RE_DOT_NEWLINE | regex.RE_DOT_NOT_NULL | regex.RE_INTERVALS | regex.RE_NO_EMPTY_RANGES
  local basic = common | regex.RE_BK_PLUS_QM | regex.RE_CONTEXT_INVALID_DUP
  local extended = common | regex.RE_CONTEXT_INDEP_ANCHORS | regex.RE_CONTEXT_INDEP_OPS | regex.RE_NO_BK_BRACES |
    regex.RE_NO_BK_PARENS | regex.RE_NO_BK_VBAR | regex.RE_CONTEXT_INVALID_OPS | regex.RE_UNMATCHED_RIGHT_PAREN_ORD
  local egrep = (extended | regex.RE_INVALID_INTERVAL_ORD | regex.RE_NEWLINE_ALT) & ~(regex.RE_CONTEXT_INVALID_OPS | regex.RE_DOT_NOT_NULL)
  if i == 0 then return regex.RE_DOT_NEWLINE
  elseif i == 1 then return basic
  elseif i == 2 then return 0
  elseif i == 3 then
    return (extended | regex.RE_BACKSLASH_ESCAPE_IN_LISTS | regex.RE_INVALID_INTERVAL_ORD) &
      ~(regex.RE_DOT_NOT_NULL | regex.RE_CONTEXT_INDEP_OPS | regex.RE_CONTEXT_INVALID_OPS)
  elseif i == 4 then return (basic | regex.RE_NEWLINE_ALT) & ~(regex.RE_CONTEXT_INVALID_DUP | regex.RE_DOT_NOT_NULL)
  elseif i == 5 then return extended | regex.RE_BACKSLASH_ESCAPE_IN_LISTS | regex.RE_INTERVALS | regex.RE_NO_GNU_OPS | regex.RE_INVALID_INTERVAL_ORD
  elseif i == 6 then
    return regex.RE_BACKSLASH_ESCAPE_IN_LISTS | regex.RE_DOT_NOT_NULL | regex.RE_NO_BK_PARENS | regex.RE_NO_BK_REFS |
      regex.RE_NO_BK_VBAR | regex.RE_NO_EMPTY_RANGES | regex.RE_DOT_NEWLINE | regex.RE_CONTEXT_INDEP_ANCHORS |
      regex.RE_CHAR_CLASSES | regex.RE_UNMATCHED_RIGHT_PAREN_ORD | regex.RE_NO_GNU_OPS
  elseif i == 7 then return basic
  elseif i == 8 or i == 9 then return egrep
  elseif i == 10 then return extended
  elseif i == 11 then return common | regex.RE_LIMITED_OPS
  end
  return basic
end

local function parse_regextype(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local ok, type_name = collect_arg(argv, arg_ptr)
  if ok then
    local tn = view(type_name)
    local found = -1
    for i = 0, 12 do
      if regex_names[i] == tn then found = i; break end
    end
    if found < 0 then
      local sb: stringbuilder
      sb:write('Unknown regular expression type ', q(tn), '; valid types are ')
      for i = 0, 12 do
        if i > 0 then sb:write(', ') end
        sb:write(q(regex_names[i]))
      end
      sb:write('.')
      die(sb:view())
    end
    options.regex_options = regex_flags(found)
    return parse_noop(entry, argv, arg_ptr)
  end
  return false
end

local function insert_regex(argv: CStrs, arg_ptr: *integer, entry: integer, regex_options: uint64): boolean
  local ok, rx = collect_arg(argv, arg_ptr)
  if ok then
    local p = insert_primary_withpred(entry, P_REGEX, rx)
    p.need_stat = false
    p.need_type = false
    local prog, err = regex.compile_syntax(view(rx), regex_options)
    if err.size > 0 then
      die("failed to compile regular expression '" .. view(rx) .. "': " .. err)
    end
    p.re = prog
    p.rate = estimate_pattern_match_rate(rx, true)
    return true
  end
  return false
end

local function parse_regex(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_regex(argv, arg_ptr, entry, options.regex_options)
end

local function parse_iregex(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_regex(argv, arg_ptr, entry, regex.RE_ICASE | options.regex_options)
end

local function parse_size(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  if argv == nilptr or argv[$arg_ptr] == nilptr then return false end
  local arg = (@Bytes)(argv[$arg_ptr])
  local len = cstrlen(arg)
  if len == 0 then die('invalid null argument to -size') end
  local suffix = arg[len - 1]
  local blksize = 512
  if suffix == 98 then blksize = 512; arg[len - 1] = 0
  elseif suffix == 99 then blksize = 1; arg[len - 1] = 0
  elseif suffix == 107 then blksize = 1024; arg[len - 1] = 0
  elseif suffix == 77 then blksize = 1024 * 1024; arg[len - 1] = 0
  elseif suffix == 71 then blksize = 1024 * 1024 * 1024; arg[len - 1] = 0
  elseif suffix == 119 then blksize = 2; arg[len - 1] = 0
  elseif suffix >= 48 and suffix <= 57 then suffix = 0
  else
    local sb: stringbuilder
    sb:write('invalid -size type `')
    sb:writebyte(arg[len - 1])
    sb:write("'")
    die(sb:view())
  end
  local ok, num, c_type = get_num((@cstring)(arg))
  if not ok then
    local sb: stringbuilder
    sb:write('Invalid argument `', view((@cstring)(arg)))
    if suffix ~= 0 then sb:writebyte(suffix) end
    sb:write("' to -size")
    die(sb:view())
    return false
  end
  local p = insert_primary(entry, (@cstring)(arg))
  p.size_kind = c_type
  p.size_blocksize = blksize
  p.size_size = num
  p.need_stat = true
  p.need_type = false
  local prod = num * (@uint64)(blksize)
  if c_type == COMP_GT then p.rate = prod > 20480 and 0.1_f32 or 0.9_f32
  elseif c_type == COMP_LT then p.rate = prod > 20480 and 0.9_f32 or 0.1_f32
  else p.rate = 0.01_f32 end
  $arg_ptr = $arg_ptr + 1
  return true
end

local function parse_samefile(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local st: sys.Stat
  local fst: sys.Stat
  local ok, filename = collect_arg_stat_info(argv, arg_ptr, &st)
  if not ok then return false end
  local fd: cint = -3
  local openflags: cint = sys.O_RDONLY
  if options.symlink_handling == SYMLINK_NEVER_DEREF then
    if options.open_nofollow_available then
      openflags = openflags | sys.O_NOFOLLOW
      fd = -1
    else
      if islnk(st.st_mode) then fd = -2 else fd = -1 end
    end
  else
    fd = -1
  end
  if fd == -1 then
    fd = sys.open(filename, openflags | sys.O_CLOEXEC, 0)
    if fd >= 0 then
      if sys.fstat(fd, &fst) ~= 0 then
        fatal_target_file_error(sys.errno(), view(filename))
      else
        if xstat(filename, &st) ~= 0 then fatal_target_file_error(sys.errno(), view(filename)) end
        if options.symlink_handling == SYMLINK_NEVER_DEREF and not options.open_nofollow_available then
          if islnk(st.st_mode) then
            sys.close(fd)
            fd = -1
          elseif not (st.st_dev == fst.st_dev and st.st_ino == fst.st_ino) then
            sys.close(fd)
            fd = -1
          end
        else
          st = fst
        end
      end
    end
  end
  local p = insert_primary(entry, filename)
  p.same_ino = st.st_ino
  p.same_dev = st.st_dev
  p.same_fd = fd
  p.need_type = false
  p.need_stat = true
  p.rate = 0.01_f32
  return true
end

local function parse_accesscheck(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_primary_noarg(entry)
  p.need_stat = false
  p.need_type = false
  p.side_effects = false
  p.no_default_print = false
  if p.func == P_EXECUTABLE then p.rate = 0.2_f32 else p.rate = 0.9_f32 end
  return true
end

local function insert_type(argv: CStrs, arg_ptr: *integer, entry: integer, which_pred: integer): boolean
  local pred_string = which_pred == P_XTYPE and '-xtype' or '-type'
  local ok, typeletter = collect_arg(argv, arg_ptr)
  if not ok then return false end
  local t = (@Bytes)(typeletter)
  if t[0] == 0 then
    die('Arguments to ' .. pred_string .. ' should contain at least one letter')
  end
  local p = insert_primary_withpred(entry, which_pred, typeletter)
  p.rate = 0.0_f32
  if which_pred == P_XTYPE then
    p.need_stat = true
    p.need_type = false
  else
    p.need_stat = false
    p.need_type = true
  end
  local i = 0
  while t[i] ~= 0 do
    local type_cell = 0
    local rate: float32 = 0.01_f32
    local c = t[i]
    if c == 98 then type_cell = FTYPE_BLK; rate = 0.000888_f32
    elseif c == 99 then type_cell = FTYPE_CHR; rate = 0.000443_f32
    elseif c == 100 then type_cell = FTYPE_DIR; rate = 0.0922_f32
    elseif c == 102 then type_cell = FTYPE_REG; rate = 0.875_f32
    elseif c == 108 then type_cell = FTYPE_LNK; rate = 0.0311_f32
    elseif c == 112 then type_cell = FTYPE_FIFO; rate = 7.554e-6_f32
    elseif c == 115 then type_cell = FTYPE_SOCK; rate = 1.59e-5_f32
    elseif c == 68 then
      local sb: stringbuilder
      sb:write(pred_string, ' ')
      sb:writebyte(c)
      sb:write(' is not supported because Solaris doors are not supported on the platform find was compiled on.')
      die(sb:view())
    else
      local sb: stringbuilder
      sb:write('Unknown argument to ', pred_string, ': ')
      sb:writebyte(c)
      die(sb:view())
    end
    if p.types[type_cell] then
      local sb: stringbuilder
      sb:write("Duplicate file type '")
      sb:writebyte(c)
      sb:write("' in the argument list to ", pred_string, '.')
      die(sb:view())
    end
    p.rate = p.rate + rate
    p.types[type_cell] = true
    i = i + 1
    if t[i] ~= 0 then
      if t[i] ~= 44 then
        die('Must separate multiple arguments to ' .. pred_string .. " using: ','")
      end
      i = i + 1
      if t[i] == 0 then
        die('Last file type in list argument to ' .. pred_string .. " is missing, i.e., list is ending on: ','")
      end
    end
  end
  return true
end

local function parse_type(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_type(argv, arg_ptr, entry, P_TYPE)
end

local function parse_xtype(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_type(argv, arg_ptr, entry, P_XTYPE)
end

local function parse_used(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local ok, offset_str = collect_arg(argv, arg_ptr)
  if ok then
    local tval: TimeVal
    if get_relative_timestamp(offset_str, &tval, 0, 0, DAYSECS,
        'arithmetic overflow while converting %s days to a number of seconds') then
      local p = insert_primary(entry, offset_str)
      p.rt_xval = tval.xval
      p.rt_kind = tval.kind
      p.rt_sec = tval.sec
      p.rt_nsec = tval.nsec
      p.rate = estimate_file_age_success_rate((@float32)(tdiv(tval.sec, DAYSECS)))
      return true
    end
    die('Invalid argument ' .. view(offset_str) .. ' to -used')
    return false
  end
  return false
end

local function parse_user(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local ok, username = collect_arg(argv, arg_ptr)
  if ok then
    local uid: cuint
    local pw = c_getpwnam(username)
    c_endpwent()
    if pw ~= nilptr then
      uid = pw.pw_uid
    else
      local uid_len = digits_len(username)
      if uid_len > 0 and (@Bytes)(username)[uid_len] == 0 then
        uid = (@cuint)(safe_atoi(username))
      else
        if (@Bytes)(username)[0] ~= 0 then
          die(q(view(username)) .. ' is not the name of a known user')
        else
          die('The argument to -user should not be empty')
        end
        return false
      end
    end
    local p = insert_primary(entry, username)
    p.uid = uid
    p.rate = uid < 100 and 0.99_f32 or 0.2_f32
    return true
  end
  return false
end

local function parse_version(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  sputs(outs, util.applet .. ' (nebox) after GNU findutils 4.9.0\n')
  sputs(outs, 'Features enabled: D_TYPE O_NOFOLLOW(' .. (options.open_nofollow_available and 'enabled' or 'disabled') ..
        ') LEAF_OPTIMISATION FTS(FTS_CWDFD) CBO(level=' .. tostring(options.optimisation_level) .. ') \n')
  xexit(0)
  return true
end

local function parse_context(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  if argv == nilptr or argv[$arg_ptr] == nilptr then return false end
  -- is_selinux_enabled () is 0 here: nebox has no SELinux support
  die('invalid predicate -context: SELinux is not enabled.')
  return false
end

local function parse_xdev(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  options.stay_on_filesystem = true
  return parse_noop(entry, argv, arg_ptr)
end

local function parse_ignore_race(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  options.ignore_readdir_race = true
  return parse_noop(entry, argv, arg_ptr)
end

local function parse_noignore_race(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  options.ignore_readdir_race = false
  return parse_noop(entry, argv, arg_ptr)
end

local function parse_time(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local saved = $arg_ptr
  local ok, timearg = collect_arg(argv, arg_ptr)
  if not ok then return false end
  local origin_sec = options.day_sec
  local origin_nsec = options.day_nsec
  local comp = get_comp_type(timearg)
  if comp == COMP_LT then origin_sec = origin_sec + (DAYSECS - 1) end
  local tval: TimeVal
  if not get_relative_timestamp(timearg, &tval, origin_sec, origin_nsec, DAYSECS,
      'arithmetic overflow while converting %s days to a number of seconds') then
    $arg_ptr = saved
    return false
  end
  local p = insert_primary(entry, timearg)
  p.rt_xval = tval.xval
  p.rt_kind = tval.kind
  p.rt_sec = tval.sec
  p.rt_nsec = tval.nsec
  p.rate = estimate_timestamp_success_rate(tval.sec)
  if (options.debug_options & DebugExpressionTree) ~= 0 then
    local k = tval.kind
    local sb: stringbuilder
    sb:write('inserting ', p.name, '\n')
    sb:write('    type: ', k == COMP_GT and 'gt' or (k == COMP_LT and 'lt' or 'eq'), '    ',
             k == COMP_GT and ' >' or (k == COMP_LT and ' <' or '>='), '  ')
    sb:write((@uint64)(p.rt_sec), ' ', ctime_str(p.rt_sec))
    if k == COMP_EQ then
      sb:write('                 <  ', (@uint64)(p.rt_sec + DAYSECS), ' ', ctime_str(p.rt_sec + DAYSECS))
    end
    eputs(sb:view())
    sb:destroy()
  end
  return true
end

local function add_entry(t: integer, name: string, f: ParseFn, pred: integer)
  parse_table:push({type = t, name = name, parse = f, pred = pred})
end

local function init_parse_table()
  add_entry(ARG_SPECIAL_PARSE, 'newerXY', parse_newerXY, P_NEWERXY)
  add_entry(ARG_PUNCTUATION, '!', parse_negate, P_NEGATE)
