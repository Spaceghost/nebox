local first_nonoption_arg: cstring = nilptr

local function found_parser(original_arg: cstring, entry: integer): integer
  local t = parse_table[entry].type
  if t ~= ARG_POSITIONAL_OPTION then
    if t == ARG_NOOP then return 0 end
    if t == ARG_OPTION then
      if first_nonoption_arg ~= nilptr and should_issue_warnings() then
        local oa = view(original_arg)
        error0('warning: you have specified the global option ' .. oa .. ' after the argument ' ..
               view(first_nonoption_arg) .. ', but global options are not positional, i.e., ' .. oa ..
               ' affects tests specified before it as well as those specified after it.  Please specify global options before other arguments.')
      end
    else
      if first_nonoption_arg == nilptr then first_nonoption_arg = original_arg end
    end
  end
  return entry
end

local function find_parser(search_name: cstring): integer
  local s = (@Bytes)(search_name)
  local n = cstrlen(s)
  if n == 8 and s[0] == 45 and s[1] == 110 and s[2] == 101 and s[3] == 119 and s[4] == 101 and s[5] == 114 then
    return found_parser(search_name, 1)
  end
  local nm = view(search_name)
  if n > 0 and s[0] == 45 then nm = (@string){data = &s[1], size = (@usize)(n - 1)} end
  for i = 2, #parse_table do
    if parse_table[i].name == nm then return found_parser(search_name, i) end
  end
  return 0
end

-------------------------------------------------------------------------------
-- formatted output helpers

local cbuf: Bytes = nilptr
local cbuf_cap: integer = 0

-- A NUL-terminated scratch copy of S (valid until the next call).
local function tmpc(s: string): cstring
  if cbuf_cap < #s + 1 then
    cbuf_cap = #s + 64
    cbuf = (@Bytes)(c_realloc(cbuf, (@csize)(cbuf_cap)))
  end
  for i = 0, < #s do cbuf[i] = s.data[i] end
  cbuf[#s] = 0
  return (@cstring)(cbuf)
end

local fbuf: [512]byte

local function out_formatted(s: *Stream, n: cint, big: Bytes)
  if n < 0 then return end
  if big ~= nilptr then
    swrite(s, big, n)
    c_free(big)
  else
    swrite(s, &fbuf[0], n)
  end
end

local function fprintf_s(s: *Stream, fmt: Bytes, arg: cstring)
  local n = c_snprintf((@cstring)(&fbuf[0]), 512, (@cstring)(fmt), arg)
  local big: Bytes = nilptr
  if n >= 512 then
    big = (@Bytes)(c_malloc((@csize)(n + 1)))
    c_snprintf((@cstring)(big), (@csize)(n + 1), (@cstring)(fmt), arg)
  end
  out_formatted(s, n, big)
end

local function fprintf_d(s: *Stream, fmt: Bytes, arg: cint)
  local n = c_snprintf((@cstring)(&fbuf[0]), 512, (@cstring)(fmt), arg)
  local big: Bytes = nilptr
  if n >= 512 then
    big = (@Bytes)(c_malloc((@csize)(n + 1)))
    c_snprintf((@cstring)(big), (@csize)(n + 1), (@cstring)(fmt), arg)
  end
  out_formatted(s, n, big)
end

local function fprintf_o(s: *Stream, fmt: Bytes, arg: cuint)
  local n = c_snprintf((@cstring)(&fbuf[0]), 512, (@cstring)(fmt), arg)
  local big: Bytes = nilptr
  if n >= 512 then
    big = (@Bytes)(c_malloc((@csize)(n + 1)))
    c_snprintf((@cstring)(big), (@csize)(n + 1), (@cstring)(fmt), arg)
  end
  out_formatted(s, n, big)
end

local function fprintf_g(s: *Stream, fmt: Bytes, arg: float64)
  local n = c_snprintf((@cstring)(&fbuf[0]), 512, (@cstring)(fmt), arg)
  local big: Bytes = nilptr
  if n >= 512 then
    big = (@Bytes)(c_malloc((@csize)(n + 1)))
    c_snprintf((@cstring)(big), (@csize)(n + 1), (@cstring)(fmt), arg)
  end
  out_formatted(s, n, big)
end

-- human_readable (N, human_ceiling, FROM, TO) where one divides the other
local hrbufs: [4][32]byte
local hrnext: integer = 0
local function hr(n: uint64, from: uint64, to: uint64): string
  local amt: uint64
  if to <= from then
    amt = n * (from // to)
  else
    local divisor = to // from
    amt = n // divisor
    if n % divisor ~= 0 then amt = amt + 1 end
  end
  local b = &hrbufs[hrnext]
  hrnext = (hrnext + 1) % 4
  local i = 31
  b[i] = 0
  repeat
    i = i - 1
    b[i] = 48 + (@byte)(amt % 10)
    amt = amt // 10
  until amt == 0
  return (@string){data = &b[i], size = (@usize)(31 - i)}
end

local function qmark(s: string): string
  local sb: stringbuilder
  for i = 0, < #s do
    local c = s.data[i]
    if c >= 32 and c < 127 then sb:writebyte(c) else sb:writebyte(63) end
  end
  return sb:promote()
end

-- print_quoted: S through FORMAT, '?' for unprintable bytes on a terminal.
local function print_quoted(fmt: *FormatVal, format: Bytes, s: string)
  if fmt.dest_is_tty then
    local qs = qmark(s)
    fprintf_s(fmt.stream, format, tmpc(qs))
    qs:destroy()
  else
    fprintf_s(fmt.stream, format, tmpc(s))
  end
end

local function areadlinkat(fd: cint, name: cstring): (boolean, string)
  local size: integer = 128
  while true do
    local buf = (@Bytes)(c_malloc((@csize)(size)))
    local r = c_readlinkat(fd, name, buf, (@csize)(size))
    if r < 0 then
      local e = sys.errno()
      c_free(buf)
      sys.seterrno(e)
      return false, ''
    end
    if r < size then
      local s = string.copy((@string){data = buf, size = (@usize)(r)})
      c_free(buf)
      return true, s
    end
    c_free(buf)
    size = size * 2
  end
  return false, ''
end

local function strmode(mode: cuint): string
  local b: [11]byte
  local t = mode & sys.S_IFMT
  if t == sys.S_IFREG then b[0] = 45
  elseif t == sys.S_IFDIR then b[0] = 100
  elseif t == sys.S_IFBLK then b[0] = 98
  elseif t == sys.S_IFCHR then b[0] = 99
  elseif t == sys.S_IFLNK then b[0] = 108
  elseif t == sys.S_IFIFO then b[0] = 112
  elseif t == sys.S_IFSOCK then b[0] = 115
  else b[0] = 63 end
  b[1] = (mode & 0x100) ~= 0 and 114 or 45
  b[2] = (mode & 0x80) ~= 0 and 119 or 45
  if (mode & S_ISUID) ~= 0 then b[3] = (mode & 0x40) ~= 0 and 115 or 83 else b[3] = (mode & 0x40) ~= 0 and 120 or 45 end
  b[4] = (mode & 0x20) ~= 0 and 114 or 45
  b[5] = (mode & 0x10) ~= 0 and 119 or 45
  if (mode & S_ISGID) ~= 0 then b[6] = (mode & 0x8) ~= 0 and 115 or 83 else b[6] = (mode & 0x8) ~= 0 and 120 or 45 end
  b[7] = (mode & 0x4) ~= 0 and 114 or 45
  b[8] = (mode & 0x2) ~= 0 and 119 or 45
  if (mode & S_ISVTX) ~= 0 then b[9] = (mode & 0x1) ~= 0 and 116 or 84 else b[9] = (mode & 0x1) ~= 0 and 120 or 45 end
  b[10] = 32
  return string.copy((@string){data = &b[0], size = 11})
end

-------------------------------------------------------------------------------
-- listfile.c

local inode_number_width = 9
local block_size_width = 6
local nlink_width = 3
local owner_width = 8
local group_width = 8
local major_device_number_width = 3
local minor_device_number_width = 3
local file_size_width = 8

local function pad_left(sb: *stringbuilder, s: string, width: integer): integer
  for _ = #s + 1, width do sb:writebyte(32) end
  sb:write(s)
  if #s > width then return #s end
  return width
end

local function print_name(sb: *stringbuilder, p: string, literal: boolean)
  if literal then sb:write(p); return end
  for i = 0, < #p do
    local c = p.data[i]
    if c == 92 then sb:write('\\\\')
    elseif c == 10 then sb:write('\\n')
    elseif c == 8 then sb:write('\\b')
    elseif c == 13 then sb:write('\\r')
    elseif c == 9 then sb:write('\\t')
    elseif c == 12 then sb:write('\\f')
    elseif c == 32 then sb:write('\\ ')
    elseif c == 34 then sb:write('\\"')
    elseif c > 32 and c < 127 then sb:writebyte(c)
    else
      sb:writebyte(92)
      sb:writebyte(48 + ((c >> 6) & 7))
      sb:writebyte(48 + ((c >> 3) & 7))
      sb:writebyte(48 + (c & 7))
    end
  end
end

local function list_file(name: string, dir_fd: cint, relname: cstring, statp: *sys.Stat, current_time: integer,
                         output_block_size: integer, literal_control_chars: boolean, stream: *Stream)
  local sb: stringbuilder
  local w = pad_left(&sb, hr(statp.st_ino, 1, 1), inode_number_width)
  if w > inode_number_width then inode_number_width = w end
  sb:writebyte(32)
  w = pad_left(&sb, hr((@uint64)(statp.st_blocks), 512, (@uint64)(output_block_size)), block_size_width)
  if w > block_size_width then block_size_width = w end
  sb:writebyte(32)
  local ms = strmode(statp.st_mode)
  sb:write(ms)
  ms:destroy()
  w = pad_left(&sb, hr(statp.st_nlink, 1, 1), nlink_width)
  if w > nlink_width then nlink_width = w end
  sb:writebyte(32)
  local pw = c_getpwuid(statp.st_uid)
  if pw ~= nilptr then
    local un = view(pw.pw_name)
    if #un > owner_width then owner_width = #un end
    sb:write(un)
    for _ = #un + 1, owner_width do sb:writebyte(32) end
    sb:writebyte(32)
  else
    local us = hr(statp.st_uid, 1, 1)
    sb:write(us)
    for _ = #us + 1, 8 do sb:writebyte(32) end
    sb:writebyte(32)
    local chars = (#us > 8 and #us or 8) + 1
    if chars > owner_width then owner_width = chars end
  end
  local gr = c_getgrgid(statp.st_gid)
  if gr ~= nilptr then
    local gn = view(gr.gr_name)
    if #gn > group_width then group_width = #gn end
    sb:write(gn)
    for _ = #gn + 1, group_width do sb:writebyte(32) end
    sb:writebyte(32)
  else
    local gs = hr(statp.st_gid, 1, 1)
    sb:write(gs)
    for _ = #gs + 1, group_width do sb:writebyte(32) end
    local chars = #gs > group_width and #gs or group_width
    if chars > group_width then group_width = chars end
    sb:writebyte(32)
  end
  local t = statp.st_mode & sys.S_IFMT
  if t == sys.S_IFCHR or t == sys.S_IFBLK then
    local rdev = statp.st_rdev
    local major = ((rdev >> 8) & 0xfff) | ((rdev >> 32) & ~0xfff_u64)
    local minor = (rdev & 0xff) | ((rdev >> 12) & ~0xff_u64)
    w = pad_left(&sb, hr(major, 1, 1), major_device_number_width)
    if w > major_device_number_width then major_device_number_width = w end
    sb:write(', ')
    w = pad_left(&sb, hr(minor, 1, 1), minor_device_number_width)
    if w > minor_device_number_width then minor_device_number_width = w end
  else
    w = pad_left(&sb, hr((@uint64)(statp.st_size), 1, 1), file_size_width)
    if w > file_size_width then file_size_width = w end
  end
  sb:writebyte(32)
  local mt = statp.st_mtim.tv_sec
  local f, ok = util.breaktime(mt, 0, false)
  if ok then
    local fmt: string
    if current_time - 6 * 30 * 24 * 60 * 60 <= mt and mt <= current_time + 60 * 60 then fmt = '%b %e %H:%M'
    else fmt = '%b %e  %Y' end
    local ts = util.timestr(fmt, &f)
    sb:write(ts, ' ')
    ts:destroy()
    f.zone:destroy()
  else
    if mt < 0 then
      local num = hr((@uint64)(-mt), 1, 1)
      for _ = 1, 12 - #num - 1 do sb:writebyte(32) end
      sb:write('-', num, ' ')
    else
      local num = hr((@uint64)(mt), 1, 1)
      for _ = #num + 1, 12 do sb:writebyte(32) end
      sb:write(num, ' ')
    end
  end
  print_name(&sb, name, literal_control_chars)
  if islnk(statp.st_mode) then
    local lok, linkname = areadlinkat(dir_fd, relname)
    if lok then
      sb:write(' -> ')
      print_name(&sb, linkname, literal_control_chars)
      linkname:destroy()
    else
      local e = sys.errno()
      sputs(stream, sb:view())
      sb:clear()
      error_e(e, name)
    end
  end
  sb:writebyte(10)
  sputs(stream, sb:view())
  sb:destroy()
end

-------------------------------------------------------------------------------
-- print.c: -printf output

local weekdays: [7]string = {'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'}
local months: [12]string = {'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'}

local function ns_suffix(nsec: integer): string
  local b: [40]byte
  local n = c_snprintf((@cstring)(&b[0]), 40, '.%09ld0', (@clong)(nsec))
  return string.copy((@string){data = &b[0], size = (@usize)(n)})
end

-- glibc strftime: the conversions glibc knows, others copied as written
local function glibc_strftime(fmt: string, f: *util.Time): string
  local sb: stringbuilder
  local i = 0
  local n = #fmt
  while i < n do
    local c = fmt.data[i]
    if c ~= 37 then sb:writebyte(c); i = i + 1; continue end
    local c2: byte = i + 1 < n and fmt.data[i + 1] or 0
    if c2 ~= 0 and strchr_set('aAbBcCdDeFgGhHIjklmMnpPrRsStTuUVwWxXyYzZ', c2) then
      local s = util.timestr((@string){data = &fmt.data[i], size = 2}, f)
      sb:write(s)
      s:destroy()
      i = i + 2
    elseif c2 == 37 then
      sb:writebyte(37)
      i = i + 2
    else
      sb:writebyte(37)
      if c2 ~= 0 then sb:writebyte(c2) end
      i = i + 2
    end
  end
  return sb:promote()
end

local function scan_for_digit_differences(p: string, qs: string): (boolean, integer, integer)
  local seen = false
  local first = 0
  local n = 0
  local i = 0
  while i < #p and i < #qs do
    if p.data[i] ~= qs.data[i] then
      local pd = p.data[i] >= 48 and p.data[i] <= 57
      local qd = qs.data[i] >= 48 and qs.data[i] <= 57
      if not pd or not qd then return false, 0, 0 end
      if not seen then first = i; n = 1; seen = true
      else
        if i - first == n then n = n + 1 else return false, 0, 0 end
      end
    end
    i = i + 1
  end
  if #p ~= #qs then return false, 0, 0 end
  return true, first, n
end

local function format_date(sec: integer, nsec: integer, kind: byte): string
  local fmt: string
  local need_ns = false
  if kind == 43 then
    fmt = '%Y-%m-%d+%T'
    need_ns = true
  else
    local fb: [2]byte = {37, kind}
    fmt = string.copy((@string){data = &fb[0], size = 2})
    need_ns = kind == 83 or kind == 84 or kind == 88 or kind == 64
  end
  local ns = need_ns and ns_suffix(nsec) or ''
  if kind ~= 64 then
    local f, ok = util.breaktime(sec, nsec, false)
    if ok then
      local buf = glibc_strftime(fmt, &f)
      local alt = f
      if alt.tm.tm_sec >= 11 then alt.tm.tm_sec = alt.tm.tm_sec - 11; alt.t = alt.t - 11
      else alt.tm.tm_sec = alt.tm.tm_sec + 11; alt.t = alt.t + 11 end
      local altbuf = glibc_strftime(fmt, &alt)
      local same, i, n = scan_for_digit_differences(buf, altbuf)
      altbuf:destroy()
      f.zone:destroy()
      if same and n == 2 and not (i + n < #buf and buf.data[i + n] >= 48 and buf.data[i + n] <= 57) then
        local sb: stringbuilder
        sb:write((@string){data = buf.data, size = (@usize)(i + n)}, ns,
                 (@string){data = &buf.data[i + n], size = (@usize)(#buf - i - n)})
        buf:destroy()
        buf = sb:promote()
      end
      if need_ns then ns:destroy() end
      if kind ~= 43 then fmt:destroy() end
      return buf
    end
  end
  local w: uint64 = (@uint64)(sec)
  local num = hr(sec < 0 and (0 - w) or w, 1, 1)
  local sb: stringbuilder
  if sec < 0 then sb:write('-') end
  sb:write(num)
  if need_ns then sb:write(ns) end
  return sb:promote()
end

local function ctime_format(sec: integer, nsec: integer): string
  local f, ok = util.breaktime(sec, nsec, false)
  if ok then
    local b: [256]byte
    local tm = &f.tm
    local n = c_snprintf((@cstring)(&b[0]), 256, '%3s %3s %2d %02d:%02d:%02d.%09ld0 %04d',
      (@cstring)(weekdays[tm.tm_wday].data), (@cstring)(months[tm.tm_mon].data), tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec,
      (@clong)(nsec), 1900 + tm.tm_year)
    f.zone:destroy()
    return string.copy((@string){data = &b[0], size = (@usize)(n)})
  end
  return format_date(sec, nsec, 64)
end

local function file_sparseness(p: *sys.Stat): float64
  if p.st_size == 0 then
    if p.st_blocks == 0 then return 1.0 end
    local zero: float64 = 0.0
    if p.st_blocks < 0 then return -1.0 / zero end
    return 1.0 / zero
  end
  local blklen = 512.0 * (@float64)(p.st_blocks)
  return blklen / (@float64)(p.st_size)
end

local function mode_to_filetype(m: cuint): cstring
  if m == sys.S_IFREG then return 'f'
  elseif m == sys.S_IFDIR then return 'd'
  elseif m == sys.S_IFLNK then return 'l'
  elseif m == sys.S_IFSOCK then return 's'
  elseif m == sys.S_IFBLK then return 'b'
  elseif m == sys.S_IFCHR then return 'c'
  elseif m == sys.S_IFIFO then return 'p' end
  return 'U'
end

local function c_lgetxattr(p: cstring, name: cstring, buf: pointer, n: csize): clong <cimport 'lgetxattr', cinclude '<sys/xattr.h>'> end
local function c_getxattr(p: cstring, name: cstring, buf: pointer, n: csize): clong <cimport 'getxattr', cinclude '<sys/xattr.h>'> end

-- getfilecon through the -P/-L/-H rules (libselinux reads security.selinux)
local function x_getfilecon(fd: cint, name: cstring): (boolean, string)
  local path: string
  local n = view(name)
  if fd == AT_FDCWD or (#n > 0 and n.data[0] == 47) then path = string.copy(n)
  else path = '/proc/self/fd/' .. tostring(fd) .. '/' .. n end
  local buf: [256]byte
  local follow = options.symlink_handling == SYMLINK_ALWAYS_DEREF or
    (options.symlink_handling == SYMLINK_DEREF_ARGSONLY and state.curdepth == 0)
  local r: clong
  if follow then
    r = c_getxattr(path, 'security.selinux', &buf[0], 255)
    if r < 0 and (sys.errno() == ENOENT or sys.errno() == ENOTDIR) then
      r = c_lgetxattr(path, 'security.selinux', &buf[0], 255)
    end
  else
    r = c_lgetxattr(path, 'security.selinux', &buf[0], 255)
  end
  local e = sys.errno()
  path:destroy()
  if r < 0 then sys.seterrno(e); return false, '' end
  local len = 0
  while len < r and buf[len] ~= 0 do len = len + 1 end
  return true, string.copy((@string){data = &buf[0], size = (@usize)(len)})
end

local function do_fprintf(dest: *FormatVal, seg: *Segment, pathname: string, st: *sys.Stat)
  local stream = dest.stream
  if seg.kind == KIND_PLAIN then
    swrite(stream, seg.text, seg.text_len)
    return
  elseif seg.kind == KIND_STOP then
    swrite(stream, seg.text, seg.text_len)
    if not sflush(stream) then nonfatal_nontarget_file_error(sys.errno(), dest.filename) end
    return
  end
  local c = seg.fc0
  local text = seg.text
  if c == 97 then
    local s = ctime_format(st.st_atim.tv_sec, st.st_atim.tv_nsec)
    fprintf_s(stream, text, tmpc(s)); s:destroy()
  elseif c == 98 then
    fprintf_s(stream, text, tmpc(hr((@uint64)(st.st_blocks), 512, 512)))
  elseif c == 99 then
    local s = ctime_format(st.st_ctim.tv_sec, st.st_ctim.tv_nsec)
    fprintf_s(stream, text, tmpc(s)); s:destroy()
  elseif c == 100 then
    fprintf_d(stream, text, (@cint)(state.curdepth))
  elseif c == 68 then
    fprintf_s(stream, text, tmpc(hr(st.st_dev, 1, 1)))
  elseif c == 102 then
    print_quoted(dest, text, base_name(pathname))
  elseif c == 70 then
    print_quoted(dest, text, filesystem_type(st))
  elseif c == 103 or c == 71 then
    local g: *Group = nilptr
    if c == 103 then g = c_getgrgid(st.st_gid) end
    if g ~= nilptr then
      text[seg.text_len] = 115
      fprintf_s(stream, text, g.gr_name)
    else
      fprintf_s(stream, text, tmpc(hr(st.st_gid, 1, 1)))
    end
  elseif c == 104 then
    local n = (@integer)(pathname.size)
    local s = n - 1
    while s >= 0 do
      if pathname.data[s] ~= 47 then break end
      s = s - 1
    end
    local len = n
    if 0 < s and s + 1 < n and pathname.data[s + 1] == 47 then len = s + 1 end
    local slash = -1
    for i = 0, len - 1 do if pathname.data[i] == 47 then slash = i end end
    if slash < 0 then print_quoted(dest, text, '.')
    else print_quoted(dest, text, (@string){data = pathname.data, size = (@usize)(slash)}) end
  elseif c == 72 then
    local l = state.starting_path_length
    if l > #pathname then l = #pathname end
    fprintf_s(stream, text, tmpc((@string){data = pathname.data, size = (@usize)(l)}))
  elseif c == 105 then
    fprintf_s(stream, text, tmpc(hr(st.st_ino, 1, 1)))
  elseif c == 107 then
    fprintf_s(stream, text, tmpc(hr((@uint64)(st.st_blocks), 512, 1024)))
  elseif c == 108 then
    local have = false
    local linkname: string = ''
    if islnk(st.st_mode) then
      have, linkname = areadlinkat(state.cwd_dir_fd, state.rel_pathname)
      if not have then
        nonfatal_target_file_error(sys.errno(), pathname)
        state.exit_status = 1
      end
    end
    if have then
      print_quoted(dest, text, linkname)
      linkname:destroy()
    else
      print_quoted(dest, text, '')
    end
  elseif c == 77 then
    local ms = strmode(st.st_mode)
    ms.data[10] = 0
    fprintf_s(stream, text, (@cstring)(ms.data))
    ms:destroy()
  elseif c == 109 then
    fprintf_o(stream, text, st.st_mode & MODE_ALL)
  elseif c == 110 then
    fprintf_s(stream, text, tmpc(hr(st.st_nlink, 1, 1)))
  elseif c == 112 then
    print_quoted(dest, text, pathname)
  elseif c == 80 then
    local cp: string = ''
    if state.curdepth > 0 then
      local off = state.starting_path_length
      if off < #pathname and pathname.data[off] == 47 then off = off + 1 end
      cp = (@string){data = &pathname.data[off], size = (@usize)(#pathname - off)}
    end
    print_quoted(dest, text, cp)
  elseif c == 115 then
    fprintf_s(stream, text, tmpc(hr((@uint64)(st.st_size), 1, 1)))
  elseif c == 83 then
    fprintf_g(stream, text, file_sparseness(st))
  elseif c == 116 then
    local s = ctime_format(st.st_mtim.tv_sec, st.st_mtim.tv_nsec)
    fprintf_s(stream, text, tmpc(s)); s:destroy()
  elseif c == 117 or c == 85 then
    local pw: *Passwd = nilptr
    if c == 117 then pw = c_getpwuid(st.st_uid) end
    if pw ~= nilptr then
      text[seg.text_len] = 115
      fprintf_s(stream, text, pw.pw_name)
    else
      fprintf_s(stream, text, tmpc(hr(st.st_uid, 1, 1)))
    end
  elseif c == 89 then
    if islnk(st.st_mode) then
      local sbuf: sys.Stat
      if c_fstatat(state.cwd_dir_fd, state.rel_pathname, &sbuf, 0) ~= 0 then
        local e = sys.errno()
        if e == ENOENT or e == ENOTDIR then fprintf_s(stream, text, 'N')
        elseif e == ELOOP then fprintf_s(stream, text, 'L')
        else
          fprintf_s(stream, text, '?')
          error_e(e, q(pathname))
        end
      else
        fprintf_s(stream, text, mode_to_filetype(sbuf.st_mode & sys.S_IFMT))
      end
    else
      fprintf_s(stream, text, mode_to_filetype(st.st_mode & sys.S_IFMT))
    end
  elseif c == 121 then
    fprintf_s(stream, text, mode_to_filetype(st.st_mode & sys.S_IFMT))
  elseif c == 90 then
    local ok, con = x_getfilecon(state.cwd_dir_fd, state.rel_pathname)
    if not ok then
      local e = sys.errno()
      fprintf_s(stream, text, '')
      error_e(e, 'getfilecon failed: ' .. q(pathname))
      state.exit_status = 1
    else
      fprintf_s(stream, text, tmpc(con))
      con:destroy()
    end
  elseif c == 37 then
    swrite(stream, text, seg.text_len)
  elseif c == 0 then
    die('error: % at end of format string')
  end
end

local function pred_fprintf(pathname: string, st: *sys.Stat, p: *Pred): boolean
  local dest = &p.fmt
  for i = 1, #dest.segments do
    local seg = &dest.segments[i]
    if seg.kind == KIND_FORMAT and seg.fc1 ~= 0 then
      local sec: integer
      local nsec: integer
      local valid = false
      local c = seg.fc0
      if c == 65 then sec = st.st_atim.tv_sec; nsec = st.st_atim.tv_nsec; valid = true
      elseif c == 66 then
        sec = -1; nsec = -1
        valid = seg.fc1 == 64
      elseif c == 67 then sec = st.st_ctim.tv_sec; nsec = st.st_ctim.tv_nsec; valid = true
      else sec = st.st_mtim.tv_sec; nsec = st.st_mtim.tv_nsec; valid = true end
      if valid then
        local s = format_date(sec, nsec, seg.fc1)
        fprintf_s(dest.stream, seg.text, tmpc(s))
        s:destroy()
      else
        fprintf_s(dest.stream, seg.text, '')
      end
    else
      do_fprintf(dest, seg, pathname, st)
    end
  end
  return true
end

-------------------------------------------------------------------------------
-- pred.c

local function apply_predicate(pathname: string, st: *sys.Stat, id: integer): boolean <forwarddecl> end
local function cleanup() <forwarddecl> end

local function ts_difference(s1: integer, n1: integer, s2: integer, n2: integer): float64
  return ((@float64)(s1) - (@float64)(s2)) + 1.0e-9 * (@float64)(n1 - n2)
end

local function compare_ts(s1: integer, n1: integer, s2: integer, n2: integer): integer
  if s1 == s2 and n1 == n2 then return 0 end
  local diff = ts_difference(s1, n1, s2, n2)
  return diff < 0.0 and -1 or 1
end

local function pred_timewindow(sec: integer, nsec: integer, p: *Pred, window: integer): boolean
  if p.rt_kind == COMP_GT then return compare_ts(sec, nsec, p.rt_sec, p.rt_nsec) > 0
  elseif p.rt_kind == COMP_LT then return compare_ts(sec, nsec, p.rt_sec, p.rt_nsec) < 0 end
  local delta = ts_difference(sec, nsec, p.rt_sec, p.rt_nsec)
  return delta > 0.0 and delta <= (@float64)(window)
end

local function numcmp(v: uint64, p: *Pred): boolean
  if p.num_kind == COMP_GT then return v > p.num_val
  elseif p.num_kind == COMP_LT then return v < p.num_val end
  return v == p.num_val
end

local function pred_type(pathname: string, st: *sys.Stat, p: *Pred): boolean
  if state.type == 0 then return false end
  local mode: cuint
  if state.have_stat then mode = st.st_mode else mode = state.type end
  local t = mode & sys.S_IFMT
  local ty = FTYPE_COUNT
  if t == sys.S_IFREG then ty = FTYPE_REG
  elseif t == sys.S_IFDIR then ty = FTYPE_DIR
  elseif t == sys.S_IFLNK then ty = FTYPE_LNK
  elseif t == sys.S_IFBLK then ty = FTYPE_BLK
  elseif t == sys.S_IFCHR then ty = FTYPE_CHR
  elseif t == sys.S_IFSOCK then ty = FTYPE_SOCK
  elseif t == sys.S_IFIFO then ty = FTYPE_FIFO end
  return ty ~= FTYPE_COUNT and p.types[ty]
end

local function match_lname(pathname: string, st: *sys.Stat, p: *Pred, ignore_case: boolean): boolean
  local ret = false
  if islnk(st.st_mode) then
    local ok, linkname = areadlinkat(state.cwd_dir_fd, state.rel_pathname)
    if ok then
      if fnmatch.match(view(p.str), linkname, ignore_case and fnmatch.CASEFOLD or 0) == 0 then ret = true end
      linkname:destroy()
    else
      nonfatal_target_file_error(sys.errno(), pathname)
      state.exit_status = 1
    end
  end
  return ret
end

local function pred_name_common(pathname: string, str: cstring, flags: integer): boolean
  local base = strip_trailing_slashes(base_name(pathname))
  return fnmatch.match(view(str), base, flags) == 0
end

-- -ok/-okdir: the prompt on stderr and gnulib yesno on standard input
local inbuf: [4096]byte
local inpos: integer = 0
local inlen: integer = 0
local ineof = false

local function in_getc(): integer
  if inpos < inlen then
    local c = inbuf[inpos]
    inpos = inpos + 1
    return c
  end
  if ineof then return -1 end
  local r: clong
  repeat r = sys.read(0, &inbuf[0], 4096) until not (r < 0 and sys.errno() == EINTR)
  if r <= 0 then ineof = true; return -1 end
  inlen = r
  inpos = 1
  return inbuf[0]
end

local function yesno(): boolean
  local c = in_getc()
  if c < 0 then return false end
  local first = c
  while c >= 0 and c ~= 10 do c = in_getc() end
  return first == 121 or first == 89
end

local function is_ok(program: cstring, arg: string): boolean
  sflush(outs)
  eputs('< ' .. view(program) .. ' ... ' .. arg .. ' > ? ')
  return yesno()
end

local tbuf: sequence(byte)

local function record_exec_dir(execp: *ExecVal): boolean
  if not execp.todo then
    local rel = view(state.rel_pathname)
    local has_slash = false
    for i = 0, < #rel do if rel.data[i] == 47 then has_slash = true; break end end
    local dir: string
    if has_slash then dir = mdir_name(rel) else dir = string.copy('.') end
    execp.wd_for_exec = default_allocator:new(@SavedCwd)
    execp.wd_for_exec.name = nilptr
    execp.wd_for_exec.desc = c_openat(state.cwd_dir_fd, dir, sys.O_RDONLY | sys.O_CLOEXEC, 0)
    dir:destroy()
    if execp.wd_for_exec.desc < 0 then return false end
  end
  return true
end

local function impl_pred_exec(pathname: string, st: *sys.Stat, p: *Pred): boolean
  local execp = &p.exec
  local islocal = p.func == P_EXECDIR or p.func == P_OKDIR
  local target: string
  local prefix: Bytes = nilptr
  local pfxlen = 0
  local result = false
  if islocal then
    if not record_exec_dir(execp) then
      die_e(sys.errno(), 'Failed to save working directory in order to run a command on ' .. q(pathname))
    end
    target = base_name(view(state.rel_pathname))
    if #target > 0 and target.data[0] == 47 then
      prefix = nilptr
      pfxlen = 0
    else
      prefix = (@Bytes)(('./').data)
      pfxlen = 2
    end
  else
    target = pathname
  end
  tbuf:clear()
  for i = 0, < #target do tbuf:push(target.data[i]) end
  tbuf:push(0)
  local tb = (@Bytes)(&tbuf[1])
  local tlen = #target
  if execp.multiple then
    bc_push_arg(execp, tb, tlen + 1, prefix, pfxlen, false)
    if execp.todo then state.execdirs_outstanding = true end
    result = true
  else
    for i = 1, execp.num_args do
      local a = execp.replace_vec[i]
      bc_do_insert(execp, (@Bytes)(a), cstrlen((@Bytes)(a)), prefix, pfxlen, tb, tlen, false)
    end
    bc_do_exec(execp)
    local stt = execp.last_child_status
    result = (stt & 0x7f) == 0 and ((stt >> 8) & 0xff) == 0
    if islocal then
      free_cwd(execp.wd_for_exec)
      default_allocator:delete(execp.wd_for_exec)
      execp.wd_for_exec = nilptr
    end
  end
  return result
end

local function pred_delete(pathname: string, st: *sys.Stat): boolean
  local rel = view(state.rel_pathname)
  if rel ~= '.' then
    local flags: cint = 0
    if state.have_stat and isdir(st.st_mode) then flags = flags | AT_REMOVEDIR end
    if c_unlinkat(state.cwd_dir_fd, state.rel_pathname, flags) == 0 then return true end
    if sys.errno() == ENOENT and options.ignore_readdir_race then
      sys.seterrno(0)
      return true
    end
    if sys.errno() == EISDIR then
      if (flags & AT_REMOVEDIR) == 0 then
        flags = flags | AT_REMOVEDIR
        if c_unlinkat(state.cwd_dir_fd, state.rel_pathname, flags) == 0 then return true end
      end
    end
    error_e(sys.errno(), 'cannot delete ' .. q(pathname))
    state.exit_status = 1
    return false
  end
  return true
end

local function pred_empty(pathname: string, st: *sys.Stat): boolean
  if isdir(st.st_mode) then
    sys.seterrno(0)
    local fd = c_openat(state.cwd_dir_fd, state.rel_pathname,
      sys.O_RDONLY | sys.O_CLOEXEC | sys.O_DIRECTORY | O_NOCTTY | O_NONBLOCK, 0)
    if fd < 0 then
      error_e(sys.errno(), q(pathname))
      state.exit_status = 1
      return false
    end
    local d = c_fdopendir(fd)
    if d == nilptr then
      error_e(sys.errno(), q(pathname))
      state.exit_status = 1
      sys.close(fd)
      return false
    end
    local empty = true
    sys.seterrno(0)
    while true do
      local dp = sys.readdir(d)
      if dp == nilptr then break end
      local nm = (@Bytes)(&dp.d_name[0])
      if nm[0] ~= 46 or (nm[1] ~= 0 and (nm[1] ~= 46 or nm[2] ~= 0)) then
        empty = false
        break
      end
    end
    if sys.errno() ~= 0 then
      error_e(sys.errno(), q(pathname))
      state.exit_status = 1
      sys.closedir(d)
      return false
    end
    if sys.closedir(d) ~= 0 then
      error_e(sys.errno(), q(pathname))
      state.exit_status = 1
      return false
    end
    return empty
  elseif isreg(st.st_mode) then
    return st.st_size == 0
  end
  return false
end

local function pred_xtype(pathname: string, st: *sys.Stat, p: *Pred): boolean
  local sbuf: sys.Stat
  local r: cint
  if following_links() then r = optionp_stat(state.rel_pathname, &sbuf)
  else r = optionl_stat(state.rel_pathname, &sbuf) end
  if r ~= 0 then
    local e = sys.errno()
    if following_links() and e == ENOENT then
      return pred_type(pathname, st, p)
    else
      error_e(e, q(pathname))
      state.exit_status = 1
    end
    return false
  end
  return pred_type(pathname, &sbuf, p)
end

local function eval_pred(pathname: string, st: *sys.Stat, id: integer): boolean
  local p = P(id)
  local f = p.func
  if f == P_AND then
    if p.left == 0 or apply_predicate(pathname, st, p.left) then return apply_predicate(pathname, st, p.right) end
    return false
  elseif f == P_OR then
    if p.left == 0 or not apply_predicate(pathname, st, p.left) then return apply_predicate(pathname, st, p.right) end
    return true
  elseif f == P_NEGATE then
    return not apply_predicate(pathname, st, p.right)
  elseif f == P_COMMA then
    if p.left ~= 0 then apply_predicate(pathname, st, p.left) end
    return apply_predicate(pathname, st, p.right)
  elseif f == P_TRUE or f == P_OPENPAREN or f == P_CLOSEPAREN then
    return true
  elseif f == P_FALSE then
    return false
  elseif f == P_AMIN then return pred_timewindow(st.st_atim.tv_sec, st.st_atim.tv_nsec, p, 60)
  elseif f == P_ATIME then return pred_timewindow(st.st_atim.tv_sec, st.st_atim.tv_nsec, p, DAYSECS)
  elseif f == P_CMIN then return pred_timewindow(st.st_ctim.tv_sec, st.st_ctim.tv_nsec, p, 60)
  elseif f == P_CTIME then return pred_timewindow(st.st_ctim.tv_sec, st.st_ctim.tv_nsec, p, DAYSECS)
  elseif f == P_MMIN then return pred_timewindow(st.st_mtim.tv_sec, st.st_mtim.tv_nsec, p, 60)
  elseif f == P_MTIME then return pred_timewindow(st.st_mtim.tv_sec, st.st_mtim.tv_nsec, p, DAYSECS)
  elseif f == P_ANEWER then return compare_ts(st.st_atim.tv_sec, st.st_atim.tv_nsec, p.rt_sec, p.rt_nsec) > 0
  elseif f == P_CNEWER then return compare_ts(st.st_ctim.tv_sec, st.st_ctim.tv_nsec, p.rt_sec, p.rt_nsec) > 0
  elseif f == P_NEWER then return compare_ts(st.st_mtim.tv_sec, st.st_mtim.tv_nsec, p.rt_sec, p.rt_nsec) > 0
  elseif f == P_NEWERXY then
    local s: integer, n: integer
    if p.rt_xval == XVAL_ATIME then s = st.st_atim.tv_sec; n = st.st_atim.tv_nsec
    elseif p.rt_xval == XVAL_CTIME then s = st.st_ctim.tv_sec; n = st.st_ctim.tv_nsec
    else s = st.st_mtim.tv_sec; n = st.st_mtim.tv_nsec end
    return compare_ts(s, n, p.rt_sec, p.rt_nsec) > 0
  elseif f == P_USED then
    local as, an = st.st_atim.tv_sec, st.st_atim.tv_nsec
    local cs, cn = st.st_ctim.tv_sec, st.st_ctim.tv_nsec
    if compare_ts(as, an, cs, cn) < 0 then return false end
    local ds = cs - as
    local dn = cn - an
    if dn < 0 then dn = dn + 1000000000; ds = ds - 1 end
    return pred_timewindow(ds, dn, p, DAYSECS)
  elseif f == P_DELETE then return pred_delete(pathname, st)
  elseif f == P_EMPTY then return pred_empty(pathname, st)
  elseif f == P_EXEC then return impl_pred_exec(pathname, st, p)
  elseif f == P_EXECDIR then return impl_pred_exec(view(state.rel_pathname), st, p)
  elseif f == P_OK then
    if is_ok(p.exec.replace_vec[1], pathname) then return impl_pred_exec(pathname, st, p) end
    return false
  elseif f == P_OKDIR then
    if is_ok(p.exec.replace_vec[1], pathname) then return impl_pred_exec(view(state.rel_pathname), st, p) end
    return false
  elseif f == P_EXECUTABLE then return c_faccessat(state.cwd_dir_fd, state.rel_pathname, sys.X_OK, 0) == 0
  elseif f == P_READABLE then return c_faccessat(state.cwd_dir_fd, state.rel_pathname, sys.R_OK, 0) == 0
  elseif f == P_WRITABLE then return c_faccessat(state.cwd_dir_fd, state.rel_pathname, sys.W_OK, 0) == 0
  elseif f == P_FLS or f == P_LS then
    list_file(pathname, state.cwd_dir_fd, state.rel_pathname, st, options.start_sec, options.output_block_size,
              p.literal_control_chars, p.fmt.stream)
    return true
  elseif f == P_FPRINT or f == P_PRINT then
    print_quoted(&p.fmt, (@Bytes)(('%s\n').data), pathname)
    return true
  elseif f == P_FPRINT0 or f == P_PRINT0 then
    swrite(p.fmt.stream, (@Bytes)(pathname.data), (@integer)(pathname.size))
    sputc(p.fmt.stream, 0)
    return true
  elseif f == P_FPRINTF then return pred_fprintf(pathname, st, p)
  elseif f == P_FSTYPE then return filesystem_type(st) == view(p.str)
  elseif f == P_GID then return numcmp(st.st_gid, p)
  elseif f == P_UID then return numcmp(st.st_uid, p)
  elseif f == P_INUM then return numcmp(st.st_ino, p)
  elseif f == P_LINKS then return numcmp(st.st_nlink, p)
  elseif f == P_GROUP then return p.gid == st.st_gid
  elseif f == P_USER then return p.uid == st.st_uid
  elseif f == P_ILNAME then return match_lname(pathname, st, p, true)
  elseif f == P_LNAME then return match_lname(pathname, st, p, false)
  elseif f == P_NAME then return pred_name_common(pathname, p.str, 0)
  elseif f == P_INAME then return pred_name_common(pathname, p.str, fnmatch.CASEFOLD)
  elseif f == P_PATH then return fnmatch.match(view(p.str), pathname, 0) == 0
  elseif f == P_IPATH then return fnmatch.match(view(p.str), pathname, fnmatch.CASEFOLD) == 0
  elseif f == P_NOGROUP then return c_getgrgid(st.st_gid) == nilptr
  elseif f == P_NOUSER then return c_getpwuid(st.st_uid) == nilptr
  elseif f == P_PERM then
    local mode = st.st_mode
    local perm_val = p.perm_val[isdir(mode) and 1 or 0]
    if p.perm_kind == PERM_AT_LEAST then return (mode & perm_val) == perm_val
    elseif p.perm_kind == PERM_ANY then
      if perm_val == 0 then return true end
      return (mode & perm_val) ~= 0
    end
    return (mode & MODE_ALL) == perm_val
  elseif f == P_PRUNE then
    if options.do_dir_first then
      if st ~= nilptr and isdir(st.st_mode) then state.stop_at_current_level = true end
    end
    return true
  elseif f == P_QUIT then
    cleanup()
    xexit(state.exit_status)
    return true
  elseif f == P_REGEX then
    local caps: regex.Caps
    if p.re:matchat(pathname, 0, &caps) and caps.at[1] == (@isize)(pathname.size) then return true end
    return false
  elseif f == P_SAMEFILE then
    if st.st_ino ~= 0 then
      if st.st_ino ~= p.same_ino then return false end
    end
    if get_statinfo(pathname, state.rel_pathname, st) == 0 then
      return st.st_ino == p.same_ino and st.st_dev == p.same_dev
    end
    return false
  elseif f == P_SIZE then
    local bs = (@uint64)(p.size_blocksize)
    local sz = (@uint64)(st.st_size)
    local f_val = sz // bs + ((sz % bs ~= 0) and 1 or 0)
    if p.size_kind == COMP_GT then return f_val > p.size_size
    elseif p.size_kind == COMP_LT then return f_val < p.size_size end
    return f_val == p.size_size
  elseif f == P_TYPE then return pred_type(pathname, st, p)
  elseif f == P_XTYPE then return pred_xtype(pathname, st, p)
  end
  return false
end

function apply_predicate(pathname: string, st: *sys.Stat, id: integer): boolean
  local p = P(id)
  p.visits = p.visits + 1
  if p.need_stat or p.need_type or p.need_inum then
    if get_info(pathname, st, p) ~= 0 then return false end
  end
  if eval_pred(pathname, st, id) then
    p.successes = p.successes + 1
    return true
  end
  return false
end

-------------------------------------------------------------------------------
-- tree.c

local function cost_name(c: integer): string
  if c == NeedsNothing then return 'Nothing'
  elseif c == NeedsInodeNumber then return 'InodeNumber'
  elseif c == NeedsType then return 'Type'
  elseif c == NeedsStatInfo then return 'StatInfo'
  elseif c == NeedsLinkName then return 'LinkName'
  elseif c == NeedsAccessInfo then return 'AccessInfo'
  elseif c == NeedsSyncDiskHit then return 'SyncDiskHit'
  elseif c == NeedsEventualExec then return 'EventualExec'
  elseif c == NeedsImmediateExec then return 'ImmediateExec'
  elseif c == NeedsUserInteraction then return 'UserInteraction'
  elseif c == NeedsUnknown then return 'Unknown' end
  return 'unknown'
end

local function type_name(t: integer): string
  if t == NO_TYPE then return 'no' elseif t == PRIMARY_TYPE then return 'primary'
  elseif t == UNI_OP then return 'uni_op' elseif t == BI_OP then return 'bi_op'
  elseif t == OPEN_PAREN then return 'open_paren  ' elseif t == CLOSE_PAREN then return 'close_paren ' end
  return 'unknown'
end

local function prec_name(t: integer): string
  if t == NO_PREC then return 'no' elseif t == COMMA_PREC then return 'comma'
  elseif t == OR_PREC then return 'or' elseif t == AND_PREC then return 'and'
  elseif t == NEGATE_PREC then return 'negate' elseif t == MAX_PREC then return 'max' end
  return 'unknown '
end

local function fmt_float(fmt: cstring, v: float64): string
  local b: [64]byte
  local n = c_snprintf((@cstring)(&b[0]), 64, fmt, v)
  return string.copy((@string){data = &b[0], size = (@usize)(n)})
end

local function print_predicate(sb: *stringbuilder, p: *Pred)
  if p.arg_text ~= nilptr then sb:write(p.name, ' ', view(p.arg_text))
  else sb:write(p.name) end
end

local function print_tree(sb: *stringbuilder, node: integer, indent: integer)
  if node == 0 then return end
  local p = P(node)
  for _ = 1, indent do sb:write('    ') end
  sb:write('pred=[')
  print_predicate(sb, p)
  sb:write('] type=', type_name(p.ptype), ' prec=', prec_name(p.prec))
  local r = fmt_float('%#.4g', (@float64)(p.rate))
  sb:write(' cost=', cost_name(p.cost), ' est_success_rate=', r, ' ', p.side_effects and '' or 'no ', 'side effects ')
  r:destroy()
  if p.need_stat or p.need_type or p.need_inum then
    local comma = false
    sb:write('Needs ')
    if p.need_stat then sb:write('stat'); comma = true end
    if p.need_inum then sb:write(comma and ',' or '', 'inode'); comma = true end
    if p.need_type then sb:write(comma and ',' or '', 'type') end
  end
  sb:write('\n')
  for _ = 1, indent do sb:write('    ') end
  if p.left == 0 and p.right == 0 then
    sb:write('no children.\n')
  else
    if p.left ~= 0 then
      sb:write('left:\n')
      print_tree(sb, p.left, indent + 1)
    else
      sb:write('no left.\n')
    end
    for _ = 1, indent do sb:write('    ') end
    if p.right ~= 0 then
      sb:write('right:\n')
      print_tree(sb, p.right, indent + 1)
    else
      sb:write('no right.\n')
    end
  end
end

local function eprint_tree(title: string, node: integer, indent: integer)
  local sb: stringbuilder
  sb:write(title)
  print_tree(&sb, node, indent)
  eputs(sb:view())
  sb:destroy()
end

local function print_list(sb: *stringbuilder, node: integer)
  local cur = node
  while cur ~= 0 do
    local nm = P(cur).name
    local n = #nm
    while n > 0 and (nm.data[n - 1] == 32 or nm.data[n - 1] == 9) do n = n - 1 end
    sb:write('[', (@string){data = nm.data, size = (@usize)(n)}, '] ')
    cur = P(cur).next
  end
  sb:write('\n')
end

local function print_optlist(sb: *stringbuilder, id: integer) <forwarddecl> end

local function print_parenthesised(sb: *stringbuilder, id: integer)
  if id ~= 0 then
    local p = P(id)
    if (p.func == P_OR or p.func == P_AND) and p.left == 0 then
      print_parenthesised(sb, p.right)
    else
      local parens = p.left ~= 0 or p.right ~= 0
      if parens then sb:write(' ( ') end
      print_optlist(sb, id)
      if parens then sb:write(' ) ') end
    end
  end
end

function print_optlist(sb: *stringbuilder, id: integer)
  if id ~= 0 then
    local p = P(id)
    print_parenthesised(sb, p.left)
    sb:write(p.need_stat and '[call stat] ' or '', p.need_type and '[need type] ' or '', p.need_inum and '[need inum] ' or '')
    print_predicate(sb, p)
    local r = fmt_float('%.4g', (@float64)(p.rate))
    sb:write(' [est success rate ', r, '] ')
    r:destroy()
    if (options.debug_options & DebugSuccessRates) ~= 0 then
      sb:write('[real success rate ', p.successes, '/', p.visits)
      if p.visits ~= 0 then
        local rr = fmt_float('%.4g', (@float64)(p.successes) / (@float64)(p.visits))
        sb:write('=', rr, '] ')
        rr:destroy()
      else
        sb:write('=_] ')
      end
    end
    print_parenthesised(sb, p.right)
  end
end

local function invalid_expr(msg: string) die(msg) end

local function scan_rest(input: *integer, head: integer, prev_prec: integer): integer <forwarddecl> end

local function get_expr(input: *integer, prev_prec: integer, prev_pred: integer): integer
  local nxt = 0
  local this_pred = $input
  if $input == 0 then die('invalid expression') end
  local ip = P($input)
  local t = ip.ptype
  if t == NO_TYPE then
    die('invalid expression')
  elseif t == BI_OP then
    die("invalid expression; you have used a binary operator '" .. P(this_pred).name .. "' with nothing before it.")
  elseif t == CLOSE_PAREN then
    if prev_pred == 0 then
      die("invalid expression: expected expression before closing parentheses '" .. P(this_pred).name .. "'.")
    end
    local pp = P(prev_pred)
    if (pp.ptype == UNI_OP or pp.ptype == BI_OP) and not P(this_pred).artificial then
      die("expected an expression between '" .. pp.name .. "' and ')'")
    elseif ip.artificial then
      die("expected an expression after '" .. pp.name .. "'")
    else
      die("invalid expression; you have too many ')'")
    end
  elseif t == PRIMARY_TYPE then
    nxt = $input
    $input = ip.next
  elseif t == UNI_OP then
    nxt = $input
    $input = ip.next
    P(nxt).right = get_expr(input, NEGATE_PREC, nxt)
  elseif t == OPEN_PAREN then
    if ip.next == 0 or P(ip.next).artificial then
      die("invalid expression; expected to find a ')' but didn't see one. Perhaps you need an extra predicate after '" ..
          P(this_pred).name .. "'")
    end
    prev_pred = $input
    $input = ip.next
    if P($input).ptype == CLOSE_PAREN then
      if P(prev_pred).artificial then
        die("invalid expression: expected expression before closing parentheses '" .. P($input).name .. "'.")
      end
      die('invalid expression; empty parentheses are not allowed.')
    end
    nxt = get_expr(input, NO_PREC, prev_pred)
    if $input == 0 or P($input).ptype ~= CLOSE_PAREN then
      die("invalid expression; I was expecting to find a ')' somewhere but did not see one.")
    end
    $input = P($input).next
  else
    die('oops -- invalid expression type!')
  end
  if $input == 0 then return nxt end
  if P($input).prec > prev_prec then
    nxt = scan_rest(input, nxt, prev_prec)
    if nxt == 0 then die('invalid expression') end
  end
  return nxt
end

function scan_rest(input: *integer, head: integer, prev_prec: integer): integer
  if $input == 0 or P($input).ptype == CLOSE_PAREN then return 0 end
  local tree = head
  while $input ~= 0 and P($input).prec > prev_prec do
    local t = P($input).ptype
    if t == NO_TYPE or t == PRIMARY_TYPE or t == UNI_OP or t == OPEN_PAREN then
      die('invalid expression')
    elseif t == BI_OP then
      local prev = $input
      P($input).left = tree
      tree = $input
      $input = P($input).next
      P(tree).right = get_expr(input, P(tree).prec, prev)
    elseif t == CLOSE_PAREN then
      return tree
    else
      die('oops -- invalid expression type (' .. tostring(t) .. ')!')
    end
  end
  return tree
end

local function predicate_is_cost_free(id: integer): boolean
  local p = P(id)
  if p.func == P_NAME or p.func == P_PATH or p.func == P_INAME or p.func == P_IPATH then return true end
  if options.optimisation_level > 0 then
    if p.func == P_AND or p.func == P_NEGATE or p.func == P_COMMA or p.func == P_OR then return false end
    return p.cost == NeedsNothing
  end
  return false
end

-- a pointer to a link: 0 the root, 1 a node's left, 2 a node's right
local Slot = @record{kind: integer, id: integer}

local function sget(s: Slot): integer
  if s.kind == 0 then return eval_tree end
  if s.kind == 1 then return P(s.id).left end
  return P(s.id).right
end

local function sset(s: Slot, v: integer)
  if s.kind == 0 then eval_tree = v
  elseif s.kind == 1 then P(s.id).left = v
  else P(s.id).right = v end
end

local PredList = @record{head: integer, tail: integer}

local function predlist_insert(list: *PredList, curr: integer, pprev: Slot)
  sset(pprev, P(curr).left)
  P(curr).left = list.head
  list.head = curr
  if list.tail == 0 then list.tail = list.head end
end

local function pred_cost_compare(p1: integer, p2: integer, wantfailure: boolean): integer
  local a = P(p1)
  local b = P(p2)
  if a.cost == b.cost then
    if a.rate == b.rate then return 0
    elseif wantfailure then return a.rate < b.rate and -1 or 1
    else return a.rate < b.rate and 1 or -1 end
  end
  return a.cost < b.cost and -1 or 1
end

local function constrain_rate(rate: float32): float32
  if rate > 1.0_f32 then return 1.0_f32
  elseif rate < 0.0 then return 0.0_f32 end
  return rate
end

local function getrate(id: integer): float32
  if id ~= 0 then return P(id).rate end
  return 1.0_f32
end

local function calculate_derived_rates(id: integer): float32
  local p = P(id)
  if p.right ~= 0 then calculate_derived_rates(p.right) end
  if p.left ~= 0 then calculate_derived_rates(p.left) end
  local t = p.ptype
  if t == NO_TYPE or t == PRIMARY_TYPE then
    return p.rate
  elseif t == UNI_OP then
    p.rate = (@float32)(1.0 - (@float64)(P(p.right).rate))
    return p.rate
  elseif t == BI_OP then
    local rate: float32
    if p.func == P_AND then rate = getrate(p.right) * getrate(p.left)
    elseif p.func == P_COMMA then rate = 1.0_f32
    else rate = getrate(p.right) + getrate(p.left) end
    p.rate = constrain_rate(rate)
    return p.rate
  end
  p.rate = 1.0_f32
  return p.rate
end

local function merge_pred(beg_list: integer, end_list: integer, last_p: Slot)
  P(end_list).left = sget(last_p)
  sset(last_p, beg_list)
end

local function predlist_merge_sort(list: *PredList, last: Slot)
  if list.head == 0 then return end
  if (options.debug_options & DebugTreeOpt) ~= 0 then eprint_tree('predlist before merge sort:\n', list.head, 2) end
  calculate_derived_rates(list.head)
  local new_list: PredList
  while list.head ~= 0 do
    local qq = list.head
    list.head = P(list.head).left
    P(qq).left = 0
    local p = new_list.head
    while p ~= 0 do
      local wantfailure = P(p).prec ~= OR_PREC
      if pred_cost_compare(P(p).right, P(qq).right, wantfailure) >= 0 then break end
      p = P(p).left
    end
    if p ~= 0 then
      P(qq).left = P(p).left
      if P(qq).left == 0 then new_list.tail = qq end
      P(p).left = qq
    else
      P(qq).left = new_list.head
      new_list.head = qq
      if new_list.tail == 0 then new_list.tail = qq end
    end
  end
  if (options.debug_options & DebugTreeOpt) ~= 0 then eprint_tree('predlist after merge sort:\n', new_list.head, 2) end
  calculate_derived_rates(new_list.head)
  merge_pred(new_list.head, new_list.tail, last)
  list.head = 0
  list.tail = 0
end

local function merge_lists(lists: *[11]PredList, name_list: *PredList, regex_list: *PredList, last: Slot)
  predlist_merge_sort(name_list, last)
  predlist_merge_sort(regex_list, last)
  for i = 0, 10 do predlist_merge_sort(&lists[i], last) end
end

local function subtree_has_side_effects(id: integer): boolean
  if id ~= 0 then
    local p = P(id)
    return p.side_effects or subtree_has_side_effects(p.left) or subtree_has_side_effects(p.right)
  end
  return false
end

local function worst_cost(id: integer): integer
  if id ~= 0 then
    local p = P(id)
    local cl = worst_cost(p.left)
    local cr = worst_cost(p.right)
    local worst = cl > cr and cl or cr
    if worst < p.cost then worst = p.cost end
    return worst
  end
  return 0
end

local function perform_arm_swap(id: integer)
  local p = P(id)
  local tmp = P(p.left).right
  P(p.left).right = p.right
  p.right = tmp
end

local function consider_arm_swap(id: integer): boolean
  local p = P(id)
  local reason: string = ''
  local left_cost = 0
  local right_cost = 0
  if p.ptype ~= BI_OP then reason = 'Not a binary operation' end
  if #reason == 0 then
    if p.left == 0 or p.right == 0 then reason = "Doesn't have two arms" end
  end
  if #reason == 0 then
    if P(p.left).right == 0 then reason = 'Left arm has no child on RHS' end
  end
  local pl = 0
  local pr = p.right
  if p.left ~= 0 then pl = P(p.left).right end
  if #reason == 0 then
    if subtree_has_side_effects(pl) then reason = 'Left subtree has side-effects' end
  end
  if #reason == 0 then
    if subtree_has_side_effects(pr) then reason = 'Right subtree has side-effects' end
  end
  if #reason == 0 then
    left_cost = worst_cost(pl)
    right_cost = worst_cost(pr)
    if left_cost < right_cost then reason = 'efficient as-is' end
  end
  if #reason == 0 then
    local want_swap = false
    if left_cost == right_cost then
      local l = P(pl).rate
      local r = P(pr).rate
      if (options.debug_options & DebugTreeOpt) ~= 0 then
        local a = fmt_float('%f', (@float64)(l))
        local b = fmt_float('%f', (@float64)(r))
        eputs('Success rates: l=' .. a .. ', r=' .. b .. '\n')
        a:destroy(); b:destroy()
      end
      if p.func == P_OR then
        want_swap = r < l
        if not want_swap then reason = 'Operation is OR; right success rate >= left' end
      elseif p.func == P_AND then
        want_swap = r > l
        if not want_swap then reason = 'Operation is AND; right success rate <= left' end
      else
        want_swap = false
        reason = "Not 'AND' or 'OR'"
      end
    else
      want_swap = true
    end
    if want_swap then
      if (options.debug_options & DebugTreeOpt) ~= 0 then eprint_tree('Performing arm swap on:\n', id, 0) end
      perform_arm_swap(id)
      return true
    end
  end
  if (options.debug_options & DebugTreeOpt) ~= 0 then
    eprint_tree('Not an arm swap candidate (' .. reason .. '):\n', id, 0)
  end
  return false
end

local function do_arm_swaps(id: integer): boolean
  if id ~= 0 then
    local swapped: boolean
    repeat
      swapped = false
      if consider_arm_swap(id) or do_arm_swaps(P(id).left) or do_arm_swaps(P(id).right) then
        swapped = true
      end
    until not swapped
    return swapped
  end
  return false
end

local function new_bare_pred(): integer
  local p = default_allocator:new(@Pred)
  p.same_fd = -1
  preds:push(p)
  return #preds
end

local function set_new_parent(curr: integer, high_prec: integer, prevp: Slot): integer
  local id = new_bare_pred()
  local np = P(id)
  np.ptype = BI_OP
  np.prec = high_prec
  np.cost = NeedsNothing
  if high_prec == COMMA_PREC then
    np.func = P_COMMA
    np.name = ','
    np.rate = 1.0_f32
  elseif high_prec == OR_PREC then
    np.func = P_OR
    np.name = '-o'
    np.rate = constrain_rate(P(curr).rate)
  elseif high_prec == AND_PREC then
    np.func = P_AND
    np.name = '-a'
    np.rate = constrain_rate(P(curr).rate)
  end
  np.right = curr
  sset(prevp, id)
  return id
end

local function opt_expr(eval_treep: Slot): boolean
  local regex_list: PredList
  local name_list: PredList
  local cbo_list: [11]PredList
  local has_side_effects = false
  if sget(eval_treep) == 0 then return false end
  local prevp = eval_treep
  local prev_prec = AND_PREC
  local curr = sget(prevp)
  while P(curr).left ~= 0 do
    prevp = (@Slot){kind = 1, id = curr}
    prev_prec = P(curr).prec
    curr = P(curr).left
  end
  if P(curr).ptype ~= BI_OP then set_new_parent(curr, prev_prec, prevp) end
  if (options.debug_options & (DebugExpressionTree | DebugTreeOpt)) ~= 0 then
    eprint_tree('Normalized Eval Tree:\n', sget(eval_treep), 0)
  end
  prevp = eval_treep
  local biop_prec = NO_PREC
  if sget(prevp) ~= 0 and P(sget(prevp)).ptype == BI_OP then biop_prec = P(sget(prevp)).prec end
  while true do
    curr = sget(prevp)
    if curr == 0 then break end
    if P(curr).ptype == BI_OP then
      if P(curr).prec ~= biop_prec then curr = set_new_parent(curr, biop_prec, prevp) end
    end
    local r = P(curr).right
    local p_type = P(r).ptype
    local pred_func = P(r).func
    if p_type == NO_TYPE or p_type == PRIMARY_TYPE then
      if biop_prec ~= COMMA_PREC and not P(r).side_effects then
        if predicate_is_cost_free(r) then
          if (options.debug_options & DebugTreeOpt) ~= 0 then
            local sb: stringbuilder
            sb:write('-O', options.optimisation_level, ': promoting cheap predicate ')
            print_predicate(&sb, P(r))
            sb:write(' into name_list\n')
            eputs(sb:view())
            sb:destroy()
          end
          predlist_insert(&name_list, curr, prevp)
          continue
        end
        if pred_func == P_REGEX then
          predlist_insert(&regex_list, curr, prevp)
          continue
        end
        local reorder = (options.optimisation_level > 1 and (P(r).cost == NeedsType or P(r).cost == NeedsInodeNumber)
                         and not P(r).need_stat) or options.optimisation_level > 2
        if reorder then
          if (options.debug_options & DebugTreeOpt) ~= 0 then
            local sb: stringbuilder
            sb:write('-O', options.optimisation_level, ': categorising predicate ')
            print_predicate(&sb, P(r))
            sb:write(' by cost (', cost_name(P(r).cost), ')\n')
            eputs(sb:view())
            sb:destroy()
          end
          predlist_insert(&cbo_list[P(r).cost], curr, prevp)
          continue
        end
      end
    elseif p_type == UNI_OP then
      local v = opt_expr((@Slot){kind = 2, id = r})
      P(r).side_effects = v
    elseif p_type == BI_OP then
      local v = opt_expr((@Slot){kind = 2, id = curr})
      P(P(curr).right).side_effects = v
    else
      die('oops -- invalid expression type!')
    end
    if P(P(curr).right).side_effects then
      merge_lists(&cbo_list, &name_list, &regex_list, prevp)
      has_side_effects = true
    end
    prevp = (@Slot){kind = 1, id = curr}
  end
  merge_lists(&cbo_list, &name_list, &regex_list, prevp)
  return has_side_effects
end

local function get_pred_cost(p: *Pred): integer
  local data_requirement_cost = NeedsNothing
  local inherent_cost = NeedsUnknown
  if p.need_stat then data_requirement_cost = NeedsStatInfo
  elseif p.need_inum then data_requirement_cost = NeedsInodeNumber
  elseif p.need_type then data_requirement_cost = NeedsType end
  if p.func == P_EXEC or p.func == P_EXECDIR then
    inherent_cost = p.exec.multiple and NeedsEventualExec or NeedsImmediateExec
  elseif p.func == P_FPRINTF then
    inherent_cost = p.cost
  else
    inherent_cost = costlookup[p.func]
  end
  if inherent_cost > data_requirement_cost then return inherent_cost end
  return data_requirement_cost
end

local function estimate_costs(id: integer)
  if id ~= 0 then
    estimate_costs(P(id).right)
    estimate_costs(P(id).left)
    P(id).cost = get_pred_cost(P(id))
  end
end

local function check_option_combinations(id: integer)
  local seen_delete = false
  local seen_prune = false
  local p = id
  while p ~= 0 do
    if P(p).func == P_DELETE then seen_delete = true
    elseif P(p).func == P_PRUNE then seen_prune = true end
    p = P(p).next
  end
  if seen_prune and seen_delete and not options.explicit_depth then
    die('The -delete action automatically turns on -depth, but -prune does nothing when -depth is in effect.  If you want to carry on anyway, just explicitly use the -depth option.')
  end
end

local function default_prints(id: integer): boolean
  local p = id
  while p ~= 0 do
    if P(p).no_default_print then return false end
    p = P(p).next
  end
  return true
end

local function looks_like_expression(arg: cstring, leading: boolean): boolean
  local a = (@Bytes)(arg)
  local c = a[0]
  if c == 45 then return a[1] ~= 0
  elseif c == 41 or c == 44 then
    if a[1] ~= 0 then return false end
    return not leading
  elseif c == 33 or c == 40 then
    return a[1] == 0
  end
  return false
end

local function build_expression_tree(argc: integer, argv: CStrs, end_of_leading_options: integer): integer
  predicates = 0
  start_points = (@CStrs)(&argv[end_of_leading_options])
  local i = end_of_leading_options
  while i < argc and not looks_like_expression(argv[i], true) do
    num_start_points = num_start_points + 1
    i = i + 1
  end
  local entry_open = find_parser('(')
  local entry_close = find_parser(')')
  local entry_print = find_parser('print')
  local argc_v = argc
  parse_openparen(entry_open, argv, &argc_v)
  P(last_pred).name = '('
  P(predicates).artificial = true
  first_nonoption_arg = nilptr
  while i < argc do
    state.already_issued_stat_error_msg = false
    if not looks_like_expression(argv[i], false) then
      error0('paths must precede expression: `' .. view(argv[i]) .. "'")
      if sys.access(argv[i], sys.F_OK) == 0 then
        error0("possible unquoted pattern after predicate `" .. P(last_pred).name .. "'?")
      end
      xexit(1)
    end
    local predicate_name = argv[i]
    local entry = find_parser(predicate_name)
    if entry == 0 then die("unknown predicate `" .. view(predicate_name) .. "'") end
    if parse_table[entry].type ~= ARG_SPECIAL_PARSE then i = i + 1 end
    local oldi = i
    if not parse_table[entry].parse(entry, argv, &i) then
      if argv[i] ~= nilptr then
        if parse_table[entry].type == ARG_SPECIAL_PARSE and i == oldi then
          die("invalid predicate `" .. view(predicate_name) .. "'")
        else
          die("invalid argument `" .. view(argv[i]) .. "' to `" .. view(predicate_name) .. "'")
        end
      else
        die("missing argument to `" .. view(predicate_name) .. "'")
      end
    else
      P(last_pred).name = view(predicate_name)
      if i ~= oldi then P(last_pred).arg_text = argv[oldi] else P(last_pred).arg_text = nilptr end
    end
  end
  if P(predicates).next == 0 then
    predicates = P(predicates).next
    last_pred = predicates
    parse_print(entry_print, argv, &argc_v)
    P(last_pred).name = '-print'
  elseif not default_prints(P(predicates).next) then
    predicates = P(predicates).next
  else
    parse_closeparen(entry_close, argv, &argc_v)
    P(last_pred).name = ')'
    P(last_pred).artificial = true
    parse_print(entry_print, argv, &argc_v)
    P(last_pred).name = '-print'
    P(last_pred).artificial = true
  end
  if (options.debug_options & (DebugExpressionTree | DebugTreeOpt)) ~= 0 then
    local sb: stringbuilder
    sb:write('Predicate List:\n')
    print_list(&sb, predicates)
    eputs(sb:view())
    sb:destroy()
  end
  check_option_combinations(predicates)
  local cur_pred = predicates
  eval_tree = get_expr(&cur_pred, NO_PREC, 0)
  calculate_derived_rates(eval_tree)
  if cur_pred ~= 0 then
    if P(cur_pred).func == P_CLOSEPAREN then
      die("you have too many ')'")
    else
      if #P(cur_pred).name > 0 then die("unexpected extra predicate '" .. P(cur_pred).name .. "'")
      else die('unexpected extra predicate') end
    end
  end
  if (options.debug_options & (DebugExpressionTree | DebugTreeOpt)) ~= 0 then
    eprint_tree('Eval Tree:\n', eval_tree, 0)
  end
  estimate_costs(eval_tree)
  opt_expr((@Slot){kind = 0, id = 0})
  do_arm_swaps(eval_tree)
  if (options.debug_options & (DebugExpressionTree | DebugTreeOpt)) ~= 0 then
    local sb: stringbuilder
    sb:write('Optimized Eval Tree:\n')
    print_tree(&sb, eval_tree, 0)
    sb:write('Optimized command line:\n')
    print_optlist(&sb, eval_tree)
    sb:write('\n')
    eputs(sb:view())
    sb:destroy()
  end
  return eval_tree
end

-------------------------------------------------------------------------------
-- util.c: cleanup

local function complete_pending_execs(id: integer)
  if id == 0 then return end
  complete_pending_execs(P(id).left)
  local p = P(id)
  if p.func == P_EXEC and p.exec.multiple then
    if p.exec.todo then bc_do_exec(&p.exec) end
  end
  complete_pending_execs(P(id).right)
end

local function do_complete_pending_execdirs(id: integer)
  if id == 0 then return end
  do_complete_pending_execdirs(P(id).left)
  local p = P(id)
  if p.func == P_EXECDIR or p.func == P_OKDIR then
    if p.exec.multiple then
      if p.exec.todo then do_exec(&p.exec) end
    end
  end
  do_complete_pending_execdirs(P(id).right)
end

local function complete_pending_execdirs()
  if state.execdirs_outstanding then
    do_complete_pending_execdirs(eval_tree)
    state.execdirs_outstanding = false
  end
end

local function traverse_tree(id: integer)
  if P(id).left ~= 0 then traverse_tree(P(id).left) end
  complete_pending_execs(id)
  if P(id).right ~= 0 then traverse_tree(P(id).right) end
end

function cleanup()
  if eval_tree ~= 0 then
    traverse_tree(eval_tree)
    complete_pending_execdirs()
  end
  sharefile_destroy()
  if restore_cwd(initial_wd) == 0 then
    free_cwd(initial_wd)
  else
    local e = sys.errno()
    local extra = ''
    if initial_wd.desc < 0 and initial_wd.name ~= nilptr then extra = ': ' .. view(initial_wd.name) end
    error_e(e, 'Failed to restore initial working directory' .. extra)
    sys._exit(1)
  end
  if not sflush(outs) then nonfatal_nontarget_file_error(sys.errno(), 'standard output') end
end

local function show_success_rates(id: integer)
  if (options.debug_options & DebugSuccessRates) ~= 0 then
    local sb: stringbuilder
    sb:write('Predicate success rates after completion:\n')
    print_optlist(&sb, id)
    sb:write('\n')
    eputs(sb:view())
    sb:destroy()
  end
end

-------------------------------------------------------------------------------
-- ftsfind.c

local ftsoptions: integer = gfts.NOSTAT | gfts.TIGHT_CYCLE_CHECK | gfts.CWDFD | gfts.VERBATIM
local prev_depth: integer = -2147483648

local function get_fts_info_name(info: integer): string
  if info == gfts.D then return 'FTS_D'
  elseif info == gfts.DC then return 'FTS_DC'
  elseif info == gfts.DEFAULT then return 'FTS_DEFAULT'
  elseif info == gfts.DNR then return 'FTS_DNR'
  elseif info == gfts.DOT then return 'FTS_DOT'
  elseif info == gfts.DP then return 'FTS_DP'
  elseif info == gfts.ERR then return 'FTS_ERR'
  elseif info == gfts.F then return 'FTS_F'
  elseif info == gfts.INIT then return 'FTS_INIT'
  elseif info == gfts.NS then return 'FTS_NS'
  elseif info == gfts.NSOK then return 'FTS_NSOK'
  elseif info == gfts.SL then return 'FTS_SL'
  elseif info == gfts.SLNONE then return 'FTS_SLNONE'
  elseif info == gfts.W then return 'FTS_W' end
  return '[' .. tostring(info) .. ']'
end

local function visit(p: *gfts.FTS, ent: *gfts.Ent, pstat: *sys.Stat)
  state.have_stat = ent.info ~= gfts.NS and ent.info ~= gfts.NSOK
  state.rel_pathname = gfts.accpath(p, ent)
  state.cwd_dir_fd = p.cwd_fd
  apply_predicate(gfts.path(p, ent), pstat, eval_tree)
  if state.stop_at_current_level then gfts.set(p, ent, gfts.SKIP) end
end

local function symlink_loop(name: cstring): boolean
  local st: sys.Stat
  local rv = xstat(name, &st)
  return rv ~= 0 and sys.errno() == ELOOP
end

local function pad6(s: string): string
  if #s >= 6 then return s end
  local sb: stringbuilder
  sb:write(s)
  for _ = #s + 1, 6 do sb:writebyte(32) end
  return sb:promote()
end

local function pad2d(v: integer): string
  local s = tostring(v)
  if #s >= 2 then return s end
  return ' ' .. s
end

local function issue_loop_warning(p: *gfts.FTS, ent: *gfts.Ent)
  local path = gfts.path(p, ent)
  if islnk(ent.st.st_mode) then
    error0('Symbolic link ' .. q(path) .. ' is part of a loop in the directory hierarchy; we have already visited the directory to which it points.')
  else
    local cyc = (@string){data = p.path, size = (@usize)(ent.cycle.pathlen)}
    error0('File system loop detected; ' .. q(path) .. ' is part of the same file system loop as ' .. q(cyc) .. '.')
  end
end

local function consider_visiting(p: *gfts.FTS, ent: *gfts.Ent)
  local statbuf: sys.Stat
  local mode: cuint
  local path = gfts.path(p, ent)
  if (options.debug_options & DebugSearch) ~= 0 then
    eputs('consider_visiting (early): ' .. q(path) .. ': fts_info=' .. pad6(get_fts_info_name(ent.info)) ..
          ', fts_level=' .. pad2d(ent.level) .. ', prev_depth=' .. tostring(prev_depth) ..
          ' fts_path=' .. q(path) .. ', fts_accpath=' .. q(view(gfts.accpath(p, ent))) .. '\n')
  end
  state.cwd_dir_fd = p.cwd_fd
  prev_depth = ent.level
  statbuf.st_ino = ent.st.st_ino
  if ent.info == gfts.ERR then
    nonfatal_target_file_error(ent.err_no, path)
    return
  end
  if ent.info == gfts.DNR then
    nonfatal_target_file_error(ent.err_no, path)
    if options.do_dir_first then return end
  elseif ent.info == gfts.DC then
    issue_loop_warning(p, ent)
    state.exit_status = 1
    return
  elseif ent.info == gfts.SLNONE then
    if symlink_loop(gfts.accpath(p, ent)) then
      nonfatal_target_file_error(ELOOP, path)
      return
    end
  elseif ent.info == gfts.NS then
    if ent.level == 0 then
      nonfatal_target_file_error(ent.err_no, path)
      return
    else
      if symlink_loop(gfts.accpath(p, ent)) then
        nonfatal_target_file_error(ELOOP, path)
        return
      else
        nonfatal_target_file_error(ent.err_no, path)
      end
    end
  end
  if ent.info == gfts.NSOK or ent.info == gfts.NS then
    mode = state.type
  else
    state.have_stat = true
    state.have_type = true
    statbuf = ent.st
    mode = statbuf.st_mode
    state.type = mode
    if mode == 0 then
      error0('WARNING: file ' .. q(path) .. ' appears to have mode 0000')
    end
  end
  state.curdepth = ent.level
  if mode ~= 0 then
    if not digest_mode(&mode, path, (@cstring)(ent.name), &statbuf, false) then return end
  end
  local ignore = false
  local isdir_ = isdir(mode) or ent.info == gfts.D or ent.info == gfts.DP or ent.info == gfts.DC
  if isdir_ and ent.info == gfts.NSOK then
    gfts.set(p, ent, gfts.AGAIN)
    return
  end
  if options.maxdepth >= 0 then
    if ent.level >= options.maxdepth then
      gfts.set(p, ent, gfts.SKIP)
      if ent.level > options.maxdepth then ignore = true end
    end
  end
  if ent.info == gfts.D and not options.do_dir_first then
    ignore = true
  elseif ent.info == gfts.DP and options.do_dir_first then
    ignore = true
  elseif ent.level < options.mindepth then
    ignore = true
  end
  if (options.debug_options & DebugSearch) ~= 0 then
    eputs('consider_visiting (late): ' .. q(path) .. ': fts_info=' .. pad6(get_fts_info_name(ent.info)) ..
          ', isdir=' .. (isdir_ and '1' or '0') .. ' ignore=' .. (ignore and '1' or '0') ..
          ' have_stat=' .. (state.have_stat and '1' or '0') .. ' have_type=' .. (state.have_type and '1' or '0') .. ' \n')
  end
  if not ignore then visit(p, ent, &statbuf) end
  if ent.info == gfts.DP then state.stop_at_current_level = false end
end

local function find(arg: cstring): boolean
  state.starting_path_length = cstrlen((@Bytes)(arg))
  state.cwd_dir_fd = AT_FDCWD
  if options.symlink_handling == SYMLINK_ALWAYS_DEREF then
    ftsoptions = ftsoptions | gfts.COMFOLLOW | gfts.LOGICAL
  elseif options.symlink_handling == SYMLINK_DEREF_ARGSONLY then
    ftsoptions = ftsoptions | gfts.COMFOLLOW | gfts.PHYSICAL
  else
    ftsoptions = ftsoptions | gfts.PHYSICAL
  end
  if options.stay_on_filesystem then ftsoptions = ftsoptions | gfts.XDEV end
  local arglist: sequence(string)
  arglist:push(view(arg))
  local p = gfts.open(arglist, ftsoptions)
  arglist:destroy()
  if p == nilptr then
    error_e(sys.errno(), 'cannot search ' .. q(view(arg)))
    state.exit_status = 1
  else
    local level: integer = -2147483648
    while true do
      sys.seterrno(0)
      local ent = gfts.read(p)
      if ent == nilptr then break end
      if state.execdirs_outstanding and ent.level ~= level then complete_pending_execdirs() end
      level = ent.level
      state.already_issued_stat_error_msg = false
      state.have_stat = false
      state.have_type = ent.st.st_mode ~= 0
      state.type = state.have_type and ent.st.st_mode or 0
      consider_visiting(p, ent)
    end
    local e = sys.errno()
    if e ~= 0 then
      error_e(e, 'failed to read file names from file system at or below ' .. q(view(arg)))
      state.exit_status = 1
      return false
    end
    if gfts.close(p) ~= 0 then
      error_e(sys.errno(), 'failed to restore working directory after searching ' .. view(arg))
      state.exit_status = 1
      return false
    end
  end
  return true
end

-- argv-iter.c over a stream of NUL-terminated names
local Files0 = @record{fd: cint, buf: [4096]byte, pos: integer, len: integer, eof: boolean, err: boolean, err_no: cint, n: integer}

local function f0_getc(r: *Files0): integer
  if r.pos < r.len then
    local c = r.buf[r.pos]
    r.pos = r.pos + 1
    return c
  end
  if r.eof or r.err then return -1 end
  local n: clong
  repeat n = sys.read(r.fd, &r.buf[0], 4096) until not (n < 0 and sys.errno() == EINTR)
  if n > 0 then
    r.len = n
    r.pos = 1
    return r.buf[0]
  end
  if n == 0 then r.eof = true else r.err = true; r.err_no = sys.errno() end
  return -1
end

-- getdelim (..., '\0', ...): false at end of input or on an error
local function f0_next(r: *Files0, tok: *sequence(byte)): boolean
  tok:clear()
  local got = false
  while true do
    local c = f0_getc(r)
    if c < 0 then break end
    got = true
    tok:push((@byte)(c))
    if c == 0 then break end
  end
  if not got then return false end
  if #tok == 0 or tok[#tok] ~= 0 then tok:push(0) end
  r.n = r.n + 1
  return true
end

local function process_all_startpoints(argc: integer, argv: CStrs): boolean
  local argv_starting_points = 0 < argc and not looks_like_expression(argv[0], true)
  local files0_quoted: string = ''
  local f0: *Files0 = nilptr
  if options.files0_from ~= nilptr then
    if argv_starting_points then
      error0('extra operand ' .. q(view(argv[0])))
      die('file operands cannot be combined with -files0-from')
    end
    f0 = default_allocator:new(@Files0)
    if view(options.files0_from) == '-' then
      if options.ok_prompt_stdin then
        die('option -files0-from reading from standard input cannot be combined with -ok, -okdir\n')
      end
      files0_quoted = q('(standard input)')
      f0.fd = 0
    else
      files0_quoted = q(view(options.files0_from))
      f0.fd = sys.open(options.files0_from, sys.O_RDONLY | sys.O_CLOEXEC, 0)
      if f0.fd < 0 then die_e(sys.errno(), 'cannot open ' .. files0_quoted .. ' for reading') end
      if options.ok_prompt_stdin then
        local sb1: sys.Stat
        local sb2: sys.Stat
        if sys.fstat(f0.fd, &sb1) == 0 and sys.fstat(0, &sb2) == 0 and sb1.st_ino == sb2.st_ino and sb1.st_dev == sb2.st_dev then
          die('option -files0-from: standard input must not refer to the same file when combined with -ok, -okdir: ' ..
              files0_quoted .. '\n')
        end
      end
    end
  else
    if not argv_starting_points then
      return find('.')
    end
  end
  local ok = true
  local ai = 0
  local tok: sequence(byte)
  while true do
    local file_name: cstring
    if f0 ~= nilptr then
      if not f0_next(f0, &tok) then
        if f0.err then
          error_e(f0.err_no, files0_quoted .. ': read error')
          state.exit_status = 1
          ok = false
        end
        break
      end
      file_name = (@cstring)(&tok[1])
    else
      if ai >= argc then break end
      file_name = argv[ai]
      ai = ai + 1
    end
    if (@Bytes)(file_name)[0] == 0 then
      if f0 == nilptr then
        error_e(ENOENT, q(''))
      else
        error0(files0_quoted .. ':' .. tostring(f0.n) .. ': invalid zero-length file name')
      end
      state.exit_status = 1
      ok = false
      continue
    end
    if f0 == nilptr and looks_like_expression(file_name, true) then break end
    state.starting_path_length = cstrlen((@Bytes)(file_name))
    if not find(file_name) then
      ok = false
      break
    end
  end
  if ok and f0 ~= nilptr then
    local bad = f0.err
    if f0.fd ~= 0 and sys.close(f0.fd) ~= 0 then bad = true end
    if bad then die('error reading ' .. files0_quoted) end
  end
  return ok
end

-------------------------------------------------------------------------------
-- util.c: leading options, -D, -O, usage

local debug_names: [9]string = {'exec', 'opt', 'rates', 'search', 'stat', 'time', 'tree', 'all', 'help'}
local debug_vals: [9]integer = {DebugExec, DebugExpressionTree | DebugTreeOpt, DebugSuccessRates, DebugSearch,
  DebugStat, DebugTime, DebugExpressionTree, DebugAll, DebugHelp}
local debug_docs: [9]string = {
  'Show diagnostic information relating to -exec, -execdir, -ok and -okdir',
  'Show diagnostic information relating to optimisation',
  'Indicate how often each predicate succeeded',
  'Navigate the directory tree verbosely',
  'Trace calls to stat(2) and lstat(2)',
  'Show diagnostic information relating to time-of-day and timestamp comparisons',
  'Display the expression tree',
  'Set all of the debug flags (but help)',
  'Explain the various -D options',
}

local function show_valid_debug_options(full: boolean)
  sputs(outs, 'Valid arguments for -D:\n')
  if full then
    for i = 0, 8 do
      local nm = debug_names[i]
      local sb: stringbuilder
      sb:write(nm)
      for _ = #nm + 1, 10 do sb:writebyte(32) end
      sb:write(' ', debug_docs[i], '\n')
      sputs(outs, sb:view())
      sb:destroy()
    end
  else
    for i = 0, 8 do
      if i > 0 then sputs(outs, ', ') end
      sputs(outs, debug_names[i])
    end
  end
end

function usage(status: integer)
  if status ~= 0 then
    eputs("Try '" .. util.applet .. " --help' for more information.\n")
    xexit(status)
  end
  sputs(outs, 'Usage: ' .. util.applet .. [[ [-H] [-L] [-P] [-Olevel] [-D debugopts] [path...] [expression]

Default path is the current directory; default expression is -print.
Expression may consist of: operators, options, tests, and actions.

Operators (decreasing precedence; -and is implicit where no others are given):
      ( EXPR )   ! EXPR   -not EXPR   EXPR1 -a EXPR2   EXPR1 -and EXPR2
      EXPR1 -o EXPR2   EXPR1 -or EXPR2   EXPR1 , EXPR2

Positional options (always true):
      -daystart -follow -nowarn -regextype -warn

Normal options (always true, specified before other expressions):
      -depth -files0-from FILE -maxdepth LEVELS -mindepth LEVELS
       -mount -noleaf -xdev -ignore_readdir_race -noignore_readdir_race

Tests (N can be +N or -N or N):
      -amin N -anewer FILE -atime N -cmin N -cnewer FILE -context CONTEXT
      -ctime N -empty -false -fstype TYPE -gid N -group NAME -ilname PATTERN
      -iname PATTERN -inum N -iwholename PATTERN -iregex PATTERN
      -links N -lname PATTERN -mmin N -mtime N -name PATTERN -newer FILE
      -nouser -nogroup -path PATTERN -perm [-/]MODE -regex PATTERN
      -readable -writable -executable
      -wholename PATTERN -size N[bcwkMG] -true -type [bcdpflsD] -uid N
      -used N -user NAME -xtype [bcdpfls]

Actions:
      -delete -print0 -printf FORMAT -fprintf FILE FORMAT -print 
      -fprint0 FILE -fprint FILE -ls -fls FILE -prune -quit
      -exec COMMAND ; -exec COMMAND {} + -ok COMMAND ;
      -execdir COMMAND ; -execdir COMMAND {} + -okdir COMMAND ;

Other common options:
      --help                   display this help and exit
      --version                output version information and exit

]])
  show_valid_debug_options(false)
  sputs(outs, "\nUse '-D help' for a description of the options, or see find(1)\n\n")
  xexit(status)
end

local function process_debug_options(arg: cstring)
  local s = (@Bytes)(arg)
  local n = cstrlen(s)
  local empty = true
  local i = 0
  while i < n do
    while i < n and s[i] == 44 do i = i + 1 end
    if i >= n then break end
    local st = i
    while i < n and s[i] ~= 44 do i = i + 1 end
    local tokn = (@string){data = &s[st], size = (@usize)(i - st)}
    -- strtok_r ends the token in place: later messages quote ARG as cut there
    if i < n then
      s[i] = 0
      i = i + 1
    end
    empty = false
    local found = false
    for k = 0, 8 do
      if debug_names[k] == tokn then
        options.debug_options = options.debug_options | debug_vals[k]
        found = true
        break
      end
    end
    if not found then
      error0('Ignoring unrecognised debug flag ' .. q(view(arg)))
    end
  end
  if empty then
    error0('Empty argument to the -D option.')
    usage(1)
  elseif (options.debug_options & DebugHelp) ~= 0 then
    show_valid_debug_options(true)
    xexit(0)
  end
end

local function process_optimisation_option(arg: cstring)
  local a = (@Bytes)(arg)
  if a[0] == 0 then
    die('The -O option must be immediately followed by a decimal integer')
  end
  if not (a[0] >= 48 and a[0] <= 57) then
    die('Please specify a decimal number immediately after -O')
  end
  local endp: cstring
  sys.seterrno(0)
  local opt_level = c_strtoul(arg, &endp, 10)
  local e = sys.errno()
  if opt_level == 0 and (@usize)(endp) == (@usize)(arg) then
    die('Please specify a decimal number immediately after -O')
  elseif (@Bytes)(endp)[0] ~= 0 then
    die('Invalid optimisation level ' .. view(arg))
  elseif opt_level == 0xffffffffffffffff and e ~= 0 then
    die_e(e, 'Invalid optimisation level ' .. view(arg))
  elseif opt_level > 65535 then
    die('Optimisation level ' .. tostring(opt_level) .. ' is too high.  If you want to find files very quickly, consider using GNU locate.')
  end
  options.optimisation_level = opt_level
end

local function process_leading_options(argc: integer, argv: CStrs): integer
  local i = 1
  local end_of_leading_options = 1
  while true do
    end_of_leading_options = i
    if i >= argc then break end
    local a = view(argv[i])
    if a == '-H' then set_follow_state(SYMLINK_DEREF_ARGSONLY)
    elseif a == '-L' then set_follow_state(SYMLINK_ALWAYS_DEREF)
    elseif a == '-P' then set_follow_state(SYMLINK_NEVER_DEREF)
    elseif a == '--' then
      end_of_leading_options = i + 1
      break
    elseif a == '-D' then
      if argc <= i + 1 then
        error0('Missing argument after the -D option.')
        usage(1)
      end
      process_debug_options(argv[i + 1])
      i = i + 1
    elseif #a >= 2 and a.data[0] == 45 and a.data[1] == 79 then
      process_optimisation_option((@cstring)(&a.data[2]))
    else
      end_of_leading_options = i
      break
    end
    i = i + 1
  end
  return end_of_leading_options
end

local function set_option_defaults()
  options.posixly_correct = sys.getenv('POSIXLY_CORRECT') ~= nilptr
  options.open_nofollow_available = true
  options.regex_options = 0
  options.warnings = sys.isatty(0) ~= 0
  options.literal_control_chars = false
  if options.posixly_correct then options.warnings = false end
  options.do_dir_first = true
  options.explicit_depth = false
  options.maxdepth = -1
  options.mindepth = -1
  local ts: sys.Timespec
  sys.clock_gettime(sys.CLOCK_REALTIME, &ts)
  options.start_sec = ts.tv_sec
  options.start_nsec = (ts.tv_nsec // 1000) * 1000
  options.day_sec = options.start_sec - DAYSECS
  options.day_nsec = options.start_nsec
  options.full_days = false
  options.stay_on_filesystem = false
  options.ignore_readdir_race = false
  options.output_block_size = options.posixly_correct and 512 or 1024
  options.debug_options = 0
  options.optimisation_level = 2
  if sys.getenv('FIND_BLOCK_SIZE') ~= nilptr then
    die('The environment variable FIND_BLOCK_SIZE is not supported, the only thing that affects the block size is the POSIXLY_CORRECT environment variable')
  end
  options.no_leaf_check = false
  set_follow_state(SYMLINK_NEVER_DEREF)
  options.files0_from = nilptr
  options.ok_prompt_stdin = false
end

local function lookup_entry(name: string): integer
  for i = 2, #parse_table do
    if parse_table[i].name == name then return i end
  end
  return 0
end

global function applet_find(args: sequence(string)): integer
  outs = stream_new(1, false)
  errs = stream_new(2, true)
  init_parse_table()
  entry_and = lookup_entry('and')
  entry_noop = lookup_entry('--noop')
  entry_false = lookup_entry('false')
  local argc = #args + 1
  local argv = (@CStrs)(c_malloc((@csize)((argc + 1) * 8)))
  argv[0] = cdup(util.applet)
  for i = 1, #args do argv[i] = cdup(args[i]) end
  argv[argc] = nilptr
  record_initial_cwd()
  state.already_issued_stat_error_msg = false
  state.exit_status = 0
  state.execdirs_outstanding = false
  state.cwd_dir_fd = AT_FDCWD
  set_option_defaults()
  local end_of_leading_options = process_leading_options(argc, argv)
  if (options.debug_options & DebugStat) ~= 0 then options.xstat = XSTAT_DEBUG end
  if (options.debug_options & DebugTime) ~= 0 then
    eputs('cur_day_start = ' .. ctime_str(options.day_sec))
  end
  build_expression_tree(argc, argv, end_of_leading_options)
  if process_all_startpoints(argc - end_of_leading_options, (@CStrs)(&argv[end_of_leading_options])) then
    show_success_rates(eval_tree)
    cleanup()
  end
  xexit(state.exit_status)
  return state.exit_status
end
