local function parse_links(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_num(argv, arg_ptr, entry)
  if p ~= nilptr then
    if p.num_val == 1 then p.rate = 0.99_f32
    elseif p.num_val == 2 then p.rate = 0.01_f32
    else p.rate = 1e-3_f32 end
    return true
  end
  $arg_ptr = $arg_ptr - 1
  return false
end

local function digits_len(s: cstring): integer
  local p = (@Bytes)(s)
  local i = 0
  while p[i] >= 48 and p[i] <= 57 do i = i + 1 end
  return i
end

local function parse_group(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local saved = $arg_ptr
  local ok, groupname = collect_arg(argv, arg_ptr)
  if ok then
    local gid: cuint
    local gr = c_getgrnam(groupname)
    c_endgrent()
    if gr ~= nilptr then
      gid = gr.gr_gid
    else
      local gid_len = digits_len(groupname)
      if gid_len > 0 then
        if (@Bytes)(groupname)[gid_len] == 0 then
          gid = (@cuint)(safe_atoi(groupname))
        else
          die(q(view(groupname)) .. ' is not the name of an existing group and it does not look like a numeric group ID because it has the unexpected suffix ' ..
              q(view((@cstring)(&(@Bytes)(groupname)[gid_len]))))
          $arg_ptr = saved
          return false
        end
      else
        if (@Bytes)(groupname)[0] ~= 0 then
          die(q(view(groupname)) .. ' is not the name of an existing group')
        else
          die('argument to -group is empty, but should be a group name')
        end
        $arg_ptr = saved
        return false
      end
    end
    local p = insert_primary(entry, groupname)
    p.gid = gid
    -- GNU reads the union through numinfo.l_val here
    p.rate = (@uint64)(gid) < 100 and 0.99_f32 or 0.2_f32
    return true
  end
  return false
end

local function usage(status: integer) <forwarddecl> end

local function parse_help(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
