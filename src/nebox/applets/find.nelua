local function do_parse_xmin(entry: integer, argv: CStrs, arg_ptr: *integer, xv: integer): boolean
  local saved = $arg_ptr
  local ok, minutes = collect_arg(argv, arg_ptr)
  if ok then
    local tval: TimeVal
    tval.xval = xv
    if get_relative_timestamp(minutes, &tval, options.day_sec + DAYSECS, options.day_nsec, 60,
        'arithmetic overflow while converting %s minutes to a number of seconds') then
      local p = insert_primary(entry, minutes)
      p.rt_xval = tval.xval
      p.rt_kind = tval.kind
      p.rt_sec = tval.sec
      p.rt_nsec = tval.nsec
      p.rate = estimate_timestamp_success_rate(tval.sec)
      return true
    end
    $arg_ptr = saved
  end
  return false
end

local function parse_amin(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return do_parse_xmin(entry, argv, arg_ptr, XVAL_ATIME)
end
local function parse_cmin(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return do_parse_xmin(entry, argv, arg_ptr, XVAL_CTIME)
end
local function parse_mmin(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return do_parse_xmin(entry, argv, arg_ptr, XVAL_MTIME)
end

local function parse_newerXY(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  if argv == nilptr or argv[$arg_ptr] == nilptr then return false end
  local a = (@Bytes)(argv[$arg_ptr])
  if cstrlen(a) ~= 8 then return false end
  local x = a[6]
  local y = a[7]
  if x == 66 or y == 66 then
    error0('This system does not provide a way to find the birth time of a file.')
    return false
  end
  if x == 116 or not strchr_set('aBcmt', x) or not strchr_set('aBcmt', y) then return false end
  if argv[$arg_ptr + 1] == nilptr then
    die('The ' .. q(view(argv[$arg_ptr])) .. ' test needs an argument')
  end
  $arg_ptr = $arg_ptr + 1
  local p = insert_primary(entry, argv[$arg_ptr])
  if x == 97 then p.rt_xval = XVAL_ATIME
  elseif x == 99 then p.rt_xval = XVAL_CTIME
  else p.rt_xval = XVAL_MTIME end
  if y == 116 then
    local ts: sys.Timespec
    local now: sys.Timespec
    now.tv_sec = options.start_sec
    now.tv_nsec = options.start_nsec
    local tz = util.tzalloc(sys.getenv('TZ'))
    if not util.parse_datetime2(&ts, view(argv[$arg_ptr]), &now, false, &tz) then
      die('I cannot figure out how to interpret ' .. q(view(argv[$arg_ptr])) .. ' as a date or time')
    end
    p.rt_sec = ts.tv_sec
    p.rt_nsec = ts.tv_nsec
  else
    local st: sys.Stat
    if xstat(argv[$arg_ptr], &st) ~= 0 then fatal_target_file_error(sys.errno(), view(argv[$arg_ptr])) end
    if y == 97 then p.rt_sec = st.st_atim.tv_sec; p.rt_nsec = st.st_atim.tv_nsec
    elseif y == 99 then p.rt_sec = st.st_ctim.tv_sec; p.rt_nsec = st.st_ctim.tv_nsec
    else p.rt_sec = st.st_mtim.tv_sec; p.rt_nsec = st.st_mtim.tv_nsec end
  end
  p.rt_kind = COMP_GT
  p.rate = estimate_timestamp_success_rate(p.rt_sec)
  $arg_ptr = $arg_ptr + 1
  return true
end

local function parse_noleaf(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  options.no_leaf_check = true
  return parse_noop(entry, argv, arg_ptr)
end

local function parse_nogroup(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
