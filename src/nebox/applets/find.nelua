    p.rate = 0.1_f32 * estimate_pattern_match_rate(name, false)
    return true
  end
  return false
end

local function check_name_arg(pred: string, alt: string, arg: cstring): boolean
  if should_issue_warnings() and has_any(arg, '/') then
    error0('warning: ' .. q(pred) .. ' matches against basenames only, but the given pattern contains a directory separator (' ..
           q('/') .. '), thus the expression will evaluate to false all the time.  Did you mean ' .. q(alt) .. '?')
  end
  return true
end

