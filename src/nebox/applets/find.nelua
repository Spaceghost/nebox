local Bytes = @*[0]byte
local CStrs = @*[0]cstring

local AT_FDCWD: cint <comptime> = -100
local AT_SYMLINK_NOFOLLOW: cint <comptime> = 0x100
local AT_REMOVEDIR: cint <comptime> = 0x200
local ENOENT: cint <comptime> = 2
local EINTR: cint <comptime> = 4
local E2BIG: cint <comptime> = 7
local EBADF: cint <comptime> = 9
local EACCES: cint <comptime> = 13
local ENOTDIR: cint <comptime> = 20
local EISDIR: cint <comptime> = 21
local ERANGE: cint <comptime> = 34
local ELOOP: cint <comptime> = 40
local O_NOCTTY: cint <comptime> = 0x100
local O_NONBLOCK: cint <comptime> = 0x800
local DAYSECS: integer <comptime> = 86400

local S_ISUID: cuint <comptime> = 0x800
local S_ISGID: cuint <comptime> = 0x400
local S_ISVTX: cuint <comptime> = 0x200
local MODE_ALL: cuint <comptime> = 0xFFF

local function isdir(m: cuint): boolean return (m & sys.S_IFMT) == sys.S_IFDIR end
local function islnk(m: cuint): boolean return (m & sys.S_IFMT) == sys.S_IFLNK end
local function isreg(m: cuint): boolean return (m & sys.S_IFMT) == sys.S_IFREG end

local function cstrlen(p: Bytes): integer
  local n = 0
  while p[n] ~= 0 do n = n + 1 end
  return n
end

local function view(c: cstring): string
  if c == nilptr then return '' end
  return (@string){data = (@Bytes)(c), size = (@usize)(cstrlen((@Bytes)(c)))}
end

-- A NUL-terminated copy that lives until exit.
local function cdup(s: string): cstring
  local p = (@Bytes)(c_malloc((@csize)(#s + 2)))
  for i = 0, < #s do p[i] = s.data[i] end
  p[#s] = 0
  p[#s + 1] = 0
  return (@cstring)(p)
end

local function errmsg(e: cint): string return view(sys.strerror(e)) end

-------------------------------------------------------------------------------
-- stdio streams

local Stream = @record{
  fd: cint,
  buf: Bytes,
  len: integer,
  cap: integer,
  err: boolean,
  unbuffered: boolean,
  linebuf: boolean,
  closed: boolean,
  dev: culong,
  ino: culong,
  name: string,
}

local function stream_new(fd: cint, unbuffered: boolean): *Stream
  local s = default_allocator:new(@Stream)
  s.fd = fd
  s.cap = 4096
  s.buf = (@Bytes)(c_malloc(4096))
  s.unbuffered = unbuffered
  s.linebuf = not unbuffered and sys.isatty(fd) ~= 0
  return s
end

local function write_all(fd: cint, p: Bytes, n: integer): boolean
  local done = 0
  while done < n do
    local r = sys.write(fd, &p[done], (@csize)(n - done))
    if r < 0 then
      if sys.errno() == EINTR then continue end
      return false
    end
    done = done + r
  end
  return true
end

-- fflush: false (errno set) when the pending bytes cannot be written; the
-- error indicator then stays set.
local function sflush(s: *Stream): boolean
  if s.len == 0 then return true end
  local ok = write_all(s.fd, s.buf, s.len)
  s.len = 0
  if not ok then s.err = true end
  return ok
end

local function swrite(s: *Stream, p: Bytes, n: integer)
  if n <= 0 then return end
  if s.unbuffered then
    if not write_all(s.fd, p, n) then s.err = true end
    return
  end
  local i = 0
  local room = s.cap - s.len
  if n > room then
    for k = 0, room - 1 do s.buf[s.len + k] = p[k] end
    s.len = s.cap
    i = room
    sflush(s)
    local whole = ((n - i) // s.cap) * s.cap
    if whole > 0 then
      if not write_all(s.fd, &p[i], whole) then s.err = true end
      i = i + whole
    end
  end
  for k = i, n - 1 do s.buf[s.len + k - i] = p[k] end
  s.len = s.len + (n - i)
  if s.linebuf then
    for k = i, n - 1 do
      if p[k] == 10 then sflush(s); break end
    end
  end
end

local function sputs(s: *Stream, str: string)
  swrite(s, (@Bytes)(str.data), (@integer)(str.size))
end

local function sputc(s: *Stream, c: byte)
  local b: [1]byte = {c}
  swrite(s, &b[0], 1)
end

local outs: *Stream
local errs: *Stream

-- Diagnostics: error (0, ERRNUM, ...) flushes stdout first.
local function eputs(str: string) sputs(errs, str) end

local function error0(msg: string)
  sflush(outs)
  local sb: stringbuilder
  sb:write(util.applet, ': ', msg, '\n')
  local v = sb:view()
  write_all(2, (@Bytes)(v.data), (@integer)(v.size))
  sb:destroy()
end

local function error_e(e: cint, msg: string)
  sflush(outs)
  local sb: stringbuilder
  sb:write(util.applet, ': ', msg)
  if e ~= 0 then sb:write(': ', errmsg(e)) end
  sb:write('\n')
  local v = sb:view()
  write_all(2, (@Bytes)(v.data), (@integer)(v.size))
  sb:destroy()
end

-- Every stream fopen'ed, in sharefile's hash bucket order at close time.
local files: sequence(*Stream)

-- exit (): atexit's close_stdout, then stdio flushes the other streams.
local function xexit(status: integer)
  local some_pending = outs.len ~= 0
  local prev_fail = outs.err
  local fclose_fail = false
  local e: cint = 0
  if not sflush(outs) then fclose_fail = true; e = sys.errno() end
  if not fclose_fail and sys.close(1) ~= 0 then fclose_fail = true; e = sys.errno() end
  if prev_fail or (fclose_fail and (some_pending or e ~= EBADF)) then
    if not fclose_fail then e = 0 end
    error_e(e, 'write error')
    sys._exit(1)
  end
  for i = 1, #files do
    if not files[i].closed then sflush(files[i]) end
  end
  sys._exit((@cint)(status))
end

local function die(msg: string)
  error0(msg)
  xexit(1)
end

local function die_e(e: cint, msg: string)
  error_e(e, msg)
  xexit(1)
end

local function q(s: string): string return quotearg.style(s, quotearg.LOCALE) end

