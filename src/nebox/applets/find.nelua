  rt_kind: integer,
  rt_sec: integer,
  rt_nsec: integer,
  perm_kind: integer,
  perm_val: [2]cuint,
  same_ino: culong,
  same_dev: culong,
  same_fd: cint,
  types: [7]boolean,
  fmt: FormatVal,
  exec: ExecVal,
  -- links
  next: integer,
  left: integer,
  right: integer,
  visits: integer,
  successes: integer,
}

local preds: sequence(*Pred)   -- every predicate allocated, index = id
local predicates: integer = 0  -- head of the input list
local last_pred: integer = 0
local eval_tree: integer = 0

local function P(i: integer): *Pred return preds[i] end

-------------------------------------------------------------------------------
-- report_file_err and friends (util.c)

local function report_file_err(exitval: integer, errno_value: cint, is_target_file: boolean, name: string)
  if not is_target_file or not state.already_issued_stat_error_msg then
    error_e(errno_value, q(name))
    state.exit_status = 1
    if exitval ~= 0 then xexit(exitval) end
  end
  if is_target_file then state.already_issued_stat_error_msg = true end
  if exitval ~= 0 then xexit(exitval) end
end

local function nonfatal_target_file_error(e: cint, name: string) report_file_err(0, e, true, name) end
local function fatal_target_file_error(e: cint, name: string) report_file_err(1, e, true, name) end
local function nonfatal_nontarget_file_error(e: cint, name: string) report_file_err(0, e, false, name) end
local function fatal_nontarget_file_error(e: cint, name: string)
  state.already_issued_stat_error_msg = false
  report_file_err(1, e, false, name)
end

-- get_statinfo: stat the current file unless that was done already.
local function get_statinfo(pathname: string, name: cstring, p: *sys.Stat): integer
  if not state.have_stat then
    if xstat(name, p) == 0 then
      if p.st_mode == 0 then
        error0('WARNING: file ' .. q(view(name)) .. ' appears to have mode 0000')
        state.exit_status = 1
      end
    else
      local e = sys.errno()
      if not options.ignore_readdir_race or e ~= ENOENT then
        nonfatal_target_file_error(e, pathname)
      end
      return -1
    end
  end
  state.have_stat = true
  state.have_type = true
  state.type = p.st_mode
  return 0
end

local function get_info(pathname: string, p: *sys.Stat, pp: *Pred): integer
  local todo = false
  if pp.need_stat and not state.have_stat then
    todo = true
  elseif pp.need_type and not state.have_type then
    todo = true
  elseif pp.need_inum then
    if p.st_ino == 0 then
      todo = true
    elseif not state.have_type or isdir(p.st_mode) then
      todo = true
    end
  end
  if todo then
    if get_statinfo(pathname, state.rel_pathname, p) ~= 0 then return -1 end
  end
  return 0
end

local function digest_mode(mode: *cuint, pathname: string, name: cstring, pstat: *sys.Stat, leaf: boolean): boolean
  if $mode ~= 0 then
    if islnk($mode) and following_links() then
      if get_statinfo(pathname, name, pstat) ~= 0 then return false end
      $mode = pstat.st_mode
      state.type = pstat.st_mode
      state.have_type = true
    else
      state.have_type = true
      pstat.st_mode = $mode
      state.type = $mode
    end
  else
    if leaf then
      state.have_stat = false
      state.have_type = false
      state.type = 0
    else
      if get_statinfo(pathname, name, pstat) ~= 0 then return false end
      $mode = pstat.st_mode
      state.type = pstat.st_mode
      state.have_type = true
    end
  end
  return true
end

-------------------------------------------------------------------------------
-- gnulib dirname/basename helpers

local function last_component_off(s: string): integer
  local base = 0
  local n = (@integer)(s.size)
  while base < n and s.data[base] == 47 do base = base + 1 end
  local last_was_slash = false
  for i = base, n - 1 do
    if s.data[i] == 47 then last_was_slash = true
    elseif last_was_slash then base = i; last_was_slash = false end
  end
  return base
end

local function base_len(s: string): integer
  local len = (@integer)(s.size)
  while 1 < len and s.data[len - 1] == 47 do len = len - 1 end
  return len
end

-- base_name (a view into S)
local function base_name(s: string): string
  local b = last_component_off(s)
  local n = (@integer)(s.size)
  if b >= n then
    return (@string){data = s.data, size = (@usize)(base_len(s))}
  end
  local rest = (@string){data = &s.data[b], size = (@usize)(n - b)}
  local length = base_len(rest)
  if b + length < n and s.data[b + length] == 47 then length = length + 1 end
  return (@string){data = &s.data[b], size = (@usize)(length)}
end

-- strip_trailing_slashes on a view
local function strip_trailing_slashes(s: string): string
  local b = last_component_off(s)
  local n = (@integer)(s.size)
  if b >= n then b = 0 end
  local rest = (@string){data = &s.data[b], size = (@usize)(n - b)}
  return (@string){data = s.data, size = (@usize)(b + base_len(rest))}
end

-- mdir_name (a new string)
local function mdir_name(s: string): string
  local prefix = (s.size > 0 and s.data[0] == 47) and 1 or 0
  local length = last_component_off(s)
  while prefix < length do
    if s.data[length - 1] ~= 47 then break end
    length = length - 1
  end
  if length == 0 then return string.copy('.') end
  return string.copy((@string){data = s.data, size = (@usize)(length)})
end

-------------------------------------------------------------------------------
-- fstype.c

local mount_list: sequence(mountlist.Entry)
local mount_list_read = false
local mount_list_ok = false

local function get_file_system_list(): boolean
  if not mount_list_read then
    mount_list, mount_list_ok = mountlist.read()
    mount_list_read = true
  end
  return mount_list_ok
end

local fstype_known = false
local current_fstype: string = ''
local current_fstype_set = false
local current_dev: culong = 0

local function file_system_type_uncached(statp: *sys.Stat): (string, boolean)
  if not get_file_system_list() then die('Cannot read mounted file system list') end
  local best = 0
  for i = 1, #mount_list do
    local e = &mount_list[i]
    if e.fstype == 'ignore' then continue end
    if e.dev == statp.st_dev then best = i end
  end
  if best > 0 then return mount_list[best].fstype, true end
  return 'unknown', false
end

local function filesystem_type(statp: *sys.Stat): string
  if current_fstype_set then
    if fstype_known and statp.st_dev == current_dev then return current_fstype end
  end
  current_dev = statp.st_dev
  current_fstype, fstype_known = file_system_type_uncached(statp)
  current_fstype_set = true
  return current_fstype
end

local function is_used_fs_type(name: string): boolean
  if name == 'afs' then return true end
  if get_file_system_list() then
    for i = 1, #mount_list do
      if mount_list[i].fstype == name then return true end
    end
  else
    return true
  end
  return false
end

-------------------------------------------------------------------------------
-- sharefile.c and open_output_file (parser.c)

local function sharefile_fopen(filename: cstring): *Stream
  local fd = sys.open(filename, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC | sys.O_CLOEXEC, 438)
  if fd < 0 then return nilptr end
  local st: sys.Stat
  if sys.fstat(fd, &st) < 0 then
    local e = sys.errno()
    sys.close(fd)
    sys.seterrno(e)
    return nilptr
  end
  for i = 1, #files do
    if files[i].dev == st.st_dev and files[i].ino == st.st_ino then
      sys.close(fd)
      return files[i]
    end
  end
  local s = stream_new(fd, false)
  s.dev = st.st_dev
  s.ino = st.st_ino
  s.name = string.copy(view(filename))
  files:push(s)
  return s
end

local function open_output_file(path: cstring, p: *FormatVal)
  p.segments = {}
  local ps = view(path)
  if ps == '/dev/stderr' then
    p.stream = errs
    p.filename = 'standard error'
  elseif ps == '/dev/stdout' then
    p.stream = outs
    p.filename = 'standard output'
  else
    p.stream = sharefile_fopen(path)
    p.filename = ps
    if p.stream == nilptr then fatal_nontarget_file_error(sys.errno(), ps) end
  end
  p.dest_is_tty = sys.isatty(p.stream.fd) ~= 0
end

local function open_stdout(p: *FormatVal) open_output_file('/dev/stdout', p) end

-- sharefile_destroy: close every file in hash_free's bucket order.
local function sharefile_destroy()
  local order: sequence(*Stream)
  for b = 0, 12 do
    -- a bucket holds its first entry, then the later ones newest first
    local first = true
    for i = 1, #files do
      local s = files[i]
      if (@integer)((s.dev ~ s.ino) % 13) == b and first then order:push(s); first = false end
    end
    for i = #files, 1, -1 do
      local s = files[i]
      if (@integer)((s.dev ~ s.ino) % 13) == b then
        local already = false
        for k = 1, #order do if order[k] == s then already = true end end
        if not already then order:push(s) end
      end
    end
  end
  for i = 1, #order do
    local s = order[i]
    if s.closed then continue end
    local fail = not sflush(s)
    local e = sys.errno()
    if sys.close(s.fd) ~= 0 and not fail then fail = true; e = sys.errno() end
    s.closed = true
    if fail then fatal_nontarget_file_error(e, s.name) end
  end
  order:destroy()
end

-------------------------------------------------------------------------------
-- save-cwd.c

local initial_wd: *SavedCwd = nilptr

local function save_cwd(cwd: *SavedCwd): cint
  cwd.name = nilptr
  cwd.desc = sys.open('.', sys.O_RDONLY | sys.O_CLOEXEC, 0)
  if cwd.desc < 0 then
    local buf: [4096]byte
    if sys.getcwd((@cstring)(&buf[0]), 4096) == nilptr then return -1 end
    cwd.name = cdup(view((@cstring)(&buf[0])))
  end
  return 0
end

local function restore_cwd(cwd: *SavedCwd): cint
  if cwd.desc >= 0 then return c_fchdir(cwd.desc) end
  return sys.chdir(cwd.name)
end

local function free_cwd(cwd: *SavedCwd)
  if cwd.desc >= 0 then sys.close(cwd.desc) end
end

local function record_initial_cwd()
  initial_wd = default_allocator:new(@SavedCwd)
  if save_cwd(initial_wd) ~= 0 then
    local e = sys.errno()
    local extra = ''
    if initial_wd.desc < 0 and initial_wd.name ~= nilptr then extra = ': ' .. view(initial_wd.name) end
    die_e(e, 'Failed to save initial working directory' .. extra)
  end
end

-------------------------------------------------------------------------------
-- buildcmd.c and exec.c

local insertbuf: Bytes = nilptr
local launch_first_time = true

local function bc_size_of_environment(): integer
  local len = 0
  local i = 0
  while environ[i] ~= nilptr do
    len = len + cstrlen((@Bytes)(environ[i])) + 1
    i = i + 1
  end
  return len
end

local function bc_init_controlinfo(ctl: *ExecVal, headroom: integer): integer
  local size_of_environment = bc_size_of_environment()
  ctl.posix_arg_size_min = 4096
  local v = sys.sysconf(0)
  ctl.posix_arg_size_max = v > 0 and v or 0x7fffffffffffffff
  ctl.exit_if_size_exceeded = false
  if size_of_environment > ctl.posix_arg_size_max then return 1
  elseif headroom + size_of_environment >= ctl.posix_arg_size_max then return 2 end
  ctl.posix_arg_size_max = ctl.posix_arg_size_max - size_of_environment - headroom
  ctl.max_arg_count = (ctl.posix_arg_size_max // 8) - 2
  ctl.rplen = 0
  ctl.has_replace = false
  ctl.initial_argc = 0
  ctl.lines_per_exec = 0
  ctl.args_per_exec = 0
  ctl.arg_max = ctl.posix_arg_size_max
  return 0
end

local function bc_use_sensible_arg_max(ctl: *ExecVal)
  local arg_size = 128 * 1024
  if arg_size > ctl.posix_arg_size_max then ctl.arg_max = ctl.posix_arg_size_max
  elseif arg_size < ctl.posix_arg_size_min then ctl.arg_max = ctl.posix_arg_size_min
  else ctl.arg_max = arg_size end
end

local function bc_init_state(ctl: *ExecVal)
  ctl.cmd_argc = 0
  ctl.cmd_argv_chars = 0
  ctl.cmd_argv = {}
  ctl.largest_successful_arg_count = 0
  ctl.smallest_failed_arg_count = 0
  ctl.argbuf = (@Bytes)(c_malloc((@csize)(ctl.arg_max + 1)))
  ctl.cmd_initial_argv_chars = 0
  ctl.todo = false
end

local function bc_clear_args(ctl: *ExecVal)
  ctl.cmd_argc = ctl.initial_argc
  ctl.cmd_argv_chars = ctl.cmd_initial_argv_chars
  ctl.todo = false
end

local function exceeds(name: cstring, quantity: integer): boolean
  local val = sys.getenv(name)
  if val == nilptr then return false end
  local s = (@Bytes)(val)
  local qq = 0
  while s[qq] == 32 or (s[qq] >= 9 and s[qq] <= 13) do qq = qq + 1 end
  local ok = s[qq] ~= 45
  local limit: culong = 0
  local e: cint = 0
  if ok then
    local endp: cstring
    sys.seterrno(0)
    limit = c_strtoul(val, &endp, 10)
    e = sys.errno()
    if (@usize)(endp) == (@usize)(val) then ok = false
    elseif (@Bytes)(endp)[0] ~= 0 then ok = false; e = 0
    elseif e ~= 0 then ok = false; if e ~= ERANGE then e = 0 end end
  end
  if not ok then
    die_e(e, 'Environment variable ' .. view(name) .. ' is not set to a valid decimal number')
  end
  return (@culong)(quantity) > limit
end

local function bc_args_exceed_testing_limit(argv: CStrs): boolean
  local chars = 0
  local args = 0
  local i = 0
  while argv[i] ~= nilptr do
    args = args + 1
    chars = chars + cstrlen((@Bytes)(argv[i]))
    i = i + 1
  end
  return exceeds('__GNU_FINDUTILS_EXEC_ARG_COUNT_LIMIT', args) or
         exceeds('__GNU_FINDUTILS_EXEC_ARG_LENGTH_LIMIT', chars)
end

local function prep_child_for_exec(close_stdin: boolean, wd: *SavedCwd): boolean
  local ok = true
  if close_stdin then
    if sys.close(0) < 0 then
      error_e(sys.errno(), 'Cannot close standard input')
      ok = false
    else
      -- GNU opens it through gnulib's open_safer, which moves a
      -- descriptor 0..2 to the lowest one above 2: standard input stays closed
      local fd = sys.open('/dev/null', sys.O_RDONLY, 0)
      if fd >= 0 and fd <= 2 then
        local f2 = sys.fcntl(fd, sys.F_DUPFD, 3)
        local e = sys.errno()
        sys.close(fd)
        sys.seterrno(e)
        fd = f2
      end
      if fd < 0 then
        error_e(sys.errno(), q('/dev/null'))
      end
    end
  end
  if restore_cwd(wd) ~= 0 then
    local e = sys.errno()
    local extra = ''
    if wd.desc < 0 and wd.name ~= nilptr then extra = ': ' .. view(wd.name) end
    error_e(e, 'Failed to change directory' .. extra)
    ok = false
  end
  return ok
end

-- launch (): run ARGV and wait for it.
local function launch(execp: *ExecVal, argv: CStrs): boolean
  if (options.debug_options & DebugExec) ~= 0 then
    local sb: stringbuilder
    sb:write('DebugExec: launching process (argc=', execp.cmd_argc - 1, '):')
    -- GNU lists the whole pending command line, not just this batch
    for i = 0, execp.cmd_argc - 2 do
      local off = execp.cmd_argv[i + 1]
      if off >= 0 then sb:write(' ', q(view((@cstring)(&execp.argbuf[off])))) end
    end
    sb:write('\n')
    eputs(sb:view())
    sb:destroy()
  end
  sflush(outs)
  if launch_first_time then
    launch_first_time = false
    local sc: sys.Sigaction
    sc.sa_handler = (@function(cint): void)((@pointer)(sys.SIG_DFL))
    sys.sigaction(sys.SIGCHLD, &sc, nilptr)
  end
  local child = sys.fork()
  if child == -1 then die_e(sys.errno(), 'cannot fork') end
  if child == 0 then
    if not prep_child_for_exec(execp.close_stdin, execp.wd_for_exec) then sys._exit(1) end
    local e: cint
    if bc_args_exceed_testing_limit(argv) then
      e = E2BIG
    elseif (@Bytes)(argv[0])[0] == 0 then
      e = ENOENT
    else
      sys.execvp(argv[0], argv)
      e = sys.errno()
    end
    error_e(e, q(view(argv[0])))
    sys._exit(1)
  end
  while sys.waitpid(child, &execp.last_child_status, 0) == -1 do
    local e = sys.errno()
    if e ~= EINTR then
      error_e(e, 'error waiting for ' .. q(view(argv[0])))
      state.exit_status = 1
      return false
    end
  end
  local st = execp.last_child_status
  if (st & 0x7f) ~= 0 and (st & 0x7f) ~= 0x7f then
    error0(q(view(argv[0])) .. ' terminated by signal ' .. tostring(st & 0x7f))
    if execp.multiple then state.exit_status = 1 end
    return true
  end
  local ex = (st >> 8) & 0xff
  if (options.debug_options & DebugExec) ~= 0 then
    eputs('DebugExec: process (PID=' .. tostring(child) .. ') terminated with exit status: ' .. tostring(ex) .. '\n')
  end
  if ex ~= 0 and execp.multiple then state.exit_status = 1 end
  return true
end

local function bc_push_arg(ctl: *ExecVal, arg: Bytes, len: integer, prefix: Bytes, pfxlen: integer, initial_args: boolean) <forwarddecl> end

local function update_limit(ctl: *ExecVal, success: boolean, limit: integer): integer
  if success then
    if limit > ctl.largest_successful_arg_count then ctl.largest_successful_arg_count = limit end
  else
    if limit < ctl.smallest_failed_arg_count or ctl.smallest_failed_arg_count == 0 then
      ctl.smallest_failed_arg_count = limit
    end
  end
  if ctl.largest_successful_arg_count == 0 or ctl.smallest_failed_arg_count <= ctl.largest_successful_arg_count then
    if success then limit = limit + 1 else limit = limit // 2 end
  else
    local shift = (ctl.smallest_failed_arg_count - ctl.largest_successful_arg_count) // 2
    if success then
      if shift ~= 0 then limit = limit + shift else limit = limit + 1 end
    else
      if shift ~= 0 then limit = limit - shift else limit = limit - 1 end
    end
  end
  if ctl.initial_argc ~= 0 and limit <= ctl.initial_argc + 1 then limit = ctl.initial_argc + 1 end
  if limit == 0 then limit = 1 end
  return limit
end

local function bc_do_exec(ctl: *ExecVal)
  bc_push_arg(ctl, nilptr, 0, nilptr, 0, false)
  local working = (@CStrs)(c_malloc((@csize)((1 + ctl.cmd_argc) * 8)))
  local done = 0
  local limit = ctl.cmd_argc
  repeat
    local dst_pos = 0
    local src_pos = 0
    while src_pos < ctl.initial_argc do
      working[dst_pos] = (@cstring)(&ctl.argbuf[ctl.cmd_argv[src_pos + 1]])
      dst_pos = dst_pos + 1; src_pos = src_pos + 1
    end
    src_pos = src_pos + done
    while src_pos < ctl.cmd_argc and dst_pos < limit do
      local off = ctl.cmd_argv[src_pos + 1]
      working[dst_pos] = off >= 0 and (@cstring)(&ctl.argbuf[off]) or nilptr
      dst_pos = dst_pos + 1; src_pos = src_pos + 1
    end
    working[dst_pos] = nilptr
    if launch(ctl, working) then
      limit = update_limit(ctl, true, limit)
      done = done + (dst_pos - ctl.initial_argc)
    else
      if limit <= ctl.initial_argc + 1 then
        die("can't call exec() due to argument size restrictions")
      else
        limit = update_limit(ctl, false, limit)
      end
    end
  until not ((done + 1) < (ctl.cmd_argc - ctl.initial_argc))
  c_free(working)
  bc_clear_args(ctl)
end

local function bc_argc_limit_reached(initial_args: boolean, ctl: *ExecVal): boolean
  if not initial_args and ctl.args_per_exec ~= 0 and (ctl.cmd_argc - ctl.initial_argc) == ctl.args_per_exec then
    return true
  end
  return ctl.cmd_argc == ctl.max_arg_count
end

function bc_push_arg(ctl: *ExecVal, arg: Bytes, len: integer, prefix: Bytes, pfxlen: integer, initial_args: boolean)
  local terminate = arg == nilptr
  if not terminate then
    if ctl.cmd_argv_chars + len + pfxlen > ctl.arg_max then
      if initial_args or ctl.cmd_argc == ctl.initial_argc then
        die('cannot fit single argument within argument list size limit')
      end
      if ctl.has_replace or (ctl.exit_if_size_exceeded and (ctl.lines_per_exec ~= 0 or ctl.args_per_exec ~= 0)) then
        die('argument list too long')
      end
      bc_do_exec(ctl)
    end
    if bc_argc_limit_reached(initial_args, ctl) then bc_do_exec(ctl) end
  end
  if not initial_args then ctl.todo = true end
  local slot = ctl.cmd_argc + 1
  if terminate then
    if slot <= #ctl.cmd_argv then ctl.cmd_argv[slot] = -1 else ctl.cmd_argv:push(-1) end
    ctl.cmd_argc = ctl.cmd_argc + 1
  else
    local off = ctl.cmd_argv_chars
    if slot <= #ctl.cmd_argv then ctl.cmd_argv[slot] = off else ctl.cmd_argv:push(off) end
    ctl.cmd_argc = ctl.cmd_argc + 1
    if prefix ~= nilptr then
      for i = 0, pfxlen - 1 do ctl.argbuf[ctl.cmd_argv_chars + i] = prefix[i] end
      ctl.cmd_argv_chars = ctl.cmd_argv_chars + pfxlen
    end
    for i = 0, len - 1 do ctl.argbuf[ctl.cmd_argv_chars + i] = arg[i] end
    ctl.cmd_argv_chars = ctl.cmd_argv_chars + len
    if bc_argc_limit_reached(initial_args, ctl) then bc_do_exec(ctl) end
  end
  if initial_args then ctl.cmd_initial_argv_chars = ctl.cmd_argv_chars end
end

-- strstr; -1 when "{}" does not occur at or after FROM.
local function find_braces(s: Bytes, n: integer, from: integer): integer
  local i = from
  while i + 1 < n do
    if s[i] == 123 and s[i + 1] == 125 then return i end
    i = i + 1
  end
  return -1
end

local function bc_do_insert(ctl: *ExecVal, arg: Bytes, arglen: integer, prefix: Bytes, pfxlen: integer,
                            linebuf: Bytes, lblen: integer, initial_args: boolean)
  local bytes_left = ctl.arg_max - 1
  if insertbuf == nilptr then insertbuf = (@Bytes)(c_malloc((@csize)(ctl.arg_max + 1))) end
  local p = 0
  local a = 0
  repeat
    local s = find_braces(arg, arglen, a)
    local len: integer
    if s >= 0 then len = s - a else len = arglen - a end
    if bytes_left <= len then break end
    bytes_left = bytes_left - len
    for i = 0, len - 1 do insertbuf[p + i] = arg[a + i] end
    p = p + len
    a = a + len
    if s >= 0 then
      if bytes_left <= lblen + pfxlen then break end
      bytes_left = bytes_left - (lblen + pfxlen)
      if prefix ~= nilptr then
        for i = 0, pfxlen - 1 do insertbuf[p + i] = prefix[i] end
        p = p + pfxlen
      end
      for i = 0, lblen - 1 do insertbuf[p + i] = linebuf[i] end
      p = p + lblen
      a = a + ctl.rplen
    end
  until not (a < arglen)
  if a < arglen then die('command too long') end
  insertbuf[p] = 0
  p = p + 1
  bc_push_arg(ctl, insertbuf, p, nilptr, 0, initial_args)
end

-- dircallback.c run_in_dir
local function run_in_dir(there: *SavedCwd, ctl: *ExecVal)
  local here: SavedCwd
  if save_cwd(&here) == 0 then
    if restore_cwd(there) == 0 then
      bc_do_exec(ctl)
    else
      die_e(sys.errno(), 'failed to return to initial working directory')
    end
    if restore_cwd(&here) ~= 0 then die_e(sys.errno(), 'failed to return to initial working directory') end
    free_cwd(&here)
  else
    die_e(sys.errno(), 'failed to save working directory')
  end
end

local function do_exec(execp: *ExecVal)
  run_in_dir(execp.wd_for_exec, execp)
  if execp.wd_for_exec ~= initial_wd then
    free_cwd(execp.wd_for_exec)
    default_allocator:delete(execp.wd_for_exec)
    execp.wd_for_exec = nilptr
  end
end

-------------------------------------------------------------------------------
-- allocating predicates (tree.c, util.c)

-- Parser table entries
local ARG_OPTION: integer <comptime> = 0
local ARG_NOOP: integer <comptime> = 1
local ARG_POSITIONAL_OPTION: integer <comptime> = 2
local ARG_TEST: integer <comptime> = 3
local ARG_SPECIAL_PARSE: integer <comptime> = 4
local ARG_PUNCTUATION: integer <comptime> = 5
local ARG_ACTION: integer <comptime> = 6

local ParseFn = @function(integer, CStrs, *integer): boolean
local Entry = @record{type: integer, name: string, parse: ParseFn, pred: integer}
local parse_table: sequence(Entry)   -- index 1 is -newerXY's special entry

local function get_new_pred(entry: integer): integer
  local p = default_allocator:new(@Pred)
  preds:push(p)
  local id = #preds
  if predicates == 0 then
    predicates = id
    last_pred = id
  else
    P(last_pred).next = id
    last_pred = id
  end
  p.entry = entry
  p.ptype = NO_TYPE
  p.prec = NO_PREC
  p.need_stat = true
  p.need_type = true
  p.cost = NeedsUnknown
  p.arg_text = 'ThisShouldBeSetToSomethingElse'
  p.literal_control_chars = options.literal_control_chars
  p.rate = 1.0
  p.same_fd = -1
  return id
end

local function get_new_pred_noarg(entry: integer): integer
  local id = get_new_pred(entry)
  P(id).arg_text = nilptr
  return id
end

local entry_and: integer = 0

local function get_new_pred_chk_op(entry: integer, arg: cstring): integer
  if last_pred ~= 0 then
    local t = P(last_pred).ptype
    if t == NO_TYPE then
      die('oops -- invalid default insertion of and!')
    elseif t == PRIMARY_TYPE or t == CLOSE_PAREN then
      local id = get_new_pred_noarg(entry_and)
      local np = P(id)
      np.func = P_AND
      np.name = '-a'
      np.ptype = BI_OP
      np.prec = AND_PREC
      np.need_stat = false
      np.need_type = false
      np.need_inum = false
      np.arg_text = nilptr
      np.str = nilptr
      np.side_effects = false
      np.no_default_print = false
    end
  end
  local id = get_new_pred(entry)
  P(id).arg_text = arg
  P(id).entry = entry
  return id
end

local function insert_primary_withpred(entry: integer, func: integer, arg: cstring): *Pred
  local id = get_new_pred_chk_op(entry, arg)
  local np = P(id)
  np.func = func
  np.name = parse_table[entry].name
  np.str = nilptr
  np.ptype = PRIMARY_TYPE
  np.prec = NO_PREC
  return np
end

local function insert_primary(entry: integer, arg: cstring): *Pred
  return insert_primary_withpred(entry, parse_table[entry].pred, arg)
end

local function insert_primary_noarg(entry: integer): *Pred
  return insert_primary(entry, nilptr)
end

-------------------------------------------------------------------------------
-- print.c: -printf format parsing

local function make_segment(segs: *sequence(Segment), format: Bytes, len: integer, kind: integer,
                            format_char: byte, aux_format_char: byte, pred: *Pred)
  local mycost = NeedsNothing
  local seg: Segment
  seg.kind = kind
  seg.fc0 = format_char
  seg.fc1 = aux_format_char
  seg.text_len = len
  seg.text = (@Bytes)(c_malloc((@csize)(len + 3)))
  -- strncpy: stop at a NUL, pad with NULs
  local stopped = false
  for i = 0, len - 1 do
    if stopped or format[i] == 0 then stopped = true; seg.text[i] = 0 else seg.text[i] = format[i] end
  end
  local fp = len
  if kind == KIND_PLAIN or kind == KIND_STOP then
    seg.text[fp] = 0
    segs:push(seg)
    return
  end
  local c = format_char
  if c == 37 then seg.text[fp] = 37; fp = fp + 1
  elseif c == 108 then pred.need_stat = true; mycost = NeedsLinkName; seg.text[fp] = 115; fp = fp + 1
  elseif c == 121 then pred.need_type = true; mycost = NeedsType; seg.text[fp] = 115; fp = fp + 1
  elseif c == 105 then pred.need_inum = true; mycost = NeedsInodeNumber; seg.text[fp] = 115; fp = fp + 1
  elseif c == 97 or c == 65 or c == 66 or c == 99 or c == 67 or c == 70 or c == 103 or c == 77 or c == 115
      or c == 116 or c == 84 or c == 117 then
    pred.need_stat = true; mycost = NeedsStatInfo; seg.text[fp] = 115; fp = fp + 1
  elseif c == 83 then pred.need_stat = true; mycost = NeedsStatInfo; seg.text[fp] = 103; fp = fp + 1
  elseif c == 89 then pred.need_stat = true; mycost = NeedsType; seg.text[fp] = 115; fp = fp + 1
  elseif c == 102 or c == 104 or c == 112 or c == 80 then seg.text[fp] = 115; fp = fp + 1
  elseif c == 90 then mycost = NeedsAccessInfo; seg.text[fp] = 115; fp = fp + 1
  elseif c == 72 then seg.text[fp] = 115; fp = fp + 1
  elseif c == 71 or c == 85 or c == 98 or c == 68 or c == 107 or c == 110 then
    pred.need_stat = true; mycost = NeedsStatInfo; seg.text[fp] = 115; fp = fp + 1
  elseif c == 100 then seg.text[fp] = 100; fp = fp + 1
  elseif c == 109 then seg.text[fp] = 111; fp = fp + 1; pred.need_stat = true; mycost = NeedsStatInfo
  end
  seg.text[fp] = 0
  if mycost > pred.cost then pred.cost = mycost end
  segs:push(seg)
end

local function is_octal_char(ch: byte): boolean return ch >= 48 and ch <= 55 end

local function parse_escape_char(ch: byte): byte
  if ch == 97 then return 7 elseif ch == 98 then return 8 elseif ch == 102 then return 12
  elseif ch == 110 then return 10 elseif ch == 114 then return 13 elseif ch == 116 then return 9
  elseif ch == 118 then return 11 elseif ch == 92 then return 92 end
  return 0
end

local function strchr_set(set: string, c: byte): boolean
  if c == 0 then return true end
  for i = 0, < #set do if set.data[i] == c then return true end end
  return false
end

local function get_format_flags_length(p: Bytes): integer
  local n = 0
  while true do
    n = n + 1
    if p[n] == 0 or not strchr_set('-+ #', p[n]) then break end
  end
  while p[n] >= 48 and p[n] <= 57 do n = n + 1 end
  if p[n] == 46 then
    n = n + 1
    while p[n] >= 48 and p[n] <= 57 do n = n + 1 end
  end
  return n
end

local function get_format_specifer_length(ch: byte): integer
  -- strchr finds the terminating NUL too
  if strchr_set('abcdDfFgGhHiklmMnpPsStuUyYZ%', ch) then return 1
  elseif strchr_set('ABCT', ch) then return 2 end
  return 0
end

local function insert_fprintf(vec: *FormatVal, entry: integer, format: cstring): boolean
  local fmt = (@Bytes)(format)
  local segstart = 0
  local our_pred = insert_primary_withpred(entry, P_FPRINTF, format)
  our_pred.side_effects = true
  our_pred.no_default_print = true
  our_pred.fmt = $vec
  our_pred.need_type = false
  our_pred.need_stat = false
  our_pred.cost = NeedsNothing
  local segs = &our_pred.fmt.segments
  local e = 0
  while fmt[e] ~= 0 do
    if fmt[e] == 92 and fmt[e + 1] == 99 then
      make_segment(segs, &fmt[segstart], e - segstart, KIND_STOP, 0, 0, our_pred)
      if our_pred.need_stat and our_pred.cost < NeedsStatInfo then our_pred.cost = NeedsStatInfo end
      return true
    elseif fmt[e] == 92 then
      local readpos = 1
      if fmt[e + readpos] == 0 then
        error0("warning: escape `\\' followed by nothing at all")
        readpos = readpos - 1
      elseif is_octal_char(fmt[e + readpos]) then
        local n = 0
        local pos = 0
        local i = 0
        while i < 3 and is_octal_char(fmt[e + readpos + pos]) do
          n = 8 * n + (fmt[e + readpos + pos] - 48)
          i = i + 1; pos = pos + 1
        end
        pos = pos - 1
        fmt[e] = (@byte)(n & 0xff)
        readpos = readpos + pos
      else
        local val = parse_escape_char(fmt[e + readpos])
        if val ~= 0 then
          fmt[e] = val
        else
          local cc = fmt[e + readpos]
          local sb: stringbuilder
          sb:write("warning: unrecognized escape `\\")
          sb:writebyte(cc)
          sb:write("'")
          error0(sb:view())
          sb:destroy()
          e = e + readpos
          e = e + 1
          goto next_iter
        end
      end
      make_segment(segs, &fmt[segstart], e - segstart + 1, KIND_PLAIN, 0, 0, our_pred)
      segstart = e + readpos + 1
      e = e + readpos
    elseif fmt[e] == 37 then
      local len: integer
      if fmt[e + 1] == 0 then
        die('error: ' .. view((@cstring)(&fmt[e])) .. ' at end of format string')
      end
      if fmt[e + 1] == 37 then len = 1 else len = get_format_flags_length(&fmt[e]) end
      e = e + len
      len = get_format_specifer_length(fmt[e])
      if len ~= 0 and fmt[e + len - 1] ~= 0 then
        local fmt2: byte = len == 2 and fmt[e + 1] or 0
        make_segment(segs, &fmt[segstart], e - segstart, KIND_FORMAT, fmt[e], fmt2, our_pred)
        e = e + (len - 1)
      else
        local cc = fmt[e]
        if strchr_set('{[(', cc) then
          local sb: stringbuilder
          sb:write("error: the format directive `%")
          sb:writebyte(cc)
          sb:write("' is reserved for future use")
          die(sb:view())
        end
        local sb: stringbuilder
        if len == 2 and fmt[e + 1] == 0 then
          sb:write("warning: format directive `%")
          sb:writebyte(cc)
          sb:write("' should be followed by another character")
        else
          sb:write("warning: unrecognized format directive `%")
          sb:writebyte(cc)
          sb:write("'")
        end
        error0(sb:view())
        sb:destroy()
        make_segment(segs, &fmt[segstart], e + 1 - segstart, KIND_PLAIN, 0, 0, our_pred)
      end
      segstart = e + 1
    end
    e = e + 1
    ::next_iter::
  end
  if e > segstart then
    make_segment(segs, &fmt[segstart], e - segstart, KIND_PLAIN, 0, 0, our_pred)
  end
  return true
end

-------------------------------------------------------------------------------
-- parser.c helpers

-- C's truncating integer division
local function tdiv(a: integer, b: integer): integer
  local r = a // b
  if r < 0 and r * b ~= a then r = r + 1 end
  return r
end

local function collect_arg(argv: CStrs, arg_ptr: *integer): (boolean, cstring)
  if argv == nilptr or argv[$arg_ptr] == nilptr then return false, nilptr end
  local a = argv[$arg_ptr]
  $arg_ptr = $arg_ptr + 1
  return true, a
end

local function collect_arg_stat_info(argv: CStrs, arg_ptr: *integer, p: *sys.Stat): (boolean, cstring)
  local ok, filename = collect_arg(argv, arg_ptr)
  if ok then
    if xstat(filename, p) ~= 0 then fatal_target_file_error(sys.errno(), view(filename)) end
    return true, filename
  end
  return false, nilptr
end

local function estimate_file_age_success_rate(num_days: float32): float32
  if num_days < 0.1_f32 then return 0.01_f32
  elseif num_days < 1.0_f32 then return 0.3_f32
  elseif num_days > 100.0_f32 then return 0.3_f32 end
  return 0.39_f32
end

local function estimate_timestamp_success_rate(when: integer): float32
  local num_days: cint = (@cint)(tdiv(options.day_sec - when, 86400))
  return estimate_file_age_success_rate((@float32)(num_days))
end

local function has_any(s: cstring, set: string): boolean
  local p = (@Bytes)(s)
  local i = 0
  while p[i] ~= 0 do
    for k = 0, < #set do if p[i] == set.data[k] then return true end end
    i = i + 1
  end
  return false
end

local function estimate_pattern_match_rate(pattern: cstring, is_regex: boolean): float32
  if has_any(pattern, '*?[') or (is_regex and has_any(pattern, '.')) then return 0.8_f32 end
  return 0.1_f32
end

-- get_comp_type: the kind and the offset past the prefix
local function get_comp_type(s: cstring): (integer, integer)
  local c = (@Bytes)(s)[0]
  if c == 43 then return COMP_GT, 1
  elseif c == 45 then return COMP_LT, 1 end
  return COMP_EQ, 0
end

-- xstrtoumax (s, &end, 10, &n, "") == LONGINT_OK
local function xstrtoumax_ok(s: cstring): (boolean, uint64)
  local p = (@Bytes)(s)
  local i = 0
  while p[i] == 32 or (p[i] >= 9 and p[i] <= 13) do i = i + 1 end
  if p[i] == 45 then return false, 0 end
  local endp: cstring
  sys.seterrno(0)
  local v = c_strtoumax(s, &endp, 10)
  if (@usize)(endp) == (@usize)(s) then return false, 0 end
  if sys.errno() ~= 0 then return false, 0 end
  if (@Bytes)(endp)[0] ~= 0 then return false, 0 end
  return true, v
end

local function get_num(s: cstring): (boolean, uint64, integer)
  if s == nilptr then return false, 0, COMP_EQ end
  local kind, off = get_comp_type(s)
  local ok, v = xstrtoumax_ok((@cstring)(&(@Bytes)(s)[off]))
  return ok, v, kind
end

-- xstrtod (str, NULL, &d, strtod)
local function xstrtod(s: cstring): (boolean, float64)
  local endp: cstring
  sys.seterrno(0)
  local v = sys.strtod(s, &endp)
  if (@usize)(endp) == (@usize)(s) or (@Bytes)(endp)[0] ~= 0 then return false, v end
  if v ~= 0 and sys.errno() == ERANGE then return false, v end
  return true, v
end

local TimeVal = @record{xval: integer, kind: integer, sec: integer, nsec: integer}

local function get_relative_timestamp(str: cstring, result: *TimeVal, origin_sec: integer, origin_nsec: integer,
                                      sec_per_unit: float64, overflowmessage: string): boolean
  local kind, off = get_comp_type(str)
  if kind == COMP_LT then kind = COMP_GT elseif kind == COMP_GT then kind = COMP_LT end
  result.kind = kind
  local rest = (@cstring)(&(@Bytes)(str)[off])
  local ok, offset = xstrtod(rest)
  if not ok then return false end
  local seconds: float64 = 0
  local nanosec = c_modf(offset * sec_per_unit, &seconds)
  nanosec = nanosec * 1.0e9
  if not (nanosec < 1000000000.0) then
    eputs(util.applet .. ": parser.c:3149: get_relative_timestamp: Assertion `nanosec < nanosec_per_sec' failed.\n")
    local sa: sys.Sigaction
    sa.sa_handler = (@function(cint): void)((@pointer)(sys.SIG_DFL))
    sys.sigaction(6, &sa, nilptr)
    sys.kill(sys.getpid(), 6)
    sys._exit(134)
  end
  result.sec = (@integer)((@float64)(origin_sec) - seconds)
  if (origin_sec < result.sec) ~= (seconds < 0) then
    local sb: stringbuilder
    local mp = overflowmessage:find('%s', 1, true)
    sb:write(overflowmessage:sub(1, mp - 1), view(rest), overflowmessage:sub(mp + 2))
    die(sb:view())
  end
  result.nsec = (@integer)((@float64)(origin_nsec) - nanosec)
  if (@float64)(origin_nsec) < nanosec then
    result.nsec = result.nsec + 1000000000
    result.sec = result.sec - 1
  end
  return true
end

local function ctime_str(t: integer): string
  local f, ok = util.breaktime(t, 0, false)
  if not ok then return '?\n' end
  return util.timestr('%a %b %e %H:%M:%S %Y', &f) .. '\n'
end

local function safe_atoi(s: cstring): integer
  local endp: cstring
  sys.seterrno(0)
  local lval = c_strtol(s, &endp, 10)
  local e = sys.errno()
  if lval == 0x7fffffffffffffff or lval == -0x7fffffffffffffff - 1 then
    die_e(e, view(s))
  end
  if lval > 0x7fffffff or lval < -0x80000000 then
    die_e(ERANGE, view(s))
  elseif (@Bytes)(endp)[0] ~= 0 then
    die_e(e, 'Unexpected suffix ' .. q(view(endp)) .. ' on ' .. q(view(s)))
  elseif (@usize)(endp) == (@usize)(s) then
    die_e(e, 'Expected an integer: ' .. q(view(s)))
  end
  return lval
end

local entry_noop: integer = 0
local entry_false: integer = 0

local function parse_true(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_primary_noarg(entry)
  p.need_stat = false
  p.need_type = false
  p.rate = 1.0_f32
  return true
end

local function parse_noop(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return parse_true(entry_noop, argv, arg_ptr)
end

local function insert_false(): boolean
  local p = insert_primary_noarg(entry_false)
  p.need_stat = false
  p.need_type = false
  p.side_effects = false
  p.no_default_print = false
  p.rate = 0.0_f32
  return true
end

local function parse_and(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local id = get_new_pred_noarg(entry)
  local p = P(id)
  p.func = P_AND
  p.ptype = BI_OP
  p.prec = AND_PREC
  p.need_stat = false
  p.need_type = false
  return true
end

local function parse_or(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local id = get_new_pred_noarg(entry)
  local p = P(id)
  p.func = P_OR
  p.ptype = BI_OP
  p.prec = OR_PREC
  p.need_stat = false
  p.need_type = false
  return true
end

local function parse_comma(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local id = get_new_pred_noarg(entry)
  local p = P(id)
  p.func = P_COMMA
  p.ptype = BI_OP
  p.prec = COMMA_PREC
  p.need_stat = false
  p.need_type = false
  p.rate = 1.0_f32
  return true
end

local function parse_negate(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local id = get_new_pred_chk_op(entry, nilptr)
  local p = P(id)
  p.func = P_NEGATE
  p.ptype = UNI_OP
  p.prec = NEGATE_PREC
  p.need_stat = false
  p.need_type = false
  return true
end

local function parse_openparen(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local id = get_new_pred_chk_op(entry, nilptr)
  local p = P(id)
  p.func = P_OPENPAREN
  p.ptype = OPEN_PAREN
  p.prec = NO_PREC
  p.need_stat = false
  p.need_type = false
  return true
end

local function parse_closeparen(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local id = get_new_pred_noarg(entry)
  local p = P(id)
  p.func = P_CLOSEPAREN
  p.ptype = CLOSE_PAREN
  p.prec = NO_PREC
  p.need_stat = false
  p.need_type = false
  return true
end

local function parse_anewer(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local st: sys.Stat
  local ok, arg = collect_arg_stat_info(argv, arg_ptr, &st)
  if ok then
    local p = insert_primary(entry, arg)
    p.rt_xval = XVAL_ATIME
    p.rt_sec = st.st_mtim.tv_sec
    p.rt_nsec = st.st_mtim.tv_nsec
    p.rt_kind = COMP_GT
    p.rate = estimate_timestamp_success_rate(st.st_mtim.tv_sec)
    return true
  end
  return false
end

local function parse_cnewer(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local st: sys.Stat
  local ok, arg = collect_arg_stat_info(argv, arg_ptr, &st)
  if ok then
    local p = insert_primary(entry, arg)
    p.rt_xval = XVAL_CTIME
    p.rt_sec = st.st_mtim.tv_sec
    p.rt_nsec = st.st_mtim.tv_nsec
    p.rt_kind = COMP_GT
    p.rate = estimate_timestamp_success_rate(st.st_mtim.tv_sec)
    return true
  end
  return false
end

local function parse_newer(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local st: sys.Stat
  local ok, arg = collect_arg_stat_info(argv, arg_ptr, &st)
  if ok then
    local p = insert_primary(entry, arg)
    p.rt_sec = st.st_mtim.tv_sec
    p.rt_nsec = st.st_mtim.tv_nsec
    p.rt_xval = XVAL_MTIME
    p.rt_kind = COMP_GT
    p.rate = estimate_timestamp_success_rate(st.st_mtim.tv_sec)
    return true
  end
  return false
end

local function parse_daystart(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  if not options.full_days then
    options.day_sec = options.day_sec + DAYSECS
    options.day_nsec = 0
    local f, ok = util.breaktime(options.day_sec, 0, false)
    if ok then
      options.day_sec = options.day_sec - (f.tm.tm_sec + f.tm.tm_min * 60 + f.tm.tm_hour * 3600)
    else
      options.day_sec = options.day_sec - options.day_sec % DAYSECS
    end
    options.full_days = true
  end
  return true
end

local function parse_delete(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_primary_noarg(entry)
  p.side_effects = true
  p.no_default_print = true
  options.do_dir_first = false
  p.need_stat = false
  p.need_type = false
  p.rate = 1.0_f32
  return true
end

local function parse_depth(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  options.do_dir_first = false
  options.explicit_depth = true
  return parse_noop(entry, argv, arg_ptr)
end

local function parse_d(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  if should_issue_warnings() then
    error0('warning: the -d option is deprecated; please use -depth instead, because the latter is a POSIX-compliant feature.')
  end
  return parse_depth(entry, argv, arg_ptr)
end

local function parse_empty(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_primary_noarg(entry)
  p.rate = 0.01_f32
  return true
end

local function check_path_safety(action: string)
  local path = sys.getenv('PATH')
  if path == nilptr then return end
  local s = (@Bytes)(path)
  local pos = 0
  local len = 0
  local first = true
  while true do
    if not first then
      pos = pos + len
      if s[pos] ~= 0 then pos = pos + 1 else break end
    end
    first = false
    len = 0
    while s[pos + len] ~= 0 and s[pos + len] ~= 58 do len = len + 1 end
    if len == 0 or (len == 1 and s[pos] == 46) then
      die('The current directory is included in the PATH environment variable, which is insecure in combination with the ' ..
          action .. ' action of find.  Please remove the current directory from your $PATH (that is, remove ".", doubled colons, or leading or trailing colons)')
    elseif s[pos] ~= 47 then
      local rel = (@string){data = &s[pos], size = (@usize)(len)}
      die('The relative path ' .. q(rel) .. ' is included in the PATH environment variable, which is insecure in combination with the ' ..
          action .. ' action of find.  Please remove that entry from $PATH')
    end
  end
end

local function has_braces(s: cstring): boolean
  local p = (@Bytes)(s)
  local i = 0
  while p[i] ~= 0 do
    if p[i] == 123 and p[i + 1] == 125 then return true end
    i = i + 1
  end
  return false
end

local function insert_exec_ok(action: string, entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local func = parse_table[entry].pred
  if argv == nilptr or argv[$arg_ptr] == nilptr then return false end
  local our_pred = insert_primary_withpred(entry, func, '(some -exec* arguments)')
  our_pred.side_effects = true
  our_pred.no_default_print = true
  our_pred.need_type = false
  our_pred.need_stat = false
  local execp = &our_pred.exec
  execp.wd_for_exec = nilptr
  local allow_plus: boolean
  if func ~= P_OKDIR and func ~= P_OK then
    allow_plus = true
    execp.close_stdin = false
  else
    allow_plus = false
    options.ok_prompt_stdin = true
    execp.close_stdin = true
  end
  if func == P_EXECDIR or func == P_OKDIR then
    execp.wd_for_exec = nilptr
    options.ignore_readdir_race = false
    check_path_safety(action)
  else
    execp.wd_for_exec = initial_wd
  end
  execp.multiple = false
  local start = $arg_ptr
  local e = start
  local saw_braces = false
  local brace_count = 0
  local brace_arg: cstring = nilptr
  while argv[e] ~= nilptr and not ((@Bytes)(argv[e])[0] == 59 and (@Bytes)(argv[e])[1] == 0) do
    if allow_plus and (@Bytes)(argv[e])[0] == 43 and (@Bytes)(argv[e])[1] == 0 and saw_braces then
      execp.multiple = true
      break
    end
    saw_braces = false
    if has_braces(argv[e]) then
      saw_braces = true
      brace_arg = argv[e]
      brace_count = brace_count + 1
      -- GNU compares the argv index with 0 here, which never holds
    end
    e = e + 1
  end
  if e == start or argv[e] == nilptr then
    $arg_ptr = e
    return false
  end
  if execp.multiple then
    local suffix = func == P_EXECDIR and 'dir' or ''
    if brace_count > 1 then
      die('Only one instance of {} is supported with -exec' .. suffix .. ' ... +')
    elseif cstrlen((@Bytes)(brace_arg)) ~= 2 then
      die('In ' .. q('-exec' .. suffix .. ' ... {} +') .. ' the ' .. q('{}') ..
          ' must appear by itself, but you specified ' .. q(view(brace_arg)))
    end
  end
  local st = bc_init_controlinfo(execp, 2048)
  if st ~= 0 then die('The environment is too large for exec().') end
  bc_use_sensible_arg_max(execp)
  if execp.multiple then
    execp.has_replace = false
    execp.rplen = 0
    execp.lines_per_exec = 0
    execp.args_per_exec = 0
    execp.initial_argc = (e - start) - 1
    bc_init_state(execp)
    for i = start, e - 2 do
      bc_push_arg(execp, (@Bytes)(argv[i]), cstrlen((@Bytes)(argv[i])) + 1, nilptr, 0, true)
    end
  else
    execp.num_args = e - start
    execp.has_replace = true
    execp.rplen = 2
    execp.lines_per_exec = 0
    execp.args_per_exec = 0
    bc_init_state(execp)
    for i = 0, execp.num_args - 1 do execp.replace_vec:push(argv[i + start]) end
  end
  if argv[e] == nilptr then $arg_ptr = e else $arg_ptr = e + 1 end
  return true
end

local function parse_exec(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_exec_ok('-exec', entry, argv, arg_ptr)
end
local function parse_execdir(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_exec_ok('-execdir', entry, argv, arg_ptr)
end
local function parse_ok(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  return insert_exec_ok('-ok', entry, argv, arg_ptr)
end
local function parse_okdir(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
