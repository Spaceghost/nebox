local function estimate_fstype_success_rate(fsname: cstring): float32
  local st: sys.Stat
  if sys.stat('/', &st) == 0 then
    local t = filesystem_type(&st)
    if view(fsname) == t then return 0.7_f32 end
    return 0.3_f32
  end
  return 1.0_f32
end

local function parse_fstype(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local ok, typename = collect_arg(argv, arg_ptr)
  if ok then
    if options.optimisation_level < 2 or is_used_fs_type(view(typename)) then
      local p = insert_primary(entry, typename)
      p.str = typename
      p.rate = estimate_fstype_success_rate(typename)
      return true
    end
    if (options.debug_options & DebugTreeOpt) ~= 0 then
      eputs('-fstype ' .. view(typename) .. ' can never succeed, substituting -false\n')
    end
    return insert_false()
  end
  return false
end

local function insert_num(argv: CStrs, arg_ptr: *integer, entry: integer): *Pred
  local ok, numstr = collect_arg(argv, arg_ptr)
  if ok then
    local nok, num, c_type = get_num(numstr)
    if nok then
      local p = insert_primary(entry, numstr)
      p.num_kind = c_type
      p.num_val = num
      if (options.debug_options & DebugExpressionTree) ~= 0 then
        local sb: stringbuilder
        sb:write('inserting ', p.name, '\n')
        sb:write('    type: ', c_type == COMP_GT and 'gt' or (c_type == COMP_LT and 'lt' or 'eq'), '    ',
                 c_type == COMP_GT and ' >' or (c_type == COMP_LT and ' <' or ' ='), '  ')
        sb:write(num, '\n')
        eputs(sb:view())
        sb:destroy()
      end
      return p
    end
  end
  return nilptr
end

local function parse_gid(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
  local p = insert_num(argv, arg_ptr, entry)
  if p ~= nilptr then
    p.rate = p.num_val < 100 and 0.99_f32 or 0.2_f32
    return true
  end
  $arg_ptr = $arg_ptr - 1
  return false
end

local function parse_uid(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
