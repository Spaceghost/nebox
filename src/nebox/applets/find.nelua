-- options and state (defs.h)

local SYMLINK_NEVER_DEREF: integer <comptime> = 0
local SYMLINK_ALWAYS_DEREF: integer <comptime> = 1
local SYMLINK_DEREF_ARGSONLY: integer <comptime> = 2

local DebugExpressionTree: integer <comptime> = 1
local DebugStat: integer <comptime> = 2
local DebugSearch: integer <comptime> = 4
local DebugTreeOpt: integer <comptime> = 8
local DebugHelp: integer <comptime> = 16
local DebugExec: integer <comptime> = 32
local DebugSuccessRates: integer <comptime> = 64
local DebugTime: integer <comptime> = 128
local DebugAll: integer <comptime> = 0xffffffff & ~16

local XSTAT_P: integer <comptime> = 0
local XSTAT_L: integer <comptime> = 1
local XSTAT_H: integer <comptime> = 2
local XSTAT_DEBUG: integer <comptime> = 3

local Options = @record{
  do_dir_first: boolean,
  explicit_depth: boolean,
  maxdepth: integer,
  mindepth: integer,
  no_leaf_check: boolean,
  stay_on_filesystem: boolean,
  ignore_readdir_race: boolean,
  literal_control_chars: boolean,
  warnings: boolean,
  posixly_correct: boolean,
  start_sec: integer, start_nsec: integer,
  day_sec: integer, day_nsec: integer,
  full_days: boolean,
  output_block_size: integer,
  debug_options: integer,
  symlink_handling: integer,
  xstat: integer,
  open_nofollow_available: boolean,
  regex_options: uint64,
  optimisation_level: integer,
  files0_from: cstring,
  ok_prompt_stdin: boolean,
}

local State = @record{
  curdepth: integer,
  have_stat: boolean,
  have_type: boolean,
  type: cuint,
  rel_pathname: cstring,
  cwd_dir_fd: cint,
  starting_path_length: integer,
  stop_at_current_level: boolean,
  exit_status: integer,
  execdirs_outstanding: boolean,
  already_issued_stat_error_msg: boolean,
}

local options: Options
local state: State

local function should_issue_warnings(): boolean
  if options.posixly_correct then return false end
  return options.warnings
end

-------------------------------------------------------------------------------
-- util.c: the stat functions

local function fallback_stat(name: cstring, p: *sys.Stat, prev_rv: cint): cint
  local e = sys.errno()
  if e == ENOENT or e == ENOTDIR then
    if (options.debug_options & DebugStat) ~= 0 then
      eputs('fallback_stat(): stat(' .. view(name) .. ') failed; falling back on lstat()\n')
    end
    return c_fstatat(state.cwd_dir_fd, name, p, AT_SYMLINK_NOFOLLOW)
  end
  return prev_rv
end

local function optionh_stat(name: cstring, p: *sys.Stat): cint
  if state.curdepth == 0 then
    local rv = c_fstatat(state.cwd_dir_fd, name, p, 0)
    if rv == 0 then return 0 end
    return fallback_stat(name, p, rv)
  end
  return c_fstatat(state.cwd_dir_fd, name, p, AT_SYMLINK_NOFOLLOW)
end

local function optionl_stat(name: cstring, p: *sys.Stat): cint
  local rv = c_fstatat(state.cwd_dir_fd, name, p, 0)
  if rv == 0 then return 0 end
  return fallback_stat(name, p, rv)
end

local function optionp_stat(name: cstring, p: *sys.Stat): cint
  return c_fstatat(state.cwd_dir_fd, name, p, AT_SYMLINK_NOFOLLOW)
end

local function debug_stat(file: cstring, p: *sys.Stat): cint
  eputs('debug_stat (' .. view(file) .. ')\n')
  if options.symlink_handling == SYMLINK_ALWAYS_DEREF then return optionl_stat(file, p)
  elseif options.symlink_handling == SYMLINK_DEREF_ARGSONLY then return optionh_stat(file, p) end
  return optionp_stat(file, p)
end

local function xstat(name: cstring, p: *sys.Stat): cint
  local k = options.xstat
  if k == XSTAT_L then return optionl_stat(name, p)
  elseif k == XSTAT_H then return optionh_stat(name, p)
  elseif k == XSTAT_DEBUG then return debug_stat(name, p) end
  return optionp_stat(name, p)
end

local function following_links(): boolean
  if options.symlink_handling == SYMLINK_ALWAYS_DEREF then return true
  elseif options.symlink_handling == SYMLINK_DEREF_ARGSONLY then return state.curdepth == 0 end
  return false
end

local function set_follow_state(opt: integer)
  if opt == SYMLINK_ALWAYS_DEREF then
    options.xstat = XSTAT_L
    options.no_leaf_check = true
  elseif opt == SYMLINK_NEVER_DEREF then
    options.xstat = XSTAT_P
  else
    options.xstat = XSTAT_H
    options.no_leaf_check = true
  end
  options.symlink_handling = opt
  if (options.debug_options & DebugStat) ~= 0 then options.xstat = XSTAT_DEBUG end
end

