local function insert_depthspec(entry: integer, argv: CStrs, arg_ptr: *integer, limitptr: *integer): boolean
  local predicate = argv[$arg_ptr - 1]
  local ok, depthstr = collect_arg(argv, arg_ptr)
  if ok then
    local depth_len = digits_len(depthstr)
    if depth_len > 0 and (@Bytes)(depthstr)[depth_len] == 0 then
      $limitptr = safe_atoi(depthstr)
      if $limitptr >= 0 then return parse_noop(entry, argv, arg_ptr) end
    end
    die('Expected a positive decimal integer argument to ' .. view(predicate) .. ', but got ' .. q(view(depthstr)))
    return false
  end
  return false
end

local function parse_maxdepth(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
