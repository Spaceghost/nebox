  if filename ~= nilptr then open_output_file(filename, &p.fmt) else open_stdout(&p.fmt) end
  p.side_effects = true
  p.no_default_print = true
  p.rate = 1.0_f32
  return true
end

local function parse_fls(entry: integer, argv: CStrs, arg_ptr: *integer): boolean
