-- More text applets: cmp comm tac fold paste expand unexpand cksum md5sum
-- sha1sum sha256sum base64 strings split
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'

-- cmp: -s silent, -l list every differing byte
global function applet_cmp(args: sequence(string)): integer
  local o = util.parse(args, 'sl')
  if not o:ok() then return util.optfail(o) end
  if #o.operands < 1 then return util.die('missing operand') end
  local a = o.operands[1]
  local b: string = '-'
  if #o.operands >= 2 then b = o.operands[2] end
  local da, oka = util.readfile(a)
  if not oka then return 2 end
  local db, okb = util.readfile(b)
  if not okb then return 2 end
  local n = da.size < db.size and da.size or db.size
  local line: integer = 1
  local rc: integer = 0
  local width: integer = 1
  local m = da.size > db.size and da.size or db.size
  while m >= 10 do m = m // 10; width = width + 1 end
  for i: usize = 0, < n do
    if da.data[i] ~= db.data[i] then
      if o:has('l') then
        rc = 1
        util.padnum((@integer)(i) + 1, width)
        util.writef(' %3o %3o\n', da.data[i], db.data[i])
      else
        if not o:has('s') then
          util.writef('%s %s differ: char %d, line %d\n', a, b, i + 1, line)
        end
        return 1
      end
    end
    if da.data[i] == 10 then line = line + 1 end
  end
  if da.size ~= db.size then
    if not o:has('s') then
      util.err('cmp: EOF on ' .. (da.size < db.size and a or b) .. ' after byte ' .. string.format('%d', n))
    end
    return 1
  end
  return rc
end

-- comm: three-column compare of sorted files; -1 -2 -3 suppress columns
global function applet_comm(args: sequence(string)): integer
  local o = util.parse(args, '123')
  if not o:ok() then return util.optfail(o) end
  if #o.operands < 2 then return util.die('missing operand') end
  local da, oka = util.readfile(o.operands[1])
  if not oka then return 1 end
  local db, okb = util.readfile(o.operands[2])
  if not okb then return 1 end
  local la, lb = util.lines(da), util.lines(db)
  local s1, s2, s3 = not o:has('1'), not o:has('2'), not o:has('3')
  local pad2: string = s1 and '\t' or ''
  local pad3: string = pad2 .. (s2 and '\t' or '')
  local i, j = 1, 1
  while i <= #la or j <= #lb do
    if i > #la then
      if s2 then util.write(pad2); util.line(lb[j]) end
      j = j + 1
    elseif j > #lb then
      if s1 then util.line(la[i]) end
      i = i + 1
    elseif la[i] == lb[j] then
      if s3 then util.write(pad3); util.line(la[i]) end
      i = i + 1; j = j + 1
    elseif la[i] < lb[j] then
      if s1 then util.line(la[i]) end
      i = i + 1
    else
      if s2 then util.write(pad2); util.line(lb[j]) end
      j = j + 1
    end
  end
  return 0
end

global function applet_tac(args: sequence(string)): integer
  if #args == 0 then args:push('-') end
  local rc: integer = 0
  for _, path in ipairs(args) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    -- records end with \n; a final partial record is printed first, as is.
    local stop: usize = data.size
    while stop > 0 do
      local start: usize = stop
      if data.data[stop - 1] == 10 then start = stop - 1 end
      while start > 0 and data.data[start - 1] ~= 10 do start = start - 1 end
      util.writebytes((@*[0]byte)(&data.data[start]), stop - start)
      stop = start
    end
  end
  return rc
end

-- fold: -w WIDTH (default 80), -s break at spaces, -b count bytes (always)
global function applet_fold(args: sequence(string)): integer
  local o = util.parse(args, 'bsw:')
  if not o:ok() then return util.optfail(o) end
  local width: integer = 80
  if o:has('w') then
    local v, ok = util.toint(o:get('w'))
    if not ok or v <= 0 then return util.die("invalid number of columns: '" .. o:get('w') .. "'") end
    width = v
  end
  if #o.operands == 0 then o.operands:push('-') end
  local rc: integer = 0
  for _, path in ipairs(o.operands) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    local col: integer = 0
    local line: sequence(byte)
    for i: usize = 0, < data.size do
      local c = data.data[i]
      if c == 10 then
        line:push(10)
        util.writebytes(&line[1], #line); line:clear(); col = 0
        continue
      end
      local w: integer = 1
      if c == 8 then w = -1 elseif c == 13 then w = -col elseif c == 9 then w = 8 - col % 8 end
      if col + w > width and w > 0 then
        local cut: integer = #line
        if o:has('s') then
          local k = #line
          while k >= 1 and line[k] ~= 32 do k = k - 1 end
          if k >= 1 then cut = k end
        end
        if cut > 0 then util.writebytes(&line[1], (@usize)(cut)) end
        util.writebyte(10)
        local n = #line
        for k = 1, n - cut do line[k] = line[k + cut] end
        line:resize((@usize)(n - cut))
        col = 0
        for k = 1, #line do
          local b = line[k]
          if b == 9 then col = col + (8 - col % 8) elseif b == 8 then col = col - 1 else col = col + 1 end
        end
      end
      line:push(c)
      col = col + w
      if col < 0 then col = 0 end
    end
    if #line > 0 then util.writebytes(&line[1], #line) end
  end
  return rc
end

-- paste: -d LIST delimiters, -s serial
local paste_delims: string = '\t'
local function delim(k: integer): string
  local idx = (k % (@integer)(paste_delims.size)) + 1
  local c = paste_delims:byte(idx)
  if c == 0 then return '' end
  return paste_delims:sub(idx, idx)
end

global function applet_paste(args: sequence(string)): integer
  local o = util.parse(args, 'd:s')
  if not o:ok() then return util.optfail(o) end
  paste_delims = '\t'
  if o:has('d') then
    local d, ok = util.unescape(o:get('d'))
    paste_delims = d
    if paste_delims.size == 0 then paste_delims = '\0' end
  end
  if #o.operands == 0 then o.operands:push('-') end
  local files: sequence(sequence(string))
  local rc: integer = 0
  for _, path in ipairs(o.operands) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1 end
    files:push(util.lines(data))
  end
  if o:has('s') then
    for _, lines in ipairs(files) do
      for k = 1, #lines do
        if k > 1 then util.write(delim(k - 2)) end
        util.write(lines[k])
      end
      util.writebyte(10)
    end
    return rc
  end
  local longest: integer = 0
  for _, lines in ipairs(files) do if #lines > longest then longest = #lines end end
  for row = 1, longest do
    for f = 1, #files do
      if f > 1 then util.write(delim(f - 2)) end
      if row <= #files[f] then util.write(files[f][row]) end
    end
    util.writebyte(10)
  end
  return rc
end

-- Tab stop list "8" or "4,8,12"
local function tabstops(spec: string): (sequence(integer), boolean)
  local stops: sequence(integer)
  for _, part in ipairs(util.lines((spec:gsub(',', '\n')))) do
    local v, ok = util.toint(part)
    if not ok or v <= 0 then return stops, false end
    if #stops > 0 and v <= stops[#stops] then return stops, false end
    stops:push(v)
  end
  if #stops == 0 then stops:push(8) end
  return stops, true
end

local function next_stop(stops: sequence(integer), col: integer): integer
  if #stops == 1 then return col + (stops[1] - col % stops[1]) end
  for _, s in ipairs(stops) do if s > col then return s end end
  return col + 1
end

global function applet_expand(args: sequence(string)): integer
  local o = util.parse(args, 'it:')
  if not o:ok() then return util.optfail(o) end
  local stops, ok = tabstops(o:has('t') and o:get('t') or '8')
  if not ok then return util.die("tab size contains invalid character(s): '" .. o:get('t') .. "'") end
  if #o.operands == 0 then o.operands:push('-') end
  local rc: integer = 0
  for _, path in ipairs(o.operands) do
    local data, dok = util.readfile(path)
    if not dok then rc = 1; continue end
    local col: integer = 0
    local initial = true
    for i: usize = 0, < data.size do
      local c = data.data[i]
      if c == 9 and (initial or not o:has('i')) then
        local target = next_stop(stops, col)
        while col < target do util.writebyte(32); col = col + 1 end
      else
        if c ~= 32 and c ~= 9 then initial = false end
        util.writebyte(c)
        if c == 10 then col = 0; initial = true elseif c == 8 then if col > 0 then col = col - 1 end else col = col + 1 end
      end
    end
  end
  return rc
end

-- Convert blanks spanning [pstart, upto) into tabs and spaces. A lone blank
-- that happens to reach a stop stays a space, as GNU does.
local function flushblanks(stops: sequence(integer), pstart: integer, upto: integer)
  if pstart < 0 then return end
  local c = pstart
  while true do
    local ns = next_stop(stops, c)
    if ns > upto then break end
    if ns - c == 1 and upto - c == 1 then break end
    util.writebyte(9); c = ns
  end
  while c < upto do util.writebyte(32); c = c + 1 end
end

-- unexpand: leading blanks only unless -a; -t sets stops (implies -a)
global function applet_unexpand(args: sequence(string)): integer
  local o = util.parse(args, 'at:')
  if not o:ok() then return util.optfail(o) end
  local stops, ok = tabstops(o:has('t') and o:get('t') or '8')
  if not ok then return util.die("tab size contains invalid character(s): '" .. o:get('t') .. "'") end
  local all = o:has('a') or o:has('t')
  if #o.operands == 0 then o.operands:push('-') end
  local rc: integer = 0
  for _, path in ipairs(o.operands) do
    local data, dok = util.readfile(path)
    if not dok then rc = 1; continue end
    local col: integer = 0      -- current output column
    local pend: integer = 0     -- pending blanks start column (blanks seen since `pstart`)
    local pstart: integer = -1
    local initial = true
    for i: usize = 0, < data.size do
      local c = data.data[i]
      if (c == 32 or c == 9) and (initial or all) then
        if pstart < 0 then pstart = col end
        if c == 9 then col = next_stop(stops, col) else col = col + 1 end
        if c == 9 then
          -- a literal tab: emit everything pending as tabs
          local cc = pstart
          while cc < col do
            local ns = next_stop(stops, cc)
            util.writebyte(9); cc = ns
          end
          pstart = -1
        end
      else
        flushblanks(stops, pstart, col); pstart = -1
        initial = false
        util.writebyte(c)
        if c == 10 then col = 0; initial = true elseif c == 8 then if col > 0 then col = col - 1 end else col = col + 1 end
      end
    end
    flushblanks(stops, pstart, col)
  end
  return rc
end

-- cksum: POSIX CRC32 (polynomial 0x04C11DB7, length appended, bit-inverted)
local crc_table: [256]uint32
local crc_ready = false
local function crc_init()
  if crc_ready then return end
  for i: uint32 = 0, 255 do
    local c: uint32 = i << 24
    for _ = 1, 8 do
      if (c & 0x80000000) ~= 0 then c = (c << 1) ~ 0x04C11DB7 else c = c << 1 end
    end
    crc_table[i] = c
  end
  crc_ready = true
end

global function applet_cksum(args: sequence(string)): integer
  crc_init()
  if #args == 0 then args:push('-') end
  local rc: integer = 0
  for _, path in ipairs(args) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    local crc: uint32 = 0
    for i: usize = 0, < data.size do
      crc = (crc << 8) ~ crc_table[((crc >> 24) ~ data.data[i]) & 0xFF]
    end
    local n: usize = data.size
    while n > 0 do
      crc = (crc << 8) ~ crc_table[((crc >> 24) ~ (n & 0xFF)) & 0xFF]
      n = n >> 8
    end
    crc = ~crc
    if path == '-' then util.writef('%u %d\n', crc, data.size)
    else util.writef('%u %d %s\n', crc, data.size, path) end
  end
  return rc
end

-- MD5
local function rotl32(x: uint32, n: uint32): uint32 return (x << n) | (x >> (32 - n)) end

local md5_s: [64]uint32 = {
  7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,
  5,9,14,20,5,9,14,20,5,9,14,20,5,9,14,20,
  4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,
  6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21}
local md5_k: [64]uint32 = {
  0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,
  0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,0x6b901122,0xfd987193,0xa679438e,0x49b40821,
  0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,
  0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,
  0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,
  0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,
  0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,
  0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391}

local function md5_pad(data: string, bigendian: boolean): sequence(byte)
  local m: sequence(byte)
  for i: usize = 0, < data.size do m:push(data.data[i]) end
  m:push(0x80)
  while #m % 64 ~= 56 do m:push(0) end
  local bits: uint64 = (@uint64)(data.size) * 8
  for i: uint64 = 0, 7 do
    if bigendian then m:push((@byte)((bits >> (56 - 8 * i)) & 0xFF))
    else m:push((@byte)((bits >> (8 * i)) & 0xFF)) end
  end
  return m
end

local function md5(data: string): string
  local m = md5_pad(data, false)
  local a0: uint32, b0: uint32, c0: uint32, d0: uint32 = 0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476
  local w: [16]uint32
  local off: integer = 1
  while off <= #m do
    for i = 0, 15 do
      local p = off + i * 4
      w[i] = (@uint32)(m[p]) | ((@uint32)(m[p+1]) << 8) | ((@uint32)(m[p+2]) << 16) | ((@uint32)(m[p+3]) << 24)
    end
    local a, b, c, d = a0, b0, c0, d0
    for i: uint32 = 0, 63 do
      local f: uint32, g: uint32
      if i < 16 then f = (b & c) | (~b & d); g = i
      elseif i < 32 then f = (d & b) | (~d & c); g = (5 * i + 1) % 16
      elseif i < 48 then f = b ~ c ~ d; g = (3 * i + 5) % 16
      else f = c ~ (b | ~d); g = (7 * i) % 16 end
      f = f + a + md5_k[i] + w[g]
      a = d; d = c; c = b
      b = b + rotl32(f, md5_s[i])
    end
    a0 = a0 + a; b0 = b0 + b; c0 = c0 + c; d0 = d0 + d
    off = off + 64
  end
  local sb: stringbuilder
  local words: [4]uint32 = {a0, b0, c0, d0}
  for i = 0, 3 do
    for k: uint32 = 0, 3 do sb:writef('%02x', (words[i] >> (8 * k)) & 0xFF) end
  end
  return sb:promote()
end

local function sha1(data: string): string
  local m = md5_pad(data, true)
  local h: [5]uint32 = {0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0}
  local w: [80]uint32
  local off: integer = 1
  while off <= #m do
    for i = 0, 15 do
      local p = off + i * 4
      w[i] = ((@uint32)(m[p]) << 24) | ((@uint32)(m[p+1]) << 16) | ((@uint32)(m[p+2]) << 8) | (@uint32)(m[p+3])
    end
    for i = 16, 79 do w[i] = rotl32(w[i-3] ~ w[i-8] ~ w[i-14] ~ w[i-16], 1) end
    local a, b, c, d, e = h[0], h[1], h[2], h[3], h[4]
    for i = 0, 79 do
      local f: uint32, k: uint32
      if i < 20 then f = (b & c) | (~b & d); k = 0x5A827999
      elseif i < 40 then f = b ~ c ~ d; k = 0x6ED9EBA1
      elseif i < 60 then f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDC
      else f = b ~ c ~ d; k = 0xCA62C1D6 end
      local t = rotl32(a, 5) + f + e + k + w[i]
      e = d; d = c; c = rotl32(b, 30); b = a; a = t
    end
    h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d; h[4] = h[4] + e
    off = off + 64
  end
  local sb: stringbuilder
  for i = 0, 4 do sb:writef('%08x', h[i]) end
  return sb:promote()
end

local sha256_k: [64]uint32 = {
  0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
  0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
  0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
  0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
  0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
  0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
  0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
  0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2}

local function rotr32(x: uint32, n: uint32): uint32 return (x >> n) | (x << (32 - n)) end

local function sha256(data: string): string
  local m = md5_pad(data, true)
  local h: [8]uint32 = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19}
  local w: [64]uint32
  local off: integer = 1
  while off <= #m do
    for i = 0, 15 do
      local p = off + i * 4
      w[i] = ((@uint32)(m[p]) << 24) | ((@uint32)(m[p+1]) << 16) | ((@uint32)(m[p+2]) << 8) | (@uint32)(m[p+3])
    end
    for i = 16, 63 do
      local s0 = rotr32(w[i-15], 7) ~ rotr32(w[i-15], 18) ~ (w[i-15] >> 3)
      local s1 = rotr32(w[i-2], 17) ~ rotr32(w[i-2], 19) ~ (w[i-2] >> 10)
      w[i] = w[i-16] + s0 + w[i-7] + s1
    end
    local a, b, c, d, e, f, g, hh = h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]
    for i = 0, 63 do
      local S1 = rotr32(e, 6) ~ rotr32(e, 11) ~ rotr32(e, 25)
      local ch = (e & f) ~ (~e & g)
      local t1 = hh + S1 + ch + sha256_k[i] + w[i]
      local S0 = rotr32(a, 2) ~ rotr32(a, 13) ~ rotr32(a, 22)
      local maj = (a & b) ~ (a & c) ~ (b & c)
      local t2 = S0 + maj
      hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2
    end
    h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d
    h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh
    off = off + 64
  end
  local sb: stringbuilder
  for i = 0, 7 do sb:writef('%08x', h[i]) end
  return sb:promote()
end

-- Shared driver for the *sum applets: prints "HASH  FILE" or checks with -c.
local function sum_main(args: sequence(string), hashfn: function(string): string, hexlen: integer): integer
  local o = util.parse(args, 'bctwq')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then o.operands:push('-') end
  local rc: integer = 0
  if o:has('c') then
    local bad: integer = 0
    for _, listpath in ipairs(o.operands) do
      local list, ok = util.readfile(listpath)
      if not ok then rc = 1; continue end
      for _, line in ipairs(util.lines(list)) do
        if (@integer)(line.size) < hexlen + 3 then continue end
        local want = line:sub(1, hexlen)
        local name = line:sub(hexlen + 3)
        if name.size > 0 and name:byte(1) == 42 then name = name:sub(2) end
        local data, dok = util.readfile(name)
        if not dok then
          if not o:has('q') then util.line(name .. ': FAILED open or read') end
          bad = bad + 1
          continue
        end
        if hashfn(data) == want then
          if not o:has('q') then util.line(name .. ': OK') end
        else
          util.line(name .. ': FAILED')
          bad = bad + 1
        end
      end
    end
    if bad > 0 then
      util.errf('%s: WARNING: %d computed checksum%s did NOT match\n', util.applet, bad, bad == 1 and '' or 's')
      rc = 1
    end
    return rc
  end
  for _, path in ipairs(o.operands) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    local sep: string = o:has('b') and ' *' or '  '
    util.line(hashfn(data) .. sep .. path)
  end
  return rc
end

global function applet_md5sum(args: sequence(string)): integer return sum_main(args, md5, 32) end
global function applet_sha1sum(args: sequence(string)): integer return sum_main(args, sha1, 40) end
global function applet_sha256sum(args: sequence(string)): integer return sum_main(args, sha256, 64) end

-- base64: encode (wrap at 76 by default, -w COLS), decode with -d (-i ignores garbage)
local b64chars: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

global function applet_base64(args: sequence(string)): integer
  local o = util.parse(args, 'diw:')
  if not o:ok() then return util.optfail(o) end
  local wrap: integer = 76
  if o:has('w') then
    local v, ok = util.toint(o:get('w'))
    if not ok or v < 0 then return util.die("invalid wrap size: '" .. o:get('w') .. "'") end
    wrap = v
  end
  if #o.operands > 1 then return util.die("extra operand '" .. o.operands[2] .. "'") end
  local path: string = '-'
  if #o.operands == 1 then path = o.operands[1] end
  local data, ok = util.readfile(path)
  if not ok then return 1 end
  if o:has('d') then
    local acc: uint32 = 0
    local bits: integer = 0
    local pad: integer = 0
    for i: usize = 0, < data.size do
      local c = data.data[i]
      local v: integer = -1
      if c >= 65 and c <= 90 then v = c - 65
      elseif c >= 97 and c <= 122 then v = c - 97 + 26
      elseif c >= 48 and c <= 57 then v = c - 48 + 52
      elseif c == 43 then v = 62 elseif c == 47 then v = 63
      elseif c == 61 then pad = pad + 1; continue
      elseif c == 10 or c == 13 then continue
      elseif not o:has('i') then return util.die('invalid input') end
      if v < 0 then continue end
      if pad > 0 then return util.die('invalid input') end
      acc = (acc << 6) | (@uint32)(v)
      bits = bits + 6
      if bits >= 8 then
        bits = bits - 8
        util.writebyte((@byte)((acc >> bits) & 0xFF))
      end
    end
    return 0
  end
  local col: integer = 0
  local i: usize = 0
  while i < data.size do
    local n: usize = data.size - i
    if n > 3 then n = 3 end
    local v: uint32 = (@uint32)(data.data[i]) << 16
    if n > 1 then v = v | ((@uint32)(data.data[i + 1]) << 8) end
    if n > 2 then v = v | (@uint32)(data.data[i + 2]) end
    local out: [4]byte = {
      b64chars:byte((@integer)((v >> 18) & 63) + 1), b64chars:byte((@integer)((v >> 12) & 63) + 1),
      n > 1 and b64chars:byte((@integer)((v >> 6) & 63) + 1) or 61,
      n > 2 and b64chars:byte((@integer)(v & 63) + 1) or 61 }
    for k = 0, 3 do
      if wrap > 0 and col == wrap then util.writebyte(10); col = 0 end
      util.writebyte(out[k]); col = col + 1
    end
    i = i + 3
  end
  if data.size > 0 and wrap > 0 then util.writebyte(10) end
  return 0
end

-- strings: printable runs of at least -n N (default 4) bytes
global function applet_strings(args: sequence(string)): integer
  local o = util.parse(args, 'an:tf')
  if not o:ok() then return util.optfail(o) end
  local minlen: integer = 4
  if o:has('n') then
    local v, ok = util.toint(o:get('n'))
    if not ok or v <= 0 then return util.die("invalid minimum string length '" .. o:get('n') .. "'") end
    minlen = v
  end
  if #o.operands == 0 then o.operands:push('-') end
  local rc: integer = 0
  for _, path in ipairs(o.operands) do
    local data, ok = util.readfile(path)
    if not ok then rc = 1; continue end
    local start: usize = 0
    local run: integer = 0
    for i: usize = 0, data.size do
      local printable = i < data.size and ((data.data[i] >= 32 and data.data[i] <= 126) or data.data[i] == 9)
      if printable then
        if run == 0 then start = i end
        run = run + 1
      else
        if run >= minlen then
          if o:has('f') and #o.operands > 0 then util.write(path .. ': ') end
          util.writebytes((@*[0]byte)(&data.data[start]), (@usize)(run)); util.writebyte(10)
        end
        run = 0
      end
    end
  end
  return rc
end

-- split: -l LINES (default 1000), -b BYTES, -d numeric suffixes, -a LEN
local function suffix(n: integer, len: integer, numeric: boolean): string
  local out: sequence(byte)
  local v = n
  for _ = 1, len do
    if numeric then out:push(48 + (@byte)(v % 10)); v = v // 10
    else out:push(97 + (@byte)(v % 26)); v = v // 26 end
  end
  local sb: stringbuilder
  for i = #out, 1, -1 do sb:writebyte(out[i]) end
  return sb:promote()
end

global function applet_split(args: sequence(string)): integer
  local o = util.parse(args, 'l:b:a:d')
  if not o:ok() then return util.optfail(o) end
  local lines: integer = 1000
  local bytes: integer = 0
  if o:has('l') then
    local v, ok = util.toint(o:get('l'))
    if not ok or v <= 0 then return util.die("invalid number of lines: '" .. o:get('l') .. "'") end
    lines = v
  end
  if o:has('b') then
    local v, ok = util.tosize(o:get('b'))
    if not ok or v <= 0 then return util.die("invalid number of bytes: '" .. o:get('b') .. "'") end
    bytes = v
  end
  local slen: integer = 2
  if o:has('a') then
    local v, ok = util.toint(o:get('a'))
    if not ok or v <= 0 then return util.die("invalid suffix length: '" .. o:get('a') .. "'") end
    slen = v
  end
  local path: string = '-'
  local prefix: string = 'x'
  if #o.operands >= 1 then path = o.operands[1] end
  if #o.operands >= 2 then prefix = o.operands[2] end
  if #o.operands > 2 then return util.die("extra operand '" .. o.operands[3] .. "'") end
  local data, ok = util.readfile(path)
  if not ok then return 1 end
  local idx: integer = 0
  local pos: usize = 0
  while pos < data.size do
    local stop: usize = data.size
    if bytes > 0 then
      stop = pos + (@usize)(bytes)
      if stop > data.size then stop = data.size end
    else
      local count: integer = 0
      local i = pos
      while i < data.size and count < lines do
        if data.data[i] == 10 then count = count + 1 end
        i = i + 1
      end
      stop = i
    end
    local name = prefix .. suffix(idx, slen, o:has('d'))
    local fd = sys.open(name, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, 0x1B6)
    if fd < 0 then return util.die("cannot open '" .. name .. "' for writing: " .. sys.errstr()) end
    local p = pos
    while p < stop do
      local w = sys.write(fd, &data.data[p], stop - p)
      if w < 0 then sys.close(fd); return util.die(name .. ': write error: ' .. sys.errstr()) end
      p = p + (@usize)(w)
    end
    sys.close(fd)
    idx = idx + 1
    pos = stop
  end
  return 0
end
