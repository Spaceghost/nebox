-- awk: POSIX.1-2017 awk. Options -F fs, -f progfile, -e program, -v
-- assignment (repeatable), -- ; operands are files, "-" for stdin, or
-- var=value assignments processed when reached.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.longopts'
require 'nebox.awk.lex'
require 'nebox.awk.ast'
require 'nebox.awk.parse'
require 'nebox.awk.interp'

local function usage(): integer
  util.err('usage: awk [-F fs] [-v assignment]... program [argument...]')
  util.err('       awk [-F fs] [-v assignment]... (-e program | -f progfile)... [argument...]')
  return 2
end

-- Combine fragments in argument order so -e and -f may be interleaved.
local function program_text(o: *util.Opts): (string, boolean)
  if o:has('f') or o:has('e') then
    local sb: stringbuilder
    for i = 1, #o.keys do
      local key, value = o.keys[i], o.vals[i]
      if key == 102 then
        local data, ok = util.readfile(value)
        if not ok then
          sb:destroy()
          util.err("cannot open source file `" .. value .. "' for reading")
          return '', false
        end
        sb:write(data)
        data:destroy()
      elseif key == 101 then
        sb:write(value)
      else
        continue
      end
      sb:writebyte(10)
    end
    return sb:promote(), true
  end
  if #o.operands == 0 then usage(); return '', false end
  local src = o.operands[1]
  o.operands:remove(1)
  return src, true
end

local awk_options: []util.LongOpt = {
  {'field-separator', 1, 70}, {'source', 1, 101}, {'file', 1, 102}, {'assign', 1, 118},
}

global function applet_awk(args: sequence(string)): integer
  local o = util.parsel(args, '+F:e:f:v:', &awk_options, #awk_options)
  if not o:ok() then
    util.optfail(o)
    return 2
  end
  local src, ok = program_text(&o)
  if not ok then return 2 end
  local prog: awkast.Program
  prog:init()
  local err = awkparse.parse(src, &prog)
  if err.size > 0 then
    util.err(err)
    return 2
  end
  local fs: string = ''
  local has_fs = false
  if o:has('F') then
    has_fs = true
    fs = awklex_unescape(o:get('F'))
  end
  return awkrun_run(&prog, o:all('v'), o.operands, fs, has_fs)
end
