-- diff: compare files line by line, as GNU diffutils 3.8 does.
--   diff [OPTIONS] FILE1 FILE2
-- The edit script comes from the same steps as GNU diff's analyze.c, so that
-- hunks match byte for byte: identical leading and trailing lines are set
-- aside except for the context ("horizon") lines; lines of one file that
-- match no line of the other are discarded first (discard_confusing_lines);
-- the rest goes through the middle-snake divide and conquer of diffseq.h
-- (compareseq/diag, including the "too expensive" cut-off); runs of changes
-- are slid and merged (shift_boundaries). Output formats include context,
-- unified, ed, side by side and ifdef. Directories: entries are compared by
-- name, recursively with -r.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'hashmap'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.locale'
require 'nebox.regex'
require 'nebox.fnmatch'
require 'nebox.diff_format'

local Opt = @record{
  fmt: byte,          -- normal, context, unified, ed, ifdef, or side by side
  context: integer,
  icase: boolean, space_change: boolean, all_space: boolean, blank_lines: boolean,
  text: boolean, new_file: boolean, brief: boolean, same: boolean, recursive: boolean,
  labels: sequence(string), excludes: sequence(string),
  formats: difffmt.Format, line_format_set: [3]boolean, group_format_set: [4]boolean,
  width: integer, tabsize: integer, expand_tabs: boolean,
  left_column: boolean, suppress_common: boolean,
  ignore_rules: sequence(regex.Prog), function_rules: sequence(regex.Prog),
  switches: string,   -- the option arguments as given, for "diff -r a/x b/x" headers
}

local DFile = @record{
  name: string,
  data: string,
  lines: sequence(string),
  incomplete: boolean,   -- the last line has no newline (and the output must say so)
  missing_nl: boolean,   -- the file does not end in a newline
  mtime: clong, mnsec: clong,
}

local Change = @record{ line0: integer, line1: integer, deleted: integer, inserted: integer, ignore: boolean }

-- Zeroed integer array indexed from `lo` (may be negative) up to hi.
local IArr = @record{ base: *[0]integer, off: integer }
local function iarr(lo: integer, hi: integer): IArr
  local n = hi - lo + 1
  if n < 1 then n = 1 end
  local p = (@*[0]integer)(default_allocator:alloc((@usize)(n) * 8))
  for i = 0, < n do p[i] = 0 end
  return {base = p, off = -lo}
end
function IArr:get(i: integer): integer <inline> return self.base[i + self.off] end
function IArr:set(i: integer, v: integer) <inline> self.base[i + self.off] = v end
function IArr:free() default_allocator:dealloc(self.base) end

local function is_space(c: byte): boolean
  return c == 32 or c == 9 or c == 11 or c == 12 or c == 13
end

-- The key two lines must share to be equal under -i/-b/-w. An incomplete
-- last line equals a complete one only under -b or -w, where the missing
-- newline is white space, and in ed scripts, which cannot express it (GNU).
local function line_key(o: *Opt, s: string, incomplete: boolean): string
  local sb: stringbuilder
  sb:writebyte((incomplete and not o.space_change and not o.all_space and o.fmt ~= 101) and 73 or 67)
  if not o.icase and not o.space_change and not o.all_space then
    sb:write(s)
    return sb:promote()
  end
  local input = s
  if o.icase and nlocale.multibyte then input = nlocale.casemap(s, false) end
  local pending_space = false
  local i: usize = 0
  while i < input.size do
    local c, used = nlocale.decode(input, i)
    local space = nlocale.multibyte and nlocale.space(c) or (not nlocale.multibyte and is_space(input.data[i]))
    if space and (o.all_space or o.space_change) then
      if o.space_change and not o.all_space then pending_space = true end
    else
      if pending_space then sb:writebyte(32); pending_space = false end
      if o.icase and not nlocale.multibyte and c >= 65 and c <= 90 then
        sb:writebyte((@byte)(c + 32))
      else
        for j: usize = 0, < used do sb:writebyte(input.data[i + j]) end
      end
    end
    i = i + used
  end
  if o.icase and nlocale.multibyte then input:destroy() end
  -- -b: trailing white space is dropped (pending_space is never written)
  return sb:promote()
end

local function is_blank(o: *Opt, s: string): boolean
  if s.size == 0 then return true end
  if not (o.space_change or o.all_space) then return false end
  local i: usize = 0
  while i < s.size do
    local c, used = nlocale.decode(s, i)
    if nlocale.multibyte then
      if not nlocale.space(c) then return false end
    elseif not is_space((@byte)(c)) then return false end
    i = i + used
  end
  return true
end

local function matches_any(rules: *sequence(regex.Prog), line: string): boolean
  for i = 1, #rules do if rules[i]:test(line) then return true end end
  return false
end

local function ignore_line(o: *Opt, line: string): boolean
  return (o.blank_lines and is_blank(o, line)) or matches_any(&o.ignore_rules, line)
end

----------------------------------------------------------------------
-- Reading
----------------------------------------------------------------------

local function load(path: string, label: string, f: *DFile): boolean
  f.name = label
  local fd: cint = 0
  if path ~= '-' then fd = sys.open(path, sys.O_RDONLY | sys.O_CLOEXEC, 0) end
  if fd < 0 then util.perror(path); return false end
  local st: sys.Stat
  if sys.fstat(fd, &st) == 0 then
    f.mtime = st.st_mtim.tv_sec
    f.mnsec = st.st_mtim.tv_nsec
  end
  if path == '-' and (st.st_mode & sys.S_IFMT) ~= sys.S_IFREG then
    -- GNU diff dates a non-file standard input with the current time
    local ts: sys.Timespec
    sys.clock_gettime(0, &ts)
    f.mtime = ts.tv_sec; f.mnsec = ts.tv_nsec
  end
  local data, ok = util.readfd(fd)
  if fd > 0 then sys.close(fd) end
  if not ok then util.perror(path); return false end
  f.data = data
  f.lines = util.lines(data)
  f.incomplete = data.size > 0 and data.data[data.size - 1] ~= 10
  f.missing_nl = f.incomplete
  return true
end

local function empty_file(label: string, f: *DFile)
  f.name = label
  f.data = ''
  f.mtime = 0; f.mnsec = 0
end

local function has_nul(s: string): boolean
  for i: usize = 0, < s.size do
    if s.data[i] == 0 then return true end
  end
  return false
end

----------------------------------------------------------------------
-- Analysis (GNU analyze.c and diffseq.h)
----------------------------------------------------------------------

local Ctx = @record{
  xv: IArr, yv: IArr,          -- undiscarded equivalence classes
  fd: IArr, bd: IArr,          -- forward/backward furthest points per diagonal
  too_expensive: integer,
  changed0: IArr, changed1: IArr,   -- over the middle region, sentinels at -1 and len
  real0: IArr, real1: IArr,
}

local Partition = @record{ xmid: integer, ymid: integer, lo_minimal: boolean, hi_minimal: boolean }

local OFFSET_MAX: integer <comptime> = 0x3fffffffffffffff

local function diag(c: *Ctx, xoff: integer, xlim: integer, yoff: integer, ylim: integer,
                    find_minimal: boolean, part: *Partition)
  local fd, bd = &c.fd, &c.bd
  local dmin = xoff - ylim
  local dmax = xlim - yoff
  local fmid = xoff - yoff
  local bmid = xlim - ylim
  local fmin, fmax = fmid, fmid
  local bmin, bmax = bmid, bmid
  local odd = ((fmid - bmid) & 1) ~= 0
  fd:set(fmid, xoff)
  bd:set(bmid, xlim)
  local cost = 1
  while true do
    -- extend the top-down search by an edit step in each diagonal
    if fmin > dmin then fmin = fmin - 1; fd:set(fmin - 1, -1) else fmin = fmin + 1 end
    if fmax < dmax then fmax = fmax + 1; fd:set(fmax + 1, -1) else fmax = fmax - 1 end
    local d = fmax
    while d >= fmin do
      local tlo, thi = fd:get(d - 1), fd:get(d + 1)
      local x0 = tlo < thi and thi or tlo + 1
      local x, y = x0, x0 - d
      while x < xlim and y < ylim and c.xv:get(x) == c.yv:get(y) do x = x + 1; y = y + 1 end
      fd:set(d, x)
      if odd and bmin <= d and d <= bmax and bd:get(d) <= x then
        part.xmid = x; part.ymid = y
        part.lo_minimal = true; part.hi_minimal = true
        return
      end
      d = d - 2
    end
    -- and the bottom-up search
    if bmin > dmin then bmin = bmin - 1; bd:set(bmin - 1, OFFSET_MAX) else bmin = bmin + 1 end
    if bmax < dmax then bmax = bmax + 1; bd:set(bmax + 1, OFFSET_MAX) else bmax = bmax - 1 end
    d = bmax
    while d >= bmin do
      local tlo, thi = bd:get(d - 1), bd:get(d + 1)
      local x0 = tlo < thi and tlo or thi - 1
      local x, y = x0, x0 - d
      while xoff < x and yoff < y and c.xv:get(x - 1) == c.yv:get(y - 1) do x = x - 1; y = y - 1 end
      bd:set(d, x)
      if not odd and fmin <= d and d <= fmax and x <= fd:get(d) then
        part.xmid = x; part.ymid = y
        part.lo_minimal = true; part.hi_minimal = true
        return
      end
      d = d - 2
    end
    if not find_minimal and cost >= c.too_expensive then
      -- give up and report halfway between the best results so far
      local fxybest, fxbest = -1, 0
      d = fmax
      while d >= fmin do
        local x = fd:get(d)
        if x > xlim then x = xlim end
        local y = x - d
        if ylim < y then x = ylim + d; y = ylim end
        if fxybest < x + y then fxybest = x + y; fxbest = x end
        d = d - 2
      end
      local bxybest, bxbest = OFFSET_MAX, 0
      d = bmax
      while d >= bmin do
        local x = bd:get(d)
        if x < xoff then x = xoff end
        local y = x - d
        if y < yoff then x = yoff + d; y = yoff end
        if x + y < bxybest then bxybest = x + y; bxbest = x end
        d = d - 2
      end
      if (xlim + ylim) - bxybest < fxybest - (xoff + yoff) then
        part.xmid = fxbest; part.ymid = fxybest - fxbest
        part.lo_minimal = true; part.hi_minimal = false
      else
        part.xmid = bxbest; part.ymid = bxybest - bxbest
        part.lo_minimal = false; part.hi_minimal = true
      end
      return
    end
    cost = cost + 1
  end
end

local function compareseq(c: *Ctx, xoff: integer, xlim: integer, yoff: integer, ylim: integer, find_minimal: boolean)
  while xoff < xlim and yoff < ylim and c.xv:get(xoff) == c.yv:get(yoff) do xoff = xoff + 1; yoff = yoff + 1 end
  while xoff < xlim and yoff < ylim and c.xv:get(xlim - 1) == c.yv:get(ylim - 1) do xlim = xlim - 1; ylim = ylim - 1 end
  if xoff == xlim then
    while yoff < ylim do c.changed1:set(c.real1:get(yoff), 1); yoff = yoff + 1 end
  elseif yoff == ylim then
    while xoff < xlim do c.changed0:set(c.real0:get(xoff), 1); xoff = xoff + 1 end
  else
    local part: Partition
    diag(c, xoff, xlim, yoff, ylim, find_minimal, &part)
    compareseq(c, xoff, part.xmid, yoff, part.ymid, part.lo_minimal)
    compareseq(c, part.xmid, xlim, part.ymid, ylim, part.hi_minimal)
  end
end

-- discard_confusing_lines: equivs over the middle regions, counts per class.
local function discard_confusing(c: *Ctx, eq: *[2]IArr, len: *[2]integer, nclass: integer)
  local counts: [2]IArr = {iarr(0, nclass), iarr(0, nclass)}
  for f = 0, 1 do
    for i = 0, < len[f] do
      counts[f]:set(eq[f]:get(i), counts[f]:get(eq[f]:get(i)) + 1)
    end
  end
  local discards: [2]IArr = {iarr(0, len[0]), iarr(0, len[1])}
  for f = 0, 1 do
    local endl = len[f]
    local many = 5
    local tem = endl // 64
    tem = tem >> 2
    while tem > 0 do many = many * 2; tem = tem >> 2 end
    for i = 0, < endl do
      local nmatch = counts[1 - f]:get(eq[f]:get(i))
      if nmatch == 0 then discards[f]:set(i, 1)
      elseif nmatch > many then discards[f]:set(i, 2) end
    end
  end
  for f = 0, 1 do
    local endl = len[f]
    local ds = &discards[f]
    local i = 0
    while i < endl do
      if ds:get(i) == 2 then
        ds:set(i, 0)
      elseif ds:get(i) ~= 0 then
        local provisional = 0
        local j = i
        while j < endl do
          if ds:get(j) == 0 then break end
          if ds:get(j) == 2 then provisional = provisional + 1 end
          j = j + 1
        end
        while j > i and ds:get(j - 1) == 2 do j = j - 1; ds:set(j, 0); provisional = provisional - 1 end
        local length = j - i
        if provisional * 4 > length then
          while j > i do
            j = j - 1
            if ds:get(j) == 2 then ds:set(j, 0) end
          end
        else
          local minimum = 1
          local t = length >> 2
          t = t >> 2
          while t > 0 do minimum = minimum << 1; t = t >> 2 end
          minimum = minimum + 1
          local consec = 0
          j = 0
          while j < length do
            if ds:get(i + j) ~= 2 then
              consec = 0
            else
              consec = consec + 1
              if minimum == consec then
                j = j - consec
              elseif minimum < consec then
                ds:set(i + j, 0)
              end
            end
            j = j + 1
          end
          consec = 0
          j = 0
          while j < length do
            if j >= 8 and ds:get(i + j) == 1 then break end
            if ds:get(i + j) == 2 then consec = 0; ds:set(i + j, 0)
            elseif ds:get(i + j) == 0 then consec = 0
            else consec = consec + 1 end
            if consec == 3 then break end
            j = j + 1
          end
          i = i + length - 1
          consec = 0
          j = 0
          while j < length do
            if j >= 8 and ds:get(i - j) == 1 then break end
            if ds:get(i - j) == 2 then consec = 0; ds:set(i - j, 0)
            elseif ds:get(i - j) == 0 then consec = 0
            else consec = consec + 1 end
            if consec == 3 then break end
            j = j + 1
          end
        end
      end
      i = i + 1
    end
  end
  -- keep the undiscarded lines; the discarded ones are changes already
  local und: [2]IArr = {iarr(0, len[0]), iarr(0, len[1])}
  local real: [2]IArr = {iarr(0, len[0]), iarr(0, len[1])}
  local nund: [2]integer
  for f = 0, 1 do
    local j = 0
    local changed = f == 0 and &c.changed0 or &c.changed1
    for i = 0, < len[f] do
      if discards[f]:get(i) == 0 then
        und[f]:set(j, eq[f]:get(i))
        real[f]:set(j, i)
        j = j + 1
      else
        changed:set(i, 1)
      end
    end
    nund[f] = j
  end
  c.xv, c.yv = und[0], und[1]
  c.real0, c.real1 = real[0], real[1]
  for f = 0, 1 do counts[f]:free(); discards[f]:free() end
  -- diffseq scratch: diagonals from -(ny+1) to nx+1
  local nx, ny = nund[0], nund[1]
  c.fd = iarr(-(ny + 1), nx + 1)
  c.bd = iarr(-(ny + 1), nx + 1)
  local diags = nx + ny + 3
  c.too_expensive = 1
  while diags ~= 0 do c.too_expensive = c.too_expensive << 1; diags = diags >> 2 end
  if c.too_expensive < 4096 then c.too_expensive = 4096 end
  compareseq(c, 0, nx, 0, ny, false)
end

local function shift_boundaries(changed: *[2]*IArr, eq: *[2]IArr, len: *[2]integer)
  for f = 0, 1 do
    local ch = changed[f]
    local other = changed[1 - f]
    local equivs = &eq[f]
    local i, j = 0, 0
    local i_end = len[f]
    while true do
      while i < i_end and ch:get(i) == 0 do
        while other:get(j) ~= 0 do j = j + 1 end
        j = j + 1
        i = i + 1
      end
      if i == i_end then break end
      local start = i
      i = i + 1
      while ch:get(i) ~= 0 do i = i + 1 end
      while other:get(j) ~= 0 do j = j + 1 end
      local corresponding: integer
      local runlength: integer
      repeat
        runlength = i - start
        while start > 0 and equivs:get(start - 1) == equivs:get(i - 1) do
          start = start - 1; ch:set(start, 1)
          i = i - 1; ch:set(i, 0)
          while ch:get(start - 1) ~= 0 do start = start - 1 end
          j = j - 1
          while other:get(j) ~= 0 do j = j - 1 end
        end
        corresponding = other:get(j - 1) ~= 0 and i or i_end
        while i ~= i_end and equivs:get(start) == equivs:get(i) do
          ch:set(start, 0); start = start + 1
          ch:set(i, 1); i = i + 1
          while ch:get(i) ~= 0 do i = i + 1 end
          j = j + 1
          while other:get(j) ~= 0 do j = j + 1; corresponding = i end
        end
      until runlength == i - start
      while corresponding < i do
        start = start - 1; ch:set(start, 1)
        i = i - 1; ch:set(i, 0)
        j = j - 1
        while other:get(j) ~= 0 do j = j - 1 end
      end
    end
  end
end

-- The changes between two files, in order, with 0-based global line numbers.
-- A byte of the file as GNU diff buffers it: a missing final newline is supplied.
local function vbyte(f: *DFile, i: integer): byte <inline>
  if i < (@integer)(f.data.size) then return f.data.data[i] end
  return 10
end

local function vsize(f: *DFile): integer <inline>
  return (@integer)(f.data.size) + (f.missing_nl and 1 or 0)
end

local function line_of(f: *DFile, off: integer): integer
  local n = 0
  for i = 0, < off do
    if vbyte(f, i) == 10 then n = n + 1 end
  end
  return n
end

-- GNU io.c find_identical_ends, on bytes: the identical prefix backed up to a
-- line start and then by `horizon` lines; the identical suffix, scanned no
-- further back than that prefix end (and the size difference), advanced to a
-- line start and then by `horizon` lines. Returns the line ranges to analyze.
local function identical_ends(o: *Opt, a: *DFile, b: *DFile, horizon: integer): (integer, integer, integer)
  local n0, n1 = vsize(a), vsize(b)
  local robust = o.fmt ~= 101
  local p = 0
  while p < n0 and p < n1 and vbyte(a, p) == vbyte(b, p) do p = p + 1 end
  -- don't mistakenly count a supplied newline as part of the prefix
  if robust and ((n0 - (a.missing_nl and 1 or 0) < p) ~= (n1 - (b.missing_nl and 1 or 0) < p)) then p = p - 1 end
  local i = horizon
  while p ~= 0 do
    if vbyte(a, p - 1) ~= 10 then
      p = p - 1
    else
      if i == 0 then break end
      i = i - 1
      p = p - 1
    end
  end
  local q0, q1 = n0, n1
  if not robust or a.missing_nl == b.missing_nl then
    local beg0 = p + (n0 < n1 and 0 or n0 - n1)
    while q0 ~= beg0 do
      q0 = q0 - 1; q1 = q1 - 1
      if vbyte(a, q0) ~= vbyte(b, q1) then
        q0 = q0 + 1; q1 = q1 + 1
        beg0 = q0
        break
      end
    end
    local at_line = (q0 == 0 or vbyte(a, q0 - 1) == 10) and (q1 == 0 or vbyte(b, q1 - 1) == 10)
    local k = horizon + (at_line and 0 or 1)
    local start0 = q0
    while k > 0 and q0 ~= n0 do
      k = k - 1
      while true do
        local c = vbyte(a, q0)
        q0 = q0 + 1
        if c == 10 then break end
      end
    end
    q1 = q1 + (q0 - start0)
  end
  return line_of(a, p), line_of(a, q0), line_of(b, q1)
end

local function analyze(o: *Opt, a: *DFile, b: *DFile, horizon: integer): sequence(Change)
  local pre, end0, end1 = identical_ends(o, a, b, horizon)
  local len: [2]integer = {end0 - pre, end1 - pre}
  -- equivalence classes over the middle regions (numbered from 1)
  local classes: hashmap(string, integer)
  local nclass = 0
  local eq: [2]IArr = {iarr(0, len[0]), iarr(0, len[1])}
  for f = 0, 1 do
    local file = f == 0 and a or b
    local n = #file.lines
    for i = 0, < len[f] do
      local li = pre + i
      local key = line_key(o, file.lines[li + 1], file.incomplete and li == n - 1)
      local p = classes:peek(key)
      if p == nilptr then
        nclass = nclass + 1
        classes[key] = nclass
        eq[f]:set(i, nclass)
      else
        eq[f]:set(i, $p)
        key:destroy()
      end
    end
  end
  local c: Ctx
  c.changed0 = iarr(-1, len[0] + 1)
  c.changed1 = iarr(-1, len[1] + 1)
  discard_confusing(&c, &eq, &len, nclass)
  local changed: [2]*IArr = {&c.changed0, &c.changed1}
  shift_boundaries(&changed, &eq, &len)
  local out: sequence(Change)
  local i0, i1 = 0, 0
  while i0 < len[0] or i1 < len[1] do
    if c.changed0:get(i0) ~= 0 or c.changed1:get(i1) ~= 0 then
      local l0, l1 = i0, i1
      while c.changed0:get(i0) ~= 0 do i0 = i0 + 1 end
      while c.changed1:get(i1) ~= 0 do i1 = i1 + 1 end
      out:push({line0 = pre + l0, line1 = pre + l1, deleted = i0 - l0, inserted = i1 - l1})
    end
    i0 = i0 + 1; i1 = i1 + 1
  end
  -- An edit is ignorable only if every deleted and inserted line is blank
  -- under -B or matches one of the -I expressions.
  if o.blank_lines or #o.ignore_rules > 0 then
    for ci = 1, #out do
      local ch = &out[ci]
      local trivial = true
      for x = ch.line0, < ch.line0 + ch.deleted do
        if not ignore_line(o, a.lines[x + 1]) then trivial = false; break end
      end
      if trivial then
        for x = ch.line1, < ch.line1 + ch.inserted do
          if not ignore_line(o, b.lines[x + 1]) then trivial = false; break end
        end
      end
      ch.ignore = trivial
    end
  end
  for f = 0, 1 do eq[f]:free() end
  c.changed0:free(); c.changed1:free(); c.xv:free(); c.yv:free()
  c.real0:free(); c.real1:free(); c.fd:free(); c.bd:free()
  classes:destroy()
  return out
end

----------------------------------------------------------------------
-- Output
----------------------------------------------------------------------

local ed_mode = false   -- ed scripts have no "\ No newline" marker

local function put_line(prefix: string, f: *DFile, i: integer)
  util.write(prefix)
  util.write(f.lines[i + 1])
  util.writebyte(10)
  if f.incomplete and i == #f.lines - 1 and not ed_mode then util.write('\\ No newline at end of file\n') end
end

local WDAY: []string = {'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'}
local MON: []string = {'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'}

-- Context headers in the C locale use POSIX's "%a %b %e %T %Y" (GNU diff
-- uses ISO 8601 there only in other locales; nebox has only the C locale).
local function put_ctime(f: *DFile)
  local t: clong = f.mtime
  local tm: sys.Tm
  sys.localtime_r(&t, &tm)
  util.writef('%s %s %2d %02d:%02d:%02d %d', WDAY[tm.tm_wday], MON[tm.tm_mon], tm.tm_mday,
    tm.tm_hour, tm.tm_min, tm.tm_sec, tm.tm_year + 1900)
end

local function put_time(f: *DFile)
  local t: clong = f.mtime
  local tm: sys.Tm
  sys.localtime_r(&t, &tm)
  local off = tm.tm_gmtoff
  local sign = off < 0 and '-' or '+'
  if off < 0 then off = -off end
  util.writef('%04d-%02d-%02d %02d:%02d:%02d.%09d %s%02d%02d', tm.tm_year + 1900, tm.tm_mon + 1,
    tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec, f.mnsec, sign, off // 3600, (off % 3600) // 60)
end

local OLD: integer <comptime> = 1
local NEW: integer <comptime> = 2

-- analyze_hunk: the ranges a hunk covers and whether it deletes/inserts
-- (ignoring -B-ignorable changes for the latter).
local function hunk_range(ch: *sequence(Change), h0: integer, h1: integer): (integer, integer, integer, integer, integer)
  local first = &ch[h0]
  local last = &ch[h1]
  local f0, f1 = first.line0, first.line1
  local l0, l1 = last.line0 + last.deleted - 1, last.line1 + last.inserted - 1
  local changes = 0
  for k = h0, h1 do
    if not ch[k].ignore then
      if ch[k].deleted > 0 then changes = changes | OLD end
      if ch[k].inserted > 0 then changes = changes | NEW end
    end
  end
  return f0, l0, f1, l1, changes
end

local function num_range(a: integer, b: integer)
  -- normal and ed: "a,b", or the single line b
  if b + 1 > a + 1 then util.writef('%d,%d', a + 1, b + 1) else util.writef('%d', b + 1) end
end

local function uni_range(a: integer, b: integer)
  local ta, tb = a + 1, b + 1
  if tb <= ta then
    if tb < ta then util.writef('%d,0', tb) else util.writef('%d', tb) end
  else
    util.writef('%d,%d', ta, tb - ta + 1)
  end
end

local function ctx_range(a: integer, b: integer)
  local ta, tb = a + 1, b + 1
  if tb <= ta then util.writef('%d', tb) else util.writef('%d,%d', ta, tb) end
end

-- Hunks: a change joins the previous hunk when the gap is under the
-- threshold (2*context+1, or context for an ignorable change).
local function hunks(ch: *sequence(Change), context: integer): sequence(integer)
  local starts: sequence(integer)
  local i = 1
  while i <= #ch do
    starts:push(i)
    local j = i
    while j < #ch do
      local top0 = ch[j].line0 + ch[j].deleted
      local nxt = &ch[j + 1]
      local thresh = nxt.ignore and context or 2 * context + 1
      if top0 + thresh <= nxt.line0 then break end
      j = j + 1
    end
    i = j + 1
  end
  starts:push(#ch + 1)
  return starts
end

local function print_normal(a: *DFile, b: *DFile, ch: *sequence(Change))
  for k = 1, #ch do
    local f0, l0, f1, l1, changes = hunk_range(ch, k, k)
    if changes == 0 then continue end
    num_range(f0, l0)
    util.writebyte(changes == OLD and 100 or (changes == NEW and 97 or 99))
    num_range(f1, l1)
    util.writebyte(10)
    if changes & OLD ~= 0 then for i = f0, l0 do put_line('< ', a, i) end end
    if changes == OLD | NEW then util.write('---\n') end
    if changes & NEW ~= 0 then for i = f1, l1 do put_line('> ', b, i) end end
  end
end

local function print_ed(a: *DFile, b: *DFile, ch: *sequence(Change))
  for k = #ch, 1, -1 do
    local f0, l0, f1, l1, changes = hunk_range(ch, k, k)
    if changes == 0 then continue end
    num_range(f0, l0)
    util.writebyte(changes == OLD and 100 or (changes == NEW and 97 or 99))
    util.writebyte(10)
    if changes ~= OLD then
      local insert_mode = true
      for i = f1, l1 do
        if not insert_mode then util.write('a\n'); insert_mode = true end
        local line = b.lines[i + 1]
        if line == '.' and not (b.incomplete and i == #b.lines - 1) then
          util.write('..\n.\ns/.//\n')
          insert_mode = false
        else
          put_line('', b, i)
        end
      end
      if insert_mode then util.write('.\n') end
    end
  end
end

-- Context lines around a hunk, clipped to the files.
local function widen(a: *DFile, b: *DFile, f0: integer, l0: integer, f1: integer, l1: integer, context: integer): (integer, integer, integer, integer)
  local nf0 = f0 - context
  if nf0 < 0 then nf0 = 0 end
  local nf1 = f1 - (f0 - nf0)
  if nf1 < 0 then nf1 = 0 end
  if l0 < #a.lines - context then l0 = l0 + context else l0 = #a.lines - 1 end
  if l1 < #b.lines - context then l1 = l1 + context else l1 = #b.lines - 1 end
  return nf0, l0, nf1, l1
end

-- Search the old file above the first context line, as diffutils does.
local function print_function(o: *Opt, a: *DFile, before: integer)
  if #o.function_rules == 0 then return end
  for line = before, 1, -1 do
    local text = a.lines[line]
    if matches_any(&o.function_rules, text) then
      if text.size > 0 then util.write(' '); util.write(text:subview(1, 40)) end
      return
    end
  end
end

local function print_file_header(o: *Opt, prefix: string, f: *DFile, idx: integer)
  util.write(prefix)
  if idx <= #o.labels then
    util.line(o.labels[idx])
  else
    util.write(f.name); util.writebyte(9)
    if o.fmt == 117 then put_time(f) else put_ctime(f) end
    util.writebyte(10)
  end
end

local function print_unified(o: *Opt, a: *DFile, b: *DFile, ch: *sequence(Change))
  local context = o.context
  local hs = hunks(ch, context)
  for h = 1, #hs - 1 do
    local h0, h1 = hs[h], hs[h + 1] - 1
    local f0, l0, f1, l1, changes = hunk_range(ch, h0, h1)
    if changes == 0 then continue end
    f0, l0, f1, l1 = widen(a, b, f0, l0, f1, l1, context)
    util.write('@@ -'); uni_range(f0, l0); util.write(' +'); uni_range(f1, l1); util.write(' @@'); print_function(o, a, f0); util.writebyte(10)
    local nx = h0
    local i, j = f0, f1
    while i <= l0 or j <= l1 do
      if nx > h1 or i < ch[nx].line0 then
        put_line(' ', a, i)
        i = i + 1; j = j + 1
      else
        for _ = 1, ch[nx].deleted do put_line('-', a, i); i = i + 1 end
        for _ = 1, ch[nx].inserted do put_line('+', b, j); j = j + 1 end
        nx = nx + 1
      end
    end
  end
end

local function print_context(o: *Opt, a: *DFile, b: *DFile, ch: *sequence(Change))
  local context = o.context
  local hs = hunks(ch, context)
  for h = 1, #hs - 1 do
    local h0, h1 = hs[h], hs[h + 1] - 1
    local f0, l0, f1, l1, changes = hunk_range(ch, h0, h1)
    if changes == 0 then continue end
    f0, l0, f1, l1 = widen(a, b, f0, l0, f1, l1, context)
    util.write('***************'); print_function(o, a, f0)
    util.write('\n*** '); ctx_range(f0, l0); util.write(' ****\n')
    if changes & OLD ~= 0 then
      local nx = h0
      for i = f0, l0 do
        while nx <= h1 and ch[nx].line0 + ch[nx].deleted <= i do nx = nx + 1 end
        local prefix: string = '  '
        if nx <= h1 and ch[nx].line0 <= i then prefix = ch[nx].inserted > 0 and '! ' or '- ' end
        put_line(prefix, a, i)
      end
    end
    util.write('--- '); ctx_range(f1, l1); util.write(' ----\n')
    if changes & NEW ~= 0 then
      local nx = h0
      for j = f1, l1 do
        while nx <= h1 and ch[nx].line1 + ch[nx].inserted <= j do nx = nx + 1 end
        local prefix: string = '  '
        if nx <= h1 and ch[nx].line1 <= j then prefix = ch[nx].deleted > 0 and '! ' or '+ ' end
        put_line(prefix, b, j)
      end
    end
  end
end

local function print_rcs(b: *DFile, ch: *sequence(Change))
  for i = 1, #ch do
    local change = &ch[i]
    if change.ignore then continue end
    if change.deleted > 0 then util.writef('d%d %d\n', change.line0 + 1, change.deleted) end
    if change.inserted > 0 then
      util.writef('a%d %d\n', change.line0 + change.deleted, change.inserted)
      for j = change.line1 + 1, change.line1 + change.inserted do
        util.write(b.lines[j])
        if j < #b.lines or not b.missing_nl then util.writebyte(10) end
      end
    end
  end
end

local function print_merged(o: *Opt, a: *DFile, b: *DFile, ch: *sequence(Change))
  local old: difffmt.Side = {lines = &a.lines, incomplete = a.missing_nl}
  local new: difffmt.Side = {lines = &b.lines, incomplete = b.missing_nl}
  for i = 1, #ch do
    local change = &ch[i]
    if change.ignore then continue end
    old.stop, new.stop = change.line0, change.line1
    if old.first < old.stop or new.first < new.stop then
      difffmt.write(&o.formats, difffmt.SAME, &old, &new)
    end
    old.first, new.first = old.stop, new.stop
    old.stop = old.stop + change.deleted
    new.stop = new.stop + change.inserted
    local kind = difffmt.CHANGED
    if change.deleted == 0 then kind = difffmt.NEW
    elseif change.inserted == 0 then kind = difffmt.OLD end
    difffmt.write(&o.formats, kind, &old, &new)
    old.first, new.first = old.stop, new.stop
  end
  old.stop, new.stop = #a.lines, #b.lines
  if old.first < old.stop or new.first < new.stop then
    difffmt.write(&o.formats, difffmt.SAME, &old, &new)
  end
end

-- Side-by-side layout uses a gutter of at least three columns and aligns
-- the start of the right half to a tab stop unless tabs are expanded.
local function side_padding(o: *Opt, col: integer, stop: integer)
  if not o.expand_tabs then
    local next_tab = col + (o.tabsize - col % o.tabsize)
    while next_tab <= stop do
      util.writebyte(9)
      col = next_tab
      if stop - next_tab < o.tabsize then break end
      next_tab = next_tab + o.tabsize
    end
  end
  for i = col, < stop do util.writebyte(32) end
end

local function side_text(o: *Opt, text: string, width: integer, indent: integer): integer
  local source, printed = 0, 0
  for i: usize = 1, text.size do
    local c = text:byte(i)
    if c == 9 then
      local step = o.tabsize - source % o.tabsize
      if source == printed then
        local stop = source + step
        if o.expand_tabs then
          if stop > width then stop = width end
          for col = printed, < stop do util.writebyte(32) end
          printed = stop
        elseif stop < width then
          util.writebyte(9); printed = stop
        end
      end
      source = source + step
    elseif c == 13 then
      util.writebyte(13)
      side_padding(o, 0, indent)
      source, printed = 0, 0
    elseif c == 8 then
      if source > 0 then
        source = source - 1
        if source < width then
          if printed > source then util.writebyte(8)
          else for col = printed, < source do util.writebyte(32) end end
          printed = source
        end
      end
    elseif c >= 32 and c <= 126 then
      source = source + 1
      if source <= width then util.writebyte(c); printed = source end
    elseif source < width then
      util.writebyte(c)
    end
  end
  return printed
end

local function side_row(o: *Opt, a: *DFile, b: *DFile, i: integer, j: integer,
                        sep: byte, half: integer, right: integer)
  local col = 0
  local left_nl = i >= 0 and (i < #a.lines - 1 or not a.missing_nl)
  local right_nl = j >= 0 and (j < #b.lines - 1 or not b.missing_nl)
  if i >= 0 then col = side_text(o, a.lines[i + 1], half, 0) end
  if sep ~= 32 then
    local gutter = (half + right - 1) // 2
    side_padding(o, col, gutter)
    if sep == 124 and left_nl ~= right_nl then sep = left_nl and 47 or 92 end
    util.writebyte(sep)
    col = gutter + 1
  end
  if j >= 0 and b.lines[j + 1].size > 0 then
    side_padding(o, col, right)
    side_text(o, b.lines[j + 1], half, right)
  end
  if left_nl or right_nl then util.writebyte(10) end
end

local function print_side(o: *Opt, a: *DFile, b: *DFile, ch: *sequence(Change))
  local tab = o.expand_tabs and 1 or o.tabsize
  local gutter = 3
  local offset = o.width // 2 + (tab + gutter) // 2 + (o.width & (tab + gutter) & 1)
  offset = offset - offset % tab
  local half = 0
  if gutter < offset and offset < o.width then
    local left, available = offset - gutter, o.width - offset
    half = left < available and left or available
  end
  local right = half == 0 and o.width or offset

  local i, j = 0, 0
  for k = 1, #ch + 1 do
    local c: Change
    if k <= #ch then
      c = ch[k]
      if c.ignore then continue end
    else
      c.line0 = #a.lines
      c.line1 = #b.lines
    end
    if not o.suppress_common then
      if not o.left_column then
        while i < c.line0 and j < c.line1 do
          side_row(o, a, b, i, j, 32, half, right)
          i = i + 1; j = j + 1
        end
        for n = j, < c.line1 do side_row(o, a, b, -1, n, 41, half, right) end
      end
      for n = i, < c.line0 do side_row(o, a, b, n, -1, 40, half, right) end
    end
    i, j = c.line0, c.line1
    local end0, end1 = i + c.deleted, j + c.inserted
    while i < end0 and j < end1 do
      side_row(o, a, b, i, j, 124, half, right)
      i = i + 1; j = j + 1
    end
    for n = j, < end1 do side_row(o, a, b, -1, n, 62, half, right) end
    for n = i, < end0 do side_row(o, a, b, n, -1, 60, half, right) end
    i, j = end0, end1
  end
end

----------------------------------------------------------------------
-- Comparing
----------------------------------------------------------------------

local Kind = @enum{ NONE = 0, FILE, DIR, OTHER }

local function kind_of(path: string, st: *sys.Stat): Kind
  if sys.stat(path, st) ~= 0 then return Kind.NONE end
  local m = st.st_mode & sys.S_IFMT
  if m == sys.S_IFDIR then return Kind.DIR end
  if m == sys.S_IFREG then return Kind.FILE end
  return Kind.OTHER
end

local function type_name(k: Kind, st: *sys.Stat): string
  if k == Kind.DIR then return 'directory' end
  if k == Kind.FILE then return st.st_size == 0 and 'regular empty file' or 'regular file' end
  return 'special file'
end

-- Returns 0 same, 1 different, 2 trouble.
local function diff_files(o: *Opt, p0: string, p1: string, header: boolean): integer
  local a: DFile
  local b: DFile
  local ok0, ok1 = true, true
  local st: sys.Stat
  if o.new_file and p0 ~= '-' and kind_of(p0, &st) == Kind.NONE then empty_file(p0, &a)
  else ok0 = load(p0, p0, &a) end
  if o.new_file and p1 ~= '-' and kind_of(p1, &st) == Kind.NONE then empty_file(p1, &b)
  else ok1 = load(p1, p1, &b) end
  if not ok0 or not ok1 then return 2 end
  -- ed scripts compare the files as if the final newline were there (GNU
  -- supplies it for output styles that cannot show its absence)
  if o.fmt == 101 then a.incomplete = false; b.incomplete = false end
  if a.data == b.data then
    local no_changes: sequence(Change)
    if not o.brief then
      if o.fmt == 'D'_b then print_merged(o, &a, &b, &no_changes)
      elseif o.fmt == 'y'_b then print_side(o, &a, &b, &no_changes) end
    end
    if o.same then util.writef('Files %s and %s are identical\n', p0, p1) end
    return 0
  end
  if not o.text and (has_nul(a.data) or has_nul(b.data)) then
    util.writef('Binary files %s and %s differ\n', p0, p1)
    return 1
  end
  local horizon = (o.fmt == 99 or o.fmt == 117) and o.context or 0
  local ch = analyze(o, &a, &b, horizon)
  local any = false
  for k = 1, #ch do if not ch[k].ignore then any = true; break end end
  -- an ed script cannot express a missing final newline (GNU: status 2)
  local ed_trouble = o.fmt == 101 and not o.brief and (a.missing_nl or b.missing_nl)
  if not any and ed_trouble then
    if a.missing_nl then util.err(a.name .. ': No newline at end of file\n') end
    if b.missing_nl then util.err(b.name .. ': No newline at end of file\n') end
    return 2
  end
  if not any then
    if not o.brief then
      if o.fmt == 'D'_b then print_merged(o, &a, &b, &ch)
      elseif o.fmt == 'y'_b then print_side(o, &a, &b, &ch) end
    end
    if o.same then util.writef('Files %s and %s are identical\n', p0, p1) end
    return 0
  end
  if o.brief then
    util.writef('Files %s and %s differ\n', p0, p1)
    return 1
  end
  if header then util.writef('diff%s %s %s\n', o.switches, p0, p1) end
  if o.fmt == 117 then
    print_file_header(o, '--- ', &a, 1)
    print_file_header(o, '+++ ', &b, 2)
    print_unified(o, &a, &b, &ch)
  elseif o.fmt == 'D'_b then
    print_merged(o, &a, &b, &ch)
  elseif o.fmt == 'R'_b then
    print_rcs(&b, &ch)
  elseif o.fmt == 'y'_b then
    print_side(o, &a, &b, &ch)
  elseif o.fmt == 99 then
    print_file_header(o, '*** ', &a, 1)
    print_file_header(o, '--- ', &b, 2)
    print_context(o, &a, &b, &ch)
  elseif o.fmt == 101 then
    ed_mode = true
    print_ed(&a, &b, &ch)
    ed_mode = false
    if a.missing_nl then util.err(a.name .. ': No newline at end of file\n') end
    if b.missing_nl then util.err(b.name .. ': No newline at end of file\n') end
    if ed_trouble then return 2 end
  else
    print_normal(&a, &b, &ch)
  end
  return 1
end

local function excluded(o: *Opt, name: string): boolean
  for i = 1, #o.excludes do
    if fnmatch.match(o.excludes[i], name, 0) == 0 then return true end
  end
  return false
end

local function read_excludes(o: *Opt, path: string): boolean
  local data, ok = util.readfile(path)
  if not ok then return false end
  for _, line in ipairs(util.lines(data)) do
    local last = #line
    while last > 0 and is_space(line:byte(last)) do last = last - 1 end
    if last > 0 then o.excludes:push(line:subview(1, last)) end
  end
  return true
end

local function diff_dirs(o: *Opt, d0: string, d1: string): integer
  local n0, ok0 = util.readnames(d0, true)
  local n1, ok1 = util.readnames(d1, true)
  if not ok0 then util.perror(d0); return 2 end
  if not ok1 then util.perror(d1); return 2 end
  local names: sequence(string)
  local seen: hashmap(string, integer)
  for _, n in ipairs(n0) do if n ~= '.' and n ~= '..' then seen[n] = 1; names:push(n) end end
  for _, n in ipairs(n1) do
    if n ~= '.' and n ~= '..' then
      local p = seen:peek(n)
      if p == nilptr then seen[n] = 2; names:push(n) else $p = 3 end
    end
  end
  util.sort(names, util.name_less)
  local rc = 0
  for _, n in ipairs(names) do
    if excluded(o, n) then continue end
    local where = seen[n]
    local p0, p1 = util.join(d0, n), util.join(d1, n)
    local st0: sys.Stat
    local st1: sys.Stat
    local k0, k1 = kind_of(p0, &st0), kind_of(p1, &st1)
    local r = 0
    if where ~= 3 and not o.new_file then
      util.writef('Only in %s: %s\n', where == 1 and d0 or d1, n)
      r = 1
    elseif where ~= 3 and (k0 == Kind.DIR or k1 == Kind.DIR) then
      -- -N with a directory on one side: GNU recurses against nothing; report it
      util.writef('Only in %s: %s\n', where == 1 and d0 or d1, n)
      r = 1
    elseif k0 == Kind.DIR and k1 == Kind.DIR then
      if o.recursive then r = diff_dirs(o, p0, p1)
      else util.writef('Common subdirectories: %s and %s\n', p0, p1) end
    elseif (k0 == Kind.DIR) ~= (k1 == Kind.DIR) then
      util.writef('File %s is a %s while file %s is a %s\n', p0, type_name(k0, &st0), p1, type_name(k1, &st1))
      r = 1
    else
      r = diff_files(o, p0, p1, true)
    end
    if r > rc then rc = r end
  end
  return rc
end

local LONGOPTS: []util.LongOpt = {
  {'text', 0, 'a'_b}, {'ignore-space-change', 0, 'b'_b}, {'ignore-blank-lines', 0, 'B'_b},
  {'context', 2, 'C'_b}, {'ed', 0, 'e'_b}, {'show-function-line', 1, 'F'_b},
  {'ignore-case', 0, 'i'_b}, {'ignore-matching-lines', 1, 'I'_b}, {'label', 1, 'L'_b},
  {'new-file', 0, 'N'_b}, {'normal', 0, 128}, {'show-c-function', 0, 'p'_b},
  {'brief', 0, 'q'_b}, {'recursive', 0, 'r'_b}, {'report-identical-files', 0, 's'_b},
  {'unified', 2, 'U'_b}, {'ignore-all-space', 0, 'w'_b},
  {'strip-trailing-cr', 0, util.UNSUPPORTED}, {'ignore-tab-expansion', 0, util.UNSUPPORTED},
  {'ignore-trailing-space', 0, util.UNSUPPORTED}, {'ignore-file-name-case', 0, util.UNSUPPORTED},
  {'no-ignore-file-name-case', 0, util.UNSUPPORTED}, {'exclude', 1, 'x'_b},
  {'exclude-from', 1, 'X'_b}, {'from-file', 1, util.UNSUPPORTED},
  {'to-file', 1, util.UNSUPPORTED}, {'starting-file', 1, util.UNSUPPORTED},
  {'side-by-side', 0, 'y'_b}, {'width', 1, 'W'_b},
  {'left-column', 0, 129}, {'suppress-common-lines', 0, 130},
  {'expand-tabs', 0, 't'_b}, {'initial-tab', 0, util.UNSUPPORTED},
  {'tabsize', 1, 131}, {'suppress-blank-empty', 0, util.UNSUPPORTED},
  {'paginate', 0, util.UNSUPPORTED}, {'no-dereference', 0, util.UNSUPPORTED},
  {'unidirectional-new-file', 0, util.UNSUPPORTED}, {'ifdef', 1, 'D'_b},
  {'minimal', 0, util.UNSUPPORTED}, {'horizon-lines', 1, util.UNSUPPORTED},
  {'speed-large-files', 0, util.UNSUPPORTED}, {'rcs', 0, 'n'_b},
  {'old-line-format', 1, 132}, {'new-line-format', 1, 133},
  {'unchanged-line-format', 1, 134}, {'line-format', 1, 135},
  {'old-group-format', 1, 136}, {'new-group-format', 1, 137},
  {'unchanged-group-format', 1, 138}, {'changed-group-format', 1, 139},
  {'color', 2, util.UNSUPPORTED}, {'palette', 1, util.UNSUPPORTED},
  {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
}

local function add_rule(rules: *sequence(regex.Prog), pat: string): boolean
  local re, err = regex.compile_posix(pat, false, false, false, false, 0)
  if err.size > 0 then util.err(err); return false end
  rules:push(re)
  return true
end

local function set_template(p: *string, present: *boolean, option: string, value: string): boolean
  if $present and $p ~= value then
    util.err('conflicting ' .. option .. ' option value ' .. util.quote(value))
    util.err("Try 'diff --help' for more information.")
    return false
  end
  $p = value
  $present = true
  return true
end

local function set_ifdef(o: *Opt, name: string): boolean
  local endif = '#endif /* ' .. name .. ' */\n'
  local old = '#ifndef ' .. name .. '\n%<'
  local option = '-D'
  return set_template(&o.formats.group[0], &o.group_format_set[0], option,
                      old .. '#endif /* ! ' .. name .. ' */\n')
     and set_template(&o.formats.group[1], &o.group_format_set[1], option, '#ifdef ' .. name .. '\n%>' .. endif)
     and set_template(&o.formats.group[3], &o.group_format_set[3], option,
                      old .. '#else /* ' .. name .. ' */\n%>' .. endif)
end

local function default_templates(o: *Opt)
  for i = 0, 2 do if not o.line_format_set[i] then o.formats.line[i] = '%l\n' end end
  if not o.group_format_set[0] then o.formats.group[0] = o.group_format_set[3] and o.formats.group[3] or '%<' end
  if not o.group_format_set[1] then o.formats.group[1] = o.group_format_set[3] and o.formats.group[3] or '%>' end
  if not o.group_format_set[2] then o.formats.group[2] = '%=' end
  if not o.group_format_set[3] then o.formats.group[3] = o.formats.group[0] .. o.formats.group[1] end
end

-- Directory headers quote each command-line option as a shell word.
local function write_switch(sb: *stringbuilder, word: string)
  sb:writebyte(32)
  local plain = #word > 0
  for i = 1, #word do
    local c = word:byte(i)
    if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
       or c == 43 or c == 45 or c == 46 or c == 47 or c == 95 then continue end
    plain = false
    break
  end
  if plain then sb:write(word); return end
  sb:writebyte(39)
  for i = 1, #word do
    local c = word:byte(i)
    if c == 39 then sb:write("'\\''") else sb:writebyte(c) end
  end
  sb:writebyte(39)
end

global function applet_diff(args: sequence(string)): integer
  local g = util.getopt(args, 'abBcC:D:eiI:F:L:nNpqrstuU:W:wx:X:y', &LONGOPTS[0], #LONGOPTS)
  local opt: Opt = {context = 3, width = 130, tabsize = 8}
  local sw: stringbuilder
  local last_switch = 0
  local c_function = false
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 63 then return 2 end
    if c == util.UNSUPPORTED then util.err("option '--" .. g.longname .. "' is not supported"); return 2 end
    -- getopt retains each option's input index, including for clusters and
    -- options that followed an operand before permutation.
    for i = g.arg_index, < g.optind do
      if i > last_switch then write_switch(&sw, args[i]); last_switch = i end
    end
    local fmt: byte = 0
    if c == 'c'_b or c == 'C'_b then fmt = 'c'_b
    elseif c == 'u'_b or c == 'U'_b then fmt = 'u'_b
    elseif c == 'e'_b then fmt = 'e'_b
    elseif c == 'y'_b then fmt = 'y'_b
    elseif c == 'n'_b then fmt = 'R'_b
    elseif c == 'x'_b then opt.excludes:push(g.optarg)
    elseif c == 'X'_b then
      if not read_excludes(&opt, g.optarg) then return 2 end
    elseif c == 'D'_b then
      fmt = 'D'_b
      if not set_ifdef(&opt, g.optarg) then return 2 end
    elseif c >= 132 and c <= 139 then
      fmt = 'D'_b
      local option = '--' .. g.longname
      if c >= 136 then
        if not set_template(&opt.formats.group[c - 136], &opt.group_format_set[c - 136], option, g.optarg) then return 2 end
      else
        local first = c == 135 and 0 or c - 132
        local last = c == 135 and 2 or first
        for i = first, last do
          if not set_template(&opt.formats.line[i], &opt.line_format_set[i], option, g.optarg) then return 2 end
        end
      end
    elseif c == 128 then fmt = 'n'_b
    elseif c == 129 then opt.left_column = true
    elseif c == 130 then opt.suppress_common = true
    elseif c == 't'_b then opt.expand_tabs = true
    elseif c == 'W'_b or c == 131 then
      local positive, ok = util.toint(g.optarg)
      local label = c == 'W'_b and 'width' or 'tab size'
      if not ok or positive <= 0 or positive > 0x7ffffffffffffffc then
        util.err('invalid ' .. label .. ' ' .. util.quote(g.optarg)); return 2
      end
      if c == 'W'_b then opt.width = positive else opt.tabsize = positive end
    elseif c == 'a'_b then opt.text = true
    elseif c == 'b'_b then opt.space_change = true
    elseif c == 'B'_b then opt.blank_lines = true
    elseif c == 'i'_b then opt.icase = true
    elseif c == 'w'_b then opt.all_space = true
    elseif c == 'N'_b then opt.new_file = true
    elseif c == 'p'_b then
      c_function = true
      if not add_rule(&opt.function_rules, '^[[:alpha:]$_]') then return 2 end
    elseif c == 'q'_b then opt.brief = true
    elseif c == 'r'_b then opt.recursive = true
    elseif c == 's'_b then opt.same = true
    elseif c == 'I'_b then
      if not add_rule(&opt.ignore_rules, g.optarg) then return 2 end
    elseif c == 'F'_b then
      if not add_rule(&opt.function_rules, g.optarg) then return 2 end
    elseif c == 'L'_b then
      if #opt.labels == 2 then util.err('too many file label options'); return 2 end
      opt.labels:push(g.optarg)
    end
    if fmt ~= 0 then
      if opt.fmt ~= 0 and opt.fmt ~= fmt then
        util.err('conflicting output style options')
        util.err("Try 'diff --help' for more information.")
        return 2
      end
      opt.fmt = fmt
      opt.context = 3
      if (fmt == 'u'_b or fmt == 'c'_b) and g.has_optarg then
        local v, ok = util.toint(g.optarg)
        if not ok or v < 0 then util.err('invalid context length ' .. util.quote(g.optarg)); return 2 end
        opt.context = v
      end
    end
  end
  opt.switches = sw:promote()
  if opt.fmt == 0 then opt.fmt = c_function and 'c'_b or 'n'_b end
  if opt.fmt == 'D'_b then default_templates(&opt) end
  if opt.fmt ~= 'y'_b and opt.expand_tabs then
    util.err('tab expansion is only supported for side-by-side output'); return 2
  end
  local operands = g:operands()
  if #operands ~= 2 then
    if #operands < 2 then
      util.err(#operands == 0 and 'missing operand' or ('missing operand after ' .. util.quote(operands[1])))
    else
      util.err('extra operand ' .. util.quote(operands[3]))
    end
    return 2
  end
  local p0, p1 = operands[1], operands[2]
  local st0: sys.Stat
  local st1: sys.Stat
  local k0 = p0 == '-' and Kind.FILE or kind_of(p0, &st0)
  local k1 = p1 == '-' and Kind.FILE or kind_of(p1, &st1)
  if k0 == Kind.DIR and k1 == Kind.DIR then
    return diff_dirs(&opt, p0, p1)
  end
  -- a directory and a file: compare with the file of the same name in it
  if k0 == Kind.DIR then p0 = util.join(p0, util.basename(p1)) end
  if k1 == Kind.DIR then p1 = util.join(p1, util.basename(p0)) end
  return diff_files(&opt, p0, p1, false)
end
