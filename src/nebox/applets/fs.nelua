-- Filesystem applets: ls mkdir rmdir rm touch cp mv ln readlink pwd basename
-- dirname chmod test
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.modechange'
require 'nebox.longopts'
require 'nebox.clock'

local function digits(v: integer): integer
  local n: integer = 1
  while v >= 10 do v = v // 10; n = n + 1 end
  return n
end

-- ls follows GNU ls 9.1 (ls.c) in the C locale: output formats, column
-- layout (calculate_columns), field widths per listing, sort keys, indicators.
local LS_LONG <comptime> = 0
local LS_ONE <comptime> = 1
local LS_VERT <comptime> = 2   -- -C
local LS_HORIZ <comptime> = 3  -- -x
local LS_COMMAS <comptime> = 4 -- -m
local SORT_NAME <comptime> = 0
local SORT_TIME <comptime> = 1
local SORT_SIZE <comptime> = 2
local SORT_EXT <comptime> = 3
local SORT_VER <comptime> = 4
local IND_NONE <comptime> = 0
local IND_SLASH <comptime> = 1    -- -p
local IND_CLASSIFY <comptime> = 2 -- -F
local LS_UNLIMITED <comptime> = 0x1000000000000000

local LsEnt = @record{
  name: string,   -- as shown (after -q)
  key: string,    -- the real name, for sorting
  path: string,
  st: sys.Stat,
  ok: boolean,    -- st is valid
  link: string,   -- symlink target, long format only
  linkmode: cuint -- mode of the target, -lF only (0 if unknown)
}

-- Column widths, computed per listing as GNU ls does.
local LsW = @record{inode: integer, blocks: integer, nlink: integer, uid: integer, gid: integer,
  size: integer, major: integer, minor: integer}

local Ls = @record{
  format: integer, indicator: integer, sortby: integer, timekind: integer,
  all: boolean, almost: boolean, recursive: boolean, reverse: boolean, human: boolean,
  inode: boolean, blocks: boolean, numeric: boolean, showowner: boolean, showgroup: boolean,
  dironly: boolean, qmark: boolean, nobackups: boolean,
  ignores: sequence(string),
  linelen: integer, tabsize: integer,
  first: boolean, rc: integer,
}

local function ls_major(d: culong): integer return (@integer)(((d >> 8) & 0xfff) | ((d >> 32) & ~(@culong)(0xfff))) end
local function ls_minor(d: culong): integer return (@integer)((d & 0xff) | ((d >> 12) & ~(@culong)(0xff))) end

local function isdev(m: cuint): boolean
  local k = m & sys.S_IFMT
  return k == sys.S_IFCHR or k == sys.S_IFBLK
end

-- Display width in the C locale: non-printable bytes take no column.
local function ls_width(s: string): integer
  local n: integer = 0
  for i: usize = 0, < s.size do
    local b = s.data[i]
    if b >= 32 and b < 127 then n = n + 1 end
  end
  return n
end

local function ls_qmark(s: string): string
  local sb: stringbuilder
  for i: usize = 0, < s.size do
    local b = s.data[i]
    if b >= 32 and b < 127 then sb:writebyte(b) else sb:writebyte(63) end
  end
  return sb:promote()
end

local function wleft(s: string, w: integer) -- right-aligned
  for _ = (@integer)(s.size) + 1, w do util.writebyte(32) end
  util.write(s)
end

local function wright(s: string, w: integer) -- left-aligned
  util.write(s)
  for _ = ls_width(s) + 1, w do util.writebyte(32) end
end

function Ls:time(st: *sys.Stat): sys.Timespec
  if self.timekind == 1 then return st.st_ctim elseif self.timekind == 2 then return st.st_atim end
  return st.st_mtim
end

function Ls:blockstr(nblocks: integer): string
  if self.human then return util.human(nblocks * 512) end
  return string.format('%d', (nblocks + 1) // 2)
end

function Ls:owner(st: *sys.Stat): (string, string)
  if self.numeric then return string.format('%d', st.st_uid), string.format('%d', st.st_gid) end
  return util.idname(util.username((@integer)(st.st_uid)), (@integer)(st.st_uid)),
         util.idname(util.groupname((@integer)(st.st_gid)), (@integer)(st.st_gid))
end

function Ls:sizestr(st: *sys.Stat): string
  if self.human then return util.human((@integer)(st.st_size)) end
  return string.format('%d', (@integer)(st.st_size))
end

function Ls:widths(ents: sequence(LsEnt)): LsW
  local w: LsW
  for _, e in ipairs(ents) do
    if not e.ok then continue end
    local st = &e.st
    if self.inode then local d = digits((@integer)(st.st_ino)); if d > w.inode then w.inode = d end end
    if self.format == LS_LONG or self.blocks then
      local d = (@integer)(self:blockstr((@integer)(st.st_blocks)).size); if d > w.blocks then w.blocks = d end
    end
    if self.format == LS_LONG then
      local d = digits((@integer)(st.st_nlink)); if d > w.nlink then w.nlink = d end
      local u, g = self:owner(st)
      d = ls_width(u); if d > w.uid then w.uid = d end
      d = ls_width(g); if d > w.gid then w.gid = d end
      if isdev(st.st_mode) then
        local ma, mi = digits(ls_major(st.st_rdev)), digits(ls_minor(st.st_rdev))
        if ma > w.major then w.major = ma end
        if mi > w.minor then w.minor = mi end
        d = w.major + 2 + w.minor
      else
        d = (@integer)(self:sizestr(st).size)
      end
      if d > w.size then w.size = d end
    end
  end
  return w
end

-- GNU get_type_indicator; 0 for none.
function Ls:indicatorof(mode: cuint): byte
  if self.indicator == IND_NONE then return 0 end
  local k = mode & sys.S_IFMT
  if k == sys.S_IFREG then
    if self.indicator == IND_CLASSIFY and (mode & 0x49) ~= 0 then return 42 end
    return 0
  end
  if k == sys.S_IFDIR then return 47 end
  if self.indicator == IND_SLASH then return 0 end
  if k == sys.S_IFLNK then return 64 end
  if k == sys.S_IFIFO then return 124 end
  if k == sys.S_IFSOCK then return 61 end
  return 0
end

-- Width of an entry with its inode, block count and indicator.
function Ls:frills(e: *LsEnt, w: *LsW): integer
  local len: integer = 0
  local commas = self.format == LS_COMMAS
  if self.inode then len = len + 1 + (commas and digits((@integer)(e.st.st_ino)) or w.inode) end
  if self.blocks then len = len + 1 + (commas and (@integer)(self:blockstr((@integer)(e.st.st_blocks)).size) or w.blocks) end
  len = len + ls_width(e.name)
  if e.ok and self:indicatorof(e.st.st_mode) ~= 0 then len = len + 1 end
  return len
end

function Ls:printname(e: *LsEnt, w: *LsW)
  local commas = self.format == LS_COMMAS
  if self.inode then wleft(string.format('%d', e.st.st_ino), commas and 0 or w.inode); util.writebyte(32) end
  if self.blocks then wleft(self:blockstr((@integer)(e.st.st_blocks)), commas and 0 or w.blocks); util.writebyte(32) end
  util.write(e.name)
  if e.ok then
    local c = self:indicatorof(e.st.st_mode)
    if c ~= 0 then util.writebyte(c) end
  end
end

function Ls:indent(from: integer, to: integer)
  while from < to do
    if self.tabsize ~= 0 and to // self.tabsize > (from + 1) // self.tabsize then
      util.writebyte(9); from = from + self.tabsize - from % self.tabsize
    else
      util.writebyte(32); from = from + 1
    end
  end
end

function Ls:long(e: *LsEnt, w: *LsW)
  local st = &e.st
  if self.inode then wleft(string.format('%d', st.st_ino), w.inode); util.writebyte(32) end
  if self.blocks then wleft(self:blockstr((@integer)(st.st_blocks)), w.blocks); util.writebyte(32) end
  util.write(util.modestr(st.st_mode)); util.writebyte(32)
  wleft(string.format('%d', (@integer)(st.st_nlink)), w.nlink); util.writebyte(32)
  local u, g = self:owner(st)
  if self.showowner then wright(u, w.uid); util.writebyte(32) end
  if self.showgroup then wright(g, w.gid); util.writebyte(32) end
  if isdev(st.st_mode) then
    local blanks = w.size - (w.major + 2 + w.minor)
    if blanks < 0 then blanks = 0 end
    wleft(string.format('%d', ls_major(st.st_rdev)), w.major + blanks); util.write(', ')
    wleft(string.format('%d', ls_minor(st.st_rdev)), w.minor)
  else
    wleft(self:sizestr(st), w.size)
  end
  util.writebyte(32)
  -- GNU: the time of day for the past six months (half of 365.2425 days),
  -- the year for anything older or in the future
  local now: sys.Timespec
  sys.clock_gettime(sys.CLOCK_REALTIME, &now)
  local t = self:time(st)
  local ms, mn = t.tv_sec, t.tv_nsec
  local hs = now.tv_sec - 15778476
  local recent = (hs < ms or (hs == ms and now.tv_nsec < mn)) and
    (ms < now.tv_sec or (ms == now.tv_sec and mn < now.tv_nsec))
  util.write(util.timefmt(ms, recent and '%b %e %H:%M' or '%b %e  %Y'))
  util.writebyte(32)
  util.write(e.name)
  if (st.st_mode & sys.S_IFMT) == sys.S_IFLNK then
    util.write(' -> '); util.write(e.link)
    if self.indicator == IND_CLASSIFY and e.linkmode ~= 0 then
      local c = self:indicatorof(e.linkmode)
      if c ~= 0 then util.writebyte(c) end
    end
  else
    local c = self:indicatorof(st.st_mode)
    if c ~= 0 then util.writebyte(c) end
  end
  util.writebyte(10)
end

-- GNU sort functions; ties go to the name, and -r reverses the whole order.
function Ls:cmp(a: *LsEnt, b: *LsEnt): integer
  if self.reverse then a, b = b, a end
  local r: integer = 0
  if self.sortby == SORT_TIME then
    local ta, tb = self:time(&a.st), self:time(&b.st)
    if ta.tv_sec ~= tb.tv_sec then r = ta.tv_sec > tb.tv_sec and -1 or 1
    elseif ta.tv_nsec ~= tb.tv_nsec then r = ta.tv_nsec > tb.tv_nsec and -1 or 1 end
  elseif self.sortby == SORT_SIZE then
    if a.st.st_size ~= b.st.st_size then r = a.st.st_size > b.st.st_size and -1 or 1 end
  elseif self.sortby == SORT_EXT then
    local ea, eb: string = '', ''
    for i = (@isize)(a.key.size), 1, -1 do if a.key:byte(i) == 46 then ea = a.key:sub(i) break end end
    for i = (@isize)(b.key.size), 1, -1 do if b.key:byte(i) == 46 then eb = b.key:sub(i) break end end
    if ea < eb then r = -1 elseif eb < ea then r = 1 end
  elseif self.sortby == SORT_VER then
    r = filevercmp(a.key, b.key)
  end
  if r == 0 then
    if a.key < b.key then r = -1 elseif b.key < a.key then r = 1 end
  end
  return r
end

-- Stable merge sort of entry indexes.
function Ls:order(ents: sequence(LsEnt)): sequence(integer)
  local idx: sequence(integer)
  local tmp: sequence(integer)
  local n = #ents
  for i = 1, n do idx:push(i); tmp:push(i) end
  local width: integer = 1
  while width < n do
    local lo: integer = 1
    while lo <= n do
      local mid = lo + width
      local hi = lo + 2 * width
      if mid > n + 1 then mid = n + 1 end
      if hi > n + 1 then hi = n + 1 end
      local i, j, k = lo, mid, lo
      while i < mid and j < hi do
        if self:cmp(&ents[idx[j]], &ents[idx[i]]) < 0 then tmp[k] = idx[j]; j = j + 1
        else tmp[k] = idx[i]; i = i + 1 end
        k = k + 1
      end
      while i < mid do tmp[k] = idx[i]; i = i + 1; k = k + 1 end
      while j < hi do tmp[k] = idx[j]; j = j + 1; k = k + 1 end
      lo = hi
    end
    idx, tmp = tmp, idx
    width = width * 2
  end
  return idx
end

-- GNU calculate_columns, print_many_per_line and print_horizontal.
function Ls:columns(ents: sequence(LsEnt), order: sequence(integer), w: *LsW, bycols: boolean)
  local n = #order
  if n == 0 then return end
  local lens: sequence(integer)
  for k = 1, n do lens:push(self:frills(&ents[order[k]], w)) end
  local maxidx = self.linelen // 3 + (self.linelen % 3 ~= 0 and 1 or 0)
  local maxcols = (maxidx > 0 and maxidx < n) and maxidx or n
  local valid: sequence(boolean)
  local linelen: sequence(integer)
  local base: sequence(integer)
  local arr: sequence(integer)
  for i = 0, maxcols - 1 do
    valid:push(true); linelen:push((i + 1) * 3); base:push(#arr)
    for _ = 0, i do arr:push(3) end
  end
  for f = 0, n - 1 do
    local len = lens[f + 1]
    for i = 0, maxcols - 1 do
      if valid[i + 1] then
        local idx: integer
        if bycols then idx = f // ((n + i) // (i + 1)) else idx = f % (i + 1) end
        local real = len + (idx == i and 0 or 2)
        local slot = base[i + 1] + idx + 1
        if arr[slot] < real then
          linelen[i + 1] = linelen[i + 1] + real - arr[slot]
          arr[slot] = real
          valid[i + 1] = linelen[i + 1] < self.linelen
        end
      end
    end
  end
  local cols = maxcols
  while cols > 1 and not valid[cols] do cols = cols - 1 end
  local b = base[cols]
  if bycols then
    local rows = n // cols + (n % cols ~= 0 and 1 or 0)
    for row = 0, rows - 1 do
      local col: integer = 0
      local f = row
      local pos: integer = 0
      while true do
        local maxw = arr[b + col + 1]
        col = col + 1
        self:printname(&ents[order[f + 1]], w)
        local len = lens[f + 1]
        f = f + rows
        if f >= n then break end
        self:indent(pos + len, pos + maxw)
        pos = pos + maxw
      end
      util.writebyte(10)
    end
  else
    local pos: integer = 0
    self:printname(&ents[order[1]], w)
    local len = lens[1]
    local maxw = arr[b + 1]
    for f = 1, n - 1 do
      local col = f % cols
      if col == 0 then util.writebyte(10); pos = 0
      else self:indent(pos + len, pos + maxw); pos = pos + maxw end
      self:printname(&ents[order[f + 1]], w)
      len = lens[f + 1]
      maxw = arr[b + col + 1]
    end
    util.writebyte(10)
  end
end

function Ls:print(ents: sequence(LsEnt), order: sequence(integer), w: *LsW)
  if self.format == LS_LONG then
    for _, i in ipairs(order) do self:long(&ents[i], w) end
  elseif self.format == LS_ONE then
    for _, i in ipairs(order) do self:printname(&ents[i], w); util.writebyte(10) end
  elseif self.format == LS_COMMAS then
    if #order == 0 then return end
    local pos: integer = 0
    for k, i in ipairs(order) do
      local len = self:frills(&ents[i], w)
      if k > 1 then
        util.writebyte(44)
        if pos + len + 2 < self.linelen then pos = pos + 2; util.writebyte(32)
        else pos = 0; util.writebyte(10) end
      end
      self:printname(&ents[i], w)
      pos = pos + len
    end
    util.writebyte(10)
  else
    self:columns(ents, order, w, self.format == LS_VERT)
  end
end

-- Symlink target text (long format) and, for -lF, the target's mode.
function Ls:linkinfo(e: *LsEnt)
  if self.format ~= LS_LONG or (e.st.st_mode & sys.S_IFMT) ~= sys.S_IFLNK then return end
  local buf: [4096]byte
  local n = sys.readlink(e.path, &buf[0], #buf)
  if n < 0 then return end
  local target = string.copy((@string){data=&buf[0], size=(@usize)(n)})
  e.link = self.qmark and ls_qmark(target) or target
  if self.indicator == IND_CLASSIFY then
    local full = target
    if target.size == 0 or target:byte(1) ~= 47 then
      local slash: isize = 0
      for i = (@isize)(e.path.size), 1, -1 do if e.path:byte(i) == 47 then slash = i break end end
      if slash > 0 then full = e.path:sub(1, slash) .. target end
    end
    local ts: sys.Stat
    if sys.stat(full, &ts) == 0 then e.linkmode = ts.st_mode end
  end
end

function Ls:ignored(name: string): boolean
  if name:byte(1) == 46 then
    if not self.all then return true end
    if self.almost and (name == '.' or name == '..') then return true end
  end
  if self.nobackups and name:byte(name.size) == 126 then return true end
  for _, p in ipairs(self.ignores) do
    -- fnmatch with FNM_PERIOD: a leading '.' must be matched literally
    if name:byte(1) == 46 and p:byte(1) ~= 46 then continue end
    if util.glob(p, name, false) then return true end
  end
  return false
end

function Ls:needstat(): boolean
  return self.format == LS_LONG or self.inode or self.blocks or self.indicator ~= IND_NONE or
    self.sortby == SORT_TIME or self.sortby == SORT_SIZE or self.recursive
end

function Ls:listdir(dir: string, label: boolean)
  local names, ok = util.readnames(dir, true)
  if not ok then util.err("cannot open directory '" .. dir .. "': " .. sys.errstr()); self.rc = 2; return end
  if label then
    if not self.first then util.writebyte(10) end
    self.first = false
    util.write(dir); util.line(':')
  end
  local ents: sequence(LsEnt)
  local need = self:needstat()
  for _, n in ipairs(names) do
    if self:ignored(n) then continue end
    local e: LsEnt = {name = self.qmark and ls_qmark(n) or n, key = n, path = util.join(dir, n), ok = true}
    if sys.lstat(e.path, &e.st) ~= 0 then
      if need then
        util.err("cannot access '" .. e.path .. "': " .. sys.errstr()); if self.rc == 0 then self.rc = 1 end
        continue
      end
      -- a plain listing needs only the name of an entry that vanished
      -- after it was read, as coreutils ls (which does not stat) prints it
      e.st = (@sys.Stat)(); e.ok = false
    end
    self:linkinfo(&e)
    ents:push(e)
  end
  if self.format == LS_LONG or self.blocks then
    local total: integer = 0
    for _, e in ipairs(ents) do if e.ok then total = total + (@integer)(e.st.st_blocks) end end
    util.write('total '); util.line(self:blockstr(total))
  end
  local w = self:widths(ents)
  local order = self:order(ents)
  self:print(ents, order, &w)
  if self.recursive then
    for _, i in ipairs(order) do
      local e = &ents[i]
      if e.ok and (e.st.st_mode & sys.S_IFMT) == sys.S_IFDIR and e.key ~= '.' and e.key ~= '..' then
        self:listdir(e.path, true)
      end
    end
  end
end

-- strtoumax with base 0 and no trailing characters, as GNU xstrtoumax;
-- returns value, ok, overflowed.
local function ls_number(s: string): (integer, boolean, boolean)
  local i: usize = 1
  while i <= s.size and (s:byte(i) == 32 or (s:byte(i) >= 9 and s:byte(i) <= 13)) do i = i + 1 end
  if i <= s.size and s:byte(i) == 45 then return 0, false, false end
  if i <= s.size and s:byte(i) == 43 then i = i + 1 end
  local base: integer = 10
  if i + 1 <= s.size and s:byte(i) == 48 and (s:byte(i + 1) == 120 or s:byte(i + 1) == 88) and i + 2 <= s.size then
    local c = s:byte(i + 2)
    if (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70) then base = 16; i = i + 2 end
  end
  if base == 10 and i <= s.size and s:byte(i) == 48 then base = 8 end
  local v: integer = 0
  local any, over = false, false
  while i <= s.size do
    local c = s:byte(i)
    local d: integer = 99
    if c >= 48 and c <= 57 then d = c - 48 elseif c >= 97 and c <= 102 then d = c - 87 elseif c >= 65 and c <= 70 then d = c - 55 end
    if d >= base then break end
    if v > (0x7fffffffffffffff - d) // base then over = true else v = v * base + d end
    any = true
    i = i + 1
  end
  if not any or i <= s.size then return 0, false, false end
  return v, true, over
end

local WinSize = @record{row: cushort, col: cushort, xpixel: cushort, ypixel: cushort}

global function applet_ls(args: sequence(string)): integer
  local ls: Ls = {format = LS_ONE, linelen = -1, tabsize = 8, first = true, showowner = true, showgroup = true}
  if sys.isatty(1) == 1 then ls.format = LS_VERT end
  local operands: sequence(string)
  local sortset = false
  local haveW, haveT = false, false
  local nomore = false
  local i: integer = 1
  while i <= #args do
    local a = args[i]
    if nomore or a.size < 2 or a:byte(1) ~= 45 then
      operands:push(a)
    elseif a == '--' then
      nomore = true
    elseif a:byte(2) == 45 then
      util.err("unrecognized option '" .. a .. "'"); util.err("Try 'ls --help' for more information."); return 2
    else
      local j: usize = 2
      while j <= a.size do
        local c = a:byte(j)
        if c == 119 or c == 84 or c == 73 then -- w T I take a value
          local v: string
          if j < a.size then v = a:sub(j + 1)
          elseif i < #args then i = i + 1; v = args[i]
          else
            util.err("option requires an argument -- '" .. string.char(c) .. "'")
            util.err("Try 'ls --help' for more information."); return 2
          end
          if c == 119 then
            local n, ok, over = ls_number(v)
            if not ok then util.err("invalid line width: '" .. v .. "'"); return 2 end
            ls.linelen = (over or n == 0) and LS_UNLIMITED or n; haveW = true
          elseif c == 84 then
            local n, ok, over = ls_number(v)
            if not ok or over then util.err("invalid tab size: '" .. v .. "'"); return 2 end
            haveT = true; ls.tabsize = n
          else
            ls.ignores:push(v)
          end
          break
        end
        if c == 97 then ls.all = true; ls.almost = false            -- a
        elseif c == 65 then ls.all = true; ls.almost = true          -- A
        elseif c == 66 then ls.nobackups = true                       -- B
        elseif c == 99 then ls.timekind = 1                          -- c
        elseif c == 117 then ls.timekind = 2                         -- u
        elseif c == 67 then ls.format = LS_VERT                      -- C
        elseif c == 120 then ls.format = LS_HORIZ                    -- x
        elseif c == 109 then ls.format = LS_COMMAS                   -- m
        elseif c == 108 then ls.format = LS_LONG                     -- l
        elseif c == 49 then if ls.format ~= LS_LONG then ls.format = LS_ONE end -- 1 (no effect after -l)
        elseif c == 110 then ls.format = LS_LONG; ls.numeric = true  -- n
        elseif c == 103 then ls.format = LS_LONG; ls.showowner = false -- g
        elseif c == 111 then ls.format = LS_LONG; ls.showgroup = false -- o
        elseif c == 71 then ls.showgroup = false                     -- G
        elseif c == 100 then ls.dironly = true                        -- d
        elseif c == 70 then ls.indicator = IND_CLASSIFY              -- F
        elseif c == 112 then ls.indicator = IND_SLASH                -- p
        elseif c == 82 then ls.recursive = true                      -- R
        elseif c == 114 then ls.reverse = true                       -- r
        elseif c == 116 then ls.sortby = SORT_TIME; sortset = true   -- t
        elseif c == 83 then ls.sortby = SORT_SIZE; sortset = true    -- S
        elseif c == 88 then ls.sortby = SORT_EXT; sortset = true     -- X
        elseif c == 118 then ls.sortby = SORT_VER; sortset = true    -- v
        elseif c == 104 then ls.human = true                         -- h
        elseif c == 107 then                                         -- k: 1024-byte blocks, the default here
        elseif c == 105 then ls.inode = true                         -- i
        elseif c == 115 then ls.blocks = true                        -- s
        elseif c == 113 then ls.qmark = true                         -- q
        elseif c == 78 then                                          -- N: literal names, the default here
        else
          util.err("invalid option -- '" .. string.char(c) .. "'")
          util.err("Try 'ls --help' for more information."); return 2
        end
        j = j + 1
      end
    end
    i = i + 1
  end
  if ls.timekind ~= 0 and not sortset and ls.format ~= LS_LONG then ls.sortby = SORT_TIME end
  if ls.format == LS_VERT or ls.format == LS_HORIZ or ls.format == LS_COMMAS then
    if not haveW then
      local p = sys.getenv('COLUMNS')
      if p ~= nilptr then
        local s = string.copy(p)
        if s.size > 0 then
          local n, ok, over = ls_number(s)
          if ok then ls.linelen = (over or n == 0) and LS_UNLIMITED or n
          else util.err("ignoring invalid width in environment variable COLUMNS: '" .. s .. "'") end
        end
      end
      if ls.linelen < 0 then
        local ws: WinSize
        if sys.ioctl(1, 0x5413, &ws) == 0 and ws.col > 0 then ls.linelen = ws.col end
      end
      if ls.linelen < 0 then ls.linelen = 80 end
    end
    -- TABSIZE is read for -C, -x and -m, and only without -T
    if not haveT then
      local p = sys.getenv('TABSIZE')
      if p ~= nilptr then
        local s = string.copy(p)
        local n, ok, over = ls_number(s)
        if ok and not over then
          ls.tabsize = n
        else
          util.err("ignoring invalid tab size in environment variable TABSIZE: '" .. s .. "'")
        end
      end
    end
  end
  if #operands == 0 then operands:push('.') end
  -- Command-line symlinks to directories are followed unless -d, -F or -l.
  local deref = not (ls.dironly or ls.indicator == IND_CLASSIFY or ls.format == LS_LONG)
  local ents: sequence(LsEnt)
  for _, p in ipairs(operands) do
    local e: LsEnt = {name = ls.qmark and ls_qmark(p) or p, key = p, path = p, ok = true}
    local found = false
    if deref and sys.stat(p, &e.st) == 0 and (e.st.st_mode & sys.S_IFMT) == sys.S_IFDIR then found = true end
    if not found and sys.lstat(p, &e.st) ~= 0 then
      util.err("cannot access '" .. p .. "': " .. sys.errstr()); ls.rc = 2
      continue
    end
    ls:linkinfo(&e)
    ents:push(e)
  end
  -- widths cover every operand, directories included, as in GNU ls
  local w = ls:widths(ents)
  local order = ls:order(ents)
  local files: sequence(integer)
  local dirs: sequence(integer)
  for _, k in ipairs(order) do
    if not ls.dironly and (ents[k].st.st_mode & sys.S_IFMT) == sys.S_IFDIR then dirs:push(k) else files:push(k) end
  end
  if #files > 0 then
    ls:print(ents, files, &w)
    if #dirs > 0 then util.writebyte(10) end
  end
  for _, k in ipairs(dirs) do
    ls:listdir(ents[k].path, #operands > 1 or ls.recursive)
  end
  return ls.rc
end

local function mkdir_pv(path: string, mode: cuint, verbose: boolean): boolean
  if util.isdir(path) then return true end
  local parent = util.dirname(path)
  if parent ~= path and parent ~= '.' and parent ~= '/' then
    if not mkdir_pv(parent, mode, verbose) then return false end
  end
  if sys.mkdir(path, mode) ~= 0 then
    if sys.errno() == sys.EEXIST and util.isdir(path) then return true end
    util.err('cannot create directory ' .. util.quoteaf(path) .. ': ' .. sys.errstr())
    return false
  end
  if verbose then util.line(util.applet .. ': created directory ' .. util.quoteaf(path)) end
  return true
end

global function mkdir_p(path: string, mode: cuint): boolean
  return mkdir_pv(path, mode, false)
end

global function parse_mode(s: string): (cuint, boolean)
  if s.size == 0 or s.size > 4 then return 0, false end
  local v: cuint = 0
  for i: usize = 1, s.size do
    local c = s:byte(i)
    if c < 48 or c > 55 then return 0, false end
    v = v * 8 + (c - 48)
  end
  return v, true
end

global function applet_mkdir(args: sequence(string)): integer
  local o = util.parsel(args, 'pm:v', &longopts.mkdir, #longopts.mkdir)
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing operand') end
  local umask_value = sys.umask(0)
  sys.umask(umask_value)
  -- GNU mkdir -m: mode_adjust(0777, dir, umask, MODE); the bits the mode
  -- mentions are set exactly after mkdir(2), whatever the umask did
  local mode: cuint = 0x1FF
  local mode_bits: cuint = 0
  local umask_self = umask_value
  if o:has('m') then
    local ch, ok = modechange.compile(o:get('m'))
    if not ok then return util.die("invalid mode '" .. o:get('m') .. "'") end
    mode, mode_bits = modechange.adjust(0x1FF, true, umask_value, ch)
    umask_self = umask_value & ~mode
  end
  -- ancestors made by -p always get u+wx (GNU's make_ancestor)
  local umask_ancestor: cuint = umask_value & ~(@cuint)(0xC0)
  local rc: integer = 0
  local verbose = o:has('v')
  for _, p in ipairs(o.operands) do
    if o:has('p') then
      if util.isdir(p) then continue end
      local parent = util.dirname(p)
      if parent ~= p and parent ~= '.' and parent ~= '/' then
        sys.umask(umask_ancestor)
        local pok = mkdir_pv(parent, 0x1FF, verbose)
        sys.umask(umask_value)
        if not pok then rc = 1; continue end
      end
    end
    -- gnulib make_dir_parents for the final component: with special mode
    -- bits in play the directory starts without group/other write, and
    -- dirchownmod then sets exactly the bits the mode mentions
    local keep_special = ((mode_bits & 0xC00) | (mode & 0x200)) == 0
    local mkdir_mode = mode
    if not keep_special then mkdir_mode = mkdir_mode & ~(@cuint)(0x12) end
    sys.umask(umask_self)
    local made = sys.mkdir(p, mkdir_mode)
    local merr = sys.errno()
    sys.umask(umask_value)
    sys.seterrno(merr)
    if made ~= 0 then
      if o:has('p') and sys.errno() == sys.EEXIST and util.isdir(p) then continue end
      util.err('cannot create directory ' .. util.quoteaf(p) .. ': ' .. sys.errstr())
      rc = 1
      continue
    end
    if verbose then util.line(util.applet .. ': created directory ' .. util.quoteaf(p)) end
    local umask_must_be_ok = (mode & mode_bits & 0x1FF) == 0
    if not (keep_special and umask_must_be_ok) then
      local st: sys.Stat
      if sys.stat(p, &st) == 0 and ((st.st_mode ~ mode) & mode_bits) ~= 0 then
        local chmod_mode: cuint = mode | (st.st_mode & 0xFFF & ~mode_bits)
        if sys.chmod(p, chmod_mode) ~= 0 then
          util.err('cannot set permissions of ' .. util.quoteaf(p) .. ': ' .. sys.errstr())
          rc = 1
        end
      end
    end
  end
  return rc
end

-- rmdir: GNU coreutils 9.1 rmdir.c (-p, -v, --ignore-fail-on-non-empty).
local rmdir_ignore_nonempty: boolean
local rmdir_verbose: boolean

local function rmdir_is_empty(dir: string): boolean
  local names, ok = util.readnames(dir, true)
  if not ok then return false end
  for _, n in ipairs(names) do
    if n ~= '.' and n ~= '..' then return false end
  end
  return true
end

local function rmdir_ignorable(e: cint, dir: string): boolean
  if not rmdir_ignore_nonempty then return false end
  if e == 39 or e == sys.EEXIST then return true end           -- ENOTEMPTY, EEXIST
  if e == sys.EACCES or e == 1 or e == 30 or e == 16 then      -- EACCES EPERM EROFS EBUSY
    sys.seterrno(0)
    local names, ok = util.readnames(dir, true)
    if not ok then return false end
    local empty = true
    for _, n in ipairs(names) do if n ~= '.' and n ~= '..' then empty = false end end
    return not empty
  end
  return false
end

local function rmdir_strip_slashes(d: string): string
  while #d > 1 and d:byte(#d) == 47 do d = d:sub(1, #d - 1) end
  return d
end

local function rmdir_parents(dir: string): boolean
  dir = rmdir_strip_slashes(dir)
  local ok = true
  while true do
    local slash = 0
    for k = #dir, 1, -1 do if dir:byte(k) == 47 then slash = k; break end end
    if slash == 0 then break end
    while slash > 1 and dir:byte(slash) == 47 do slash = slash - 1 end
    dir = dir:sub(1, slash)
    if rmdir_verbose then util.line('rmdir: removing directory, ' .. util.quoteaf(dir)) end
    ok = sys.rmdir(dir) == 0
    local e = sys.errno()
    if not ok then
      if rmdir_ignorable(e, dir) then ok = true
      elseif e ~= sys.ENOTDIR then util.err('failed to remove directory ' .. util.quoteaf(dir) .. ': ' .. sys.strerror(e))
      else util.err('failed to remove ' .. util.quoteaf(dir) .. ': ' .. sys.strerror(e)) end
      break
    end
  end
  return ok
end

global function applet_rmdir(args: sequence(string)): integer
  local o = util.parsel(args, 'pv', &longopts.rmdir, #longopts.rmdir)
  if not o:ok() then return util.optfail(o) end
  rmdir_ignore_nonempty = o.set[201]
  rmdir_verbose = o:has('v')
  if #o.operands == 0 then return util.die('missing operand') end
  local ok = true
  for _, dir in ipairs(o.operands) do
    if rmdir_verbose then util.line('rmdir: removing directory, ' .. util.quoteaf(dir)) end
    if sys.rmdir(dir) ~= 0 then
      local e = sys.errno()
      if rmdir_ignorable(e, dir) then continue end
      local custom = false
      if e == sys.ENOTDIR and #dir > 0 and dir:byte(#dir) == 47 then
        local st: sys.Stat
        local ret = sys.stat(dir, &st)
        if (ret ~= 0 and sys.errno() ~= sys.ENOTDIR) or (ret == 0 and (st.st_mode & sys.S_IFMT) == sys.S_IFDIR) then
          local stripped = rmdir_strip_slashes(dir)
          if sys.lstat(stripped, &st) == 0 and (st.st_mode & sys.S_IFMT) == sys.S_IFLNK then
            util.err('failed to remove ' .. util.quoteaf(dir) .. ': Symbolic link not followed')
            custom = true
          end
        end
      end
      if not custom then util.err('failed to remove ' .. util.quoteaf(dir) .. ': ' .. sys.strerror(e)) end
      ok = false
    elseif o:has('p') then
      if not rmdir_parents(dir) then ok = false end
    end
  end
  return ok and 0 or 1
end

local function rm_tree(path: string, force: boolean, verbose: boolean): boolean
  local st: sys.Stat
  if sys.lstat(path, &st) ~= 0 then
    if force and sys.errno() == sys.ENOENT then return true end
    util.err("cannot remove '" .. path .. "': " .. sys.errstr())
    return false
  end
  local ok = true
  if (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then
    local names, rok = util.readnames(path, true)
    if not rok then util.perror(path); return false end
    for _, n in ipairs(names) do
      if n ~= '.' and n ~= '..' then
        if not rm_tree(util.join(path, n), force, verbose) then ok = false end
      end
    end
    if sys.rmdir(path) ~= 0 then util.err("cannot remove '" .. path .. "': " .. sys.errstr()); return false end
  elseif sys.unlink(path) ~= 0 then
    util.err("cannot remove '" .. path .. "': " .. sys.errstr())
    return false
  end
  if verbose and ok then util.line("removed '" .. path .. "'") end
  return ok
end


-- "@SECONDS", "YYYY-MM-DD", "YYYY-MM-DD HH:MM[:SS]", or "YYYY-MM-DDTHH:MM[:SS]" in local time.
global function parse_datetime(s: string): (clong, boolean)
  if s.size > 1 and s:byte(1) == 64 then
    local v, ok = util.toint(s:sub(2))
    return (@clong)(v), ok
  end
  local nums: sequence(integer)
  for w in s:gmatch('%d+') do local v, _ = util.toint(w); nums:push(v) end
  if #nums < 3 then return 0, false end
  local y, m, d = nums[1], nums[2], nums[3]
  local hh: integer, mm: integer, ss: integer = 0, 0, 0
  if #nums >= 4 then hh = nums[4] end
  if #nums >= 5 then mm = nums[5] end
  if #nums >= 6 then ss = nums[6] end
  if m < 1 or m > 12 or d < 1 or d > 31 or hh > 23 or mm > 59 or ss > 59 then return 0, false end
  -- local wall time; one that a DST change skips is rejected, as GNU does
  local t, ok = util.localsecs(y, m, d, hh, mm, ss)
  return (@clong)(t), ok
end

-- Fractional seconds of a -d time ("HH:MM:SS.fff" or ",fff") as nanoseconds,
-- truncated to nine digits as GNU touch does; 0 when there are none.
global function parse_datetime_nsec(s: string): clong
  local _, e = s:find('%d+:%d+:%d+[.,]')
  if e <= 0 then return 0 end
  local ns: clong = 0
  local digits = 0
  local i: usize = (@usize)(e) + 1
  while i <= s.size and s:byte(i) >= 48 and s:byte(i) <= 57 do
    if digits < 9 then ns = ns * 10 + (s:byte(i) - 48); digits = digits + 1 end
    i = i + 1
  end
  while digits < 9 do ns = ns * 10; digits = digits + 1 end
  return ns
end

-- touch -t: [[CC]YY]MMDDhhmm[.ss]
global function parse_touch_t(s: string): (clong, boolean)
  local body = s
  local ss: integer = 0
  local dot = s:find('.', 1, true)
  if dot > 0 then
    local v, ok = util.toint(s:sub(dot + 1))
    if not ok or s.size - (@usize)(dot) ~= 2 then return 0, false end
    ss = v; body = s:sub(1, dot - 1)
  end
  for i: usize = 1, body.size do if body:byte(i) < 48 or body:byte(i) > 57 then return 0, false end end
  local y: integer
  local okv: boolean
  if body.size == 12 then
    y, okv = util.toint(body:sub(1, 4)); body = body:sub(5)
  elseif body.size == 10 then
    y, okv = util.toint(body:sub(1, 2)); body = body:sub(3)
    if y >= 69 then y = y + 1900 else y = y + 2000 end
  elseif body.size == 8 then
    local ts: sys.Timespec
    sys.clock_gettime(sys.CLOCK_REALTIME, &ts)
    local now, _ = util.breaktime(ts.tv_sec, 0, false)
    y = (@integer)(now.tm.tm_year) + 1900
  else return 0, false end
  local mo, ok1 = util.toint(body:sub(1, 2))
  local d, ok2 = util.toint(body:sub(3, 4))
  local hh, ok3 = util.toint(body:sub(5, 6))
  local mm, ok4 = util.toint(body:sub(7, 8))
  -- second 60 (a leap second) is accepted as the next minute's first
  local leap: integer = ss == 60 and 1 or 0
  local t, ok = parse_datetime(string.format('%d-%d-%d %d:%d:%d', y, mo, d, hh, mm, ss - leap))
  return t + leap, ok
end


global function copy_file(src: string, dst: string, mode: cuint): boolean
  local ifd = sys.open(src, sys.O_RDONLY, 0)
  if ifd < 0 then util.err("cannot open '" .. src .. "' for reading: " .. sys.errstr()); return false end
  local ofd = sys.open(dst, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, mode & 0x1FF)
  if ofd < 0 then util.err("cannot create regular file '" .. dst .. "': " .. sys.errstr()); sys.close(ifd); return false end
  local chunk: [65536]byte
  local ok = true
  while true do
    local r = sys.read(ifd, &chunk[0], #chunk)
    if r < 0 then if sys.errno() == sys.EINTR then continue end; util.perror(src); ok = false; break end
    if r == 0 then break end
    local done: clong = 0
    while done < r do
      local w = sys.write(ofd, &chunk[done], (@usize)(r - done))
      if w < 0 then util.perror(dst); ok = false; break end
      done = done + w
    end
    if not ok then break end
  end
  sys.close(ifd)
  sys.close(ofd)
  return ok
end






global function applet_pwd(args: sequence(string)): integer
  local o = util.parsel(args, 'LP', &longopts.pwd, #longopts.pwd)
  if not o:ok() then return util.optfail(o) end
  if o:has('L') then
    local env = sys.getenv('PWD')
    if env ~= nilptr then
      local p: string = env
      local a: sys.Stat
      local b: sys.Stat
      if p.size > 0 and p:byte(1) == 47 and sys.stat(p, &a) == 0 and sys.stat('.', &b) == 0 and a.st_ino == b.st_ino and a.st_dev == b.st_dev then
        util.line(p); return 0
      end
    end
  end
  local buf: [4096]cchar
  if sys.getcwd(&buf[0], 4096) == nilptr then return util.die('cannot get current directory: ' .. sys.errstr()) end
  util.line(sys.cstr(&buf[0]))
  return 0
end

global function applet_basename(args: sequence(string)): integer
  local o = util.parsel(args, '+as:z', &longopts.basename, #longopts.basename)
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing operand') end
  local multi = o:has('a') or o:has('s')
  local suffix: string = o:has('s') and o:get('s') or ''
  local names: sequence(string)
  if multi then names = o.operands
  else
    names:push(o.operands[1])
    if #o.operands > 1 then suffix = o.operands[2] end
    if #o.operands > 2 then return util.die("extra operand '" .. o.operands[3] .. "'") end
  end
  for _, p in ipairs(names) do
    local b = util.basename(p)
    if suffix.size > 0 and b.size > suffix.size and b:sub(-(@isize)(suffix.size)) == suffix then
      b = b:sub(1, (@isize)(b.size - suffix.size))
    end
    util.write(b)
    util.writebyte(o:has('z') and 0 or 10)
  end
  return 0
end

global function applet_dirname(args: sequence(string)): integer
  local o = util.parsel(args, 'z', &longopts.dirname, #longopts.dirname)
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing operand') end
  for _, p in ipairs(o.operands) do
    util.write(util.dirname(p))
    util.writebyte(o:has('z') and 0 or 10)
  end
  return 0
end

-- chmod: GNU coreutils 9.1 chmod.c over gnulib modechange: octal and
-- symbolic modes (with the umask when no "who" is given), "-w"-style modes
-- mixed with options, --reference, -R, -c, -f, -v, --preserve-root.
local chmod_change: sequence(modechange.Change)
local chmod_umask: cuint
local chmod_recurse: boolean
local chmod_force: boolean
local chmod_verbosity: integer   -- 0 off, 1 changes only, 2 high
local chmod_surprises: boolean
local chmod_root_dev: culong
local chmod_root_ino: culong
local chmod_preserve_root: boolean

-- GNU's Change_status order matters: ok means NOT_APPLIED or better.
local CH_NO_STAT: integer <comptime> = 0
local CH_FAILED: integer <comptime> = 1
local CH_NOT_APPLIED: integer <comptime> = 2
local CH_NO_CHANGE_REQUESTED: integer <comptime> = 3
local CH_SUCCEEDED: integer <comptime> = 4

local function chmod_describe(file: string, status: integer, old_mode: cuint, new_mode: cuint)
  local q = util.quoteaf(file)
  if status == CH_NOT_APPLIED then util.line('neither symbolic link ' .. q .. ' nor referent has been changed'); return end
  if status == CH_NO_STAT then util.line(q .. ' could not be accessed'); return end
  local m = new_mode & 0xFFF
  if status == CH_NO_CHANGE_REQUESTED then
    util.writef('mode of %s retained as %04o (%s)\n', q, m, modechange.strmode9(new_mode))
    return
  end
  local fmt = status == CH_SUCCEEDED and 'mode of %s changed from %04o (%s) to %04o (%s)\n'
                                      or 'failed to change mode of %s from %04o (%s) to %04o (%s)\n'
  util.writef(fmt, q, old_mode & 0xFFF, modechange.strmode9(old_mode), m, modechange.strmode9(new_mode))
end

-- process_file for one entry; st is nilptr when it could not be stat'ed
-- (the error was already reported).
local function chmod_one(path: string, st: *sys.Stat): boolean
  local status: integer = CH_NO_STAT
  local old_mode: cuint = 0
  local new_mode: cuint = 0
  if st ~= nilptr then
    status = CH_NOT_APPLIED
    if (st.st_mode & sys.S_IFMT) ~= sys.S_IFLNK then
      old_mode = st.st_mode
      new_mode = modechange.adjust(old_mode, (old_mode & sys.S_IFMT) == sys.S_IFDIR, chmod_umask, chmod_change)
      if sys.chmod(path, new_mode) == 0 then status = CH_SUCCEEDED
      else
        if not chmod_force then util.err('changing permissions of ' .. util.quoteaf(path) .. ': ' .. sys.errstr()) end
        status = CH_FAILED
      end
    end
  end
  if chmod_verbosity ~= 0 then
    if status == CH_SUCCEEDED then
      local nm = new_mode
      local changed = true
      if (nm & 0xE00) ~= 0 then
        local nst: sys.Stat
        if sys.stat(path, &nst) ~= 0 then
          if not chmod_force then util.err('getting new attributes of ' .. util.quoteaf(path) .. ': ' .. sys.errstr()) end
          changed = false
        else nm = nst.st_mode end
      end
      if changed then changed = ((old_mode ~ nm) & 0xFFF) ~= 0 end
      if not changed then status = CH_NO_CHANGE_REQUESTED end
    end
    if status == CH_SUCCEEDED or chmod_verbosity == 2 then chmod_describe(path, status, old_mode, new_mode) end
  end
  if CH_NO_CHANGE_REQUESTED <= status and chmod_surprises then
    local naive = modechange.adjust(old_mode, (old_mode & sys.S_IFMT) == sys.S_IFDIR, 0, chmod_change)
    if (new_mode & ~naive) ~= 0 then
      util.err(util.quotef(path) .. ': new permissions are ' .. modechange.strmode9(new_mode) .. ', not '
        .. modechange.strmode9(naive))
      status = CH_FAILED
    end
  end
  return CH_NOT_APPLIED <= status
end

local function chmod_tree(path: string, top: boolean): boolean
  local st: sys.Stat
  local r: cint
  if top then r = sys.stat(path, &st) else r = sys.lstat(path, &st) end
  if r ~= 0 then
    local e = sys.errno()
    if top and sys.lstat(path, &st) == 0 and (st.st_mode & sys.S_IFMT) == sys.S_IFLNK then
      if not chmod_force then util.err('cannot operate on dangling symlink ' .. util.quoteaf(path)) end
    elseif not chmod_force then
      util.err('cannot access ' .. util.quoteaf(path) .. ': ' .. sys.strerror(e))
    end
    return chmod_one(path, nilptr)
  end
  if chmod_recurse and chmod_preserve_root and st.st_dev == chmod_root_dev and st.st_ino == chmod_root_ino then
    if path == '/' then util.err("it is dangerous to operate recursively on '/'")
    else util.err("it is dangerous to operate recursively on " .. util.quoteaf(path) .. " (same as '/')") end
    util.err('use --no-preserve-root to override this failsafe')
    return false
  end
  local ok = chmod_one(path, &st)
  if chmod_recurse and (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then
    local names, rok = util.readnames_raw(path)
    if not rok then
      if not chmod_force then util.err('cannot read directory ' .. util.quoteaf(path) .. ': ' .. sys.errstr()) end
      if chmod_verbosity == 2 then chmod_describe(path, CH_NO_STAT, 0, 0) end
      return false
    end
    for _, n in ipairs(names) do
      if n ~= '.' and n ~= '..' then
        local child = path:byte(#path) == 47 and path .. n or path .. '/' .. n
        if not chmod_tree(child, false) then ok = false end
      end
    end
  end
  return ok
end

local CHMOD_NO_PRESERVE_ROOT: integer <comptime> = 200
local CHMOD_PRESERVE_ROOT: integer <comptime> = 201
local CHMOD_REFERENCE: integer <comptime> = 202
local chmod_longs: []util.LongOpt = {
  {'changes', 0, 99}, {'recursive', 0, 82}, {'no-preserve-root', 0, CHMOD_NO_PRESERVE_ROOT},
  {'preserve-root', 0, CHMOD_PRESERVE_ROOT}, {'quiet', 0, 102}, {'reference', 1, CHMOD_REFERENCE},
  {'silent', 0, 102}, {'verbose', 0, 118}, {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
}

global function applet_chmod(args: sequence(string)): integer
  local g = util.getopt(args, 'Rcfvr::w::x::X::s::t::u::g::o::a::,::+::=::0::1::2::3::4::5::6::7::', &chmod_longs, #chmod_longs)
  g.quiet = true
  local mode: string = ''
  local have_mode = false
  local reference: string = ''
  local have_ref = false
  chmod_recurse = false; chmod_force = false; chmod_verbosity = 0; chmod_surprises = false
  chmod_preserve_root = false
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 63 then util.err(g.errmsg); return 1 end
    if c == util.UNSUPPORTED then util.err("option '--" .. g.longname .. "' is not supported"); return 1 end
    if c == 114 or c == 119 or c == 120 or c == 88 or c == 115 or c == 116 or c == 117 or c == 103
       or c == 111 or c == 97 or c == 44 or c == 43 or c == 61 or (c >= 48 and c <= 55) then
      local arg = g.args[g.optind - 1]
      if have_mode then mode = mode .. ',' .. arg else mode = arg end
      have_mode = true
      chmod_surprises = true
    elseif c == CHMOD_NO_PRESERVE_ROOT then chmod_preserve_root = false
    elseif c == CHMOD_PRESERVE_ROOT then chmod_preserve_root = true
    elseif c == CHMOD_REFERENCE then reference = g.optarg; have_ref = true
    elseif c == 82 then chmod_recurse = true
    elseif c == 99 then chmod_verbosity = 1
    elseif c == 102 then chmod_force = true
    elseif c == 118 then chmod_verbosity = 2 end
  end
  local operands = g:operands()
  local oi = 1
  local mode_from_operand = false
  if have_ref then
    if have_mode then util.err('cannot combine mode and --reference options'); return 1 end
  elseif not have_mode then
    if oi <= #operands then mode = operands[oi]; oi = oi + 1; have_mode = true; mode_from_operand = true end
  end
  if oi > #operands then
    if not mode_from_operand then util.err('missing operand')
    else util.err("missing operand after '" .. args[#args] .. "'") end
    return 1
  end
  if have_ref then
    local rst: sys.Stat
    if sys.stat(reference, &rst) ~= 0 then
      util.err('failed to get attributes of ' .. util.quoteaf(reference) .. ': ' .. sys.errstr())
      return 1
    end
    chmod_change = modechange.from_mode(rst.st_mode)
    chmod_umask = 0
  else
    local ok: boolean
    chmod_change, ok = modechange.compile(mode)
    if not ok then util.err("invalid mode: '" .. mode .. "'"); return 1 end
    chmod_umask = sys.umask(0)
  end
  if chmod_recurse and chmod_preserve_root then
    local rst: sys.Stat
    if sys.stat('/', &rst) ~= 0 then util.err("failed to get attributes of '/': " .. sys.errstr()); return 1 end
    chmod_root_dev = rst.st_dev; chmod_root_ino = rst.st_ino
  end
  local ok = true
  for k = oi, #operands do
    if not chmod_tree(operands[k], true) then ok = false end
  end
  return ok and 0 or 1
end

-- test / [ : the POSIX subset with -a/-o and parentheses left out.
local function test_unary(op: string, a: string): (boolean, boolean)
  local st: sys.Stat
  local c = op:byte(2)
  if c == 122 then return a.size == 0, true end
  if c == 110 then return a.size > 0, true end
  if c == 116 then local fd, ok = util.toint(a); return ok and sys.isatty((@cint)(fd)) == 1, true end
  if c == 104 or c == 76 then return sys.lstat(a, &st) == 0 and (st.st_mode & sys.S_IFMT) == sys.S_IFLNK, true end
  if c == 114 then return sys.access(a, sys.R_OK) == 0, true end
  if c == 119 then return sys.access(a, sys.W_OK) == 0, true end
  if c == 120 then return sys.access(a, sys.X_OK) == 0, true end
  if sys.stat(a, &st) ~= 0 then
    if c == 101 or c == 102 or c == 100 or c == 115 or c == 112 or c == 98 or c == 99 or c == 83 then return false, true end
    return false, false
  end
  local kind = st.st_mode & sys.S_IFMT
  if c == 101 then return true, true end
  if c == 102 then return kind == sys.S_IFREG, true end
  if c == 100 then return kind == sys.S_IFDIR, true end
  if c == 115 then return st.st_size > 0, true end
  if c == 112 then return kind == sys.S_IFIFO, true end
  if c == 98 then return kind == sys.S_IFBLK, true end
  if c == 99 then return kind == sys.S_IFCHR, true end
  if c == 83 then return kind == sys.S_IFSOCK, true end
  return false, false
end

local function test_binary(a: string, op: string, b: string): (boolean, boolean)
  if op == '=' or op == '==' then return a == b, true end
  if op == '!=' then return a ~= b, true end
  if op == '<' then return a < b, true end
  if op == '>' then return b < a, true end
  local x, okx = util.toint(a)
  local y, oky = util.toint(b)
  if op == '-eq' or op == '-ne' or op == '-lt' or op == '-le' or op == '-gt' or op == '-ge' then
    if not okx then util.err("integer expression expected: '" .. a .. "'"); return false, false end
    if not oky then util.err("integer expression expected: '" .. b .. "'"); return false, false end
    if op == '-eq' then return x == y, true end
    if op == '-ne' then return x ~= y, true end
    if op == '-lt' then return x < y, true end
    if op == '-le' then return x <= y, true end
    if op == '-gt' then return x > y, true end
    return x >= y, true
  end
  if op == '-nt' or op == '-ot' or op == '-ef' then
    local sa: sys.Stat
    local sb: sys.Stat
    local ea, eb = sys.stat(a, &sa) == 0, sys.stat(b, &sb) == 0
    if op == '-ef' then return ea and eb and sa.st_dev == sb.st_dev and sa.st_ino == sb.st_ino, true end
    if not ea or not eb then return false, true end
    if op == '-nt' then return sa.st_mtim.tv_sec > sb.st_mtim.tv_sec, true end
    return sa.st_mtim.tv_sec < sb.st_mtim.tv_sec, true
  end
  return false, false
end

local function test_eval(args: sequence(string), lo: integer, hi: integer): (boolean, boolean)
  local n = hi - lo + 1
  if n <= 0 then return false, true end
  if args[lo] == '!' then
    local v, ok = test_eval(args, lo + 1, hi)
    return not v, ok
  end
  -- lowest precedence: -o, then -a
  for i: integer = lo + 1, hi - 1 do
    if args[i] == '-o' then
      local l, okl = test_eval(args, lo, i - 1)
      local r, okr = test_eval(args, i + 1, hi)
      return l or r, okl and okr
    end
  end
  for i: integer = lo + 1, hi - 1 do
    if args[i] == '-a' then
      local l, okl = test_eval(args, lo, i - 1)
      local r, okr = test_eval(args, i + 1, hi)
      return l and r, okl and okr
    end
  end
  if n == 1 then return args[lo].size > 0, true end
  if n == 2 then
    local a = args[lo]
    if a.size == 2 and a:byte(1) == 45 then return test_unary(a, args[lo + 1]) end
    util.err("unknown unary operator '" .. a .. "'")
    return false, false
  end
  if n == 3 then
    local v, ok = test_binary(args[lo], args[lo + 1], args[lo + 2])
    if ok then return v, true end
    util.err("unknown binary operator '" .. args[lo + 1] .. "'")
    return false, false
  end
  util.err('too many arguments')
  return false, false
end

global function applet_test(args: sequence(string)): integer
  local hi = #args
  if util.applet == '[' then
    if hi == 0 or args[hi] ~= ']' then util.err("missing ']'"); return 2 end
    hi = hi - 1
  end
  local v, ok = test_eval(args, 1, hi)
  if not ok then return 2 end
  return v and 0 or 1
end
