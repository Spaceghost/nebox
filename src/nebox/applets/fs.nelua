-- Filesystem applets: ls mkdir rmdir rm touch cp mv ln readlink pwd basename
-- dirname chmod test
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'

local function digits(v: integer): integer
  local n: integer = 1
  while v >= 10 do v = v // 10; n = n + 1 end
  return n
end

-- Column widths for -l, computed per listing as GNU ls does.
local LsWidths = @record{nlink: integer, uid: integer, gid: integer, size: integer}

local function owner(st: *sys.Stat): (string, string)
  return util.idname(util.username((@integer)(st.st_uid)), (@integer)(st.st_uid)),
         util.idname(util.groupname((@integer)(st.st_gid)), (@integer)(st.st_gid))
end

local function widths_of(stats: sequence(sys.Stat), human: boolean, numeric: boolean): LsWidths
  local w: LsWidths = {1, 1, 1, 1}
  for _, st in ipairs(stats) do
    local u, g = owner(&st)
    if numeric then u = string.format('%d', st.st_uid); g = string.format('%d', st.st_gid) end
    local d = digits((@integer)(st.st_nlink)); if d > w.nlink then w.nlink = d end
    d = (@integer)(u.size); if d > w.uid then w.uid = d end
    d = (@integer)(g.size); if d > w.gid then w.gid = d end
    if human then d = (@integer)(util.human((@integer)(st.st_size)).size) else d = digits((@integer)(st.st_size)) end
    if d > w.size then w.size = d end
  end
  return w
end

-- Order entries by time or size (newest/largest first), then name; -r flips.
local function ls_order(stats: sequence(sys.Stat), names: sequence(string), bytime: boolean, bysize: boolean, reverse: boolean): sequence(integer)
  local idx: sequence(integer)
  for i = 1, #stats do idx:push(i) end
  -- insertion sort keeps this simple and stable
  for i = 2, #idx do
    local j = i
    while j > 1 do
      local a, b = idx[j - 1], idx[j]
      local r: integer = 0
      if bytime then
        local ta, tb = stats[a].st_mtim, stats[b].st_mtim
        if ta.tv_sec ~= tb.tv_sec then r = ta.tv_sec > tb.tv_sec and -1 or 1
        elseif ta.tv_nsec ~= tb.tv_nsec then r = ta.tv_nsec > tb.tv_nsec and -1 or 1 end
      elseif bysize then
        if stats[a].st_size ~= stats[b].st_size then r = stats[a].st_size > stats[b].st_size and -1 or 1 end
      end
      if r == 0 then
        if names[a] < names[b] then r = -1 elseif names[b] < names[a] then r = 1 end
      end
      if reverse then r = -r end
      if r <= 0 then break end
      idx[j - 1] = b; idx[j] = a
      j = j - 1
    end
  end
  return idx
end

local function ls_long(path: string, shown: string, st: *sys.Stat, w: LsWidths, human: boolean, numeric: boolean)
  local u, g = owner(st)
  if numeric then u = string.format('%d', st.st_uid); g = string.format('%d', st.st_gid) end
  local size: string = string.format('%d', (@integer)(st.st_size))
  if human then size = util.human((@integer)(st.st_size)) end
  local fmt = string.format('%%s %%%dd %%-%ds %%-%ds %%%ds %%s %%s', w.nlink, w.uid, w.gid, w.size)
  util.write(string.format(fmt, util.modestr(st.st_mode), (@integer)(st.st_nlink),
    u, g, size,
    util.timefmt(st.st_mtim.tv_sec, '%b %e %H:%M'), shown))
  if (st.st_mode & sys.S_IFMT) == sys.S_IFLNK then
    local buf: [4096]byte
    local n = sys.readlink(path, &buf[0], #buf)
    if n > 0 then util.write(' -> '); util.writebytes(&buf[0], (@usize)(n)) end
  end
  util.writebyte(10)
end

local Ls = @record{longfmt: boolean, all: boolean, classify: boolean, slash: boolean, recursive: boolean, rc: integer,
  reverse: boolean, bytime: boolean, bysize: boolean, human: boolean, inode: boolean, numeric: boolean, almost: boolean}

function Ls:show(path: string, shown: string, st: *sys.Stat, w: LsWidths)
  if self.inode then util.writef('%d ', st.st_ino) end
  if self.longfmt then ls_long(path, shown, st, w, self.human, self.numeric) return end
  util.write(shown)
  local kind = st.st_mode & sys.S_IFMT
  if (self.classify or self.slash) and kind == sys.S_IFDIR then util.writebyte(47)
  elseif self.classify and kind == sys.S_IFLNK then util.writebyte(64)
  elseif self.classify and (st.st_mode & 0x49) ~= 0 and kind == sys.S_IFREG then util.writebyte(42) end
  util.writebyte(10)
end

-- Print a group of entries (operand files, or one directory's contents).
function Ls:group(paths: sequence(string), shown: sequence(string), total: boolean)
  local stats: sequence(sys.Stat)
  local okpaths: sequence(string)
  local okshown: sequence(string)
  local blocks: integer = 0
  for i, p in ipairs(paths) do
    local st: sys.Stat
    if sys.lstat(p, &st) ~= 0 then
      if total and not (self.longfmt or self.inode or self.classify or self.slash or self.bytime or self.bysize) then
        -- a directory entry that vanished (or cannot be stat'ed) after it was
        -- read: plain listings need only its name, as coreutils ls prints it
        st = (@sys.Stat)()
        stats:push(st); okpaths:push(p); okshown:push(shown[i])
      else
        util.err("cannot access '" .. p .. "': " .. sys.errstr()); self.rc = 2
      end
    else
      stats:push(st); okpaths:push(p); okshown:push(shown[i])
      blocks = blocks + (@integer)(st.st_blocks)
    end
  end
  local w = widths_of(stats, self.human, self.numeric)
  if self.longfmt and total then
    if self.human then util.line('total ' .. util.human(blocks * 512)) else util.writef('total %d\n', (blocks + 1) // 2) end
  end
  local order = ls_order(stats, okshown, self.bytime, self.bysize, self.reverse)
  for _, i in ipairs(order) do self:show(okpaths[i], okshown[i], &stats[i], w) end
end

function Ls:listdir(dir: string, label: boolean)
  local names, ok = util.readnames(dir, self.all)
  if not ok then util.err("cannot open directory '" .. dir .. "': " .. sys.errstr()); self.rc = 2; return end
  if self.almost then
    local kept: sequence(string)
    for _, n in ipairs(names) do if n ~= '.' and n ~= '..' then kept:push(n) end end
    names = kept
  end
  if label then util.write(dir); util.line(':') end
  local paths: sequence(string)
  for _, n in ipairs(names) do paths:push(util.join(dir, n)) end
  self:group(paths, names, true)
  if self.recursive then
    for _, n in ipairs(names) do
      if n == '.' or n == '..' then continue end
      local p = util.join(dir, n)
      local st: sys.Stat
      if sys.lstat(p, &st) == 0 and (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then
        util.writebyte(10)
        self:listdir(p, true)
      end
    end
  end
end

global function applet_ls(args: sequence(string)): integer
  local o = util.parse(args, 'al1dFRprtShinAgo')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then o.operands:push('.') end
  local ls: Ls = {longfmt = o:has('l') or o:has('n') or o:has('g') or o:has('o'), all = o:has('a') or o:has('A'), classify = o:has('F'), slash = o:has('p'), recursive = o:has('R'),
    reverse = o:has('r'), bytime = o:has('t'), bysize = o:has('S'), human = o:has('h'), inode = o:has('i'), numeric = o:has('n'),
    almost = o:has('A') and not o:has('a')}
  local dironly = o:has('d')
  local files: sequence(string)
  local dirs: sequence(string)
  for _, p in ipairs(o.operands) do
    if not dironly and util.isdir(p) then dirs:push(p) else files:push(p) end
  end
  util.sort(files, util.name_less)
  util.sort(dirs, util.name_less)
  if #files > 0 then ls:group(files, files, false) end
  for i, d in ipairs(dirs) do
    if #files > 0 or i > 1 then util.writebyte(10) end
    ls:listdir(d, #o.operands > 1 or ls.recursive)
  end
  return ls.rc
end

global function mkdir_p(path: string, mode: cuint): boolean
  if util.isdir(path) then return true end
  local parent = util.dirname(path)
  if parent ~= path and parent ~= '.' and parent ~= '/' then
    if not mkdir_p(parent, mode) then return false end
  end
  if sys.mkdir(path, mode) ~= 0 then
    if sys.errno() == sys.EEXIST and util.isdir(path) then return true end
    util.err("cannot create directory '" .. path .. "': " .. sys.errstr())
    return false
  end
  return true
end

global function parse_mode(s: string): (cuint, boolean)
  if s.size == 0 or s.size > 4 then return 0, false end
  local v: cuint = 0
  for i: usize = 1, s.size do
    local c = s:byte(i)
    if c < 48 or c > 55 then return 0, false end
    v = v * 8 + (c - 48)
  end
  return v, true
end

global function applet_mkdir(args: sequence(string)): integer
  local o = util.parse(args, 'pm:v')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing operand') end
  local mode: cuint = 0x1FF
  if o:has('m') then
    local m, ok = parse_mode(o:get('m'))
    if not ok then return util.die("invalid mode '" .. o:get('m') .. "'") end
    mode = m
  end
  local rc: integer = 0
  for _, p in ipairs(o.operands) do
    if o:has('p') then
      if not mkdir_p(p, 0x1FF) then rc = 1
      elseif o:has('m') then sys.chmod(p, mode) end
    elseif sys.mkdir(p, mode) ~= 0 then
      util.err("cannot create directory '" .. p .. "': " .. sys.errstr())
      rc = 1
    elseif o:has('m') then
      sys.chmod(p, mode)
    end
  end
  return rc
end

global function applet_rmdir(args: sequence(string)): integer
  local o = util.parse(args, 'p')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing operand') end
  local rc: integer = 0
  for _, p in ipairs(o.operands) do
    if sys.rmdir(p) ~= 0 then
      util.err("failed to remove '" .. p .. "': " .. sys.errstr())
      rc = 1
    elseif o:has('p') then
      local d = util.dirname(p)
      while d ~= '.' and d ~= '/' and sys.rmdir(d) == 0 do d = util.dirname(d) end
    end
  end
  return rc
end

local function rm_tree(path: string, force: boolean, verbose: boolean): boolean
  local st: sys.Stat
  if sys.lstat(path, &st) ~= 0 then
    if force and sys.errno() == sys.ENOENT then return true end
    util.err("cannot remove '" .. path .. "': " .. sys.errstr())
    return false
  end
  local ok = true
  if (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then
    local names, rok = util.readnames(path, true)
    if not rok then util.perror(path); return false end
    for _, n in ipairs(names) do
      if n ~= '.' and n ~= '..' then
        if not rm_tree(util.join(path, n), force, verbose) then ok = false end
      end
    end
    if sys.rmdir(path) ~= 0 then util.err("cannot remove '" .. path .. "': " .. sys.errstr()); return false end
  elseif sys.unlink(path) ~= 0 then
    util.err("cannot remove '" .. path .. "': " .. sys.errstr())
    return false
  end
  if verbose and ok then util.line("removed '" .. path .. "'") end
  return ok
end

global function applet_rm(args: sequence(string)): integer
  local o = util.parse(args, 'rRfvi')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then
    if o:has('f') then return 0 end
    return util.die('missing operand')
  end
  local rc: integer = 0
  local recursive = o:has('r') or o:has('R')
  for _, p in ipairs(o.operands) do
    if recursive then
      if not rm_tree(p, o:has('f'), o:has('v')) then rc = 1 end
    else
      local st: sys.Stat
      if sys.lstat(p, &st) ~= 0 then
        if not (o:has('f') and sys.errno() == sys.ENOENT) then
          util.err("cannot remove '" .. p .. "': " .. sys.errstr()); rc = 1
        end
      elseif (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then
        util.err("cannot remove '" .. p .. "': Is a directory"); rc = 1
      elseif sys.unlink(p) ~= 0 then
        util.err("cannot remove '" .. p .. "': " .. sys.errstr()); rc = 1
      elseif o:has('v') then
        util.line("removed '" .. p .. "'")
      end
    end
  end
  return rc
end

-- "@SECONDS", "YYYY-MM-DD", "YYYY-MM-DD HH:MM[:SS]", or "YYYY-MM-DDTHH:MM[:SS]" as UTC.
global function parse_datetime(s: string): (clong, boolean)
  if s.size > 1 and s:byte(1) == 64 then
    local v, ok = util.toint(s:sub(2))
    return (@clong)(v), ok
  end
  local nums: sequence(integer)
  for w in s:gmatch('%d+') do local v, _ = util.toint(w); nums:push(v) end
  if #nums < 3 then return 0, false end
  local y, m, d = nums[1], nums[2], nums[3]
  local hh: integer, mm: integer, ss: integer = 0, 0, 0
  if #nums >= 4 then hh = nums[4] end
  if #nums >= 5 then mm = nums[5] end
  if #nums >= 6 then ss = nums[6] end
  if m < 1 or m > 12 or d < 1 or d > 31 or hh > 23 or mm > 59 or ss > 60 then return 0, false end
  -- days from civil (Howard Hinnant)
  local yy = y
  if m <= 2 then yy = yy - 1 end
  local era = (yy >= 0 and yy or yy - 399) // 400
  local yoe = yy - era * 400
  local mp = (m + 9) % 12
  local doy = (153 * mp + 2) // 5 + d - 1
  local doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
  local days = era * 146097 + doe - 719468
  return (@clong)(days * 86400 + hh * 3600 + mm * 60 + ss), true
end

-- touch -t: [[CC]YY]MMDDhhmm[.ss]
global function parse_touch_t(s: string): (clong, boolean)
  local body = s
  local ss: integer = 0
  local dot = s:find('.', 1, true)
  if dot > 0 then
    local v, ok = util.toint(s:sub(dot + 1))
    if not ok or s.size - (@usize)(dot) ~= 2 then return 0, false end
    ss = v; body = s:sub(1, dot - 1)
  end
  for i: usize = 1, body.size do if body:byte(i) < 48 or body:byte(i) > 57 then return 0, false end end
  local y: integer
  local okv: boolean
  if body.size == 12 then
    y, okv = util.toint(body:sub(1, 4)); body = body:sub(5)
  elseif body.size == 10 then
    y, okv = util.toint(body:sub(1, 2)); body = body:sub(3)
    if y >= 69 then y = y + 1900 else y = y + 2000 end
  elseif body.size == 8 then
    local ts: sys.Timespec
    sys.clock_gettime(sys.CLOCK_REALTIME, &ts)
    local tm: sys.Tm
    sys.gmtime_r(&ts.tv_sec, &tm)
    y = (@integer)(tm.tm_year) + 1900
  else return 0, false end
  local mo, ok1 = util.toint(body:sub(1, 2))
  local d, ok2 = util.toint(body:sub(3, 4))
  local hh, ok3 = util.toint(body:sub(5, 6))
  local mm, ok4 = util.toint(body:sub(7, 8))
  return parse_datetime(string.format('%d-%d-%d %d:%d:%d', y, mo, d, hh, mm, ss))
end

global function applet_touch(args: sequence(string)): integer
  local o = util.parse(args, 'camhd:r:t:')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing file operand') end
  local times: [2]sys.Timespec
  local have_time = false
  if o:has('r') then
    local st: sys.Stat
    if sys.stat(o:get('r'), &st) ~= 0 then return util.die("failed to get attributes of '" .. o:get('r') .. "': " .. sys.errstr()) end
    times[0] = st.st_atim; times[1] = st.st_mtim; have_time = true
  elseif o:has('d') or o:has('t') then
    local secs: clong, ok: boolean
    if o:has('d') then secs, ok = parse_datetime(o:get('d')) else secs, ok = parse_touch_t(o:get('t')) end
    if not ok then return util.die("invalid date format '" .. (o:has('d') and o:get('d') or o:get('t')) .. "'") end
    times[0].tv_sec = secs; times[1].tv_sec = secs; have_time = true
  end
  if have_time then
    -- UTIME_OMIT for the time not selected by -a / -m
    if o:has('a') and not o:has('m') then times[1].tv_nsec = 0x3FFFFFFE end
    if o:has('m') and not o:has('a') then times[0].tv_nsec = 0x3FFFFFFE end
  end
  local rc: integer = 0
  for _, p in ipairs(o.operands) do
    if not util.exists(p) then
      if o:has('c') then continue end
      local fd = sys.open(p, sys.O_WRONLY | sys.O_CREAT, 0x1B6)
      if fd < 0 then util.err("cannot touch '" .. p .. "': " .. sys.errstr()); rc = 1; continue end
      sys.close(fd)
    end
    local flags: cint = o:has('h') and sys.AT_SYMLINK_NOFOLLOW or 0
    local tp: *[2]sys.Timespec = nilptr
    if have_time then tp = &times end
    if sys.utimensat(sys.AT_FDCWD, p, tp, flags) ~= 0 then
      util.err("setting times of '" .. p .. "': " .. sys.errstr()); rc = 1
    end
  end
  return rc
end

global function copy_file(src: string, dst: string, mode: cuint): boolean
  local ifd = sys.open(src, sys.O_RDONLY, 0)
  if ifd < 0 then util.err("cannot open '" .. src .. "' for reading: " .. sys.errstr()); return false end
  local ofd = sys.open(dst, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, mode & 0x1FF)
  if ofd < 0 then util.err("cannot create regular file '" .. dst .. "': " .. sys.errstr()); sys.close(ifd); return false end
  local chunk: [65536]byte
  local ok = true
  while true do
    local r = sys.read(ifd, &chunk[0], #chunk)
    if r < 0 then if sys.errno() == sys.EINTR then continue end; util.perror(src); ok = false; break end
    if r == 0 then break end
    local done: clong = 0
    while done < r do
      local w = sys.write(ofd, &chunk[done], (@usize)(r - done))
      if w < 0 then util.perror(dst); ok = false; break end
      done = done + w
    end
    if not ok then break end
  end
  sys.close(ifd)
  sys.close(ofd)
  return ok
end

local function copy_tree(src: string, dst: string, recursive: boolean, preserve: boolean): boolean
  local st: sys.Stat
  if sys.lstat(src, &st) ~= 0 then util.err("cannot stat '" .. src .. "': " .. sys.errstr()); return false end
  local kind = st.st_mode & sys.S_IFMT
  local ok = true
  if kind == sys.S_IFDIR then
    if not recursive then util.err("-r not specified; omitting directory '" .. src .. "'"); return false end
    if not util.isdir(dst) and sys.mkdir(dst, st.st_mode & 0x1FF) ~= 0 then
      util.err("cannot create directory '" .. dst .. "': " .. sys.errstr()); return false
    end
    local names, rok = util.readnames(src, true)
    if not rok then util.perror(src); return false end
    for _, n in ipairs(names) do
      if n ~= '.' and n ~= '..' then
        if not copy_tree(util.join(src, n), util.join(dst, n), recursive, preserve) then ok = false end
      end
    end
  elseif kind == sys.S_IFLNK and recursive then
    local buf: [4096]byte
    local n = sys.readlink(src, &buf[0], #buf)
    if n < 0 then util.perror(src); return false end
    sys.unlink(dst)
    local target = string.copy((@string){data=&buf[0], size=(@usize)(n)})
    if sys.symlink(target, dst) ~= 0 then util.err("cannot create symbolic link '" .. dst .. "': " .. sys.errstr()); return false end
    return true
  else
    ok = copy_file(src, dst, st.st_mode)
  end
  if ok and preserve then
    sys.chmod(dst, st.st_mode & 0xFFF)
    local times: [2]sys.Timespec = {st.st_atim, st.st_mtim}
    sys.utimensat(sys.AT_FDCWD, dst, &times, 0)
  end
  return ok
end

global function applet_cp(args: sequence(string)): integer
  local o = util.parse(args, 'rRfpvaint')
  if not o:ok() then return util.optfail(o) end
  if #o.operands < 2 then return util.die(#o.operands == 0 and 'missing file operand' or "missing destination file operand after '" .. o.operands[1] .. "'") end
  local recursive = o:has('r') or o:has('R') or o:has('a')
  local preserve = o:has('p') or o:has('a')
  local dst = o.operands[#o.operands]
  local nsrc = #o.operands - 1
  local dstdir = util.isdir(dst)
  if nsrc > 1 and not dstdir then return util.die("target '" .. dst .. "' is not a directory") end
  local rc: integer = 0
  for i: integer = 1, nsrc do
    local src = o.operands[i]
    local target = dstdir and util.join(dst, util.basename(src)) or dst
    if o:has('n') and util.exists(target) then continue end
    if o:has('f') and not util.isdir(target) then sys.unlink(target) end
    if not copy_tree(src, target, recursive, preserve) then rc = 1
    elseif o:has('v') then util.line("'" .. src .. "' -> '" .. target .. "'") end
  end
  return rc
end

global function applet_mv(args: sequence(string)): integer
  local o = util.parse(args, 'fivn')
  if not o:ok() then return util.optfail(o) end
  if #o.operands < 2 then return util.die(#o.operands == 0 and 'missing file operand' or "missing destination file operand after '" .. o.operands[1] .. "'") end
  local dst = o.operands[#o.operands]
  local nsrc = #o.operands - 1
  local dstdir = util.isdir(dst)
  if nsrc > 1 and not dstdir then return util.die("target '" .. dst .. "' is not a directory") end
  local rc: integer = 0
  for i: integer = 1, nsrc do
    local src = o.operands[i]
    local target = dstdir and util.join(dst, util.basename(src)) or dst
    if o:has('n') and util.exists(target) then continue end
    if sys.rename(src, target) ~= 0 then
      if sys.errno() == sys.EXDEV then
        if copy_tree(src, target, true, true) and rm_tree(src, false, false) then
          if o:has('v') then util.line("renamed '" .. src .. "' -> '" .. target .. "'") end
          continue
        end
      else
        util.err("cannot move '" .. src .. "' to '" .. target .. "': " .. sys.errstr())
      end
      rc = 1
    elseif o:has('v') then
      util.line("renamed '" .. src .. "' -> '" .. target .. "'")
    end
  end
  return rc
end

global function applet_ln(args: sequence(string)): integer
  local o = util.parse(args, 'sfnvT')
  if not o:ok() then return util.optfail(o) end
  if #o.operands < 1 then return util.die('missing file operand') end
  local targets: sequence(string)
  local dst: string
  if #o.operands == 1 then
    targets:push(o.operands[1]); dst = util.basename(o.operands[1])
  else
    for i: integer = 1, #o.operands - 1 do targets:push(o.operands[i]) end
    dst = o.operands[#o.operands]
  end
  local dstdir = util.isdir(dst) and not (o:has('n') and not util.isdir(dst))
  if #targets > 1 and not dstdir then return util.die("target '" .. dst .. "' is not a directory") end
  local rc: integer = 0
  for _, t in ipairs(targets) do
    local link = dstdir and util.join(dst, util.basename(t)) or dst
    if o:has('f') then sys.unlink(link) end
    local r: cint
    if o:has('s') then r = sys.symlink(t, link) else r = sys.link(t, link) end
    if r ~= 0 then
      util.err("failed to create " .. (o:has('s') and 'symbolic' or 'hard') .. " link '" .. link .. "': " .. sys.errstr())
      rc = 1
    elseif o:has('v') then
      util.line("'" .. link .. "' -> '" .. t .. "'")
    end
  end
  return rc
end

global function applet_readlink(args: sequence(string)): integer
  local o = util.parse(args, 'fenmqsv')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing operand') end
  local rc: integer = 0
  for _, p in ipairs(o.operands) do
    if o:has('f') or o:has('e') or o:has('m') then
      local buf: [4096]cchar
      local r = sys.realpath(p, &buf[0])
      if r == nilptr then
        if o:has('f') then
          -- all but the last component must exist
          local d = sys.realpath(util.dirname(p), &buf[0])
          if d ~= nilptr then util.line(util.join(sys.cstr(&buf[0]), util.basename(p))); continue end
        end
        if not o:has('q') and not o:has('s') then util.perror(p) end
        rc = 1
      else
        util.line(sys.cstr(&buf[0]))
      end
    else
      local buf: [4096]byte
      local n = sys.readlink(p, &buf[0], #buf)
      if n < 0 then
        if o:has('v') then util.perror(p) end
        rc = 1
      else
        util.writebytes(&buf[0], (@usize)(n))
        if not o:has('n') then util.writebyte(10) end
      end
    end
  end
  return rc
end

global function applet_pwd(args: sequence(string)): integer
  local o = util.parse(args, 'LP')
  if not o:ok() then return util.optfail(o) end
  if o:has('L') then
    local env = sys.getenv('PWD')
    if env ~= nilptr then
      local p: string = env
      local a: sys.Stat
      local b: sys.Stat
      if p.size > 0 and p:byte(1) == 47 and sys.stat(p, &a) == 0 and sys.stat('.', &b) == 0 and a.st_ino == b.st_ino and a.st_dev == b.st_dev then
        util.line(p); return 0
      end
    end
  end
  local buf: [4096]cchar
  if sys.getcwd(&buf[0], 4096) == nilptr then return util.die('cannot get current directory: ' .. sys.errstr()) end
  util.line(sys.cstr(&buf[0]))
  return 0
end

global function applet_basename(args: sequence(string)): integer
  local o = util.parse(args, 'as:z')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing operand') end
  local multi = o:has('a') or o:has('s')
  local suffix: string = o:has('s') and o:get('s') or ''
  local names: sequence(string)
  if multi then names = o.operands
  else
    names:push(o.operands[1])
    if #o.operands > 1 then suffix = o.operands[2] end
    if #o.operands > 2 then return util.die("extra operand '" .. o.operands[3] .. "'") end
  end
  for _, p in ipairs(names) do
    local b = util.basename(p)
    if suffix.size > 0 and b.size > suffix.size and b:sub(-(@isize)(suffix.size)) == suffix then
      b = b:sub(1, (@isize)(b.size - suffix.size))
    end
    util.write(b)
    util.writebyte(o:has('z') and 0 or 10)
  end
  return 0
end

global function applet_dirname(args: sequence(string)): integer
  local o = util.parse(args, 'z')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then return util.die('missing operand') end
  for _, p in ipairs(o.operands) do
    util.write(util.dirname(p))
    util.writebyte(o:has('z') and 0 or 10)
  end
  return 0
end

-- chmod: octal modes and the simple symbolic forms [ugoa][+-=][rwxst]
local function apply_symbolic(mode: cuint, spec: string): (cuint, boolean)
  local i: usize = 1
  while i <= spec.size do
    local who: cuint = 0
    while i <= spec.size do
      local c = spec:byte(i)
      if c == 117 then who = who | 0x1C0 elseif c == 103 then who = who | 0x38
      elseif c == 111 then who = who | 0x7 elseif c == 97 then who = who | 0x1FF
      else break end
      i = i + 1
    end
    if who == 0 then who = 0x1FF end
    if i > spec.size then return mode, false end
    local op = spec:byte(i)
    if op ~= 43 and op ~= 45 and op ~= 61 then return mode, false end
    i = i + 1
    local bits: cuint = 0
    local special: cuint = 0
    while i <= spec.size and spec:byte(i) ~= 44 do
      local c = spec:byte(i)
      if c == 114 then bits = bits | 0x124 elseif c == 119 then bits = bits | 0x92
      elseif c == 120 then bits = bits | 0x49 elseif c == 115 then special = special | 0xC00
      elseif c == 116 then special = special | 0x200
      elseif c == 88 then if (mode & sys.S_IFMT) == sys.S_IFDIR or (mode & 0x49) ~= 0 then bits = bits | 0x49 end
      else return mode, false end
      i = i + 1
    end
    bits = bits & who
    if (who & 0x1C0) == 0 then special = special & ~(@cuint)(0x800) end
    if (who & 0x38) == 0 then special = special & ~(@cuint)(0x400) end
    if op == 43 then mode = mode | bits | special
    elseif op == 45 then mode = mode & ~(bits | special)
    else mode = (mode & ~who) | bits | special end
    if i <= spec.size then i = i + 1 end
  end
  return mode, true
end

local function chmod_path(path: string, spec: string, recursive: boolean, verbose: boolean): boolean
  local st: sys.Stat
  if sys.lstat(path, &st) ~= 0 then util.err("cannot access '" .. path .. "': " .. sys.errstr()); return false end
  if (st.st_mode & sys.S_IFMT) == sys.S_IFLNK then return true end
  local mode: cuint
  local ok: boolean
  mode, ok = parse_mode(spec)
  if not ok then mode, ok = apply_symbolic(st.st_mode, spec) end
  if not ok then util.err("invalid mode: '" .. spec .. "'"); return false end
  mode = mode & 0xFFF
  if sys.chmod(path, mode) ~= 0 then util.err("changing permissions of '" .. path .. "': " .. sys.errstr()); return false end
  if verbose then util.line(string.format("mode of '%s' changed to %04o", path, (@integer)(mode))) end
  local all = true
  if recursive and (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then
    local names, rok = util.readnames(path, true)
    if not rok then util.perror(path); return false end
    for _, n in ipairs(names) do
      if n ~= '.' and n ~= '..' then
        if not chmod_path(util.join(path, n), spec, true, verbose) then all = false end
      end
    end
  end
  return all
end

global function applet_chmod(args: sequence(string)): integer
  -- the mode may look like an option (-x), so parse by hand
  local recursive, verbose = false, false
  local i: integer = 1
  while i <= #args do
    local a = args[i]
    if a == '-R' then recursive = true
    elseif a == '-v' then verbose = true
    elseif a == '--' then i = i + 1; break
    else break end
    i = i + 1
  end
  if #args - i + 1 < 2 then return util.die('missing operand') end
  local spec = args[i]
  local rc: integer = 0
  for j: integer = i + 1, #args do
    if not chmod_path(args[j], spec, recursive, verbose) then rc = 1 end
  end
  return rc
end

-- test / [ : the POSIX subset with -a/-o and parentheses left out.
local function test_unary(op: string, a: string): (boolean, boolean)
  local st: sys.Stat
  local c = op:byte(2)
  if c == 122 then return a.size == 0, true end
  if c == 110 then return a.size > 0, true end
  if c == 116 then local fd, ok = util.toint(a); return ok and sys.isatty((@cint)(fd)) == 1, true end
  if c == 104 or c == 76 then return sys.lstat(a, &st) == 0 and (st.st_mode & sys.S_IFMT) == sys.S_IFLNK, true end
  if c == 114 then return sys.access(a, sys.R_OK) == 0, true end
  if c == 119 then return sys.access(a, sys.W_OK) == 0, true end
  if c == 120 then return sys.access(a, sys.X_OK) == 0, true end
  if sys.stat(a, &st) ~= 0 then
    if c == 101 or c == 102 or c == 100 or c == 115 or c == 112 or c == 98 or c == 99 or c == 83 then return false, true end
    return false, false
  end
  local kind = st.st_mode & sys.S_IFMT
  if c == 101 then return true, true end
  if c == 102 then return kind == sys.S_IFREG, true end
  if c == 100 then return kind == sys.S_IFDIR, true end
  if c == 115 then return st.st_size > 0, true end
  if c == 112 then return kind == sys.S_IFIFO, true end
  if c == 98 then return kind == sys.S_IFBLK, true end
  if c == 99 then return kind == sys.S_IFCHR, true end
  if c == 83 then return kind == sys.S_IFSOCK, true end
  return false, false
end

local function test_binary(a: string, op: string, b: string): (boolean, boolean)
  if op == '=' or op == '==' then return a == b, true end
  if op == '!=' then return a ~= b, true end
  if op == '<' then return a < b, true end
  if op == '>' then return b < a, true end
  local x, okx = util.toint(a)
  local y, oky = util.toint(b)
  if op == '-eq' or op == '-ne' or op == '-lt' or op == '-le' or op == '-gt' or op == '-ge' then
    if not okx then util.err("integer expression expected: '" .. a .. "'"); return false, false end
    if not oky then util.err("integer expression expected: '" .. b .. "'"); return false, false end
    if op == '-eq' then return x == y, true end
    if op == '-ne' then return x ~= y, true end
    if op == '-lt' then return x < y, true end
    if op == '-le' then return x <= y, true end
    if op == '-gt' then return x > y, true end
    return x >= y, true
  end
  if op == '-nt' or op == '-ot' or op == '-ef' then
    local sa: sys.Stat
    local sb: sys.Stat
    local ea, eb = sys.stat(a, &sa) == 0, sys.stat(b, &sb) == 0
    if op == '-ef' then return ea and eb and sa.st_dev == sb.st_dev and sa.st_ino == sb.st_ino, true end
    if not ea or not eb then return false, true end
    if op == '-nt' then return sa.st_mtim.tv_sec > sb.st_mtim.tv_sec, true end
    return sa.st_mtim.tv_sec < sb.st_mtim.tv_sec, true
  end
  return false, false
end

local function test_eval(args: sequence(string), lo: integer, hi: integer): (boolean, boolean)
  local n = hi - lo + 1
  if n <= 0 then return false, true end
  if args[lo] == '!' then
    local v, ok = test_eval(args, lo + 1, hi)
    return not v, ok
  end
  -- lowest precedence: -o, then -a
  for i: integer = lo + 1, hi - 1 do
    if args[i] == '-o' then
      local l, okl = test_eval(args, lo, i - 1)
      local r, okr = test_eval(args, i + 1, hi)
      return l or r, okl and okr
    end
  end
  for i: integer = lo + 1, hi - 1 do
    if args[i] == '-a' then
      local l, okl = test_eval(args, lo, i - 1)
      local r, okr = test_eval(args, i + 1, hi)
      return l and r, okl and okr
    end
  end
  if n == 1 then return args[lo].size > 0, true end
  if n == 2 then
    local a = args[lo]
    if a.size == 2 and a:byte(1) == 45 then return test_unary(a, args[lo + 1]) end
    util.err("unknown unary operator '" .. a .. "'")
    return false, false
  end
  if n == 3 then
    local v, ok = test_binary(args[lo], args[lo + 1], args[lo + 2])
    if ok then return v, true end
    util.err("unknown binary operator '" .. args[lo + 1] .. "'")
    return false, false
  end
  util.err('too many arguments')
  return false, false
end

global function applet_test(args: sequence(string)): integer
  local hi = #args
  if util.applet == '[' then
    if hi == 0 or args[hi] ~= ']' then util.err("missing ']'"); return 2 end
    hi = hi - 1
  end
  local v, ok = test_eval(args, 1, hi)
  if not ok then return 2 end
  return v and 0 or 1
end
