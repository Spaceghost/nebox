-- Process and system applets: true false sleep env printenv uname hostname id
-- kill which sync date nproc
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.longopts'
require 'nebox.getdate'
require 'nebox.clock'

global function applet_true(args: sequence(string)): integer
  return 0
end

global function applet_false(args: sequence(string)): integer
  return 1
end

-- Parse "1.5", "2m", "1h", "3d" style durations into a timespec.
global function parse_duration(s: string, ts: *sys.Timespec): boolean
  if s.size == 0 then return false end
  local mult: float64 = 1
  local body = s
  local last = s:byte(s.size)
  if last == 115 then body = s:sub(1, -2)
  elseif last == 109 then mult = 60; body = s:sub(1, -2)
  elseif last == 104 then mult = 3600; body = s:sub(1, -2)
  elseif last == 100 then mult = 86400; body = s:sub(1, -2) end
  if body.size == 0 then return false end
  local whole: float64 = 0
  local i: usize = 1
  local any = false
  while i <= body.size and body:byte(i) >= 48 and body:byte(i) <= 57 do
    whole = whole * 10 + (body:byte(i) - 48); i = i + 1; any = true
  end
  if i <= body.size and body:byte(i) == 46 then
    i = i + 1
    local scale: float64 = 0.1
    while i <= body.size and body:byte(i) >= 48 and body:byte(i) <= 57 do
      whole = whole + (body:byte(i) - 48) * scale; scale = scale * 0.1; i = i + 1; any = true
    end
  end
  if not any or i <= body.size then return false end
  whole = whole * mult
  ts.tv_sec = (@clong)(whole)
  ts.tv_nsec = (@clong)((whole - (@float64)(ts.tv_sec)) * 1e9)
  return true
end

global function applet_sleep(args: sequence(string)): integer
  if #args == 0 then return util.die('missing operand') end
  local total: sys.Timespec
  for _, a in ipairs(args) do
    local ts: sys.Timespec
    if not parse_duration(a, &ts) then return util.die("invalid time interval '" .. a .. "'") end
    total.tv_sec = total.tv_sec + ts.tv_sec
    total.tv_nsec = total.tv_nsec + ts.tv_nsec
    if total.tv_nsec >= 1000000000 then total.tv_sec = total.tv_sec + 1; total.tv_nsec = total.tv_nsec - 1000000000 end
  end
  while sys.nanosleep(&total, &total) ~= 0 do
    if sys.errno() ~= sys.EINTR then return util.die('nanosleep: ' .. sys.errstr()) end
  end
  return 0
end

local function print_environ()
  local i: usize = 0
  while environ[i] ~= nilptr do
    util.line(environ[i])
    i = i + 1
  end
end

global function applet_printenv(args: sequence(string)): integer
  if #args == 0 then print_environ(); return 0 end
  local rc: integer = 0
  for _, name in ipairs(args) do
    local v = sys.getenv(name)
    if v == nilptr then rc = 1 else util.line(v) end
  end
  return rc
end

global function applet_env(args: sequence(string)): integer
  local i: integer = 1
  local clear = false
  while i <= #args do
    local a = args[i]
    if a == '-i' then clear = true
    elseif a == '-u' then
      i = i + 1
      if i > #args then return util.die("option requires an argument -- 'u'") end
      sys.unsetenv(args[i])
    elseif a == '--' then i = i + 1; break
    elseif a.size > 1 and a:byte(1) == 45 then return util.die("invalid option -- '" .. a:sub(2, 2) .. "'")
    else break end
    i = i + 1
  end
  if clear then
    -- drop every variable by clearing the pointer array in place
    environ[0] = nilptr
  end
  while i <= #args do
    local a = args[i]
    local eq = a:find('=', 1, true)
    if eq <= 1 then break end
    sys.setenv(a:sub(1, eq - 1), a:sub(eq + 1), 1)
    i = i + 1
  end
  if i > #args then print_environ(); return 0 end
  local argv: sequence(cstring)
  for j: integer = i, #args do argv:push(args[j]) end
  argv:push(nilptr)
  util.flush()
  sys.execvp(args[i], &argv[1])
  local e = sys.errno()
  util.err("'" .. args[i] .. "': " .. sys.errstr())
  return e == sys.ENOENT and 127 or 126
end

global function applet_uname(args: sequence(string)): integer
  local o = util.parsel(args, 'asnrvmpio', &longopts.uname, #longopts.uname)
  if not o:ok() then return util.optfail(o) end
  if #o.operands > 0 then return util.die("extra operand '" .. o.operands[1] .. "'") end
  local u: sys.Utsname
  if sys.uname(&u) ~= 0 then return util.die('uname: ' .. sys.errstr()) end
  local all = o:has('a')
  local nothing = not (o:has('s') or o:has('n') or o:has('r') or o:has('v') or o:has('m') or o:has('p') or o:has('i') or o:has('o') or all)
  if nothing then util.line(sys.cstr(&u.sysname)); return 0 end
  local parts: sequence(string)
  if all or o:has('s') then parts:push(sys.cstr(&u.sysname)) end
  if all or o:has('n') then parts:push(sys.cstr(&u.nodename)) end
  if all or o:has('r') then parts:push(sys.cstr(&u.release)) end
  if all or o:has('v') then parts:push(sys.cstr(&u.version)) end
  if all or o:has('m') then parts:push(sys.cstr(&u.machine)) end
  if not all and o:has('p') then parts:push('unknown') end
  if not all and o:has('i') then parts:push('unknown') end
  if all or o:has('o') then parts:push('GNU/Linux') end
  for i, p in ipairs(parts) do
    if i > 1 then util.writebyte(32) end
    util.write(p)
  end
  util.writebyte(10)
  return 0
end

global function applet_hostname(args: sequence(string)): integer
  local buf: [256]cchar
  if sys.gethostname(&buf[0], 256) ~= 0 then return util.die(sys.errstr()) end
  util.line(sys.cstr(&buf[0]))
  return 0
end

global function applet_id(args: sequence(string)): integer
  local o = util.parsel(args, 'ugrnG', &longopts.id, #longopts.id)
  if not o:ok() then return util.optfail(o) end
  local uid, euid = sys.getuid(), sys.geteuid()
  local gid, egid = sys.getgid(), sys.getegid()
  local u: integer = (@integer)(o:has('r') and uid or euid)
  local g: integer = (@integer)(o:has('r') and gid or egid)
  if o:has('G') then
    local list: [256]cuint
    local n = sys.getgroups(256, &list[0])
    local names = o:has('n')
    local ids: sequence(integer)
    ids:push((@integer)(egid))
    for i: integer = 0, < n do
      local sg = (@integer)(list[i])
      if sg ~= (@integer)(egid) then ids:push(sg) end
    end
    for k, id in ipairs(ids) do
      if k > 1 then util.writebyte(32) end
      if names then util.write(util.idname(util.groupname(id), id)) else util.writef('%d', id) end
    end
    util.writebyte(10)
    return 0
  end
  if o:has('u') then
    if o:has('n') then util.line(util.idname(util.username(u), u)) else util.writef('%d\n', u) end
    return 0
  end
  if o:has('g') then
    if o:has('n') then util.line(util.idname(util.groupname(g), g)) else util.writef('%d\n', g) end
    return 0
  end
  local function show(label: string, id: integer, name: string)
    util.write(label); util.writef('%d', id)
    if name.size > 0 then util.write('(' .. name .. ')') end
  end
  show('uid=', (@integer)(uid), util.username((@integer)(uid)))
  show(' gid=', (@integer)(gid), util.groupname((@integer)(gid)))
  if euid ~= uid then show(' euid=', (@integer)(euid), util.username((@integer)(euid))) end
  if egid ~= gid then show(' egid=', (@integer)(egid), util.groupname((@integer)(egid))) end
  show(' groups=', (@integer)(gid), util.groupname((@integer)(gid)))
  local list: [256]cuint
  local n = sys.getgroups(256, &list[0])
  for i: integer = 0, < n do
    local sg = (@integer)(list[i])
    if sg == (@integer)(gid) then continue end
    show(',', sg, util.groupname(sg))
  end
  util.writebyte(10)
  return 0
end

local SigName = @record{name: string, num: cint}
local signals: []SigName = {
  {'HUP', 1}, {'INT', 2}, {'QUIT', 3}, {'ILL', 4}, {'TRAP', 5}, {'ABRT', 6}, {'BUS', 7},
  {'FPE', 8}, {'KILL', 9}, {'USR1', 10}, {'SEGV', 11}, {'USR2', 12}, {'PIPE', 13},
  {'ALRM', 14}, {'TERM', 15}, {'CHLD', 17}, {'CONT', 18}, {'STOP', 19}, {'TSTP', 20},
  {'TTIN', 21}, {'TTOU', 22}, {'WINCH', 28},
}

global function signum(s: string): cint
  local name = s
  if name.size > 3 and name:sub(1, 3):upper() == 'SIG' then name = name:sub(4) end
  local v, ok = util.toint(name)
  if ok then return (@cint)(v) end
  local up = name:upper()
  for _, sg in ipairs(signals) do if sg.name == up then return sg.num end end
  return -1
end

global function applet_kill(args: sequence(string)): integer
  local sig: cint = 15
  local i: integer = 1
  if #args == 0 then return util.die('usage: kill [-s SIG | -SIG] PID...') end
  if args[1] == '-l' then
    for _, sg in ipairs(signals) do util.line(sg.name) end
    return 0
  end
  if args[1] == '-s' then
    if #args < 2 then return util.die("option requires an argument -- 's'") end
    sig = signum(args[2]); i = 3
  elseif args[1].size > 1 and args[1]:byte(1) == 45 then
    sig = signum(args[1]:sub(2)); i = 2
  end
  if sig < 0 then return util.die("unknown signal '" .. args[i - 1] .. "'") end
  if i > #args then return util.die('missing pid operand') end
  local rc: integer = 0
  for j: integer = i, #args do
    local pid, ok = util.toint(args[j])
    if not ok then util.err("invalid pid '" .. args[j] .. "'"); rc = 1; continue end
    if sys.kill((@cint)(pid), sig) ~= 0 then util.err('(' .. args[j] .. '): ' .. sys.errstr()); rc = 1 end
  end
  return rc
end

global function applet_which(args: sequence(string)): integer
  local o = util.parse(args, '+a')
  if not o:ok() then return util.optfail(o) end
  local path = sys.getenv('PATH')
  local pathstr: string = '/usr/local/bin:/usr/bin:/bin'
  if path ~= nilptr then pathstr = path end
  local rc: integer = 0
  for _, name in ipairs(o.operands) do
    local found = false
    if name:find('/', 1, true) > 0 then
      if sys.access(name, sys.X_OK) == 0 and not util.isdir(name) then util.line(name); found = true end
    else
      local start: usize = 1
      for i: usize = 1, pathstr.size + 1 do
        if i > pathstr.size or pathstr:byte(i) == 58 then
          local dir = i > start and pathstr:sub(start, i - 1) or '.'
          local full = util.join(dir, name)
          if sys.access(full, sys.X_OK) == 0 and not util.isdir(full) then
            util.line(full)
            found = true
            if not o:has('a') then break end
          end
          start = i + 1
        end
      end
    end
    if not found then rc = 1 end
  end
  return rc
end

global function applet_sync(args: sequence(string)): integer
  sys.sync()
  return 0
end

-- date: local time from nelibc's zone handling (TZ, /etc/localtime), -u for
-- UTC; formats go through util.timestr (GNU nstrftime semantics).
global function applet_date(args: sequence(string)): integer
  local o = util.parse(args, 'ud:r:R')
  if not o:ok() then return util.optfail(o) end
  local t: integer
  local ns: integer = 0
  if o:has('r') then
    local st: sys.Stat
    if sys.stat(o:get('r'), &st) ~= 0 then return util.die(o:get('r') .. ': ' .. sys.errstr()) end
    t = st.st_mtim.tv_sec; ns = st.st_mtim.tv_nsec
  elseif o:has('d') then
    local d = o:get('d')
    local ts: sys.Timespec
    sys.clock_gettime(sys.CLOCK_REALTIME, &ts)
    local v, vns, ok = util.getdate(d, ts.tv_sec, ts.tv_nsec)
    if not ok then return util.die("invalid date '" .. d .. "'") end
    t = v; ns = vns
  else
    local ts: sys.Timespec
    sys.clock_gettime(sys.CLOCK_REALTIME, &ts)
    t = ts.tv_sec; ns = ts.tv_nsec
  end
  local fmt: string = '%a %b %e %H:%M:%S %Z %Y'
  if o:has('R') then fmt = '%a, %d %b %Y %H:%M:%S %z' end
  if #o.operands > 1 then return util.die("extra operand '" .. o.operands[2] .. "'") end
  if #o.operands > 0 then
    local f = o.operands[1]
    if f.size == 0 or f:byte(1) ~= 43 then return util.die('setting the date is not supported') end
    if o:has('R') then return util.die('multiple output formats specified') end
    -- "%-N" means as many digits as the clock resolution: 9 here, as in
    -- coreutils' adjust_resolution
    local sb: stringbuilder
    local i: usize = 2
    while i <= f.size do
      local c = f:byte(i)
      if c == 37 and i + 2 <= f.size and f:byte(i + 1) == 45 and f:byte(i + 2) == 78 then
        sb:write('%9N'); i = i + 3
      elseif c == 37 and i + 1 <= f.size and f:byte(i + 1) == 37 then
        sb:write('%%'); i = i + 2
      else
        sb:writebyte(c); i = i + 1
      end
    end
    fmt = sb:promote()
  end
  local tm, ok = util.breaktime(t, ns, o:has('u'))
  if not ok then return util.die(string.format("time '%d' is out of range", t)) end
  util.line(util.timestr(fmt, &tm))
  return 0
end

global function applet_nproc(args: sequence(string)): integer
  local n = util.cpucount()
  if n == 0 then return util.die('sched_getaffinity: ' .. sys.errstr()) end
  util.writef('%d\n', n)
  return 0
end
