-- Process and system applets: true false sleep env printenv uname hostname id
-- kill nproc
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.longopts'

global function applet_true(args: sequence(string)): integer
  return 0
end

global function applet_false(args: sequence(string)): integer
  return 1
end

-- Parse "1.5", "2m", "1h", "3d" style durations into a timespec.
global function parse_duration(s: string, ts: *sys.Timespec): boolean
  if s.size == 0 then return false end
  local mult: float64 = 1
  local body = s
  local last = s:byte(s.size)
  if last == 115 then body = s:sub(1, -2)
  elseif last == 109 then mult = 60; body = s:sub(1, -2)
  elseif last == 104 then mult = 3600; body = s:sub(1, -2)
  elseif last == 100 then mult = 86400; body = s:sub(1, -2) end
  if body.size == 0 then return false end
  local whole: float64 = 0
  local i: usize = 1
  local any = false
  while i <= body.size and body:byte(i) >= 48 and body:byte(i) <= 57 do
    whole = whole * 10 + (body:byte(i) - 48); i = i + 1; any = true
  end
  if i <= body.size and body:byte(i) == 46 then
    i = i + 1
    local scale: float64 = 0.1
    while i <= body.size and body:byte(i) >= 48 and body:byte(i) <= 57 do
      whole = whole + (body:byte(i) - 48) * scale; scale = scale * 0.1; i = i + 1; any = true
    end
  end
  if not any or i <= body.size then return false end
  whole = whole * mult
  ts.tv_sec = (@clong)(whole)
  ts.tv_nsec = (@clong)((whole - (@float64)(ts.tv_sec)) * 1e9)
  return true
end



global function applet_uname(args: sequence(string)): integer
  local o = util.parsel(args, 'asnrvmpio', &longopts.uname, #longopts.uname)
  if not o:ok() then return util.optfail(o) end
  if #o.operands > 0 then return util.die("extra operand '" .. o.operands[1] .. "'") end
  local u: sys.Utsname
  if sys.uname(&u) ~= 0 then return util.die('uname: ' .. sys.errstr()) end
  local all = o:has('a')
  local nothing = not (o:has('s') or o:has('n') or o:has('r') or o:has('v') or o:has('m') or o:has('p') or o:has('i') or o:has('o') or all)
  if nothing then util.line(sys.cstr(&u.sysname)); return 0 end
  local parts: sequence(string)
  if all or o:has('s') then parts:push(sys.cstr(&u.sysname)) end
  if all or o:has('n') then parts:push(sys.cstr(&u.nodename)) end
  if all or o:has('r') then parts:push(sys.cstr(&u.release)) end
  if all or o:has('v') then parts:push(sys.cstr(&u.version)) end
  if all or o:has('m') then parts:push(sys.cstr(&u.machine)) end
  if not all and o:has('p') then parts:push('unknown') end
  if not all and o:has('i') then parts:push('unknown') end
  if all or o:has('o') then parts:push('GNU/Linux') end
  for i, p in ipairs(parts) do
    if i > 1 then util.writebyte(32) end
    util.write(p)
  end
  util.writebyte(10)
  return 0
end

global function applet_hostname(args: sequence(string)): integer
  local buf: [256]cchar
  if sys.gethostname(&buf[0], 256) ~= 0 then return util.die(sys.errstr()) end
  util.line(sys.cstr(&buf[0]))
  return 0
end


local SigName = @record{name: string, num: cint}
local signals: []SigName = {
  {'HUP', 1}, {'INT', 2}, {'QUIT', 3}, {'ILL', 4}, {'TRAP', 5}, {'ABRT', 6}, {'BUS', 7},
  {'FPE', 8}, {'KILL', 9}, {'USR1', 10}, {'SEGV', 11}, {'USR2', 12}, {'PIPE', 13},
  {'ALRM', 14}, {'TERM', 15}, {'CHLD', 17}, {'CONT', 18}, {'STOP', 19}, {'TSTP', 20},
  {'TTIN', 21}, {'TTOU', 22}, {'WINCH', 28},
}

global function signum(s: string): cint
  local name = s
  if name.size > 3 and name:sub(1, 3):upper() == 'SIG' then name = name:sub(4) end
  local v, ok = util.toint(name)
  if ok then return (@cint)(v) end
  local up = name:upper()
  for _, sg in ipairs(signals) do if sg.name == up then return sg.num end end
  return -1
end

global function applet_kill(args: sequence(string)): integer
  local sig: cint = 15
  local i: integer = 1
  if #args == 0 then return util.die('usage: kill [-s SIG | -SIG] PID...') end
  if args[1] == '-l' then
    for _, sg in ipairs(signals) do util.line(sg.name) end
    return 0
  end
  if args[1] == '-s' then
    if #args < 2 then return util.die("option requires an argument -- 's'") end
    sig = signum(args[2]); i = 3
  elseif args[1].size > 1 and args[1]:byte(1) == 45 then
    sig = signum(args[1]:sub(2)); i = 2
  end
  if sig < 0 then return util.die("unknown signal '" .. args[i - 1] .. "'") end
  if i > #args then return util.die('missing pid operand') end
  local rc: integer = 0
  for j: integer = i, #args do
    local pid, ok = util.toint(args[j])
    if not ok then util.err("invalid pid '" .. args[j] .. "'"); rc = 1; continue end
    if sys.kill((@cint)(pid), sig) ~= 0 then util.err('(' .. args[j] .. '): ' .. sys.errstr()); rc = 1 end
  end
  return rc
end
