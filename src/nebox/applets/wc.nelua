-- wc: a port of GNU coreutils 9.1 src/wc.c in the C locale. -c -m -l -w -L
-- in GNU's column order, compute_number_width, --files0-from=F (with its
-- diagnostics), the bytes-only fast path that honours the file offset,
-- counts still printed after a read error, and the "total" line.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'

local function c_exit(status: cint) <cimport 'exit', cinclude '<stdlib.h>', noreturn> end
local function c_getpagesize(): cint <cimport 'getpagesize', cinclude '<unistd.h>'> end

local print_lines: boolean
local print_words: boolean
local print_chars: boolean
local print_bytes: boolean
local print_linelength: boolean
local number_width: integer
local total_lines: uint64
local total_words: uint64
local total_chars: uint64
local total_bytes: uint64
local max_line_length: uint64

local FStatus = @record{failed: integer, st: sys.Stat}

local function write_counts(lines: uint64, words: uint64, chars: uint64, bytes: uint64, linelength: uint64, file: string, has_file: boolean)
  local first = true
  local vals: [5]uint64 = {lines, words, chars, bytes, linelength}
  local on: [5]boolean = {print_lines, print_words, print_chars, print_bytes, print_linelength}
  for k = 0, 4 do
    if on[k] then
      local s = tostring(vals[k])
      if not first then util.writebyte(32) end
      for _ = #s + 1, number_width do util.writebyte(32) end
      util.write(s)
      first = false
    end
  end
  if has_file then
    util.writebyte(32)
    if file:find('\n', 1, true) > 0 then util.write(util.quotef(file)) else util.write(file) end
  end
  util.writebyte(10)
end

local function wc(fd: cint, name: string, has_name: boolean, fs: *FStatus, current_pos: int64): boolean
  local ok = true
  local file = has_name and name or 'standard input'
  local lines, words, chars, bytes, linelength: uint64 = 0, 0, 0, 0, 0
  local count_bytes = print_bytes or print_chars
  local count_complicated = print_words or print_linelength
  local buf: [65536]byte
  if count_bytes and not print_lines and not count_complicated then
    local skip_read = false
    if fs.failed > 0 then fs.failed = sys.fstat(fd, &fs.st) end
    local t = fs.st.st_mode & sys.S_IFMT
    if fs.failed == 0 and (t == sys.S_IFREG or t == 0xA000) and fs.st.st_size >= 0 then
      local end_pos = fs.st.st_size
      if current_pos < 0 then current_pos = sys.lseek(fd, 0, sys.SEEK_CUR) end
      local page = c_getpagesize()
      if end_pos % page ~= 0 then
        bytes = end_pos < current_pos and 0 or (@uint64)(end_pos - current_pos)
        skip_read = true
      else
        local hi_pos = end_pos - end_pos % (fs.st.st_blksize + 1)
        if 0 <= current_pos and current_pos < hi_pos and 0 <= sys.lseek(fd, hi_pos, sys.SEEK_CUR) then
          bytes = (@uint64)(hi_pos - current_pos)
        end
      end
    end
    if not skip_read then
      while true do
        local n = sys.read(fd, &buf, #buf)
        if n < 0 then
          if sys.errno() == sys.EINTR then continue end
          util.err(util.quotef(file) .. ': ' .. sys.errstr()); ok = false; break
        end
        if n == 0 then break end
        bytes = bytes + (@uint64)(n)
      end
    end
  else
    local in_word = false
    local linepos: uint64 = 0
    while true do
      local n = sys.read(fd, &buf, #buf)
      if n < 0 then
        if sys.errno() == sys.EINTR then continue end
        util.err(util.quotef(file) .. ': ' .. sys.errstr()); ok = false; break
      end
      if n == 0 then break end
      bytes = bytes + (@uint64)(n)
      for i = 0, < n do
        local c = buf[i]
        if c == 10 then
          lines = lines + 1
          if linepos > linelength then linelength = linepos end
          linepos = 0
          if in_word then words = words + 1; in_word = false end
        elseif c == 13 or c == 12 then
          if linepos > linelength then linelength = linepos end
          linepos = 0
          if in_word then words = words + 1; in_word = false end
        elseif c == 9 then
          linepos = linepos + 8 - linepos % 8
          if in_word then words = words + 1; in_word = false end
        elseif c == 32 then
          linepos = linepos + 1
          if in_word then words = words + 1; in_word = false end
        elseif c == 11 then
          if in_word then words = words + 1; in_word = false end
        elseif c >= 33 and c <= 126 then
          linepos = linepos + 1
          in_word = true
        end
      end
    end
    if linepos > linelength then linelength = linepos end
    if in_word then words = words + 1 end
  end
  chars = bytes
  write_counts(lines, words, chars, bytes, linelength, name, has_name)
  total_lines = total_lines + lines; total_words = total_words + words
  total_chars = total_chars + chars; total_bytes = total_bytes + bytes
  if linelength > max_line_length then max_line_length = linelength end
  return ok
end

local function wc_file(file: string, has_name: boolean, fs: *FStatus): boolean
  if not has_name or file == '-' then return wc(0, file, has_name, fs, -1) end
  local fd = sys.open(file, sys.O_RDONLY, 0)
  if fd == -1 then util.err(util.quotef(file) .. ': ' .. sys.errstr()); return false end
  local ok = wc(fd, file, true, fs, 0)
  if sys.close(fd) ~= 0 then util.err(util.quotef(file) .. ': ' .. sys.errstr()); return false end
  return ok
end

global function applet_wc(args: sequence(string)): integer
  local DEBUG_PROGRAM_OPTION: integer <comptime> = 200
  local FILES0_FROM_OPTION: integer <comptime> = 201
  local longs: []util.LongOpt = {
    {'bytes', 0, 99}, {'chars', 0, 109}, {'lines', 0, 108}, {'words', 0, 119}, {'debug', 0, DEBUG_PROGRAM_OPTION},
    {'files0-from', 1, FILES0_FROM_OPTION}, {'max-line-length', 0, 76},
    {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
  }
  local g = util.getopt(args, 'clLmw', &longs, #longs)
  g.quiet = true
  print_lines = false; print_words = false; print_chars = false; print_bytes = false; print_linelength = false
  total_lines = 0; total_words = 0; total_chars = 0; total_bytes = 0; max_line_length = 0
  local files_from = ''
  local have_files_from = false
  local function usage_fail(msg: string): integer
    if #msg > 0 then util.err(msg) end
    util.flush()
    local m = "Try 'wc --help' for more information.\n"
    sys.write(2, m.data, m.size)
    return 1
  end
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 63 then return usage_fail(g.errmsg) end
    if c == util.UNSUPPORTED then return usage_fail("option '--" .. g.longname .. "' is not supported") end
    if c == 99 then print_bytes = true elseif c == 109 then print_chars = true
    elseif c == 108 then print_lines = true elseif c == 119 then print_words = true
    elseif c == 76 then print_linelength = true
    elseif c == FILES0_FROM_OPTION then files_from = g.optarg; have_files_from = true end
  end
  if not (print_lines or print_words or print_chars or print_bytes or print_linelength) then
    print_lines = true; print_words = true; print_bytes = true
  end
  local operands = g:operands()
  local names: sequence(string)
  local nfiles = 0
  local stream_names = false
  if have_files_from then
    if #operands > 0 then
      util.err('extra operand ' .. util.quoteaf(operands[1]))
      util.flush()
      local m = 'file operands cannot be combined with --files0-from\n'
      sys.write(2, m.data, m.size)
      return usage_fail('')
    end
    local fd: cint = 0
    if files_from ~= '-' then
      fd = sys.open(files_from, sys.O_RDONLY, 0)
      if fd < 0 then
        util.err('cannot open ' .. util.quoteaf(files_from) .. ' for reading: ' .. sys.errstr()); util.flush(); c_exit(1)
      end
    end
    local st: sys.Stat
    local regular = sys.fstat(fd, &st) == 0 and (st.st_mode & sys.S_IFMT) == sys.S_IFREG
    local data, rok = util.readfd(fd)
    if fd ~= 0 then sys.close(fd) end
    if not rok then
      if regular then util.err('cannot read file names from ' .. util.quoteaf(files_from)); util.flush(); c_exit(1) end
      util.err(util.quotef(files_from) .. ': read error: ' .. sys.errstr())
    end
    -- NUL-separated names; a final name without a NUL still counts
    local start: usize = 0
    for i: usize = 0, < data.size do
      if data.data[i] == 0 then
        names:push((@string){data = &data.data[start], size = i - start})
        start = i + 1
      end
    end
    if start < data.size then names:push((@string){data = &data.data[start], size = data.size - start}) end
    if regular then nfiles = #names else stream_names = true end
  else
    for _, o in ipairs(operands) do names:push(o) end
    -- with no operand GNU still has one (NULL) file: standard input
    nfiles = #names > 0 and #names or 1
  end
  local counts = (print_lines and 1 or 0) + (print_words and 1 or 0) + (print_chars and 1 or 0)
               + (print_bytes and 1 or 0) + (print_linelength and 1 or 0)
  -- get_input_fstatus and compute_number_width
  local fstatus: sequence(FStatus)
  local nstat = nfiles > 0 and nfiles or 1
  fstatus:resize((@usize)(nstat))
  if nfiles == 0 or (nfiles == 1 and counts == 1) then
    fstatus[1].failed = 1
  else
    for i = 1, nfiles do
      local f = i <= #names and names[i] or '-'
      local r: cint
      if f == '-' then r = sys.fstat(0, &fstatus[i].st) else r = sys.stat(f, &fstatus[i].st) end
      fstatus[i].failed = r == 0 and 0 or -1
    end
  end
  number_width = 1
  if nfiles > 0 and fstatus[1].failed <= 0 then
    local minimum = 1
    local regular_total: uint64 = 0
    for i = 1, nfiles do
      if fstatus[i].failed == 0 then
        if (fstatus[i].st.st_mode & sys.S_IFMT) == sys.S_IFREG then regular_total = regular_total + (@uint64)(fstatus[i].st.st_size)
        else minimum = 7 end
      end
    end
    while regular_total >= 10 do regular_total = regular_total // 10; number_width = number_width + 1 end
    if number_width < minimum then number_width = minimum end
  end
  local ok = true
  local processed = 0
  if not have_files_from and #names == 0 then
    processed = 1
    if not wc_file('', false, &fstatus[1]) then ok = false end
  else
    for i = 1, #names do
      processed = processed + 1
      local name = names[i]
      local skip = false
      if have_files_from and files_from == '-' and name == '-' then
        util.err("when reading file names from stdin, no file name of '-' allowed")
        skip = true
      end
      if #name == 0 then
        if not have_files_from then util.err('invalid zero-length file name')
        else util.err(util.quotef(files_from) .. ':' .. tostring(i) .. ': invalid zero-length file name') end
        skip = true
      end
      local fs = &fstatus[nfiles > 0 and i or 1]
      if skip then ok = false
      elseif not wc_file(name, true, fs) then ok = false end
      if nfiles == 0 then fstatus[1].failed = 1 end
    end
  end
  if processed > 1 then
    write_counts(total_lines, total_words, total_chars, total_bytes, max_line_length, 'total', true)
  end
  util.flush()
  return ok and 0 or 1
end
