-- More filesystem applets: du stat chown chgrp mktemp truncate realpath link unlink
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.longopts'
require 'nebox.clock'

-- Directory children, sorted, without . and ..
local function children(path: string): sequence(string)
  local out: sequence(string)
  local names, ok = util.readnames(path, true)
  if not ok then return out end
  for _, n in ipairs(names) do
    if n ~= '.' and n ~= '..' then out:push(n) end
  end
  return out
end

-- du
local Du = @record{
  summarize: boolean, all: boolean, apparent: boolean, human: boolean,
  bytes: boolean, total: integer, rc: integer, deref: boolean,
}

function Du:fmt(n: integer): string
  -- n is in bytes when apparent/bytes, else in 512-byte blocks
  if self.bytes then return string.format('%d', n) end
  if self.apparent then
    if self.human then return util.human(n) end
    return string.format('%d', (n + 1023) // 1024)
  end
  if self.human then return util.human(n * 512) end
  return string.format('%d', (n + 1) // 2)
end

function Du:size_of(st: *sys.Stat): integer
  if self.apparent or self.bytes then return st.st_size end
  return st.st_blocks
end

-- Returns the size (blocks or bytes) of path including its children.
function Du:walk(path: string, top: boolean): integer
  local st: sys.Stat
  local r: cint
  if self.deref or top then r = sys.stat(path, &st) else r = sys.lstat(path, &st) end
  if r ~= 0 then
    if sys.lstat(path, &st) ~= 0 then
      util.err("du: cannot access '" .. path .. "': " .. sys.errstr()); self.rc = 1; return 0
    end
  end
  local total = self:size_of(&st)
  if (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then
    for _, name in ipairs(children(path)) do
      total = total + self:walk(util.join(path, name), false)
    end
    if not self.summarize or top then util.line(self:fmt(total) .. '\t' .. path) end
  elseif self.all or top then
    util.line(self:fmt(total) .. '\t' .. path)
  end
  return total
end


-- stat
local function filetype(mode: cuint, size: integer): string
  local t = mode & sys.S_IFMT
  if t == sys.S_IFREG then return size == 0 and 'regular empty file' or 'regular file'
  elseif t == sys.S_IFDIR then return 'directory'
  elseif t == sys.S_IFLNK then return 'symbolic link'
  elseif t == sys.S_IFCHR then return 'character special file'
  elseif t == sys.S_IFBLK then return 'block special file'
  elseif t == sys.S_IFIFO then return 'fifo'
  elseif t == sys.S_IFSOCK then return 'socket' end
  return 'weird file'
end



-- chown / chgrp
local Chown = @record{ uid: integer, gid: integer, recursive: boolean, nofollow: boolean, verbose: boolean, rc: integer }

function Chown:apply(path: string)
  local st: sys.Stat
  if sys.lstat(path, &st) ~= 0 then
    util.err(util.applet .. ": cannot access '" .. path .. "': " .. sys.errstr()); self.rc = 1; return
  end
  local uid: cuint = self.uid >= 0 and (@cuint)(self.uid) or 0xFFFFFFFF
  local gid: cuint = self.gid >= 0 and (@cuint)(self.gid) or 0xFFFFFFFF
  local r: cint
  if self.nofollow or (st.st_mode & sys.S_IFMT) == sys.S_IFLNK then r = sys.lchown(path, uid, gid)
  else r = sys.chown(path, uid, gid) end
  if r ~= 0 then
    util.err(util.applet .. ": changing ownership of '" .. path .. "': " .. sys.errstr()); self.rc = 1
  elseif self.verbose then
    util.line("ownership of '" .. path .. "' retained")
  end
  if self.recursive and (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then
    for _, name in ipairs(children(path)) do self:apply(util.join(path, name)) end
  end
end


-- mktemp: replace the trailing XXXXXX run with random letters/digits
local function fill_template(t: string): (string, boolean)
  local n: usize = 0
  while n < t.size and t:byte(t.size - n) == 88 do n = n + 1 end
  if n < 3 then return t, false end
  local rnd: [64]byte
  sys.getrandom(&rnd[0], n, 0)
  local alphabet: string = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
  local sb: stringbuilder
  sb:write(t:sub(1, t.size - n))
  for i: usize = 0, < n do sb:writebyte(alphabet:byte((rnd[i] % 62) + 1)) end
  return sb:promote(), true
end


-- truncate: -s [+-]SIZE, -c no-create, -r REF
global function applet_truncate(args: sequence(string)): integer
  local o = util.parsel(args, 'cos:r:', &longopts.truncate, #longopts.truncate)
  if not o:ok() then return util.optfail(o) end
  if not o:has('s') and not o:has('r') then return util.die('you must specify either -s or -r') end
  if #o.operands == 0 then return util.die('missing file operand') end
  local rel: integer = 0   -- 0 absolute, 1 extend, -1 shrink, 2 at-least, 3 at-most
  local size: integer = 0
  if o:has('r') then
    local st: sys.Stat
    if sys.stat(o:get('r'), &st) ~= 0 then return util.die("cannot stat '" .. o:get('r') .. "': " .. sys.errstr()) end
    size = st.st_size
  end
  if o:has('s') then
    local spec = o:get('s')
    local first = spec:byte(1)
    if first == 43 then rel = 1; spec = spec:sub(2)
    elseif first == 45 then rel = -1; spec = spec:sub(2)
    elseif first == 62 then rel = 2; spec = spec:sub(2)
    elseif first == 60 then rel = 3; spec = spec:sub(2) end
    local v, ok = util.tosize(spec)
    if not ok then return util.die("invalid number: '" .. o:get('s') .. "'") end
    size = v
  end
  local rc: integer = 0
  for _, p in ipairs(o.operands) do
    local st: sys.Stat
    if sys.stat(p, &st) ~= 0 then
      if o:has('c') then continue end
      local fd = sys.open(p, sys.O_WRONLY | sys.O_CREAT, 0x1B6)
      if fd < 0 then util.perror(p); rc = 1; continue end
      sys.close(fd)
      st.st_size = 0
    end
    local target = size
    if rel == 1 then target = st.st_size + size
    elseif rel == -1 then target = st.st_size - size
    elseif rel == 2 then target = st.st_size > size and st.st_size or size
    elseif rel == 3 then target = st.st_size < size and st.st_size or size end
    if target < 0 then target = 0 end
    if sys.truncate(p, target) ~= 0 then
      util.err("truncate: cannot open '" .. p .. "' for writing: " .. sys.errstr()); rc = 1
    end
  end
  return rc
end

-- realpath: like readlink -f; -e all must exist, -m nothing need exist, -s no symlink resolution
local function absolute(p: string): string
  if p.size > 0 and p:byte(1) == 47 then return p end
  local buf: [4096]cchar
  if sys.getcwd(&buf[0], #buf) == nilptr then return p end
  return util.join(sys.cstr(&buf[0]), p)
end

-- Lexically normalise: collapse //, ., and .. segments.
local function normalize(p: string): string
  local parts: sequence(string)
  local start: usize = 1
  while start <= p.size + 1 do
    local slash = p:find('/', start, true)
    local seg: string
    if slash <= 0 then seg = p:sub(start) else seg = p:sub(start, slash - 1) end
    if seg == '..' then
      if #parts > 0 then parts:remove(#parts) end
    elseif seg.size > 0 and seg ~= '.' then
      parts:push(seg)
    end
    if slash <= 0 then break end
    start = (@usize)(slash) + 1
  end
  local sb: stringbuilder
  for _, s in ipairs(parts) do sb:write('/'); sb:write(s) end
  if #parts == 0 then return '/' end
  return sb:promote()
end


global function applet_link(args: sequence(string)): integer
  if #args ~= 2 then
    if #args < 2 then return util.die(#args == 0 and 'missing operand' or ("missing operand after '" .. args[1] .. "'")) end
    return util.die("extra operand '" .. args[3] .. "'")
  end
  if sys.link(args[1], args[2]) ~= 0 then
    return util.die("cannot create link '" .. args[2] .. "' to '" .. args[1] .. "': " .. sys.errstr())
  end
  return 0
end

global function applet_unlink(args: sequence(string)): integer
  if #args ~= 1 then
    if #args == 0 then return util.die('missing operand') end
    return util.die("extra operand '" .. args[2] .. "'")
  end
  if sys.unlink(args[1]) ~= 0 then return util.die("cannot unlink '" .. args[1] .. "': " .. sys.errstr()) end
  return 0
end
