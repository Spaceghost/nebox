-- hexdump, hd: a port of util-linux 2.38.1 text-utils/hexdump.c,
-- hexdump-parse.c, hexdump-display.c and hexdump-conv.c, with the pieces of
-- lib/strutils.c (parse_size), lib/colors.c and lib/color-names.c (the
-- --color modes, terminal-colors.d enable/disable files, the terminfo
-- "colors" check, the color names) and include/closestream.h they use.
-- The -e/-f format language is handled as the C code handles it: format
-- strings live in NUL-terminated byte buffers that are edited in place
-- (escape(), the conversion rewrite, bpad(), the trailing-space cut), and
-- every conversion goes through snprintf with the rewritten printf format.
-- Input is read the way glibc's stdio reads a freopen()ed stdin (buffer of
-- st_blksize, fseek's block-aligned seek), output is a stdout buffer with
-- glibc's flush points and close_stdout's "write error" rules.
-- Where the C code reads past the end of a string (a '%' or "%_a" at the
-- very end of a format unit) the bytes after the NUL are zeros and then
-- an 'A', the usual heap layout on the reference; the result there is
-- undefined in the original and noted in the README.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'memory'
require 'nebox.sys'
require 'nebox.util'

local function c_exit(status: cint) <cimport 'exit', cinclude '<stdlib.h>', noreturn> end
local function c_calloc(n: csize, sz: csize): pointer <cimport 'calloc', cinclude '<stdlib.h>'> end
local function c_free(p: pointer) <cimport 'free', cinclude '<stdlib.h>'> end
local function c_snprintf(buf: cstring, n: csize, fmt: cstring, ...: cvarargs): cint <cimport 'snprintf', cinclude '<stdio.h>'> end
local function c_getpid(): cint <cimport 'getpid', cinclude '<unistd.h>'> end

local EBADF <comptime> = 9
local EINVAL <comptime> = 22
local ERANGE <comptime> = 34
local EPIPE <comptime> = 32

local F_ADDRESS <comptime> = 0x001
local F_BPAD <comptime> = 0x002
local F_C <comptime> = 0x004
local F_CHAR <comptime> = 0x008
local F_DBL <comptime> = 0x010
local F_INT <comptime> = 0x020
local F_P <comptime> = 0x040
local F_STR <comptime> = 0x080
local F_U <comptime> = 0x100
local F_UINT <comptime> = 0x200
local F_TEXT <comptime> = 0x400

local F_IGNORE <comptime> = 0x01
local F_SETREP <comptime> = 0x02

local V_ALL <comptime> = 0
local V_DUP <comptime> = 1
local V_FIRST <comptime> = 2
local V_WAIT <comptime> = 3

local CM_AUTO <comptime> = 0
local CM_NEVER <comptime> = 1
local CM_ALWAYS <comptime> = 2
local CM_UNDEF <comptime> = 3

local Clr = @record{
  fmt: string,       -- the escape sequence
  offt: int64,       -- offset where the unit is valid ...
  range: int32,      -- ... and its range
  val: int32,        -- value ...
  has_str: boolean,  -- ... or string to match
  str: *[0]byte,
  invert: boolean,
}

local Pr = @record{
  flags: integer,
  bcnt: integer,
  cchar: integer,    -- index of the conversion character in fmt
  has_colors: boolean,
  colors: sequence(Clr),
  fmt: *[0]byte,
  nospace: integer,  -- index of the trailing blank, or -1
}

local Fu = @record{
  prs: sequence(*Pr),
  flags: integer,
  reps: integer,
  bcnt: integer,
  fmt: *[0]byte,
}

local Fs = @record{
  fus: sequence(*Fu),
  bcnt: integer,
}

local fshead: sequence(*Fs)
local blocksize: integer = 0
local exitval: integer = 0
local length: int64 = -1
local skip: int64 = 0
local endfu: *Fu = nilptr
local vflag: integer = V_FIRST
local address: int64 = 0
local eaddress: int64 = 0
local has_colors = false

----------------------------------------------------------------------------
-- C string helpers over padded buffers

local PAD <comptime> = 40

local function isspace(c: byte): boolean return c == 32 or (c >= 9 and c <= 13) end
local function isdigit(c: byte): boolean return c >= 48 and c <= 57 end
local function isprint(c: byte): boolean return c >= 32 and c <= 126 end

-- strchr(set, c) ~= NULL: the terminating NUL is always found
local function inset(set: string, c: byte): boolean
  if c == 0 then return true end
  for i = 1, #set do if set:byte(i) == c then return true end end
  return false
end

local function bytes_alloc(n: integer): *[0]byte
  return (@*[0]byte)(c_calloc((@csize)(n), 1))
end

-- a copy of n bytes, NUL-terminated, then zeros and an 'A' as heap bytes
local function cbuf(src: *[0]byte, n: integer): *[0]byte
  local b = bytes_alloc(n + PAD)
  for i = 0, < n do b[i] = src[i] end
  b[n + 8] = 65
  return b
end

local function cstrlen(p: *[0]byte, i: integer): integer
  local n = 0
  while p[i + n] ~= 0 do n = n + 1 end
  return n
end

local function cview(p: *[0]byte, i: integer): string
  local n = cstrlen(p, i)
  if n == 0 then return '' end
  return (@string){data = &p[i], size = (@usize)(n)}
end

local function cbuf_s(s: string): *[0]byte
  local n = 0
  while n < (@integer)(#s) and s.data[n] ~= 0 do n = n + 1 end
  if n == 0 then return bytes_alloc(PAD) end
  return cbuf(s.data, n)
end

----------------------------------------------------------------------------
-- stdout as glibc buffers it, closed as close_stdout() closes it

local obuf: *[0]byte = nilptr
local olen: integer = 0
local ocap: integer = 0
local olinebuf = false
local ofail = false
local oerrno: cint = 0

local function oinit()
  if ocap > 0 then return end
  ocap = 8192
  local st: sys.Stat
  if sys.fstat(1, &st) == 0 then
    if (st.st_mode & sys.S_IFMT) == sys.S_IFCHR and sys.isatty(1) == 1 then olinebuf = true end
    if st.st_blksize > 0 and st.st_blksize < 8192 then ocap = st.st_blksize end
  end
  obuf = bytes_alloc(ocap)
end

local function oflush(): boolean
  local done = 0
  while done < olen do
    local r = sys.write(1, &obuf[done], (@usize)(olen - done))
    if r < 0 then
      if sys.errno() == sys.EINTR then continue end
      ofail = true; oerrno = sys.errno(); olen = 0
      return false
    end
    done = done + r
  end
  olen = 0
  return true
end

local function oput(p: *[0]byte, n: integer)
  oinit()
  for i = 0, < n do
    if olen >= ocap then oflush() end
    obuf[olen] = p[i]
    olen = olen + 1
    if olinebuf and p[i] == 10 then oflush() end
  end
end

local function ostr(s: string)
  if #s > 0 then oput(s.data, #s) end
end

local in_sync: function(): void

local function finish(status: integer)
  -- flush_standard_stream(stdout), then exit
  local fail = false
  local e: cint = 0
  if ofail then
    fail = true
  elseif olen > 0 and not oflush() then
    fail = true; e = oerrno
  end
  if fail and e == EBADF then fail = false end
  if fail and e ~= EPIPE then
    if e ~= 0 then util.err('write error: ' .. sys.strerror(e)) else util.err('write error') end
    sys._exit(1)
  end
  -- exit(): glibc's _IO_unbuffer_all syncs stdin back to what was used
  if in_sync then in_sync() end
  c_exit(status)
end

local function errx(msg: string)
  util.err(msg)
  finish(1)
end

local function errno_msg(msg: string, e: cint)
  util.err(msg .. ': ' .. sys.strerror(e))
end

local function crash()
  -- the C code dereferences NULL here
  sys.kill(c_getpid(), 11)
  sys._exit(139)
end

----------------------------------------------------------------------------
-- numbers: strtol/strtoul/strtoumax as glibc does them

local UMAX: uint64 = ~(@uint64)(0)

local function digitval(c: byte): integer
  if c >= 48 and c <= 57 then return c - 48 end
  if c >= 97 and c <= 122 then return c - 87 end
  if c >= 65 and c <= 90 then return c - 55 end
  return 99
end

-- returns value, end index, ERANGE flag (value is ULONG_MAX then)
local function strtoul_at(b: *[0]byte, start: integer, base: integer): (uint64, integer, boolean)
  local s = start
  while isspace(b[s]) do s = s + 1 end
  local neg = false
  if b[s] == 45 then neg = true; s = s + 1 elseif b[s] == 43 then s = s + 1 end
  if base == 0 then
    if b[s] == 48 then
      if b[s + 1] == 120 or b[s + 1] == 88 then s = s + 2; base = 16 else base = 8 end
    else
      base = 10
    end
  elseif base == 16 and b[s] == 48 and (b[s + 1] == 120 or b[s + 1] == 88) then
    s = s + 2
  end
  local save = s
  local v: uint64 = 0
  local over = false
  local ubase = (@uint64)(base)
  local cutoff = UMAX // ubase
  local cutlim = UMAX % ubase
  while true do
    local d = digitval(b[s])
    if d >= base then break end
    local ud = (@uint64)(d)
    if v > cutoff or (v == cutoff and ud > cutlim) then over = true
    else v = v * ubase + ud end
    s = s + 1
  end
  if s == save then
    if save - start >= 2 and (b[save - 1] == 120 or b[save - 1] == 88) and b[save - 2] == 48 then
      return 0, save - 1, false
    end
    return 0, start, false
  end
  if over then return UMAX, s, true end
  if neg then v = (~v) + 1 end
  return v, s, false
end

-- next_number(): strtol base 10 on a string that starts with a digit;
-- false when it overflows a long
local function next_number(b: *[0]byte, start: integer): (boolean, int64, integer)
  local v, e, over = strtoul_at(b, start, 10)
  if over or v > (@uint64)(0x7fffffffffffffff) then return false, 0, e end
  return true, (@int64)(v), e
end

-- lib/strutils.c parse_size(); returns errno-style code (0 on success)
local function parse_size(str: string): (integer, uint64)
  local b = cbuf_s(str)
  local n = cstrlen(b, 0)
  -- bytes past the terminating NUL belong to the next argument: not NUL
  local function at(b: *[0]byte, n: integer, i: integer): byte
    if i > n then return 1 end
    return b[i]
  end
  if n == 0 then return EINVAL, 0 end
  local p = 0
  while isspace(b[p]) do p = p + 1 end
  if b[p] == 45 then return EINVAL, 0 end
  local x, e, over = strtoul_at(b, 0, 0)
  if e == 0 then return EINVAL, 0 end
  if over then return ERANGE, 0 end
  if b[e] == 0 then return 0, x end
  p = e
  local base: uint64 = 1024
  local frac: uint64 = 0
  local frac_zeros = 0
  local pwr = 0
  while true do
    -- check_suffix:
    if at(b, n, p + 1) == 105 and (at(b, n, p + 2) == 66 or at(b, n, p + 2) == 98) and at(b, n, p + 3) == 0 then
      base = 1024
    elseif (at(b, n, p + 1) == 66 or at(b, n, p + 1) == 98) and at(b, n, p + 2) == 0 then
      base = 1000
    elseif at(b, n, p + 1) ~= 0 then
      if frac == 0 and at(b, n, p) ~= 0 and b[p] == 46 then
        local fstr = p + 1
        p = fstr
        while b[p] == 48 do frac_zeros = frac_zeros + 1; p = p + 1 end
        fstr = p
        local fend: integer
        if isdigit(b[fstr]) then
          local fv, fe, fover = strtoul_at(b, fstr, 0)
          if fe == fstr then return EINVAL, 0 end
          if fover then return ERANGE, 0 end
          frac = fv
          fend = fe
        else
          fend = p
        end
        if frac ~= 0 and b[fend] == 0 then return EINVAL, 0 end
        p = fend
        continue
      end
      return EINVAL, 0
    end
    break
  end
  local suf = 'KMGTPEZY'
  local suf2 = 'kmgtpezy'
  local c = at(b, n, p)
  pwr = 0
  if c == 0 then
    pwr = 9  -- strchr() finds the terminator
  else
    for i = 1, 8 do
      if suf:byte(i) == c or suf2:byte(i) == c then pwr = i; break end
    end
    if pwr == 0 then return EINVAL, 0 end
  end
  local rc = 0
  for _ = 1, pwr do
    if UMAX // base < x then rc = ERANGE; break end
    x = x * base
  end
  if frac ~= 0 and pwr ~= 0 then
    local frac_div: uint64 = 10
    local frac_poz: uint64 = 1
    local frac_base: uint64 = 1
    for _ = 1, pwr do
      if UMAX // base < frac_base then break end
      frac_base = frac_base * base
    end
    while frac_div < frac do
      if frac_div <= UMAX // 10 then frac_div = frac_div * 10 else frac = frac // 10 end
    end
    for _ = 1, frac_zeros do
      if frac_div <= UMAX // 10 then frac_div = frac_div * 10 else frac = frac // 10 end
    end
    repeat
      local seg = frac % 10
      local seg_div = frac_div // frac_poz
      frac = frac // 10
      frac_poz = frac_poz * 10
      if seg ~= 0 and seg_div // seg ~= 0 then x = x + frac_base // (seg_div // seg) end
    until frac == 0
  end
  if rc ~= 0 then return rc, 0 end
  return 0, x
end

local function strtosize_or_err(str: string, msg: string): uint64
  local rc, v = parse_size(str)
  if rc ~= 0 then
    errno_msg(msg .. ": '" .. str .. "'", (@cint)(rc))
    finish(1)
  end
  return v
end

----------------------------------------------------------------------------
-- colors (lib/colors.c, lib/color-names.c)

local color_names: []string = {
  'black', 'blink', 'blue', 'bold', 'brown', 'cyan', 'darkgray', 'gray', 'green', 'halfbright',
  'lightblue', 'lightcyan', 'lightgray,', 'lightgreen', 'lightmagenta', 'lightred', 'magenta',
  'red', 'reset', 'reverse', 'yellow', 'white',
}
local color_seqs: []string = {
  '\27[30m', '\27[5m', '\27[34m', '\27[1m', '\27[33m', '\27[36m', '\27[1;30m', '\27[37m', '\27[32m', '\27[2m',
  '\27[1;34m', '\27[1;36m', '\27[37m', '\27[1;32m', '\27[1;35m', '\27[1;31m', '\27[35m',
  '\27[31m', '\27[0m', '\27[7m', '\27[1;33m', '\27[1;37m',
}

local function strcmp(a: string, b: string): integer
  local n = #a < #b and #a or #b
  for i = 1, n do
    local x, y = a:byte(i), b:byte(i)
    if x ~= y then return (@integer)(x) - (@integer)(y) end
  end
  return (@integer)(#a) - (@integer)(#b)
end

-- glibc bsearch over the table as it is (it is not quite sorted)
local function color_sequence_from_colorname(s: string): (boolean, string)
  local l: integer = 0
  local u: integer = #color_names
  while l < u do
    local idx = (l + u) // 2
    local c = strcmp(s, color_names[idx])
    if c < 0 then u = idx
    elseif c > 0 then l = idx + 1
    else return true, color_seqs[idx] end
  end
  return false, ''
end

local function colormode_or_err(str: string, msg: string): integer
  local p = str
  if #p > 0 and p:byte(1) == 61 then p = p:sub(2) end
  local modes: []string = {'auto', 'never', 'always', ''}
  if #p > 0 then
    for i = 0, < 4 do
      local m = modes[i]
      if #m == #p then
        local same = true
        for k = 1, #p do
          local c = p:byte(k)
          if c >= 65 and c <= 90 then c = c + 32 end
          if c ~= m:byte(k) then same = false; break end
        end
        if same then return i end
      end
    end
  end
  errx(msg .. ": '" .. p .. "'")
  return 0
end

-- setupterm() + tigetnum("colors") through the compiled terminfo entry
local function terminfo_colors(term: string): integer
  if #term == 0 then return -1 end
  local dirs: sequence(string)
  local ti = sys.getenv('TERMINFO')
  if ti ~= nilptr then dirs:push(ti) end
  local home = sys.getenv('HOME')
  if home ~= nilptr then dirs:push((@string)(home) .. '/.terminfo') end
  local tdirs = sys.getenv('TERMINFO_DIRS')
  if tdirs ~= nilptr then
    local s: string = tdirs
    local start = 1
    for i = 1, #s + 1 do
      if i > #s or s:byte(i) == 58 then
        local d = s:sub(start, i - 1)
        if #d == 0 then dirs:push('/etc/terminfo'); dirs:push('/lib/terminfo'); dirs:push('/usr/share/terminfo')
        else dirs:push(d) end
        start = i + 1
      end
    end
  end
  dirs:push('/etc/terminfo'); dirs:push('/lib/terminfo'); dirs:push('/usr/share/terminfo')
  for _, d in ipairs(dirs) do
    local c1 = term:sub(1, 1)
    local paths: [2]string = {d .. '/' .. c1 .. '/' .. term, d .. '/' .. string.format('%02x', term:byte(1)) .. '/' .. term}
    for k = 0, < 2 do
      local fd = sys.open(paths[k], 0, 0)
      local data: string = ''
      local ok = false
      if fd >= 0 then data, ok = util.readfd(fd); sys.close(fd) end
      if ok and #data >= 12 then
        local function u16(s: string, i: integer): integer return (@integer)(s:byte(i + 1)) | ((@integer)(s:byte(i + 2)) << 8) end
        local magic = u16(data, 0)
        local numsize = 0
        if magic == 0x011a then numsize = 2 elseif magic == 0x021e then numsize = 4 end
        if numsize > 0 then
          local names = u16(data, 2)
          local nbools = u16(data, 4)
          local nnums = u16(data, 6)
          local off = 12 + names + nbools
          if off % 2 == 1 then off = off + 1 end
          if nnums <= 13 then return -1 end
          local at = off + 13 * numsize
          if at + numsize > #data then return -1 end
          local v: integer
          if numsize == 2 then
            v = u16(data, at)
            if v >= 0x8000 then v = v - 0x10000 end
          else
            v = u16(data, at) | (u16(data, at + 2) << 16)
            if v >= 0x80000000 then v = v - 0x100000000 end
          end
          return v
        end
        return -1
      end
    end
  end
  return -1
end

local function colors_terminal_is_ready(): boolean
  local t = sys.getenv('TERM')
  if t == nilptr then return false end
  return terminfo_colors(t) > 1
end

-- terminal-colors.d: the best "disable" and "enable" scores for this util
local function colors_readdir(dirname: string, util_name: string, term: string, scores: *[3]integer): integer
  local dir = sys.opendir(dirname)
  if dir == nilptr then return -(@integer)(sys.errno()) end
  while true do
    local ent = sys.readdir(dir)
    if ent == nilptr then break end
    local name: string = (@cstring)(&ent.d_name[0])
    if #name == 0 or name:byte(1) == 46 then goto next_ent end
    if ent.d_type ~= 0 and ent.d_type ~= 10 and ent.d_type ~= 8 then goto next_ent end
    do
      local dot = 0
      for i = #name, 1, -1 do if name:byte(i) == 46 then dot = i; break end end
      local type_start = dot + 1
      local ty = name:sub(type_start)
      local t = -1
      if ty == 'disable' then t = 0 elseif ty == 'enable' then t = 1 elseif ty == 'scheme' then t = 2 end
      if t < 0 then goto next_ent end
      local score = 1
      local tk_name, tk_term = false, false
      local tk_namesz, tk_termsz = 0, 0
      local nm, tm = '', ''
      if type_start ~= 1 then
        local at = 0
        for i = 1, #name do if name:byte(i) == 64 then at = i; break end end
        local p = type_start
        local only_term = false
        if at > 0 then
          tk_term = true
          tk_termsz = type_start - (at + 1) - 1
          if tk_termsz > 0 then tm = name:sub(at + 1, at + tk_termsz) end
          if at == 1 then only_term = true end
          p = at + 1
        end
        if not only_term then
          tk_name = true
          tk_namesz = p - 1 - 1
          if tk_namesz > 0 then nm = name:sub(1, tk_namesz) end
        end
      end
      if tk_name then score = score + 20 end
      if tk_term then score = score + 10 end
      if score < scores[t] then goto next_ent end
      if tk_namesz ~= 0 and nm ~= util_name then goto next_ent end
      if tk_termsz ~= 0 and (#term == 0 or tm ~= term) then goto next_ent end
      scores[t] = score
    end
    ::next_ent::
  end
  sys.closedir(dir)
  return 0
end

local function colors_init(mode: integer, name: string)
  local ready = -1
  if mode ~= CM_ALWAYS and sys.isatty(1) ~= 1 then mode = CM_NEVER end
  if mode == CM_UNDEF then
    ready = colors_terminal_is_ready() and 1 or 0
    if ready == 1 then
      local scores: [3]integer = {0, 0, 0}
      local t = sys.getenv('TERM')
      local term: string = t ~= nilptr and (@string)(t) or ''
      local rc = -2
      local x = sys.getenv('XDG_CONFIG_HOME')
      local h = sys.getenv('HOME')
      if x ~= nilptr then rc = colors_readdir((@string)(x) .. '/terminal-colors.d', name, term, &scores)
      elseif h ~= nilptr then rc = colors_readdir((@string)(h) .. '/.config/terminal-colors.d', name, term, &scores) end
      if rc == -1 or rc == -13 or rc == -2 then rc = colors_readdir('/etc/terminal-colors.d', name, term, &scores) end
      if rc ~= 0 then mode = CM_AUTO
      elseif scores[0] > scores[1] then mode = CM_NEVER
      else mode = CM_AUTO end
    end
  end
  if mode == CM_AUTO then
    if ready == -1 then has_colors = colors_terminal_is_ready() else has_colors = ready == 1 end
  elseif mode == CM_ALWAYS then
    has_colors = true
  else
    has_colors = false
  end
end

----------------------------------------------------------------------------
-- hexdump-parse.c

local function badcnt(s: string) errx('bad byte count for conversion character ' .. s) end
local function badsfmt() errx('%s requires a precision or a byte count') end
local function badfmt(fmt: string) errx('bad format {' .. fmt .. '}') end
local function badconv(ch: string) errx('bad conversion character %' .. ch) end

local function escape(b: *[0]byte)
  local p1, p2 = 0, 0
  while true do
    if b[p1] == 0 then b[p2] = b[p1]; break end
    if b[p1] == 92 then
      p1 = p1 + 1
      local c = b[p1]
      if c == 97 then c = 7 elseif c == 98 then c = 8 elseif c == 102 then c = 12
      elseif c == 110 then c = 10 elseif c == 114 then c = 13 elseif c == 116 then c = 9
      elseif c == 118 then c = 11 end
      b[p2] = c
    end
    p1 = p1 + 1; p2 = p2 + 1
  end
end

local function skip_space(b: *[0]byte, p: integer): integer
  while isspace(b[p]) do p = p + 1 end
  return p
end

local function add_fmt(fmt_s: string)
  local fmt = cbuf_s(fmt_s)
  local tfs = new(@Fs)
  fshead:push(tfs)
  local p = 0
  while true do
    p = skip_space(fmt, p)
    if fmt[p] == 0 then break end
    local tfu = new(@Fu)
    tfu.reps = 1
    tfs.fus:push(tfu)
    if isdigit(fmt[p]) then
      local ok, v, e = next_number(fmt, p)
      if not ok or (not isspace(fmt[e]) and fmt[e] ~= 47) then badfmt(cview(fmt, 0)) end
      tfu.reps = (@int32)(v)
      tfu.flags = F_SETREP
      p = skip_space(fmt, e + 1)
    end
    if fmt[p] == 47 then p = skip_space(fmt, p + 1) end
    if isdigit(fmt[p]) then
      local ok, v, e = next_number(fmt, p)
      if not ok or not isspace(fmt[e]) then badfmt(cview(fmt, 0)) end
      tfu.bcnt = (@int32)(v)
      p = skip_space(fmt, e + 1)
    end
    if fmt[p] ~= 34 then badfmt(cview(fmt, 0)) end
    p = p + 1
    local savep = p
    while fmt[p] ~= 34 do
      local c = fmt[p]
      p = p + 1
      if c == 0 then badfmt(cview(fmt, 0)) end
    end
    tfu.fmt = cbuf(&fmt[savep], p - savep)
    escape(tfu.fmt)
    p = p + 1
  end
end

local function addfile(name: string)
  local fd = sys.open(name, 0, 0)
  if fd < 0 then
    errno_msg("can't read " .. name, sys.errno())
    finish(1)
  end
  local data: sequence(byte)
  local buf: [8192]byte
  while true do
    local r = sys.read(fd, &buf[0], #buf)
    if r < 0 and sys.errno() == sys.EINTR then continue end
    if r <= 0 then break end
    for i = 0, < r do data:push(buf[i]) end
  end
  sys.close(fd)
  local i = 1
  local n = #data
  while i <= n do
    local j = i
    while j <= n and data[j] ~= 10 do j = j + 1 end
    local e = j <= n and j or n   -- the line includes its newline
    -- the line as a C string
    local k = i
    while k <= e and data[k] ~= 0 do k = k + 1 end
    local s = i
    while s < k and isspace(data[s]) do s = s + 1 end
    if s < k and data[s] ~= 35 then
      add_fmt((@string){data = &data[s], size = (@usize)(k - s)})
    end
    i = e + 1
  end
  data:destroy()
end

local spec = '.#-+ 0123456789'
local spec1 = '#-+ 0123456789'

local function block_size(fs: *Fs): integer
  local cursize = 0
  for _, fu in ipairs(fs.fus) do
    if fu.bcnt ~= 0 then
      cursize = cursize + fu.bcnt * fu.reps
      goto next_fu
    end
    do
      local bcnt, prec = 0, 0
      local f = fu.fmt
      local i = 0
      while f[i] ~= 0 do
        if f[i] ~= 37 then i = i + 1; goto next_ch end
        i = i + 1
        while inset(spec1, f[i]) do i = i + 1 end
        if f[i] == 46 then
          i = i + 1
          if isdigit(f[i]) then
            local ok, v, e = next_number(f, i)
            if not ok then crash() end
            prec = (@int32)(v)
            i = e
          end
        end
        if inset('diouxX', f[i]) then bcnt = bcnt + 4
        elseif inset('efgEG', f[i]) then bcnt = bcnt + 8
        elseif f[i] == 115 then bcnt = bcnt + prec
        elseif f[i] == 99 then bcnt = bcnt + 1
        elseif f[i] == 95 then
          i = i + 1
          if inset('cpu', f[i]) then bcnt = bcnt + 1 end
        end
        i = i + 1
        ::next_ch::
      end
      cursize = cursize + bcnt * fu.reps
    end
    ::next_fu::
  end
  return cursize
end

-- strndup(s + i, n) with n a size_t (a negative n copies to the NUL)
local function strndup_at(b: *[0]byte, i: integer, n: integer): *[0]byte
  local len = cstrlen(b, i)
  if n >= 0 and n < len then len = n end
  return cbuf(&b[i], len)
end

local function strcspn_at(b: *[0]byte, i: integer, set: string): integer
  local n = 0
  while b[i + n] ~= 0 do
    local c = b[i + n]
    for k = 1, #set do if set:byte(k) == c then return n end end
    n = n + 1
  end
  return n
end

local function strrchr_at(b: *[0]byte, i: integer, c: byte): integer
  local r = -1
  while b[i] ~= 0 do
    if b[i] == c then r = i end
    i = i + 1
  end
  return r
end

local function strchr_at(b: *[0]byte, i: integer, c: byte): integer
  while b[i] ~= 0 do
    if b[i] == c then return i end
    i = i + 1
  end
  return -1
end

-- [!]color[:string|:hex_number|:oct_number][@offt|@offt_start-offt_end],...
local function color_fmt(cf: *[0]byte, bcnt: integer, out: *sequence(Clr)): boolean
  local fmt = cview(cf, 0)
  out:push((@Clr){})
  local hi = #out
  local c = 0
  while cf[c] ~= 0 do
    if cf[c] == 33 then out[hi].invert = true; c = c + 1 end
    local n = strcspn_at(cf, c, ':@,')
    local found, seq = color_sequence_from_colorname(n > 0 and (@string){data = &cf[c], size = (@usize)(n)} or '')
    c = c + n
    if not found then return false end
    out[hi].fmt = seq
    if cf[c] == 58 then
      c = c + 1
      if cf[c] == 48 then
        local v: uint64, e: integer, over: boolean
        if cf[c + 1] == 120 or cf[c + 1] == 88 then v, e, over = strtoul_at(cf, c + 2, 16)
        else v, e, over = strtoul_at(cf, c, 8) end
        if over or e == c then badfmt(fmt) end
        out[hi].val = (@int32)(v)
        c = e
      else
        out[hi].val = -1
        local fmt_end = strcspn_at(cf, c, ',')
        local endchar = cf[c + fmt_end]
        cf[c + fmt_end] = 0
        local endstr = strrchr_at(cf, c, 64)
        if endstr >= 0 then
          if cf[endstr + 1] ~= 0 then endstr = endstr - 1 end
          out[hi].str = strndup_at(cf, c, endstr - c + 1)
        else
          out[hi].str = strndup_at(cf, c, fmt_end)
        end
        out[hi].has_str = true
        cf[c + fmt_end] = endchar
        c = c + cstrlen(out[hi].str, 0)
      end
    else
      out[hi].val = -1
    end
    out[hi].range = (@int32)(bcnt)
    if cf[c] == 64 then
      c = c + 1
      local v, e, over = strtoul_at(cf, c, 10)
      out[hi].offt = (@int64)(v)
      c = e
      if over then badfmt(fmt) end
      if cf[c] == 45 then
        c = c + 1
        local v2, e2, over2 = strtoul_at(cf, c, 10)
        c = e2
        out[hi].range = (@int32)(v2 - (@uint64)(out[hi].offt) + 1)
        if over2 then badfmt(fmt) end
        if out[hi].range < 0 then badcnt('_L') end
        -- an offset over several print units: clone the condition
        while out[hi].range > bcnt and bcnt > 0 do
          local hc = out[hi]
          hc.range = (@int32)(bcnt)
          out:push(hc)
          out[hi].offt = out[hi].offt + bcnt
          out[hi].range = out[hi].range - (@int32)(bcnt)
        end
      end
    else
      out[hi].offt = -1
    end
    if out[hi].has_str and cstrlen(out[hi].str, 0) ~= out[hi].range then badcnt('_L') end
    if cf[c] == 44 then
      c = c + 1
      out:push((@Clr){})
      hi = #out
    end
  end
  return true
end

local function rewrite_rules(fs: *Fs)
  local USEBCNT <comptime> = 1
  local USEPREC <comptime> = 2
  local prec = 0
  for _, fu in ipairs(fs.fus) do
    local nconv = 0
    local f = fu.fmt
    local fmtp = 0
    while f[fmtp] ~= 0 do
      local pr = new(@Pr)
      pr.nospace = -1
      fu.prs:push(pr)
      local p1 = fmtp
      while f[p1] ~= 0 and f[p1] ~= 37 do p1 = p1 + 1 end
      if f[p1] == 0 then
        pr.fmt = cbuf(&f[fmtp], cstrlen(f, fmtp))
        pr.flags = F_TEXT
        break
      end
      local sokay = 0
      if fu.bcnt ~= 0 then
        sokay = USEBCNT
        p1 = p1 + 1
        while inset(spec, f[p1]) do p1 = p1 + 1 end
      else
        p1 = p1 + 1
        while inset(spec1, f[p1]) do p1 = p1 + 1 end
        if f[p1] == 46 then
          p1 = p1 + 1
          if isdigit(f[p1]) then
            sokay = USEPREC
            local ok, v, e = next_number(f, p1)
            if not ok then crash() end
            prec = (@int32)(v)
            p1 = e
          end
        end
      end
      local p2 = p1 + 1
      local cs: [4]byte = {f[p1], 0, 0, 0}
      if cs[0] == 99 then
        pr.flags = F_CHAR
        if fu.bcnt == 0 or fu.bcnt == 1 then pr.bcnt = 1
        else f[p1 + 1] = 0; badcnt(cview(f, p1)) end
      elseif inset('di', cs[0]) or inset('ouxX', cs[0]) then
        pr.flags = inset('di', cs[0]) and F_INT or F_UINT
        cs[2] = cs[0]; cs[1] = 108; cs[0] = 108; cs[3] = 0
        if fu.bcnt == 0 then pr.bcnt = 4
        elseif fu.bcnt == 1 or fu.bcnt == 2 or fu.bcnt == 4 or fu.bcnt == 8 then pr.bcnt = fu.bcnt
        else f[p1 + 1] = 0; badcnt(cview(f, p1)) end
      elseif inset('efgEG', cs[0]) then
        pr.flags = F_DBL
        if fu.bcnt == 0 then pr.bcnt = 8
        elseif fu.bcnt == 4 or fu.bcnt == 8 then pr.bcnt = fu.bcnt
        else f[p1 + 1] = 0; badcnt(cview(f, p1)) end
      elseif cs[0] == 115 then
        pr.flags = F_STR
        if sokay == 0 then badsfmt()
        elseif sokay == USEBCNT then pr.bcnt = fu.bcnt
        else pr.bcnt = prec end
      elseif cs[0] == 95 then
        p2 = p2 + 1
        local k = f[p1 + 1]
        if k == 65 or k == 97 then
          if k == 65 then endfu = fu; fu.flags = fu.flags | F_IGNORE end
          pr.flags = F_ADDRESS
          p2 = p2 + 1
          if inset('dox', f[p1 + 2]) then
            cs[0] = 108; cs[1] = 108; cs[2] = f[p1 + 2]; cs[3] = 0
          else
            f[p1 + 3] = 0; badconv(cview(f, p1))
          end
        elseif k == 99 or k == 112 or k == 117 then
          if k == 99 then pr.flags = F_C
          elseif k == 112 then pr.flags = F_P; cs[0] = 99
          else pr.flags = F_U end
          if fu.bcnt == 0 or fu.bcnt == 1 then pr.bcnt = 1
          else f[p1 + 2] = 0; badcnt(cview(f, p1)) end
        else
          f[p1 + 2] = 0; badconv(cview(f, p1))
        end
      else
        f[p1 + 1] = 0; badconv(cview(f, p1))
      end
      -- color unit(s)
      if f[p2] == 95 and f[p2 + 1] == 76 then
        if has_colors then
          local a = strchr_at(f, p2, 91)
          local q = strrchr_at(f, p2, 93)
          if a >= 0 and q >= 0 then
            a = a + 1
            local cf = strndup_at(f, a, q - a)
            pr.has_colors = color_fmt(cf, pr.bcnt, &pr.colors)
            p2 = q + 1
          else
            if q < 0 then badconv('(null)') else badconv(cview(f, q)) end
          end
        else
          local q = strrchr_at(f, p2, 93)
          if q < 0 then badconv('_L') end
          p2 = q + 1
        end
      end
      f[p1] = 0
      local tl = cstrlen(f, fmtp)
      local cl = cstrlen(&cs[0], 0)
      local room = tl > p1 - fmtp and tl or p1 - fmtp
      pr.fmt = bytes_alloc(room + cl + PAD)
      for i = 0, < tl do pr.fmt[i] = f[fmtp + i] end
      for i = 0, < cl do pr.fmt[tl + i] = cs[i] end
      pr.cchar = p1 - fmtp
      fmtp = p2
      if (pr.flags & F_ADDRESS) == 0 and fu.bcnt ~= 0 then
        if nconv ~= 0 then errx('byte count with multiple conversion characters') end
        nconv = nconv + 1
      end
    end
    if fu.bcnt == 0 then
      for _, pr in ipairs(fu.prs) do fu.bcnt = fu.bcnt + pr.bcnt end
    end
  end
  for i, fu in ipairs(fs.fus) do
    if i == #fs.fus and fs.bcnt < blocksize and (fu.flags & F_SETREP) == 0 and fu.bcnt ~= 0 then
      fu.reps = fu.reps + (blocksize - fs.bcnt) // fu.bcnt
    end
    if fu.reps > 1 and #fu.prs > 0 then
      local pr = fu.prs[#fu.prs]
      local q = -1
      local k = 0
      while pr.fmt[k] ~= 0 do
        if isspace(pr.fmt[k]) then q = k else q = -1 end
        k = k + 1
      end
      if q >= 0 then pr.nospace = q end
    end
  end
end

----------------------------------------------------------------------------
-- printf through snprintf

local tmp: *[0]byte = nilptr
local tmpcap: integer = 0

local function ensure_tmp(n: integer)
  if n <= tmpcap then return end
  if tmp ~= nilptr then c_free(tmp) end
  tmpcap = n
  tmp = bytes_alloc(n)
end

local function emit(n: integer)
  if n > 0 then oput(tmp, n) end
end

-- glibc prints a conversion it does not know through __printf_unknown
-- (flags in a fixed order, width, precision, the character, no length
-- modifier) and the rest of the format as text; a format that ends inside
-- a conversion stops output there. Returns false for a known conversion.
local function pf_unknown(fmt: *[0]byte): boolean
  local i = 0
  while fmt[i] ~= 0 and fmt[i] ~= 37 do i = i + 1 end
  if fmt[i] == 0 then return false end
  local start = i
  i = i + 1
  local alt, plus, space, left, zero = false, false, false, false, false
  while true do
    local c = fmt[i]
    if c == 35 then alt = true elseif c == 43 then plus = true elseif c == 32 then space = true
    elseif c == 45 then left = true elseif c == 48 then zero = true elseif c == 39 or c == 73 then
    else break end
    i = i + 1
  end
  local width: int64 = 0
  while isdigit(fmt[i]) do width = width * 10 + (fmt[i] - 48); i = i + 1 end
  local prec: int64 = -1
  if fmt[i] == 46 then
    i = i + 1
    prec = 0
    while isdigit(fmt[i]) do prec = prec * 10 + (fmt[i] - 48); i = i + 1 end
  end
  while inset('hlLqjzZt', fmt[i]) and fmt[i] ~= 0 do i = i + 1 end
  local spec = fmt[i]
  if spec ~= 0 and inset('diouxXeEfFgGcs', spec) then return false end
  oput(fmt, start)
  if spec == 0 then return true end
  local sb: [64]byte
  local n = 0
  sb[n] = 37; n = n + 1
  if alt then sb[n] = 35; n = n + 1 end
  if plus then sb[n] = 43; n = n + 1 elseif space then sb[n] = 32; n = n + 1 end
  if left then sb[n] = 45; n = n + 1 end
  if zero then sb[n] = 48; n = n + 1 end
  oput(&sb[0], n)
  if width ~= 0 then ostr(tostring(width)) end
  if prec ~= -1 then ostr('.' .. tostring(prec)) end
  oput((@*[0]byte)(&fmt[i]), 1)
  i = i + 1
  oput((@*[0]byte)(&fmt[i]), cstrlen(fmt, i))
  return true
end

local function pf_i64(fmt: *[0]byte, v: int64)
  if pf_unknown(fmt) then return end
  ensure_tmp(512)
  local n: integer = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&fmt[0]), v)
  if n >= tmpcap then
    ensure_tmp(n + 1)
    n = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&fmt[0]), v)
  end
  emit(n)
end

local function pf_int(fmt: *[0]byte, v: cint)
  if pf_unknown(fmt) then return end
  ensure_tmp(512)
  local n: integer = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&fmt[0]), v)
  if n >= tmpcap then
    ensure_tmp(n + 1)
    n = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&fmt[0]), v)
  end
  emit(n)
end

-- nelibc's "%#.0f" drops the '.' for |v| >= 2^64 (glibc keeps it): such a
-- value is an integer, so print it with ".1" and one more column of width
-- and cut the '0' after the point
local function pf_dbl_altf(fmt: *[0]byte, v: float64): boolean
  if not (v >= 18446744073709551616.0 or v <= -18446744073709551616.0) or v ~= v then return false end
  if v == v * 2.0 then return false end -- inf
  local i = 0
  while fmt[i] ~= 0 and fmt[i] ~= 37 do i = i + 1 end
  if fmt[i] == 0 then return false end
  local prefix = i
  i = i + 1
  local alt = false
  while fmt[i] ~= 0 and inset('#-+ 0', fmt[i]) do
    if fmt[i] == 35 then alt = true end
    i = i + 1
  end
  local flend = i
  local width: int64 = 0
  while isdigit(fmt[i]) do width = width * 10 + (fmt[i] - 48); i = i + 1 end
  if fmt[i] ~= 46 then return false end
  i = i + 1
  while fmt[i] == 48 do i = i + 1 end
  if isdigit(fmt[i]) then return false end
  local spec = fmt[i]
  if not alt or (spec ~= 102 and spec ~= 70) or fmt[i + 1] ~= 0 then return false end
  local nf: sequence(byte)
  for k = 0, < flend do nf:push(fmt[k]) end
  local w = width > 0 and tostring(width + 1) or ''
  for k = 1, #w do nf:push(w:byte(k)) end
  nf:push(46); nf:push(49); nf:push(spec); nf:push(0)
  ensure_tmp(8192)
  local n: integer = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&nf[1]), v)
  if n >= tmpcap then
    ensure_tmp(n + 1)
    n = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&nf[1]), v)
  end
  nf:destroy()
  if n <= 0 then return true end
  local k = prefix
  while k < n and tmp[k] ~= 46 do k = k + 1 end
  if k + 1 < n then
    for j = k + 1, < n - 1 do tmp[j] = tmp[j + 1] end
    n = n - 1
  end
  emit(n)
  return true
end

local function pf_dbl(fmt: *[0]byte, v: float64)
  if pf_unknown(fmt) then return end
  if pf_dbl_altf(fmt, v) then return end
  ensure_tmp(512)
  local n: integer = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&fmt[0]), v)
  if n >= tmpcap then
    ensure_tmp(n + 1)
    n = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&fmt[0]), v)
  end
  emit(n)
end

local function pf_str(fmt: *[0]byte, s: *[0]byte)
  if pf_unknown(fmt) then return end
  ensure_tmp(512)
  local n: integer = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&fmt[0]), (@cstring)(&s[0]))
  if n >= tmpcap then
    ensure_tmp(n + 1)
    n = c_snprintf((@cstring)(&tmp[0]), (@csize)(tmpcap), (@cstring)(&fmt[0]), (@cstring)(&s[0]))
  end
  emit(n)
end

local function pf_text(fmt: *[0]byte)
  oput(fmt, cstrlen(fmt, 0))
end

----------------------------------------------------------------------------
-- hexdump-conv.c

local function conv_c(pr: *Pr, p: *[0]byte)
  local c = p[0]
  local str: string = ''
  if c == 0 then str = '\\0'
  elseif c == 7 then str = '\\a'
  elseif c == 8 then str = '\\b'
  elseif c == 12 then str = '\\f'
  elseif c == 10 then str = '\\n'
  elseif c == 13 then str = '\\r'
  elseif c == 9 then str = '\\t'
  elseif c == 11 then str = '\\v'
  elseif isprint(c) then
    pr.fmt[pr.cchar] = 99
    pf_int(pr.fmt, c)
    return
  else
    local o: [4]byte = {48 + ((c >> 6) & 7), 48 + ((c >> 3) & 7), 48 + (c & 7), 0}
    pr.fmt[pr.cchar] = 115
    pf_str(pr.fmt, &o)
    return
  end
  local sb: [4]byte = {str:byte(1), str:byte(2), 0, 0}
  pr.fmt[pr.cchar] = 115
  pf_str(pr.fmt, &sb)
end

local ulist: []string = {
  'nul', 'soh', 'stx', 'etx', 'eot', 'enq', 'ack', 'bel',
  'bs', 'ht', 'lf', 'vt', 'ff', 'cr', 'so', 'si',
  'dle', 'dc1', 'dc2', 'dc3', 'dc4', 'nak', 'syn', 'etb',
  'can', 'em', 'sub', 'esc', 'fs', 'gs', 'rs', 'us',
}

local function conv_u(pr: *Pr, p: *[0]byte)
  local c = p[0]
  if c <= 0x1f or c == 0x7f then
    local s = c == 0x7f and 'del' or ulist[c]
    local sb: [4]byte
    for i = 1, #s do sb[i - 1] = s:byte(i) end
    pr.fmt[pr.cchar] = 115
    pf_str(pr.fmt, &sb)
  elseif isprint(c) then
    pr.fmt[pr.cchar] = 99
    pf_int(pr.fmt, c)
  else
    pr.fmt[pr.cchar] = 120
    pf_int(pr.fmt, c)
  end
end

----------------------------------------------------------------------------
-- hexdump-display.c

local function color_cond(pr: *Pr, bp: *[0]byte, bcnt: integer): (boolean, string)
  for i = 1, #pr.colors do
    local clr = &pr.colors[i]
    local offt = clr.offt
    local match = false
    if offt < 0 then offt = address end
    if offt < address or offt + clr.range > address + bcnt then goto next_clr end
    if clr.has_str then
      if pr.flags == F_ADDRESS then
        -- TODO in the original
      else
        if bp == nilptr then crash() end
        local same = true
        local base = offt - address
        for k = 0, < clr.range do
          local x, y = clr.str[k], bp[base + k]
          if x ~= y then same = false; break end
          if x == 0 then break end
        end
        if same then match = true end
      end
    elseif clr.val ~= -1 then
      if pr.flags == F_ADDRESS then
        if (@int64)(clr.val) == address then match = true end
      else
        if bp == nilptr then crash() end
        local v: uint32 = 0
        local n = clr.range
        if n > 4 then n = 4 end
        for k = 0, < n do v = v | ((@uint32)(bp[offt - address + k]) << (8 * k)) end
        if (@int32)(v) == clr.val then match = true end
      end
    else
      return true, clr.fmt
    end
    if match ~= clr.invert then return true, clr.fmt end
    ::next_clr::
  end
  return false, ''
end

local function le(bp: *[0]byte, n: integer): uint64
  local v: uint64 = 0
  for k = 0, < n do v = v | ((@uint64)(bp[k]) << (8 * k)) end
  return v
end

local function print_pr(pr: *Pr, bp: *[0]byte)
  local colored = false
  local seq: string = ''
  if pr.has_colors then
    colored, seq = color_cond(pr, bp, pr.bcnt)
    if colored and has_colors then ostr(seq) end
  end
  local fl = pr.flags
  if fl == F_ADDRESS then
    pf_i64(pr.fmt, address)
  elseif fl == F_BPAD then
    local e: [1]byte = {0}
    pf_str(pr.fmt, &e)
  elseif fl == F_C then
    conv_c(pr, bp)
  elseif fl == F_CHAR then
    pf_int(pr.fmt, bp[0])
  elseif fl == F_DBL then
    if pr.bcnt == 4 then
      local u = (@uint32)(le(bp, 4))
      local f: float32 = $(@*float32)(&u)
      pf_dbl(pr.fmt, f)
    elseif pr.bcnt == 8 then
      local u = le(bp, 8)
      local d: float64 = $(@*float64)(&u)
      pf_dbl(pr.fmt, d)
    end
  elseif fl == F_INT then
    if pr.bcnt == 1 then pf_i64(pr.fmt, (@int8)(bp[0]))
    elseif pr.bcnt == 2 then pf_i64(pr.fmt, (@int16)((@uint16)(le(bp, 2))))
    elseif pr.bcnt == 4 then pf_i64(pr.fmt, (@int32)((@uint32)(le(bp, 4))))
    elseif pr.bcnt == 8 then pf_i64(pr.fmt, (@int64)(le(bp, 8))) end
  elseif fl == F_P then
    pf_int(pr.fmt, isprint(bp[0]) and bp[0] or 46)
  elseif fl == F_STR then
    pf_str(pr.fmt, bp)
  elseif fl == F_TEXT then
    pf_text(pr.fmt)
  elseif fl == F_U then
    conv_u(pr, bp)
  elseif fl == F_UINT then
    if pr.bcnt == 1 then pf_i64(pr.fmt, bp[0])
    elseif pr.bcnt == 2 or pr.bcnt == 4 or pr.bcnt == 8 then pf_i64(pr.fmt, (@int64)(le(bp, pr.bcnt))) end
  end
  if colored and has_colors then ostr('\27[0m') end
end

local function bpad(pr: *Pr)
  pr.flags = F_BPAD
  pr.fmt[pr.cchar] = 115
  pr.fmt[pr.cchar + 1] = 0
  local p1 = 0
  while pr.fmt[p1] ~= 37 do p1 = p1 + 1 end
  p1 = p1 + 1
  local p2 = p1
  while pr.fmt[p1] ~= 0 and inset(' -0+#', pr.fmt[p1]) do p1 = p1 + 1 end
  while true do
    local c = pr.fmt[p1]
    pr.fmt[p2] = c
    p1 = p1 + 1; p2 = p2 + 1
    if c == 0 then break end
  end
end

-- the input: stdin as freopen() and fread() see it
local files: sequence(string)
local argi: integer = 1
local prev_name: string = ''   -- _argv[-1] before any operand
local done_next = false
local in_fd: cint = 0
local in_buf: *[0]byte = nilptr
local in_bsize: integer = 0
local in_rpos: integer = 0
local in_rend: integer = 0
local in_eof = false
local in_err = false
local in_errno: cint = 0

local function in_alloc()
  if in_buf ~= nilptr then return end
  in_bsize = 8192
  local st: sys.Stat
  if in_fd >= 0 and sys.fstat(in_fd, &st) == 0 then
    if st.st_blksize > 0 and st.st_blksize < 8192 then in_bsize = st.st_blksize end
  end
  in_buf = bytes_alloc(in_bsize)
end

local function freopen(name: string): boolean
  if in_fd >= 0 then sys.close(in_fd) end
  if in_buf ~= nilptr then c_free(in_buf); in_buf = nilptr end
  in_rpos = 0; in_rend = 0; in_eof = false; in_err = false
  in_fd = sys.open(name, 0, 0)
  return in_fd >= 0
end

local function sysread(dst: *[0]byte, n: integer): integer
  while true do
    local r = sys.read(in_fd, dst, (@usize)(n))
    if r < 0 and sys.errno() == sys.EINTR then continue end
    if r < 0 then in_errno = sys.errno() end
    return r
  end
  return -1
end

-- glibc _IO_file_xsgetn
local function fread(dst: *[0]byte, n: integer): integer
  in_alloc()
  local want = n
  local got = 0
  while want > 0 do
    local have = in_rend - in_rpos
    if want <= have then
      for k = 0, < want do dst[got + k] = in_buf[in_rpos + k] end
      in_rpos = in_rpos + want
      got = got + want
      want = 0
    else
      if have > 0 then
        for k = 0, < have do dst[got + k] = in_buf[in_rpos + k] end
        got = got + have; want = want - have
        in_rpos = in_rend
      end
      if want < in_bsize then
        if in_eof then break end
        local r = sysread(in_buf, in_bsize)
        if r <= 0 then
          if r == 0 then in_eof = true else in_err = true end
          break
        end
        in_rpos = 0; in_rend = r
      else
        in_rpos = 0; in_rend = 0
        local count = want
        if in_bsize >= 128 then count = count - want % in_bsize end
        local r = sysread(&dst[got], count)
        if r <= 0 then
          if r == 0 then in_eof = true else in_err = true end
          break
        end
        got = got + r; want = want - r
      end
    end
  end
  return got
end

-- glibc fseek(stdin, offset, SEEK_SET) on a fresh stream; errno on failure
local function fseek(offset: int64): cint
  in_alloc()
  if in_fd < 0 then return EBADF end
  local bs = (@int64)(in_bsize)
  local new_offset = offset & ~(bs - 1)
  local delta = offset - new_offset
  if delta > bs then new_offset = offset; delta = 0 end
  if sys.lseek(in_fd, new_offset, 0) < 0 then return sys.errno() end
  local count: integer = 0
  if delta ~= 0 then
    count = sysread(in_buf, delta)
    if count < delta then
      local rest = count < 0 and delta or delta - count
      if sys.lseek(in_fd, rest, 1) < 0 then return sys.errno() end
      in_rpos = 0; in_rend = 0; in_eof = false
      return 0
    end
  end
  in_rpos = delta; in_rend = count; in_eof = false
  return 0
end

in_sync = function()
  if in_fd >= 0 and in_buf ~= nilptr and in_rend > in_rpos then
    sys.lseek(in_fd, -(in_rend - in_rpos), 1)
  end
end

local function doskip(fname: string, statok: boolean)
  if statok then
    local st: sys.Stat
    if sys.fstat(in_fd, &st) ~= 0 then
      errno_msg(fname, sys.errno()); finish(1)
    end
    if (st.st_mode & sys.S_IFMT) == sys.S_IFREG and skip > st.st_size then
      skip = skip - st.st_size
      address = address + st.st_size
      return
    end
  end
  local e = fseek(skip)
  if e ~= 0 then errno_msg(fname, e); finish(1) end
  address = address + skip
  skip = 0
end

local function next_file(): boolean
  while true do
    local statok: boolean
    if argi <= #files then
      if not freopen(files[argi]) then
        errno_msg(files[argi], sys.errno())
        exitval = 1
        argi = argi + 1
        continue
      end
      statok = true; done_next = true
    else
      if done_next then return false end
      done_next = true
      statok = false
    end
    if skip ~= 0 then doskip(statok and files[argi] or 'stdin', statok) end
    if argi <= #files then argi = argi + 1 end
    if skip == 0 then return true end
  end
  return false
end

local ateof = true
local curp: *[0]byte = nilptr
local savp: *[0]byte = nilptr

local function memeq(a: *[0]byte, b: *[0]byte, n: integer): boolean
  for k = 0, < n do if a[k] ~= b[k] then return false end end
  return true
end

local function get(): *[0]byte
  if curp == nilptr then
    curp = bytes_alloc(blocksize + PAD)
    savp = bytes_alloc(blocksize + PAD)
  else
    local t = curp; curp = savp; savp = t
    address = address + blocksize
  end
  local need = blocksize
  local nread = 0
  while true do
    if length == 0 or (ateof and not next_file()) then
      if need == blocksize then return nilptr end
      if need == 0 and vflag ~= V_ALL and memeq(curp, savp, nread) then
        if vflag ~= V_DUP then ostr('*\n') end
        return nilptr
      end
      if need > 0 then for k = 0, < need do curp[nread + k] = 0 end end
      eaddress = address + nread
      return curp
    end
    if in_fd < 0 then
      util.err('all input file arguments failed')
      return nilptr
    end
    local want = need
    if length ~= -1 and length >= 0 and length < need then want = length end
    local n = fread(&curp[nread], want)
    if n == 0 then
      if in_err then
        local name = argi > 1 and files[argi - 1] or prev_name
        errno_msg(name, in_errno)
      end
      ateof = true
      continue
    end
    ateof = false
    if length ~= -1 then length = length - n end
    need = need - n
    if need == 0 then
      if vflag == V_ALL or vflag == V_FIRST or not memeq(curp, savp, blocksize) then
        if vflag == V_DUP or vflag == V_FIRST then vflag = V_WAIT end
        return curp
      end
      if vflag == V_WAIT then ostr('*\n') end
      vflag = V_DUP
      address = address + blocksize
      need = blocksize
      nread = 0
    else
      nread = nread + n
    end
  end
  return nilptr
end

local function display()
  local bp: *[0]byte = nilptr
  while true do
    bp = get()
    if bp == nilptr then break end
    local savebp = bp
    local saveaddress = address
    for _, fss in ipairs(fshead) do
      for _, fu in ipairs(fss.fus) do
        if (fu.flags & F_IGNORE) ~= 0 then break end
        local cnt = fu.reps
        while cnt ~= 0 do
          for _, pr in ipairs(fu.prs) do
            if eaddress ~= 0 and address >= eaddress and (pr.flags & (F_TEXT | F_BPAD)) == 0 then bpad(pr) end
            if cnt == 1 and pr.nospace >= 0 then
              local savech = pr.fmt[pr.nospace]
              pr.fmt[pr.nospace] = 0
              print_pr(pr, bp)
              pr.fmt[pr.nospace] = savech
            else
              print_pr(pr, bp)
            end
            address = address + pr.bcnt
            bp = (@*[0]byte)(&bp[pr.bcnt])
          end
          cnt = cnt - 1
        end
      end
      bp = savebp
      address = saveaddress
    end
  end
  if endfu ~= nilptr then
    if eaddress == 0 then
      if address == 0 then return end
      eaddress = address
    end
    for _, pr in ipairs(endfu.prs) do
      local colored = false
      local seq: string = ''
      if has_colors and pr.has_colors then
        colored, seq = color_cond(pr, nilptr, pr.bcnt)
        if colored then ostr(seq) end
      end
      if pr.flags == F_ADDRESS then pf_i64(pr.fmt, eaddress)
      elseif pr.flags == F_TEXT then pf_text(pr.fmt) end
      if colored then ostr('\27[0m') end
    end
  end
end

----------------------------------------------------------------------------
-- hexdump.c

local function usage(name: string)
  ostr('\nUsage:\n')
  ostr(' ' .. name .. ' [options] <file>...\n')
  ostr('\n')
  ostr('Display file contents in hexadecimal, decimal, octal, or ascii.\n')
  ostr('\nOptions:\n')
  ostr(' -b, --one-byte-octal      one-byte octal display\n')
  ostr(' -c, --one-byte-char       one-byte character display\n')
  ostr(' -C, --canonical           canonical hex+ASCII display\n')
  ostr(' -d, --two-bytes-decimal   two-byte decimal display\n')
  ostr(' -o, --two-bytes-octal     two-byte octal display\n')
  ostr(' -x, --two-bytes-hex       two-byte hexadecimal display\n')
  ostr(' -L, --color[=<mode>]      interpret color formatting specifiers\n')
  ostr('                             colors are enabled by default\n')
  ostr(' -e, --format <format>     format string to be used for displaying data\n')
  ostr(' -f, --format-file <file>  file that contains format strings\n')
  ostr(' -n, --length <length>     interpret only length bytes of input\n')
  ostr(' -s, --skip <offset>       skip offset bytes from the beginning\n')
  ostr(' -v, --no-squeezing        output identical lines\n')
  ostr('\n')
  ostr(' -h, --help                display this help\n')
  ostr(' -V, --version             display version\n')
  ostr('\nArguments:\n')
  ostr(' <length> and <offset> arguments may be followed by the suffixes for\n')
  ostr('   GiB, TiB, PiB, EiB, ZiB, and YiB (the "iB" is optional)\n')
  ostr('\nFor more details see hexdump(1).\n')
  finish(0)
end

local function hexdump_main(args: sequence(string)): integer
  local name = util.applet
  local colormode = CM_UNDEF
  local hex_offt = '"%07.7_Ax\n"'
  local longs: []util.LongOpt = {
    {'one-byte-octal', 0, 98}, {'one-byte-char', 0, 99}, {'canonical', 0, 67},
    {'two-bytes-decimal', 0, 100}, {'two-bytes-octal', 0, 111}, {'two-bytes-hex', 0, 120},
    {'format', 1, 101}, {'format-file', 1, 102}, {'color', 2, 76}, {'length', 1, 110},
    {'skip', 1, 115}, {'no-squeezing', 0, 118}, {'help', 0, 104}, {'version', 0, 86},
  }
  if name == 'hd' then
    add_fmt('"%08.8_Ax\n"')
    add_fmt('"%08.8_ax  " 8/1 "%02x " "  " 8/1 "%02x " ')
    add_fmt('"  |" 16/1 "%_p" "|\\n"')
  end
  local g = util.getopt(args, 'bcCde:f:L::n:os:vxhV', &longs, #longs)
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 98 then
      add_fmt(hex_offt); add_fmt('"%07.7_ax " 16/1 "%03o " "\\n"')
    elseif c == 99 then
      add_fmt(hex_offt); add_fmt('"%07.7_ax " 16/1 "%3_c " "\\n"')
    elseif c == 67 then
      add_fmt('"%08.8_Ax\n"')
      add_fmt('"%08.8_ax  " 8/1 "%02x " "  " 8/1 "%02x " ')
      add_fmt('"  |" 16/1 "%_p" "|\\n"')
    elseif c == 100 then
      add_fmt(hex_offt); add_fmt('"%07.7_ax " 8/2 "  %05u " "\\n"')
    elseif c == 101 then
      add_fmt(g.optarg)
    elseif c == 102 then
      addfile(g.optarg)
    elseif c == 76 then
      colormode = CM_AUTO
      if g.has_optarg then colormode = colormode_or_err(g.optarg, 'unsupported color mode') end
    elseif c == 110 then
      length = (@int64)(strtosize_or_err(g.optarg, 'failed to parse length'))
    elseif c == 111 then
      add_fmt(hex_offt); add_fmt('"%07.7_ax " 8/2 " %06o " "\\n"')
    elseif c == 115 then
      skip = (@int64)(strtosize_or_err(g.optarg, 'failed to parse offset'))
    elseif c == 118 then
      vflag = V_ALL
    elseif c == 120 then
      add_fmt(hex_offt); add_fmt('"%07.7_ax " 8/2 "   %04x " "\\n"')
    elseif c == 104 then
      usage(name)
    elseif c == 86 then
      ostr(name .. ' from util-linux 2.38.1\n')
      finish(0)
    else
      local m = "Try '" .. name .. " --help' for more information.\n"
      sys.write(2, m.data, m.size)
      finish(1)
    end
  end
  if #fshead == 0 then
    add_fmt(hex_offt)
    add_fmt('"%07.7_ax " 8/2 "%04x " "\\n"')
  end
  colors_init(colormode, name)

  local ops = g:operands()
  for i = 1, #ops do files:push(ops[i]) end
  -- _argv[-1] while no operand has been opened: the last argument before
  -- the operands (glibc permutes them to the end), or argv[0]
  if #ops == 0 then
    prev_name = #args > 0 and args[#args] or name
  end

  blocksize = 0
  for _, tfs in ipairs(fshead) do
    tfs.bcnt = block_size(tfs)
    if tfs.bcnt > blocksize then blocksize = tfs.bcnt end
  end
  for _, tfs in ipairs(fshead) do rewrite_rules(tfs) end

  display()
  finish(exitval)
  return exitval
end

global function applet_hexdump(args: sequence(string)): integer
  return hexdump_main(args)
end

global function applet_hd(args: sequence(string)): integer
  return hexdump_main(args)
end
