-- shuf: a port of GNU coreutils 9.1 src/shuf.c with gnulib randint.c,
-- randperm.c and randread.c. -e, -i LO-HI, -n, -o, -r, -z and
-- --random-source=FILE, which consumes FILE's bytes exactly as GNU does, so
-- the same source gives the same output. Without it the bytes come from
-- getrandom (GNU seeds ISAAC from getrandom; both are unpredictable). Inputs
-- over 8 MiB with -n use GNU's reservoir sampling, draw for draw.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'hashmap'
require 'nebox.sys'
require 'nebox.util'

local function c_exit(status: cint) <cimport 'exit', cinclude '<stdlib.h>', noreturn> end

local UMAX: uint64 <comptime> = 0xffffffffffffffff
local OFF_T_MAX: int64 <comptime> = 0x7fffffffffffffff
local RESERVOIR_MIN_INPUT: int64 <comptime> = 8192 * 1024
local RESERVOIR_LINES_INCREMENT: integer <comptime> = 1024

local function die(msg: string)
  util.err(msg)
  util.flush()
  c_exit(1)
end

local function die_errno(e: cint, msg: string)
  if e == 0 then die(msg) end
  die(msg .. ': ' .. sys.strerror(e))
end

local function usage_fail(msg: string)
  if #msg > 0 then util.err(msg) end
  util.flush()
  local m = "Try 'shuf --help' for more information.\n"
  sys.write(2, m.data, m.size)
  c_exit(1)
end

-- randread: bytes from the --random-source file in order, or getrandom.
local src_fd: cint = -1
local src_name: string
local src_open = false
local src_buf: [4096]byte
local src_len: integer = 0
local src_pos: integer = 0

local function randread(out: *[0]byte, n: integer)
  for i = 0, n - 1 do
    if src_pos == src_len then
      if src_fd >= 0 then
        local r: clong
        repeat r = sys.read(src_fd, &src_buf[0], #src_buf) until not (r < 0 and sys.errno() == sys.EINTR)
        if r == 0 then die(util.quote(src_name) .. ': end of file') end
        if r < 0 then die_errno(sys.errno(), util.quote(src_name) .. ': read error') end
        src_len = r
      else
        local r: clong
        repeat r = sys.getrandom(&src_buf[0], #src_buf, 0) until r > 0 or sys.errno() ~= sys.EINTR
        if r <= 0 then die_errno(sys.errno(), 'getrandom') end
        src_len = r
      end
      src_pos = 0
    end
    out[i] = src_buf[src_pos]
    src_pos = src_pos + 1
  end
end

-- randint: a buffered uniformly distributed integer, as gnulib keeps it.
local randnum: uint64 = 0
local randmax: uint64 = 0

local function randint_genmax(genmax: uint64): uint64
  local rn = randnum
  local rm = randmax
  local choices = genmax + 1
  local buf: [8]byte
  while true do
    if rm < genmax then
      local i = 0
      local rmax = rm
      repeat
        rmax = (rmax << 8) + 255
        i = i + 1
      until rmax >= genmax
      randread(&buf, i)
      i = 0
      repeat
        rn = (rn << 8) + buf[i]
        rm = (rm << 8) + 255
        i = i + 1
      until rm >= genmax
    end
    if rm == genmax then
      randnum = 0; randmax = 0
      return rn
    end
    local excess = rm - genmax
    local unusable = excess % choices
    local last_usable = rm - unusable
    local reduced = rn % choices
    if rn <= last_usable then
      randnum = rn // choices
      randmax = excess // choices
      return reduced
    end
    rn = reduced
    rm = unusable - 1
  end
  return 0
end

local function randint_choose(choices: uint64): uint64
  return randint_genmax(choices - 1)
end

local function floor_lg(n: uint64): int64
  if n == 0 then return -1 end
  local r: int64 = -1
  while n ~= 0 do r = r + 1; n = n >> 1 end
  return r
end

local function randperm_bound(h: uint64, n: uint64): uint64
  local lg_n: uint64 = (@uint64)(floor_lg(n) + 1)
  local ar: uint64 = lg_n * h
  return (ar + 7) // 8
end

-- randperm_new: the first H elements of a random permutation of N.
local function randperm_new(h: uint64, n: uint64): sequence(uint64)
  local v: sequence(uint64)
  if h == 0 then return v end
  local sparse = n >= 128 * 1024 and n // h >= 32
  if sparse then
    local sv: hashmap(uint64, uint64)
    for i: uint64 = 0, < h do
      local j = i + randint_choose(n - i)
      local vi = sv:peek(i)
      local vj = sv:peek(j)
      local a: uint64 = vi and $vi or i
      local b: uint64 = vj and $vj or j
      sv[i] = b
      sv[j] = a
      v:push(b)
    end
  else
    v:resize((@integer)(n))
    for i = 1, (@integer)(n) do v[i] = (@uint64)(i - 1) end
    for i: uint64 = 0, < h do
      local j = i + randint_choose(n - i)
      local t = v[i + 1]
      v[i + 1] = v[j + 1]
      v[j + 1] = t
    end
    v:resize((@integer)(h))
  end
  return v
end

-- Input lines: data holds every line with its terminator; starts[k] is the
-- 0-based offset of line k (1-based), starts[n + 1] the end.
local data: sequence(byte)
local starts: sequence(integer)

local function index_lines(eolbyte: byte)
  if #data > 0 and data[#data] ~= eolbyte then data:push(eolbyte) end
  starts:clear()
  starts:push(0)
  for i = 1, #data do
    if data[i] == eolbyte then starts:push(i) end
  end
end

local function read_input(eolbyte: byte)
  local buf: [65536]byte
  while true do
    local r = sys.read(0, &buf[0], #buf)
    if r < 0 then
      if sys.errno() == sys.EINTR then continue end
      die_errno(sys.errno(), 'read error')
    end
    if r == 0 then break end
    for i = 0, r - 1 do data:push(buf[i]) end
  end
  index_lines(eolbyte)
end

local function write_line(k: integer)
  local a = starts[k]
  local b = starts[k + 1]
  if b > a then util.writebytes(&data[a + 1], (@usize)(b - a)) end
end

-- A readlinebuffer_delim over fd 0 for reservoir sampling.
local rbuf: [65536]byte
local rlen: integer = 0
local rpos: integer = 0
local reof = false

local function refill(): boolean
  while rpos == rlen do
    if reof then return false end
    local r = sys.read(0, &rbuf[0], #rbuf)
    if r < 0 then
      if sys.errno() == sys.EINTR then continue end
      die_errno(sys.errno(), 'read error')
    end
    if r == 0 then reof = true; return false end
    rlen = r; rpos = 0
  end
  return true
end

-- At end of input INTO is left as it was, as readlinebuffer_delim does.
local function readline(into: *sequence(byte), eolbyte: byte): boolean
  if not refill() then return false end
  into:clear()
  while true do
    if rpos == rlen then
      if reof then break end
      local r = sys.read(0, &rbuf[0], #rbuf)
      if r < 0 then
        if sys.errno() == sys.EINTR then continue end
        die_errno(sys.errno(), 'read error')
      end
      if r == 0 then reof = true; break end
      rlen = r; rpos = 0
    end
    local c = rbuf[rpos]
    rpos = rpos + 1
    into:push(c)
    if c == eolbyte then return true end
  end
  if #into == 0 then return false end
  into:push(eolbyte)
  return true
end

local function input_size(): int64
  local st: sys.Stat
  if sys.fstat(0, &st) ~= 0 then return OFF_T_MAX end
  if (st.st_mode & sys.S_IFMT) ~= 0x8000 then return OFF_T_MAX end
  local off = sys.lseek(0, 0, sys.SEEK_CUR)
  if off < 0 then return OFF_T_MAX end
  return st.st_size - off
end

local function reservoir_sample(k: uint64, eolbyte: byte, rsrv: *sequence(sequence(byte))): uint64
  local n_lines: uint64 = 0
  local got = false
  while n_lines < k do
    local line: sequence(byte)
    got = readline(&line, eolbyte)
    if not got then break end
    rsrv:push(line)
    n_lines = n_lines + 1
  end
  if got then
    local dummy: sequence(byte)
    while true do
      local j = randint_choose(n_lines + 1)
      local ok: boolean
      if j < k then ok = readline(&rsrv[(@integer)(j) + 1], eolbyte)
      else ok = readline(&dummy, eolbyte) end
      if not ok then break end
      if n_lines == 0 then break end
      n_lines = n_lines + 1
    end
    if n_lines == 0 then die_errno(75, 'too many input lines') end
  end
  return n_lines < k and n_lines or k
end

global function applet_shuf(args: sequence(string)): integer
  local echo = false
  local input_range = false
  local lo_input: uint64 = UMAX
  local hi_input: uint64 = 0
  local head_lines: uint64 = UMAX
  local outfile = ''
  local have_out = false
  local random_source = ''
  local have_rs = false
  local eolbyte: byte = 10
  local use_reservoir = false
  local rep = false
  local n_lines: uint64 = 0
  local longs: []util.LongOpt = {
    {'echo', 0, 101}, {'input-range', 1, 105}, {'head-count', 1, 110}, {'output', 1, 111},
    {'random-source', 1, 256}, {'repeat', 0, 114}, {'zero-terminated', 0, 122},
    {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
  }
  local g = util.getopt(args, 'ei:n:o:rz', &longs, #longs)
  g.quiet = true
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 63 then usage_fail(g.errmsg) end
    if c == util.UNSUPPORTED then usage_fail("option '--" .. g.longname .. "' is not supported") end
    if c == 101 then echo = true
    elseif c == 105 then
      local a = g.optarg
      local p = a:find('-', 1, true)
      local hi_arg = a
      local invalid = p == 0
      if input_range then die('multiple -i options specified') end
      input_range = true
      if p > 0 then
        local lo = a:sub(1, p - 1)
        local ok, v, e = util.xdectoumax(lo, 0, UMAX, '', 'invalid input range')
        if not ok then die(e) end
        lo_input = v
        hi_arg = a:sub(p + 1)
      end
      local ok, v, e = util.xdectoumax(hi_arg, 0, UMAX, '', 'invalid input range')
      if not ok then die(e) end
      hi_input = v
      n_lines = hi_input - lo_input + 1
      if invalid or ((lo_input <= hi_input) == (n_lines == 0)) then
        die('invalid input range: ' .. util.quote(a))
      end
    elseif c == 110 then
      local st, v = util.xstrtoumax(g.optarg, '')
      if st == 0 then
        if v < head_lines then head_lines = v end
      elseif st ~= 1 then
        die('invalid line count: ' .. util.quote(g.optarg))
      end
    elseif c == 111 then
      if have_out and outfile ~= g.optarg then die('multiple output files specified') end
      outfile = g.optarg; have_out = true
    elseif c == 256 then
      if have_rs and random_source ~= g.optarg then die('multiple random sources specified') end
      random_source = g.optarg; have_rs = true
    elseif c == 114 then rep = true
    elseif c == 122 then eolbyte = 0
    end
  end
  local ops = g:operands()
  if echo and input_range then usage_fail('cannot combine -e and -i options') end
  if (input_range and #ops > 0) or (not input_range and not echo and #ops > 1) then
    usage_fail('extra operand ' .. util.quote(ops[input_range and 1 or 2]))
  end
  local rsrv: sequence(sequence(byte))
  if head_lines == 0 then
    n_lines = 0
  elseif echo then
    for _, a in ipairs(ops) do
      for i = 1, #a do data:push(a:byte(i)) end
      data:push(eolbyte)
    end
    starts:push(0)
    local off = 0
    for _, a in ipairs(ops) do off = off + #a + 1; starts:push(off) end
    n_lines = (@uint64)(#ops)
  elseif input_range then
    n_lines = hi_input - lo_input + 1
  else
    if #ops == 1 and ops[1] ~= '-' then
      local fd = sys.open(ops[1], sys.O_RDONLY, 0)
      if fd < 0 then die_errno(sys.errno(), util.quotef(ops[1])) end
      if fd ~= 0 then sys.dup2(fd, 0); sys.close(fd) end
    end
    if rep or head_lines == UMAX or input_size() <= RESERVOIR_MIN_INPUT then
      read_input(eolbyte)
      n_lines = (@uint64)(#starts - 1)
    else
      use_reservoir = true
      n_lines = UMAX
    end
  end
  local ahead_lines: uint64 = (rep or head_lines < n_lines) and head_lines or n_lines
  local bound: uint64 = (use_reservoir or rep) and UMAX or randperm_bound(ahead_lines, n_lines)
  if bound ~= 0 and have_rs then
    src_fd = sys.open(random_source, sys.O_RDONLY, 0)
    if src_fd < 0 then die_errno(sys.errno(), util.quotef(random_source)) end
    src_name = random_source
  end
  if use_reservoir then
    n_lines = reservoir_sample(ahead_lines, eolbyte, &rsrv)
    ahead_lines = n_lines
  end
  if not (head_lines == 0 or echo or input_range) and sys.close(0) ~= 0 then
    die_errno(sys.errno(), 'read error')
  end
  local perm: sequence(uint64)
  if not rep then perm = randperm_new(ahead_lines, n_lines) end
  if have_out then
    local fd = sys.open(outfile, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, 0x1B6)
    if fd < 0 then die_errno(sys.errno(), util.quotef(outfile)) end
    util.setout(fd)
  end
  local nb: [1]byte = {eolbyte}
  if rep then
    if head_lines ~= 0 then
      if n_lines == 0 then die('no lines to repeat') end
      local i: uint64 = 0
      while i < ahead_lines do
        if input_range then
          local j = lo_input + randint_choose(hi_input - lo_input + 1)
          util.write(tostring(j)); util.writebytes(&nb, 1)
        else
          write_line((@integer)(randint_choose(n_lines)) + 1)
        end
        i = i + 1
      end
    end
  else
    for i = 1, #perm do
      if use_reservoir then
        local l = &rsrv[(@integer)(perm[i]) + 1]
        if #l > 0 then util.writebytes(&l[1], (@usize)(#l)) end
      elseif input_range then
        util.write(tostring(lo_input + perm[i])); util.writebytes(&nb, 1)
      else
        write_line((@integer)(perm[i]) + 1)
      end
    end
  end
  if not util.flush() then die_errno(sys.errno(), 'write error') end
  return 0
end
