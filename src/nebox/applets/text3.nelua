-- od hexdump shuf tsort free
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.longopts'

-- od ------------------------------------------------------------------------
local OdFmt = @record{ kind: byte, size: integer }   -- kind: a c d u o x

local function od_item(kind: byte, size: integer, v: uint64): string
  if kind == 120 then
    if size == 1 then return string.format('%02x', v) elseif size == 2 then return string.format('%04x', v)
    elseif size == 4 then return string.format('%08x', v) end
    return string.format('%016x', v)
  elseif kind == 111 then
    if size == 1 then return string.format('%03o', v) elseif size == 2 then return string.format('%06o', v)
    elseif size == 4 then return string.format('%011o', v) end
    return string.format('%022o', v)
  elseif kind == 117 then
    if size == 1 then return string.format('%3u', v) elseif size == 2 then return string.format('%5u', v)
    elseif size == 4 then return string.format('%10u', v) end
    return string.format('%20u', v)
  elseif kind == 100 then
    local sv: int64
    if size == 1 then sv = (@int64)((@int8)(v)) elseif size == 2 then sv = (@int64)((@int16)(v))
    elseif size == 4 then sv = (@int64)((@int32)(v)) else sv = (@int64)(v) end
    if size == 1 then return string.format('%4d', sv) elseif size == 2 then return string.format('%6d', sv)
    elseif size == 4 then return string.format('%11d', sv) end
    return string.format('%20d', sv)
  elseif kind == 99 then
    local b = (@byte)(v & 0xFF)
    if b == 0 then return ' \\0' elseif b == 7 then return ' \\a' elseif b == 8 then return ' \\b'
    elseif b == 9 then return ' \\t' elseif b == 10 then return ' \\n' elseif b == 11 then return ' \\v'
    elseif b == 12 then return ' \\f' elseif b == 13 then return ' \\r'
    elseif b >= 32 and b < 127 then return string.format('  %c', b) end
    return string.format('%03o', b)
  else -- 'a' named characters
    local b = (@byte)(v & 0x7F)
    local names: []string = {'nul','soh','stx','etx','eot','enq','ack','bel','bs','ht','nl','vt','ff','cr','so','si',
      'dle','dc1','dc2','dc3','dc4','nak','syn','etb','can','em','sub','esc','fs','gs','rs','us','sp'}
    if b <= 32 then return string.format('%3s', names[b]) end
    if b == 127 then return 'del' end
    return string.format('  %c', b)
  end
end

local function od_addr(kind: byte, off: integer): string
  if kind == 100 then return string.format('%07d', off)
  elseif kind == 120 then return string.format('%06x', off)
  elseif kind == 110 then return '' end
  return string.format('%07o', off)
end

global function applet_od(args: sequence(string)): integer
  local fmts: sequence(OdFmt)
  local addr: byte = 111
  local skip: integer = 0
  local limit: integer = -1
  local verbose = false
  local files: sequence(string)
  local i: integer = 1
  while i <= #args do
    local a = args[i]
    if a == '--' then i = i + 1; break end
    if a.size < 2 or a:byte(1) ~= 45 then break end
    local j: usize = 2
    while j <= a.size do
      local c = a:byte(j)
      if c == 118 then verbose = true
      elseif c == 98 then fmts:push((@OdFmt){111, 1})
      elseif c == 99 then fmts:push((@OdFmt){99, 1})
      elseif c == 100 then fmts:push((@OdFmt){117, 2})
      elseif c == 111 then fmts:push((@OdFmt){111, 2})
      elseif c == 120 then fmts:push((@OdFmt){120, 2})
      elseif c == 115 then fmts:push((@OdFmt){100, 2})
      elseif c == 105 then fmts:push((@OdFmt){100, 4})
      elseif c == 108 then fmts:push((@OdFmt){100, 8})
      elseif c == 97 then fmts:push((@OdFmt){97, 1})
      elseif c == 65 or c == 116 or c == 106 or c == 78 or c == 119 then
        local v: string
        if j < a.size then v = a:sub(j + 1) else
          i = i + 1
          if i > #args then return util.die("option requires an argument -- '" .. string.char(c) .. "'") end
          v = args[i]
        end
        if c == 65 then
          if v.size ~= 1 or ('doxn'):find(v, 1, true) <= 0 then return util.die("invalid output address radix '" .. v .. "'") end
          addr = v:byte(1)
        elseif c == 116 then
          local k: usize = 1
          while k <= v.size do
            local kind = v:byte(k); k = k + 1
            if ('acdouxf'):find(string.char(kind), 1, true) <= 0 then return util.die("invalid type string '" .. v .. "'") end
            if kind == 102 then return util.die('floating point output is not supported') end
            local size: integer = (kind == 97 or kind == 99) and 1 or 4
            if k <= v.size then
              local sc = v:byte(k)
              if sc == 67 then size = 1; k = k + 1 elseif sc == 83 then size = 2; k = k + 1
              elseif sc == 73 then size = 4; k = k + 1 elseif sc == 76 then size = 8; k = k + 1
              elseif sc >= 48 and sc <= 57 then
                size = sc - 48; k = k + 1
                if size ~= 1 and size ~= 2 and size ~= 4 and size ~= 8 then return util.die("invalid type string '" .. v .. "'") end
              end
            end
            fmts:push((@OdFmt){kind, size})
          end
        elseif c == 106 then
          local n, ok = util.tosize(v); if not ok then return util.die("invalid suffix in --skip-bytes argument '" .. v .. "'") end
          skip = n
        elseif c == 78 then
          local n, ok = util.tosize(v); if not ok then return util.die("invalid suffix in --read-bytes argument '" .. v .. "'") end
          limit = n
        else
          return util.die('-w is not supported')
        end
        break
      else
        return util.die("invalid option -- '" .. string.char(c) .. "'")
      end
      j = j + 1
    end
    i = i + 1
  end
  while i <= #args do files:push(args[i]); i = i + 1 end
  if #fmts == 0 then fmts:push((@OdFmt){111, 2}) end
  if #files == 0 then files:push('-') end
  local all: stringbuilder
  for _, f in ipairs(files) do
    local d, ok = util.readfile(f)
    if not ok then return 1 end
    all:write(d)
  end
  local data = all:promote()
  if skip > (@integer)(data.size) then return util.die('cannot skip past end of combined input') end
  local stop = (@integer)(data.size)
  if limit >= 0 and skip + limit < stop then stop = skip + limit end
  -- GNU pads every format's items so each 16-byte block prints at the same width
  local width_per_block: integer = 0
  for _, fm in ipairs(fmts) do
    local w = (@integer)(od_item(fm.kind, fm.size, 0).size)
    local total = (w + 1) * (16 // fm.size)
    if total > width_per_block then width_per_block = total end
  end
  local off = skip
  local prevline: string = ''
  local star = false
  while off < stop do
    local n = stop - off
    if n > 16 then n = 16 end
    local sb: stringbuilder
    for fi, fm in ipairs(fmts) do
      if fi > 1 then sb:write('\n') end
      if fi == 1 then
        local a = od_addr(addr, off)
        sb:write(a)
      else
        local a = od_addr(addr, off)
        for _ = 1, a.size do sb:write(' ') end
      end
      local per = width_per_block // (16 // fm.size)
      local p: integer = 0
      while p < n do
        local sz = fm.size
        if p + sz > n then sz = n - p end
        local v: uint64 = 0
        for b = sz - 1, 0, -1 do v = (v << 8) | (@uint64)(data.data[off + p + b]) end
        local item = od_item(fm.kind, fm.size, v)
        for _ = (@integer)(item.size) + 1, per do sb:write(' ') end
        sb:write(item)
        p = p + fm.size
      end
    end
    local line = sb:promote()
    local body = line:sub(8)
    if not verbose and off > skip and n == 16 and body == prevline then
      if not star then util.line('*'); star = true end
    else
      util.line(line); star = false
    end
    prevline = body
    off = off + n
  end
  if addr ~= 110 then util.line(od_addr(addr, stop)) end
  return 0
end

-- hexdump ---------------------------------------------------------------------
global function applet_hexdump(args: sequence(string)): integer
  local o = util.parse(args, 'Cvn:s:bcdox')
  if not o:ok() then return util.optfail(o) end
  if #o.operands == 0 then o.operands:push('-') end
  local all: stringbuilder
  for _, f in ipairs(o.operands) do
    local d, ok = util.readfile(f)
    if not ok then return 1 end
    all:write(d)
  end
  local data = all:promote()
  local skip: integer = 0
  if o:has('s') then
    local n, ok = util.tosize(o:get('s')); if not ok then return util.die("bad skip value") end
    skip = n
  end
  local stop = (@integer)(data.size)
  if o:has('n') then
    local n, ok = util.tosize(o:get('n')); if not ok then return util.die("bad length value") end
    if skip + n < stop then stop = skip + n end
  end
  local canonical = o:has('C')
  local off = skip
  local prev: string = ''
  local star = false
  while off < stop do
    local n = stop - off
    if n > 16 then n = 16 end
    local sb: stringbuilder
    if canonical then sb:writef('%08x ', off) else sb:writef('%07x', off) end
    if canonical then
      for p = 0, 15 do
        if p == 8 then sb:write(' ') end
        if p < n then sb:writef(' %02x', data.data[off + p]) else sb:write('   ') end
      end
      sb:write('  |')
      for p = 0, < n do
        local b = data.data[off + p]
        sb:writebyte((b >= 32 and b < 127) and b or 46)
      end
      sb:write('|')
    elseif o:has('c') then
      for p = 0, < n do
        local b = data.data[off + p]
        if b == 0 then sb:write('  \\0') elseif b == 10 then sb:write('  \\n') elseif b == 9 then sb:write('  \\t')
        elseif b == 13 then sb:write('  \\r') elseif b >= 32 and b < 127 then sb:writef('   %c', b)
        else sb:writef(' %03o', b) end
      end
    elseif o:has('b') then
      for p = 0, < n do sb:writef(' %03o', data.data[off + p]) end
    elseif o:has('d') or o:has('o') or o:has('x') then
      local p: integer = 0
      while p < n do
        local v: uint64 = (@uint64)(data.data[off + p])
        if p + 1 < n then v = v | ((@uint64)(data.data[off + p + 1]) << 8) end
        if o:has('d') then sb:writef('   %05d', v) elseif o:has('o') then sb:writef('  %06o', v) else sb:writef('    %04x', v) end
        p = p + 2
      end
    else
      local p: integer = 0
      while p < n do
        local v: uint64 = (@uint64)(data.data[off + p])
        if p + 1 < n then v = v | ((@uint64)(data.data[off + p + 1]) << 8) end
        sb:writef(' %04x', v)
        p = p + 2
      end
    end
    local line = sb:promote()
    local body = line:sub(8)
    if not o:has('v') and off > skip and n == 16 and body == prev then
      if not star then util.line('*'); star = true end
    else
      util.line(line); star = false
    end
    prev = body
    off = off + n
  end
  if canonical then util.writef('%08x\n', stop) else util.writef('%07x\n', stop) end
  return 0
end

-- shuf ------------------------------------------------------------------------
local function rand_below(n: integer): integer
  local r: uint64
  sys.getrandom(&r, 8, 0)
  return (@integer)(r % (@uint64)(n))
end

global function applet_shuf(args: sequence(string)): integer
  local o = util.parsel(args, 'ern:i:o:z', &longopts.shuf, #longopts.shuf)
  if not o:ok() then return util.optfail(o) end
  local items: sequence(string)
  if o:has('e') then
    for _, a in ipairs(o.operands) do items:push(a) end
  elseif o:has('i') then
    local spec = o:get('i')
    local dash = spec:find('-', 1, true)
    if dash <= 0 then return util.die("invalid input range: '" .. spec .. "'") end
    local lo, ok1 = util.toint(spec:sub(1, dash - 1))
    local hi, ok2 = util.toint(spec:sub(dash + 1))
    if not ok1 or not ok2 or hi < lo - 1 then return util.die("invalid input range: '" .. spec .. "'") end
    for v = lo, hi do items:push(string.format('%d', v)) end
  else
    if #o.operands > 1 then return util.die("extra operand '" .. o.operands[2] .. "'") end
    local d, ok = util.readfile(#o.operands == 1 and o.operands[1] or '-')
    if not ok then return 1 end
    items = util.lines(d)
  end
  local count: integer = #items
  if o:has('n') then
    local v, ok = util.toint(o:get('n'))
    if not ok or v < 0 then return util.die("invalid line count: '" .. o:get('n') .. "'") end
    if v < count then count = v end
  end
  if o:has('o') then
    local fd = sys.open(o:get('o'), sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, 0x1B6)
    if fd < 0 then util.perror(o:get('o')); return 1 end
    util.setout(fd)
  end
  local term: byte = o:has('z') and 0 or 10
  if o:has('r') then
    if #items == 0 then return 0 end
    if not o:has('n') then count = 1 << 40 end
    for _ = 1, count do util.write(items[rand_below(#items) + 1]); util.writebyte(term) end
  else
    -- partial Fisher-Yates
    for k = 1, count do
      local j = k + rand_below(#items - k + 1)
      local t = items[k]; items[k] = items[j]; items[j] = t
      util.write(items[k]); util.writebyte(term)
    end
  end
  util.flush(); util.setout(1)
  return 0
end

-- tsort -----------------------------------------------------------------------
global function applet_tsort(args: sequence(string)): integer
  if #args > 1 then return util.die("extra operand '" .. args[2] .. "'") end
  local path: string = #args == 1 and args[1] or '-'
  local data, ok = util.readfile(path)
  if not ok then return 1 end
  local toks: sequence(string)
  for _, line in ipairs(util.lines(data)) do
    for w in line:gmatch('%S+') do toks:push(w) end
  end
  if #toks % 2 ~= 0 then return util.die((path == '-' and '-' or path) .. ': input contains an odd number of tokens') end
  local names: sequence(string)
  local indeg: sequence(integer)
  local succ: sequence(sequence(integer))
  for k = 1, #toks, 2 do
    local ids: [2]integer
    for s = 0, 1 do
      local t = toks[k + s]
      local id: integer = -1
      for i, nm in ipairs(names) do if nm == t then id = i; break end end
      if id < 0 then
        names:push(t); indeg:push(0)
        local e: sequence(integer)
        succ:push(e)
        id = #names
      end
      ids[s] = id
    end
    if ids[0] ~= ids[1] then
      -- GNU prepends to the successor list
      local e = succ[ids[0]]
      e:insert(1, ids[1])
      succ[ids[0]] = e
      indeg[ids[1]] = indeg[ids[1]] + 1
    end
  end
  -- initial zero-degree queue in sorted name order
  local order: sequence(string)
  for _, nm in ipairs(names) do order:push(nm) end
  util.sort(order, util.name_less)
  local queue: sequence(integer)
  local done: sequence(boolean)
  for _ = 1, #names do done:push(false) end
  for _, nm in ipairs(order) do
    for i, n2 in ipairs(names) do
      if n2 == nm and indeg[i] == 0 then queue:push(i) end
    end
  end
  local emitted: integer = 0
  local qi: integer = 1
  while qi <= #queue do
    local id = queue[qi]; qi = qi + 1
    util.line(names[id]); done[id] = true; emitted = emitted + 1
    for _, s in ipairs(succ[id]) do
      indeg[s] = indeg[s] - 1
      if indeg[s] == 0 then queue:push(s) end
    end
  end
  if emitted < #names then
    util.err((path == '-' and '-' or path) .. ': input contains a loop:')
    for i, nm in ipairs(names) do
      if not done[i] then util.line(nm) end
    end
    return 1
  end
  return 0
end

-- free ------------------------------------------------------------------------
local function meminfo(data: string, key: string): integer
  for _, line in ipairs(util.lines(data)) do
    if line.size > key.size and line:sub(1, key.size + 1) == key .. ':' then
      local v: integer = 0
      for w in line:gmatch('%d+') do local okv: boolean; v, okv = util.toint(w); break end
      return v
    end
  end
  return 0
end

global function applet_free(args: sequence(string)): integer
  local o = util.parse(args, 'bkmghwt')
  if not o:ok() then return util.optfail(o) end
  local data, ok = util.readfile('/proc/meminfo')
  if not ok then return 1 end
  local total = meminfo(data, 'MemTotal')
  local free = meminfo(data, 'MemFree')
  local avail = meminfo(data, 'MemAvailable')
  local buffers = meminfo(data, 'Buffers')
  local cached = meminfo(data, 'Cached') + meminfo(data, 'SReclaimable')
  local shared = meminfo(data, 'Shmem')
  local stotal = meminfo(data, 'SwapTotal')
  local sfree = meminfo(data, 'SwapFree')
  local used = total - free - buffers - cached
  local div: integer = 1
  if o:has('b') then div = 0 elseif o:has('m') then div = 1024 elseif o:has('g') then div = 1024 * 1024 end
  local cols: [6]integer = {total, used, free, shared, buffers + cached, avail}
  util.line('               total        used        free      shared  buff/cache   available')
  util.write('Mem:')
  for k = 0, 5 do
    local v = cols[k]
    local s: string
    if o:has('h') then s = util.human(v * 1024)
    elseif div == 0 then s = string.format('%d', v * 1024)
    else s = string.format('%d', v // div) end
    util.writef('%12s', s)
  end
  util.writebyte(10)
  util.write('Swap:')
  local swaps: [3]integer = {stotal, stotal - sfree, sfree}
  for k = 0, 2 do
    local v = swaps[k]
    local s: string
    if o:has('h') then s = util.human(v * 1024)
    elseif div == 0 then s = string.format('%d', v * 1024)
    else s = string.format('%d', v // div) end
    util.writef('%11s', s)
  end
  util.writebyte(10)
  return 0
end
