-- More process applets: whoami groups tty xargs timeout expr factor
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.longopts'
require 'nebox.regex'
require 'nebox.applets.proc'

global function applet_whoami(args: sequence(string)): integer
  if #args > 0 then return util.die("extra operand '" .. args[1] .. "'") end
  local uid = (@integer)(sys.geteuid())
  local name = util.username(uid)
  if name.size == 0 then return util.die(string.format("cannot find name for user ID %d", uid)) end
  util.line(name)
  return 0
end

global function applet_groups(args: sequence(string)): integer
  if #args > 0 then return util.die("looking up other users is not supported") end
  local list: [256]cuint
  local n = sys.getgroups(256, &list[0])
  if n < 0 then return util.die('cannot get groups: ' .. sys.errstr()) end
  local egid = (@integer)(sys.getegid())
  util.write(util.idname(util.groupname(egid), egid))
  for i: integer = 0, < n do
    local g = (@integer)(list[i])
    if g == egid then continue end
    util.write(' ' .. util.idname(util.groupname(g), g))
  end
  util.writebyte(10)
  return 0
end

global function applet_tty(args: sequence(string)): integer
  local o = util.parsel(args, 's', &longopts.tty, #longopts.tty)
  if not o:ok() then return util.optfail(o) end
  if #o.operands > 0 then return util.die("extra operand '" .. o.operands[1] .. "'") end
  if sys.isatty(0) == 0 then
    if not o:has('s') then util.line('not a tty') end
    return 1
  end
  if o:has('s') then return 0 end
  local buf: [4096]byte
  local n = sys.readlink('/proc/self/fd/0', &buf[0], #buf)
  if n <= 0 then return util.die('cannot resolve stdin: ' .. sys.errstr()) end
  util.writebytes(&buf[0], (@usize)(n)); util.writebyte(10)
  return 0
end

-- Run argv as a child; returns the wait status mapped to an exit code
-- (128+signal when killed), or 126/127 when exec fails.
global function spawn_wait(argv: sequence(string)): integer
  local cargv: sequence(cstring)
  for _, a in ipairs(argv) do cargv:push(a) end
  cargv:push(nilptr)
  util.flush()
  local pid = sys.fork()
  if pid < 0 then util.err(util.applet .. ': cannot fork: ' .. sys.errstr()); return 126 end
  if pid == 0 then
    sys.execvp(argv[1], &cargv[1])
    local e = sys.errno()
    util.err(util.applet .. ": " .. argv[1] .. ": " .. sys.errstr())
    util.flush()
    sys._exit(e == sys.ENOENT and 127 or 126)
  end
  local status: cint = 0
  while sys.waitpid(pid, &status, 0) < 0 do
    if sys.errno() ~= sys.EINTR then return 126 end
  end
  if (status & 0x7F) == 0 then return (status >> 8) & 0xFF end
  return 128 + (status & 0x7F)
end

-- xargs: -0, -n N, -I REPL, -r, -t, -E EOF, -a FILE; default command echo
local function xargs_split(data: string, nul: boolean, eof: string): (sequence(string), string)
  local out: sequence(string)
  if nul then
    local start: usize = 0
    for i: usize = 0, data.size do
      if i == data.size or data.data[i] == 0 then
        if i > start or i < data.size then out:push(data:sub(start + 1, i)) end
        start = i + 1
      end
    end
    return out, ''
  end
  local i: usize = 0
  while i < data.size do
    local c = data.data[i]
    if c == 32 or c == 9 or c == 10 then i = i + 1; continue end
    local sb: stringbuilder
    while i < data.size do
      c = data.data[i]
      if c == 32 or c == 9 or c == 10 then break end
      if c == 34 or c == 39 then
        local q = c
        i = i + 1
        local closed = false
        while i < data.size do
          if data.data[i] == q then closed = true; i = i + 1; break end
          if data.data[i] == 10 then return out, 'unmatched ' .. (q == 34 and 'double' or 'single') .. ' quote; by default quotes are special to xargs unless you use the -0 option' end
          sb:writebyte(data.data[i]); i = i + 1
        end
        if not closed then return out, 'unmatched ' .. (q == 34 and 'double' or 'single') .. ' quote; by default quotes are special to xargs unless you use the -0 option' end
      elseif c == 92 and i + 1 < data.size then
        sb:writebyte(data.data[i + 1]); i = i + 2
      else
        sb:writebyte(c); i = i + 1
      end
    end
    local word = sb:promote()
    if eof.size > 0 and word == eof then break end
    out:push(word)
  end
  return out, ''
end

local function replace_all(s: string, needle: string, rep: string): string
  if needle.size == 0 then return s end
  local sb: stringbuilder
  local pos: isize = 1
  while true do
    local at = s:find(needle, pos, true)
    if at <= 0 then sb:write(s:sub(pos)); break end
    sb:write(s:sub(pos, at - 1)); sb:write(rep)
    pos = at + (@isize)(needle.size)
  end
  return sb:promote()
end

global function applet_xargs(args: sequence(string)): integer
  local o = util.parse(args, '+0rtn:I:E:a:s:')
  if not o:ok() then return util.optfail(o) end
  local cmd: sequence(string)
  if #o.operands == 0 then cmd:push('echo') else for _, a in ipairs(o.operands) do cmd:push(a) end end
  local per: integer = 0
  if o:has('n') then
    local v, ok = util.toint(o:get('n'))
    if not ok or v <= 0 then return util.die("invalid number of arguments: '" .. o:get('n') .. "'") end
    per = v
  end
  local data: string
  local ok: boolean
  if o:has('a') then data, ok = util.readfile(o:get('a')) else data, ok = util.readfd(0) end
  if not ok then return 1 end
  local items: sequence(string)
  if o:has('I') then
    -- one line per command, leading blanks stripped
    for _, line in ipairs(util.lines(data)) do
      local s: usize = 1
      while s <= line.size and (line:byte(s) == 32 or line:byte(s) == 9) do s = s + 1 end
      if s <= line.size then items:push(line:sub(s)) end
    end
    per = 1
  else
    local err: string
    items, err = xargs_split(data, o:has('0'), o:has('E') and o:get('E') or '')
    if err.size > 0 then return util.die(err) end
  end
  if #items == 0 and (o:has('r') or o:has('I')) then return 0 end
  local rc: integer = 0
  local i: integer = 1
  repeat
    local argv: sequence(string)
    local stop = #items
    if per > 0 and i + per - 1 < stop then stop = i + per - 1 end
    if o:has('I') then
      local repl = o:get('I')
      for _, c in ipairs(cmd) do argv:push(replace_all(c, repl, items[i])) end
    else
      for _, c in ipairs(cmd) do argv:push(c) end
      for k = i, stop do argv:push(items[k]) end
    end
    if o:has('t') then
      local sb: stringbuilder
      for k, a in ipairs(argv) do if k > 1 then sb:write(' ') end; sb:write(a) end
      util.flush()
      local msg = sb:promote() .. '\n'
      sys.write(2, msg.data, msg.size)
    end
    local r = spawn_wait(argv)
    if r == 255 then return 124 end
    if r >= 128 then return 125 end
    if r == 126 or r == 127 then return r end
    if r ~= 0 then rc = 123 end
    i = stop + 1
  until i > #items
  return rc
end


