## pragmas.nogc = true
require 'string'
require 'sequence'
require 'nebox.gzip'
require 'nebox.util'

local function mkstemp(path: cstring): cint <cimport 'mkstemp', cinclude '<stdlib.h>'> end
local function fchmod(fd: cint, mode: cuint): cint <cimport 'fchmod', cinclude '<sys/stat.h>'> end
local function futimens(fd: cint, times: *[2]sys.Timespec): cint <cimport 'futimens', cinclude '<sys/stat.h>'> end

local Options = @record{decode: boolean, stdout: boolean, keep: boolean, force: boolean, test: boolean, level: integer}

local function name_for(path: string, decode: boolean): string
  if decode then
    if #path > 4 and path:sub(-4) == '.tgz' then return path:sub(1, -5) .. '.tar' end
    if #path > 3 and path:sub(-3) == '.gz' then return path:sub(1, -4) end
    util.err(path .. ': unknown gzip suffix')
  elseif #path >= 3 and path:sub(-3) == '.gz' then
    util.err(path .. ': already has .gz suffix')
  else return path .. '.gz' end
  return ''
end

local function transform(input: cint, output: cint, opts: *Options, name: string): boolean
  local ok: boolean
  if opts.decode then ok = gzip.decode(input, output)
  else ok = gzip.encode_level(input, output, opts.level) end
  if not ok then
    if opts.decode then util.err(name .. ': invalid gzip stream or I/O error')
    else util.err(name .. ': gzip I/O error') end
  end
  return ok
end

local function process(name: string, opts: *Options): boolean
  local file_output = name ~= '-' and not opts.stdout and not opts.test
  local input: cint = 0
  local source: sys.Stat
  local dest = ''
  if file_output then
    dest = name_for(name, opts.decode)
    if #dest == 0 then return false end
    if sys.lstat(name, &source) < 0 then util.perror(name); return false end
    if (source.st_mode & sys.S_IFMT) ~= sys.S_IFREG then util.err(name .. ': not a regular file'); return false end
  end
  if name ~= '-' then
    local flags = sys.O_RDONLY
    if file_output then flags = flags | sys.O_NOFOLLOW end
    input = sys.open(name, flags, 0)
    if input < 0 then util.perror(name); return false end
  end
  if not file_output then
    local out: cint = 1
    if opts.test then out = -1 end
    local ok = false
    if not opts.force and ((opts.decode and sys.isatty(input) ~= 0) or (not opts.decode and sys.isatty(out) ~= 0)) then
      util.err('refusing to use a terminal for compressed data (use -f to force)')
    else ok = transform(input, out, opts, name) end
    if name ~= '-' then sys.close(input) end
    return ok
  end
  if sys.fstat(input, &source) ~= 0 then util.perror(name); sys.close(input); return false end
  if source.st_nlink > 1 and not opts.force and not opts.keep then
    util.err(name .. ': has other links (use -k or -f)'); sys.close(input); return false
  end
  -- Write beside the destination, then publish in one rename. A checksum or
  -- write failure leaves both the source and any previous destination intact.
  local temp = dest .. '.XXXXXX'
  local out = mkstemp((@cstring)(temp.data))
  if out < 0 then util.perror(dest); sys.close(input); return false end
  local ok = transform(input, out, opts, name)
  local times: [2]sys.Timespec = {source.st_atim, source.st_mtim}
  if ok and (fchmod(out, source.st_mode & 0x1ff) ~= 0 or futimens(out, &times) ~= 0) then
    util.perror(dest); ok = false
  end
  if sys.close(out) ~= 0 then util.perror(dest); ok = false end
  sys.close(input)
  if ok then
    local flags: cuint = 1 -- RENAME_NOREPLACE
    if opts.force then flags = 0 end
    if sys.renameat2(sys.AT_FDCWD, temp, sys.AT_FDCWD, dest, flags) ~= 0 then util.perror(dest); ok = false end
  end
  if not ok then sys.unlink(temp); return false end
  if not opts.keep then
    local current: sys.Stat
    if sys.lstat(name, &current) ~= 0 or current.st_dev ~= source.st_dev or current.st_ino ~= source.st_ino then
      util.err(name .. ': input changed during compression'); return false
    end
    if sys.unlink(name) ~= 0 then util.perror(name); return false end
  end
  return true
end

local function run_gzip(args: sequence(string), decode: boolean, stdout: boolean): integer
  local opts: Options
  opts.decode, opts.stdout, opts.level = decode, stdout, 6
  local longs: []util.LongOpt = {{'decompress',0,100},{'stdout',0,99},{'keep',0,107},{'force',0,102},{'test',0,116},{'help',0,104}}
  local parser = util.getopt(args, 'cdkfth123456789', &longs, #longs)
  while true do
    local c = parser:next()
    if c == -1 then break end
    if c == 99 then opts.stdout = true
    elseif c == 100 then opts.decode = true
    elseif c == 107 then opts.keep = true
    elseif c == 102 then opts.force = true
    elseif c == 116 then opts.test = true; opts.decode = true
    elseif c == 104 then
      util.write('Usage: ' .. util.applet .. ' [-cdkft1-9] [FILE ...]\n-c stdout  -d decompress  -k keep input  -f force  -t test\n')
      return 0
    elseif c >= 49 and c <= 57 then opts.level = c - 48
    else return 1 end
  end
  local files = parser:operands()
  if #files == 0 then files:push('-') end
  local status = 0
  for i = 1, #files do
    if not process(files[i], &opts) then status = 1 end
  end
  return status
end

global function applet_gzip(args: sequence(string)): integer return run_gzip(args, false, false) end
global function applet_gunzip(args: sequence(string)): integer return run_gzip(args, true, false) end
global function applet_zcat(args: sequence(string)): integer return run_gzip(args, true, true) end
