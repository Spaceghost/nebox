-- dd: a port of GNU coreutils 9.1 src/dd.c. Operands, conversions, flags,
-- numbers (with b c w k K M G T P E Z Y, kB/KiB-style second suffixes, the
-- 'B' byte suffix and one 'x' multiplication), block semantics (bs= copies
-- each read as it came; otherwise partial reads are gathered into obs-sized
-- writes), skip/seek by seeking or reading, conv=sparse, the statistics
-- lines (with gnulib human_readable's rounding), status=progress, SIGUSR1
-- and SIGINT reports, and the diagnostics' wording and quoting.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'

local function c_exit(status: cint) <cimport 'exit', cinclude '<stdlib.h>', noreturn> end
local function c_malloc(n: csize): pointer <cimport 'malloc', cinclude '<stdlib.h>'> end
local function c_ftruncate(fd: cint, len: clong): cint <cimport 'ftruncate', cinclude '<unistd.h>'> end
local function c_fsync(fd: cint): cint <cimport 'fsync', cinclude '<unistd.h>'> end
local function c_fdatasync(fd: cint): cint <cimport 'fdatasync', cinclude '<unistd.h>'> end
local function c_fadvise(fd: cint, off: clong, len: clong, advice: cint): cint <cimport 'posix_fadvise', cinclude '<fcntl.h>'> end
local function c_getpagesize(): cint <cimport 'getpagesize', cinclude '<unistd.h>'> end

local INT64_MAX: int64 <comptime> = 0x7fffffffffffffff
local IO_BUFSIZE: int64 <comptime> = 131072
local F_SETFL: cint <comptime> = 4
local SIGUSR1: cint <comptime> = 10
local ENOSPC: cint <comptime> = 28
local EINVAL: cint <comptime> = 22
local ENOSYS: cint <comptime> = 38
local EOVERFLOW: cint <comptime> = 75
local EMLINK: cint <comptime> = 31
local POSIX_FADV_DONTNEED: cint <comptime> = 4

-- Linux open flags, and private flags in bits open() does not use.
local O_NONBLOCK: cint <comptime> = 0x800
local O_DSYNC: cint <comptime> = 0x1000
local O_SYNC: cint <comptime> = 0x101000
local O_DIRECT: cint <comptime> = 0x4000
local O_NOATIME: cint <comptime> = 0x40000
local O_NOCTTY: cint <comptime> = 0x100
local O_FULLBLOCK: cint <comptime> = 0x1000000
local O_NOCACHE: cint <comptime> = 0x2000000
local O_COUNT_BYTES: cint <comptime> = 0x4000000
local O_SKIP_BYTES: cint <comptime> = 0x8000000
local O_SEEK_BYTES: cint <comptime> = 0x10000000
local O_PRIVATE: cint <comptime> = 0x1f000000

local C_ASCII: integer <comptime> = 0x1
local C_EBCDIC: integer <comptime> = 0x2
local C_IBM: integer <comptime> = 0x4
local C_BLOCK: integer <comptime> = 0x8
local C_UNBLOCK: integer <comptime> = 0x10
local C_LCASE: integer <comptime> = 0x20
local C_UCASE: integer <comptime> = 0x40
local C_SWAB: integer <comptime> = 0x80
local C_NOERROR: integer <comptime> = 0x100
local C_NOTRUNC: integer <comptime> = 0x200
local C_SYNC: integer <comptime> = 0x400
local C_TWOBUFS: integer <comptime> = 0x800
local C_NOCREAT: integer <comptime> = 0x1000
local C_EXCL: integer <comptime> = 0x2000
local C_FDATASYNC: integer <comptime> = 0x4000
local C_FSYNC: integer <comptime> = 0x8000
local C_SPARSE: integer <comptime> = 0x10000

local STATUS_NONE: integer <comptime> = 1
local STATUS_NOXFER: integer <comptime> = 2
local STATUS_DEFAULT: integer <comptime> = 3
local STATUS_PROGRESS: integer <comptime> = 4

local Symbol = @record{name: string, value: integer}

local conversions: []Symbol = {
  {'ascii', C_ASCII | C_UNBLOCK | C_TWOBUFS}, {'ebcdic', C_EBCDIC | C_BLOCK | C_TWOBUFS},
  {'ibm', C_IBM | C_BLOCK | C_TWOBUFS}, {'block', C_BLOCK | C_TWOBUFS},
  {'unblock', C_UNBLOCK | C_TWOBUFS}, {'lcase', C_LCASE | C_TWOBUFS},
  {'ucase', C_UCASE | C_TWOBUFS}, {'sparse', C_SPARSE}, {'swab', C_SWAB | C_TWOBUFS},
  {'noerror', C_NOERROR}, {'nocreat', C_NOCREAT}, {'excl', C_EXCL},
  {'notrunc', C_NOTRUNC}, {'sync', C_SYNC}, {'fdatasync', C_FDATASYNC}, {'fsync', C_FSYNC},
}

-- binary, text, cio and nolinks are 0 on Linux, so GNU dd rejects them.
local flagsyms: []Symbol = {
  {'append', sys.O_APPEND}, {'binary', 0}, {'cio', 0}, {'direct', O_DIRECT},
  {'directory', sys.O_DIRECTORY}, {'dsync', O_DSYNC}, {'noatime', O_NOATIME},
  {'nocache', O_NOCACHE}, {'noctty', O_NOCTTY}, {'nofollow', sys.O_NOFOLLOW},
  {'nolinks', 0}, {'nonblock', O_NONBLOCK}, {'sync', O_SYNC}, {'text', 0},
  {'fullblock', O_FULLBLOCK}, {'count_bytes', O_COUNT_BYTES},
  {'skip_bytes', O_SKIP_BYTES}, {'seek_bytes', O_SEEK_BYTES},
}

local statuses: []Symbol = {
  {'none', STATUS_NONE}, {'noxfer', STATUS_NOXFER}, {'progress', STATUS_PROGRESS},
}

