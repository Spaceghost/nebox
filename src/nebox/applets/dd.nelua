-- State (reset by applet_dd).
local input_file: string
local output_file: string
local have_if: boolean
local have_of: boolean
local page_size: int64
local input_blocksize: int64
local output_blocksize: int64
local conversion_blocksize: int64
local skip_records: int64
local skip_bytes: int64
local seek_records: int64
local seek_bytes: int64
local final_op_was_seek: boolean
local max_records: int64
local max_bytes: int64
local conversions_mask: integer
local input_flags: cint
local output_flags: cint
local status_level: integer
local translation_needed: boolean
local w_partial: int64
local w_full: int64
local r_partial: int64
local r_full: int64
local w_bytes: int64
local reported_w_bytes: int64
local start_time: int64
local next_time: int64
local progress_len: integer
local input_seekable: boolean
local input_seek_errno: cint
local input_offset: int64
local warn_partial_read: boolean
local r_truncate: int64
local newline_character: byte
local space_character: byte
local ibuf: *[0]byte
local obuf: *[0]byte
local oc: int64
local col: int64
local interrupt_signal: cint
local info_signal_count: integer
local i_nocache: boolean
local o_nocache: boolean
local i_nocache_eof: boolean
local o_nocache_eof: boolean
local fullblock: boolean
local trans_table: [256]byte
local prev_nread: int64
local pending_spaces: int64
local i_pending: int64
local o_pending: int64
local output_offset: int64

local function now_ns(): int64
  local ts: sys.Timespec
  sys.clock_gettime(sys.CLOCK_MONOTONIC, &ts)
  return (@int64)(ts.tv_sec) * 1000000000 + (@int64)(ts.tv_nsec)
end

local function errput(s: string)
  local off: usize = 0
  while off < s.size do
    local w = sys.write(2, (@pointer)((@usize)(s.data) + off), s.size - off)
    if w <= 0 then break end
    off = off + (@usize)(w)
  end
end

-- error(0, errnum, ...): "dd: MSG[: strerror]".
local function report(msg: string, errnum: cint)
  if errnum ~= 0 then util.err(msg .. ': ' .. sys.strerror(errnum)) else util.err(msg) end
end

local function die(msg: string, errnum: cint)
  report(msg, errnum)
  c_exit(1)
end

local function usage_fail()
  errput("Try 'dd --help' for more information.\n")
  c_exit(1)
end

local function mul_ovf(a: int64, b: int64): (int64, boolean)
  if a == 0 or b == 0 then return 0, false end
  if a > INT64_MAX // b then return INT64_MAX, true end
  return a * b, false
end

local function add_ovf(a: int64, b: int64): (int64, boolean)
  if a > INT64_MAX - b then return INT64_MAX, true end
  return a + b, false
end

-- gnulib human_readable with dd's options (autoscale, round to nearest,
-- space before the unit, SI, B suffix; base 1000, or 1024 for IEC).
local power_letter: [9]byte = {0, 75, 77, 71, 84, 80, 69, 90, 89}
local function human(n: uint64, base1024: boolean, from_bs: uint64, to_bs: uint64): string
  local base: uint64 = base1024 and 1024 or 1000
  local exponent_max: integer = 8
  local exponent: integer = -1
  local amt: uint64 = 0
  local tenths: uint64 = 0
  local rounding: uint64 = 0
  local digits: string
  local use_int = false
  if to_bs <= from_bs then
    if from_bs % to_bs == 0 then
      local mul = from_bs // to_bs
      amt = n * mul
      if amt // mul == n then use_int = true end
    end
  elseif from_bs ~= 0 and to_bs % from_bs == 0 then
    local divisor = to_bs // from_bs
    local r10 = (n % divisor) * 10
    local r2 = (r10 % divisor) * 2
    amt = n // divisor
    tenths = r10 // divisor
    rounding = r2 < divisor and (r2 > 0 and 1 or 0) or (2 + (divisor < r2 and 1 or 0))
    use_int = true
  end
  if not use_int then
    local damt: float64 = (@float64)(n) * ((@float64)(from_bs) / (@float64)(to_bs))
    local e: float64 = 1
    exponent = 0
    repeat
      e = e * (@float64)(base)
      exponent = exponent + 1
    until not (e * (@float64)(base) <= damt and exponent < exponent_max)
    damt = damt / e
    digits = string.format('%.1f', damt)
    if 1 + 2 + (base1024 and 0 or 1) < digits.size then
      digits = string.format('%.0f', damt * 10 / 10)
    end
  else
    local frac = ''
    exponent = 0
    if base <= amt then
      repeat
        local r10 = (amt % base) * 10 + tenths
        local r2 = (r10 % base) * 2 + (rounding >> 1)
        amt = amt // base
        tenths = r10 // base
        if r2 < base then rounding = (r2 + rounding ~= 0) and 1 or 0
        else rounding = 2 + ((base < r2 + rounding) and 1 or 0) end
        exponent = exponent + 1
      until not (base <= amt and exponent < exponent_max)
      if amt < 10 then
        if 2 < rounding + (tenths & 1) then
          tenths = tenths + 1
          rounding = 0
          if tenths == 10 then amt = amt + 1; tenths = 0 end
        end
        if amt < 10 then
          frac = '.' .. tostring(tenths)
          tenths = 0; rounding = 0
        end
      end
    end
    if 5 < tenths + ((0 < rounding + (amt & 1)) and 1 or 0) then
      amt = amt + 1
      if amt == base and exponent < exponent_max then
        exponent = exponent + 1
        frac = '.0'
        amt = 1
      end
    end
    digits = tostring(amt) .. frac
  end
  local sb: stringbuilder
  sb:write(digits, ' ')
  if exponent > 0 then
    if not base1024 and exponent == 1 then sb:write('k') else sb:writebyte(power_letter[exponent]) end
    if base1024 then sb:write('i') end
  end
  sb:write('B')
  return sb:promote()
end

local function plural(n: int64, one: string, many: string): string
  return n == 1 and one or many
end

local function lacks_prefix(s: string): boolean
  return s:byte(s.size - 1) == 32
end

local function print_xfer_stats(progress_time: int64)
  local now = progress_time ~= 0 and progress_time or now_ns()
  local si = human((@uint64)(w_bytes), false, 1, 1)
  local iec = human((@uint64)(w_bytes), true, 1, 1)
  local delta_s: float64
  local bps: string
  if start_time < now then
    local dx = now - start_time
    delta_s = (@float64)(dx) / 1e9
    bps = human((@uint64)(w_bytes), false, 1000000000, (@uint64)(dx)) .. '/s'
  else
    delta_s = 0
    bps = 'Infinity B/s'
  end
  local ds = progress_time ~= 0 and string.format('%.0f s', delta_s) or string.format('%g s', delta_s)
  local line: string
  if lacks_prefix(si) then
    line = string.format(plural(w_bytes, '%d byte copied, %s, %s', '%d bytes copied, %s, %s'), w_bytes, ds, bps)
  elseif lacks_prefix(iec) then
    line = string.format('%d bytes (%s) copied, %s, %s', w_bytes, si, ds, bps)
  else
    line = string.format('%d bytes (%s, %s) copied, %s, %s', w_bytes, si, iec, ds, bps)
  end
  if progress_time ~= 0 then
    local sb: stringbuilder
    sb:write('\r', line)
    local len = (@integer)(line.size)
    for i = len + 1, progress_len do sb:writebyte(32) end
    progress_len = len
    errput(sb:promote())
  else
    errput(line .. '\n')
  end
  reported_w_bytes = w_bytes
end

local function print_stats()
  if status_level == STATUS_NONE then return end
  if progress_len > 0 then errput('\n'); progress_len = 0 end
  errput(string.format('%d+%d records in\n%d+%d records out\n', r_full, r_partial, w_full, w_partial))
  if r_truncate ~= 0 then
    errput(string.format(plural(r_truncate, '%d truncated record\n', '%d truncated records\n'), r_truncate))
  end
  if status_level == STATUS_NOXFER then return end
  print_xfer_stats(0)
end

local function interrupt_handler(sig: cint)
  interrupt_signal = sig
end

local function siginfo_handler(sig: cint)
  info_signal_count = info_signal_count + 1
end

local function install_signal_handlers()
  local catch_siginfo = sys.getenv('POSIXLY_CORRECT') == nilptr
  local act: sys.Sigaction
  if catch_siginfo then
    act = {}
    act.sa_handler = siginfo_handler
    act.sa_flags = 0
    sys.sigaction(SIGUSR1, &act, nilptr)
  end
  local old: sys.Sigaction
  sys.sigaction(sys.SIGINT, nilptr, &old)
  if (@usize)((@pointer)(old.sa_handler)) ~= sys.SIG_IGN then
    act = {}
    act.sa_handler = interrupt_handler
    local fl: uint32 = 0xC0000000   -- SA_NODEFER | SA_RESETHAND
    act.sa_flags = (@cint)(fl)
    sys.sigaction(sys.SIGINT, &act, nilptr)
  end
end

local function iclose(fd: cint): cint
  if sys.close(fd) ~= 0 then
    repeat
      if sys.errno() ~= sys.EINTR then return -1 end
    until not (sys.close(fd) ~= 0 and sys.errno() ~= sys.EBADF)
  end
  return 0
end

local synchronize_output: function(): integer

local function cleanup()
  if interrupt_signal == 0 then
    local st = synchronize_output()
    if st ~= 0 then c_exit((@cint)(st)) end
  end
  if iclose(0) ~= 0 then die('closing input file ' .. util.quoteaf(input_file), sys.errno()) end
  if iclose(1) ~= 0 then die('closing output file ' .. util.quoteaf(output_file), sys.errno()) end
end

local function process_signals()
  while interrupt_signal ~= 0 or info_signal_count ~= 0 do
    local interrupt = interrupt_signal
    if info_signal_count > 0 then info_signal_count = info_signal_count - 1 end
    if interrupt ~= 0 then cleanup() end
    print_stats()
    if interrupt ~= 0 then sys.kill(sys.getpid(), interrupt) end
  end
end

local function finish_up()
  process_signals()
  cleanup()
  print_stats()
end

local function quit(code: cint)
  finish_up()
  c_exit(code)
end

local function cache_round(fd: cint, len: int64): int64
  local pending: *int64 = fd == 0 and &i_pending or &o_pending
  if len ~= 0 then
    local c_pending, ovf = add_ovf($pending, len)
    $pending = c_pending % IO_BUFSIZE
    if c_pending > $pending then len = c_pending - $pending else len = 0 end
  else
    len = $pending
  end
  return len
end

local function invalidate_cache(fd: cint, len: int64): boolean
  local adv_ret: cint = -1
  local offset: int64
  local nocache_eof = fd == 0 and i_nocache_eof or o_nocache_eof
  local clen = cache_round(fd, len)
  if len ~= 0 and clen == 0 then return true
  elseif len == 0 and clen == 0 and not nocache_eof then return true end
  local pending: int64 = len ~= 0 and cache_round(fd, 0) or 0
  if fd == 0 then
    if input_seekable then offset = input_offset
    else offset = -1; sys.seterrno(sys.ESPIPE) end
  else
    if output_offset ~= -1 then
      if output_offset < 0 then output_offset = sys.lseek(fd, 0, sys.SEEK_CUR)
      elseif len ~= 0 then output_offset = output_offset + clen + pending end
    end
    offset = output_offset
  end
  if 0 <= offset then
    if len == 0 and clen ~= 0 and nocache_eof then pending = clen; clen = 0 end
    offset = offset - clen - pending
    if clen == 0 then offset = offset - offset % page_size end
    adv_ret = c_fadvise(fd, offset, clen, POSIX_FADV_DONTNEED)
  end
  return adv_ret ~= -1
end

local function iread(fd: cint, buf: *[0]byte, size: int64): int64
  local nread: int64
  repeat
    process_signals()
    nread = sys.read(fd, buf, (@csize)(size))
    if nread == -1 and sys.errno() == EINVAL and 0 < prev_nread and prev_nread < size
       and (input_flags & O_DIRECT) ~= 0 then
      sys.seterrno(0)
      nread = 0
    end
  until not (nread < 0 and sys.errno() == sys.EINTR)
  if 0 < nread and nread < size then process_signals() end
  if 0 < nread and warn_partial_read then
    if 0 < prev_nread and prev_nread < size then
      if status_level ~= STATUS_NONE then
        report(string.format(plural(prev_nread, 'warning: partial read (%d byte); suggest iflag=fullblock',
          'warning: partial read (%d bytes); suggest iflag=fullblock'), prev_nread), 0)
      end
      warn_partial_read = false
    end
  end
  prev_nread = nread
  return nread
end

local function iread_fnc(fd: cint, buf: *[0]byte, size: int64): int64
  if not fullblock then return iread(fd, buf, size) end
  local nread: int64 = 0
  local p = buf
  while 0 < size do
    local ncurr = iread(fd, p, size)
    if ncurr < 0 then return ncurr end
    if ncurr == 0 then break end
    nread = nread + ncurr
    p = (@*[0]byte)(&p[ncurr])
    size = size - ncurr
  end
  return nread
end

local function is_nul(buf: *[0]byte, size: int64): boolean
  for i = 0, < size do
    if buf[i] ~= 0 then return false end
  end
  return true
end

local function iwrite(fd: cint, buf: *[0]byte, size: int64): int64
  local total: int64 = 0
  if (output_flags & O_DIRECT) ~= 0 and size < output_blocksize then
    local old_flags = sys.fcntl(1, sys.F_GETFL, 0)
    if sys.fcntl(1, F_SETFL, old_flags & ~O_DIRECT) ~= 0 and status_level ~= STATUS_NONE then
      report('failed to turn off O_DIRECT: ' .. util.quotef(output_file), sys.errno())
    end
    o_nocache_eof = true
    invalidate_cache(1, 0)
    conversions_mask = conversions_mask | C_FSYNC
  end
  while total < size do
    local nwritten: int64 = 0
    process_signals()
    final_op_was_seek = false
    if (conversions_mask & C_SPARSE) ~= 0 and is_nul(buf, size) then
      if sys.lseek(fd, size, sys.SEEK_CUR) < 0 then
        conversions_mask = conversions_mask & ~C_SPARSE
      else
        final_op_was_seek = true
        nwritten = size
      end
    end
    if nwritten == 0 then
      nwritten = sys.write(fd, &buf[total], (@csize)(size - total))
    end
    if nwritten < 0 then
      if sys.errno() ~= sys.EINTR then break end
    elseif nwritten == 0 then
      sys.seterrno(ENOSPC)
      break
    else
      total = total + nwritten
    end
  end
  if o_nocache and total ~= 0 then invalidate_cache(fd, total) end
  return total
end

local function write_output()
  local nwritten = iwrite(1, obuf, output_blocksize)
  w_bytes = w_bytes + nwritten
  if nwritten ~= output_blocksize then
    report('writing to ' .. util.quoteaf(output_file), sys.errno())
    if nwritten ~= 0 then w_partial = w_partial + 1 end
    quit(1)
  else
    w_full = w_full + 1
  end
  oc = 0
end

local function output_char(c: byte)
  obuf[oc] = c
  oc = oc + 1
  if oc >= output_blocksize then write_output() end
end

synchronize_output = function(): integer
  local exit_status: integer = 0
  local mask = conversions_mask
  conversions_mask = conversions_mask & ~(C_FDATASYNC | C_FSYNC)
  if (mask & C_FDATASYNC) ~= 0 then
    local ret: cint
    repeat process_signals(); ret = c_fdatasync(1) until not (ret < 0 and sys.errno() == sys.EINTR)
    if ret ~= 0 then
      local e = sys.errno()
      if e ~= ENOSYS and e ~= EINVAL then
        report('fdatasync failed for ' .. util.quoteaf(output_file), e)
        exit_status = 1
      end
      mask = mask | C_FSYNC
    end
  end
  if (mask & C_FSYNC) ~= 0 then
    local ret: cint
    repeat process_signals(); ret = c_fsync(1) until not (ret < 0 and sys.errno() == sys.EINTR)
    if ret ~= 0 then
      report('fsync failed for ' .. util.quoteaf(output_file), sys.errno())
      return 1
    end
  end
  return exit_status
end

-- Number parsing: gnulib xstrtoumax with dd's suffixes "bcEGkKMPTwYZ0".
local LONGINT_OK: integer <comptime> = 0
local LONGINT_OVERFLOW: integer <comptime> = 1
local LONGINT_INVALID_SUFFIX_CHAR: integer <comptime> = 2
local LONGINT_INVALID: integer <comptime> = 4
local UMAX: uint64 <comptime> = 0xffffffffffffffff

local function scale(v: *uint64, factor: uint64): integer
  if $v ~= 0 and $v > UMAX // factor then $v = UMAX; return LONGINT_OVERFLOW end
  $v = $v * factor
  return LONGINT_OK
end

local function scale_power(v: *uint64, base: uint64, power: integer): integer
  local err: integer = LONGINT_OK
  for i = 1, power do err = err | scale(v, base) end
  return err
end

local function is_suffix(c: byte): boolean
  return c ~= 0 and ('bcEGkKMPTwYZ0'):find(string.char(c), 1, true) > 0
end

-- Parse s from position pos (1-based); returns (error, value, next position).
local function xstrtoumax(s: string, pos: integer): (integer, uint64, integer)
  local q = pos
  while q <= #s and (s:byte(q) == 32 or (s:byte(q) >= 9 and s:byte(q) <= 13)) do q = q + 1 end
  if q <= #s and s:byte(q) == 45 then return LONGINT_INVALID, 0, pos end
  local p = q
  if p <= #s and s:byte(p) == 43 then p = p + 1 end
  local tmp: uint64 = 0
  local err: integer = LONGINT_OK
  local start = p
  while p <= #s and s:byte(p) >= 48 and s:byte(p) <= 57 do
    local d: uint64 = s:byte(p) - 48
    if err == LONGINT_OK then
      if tmp > (UMAX - d) // 10 then err = LONGINT_OVERFLOW; tmp = UMAX
      else tmp = tmp * 10 + d end
    end
    p = p + 1
  end
  if p == start then
    p = pos
    local c: byte = pos <= #s and s:byte(pos) or 0
    if is_suffix(c) then tmp = 1 else return LONGINT_INVALID, 0, pos end
  end
  if p > #s then return err, tmp, p end
  local c = s:byte(p)
  if not is_suffix(c) then return err | LONGINT_INVALID_SUFFIX_CHAR, tmp, p end
  local base: uint64 = 1024
  local nsuf = 1
  if c == 69 or c == 71 or c == 103 or c == 107 or c == 75 or c == 77 or c == 109
     or c == 80 or c == 84 or c == 116 or c == 89 or c == 90 then
    local c1: byte = p + 1 <= #s and s:byte(p + 1) or 0
    if c1 == 105 then
      if p + 2 <= #s and s:byte(p + 2) == 66 then nsuf = nsuf + 2 end
    elseif c1 == 66 or c1 == 68 then base = 1000; nsuf = nsuf + 1 end
  end
  local ovf: integer
  if c == 98 then ovf = scale(&tmp, 512)
  elseif c == 99 then ovf = LONGINT_OK
  elseif c == 69 then ovf = scale_power(&tmp, base, 6)
  elseif c == 71 or c == 103 then ovf = scale_power(&tmp, base, 3)
  elseif c == 107 or c == 75 then ovf = scale_power(&tmp, base, 1)
  elseif c == 77 or c == 109 then ovf = scale_power(&tmp, base, 2)
  elseif c == 80 then ovf = scale_power(&tmp, base, 5)
  elseif c == 84 or c == 116 then ovf = scale_power(&tmp, base, 4)
  elseif c == 119 then ovf = scale(&tmp, 2)
  elseif c == 89 then ovf = scale_power(&tmp, base, 8)
  elseif c == 90 then ovf = scale_power(&tmp, base, 7)
  else return err | LONGINT_INVALID_SUFFIX_CHAR, tmp, p end
  err = err | ovf
  p = p + nsuf
  if p <= #s then err = err | LONGINT_INVALID_SUFFIX_CHAR end
  return err, tmp, p
end

-- dd's parse_integer: a 'B' suffix and one 'x' multiplication.
local function parse_integer(str: string): (int64, integer)
  local e, n, sp = xstrtoumax(str, 1)
  local result: int64 = 0
  local function at(i: integer): byte
    if i >= 1 and i <= #str then return str:byte(i) end
    return 0
  end
  if (e & ~LONGINT_OVERFLOW) == LONGINT_INVALID_SUFFIX_CHAR and at(sp - 1) ~= 66 and at(sp) == 66 then
    sp = sp + 1
    if sp > #str then e = e & ~LONGINT_INVALID_SUFFIX_CHAR end
  end
  if (e & ~LONGINT_OVERFLOW) == LONGINT_INVALID_SUFFIX_CHAR and at(sp) == 120
     and not (at(sp - 1) == 66 and str:find('B', sp + 1, true) > 0) then
    local f, o, sp2 = xstrtoumax(str, sp + 1)
    if (f & ~LONGINT_OVERFLOW) ~= LONGINT_OK then
      e = f
      result = 0
    else
      local wrap = false
      if n > (@uint64)(INT64_MAX) or o > (@uint64)(INT64_MAX) then
        wrap = n ~= 0 and o ~= 0
        result = 0
        if not wrap then result = 0 end
      else
        local r, w = mul_ovf((@int64)(n), (@int64)(o))
        result = r; wrap = w
      end
      if wrap or (result ~= 0 and ((e | f) & LONGINT_OVERFLOW) ~= 0) then
        e = LONGINT_OVERFLOW
        result = INT64_MAX
      else
        if result == 0 and str:sub(1, 2) == '0x' then
          report("warning: '0x' is a zero multiplier; use '00x' if that is intended", 0)
        end
        e = LONGINT_OK
      end
    end
  elseif n <= (@uint64)(INT64_MAX) then
    result = (@int64)(n)
  else
    e = LONGINT_OVERFLOW
    result = INT64_MAX
  end
  return result, e
end

local function operand_matches(str: string, pattern: string, delim: byte): boolean
  if str:sub(1, #pattern) ~= pattern then return false end
  return #str == #pattern or str:byte(#pattern + 1) == delim
end

local function parse_symbols(str: string, table: *[0]Symbol, n: integer, exclusive: boolean, what: string): integer
  local value: integer = 0
  local pos = 1
  while true do
    local comma = str:find(',', pos, true)
    local item = comma > 0 and str:sub(pos, comma - 1) or str:sub(pos)
    local found = -1
    for i = 0, < n do
      if item == table[i].name and table[i].value ~= 0 then found = i; break end
    end
    if found < 0 then
      util.err(what .. ": '" .. item .. "'")
      usage_fail()
    end
    if exclusive then value = table[found].value else value = value | table[found].value end
    if comma <= 0 then break end
    pos = comma + 1
  end
  return value
end

local function multiple_bits(i: integer): boolean
  return (i & (i - 1)) ~= 0
end

local function scanargs(operands: sequence(string))
  local blocksize: int64 = 0
  local count: int64 = INT64_MAX
  local skip: int64 = 0
  local seek: int64 = 0
  local count_B, skip_B, seek_B = false, false, false
  for _, name in ipairs(operands) do
    local eq = name:find('=', 1, true)
    if eq <= 0 then
      util.err("unrecognized operand '" .. name .. "'")
      usage_fail()
    end
    local val = name:sub(eq + 1)
    if operand_matches(name, 'if', 61) then input_file = val; have_if = true
    elseif operand_matches(name, 'of', 61) then output_file = val; have_of = true
    elseif operand_matches(name, 'conv', 61) then
      conversions_mask = conversions_mask | parse_symbols(val, &conversions, #conversions, false, 'invalid conversion')
    elseif operand_matches(name, 'iflag', 61) then
      input_flags = input_flags | (@cint)(parse_symbols(val, &flagsyms, #flagsyms, false, 'invalid input flag'))
    elseif operand_matches(name, 'oflag', 61) then
      output_flags = output_flags | (@cint)(parse_symbols(val, &flagsyms, #flagsyms, false, 'invalid output flag'))
    elseif operand_matches(name, 'status', 61) then
      status_level = parse_symbols(val, &statuses, #statuses, true, 'invalid status level')
    else
      local n, invalid = parse_integer(val)
      local has_B = val:find('B', 1, true) > 0
      local n_min: int64 = 0
      local n_max: int64 = INT64_MAX
      local which = 0
      local max_blocksize: int64 = INT64_MAX - 1
      if operand_matches(name, 'ibs', 61) then n_min = 1; n_max = max_blocksize; which = 1
      elseif operand_matches(name, 'obs', 61) then n_min = 1; n_max = max_blocksize; which = 2
      elseif operand_matches(name, 'bs', 61) then n_min = 1; n_max = max_blocksize; which = 3
      elseif operand_matches(name, 'cbs', 61) then n_min = 1; n_max = INT64_MAX; which = 4
      elseif operand_matches(name, 'skip', 61) or operand_matches(name, 'iseek', 61) then skip = n; skip_B = has_B
      elseif operand_matches(name, 'seek', 61) or operand_matches(name, 'oseek', 61) then seek = n; seek_B = has_B
      elseif operand_matches(name, 'count', 61) then count = n; count_B = has_B
      else
        util.err("unrecognized operand '" .. name .. "'")
        usage_fail()
      end
      if n < n_min then invalid = LONGINT_INVALID
      elseif n_max < n then invalid = LONGINT_OVERFLOW end
      if invalid ~= LONGINT_OK then
        die("invalid number: '" .. val .. "'", invalid == LONGINT_OVERFLOW and EOVERFLOW or 0)
      elseif which == 1 then input_blocksize = n
      elseif which == 2 then output_blocksize = n
      elseif which == 3 then blocksize = n
      elseif which == 4 then conversion_blocksize = n end
    end
  end
  if blocksize ~= 0 then
    input_blocksize = blocksize; output_blocksize = blocksize
  else
    conversions_mask = conversions_mask | C_TWOBUFS
  end
  if input_blocksize == 0 then input_blocksize = 512 end
  if output_blocksize == 0 then output_blocksize = 512 end
  if conversion_blocksize == 0 then conversions_mask = conversions_mask & ~(C_BLOCK | C_UNBLOCK) end
  if (output_flags & O_FULLBLOCK) ~= 0 then
    util.err("invalid output flag: 'fullblock'")
    usage_fail()
  end
  if skip_B then input_flags = input_flags | O_SKIP_BYTES end
  if (input_flags & O_SKIP_BYTES) ~= 0 and skip ~= 0 then
    skip_records = skip // input_blocksize; skip_bytes = skip % input_blocksize
  elseif skip ~= 0 then skip_records = skip end
  if count_B then input_flags = input_flags | O_COUNT_BYTES end
  if (input_flags & O_COUNT_BYTES) ~= 0 and count ~= INT64_MAX then
    max_records = count // input_blocksize; max_bytes = count % input_blocksize
  elseif count ~= INT64_MAX then max_records = count end
  if seek_B then output_flags = output_flags | O_SEEK_BYTES end
  if (output_flags & O_SEEK_BYTES) ~= 0 and seek ~= 0 then
    seek_records = seek // output_blocksize; seek_bytes = seek % output_blocksize
  elseif seek ~= 0 then seek_records = seek end
  warn_partial_read = (conversions_mask & C_TWOBUFS) == 0 and (input_flags & O_FULLBLOCK) == 0
    and (skip_records ~= 0 or (0 < max_records and max_records < INT64_MAX)
         or ((input_flags | output_flags) & O_DIRECT) ~= 0)
  fullblock = (input_flags & O_FULLBLOCK) ~= 0
  input_flags = input_flags & ~O_FULLBLOCK
  if multiple_bits(conversions_mask & (C_ASCII | C_EBCDIC | C_IBM)) then
    die('cannot combine any two of {ascii,ebcdic,ibm}', 0)
  end
  if multiple_bits(conversions_mask & (C_BLOCK | C_UNBLOCK)) then die('cannot combine block and unblock', 0) end
  if multiple_bits(conversions_mask & (C_LCASE | C_UCASE)) then die('cannot combine lcase and ucase', 0) end
  if multiple_bits(conversions_mask & (C_EXCL | C_NOCREAT)) then die('cannot combine excl and nocreat', 0) end
  if multiple_bits(input_flags & (O_DIRECT | O_NOCACHE)) or multiple_bits(output_flags & (O_DIRECT | O_NOCACHE)) then
    die('cannot combine direct and nocache', 0)
  end
  if (input_flags & O_NOCACHE) ~= 0 then
    i_nocache = true
    i_nocache_eof = max_records == 0 and max_bytes == 0
    input_flags = input_flags & ~O_NOCACHE
  end
  if (output_flags & O_NOCACHE) ~= 0 then
    o_nocache = true
    o_nocache_eof = max_records == 0 and max_bytes == 0
    output_flags = output_flags & ~O_NOCACHE
  end
end

local function translate_charset(new_trans: *[256]byte)
  for i = 0, 255 do trans_table[i] = new_trans[trans_table[i]] end
  translation_needed = true
end

local function apply_translations()
  if (conversions_mask & C_ASCII) ~= 0 then translate_charset(&ebcdic_to_ascii) end
  if (conversions_mask & C_UCASE) ~= 0 then
    for i = 0, 255 do
      local c = trans_table[i]
      if c >= 97 and c <= 122 then trans_table[i] = c - 32 end
    end
    translation_needed = true
  elseif (conversions_mask & C_LCASE) ~= 0 then
    for i = 0, 255 do
      local c = trans_table[i]
      if c >= 65 and c <= 90 then trans_table[i] = c + 32 end
    end
    translation_needed = true
  end
  if (conversions_mask & C_EBCDIC) ~= 0 then
    translate_charset(&ascii_to_ebcdic)
    newline_character = ascii_to_ebcdic[10]
    space_character = ascii_to_ebcdic[32]
  elseif (conversions_mask & C_IBM) ~= 0 then
    translate_charset(&ascii_to_ibm)
    newline_character = ascii_to_ibm[10]
    space_character = ascii_to_ibm[32]
  end
end

local function alloc_aligned(size: int64, what: string): *[0]byte
  local p = c_malloc((@csize)(size + page_size))
  if p == nilptr then
    die(string.format('memory exhausted by %s buffer of size %d bytes (%s)', what, size,
      human((@uint64)(size), true, 1, 1)), 0)
  end
  local a = ((@usize)(p) + (@usize)(page_size) - 1) & ~((@usize)(page_size) - 1)
  return (@*[0]byte)(a)
end

local function alloc_ibuf()
  if ibuf ~= nilptr then return end
  local extra: int64 = (conversions_mask & C_SWAB) ~= 0 and 1 or 0
  ibuf = alloc_aligned(input_blocksize + extra, 'input')
end

local function alloc_obuf()
  if obuf ~= nilptr then return end
  if (conversions_mask & C_TWOBUFS) ~= 0 then
    obuf = alloc_aligned(output_blocksize, 'output')
  else
    alloc_ibuf()
    obuf = ibuf
  end
end

local function advance_input_offset(offset: int64)
  if 0 <= input_offset then
    local v, ovf = add_ovf(input_offset, offset)
    if ovf then input_offset = -1 else input_offset = v end
  end
end

local function usable_st_size(st: *sys.Stat): boolean
  local t = st.st_mode & sys.S_IFMT
  return t == sys.S_IFREG or t == 0xA000
end

-- Skip `records` blocks plus `bytes` bytes on fd 0 or 1 (seeking if it can,
-- reading if it cannot); returns the records not skipped.
local function skip(fdesc: cint, file: string, records: int64, blocksize: int64, bytes: *int64): int64
  sys.seterrno(0)
  local offset, o1 = mul_ovf(records, blocksize)
  local o2 = false
  if not o1 then offset, o2 = add_ovf(offset, $bytes) end
  if not o1 and not o2 and 0 <= sys.lseek(fdesc, offset, sys.SEEK_CUR) then
    if fdesc == 0 then
      local st: sys.Stat
      if sys.fstat(0, &st) ~= 0 then die('cannot fstat ' .. util.quoteaf(file), sys.errno()) end
      if usable_st_size(&st) and 0 <= input_offset and st.st_size - input_offset < offset then
        records = (offset - st.st_size) // blocksize
        offset = st.st_size - input_offset
      else
        records = 0
      end
      advance_input_offset(offset)
    else
      records = 0
      $bytes = 0
    end
    return records
  end
  local lseek_errno = sys.errno()
  if sys.lseek(fdesc, 0, 2) >= 0 then
    if lseek_errno == 0 then lseek_errno = EOVERFLOW end
    if fdesc == 0 then report(util.quotef(file) .. ': cannot skip', lseek_errno)
    else report(util.quotef(file) .. ': cannot seek', lseek_errno) end
    quit(1)
  end
  local buf: *[0]byte
  if fdesc == 0 then alloc_ibuf(); buf = ibuf else alloc_obuf(); buf = obuf end
  repeat
    local nread = iread_fnc(fdesc, buf, records ~= 0 and blocksize or $bytes)
    if nread < 0 then
      if fdesc == 0 then
        report('error reading ' .. util.quoteaf(file), sys.errno())
        if (conversions_mask & C_NOERROR) ~= 0 then print_stats() end
      else
        report(util.quotef(file) .. ': cannot seek', lseek_errno)
      end
      quit(1)
    elseif nread == 0 then
      break
    elseif fdesc == 0 then
      advance_input_offset(nread)
    end
    if records ~= 0 then records = records - 1 else $bytes = 0 end
  until not (records ~= 0 or $bytes ~= 0)
  return records
end

local function advance_input_after_read_error(nbytes: int64): boolean
  if not input_seekable then
    if input_seek_errno == sys.ESPIPE then return true end
    sys.seterrno(input_seek_errno)
  else
    advance_input_offset(nbytes)
    if input_offset < 0 then
      report('offset overflow while reading file ' .. util.quoteaf(input_file), 0)
      return false
    end
    local offset = sys.lseek(0, 0, sys.SEEK_CUR)
    if 0 <= offset then
      if offset == input_offset then return true end
      local diff = input_offset - offset
      if not (0 <= diff and diff <= nbytes) and status_level ~= STATUS_NONE then
        report('warning: invalid file offset after failed read', 0)
      end
      if 0 <= sys.lseek(0, diff, sys.SEEK_CUR) then return true end
      if sys.errno() == 0 then report('cannot work around kernel bug after all', 0) end
    end
  end
  report(util.quotef(input_file) .. ': cannot seek', sys.errno())
  return false
end

local function copy_simple(buf: *[0]byte, nread: int64)
  local start: int64 = 0
  repeat
    local nfree = output_blocksize - oc
    if nread < nfree then nfree = nread end
    for i = 0, < nfree do obuf[oc + i] = buf[start + i] end
    nread = nread - nfree
    start = start + nfree
    oc = oc + nfree
    if oc >= output_blocksize then write_output() end
  until nread == 0
end

local function copy_with_block(buf: *[0]byte, nread: int64)
  for k = 0, < nread do
    local c = buf[k]
    if c == newline_character then
      if col < conversion_blocksize then
        for j = col, < conversion_blocksize do output_char(space_character) end
      end
      col = 0
    else
      if col == conversion_blocksize then r_truncate = r_truncate + 1
      elseif col < conversion_blocksize then output_char(c) end
      col = col + 1
    end
  end
end

local function copy_with_unblock(buf: *[0]byte, nread: int64)
  local i: int64 = 0
  while i < nread do
    local c = buf[i]
    local was = col
    col = col + 1
    if was >= conversion_blocksize then
      col = 0; pending_spaces = 0
      i = i - 1
      output_char(newline_character)
    elseif c == space_character then
      pending_spaces = pending_spaces + 1
    else
      while pending_spaces > 0 do
        output_char(space_character)
        pending_spaces = pending_spaces - 1
      end
      output_char(c)
    end
    i = i + 1
  end
end

-- Swap bytes in place; buf has room for one byte after *nread. Returns the
-- adjusted start offset (0 or 1).
local function swab_buffer(buf: *[0]byte, nread: *int64, saved_byte: *integer): int64
  if $nread == 0 then return 0 end
  local prev_saved = $saved_byte
  if (prev_saved < 0) == (($nread & 1) ~= 0) then
    $nread = $nread - 1
    $saved_byte = buf[$nread]
  else
    $saved_byte = -1
  end
  local i = $nread
  while 1 < i do
    buf[i] = buf[i - 2]
    i = i - 2
  end
  if prev_saved < 0 then return 1 end
  buf[1] = (@byte)(prev_saved)
  $nread = $nread + 1
  return 0
end

local function set_fd_flags(fd: cint, add_flags: cint, name: string)
  add_flags = add_flags & ~(O_NOCTTY | sys.O_NOFOLLOW | O_PRIVATE)
  if add_flags ~= 0 then
    local old_flags = sys.fcntl(fd, sys.F_GETFL, 0)
    local new_flags = old_flags | add_flags
    local ok = true
    if old_flags < 0 then ok = false
    elseif old_flags ~= new_flags then
      if (new_flags & sys.O_DIRECTORY) ~= 0 then
        local st: sys.Stat
        if sys.fstat(fd, &st) ~= 0 then ok = false
        elseif (st.st_mode & sys.S_IFMT) ~= sys.S_IFDIR then
          sys.seterrno(sys.ENOTDIR); ok = false
        end
        new_flags = new_flags & ~sys.O_DIRECTORY
      end
      if ok and old_flags ~= new_flags and sys.fcntl(fd, F_SETFL, new_flags) == -1 then ok = false end
    end
    if not ok then die('setting flags for ' .. util.quoteaf(name), sys.errno()) end
  end
end

local function dd_copy(): integer
  local exit_status: integer = 0
  local partread: int64 = 0
  if skip_records ~= 0 or skip_bytes ~= 0 then
    local us_bytes, o1 = mul_ovf(skip_records, input_blocksize)
    local o2 = false
    us_bytes, o2 = add_ovf(skip_bytes, us_bytes)
    local input_offset0 = input_offset
    local us_blocks = skip(0, input_file, skip_records, input_blocksize, &skip_bytes)
    if (us_blocks ~= 0 or (0 <= input_offset and (o1 or o2 or us_bytes ~= input_offset - input_offset0)))
       and status_level ~= STATUS_NONE then
      report(util.quotef(input_file) .. ': cannot skip to specified offset', 0)
    end
  end
  if seek_records ~= 0 or seek_bytes ~= 0 then
    local bytes = seek_bytes
    local write_records = skip(1, output_file, seek_records, output_blocksize, &bytes)
    if write_records ~= 0 or bytes ~= 0 then
      local n = write_records ~= 0 and output_blocksize or bytes
      for i = 0, < n do obuf[i] = 0 end
      repeat
        local size = write_records ~= 0 and output_blocksize or bytes
        if iwrite(1, obuf, size) ~= size then
          report('writing to ' .. util.quoteaf(output_file), sys.errno())
          quit(1)
        end
        if write_records ~= 0 then write_records = write_records - 1 else bytes = 0 end
      until not (write_records ~= 0 or bytes ~= 0)
    end
  end
  if max_records == 0 and max_bytes == 0 then return exit_status end
  alloc_ibuf()
  alloc_obuf()
  local saved_byte: integer = -1
  while true do
    if status_level == STATUS_PROGRESS then
      local t = now_ns()
      if next_time <= t then
        print_xfer_stats(t)
        next_time = next_time + 1000000000
      end
    end
    if r_partial + r_full >= max_records + (max_bytes ~= 0 and 1 or 0) then break end
    if (conversions_mask & C_SYNC) ~= 0 and (conversions_mask & C_NOERROR) ~= 0 then
      local fill: byte = (conversions_mask & (C_BLOCK | C_UNBLOCK)) ~= 0 and 32 or 0
      for i = 0, < input_blocksize do ibuf[i] = fill end
    end
    local nread: int64
    if r_partial + r_full >= max_records then nread = iread_fnc(0, ibuf, max_bytes)
    else nread = iread_fnc(0, ibuf, input_blocksize) end
    if nread > 0 then
      advance_input_offset(nread)
      if i_nocache then invalidate_cache(0, nread) end
    elseif nread == 0 then
      i_nocache_eof = i_nocache_eof or i_nocache
      o_nocache_eof = o_nocache_eof or (o_nocache and (conversions_mask & C_NOTRUNC) == 0)
      break
    else
      local e = sys.errno()
      if (conversions_mask & C_NOERROR) == 0 or status_level ~= STATUS_NONE then
        report('error reading ' .. util.quoteaf(input_file), e)
      end
      if (conversions_mask & C_NOERROR) ~= 0 then
        print_stats()
        local bad_portion = input_blocksize - partread
        invalidate_cache(0, bad_portion)
        if not advance_input_after_read_error(bad_portion) then
          exit_status = 1
          input_seekable = false
          input_seek_errno = sys.ESPIPE
        end
        if (conversions_mask & C_SYNC) ~= 0 and partread == 0 then
          nread = 0
        else
          continue
        end
      else
        exit_status = 1
        break
      end
    end
    do
      local n_bytes_read = nread
      if n_bytes_read < input_blocksize then
        r_partial = r_partial + 1
        partread = n_bytes_read
        if (conversions_mask & C_SYNC) ~= 0 then
          if (conversions_mask & C_NOERROR) == 0 then
            local fill: byte = (conversions_mask & (C_BLOCK | C_UNBLOCK)) ~= 0 and 32 or 0
            for i = n_bytes_read, < input_blocksize do ibuf[i] = fill end
          end
          n_bytes_read = input_blocksize
        end
      else
        r_full = r_full + 1
        partread = 0
      end
      if ibuf == obuf then
        local nwritten = iwrite(1, obuf, n_bytes_read)
        w_bytes = w_bytes + nwritten
        if nwritten ~= n_bytes_read then
          report('error writing ' .. util.quoteaf(output_file), sys.errno())
          return 1
        elseif n_bytes_read == input_blocksize then w_full = w_full + 1
        else w_partial = w_partial + 1 end
        continue
      end
      if translation_needed then
        for i = 0, < n_bytes_read do ibuf[i] = trans_table[ibuf[i]] end
      end
      local start: int64 = 0
      if (conversions_mask & C_SWAB) ~= 0 then start = swab_buffer(ibuf, &n_bytes_read, &saved_byte) end
      local bufstart = (@*[0]byte)(&ibuf[start])
      if (conversions_mask & C_BLOCK) ~= 0 then copy_with_block(bufstart, n_bytes_read)
      elseif (conversions_mask & C_UNBLOCK) ~= 0 then copy_with_unblock(bufstart, n_bytes_read)
      else copy_simple(bufstart, n_bytes_read) end
    end
  end
  if 0 <= saved_byte then
    local one: [1]byte = {(@byte)(saved_byte)}
    if (conversions_mask & C_BLOCK) ~= 0 then copy_with_block(&one, 1)
    elseif (conversions_mask & C_UNBLOCK) ~= 0 then copy_with_unblock(&one, 1)
    else output_char(one[0]) end
  end
  if (conversions_mask & C_BLOCK) ~= 0 and col > 0 then
    for i = col, < conversion_blocksize do output_char(space_character) end
  end
  if col ~= 0 and (conversions_mask & C_UNBLOCK) ~= 0 then output_char(newline_character) end
  if oc ~= 0 then
    local nwritten = iwrite(1, obuf, oc)
    w_bytes = w_bytes + nwritten
    if nwritten ~= 0 then w_partial = w_partial + 1 end
    if nwritten ~= oc then
      report('error writing ' .. util.quoteaf(output_file), sys.errno())
      return 1
    end
  end
  if final_op_was_seek then
    local st: sys.Stat
    if sys.fstat(1, &st) ~= 0 then
      report('cannot fstat ' .. util.quoteaf(output_file), sys.errno())
      return 1
    end
    if (st.st_mode & sys.S_IFMT) == sys.S_IFREG then
      local output_off = sys.lseek(1, 0, sys.SEEK_CUR)
      if 0 <= output_off and st.st_size < output_off then
        if c_ftruncate(1, output_off) ~= 0 then
          report(string.format('failed to truncate to %d bytes in output file %s', output_off,
            util.quoteaf(output_file)), sys.errno())
          return 1
        end
      end
    end
  end
  if (conversions_mask & (C_FDATASYNC | C_FSYNC)) ~= 0 and status_level == STATUS_PROGRESS
     and 0 <= reported_w_bytes and reported_w_bytes < w_bytes then
    print_xfer_stats(0)
  end
  return exit_status
end

local function fd_reopen(desired: cint, file: string, flag: cint, mode: cuint): cint
  local fd: cint
  repeat
    process_signals()
    fd = sys.open(file, flag & ~O_PRIVATE, mode)
  until not (fd < 0 and sys.errno() == sys.EINTR)
  if fd < 0 or fd == desired then return fd end
  local fd2 = sys.dup2(fd, desired)
  local e = sys.errno()
  sys.close(fd)
  sys.seterrno(e)
  return fd2
end

local function reset()
  input_file = ''; output_file = ''; have_if = false; have_of = false
  page_size = c_getpagesize()
  input_blocksize = 0; output_blocksize = 0; conversion_blocksize = 0
  skip_records = 0; skip_bytes = 0; seek_records = 0; seek_bytes = 0
  final_op_was_seek = false
  max_records = INT64_MAX; max_bytes = 0
  conversions_mask = 0; input_flags = 0; output_flags = 0
  status_level = STATUS_DEFAULT
  translation_needed = false
  w_partial = 0; w_full = 0; r_partial = 0; r_full = 0; w_bytes = 0
  reported_w_bytes = -1
  progress_len = 0
  r_truncate = 0
  newline_character = 10; space_character = 32
  ibuf = nilptr; obuf = nilptr
  oc = 0; col = 0
  interrupt_signal = 0; info_signal_count = 0
  i_nocache = false; o_nocache = false; i_nocache_eof = false; o_nocache_eof = false
  fullblock = false
  for i = 0, 255 do trans_table[i] = (@byte)(i) end
  prev_nread = 0; pending_spaces = 0; i_pending = 0; o_pending = 0
  output_offset = -2
end

local function usage()
  util.write([[
Usage: dd [OPERAND]...
  or:  dd OPTION
Copy a file, converting and formatting according to the operands.

  bs=BYTES        read and write up to BYTES bytes at a time (default: 512);
                  overrides ibs and obs
  cbs=BYTES       convert BYTES bytes at a time
  conv=CONVS      convert the file as per the comma separated symbol list
  count=N         copy only N input blocks
  ibs=BYTES       read up to BYTES bytes at a time (default: 512)
  if=FILE         read from FILE instead of stdin
  iflag=FLAGS     read as per the comma separated symbol list
  obs=BYTES       write BYTES bytes at a time (default: 512)
  of=FILE         write to FILE instead of stdout
  oflag=FLAGS     write as per the comma separated symbol list
  seek=N          (or oseek=N) skip N obs-sized output blocks
  skip=N          (or iseek=N) skip N ibs-sized input blocks
  status=LEVEL    The LEVEL of information to print to stderr;
                  'none' suppresses everything but error messages,
                  'noxfer' suppresses the final transfer statistics,
                  'progress' shows periodic transfer statistics

N and BYTES may be followed by the following multiplicative suffixes:
c=1, w=2, b=512, kB=1000, K=1024, MB=1000*1000, M=1024*1024, xM=M,
GB=1000*1000*1000, G=1024*1024*1024, and so on for T, P, E, Z, Y.
If N ends in 'B', it counts bytes not blocks.

Each CONV symbol may be:

  ascii     from EBCDIC to ASCII
  ebcdic    from ASCII to EBCDIC
  ibm       from ASCII to alternate EBCDIC
  block     pad newline-terminated records with spaces to cbs-size
  unblock   replace trailing spaces in cbs-size records with newline
  lcase     change upper case to lower case
  ucase     change lower case to upper case
  sparse    try to seek rather than write all-NUL output blocks
  swab      swap every pair of input bytes
  sync      pad every input block with NULs to ibs-size; when used
            with block or unblock, pad with spaces rather than NULs
  excl      fail if the output file already exists
  nocreat   do not create the output file
  notrunc   do not truncate the output file
  noerror   continue after read errors
  fdatasync  physically write output file data before finishing
  fsync     likewise, but also write metadata

Each FLAG symbol may be:

  append    append mode (makes sense only for output; conv=notrunc suggested)
  direct    use direct I/O for data
  directory  fail unless a directory
  dsync     use synchronized I/O for data
  sync      likewise, but also for metadata
  fullblock  accumulate full blocks of input (iflag only)
  nonblock  use non-blocking I/O
  noatime   do not update access time
  nocache   Request to drop cache.  See also oflag=sync
  noctty    do not assign controlling terminal from file
  nofollow  do not follow symlinks

Sending a USR1 signal to a running 'dd' process makes it
print I/O statistics to standard error and then resume copying.
]])
  util.flush()
end

global function applet_dd(args: sequence(string)): integer
  reset()
  install_signal_handlers()
  -- GNU standard options only; getopt permutes, so any "-X" before "--"
  -- is an option.
  local operands: sequence(string)
  local dashdash = false
  for _, a in ipairs(args) do
    if dashdash or #a < 2 or a:byte(1) ~= 45 then
      operands:push(a)
    elseif a == '--' then
      dashdash = true
    elseif a:byte(2) == 45 then
      local long = a:sub(3)
      local eq = long:find('=', 1, true)
      local nm = eq > 0 and long:sub(1, eq - 1) or long
      if #nm > 0 and ('help'):sub(1, #nm) == nm then
        if eq > 0 then util.err("option '--help' doesn't allow an argument"); usage_fail() end
        usage(); return 0
      elseif #nm > 0 and ('version'):sub(1, #nm) == nm then
        if eq > 0 then util.err("option '--version' doesn't allow an argument"); usage_fail() end
        util.line('dd (nebox) after GNU coreutils 9.1'); util.flush(); return 0
      else
        util.err("unrecognized option '" .. a .. "'")
        usage_fail()
      end
    else
      util.err("invalid option -- '" .. string.char(a:byte(2)) .. "'")
      usage_fail()
    end
  end
  scanargs(operands)
  apply_translations()
  util.flush()
  if not have_if then
    input_file = 'standard input'
    set_fd_flags(0, input_flags, input_file)
  elseif fd_reopen(0, input_file, sys.O_RDONLY | input_flags, 0) < 0 then
    die('failed to open ' .. util.quoteaf(input_file), sys.errno())
  end
  sys.seterrno(0)
  local offset = sys.lseek(0, 0, sys.SEEK_CUR)
  input_seekable = 0 <= offset
  input_offset = offset > 0 and offset or 0
  input_seek_errno = sys.errno()
  local exit_status: integer = 0
  if not have_of then
    output_file = 'standard output'
    set_fd_flags(1, output_flags, output_file)
  else
    local opts: cint = output_flags
    if (conversions_mask & C_NOCREAT) == 0 then opts = opts | sys.O_CREAT end
    if (conversions_mask & C_EXCL) ~= 0 then opts = opts | sys.O_EXCL end
    if seek_records == 0 and (conversions_mask & C_NOTRUNC) == 0 then opts = opts | sys.O_TRUNC end
    local size, o1 = mul_ovf(seek_records, output_blocksize)
    local o2 = false
    if not o1 then size, o2 = add_ovf(seek_bytes, size) end
    if (o1 or o2) and (conversions_mask & C_NOTRUNC) == 0 then
      die(string.format('offset too large: cannot truncate to a length of seek=%d (%d-byte) blocks',
        seek_records, output_blocksize), 0)
    end
    if (seek_records == 0 or fd_reopen(1, output_file, sys.O_RDWR | opts, 0x1B6) < 0)
       and fd_reopen(1, output_file, sys.O_WRONLY | opts, 0x1B6) < 0 then
      die('failed to open ' .. util.quoteaf(output_file), sys.errno())
    end
    if seek_records ~= 0 and (conversions_mask & C_NOTRUNC) == 0 then
      local ret: cint
      repeat process_signals(); ret = c_ftruncate(1, size) until not (ret < 0 and sys.errno() == sys.EINTR)
      if ret ~= 0 then
        local ftruncate_errno = sys.errno()
        local st: sys.Stat
        if sys.fstat(1, &st) ~= 0 then
          report('cannot fstat ' .. util.quoteaf(output_file), sys.errno())
          exit_status = 1
        else
          local t = st.st_mode & sys.S_IFMT
          if t == sys.S_IFREG or t == sys.S_IFDIR then
            report(string.format('failed to truncate to %d bytes in output file %s', size,
              util.quoteaf(output_file)), ftruncate_errno)
            exit_status = 1
          end
        end
      end
    end
  end
  start_time = now_ns()
  next_time = start_time + 1000000000
  exit_status = dd_copy()
  local sync_status = synchronize_output()
  if sync_status ~= 0 then exit_status = sync_status end
  if max_records == 0 and max_bytes == 0 then
    if i_nocache and not invalidate_cache(0, 0) then
      report('failed to discard cache for: ' .. util.quotef(input_file), sys.errno())
      exit_status = 1
    end
    if o_nocache and not invalidate_cache(1, 0) then
      report('failed to discard cache for: ' .. util.quotef(output_file), sys.errno())
      exit_status = 1
    end
  else
    if i_nocache or i_nocache_eof then invalidate_cache(0, 0) end
    if o_nocache or o_nocache_eof then invalidate_cache(1, 0) end
  end
  finish_up()
  return exit_status
end
