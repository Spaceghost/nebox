-- sh: POSIX.1-2017 shell command language, non-interactive. Usage:
--   sh [-abCefhnuvx] [-o option]... [+...] -c command_string [command_name [argument...]]
--   sh [options] -s [argument...]
--   sh [options] command_file [argument...]
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.sh.ast'
require 'nebox.sh.lex'
require 'nebox.sh.parse'
require 'nebox.sh.exec'
require 'nebox.sh.builtins'

local function usage_error(msg: string): integer
  util.flush()
  local s = 'sh: ' .. msg .. '\n'
  sys.write(2, s.data, s.size)
  return 2
end

global function applet_sh(args: sequence(string)): integer
  shexec.init('sh')
  shbi.init()
  local cmode = false
  local smode = false
  local i: integer = 1
  while i <= #args do
    local a = args[i]
    if a == '--' then i = i + 1; break end
    if a.size < 2 or (a:byte(1) ~= 45 and a:byte(1) ~= 43) then break end
    local on = a:byte(1) == 45
    local j: usize = 2
    local consumed_next = false
    while j <= a.size do
      local c = a:byte(j)
      if c == 99 then cmode = true            -- c
      elseif c == 115 then smode = true       -- s
      elseif c == 105 then return usage_error('-i: interactive mode is not supported')
      elseif c == 109 then return usage_error('-m: job control is not supported')
      elseif c == 111 then                    -- o
        if i + 1 > #args then return usage_error('-o requires an argument') end
        local err = shbi.set_option_name(args[i + 1], on)
        if err.size > 0 then return usage_error(err) end
        consumed_next = true
      elseif not shbi.set_option(c, on) then
        return usage_error('Illegal option ' .. (on and '-' or '+') .. string.char(c))
      end
      j = j + 1
    end
    i = i + 1
    if consumed_next then i = i + 1 end
  end
  local lx: shlex.Lexer
  shst.main_lexer = &lx
  if cmode then
    if i > #args then return usage_error('-c requires an argument') end
    local text = args[i]
    i = i + 1
    if i <= #args then shst.arg0 = args[i]; i = i + 1 end
    for k = i, #args do shst.params:push(args[k]) end
    lx:init_text(text)
  elseif smode or i > #args then
    for k = i, #args do shst.params:push(args[k]) end
    lx:init_fd(0, true)
  else
    local path = args[i]
    local fd = sys.open(path, sys.O_RDONLY | sys.O_CLOEXEC, 0)
    if fd < 0 then return usage_error('cannot open ' .. path .. ': ' .. sys.errstr()) end
    shst.arg0 = path
    for k = i + 1, #args do shst.params:push(args[k]) end
    lx:init_fd(fd, false)
  end
  shexec.run_lexer(&lx)
  shexec.finish()
  return 0
end
