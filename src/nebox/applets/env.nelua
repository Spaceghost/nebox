-- env: a port of GNU coreutils 9.1 src/env.c. -i/-, -u (applied after all
-- options), NAME=VALUE operands via putenv, -0, -C, -v debug messages,
-- -S split-string (quotes, \_ \c \f \n \r \t \v escapes, ${VARNAME}, '#'
-- comments) re-scanned as options, and the signal options
-- --default-signal / --ignore-signal / --block-signal / --list-signal-handling
-- over signals 1..64. Exit 125 for env's own failures, 126/127 for exec.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.sig'

local function c_exit(status: cint) <cimport 'exit', cinclude '<stdlib.h>', noreturn> end
local function c_putenv(s: cstring): cint <cimport 'putenv', cinclude '<stdlib.h>'> end
local function c_malloc(n: csize): pointer <cimport 'malloc', cinclude '<stdlib.h>'> end
local environ: *[0]cstring <cimport 'environ', cinclude '<unistd.h>', nodecl>
local SigSet = @record{bits: [16]culong}
local function c_sigprocmask(how: cint, set: *SigSet, old: *SigSet): cint <cimport 'sigprocmask', cinclude '<signal.h>'> end

local EXIT_CANCELED: cint <comptime> = 125
local EXIT_CANNOT_INVOKE: integer <comptime> = 126
local EXIT_ENOENT: integer <comptime> = 127
local SIG_SETMASK: cint <comptime> = 2
local SIGNUM_BOUND: cint <comptime> = 64
local ISSPACE: string <comptime> = ' \t\n\v\f\r'

local UNCHANGED: byte <comptime> = 0
local DEFAULT: byte <comptime> = 1
local DEFAULT_NOERR: byte <comptime> = 2
local IGNORE: byte <comptime> = 3
local IGNORE_NOERR: byte <comptime> = 4

local dev_debug = false
local signals: [65]byte
local block_signals: SigSet
local unblock_signals: SigSet
local sig_mask_changed = false
local report_signal_handling = false
local dummy_environ: [1]cstring

local function devmsg(s: string)
  if dev_debug then sys.write(2, s.data, s.size) end
end

local function usage_fail(status: cint)
  util.flush()
  local m = "Try 'env --help' for more information.\n"
  sys.write(2, m.data, m.size)
  c_exit(status)
end

local function die(msg: string)
  util.err(msg)
  c_exit(EXIT_CANCELED)
end

-- A NUL-terminated copy that outlives the call (putenv keeps the pointer).
local function cdup(s: string): cstring
  local p: *[0]byte = (@*[0]byte)(c_malloc(#s + 1))
  for i = 0, < #s do p[i] = s.data[i] end
  p[#s] = 0
  return (@cstring)(p)
end

-- glibc's sigset operations; sigfillset leaves out the two signals glibc
-- reserves for itself (32 and 33).
local function sset_empty(s: *SigSet) for i = 0, < 16 do s.bits[i] = 0 end end
local function sset_add(s: *SigSet, n: cint)
  local b = n - 1
  s.bits[b // 64] = s.bits[b // 64] | ((@culong)(1) << (b % 64))
end
local function sset_del(s: *SigSet, n: cint)
  local b = n - 1
  s.bits[b // 64] = s.bits[b // 64] & ~((@culong)(1) << (b % 64))
end
local function sset_has(s: *SigSet, n: cint): boolean
  local b = n - 1
  return (s.bits[b // 64] >> (b % 64)) & 1 ~= 0
end
local function sset_fill(s: *SigSet)
  for i = 0, < 16 do s.bits[i] = ~(@culong)(0) end
  sset_del(s, 32); sset_del(s, 33)
end

-- glibc's sigaction refuses the two signals it reserves (EINVAL); GNU env's
-- loops over 1..64 rely on that to skip them.
local function env_sigaction(n: cint, act: *sys.Sigaction, old: *sys.Sigaction): cint
  if n == 32 or n == 33 then sys.seterrno(22); return -1 end
  return sys.sigaction(n, act, old)
end

local function isspace(c: byte): boolean
  return c == 32 or (c >= 9 and c <= 13)
end
local function isalpha(c: byte): boolean
  return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
end
local function isalnum(c: byte): boolean
  return isalpha(c) or (c >= 48 and c <= 57)
end

-- scan_varname/extract_varname: the NAME of "${NAME}" at position p (the
-- '$'), and the position of the closing brace; "" when it is not valid.
local function extract_varname(s: string, p: integer): (string, integer)
  if p + 2 <= #s and s:byte(p + 1) == 123 and (isalpha(s:byte(p + 2)) or s:byte(p + 2) == 95) then
    local e = p + 3
    while e <= #s and (isalnum(s:byte(e)) or s:byte(e) == 95) do e = e + 1 end
    if e <= #s and s:byte(e) == 125 then return s:sub(p + 2, e - 1), e end
  end
  return '', 0
end

-- build_argv: split an -S string into arguments.
local function build_argv(str: string): sequence(string)
  local out: sequence(string)
  local cur: stringbuilder
  local have = false
  local sep = true
  local dq, sq = false, false
  local function start_new(out: *sequence(string), cur: *stringbuilder, have: *boolean, sep: *boolean)
    if $sep then
      if $have then out:push(cur:promote()) end
      $have = true
      $sep = false
    end
  end
  local i = 1
  local terminated = false
  while i <= #str do
    local c = str:byte(i)
    local newc = c
    local add = true
    if c == 39 then
      if not dq then
        sq = not sq
        start_new(&out, &cur, &have, &sep)
        i = i + 1
        add = false
      end
    elseif c == 34 then
      if not sq then
        dq = not dq
        start_new(&out, &cur, &have, &sep)
        i = i + 1
        add = false
      end
    elseif isspace(c) then
      if not sq and not dq then
        sep = true
        while i <= #str and isspace(str:byte(i)) do i = i + 1 end
        add = false
      end
    elseif c == 35 then
      if sep then terminated = true; break end
    elseif c == 92 then
      local nx: byte = i < #str and str:byte(i + 1) or 0
      if not (sq and nx ~= 92 and nx ~= 39) then
        i = i + 1
        newc = nx
        if nx == 34 or nx == 35 or nx == 36 or nx == 39 or nx == 92 then
        elseif nx == 95 then
          if not dq then
            i = i + 1
            sep = true
            add = false
          else
            newc = 32
          end
        elseif nx == 99 then
          if dq then die("'\\c' must not appear in double-quoted -S string") end
          terminated = true; break
        elseif nx == 102 then newc = 12
        elseif nx == 110 then newc = 10
        elseif nx == 114 then newc = 13
        elseif nx == 116 then newc = 9
        elseif nx == 118 then newc = 11
        elseif nx == 0 then die('invalid backslash at end of string in -S')
        else die("invalid sequence '\\" .. string.char(nx) .. "' in -S") end
      end
    elseif c == 36 then
      if not sq then
        local n, e = extract_varname(str, i)
        if #n == 0 then
          die('only ${VARNAME} expansion is supported, error at: ' .. str:sub(i))
        end
        local v = sys.getenv(n)
        if v ~= nilptr then
          start_new(&out, &cur, &have, &sep)
          local vs: string = (@string)(v)
          devmsg('expanding ${' .. n .. '} into ' .. util.quote(vs) .. '\n')
          cur:write(vs)
        else
          devmsg('replacing ${' .. n .. '} with null string\n')
        end
        i = e + 1
        add = false
      end
    end
    if add then
      start_new(&out, &cur, &have, &sep)
      cur:writebyte(newc)
      i = i + 1
    end
  end
  if not terminated and (dq or sq) then die('no terminating quote in -S string') end
  if have then out:push(cur:promote()) end
  return out
end

local function invalid_signal(s: string)
  util.err(util.quote(s) .. ': invalid signal')
end

-- strtok(optarg, ","): the non-empty pieces.
local function split_commas(s: string): sequence(string)
  local out: sequence(string)
  local start = 1
  for k = 1, #s + 1 do
    if k > #s or s:byte(k) == 44 then
      if k > start then out:push(s:sub(start, k - 1)) end
      start = k + 1
    end
  end
  return out
end

local function parse_signal_action_params(has: boolean, arg: string, set_default: boolean)
  if not has then
    for i: cint = 1, SIGNUM_BOUND do
      if #sig.sig2str(i) > 0 then signals[i] = set_default and DEFAULT_NOERR or IGNORE_NOERR end
    end
    return
  end
  for _, s in ipairs(split_commas(arg)) do
    local signum = sig.operand2sig(s)
    if signum <= 0 then invalid_signal(s); usage_fail(EXIT_CANCELED) end
    signals[signum] = set_default and DEFAULT or IGNORE
  end
end

local function parse_block_signal_params(has: boolean, arg: string, block: boolean)
  if not has then
    if block then sset_fill(&block_signals); sset_empty(&unblock_signals)
    else sset_fill(&unblock_signals); sset_empty(&block_signals) end
  elseif not sig_mask_changed then
    sset_empty(&block_signals)
    sset_empty(&unblock_signals)
  end
  sig_mask_changed = true
  if not has then return end
  for _, s in ipairs(split_commas(arg)) do
    local signum = sig.operand2sig(s)
    if signum <= 0 then invalid_signal(s); usage_fail(EXIT_CANCELED) end
    if block then sset_add(&block_signals, signum); sset_del(&unblock_signals, signum)
    else sset_add(&unblock_signals, signum); sset_del(&block_signals, signum) end
  end
end

local function reset_signal_handlers()
  for i: cint = 1, SIGNUM_BOUND do
    if signals[i] == UNCHANGED then continue end
    local ignore_errors = signals[i] == DEFAULT_NOERR or signals[i] == IGNORE_NOERR
    local set_to_default = signals[i] == DEFAULT or signals[i] == DEFAULT_NOERR
    local act: sys.Sigaction
    local sig_err = env_sigaction(i, nilptr, &act)
    if sig_err ~= 0 and not ignore_errors then
      die('failed to get signal action for signal ' .. tostring(i) .. ': ' .. sys.errstr())
    end
    if sig_err == 0 then
      act.sa_handler = (@function(cint): void)((@pointer)(set_to_default and sys.SIG_DFL or sys.SIG_IGN))
      sig_err = env_sigaction(i, &act, nilptr)
      if sig_err ~= 0 and not ignore_errors then
        die('failed to set signal action for signal ' .. tostring(i) .. ': ' .. sys.errstr())
      end
    end
    devmsg('Reset signal ' .. sig.sig2str(i) .. ' (' .. tostring(i) .. ') to ' ..
           (set_to_default and 'DEFAULT' or 'IGNORE') .. (sig_err ~= 0 and ' (failure ignored)' or '') .. '\n')
  end
end

local function set_signal_proc_mask()
  local set: SigSet
  sset_empty(&set)
  if c_sigprocmask(0, nilptr, &set) ~= 0 then die('failed to get signal process mask: ' .. sys.errstr()) end
  for i: cint = 1, SIGNUM_BOUND do
    local act = ''
    if sset_has(&block_signals, i) then sset_add(&set, i); act = 'BLOCK'
    elseif sset_has(&unblock_signals, i) then sset_del(&set, i); act = 'UNBLOCK' end
    if #act > 0 then
      devmsg('signal ' .. sig.sig2str(i) .. ' (' .. tostring(i) .. ') mask set to ' .. act .. '\n')
    end
  end
  if c_sigprocmask(SIG_SETMASK, &set, nilptr) ~= 0 then die('failed to set signal process mask: ' .. sys.errstr()) end
end

local function list_signal_handling()
  local set: SigSet
  sset_empty(&set)
  if c_sigprocmask(0, nilptr, &set) ~= 0 then die('failed to get signal process mask: ' .. sys.errstr()) end
  for i: cint = 1, SIGNUM_BOUND do
    local act: sys.Sigaction
    if env_sigaction(i, nilptr, &act) ~= 0 then continue end
    local ignored = (@usize)((@pointer)(act.sa_handler)) == sys.SIG_IGN and 'IGNORE' or ''
    local blocked = sset_has(&set, i) and 'BLOCK' or ''
    if #ignored == 0 and #blocked == 0 then continue end
    local connect = (#ignored > 0 and #blocked > 0) and ',' or ''
    local name = sig.sig2str(i)
    local sb: stringbuilder
    sb:write(name)
    for _ = #name + 1, 10 do sb:writebyte(32) end
    sb:write(' (', i < 10 and ' ' or '', tostring(i), '): ', blocked, connect, ignored, '\n')
    local m = sb:promote()
    sys.write(2, m.data, m.size)
  end
end

global function applet_env(args: sequence(string)): integer
  local ignore_environment = false
  local nul_terminate = false
  local newdir = ''
  local have_newdir = false
  local usvars: sequence(string)
  local longs: []util.LongOpt = {
    {'ignore-environment', 0, 105}, {'null', 0, 48}, {'unset', 1, 117}, {'chdir', 1, 67},
    {'default-signal', 2, 256}, {'ignore-signal', 2, 257}, {'block-signal', 2, 258},
    {'list-signal-handling', 0, 259}, {'debug', 0, 118}, {'split-string', 1, 83},
    {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
  }
  local shortopts = '+C:iS:u:v0' .. ISSPACE
  local g = util.getopt(args, shortopts, &longs, #longs)
  g.quiet = true
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 105 then ignore_environment = true
    elseif c == 117 then usvars:push(g.optarg)
    elseif c == 118 then dev_debug = true
    elseif c == 48 then nul_terminate = true
    elseif c == 256 then
      parse_signal_action_params(g.has_optarg, g.optarg, true)
      parse_block_signal_params(g.has_optarg, g.optarg, false)
    elseif c == 257 then parse_signal_action_params(g.has_optarg, g.optarg, false)
    elseif c == 258 then parse_block_signal_params(g.has_optarg, g.optarg, true)
    elseif c == 259 then report_signal_handling = true
    elseif c == 67 then newdir = g.optarg; have_newdir = true
    elseif c == 83 then
      local str = g.optarg
      local split = build_argv(str)
      if dev_debug and #split > 0 then
        devmsg('split -S:  ' .. util.quote(str) .. '\n')
        devmsg(' into:    ' .. util.quote(split[1]) .. '\n')
        for k = 2, #split do devmsg('     &    ' .. util.quote(split[k]) .. '\n') end
      end
      for k = g.optind, #g.args do split:push(g.args[k]) end
      g = util.getopt(split, shortopts, &longs, #longs)
      g.quiet = true
    elseif c >= 9 and c <= 32 and isspace((@byte)(c)) then
      util.err("invalid option -- '" .. string.char(c) .. "'")
      util.err('use -[v]S to pass options in shebang lines')
      usage_fail(EXIT_CANCELED)
    elseif c == util.UNSUPPORTED then
      util.err("option '--" .. g.longname .. "' is not supported")
      usage_fail(EXIT_CANCELED)
    else
      if #g.errmsg > 0 then util.err(g.errmsg) end
      usage_fail(EXIT_CANCELED)
    end
  end
  local ops = g:operands()
  local oi = 1
  if oi <= #ops and ops[oi] == '-' then
    ignore_environment = true
    oi = oi + 1
  end
  if ignore_environment then
    devmsg('cleaning environ\n')
    dummy_environ[0] = nilptr
    environ = (@*[0]cstring)(&dummy_environ)
  else
    for _, v in ipairs(usvars) do
      devmsg('unset:    ' .. v .. '\n')
      if sys.unsetenv(cdup(v)) ~= 0 then die('cannot unset ' .. util.quote(v) .. ': ' .. sys.errstr()) end
    end
  end
  while oi <= #ops and ops[oi]:find('=', 1, true) > 0 do
    devmsg('setenv:   ' .. ops[oi] .. '\n')
    if c_putenv(cdup(ops[oi])) ~= 0 then
      local a = ops[oi]
      die('cannot set ' .. util.quote(a:sub(1, a:find('=', 1, true) - 1)) .. ': ' .. sys.errstr())
    end
    oi = oi + 1
  end
  local program_specified = oi <= #ops
  if nul_terminate and program_specified then
    util.err('cannot specify --null (-0) with command')
    usage_fail(EXIT_CANCELED)
  end
  if have_newdir and not program_specified then
    util.err('must specify command with --chdir (-C)')
    usage_fail(EXIT_CANCELED)
  end
  if not program_specified then
    local i = 0
    while environ[i] ~= nilptr do
      util.write((@string)(environ[i]))
      util.writebyte(nul_terminate and 0 or 10)
      i = i + 1
    end
    if not util.flush() then util.err('write error: ' .. sys.errstr()); return EXIT_CANCELED end
    return 0
  end
  reset_signal_handlers()
  if sig_mask_changed then set_signal_proc_mask() end
  if report_signal_handling then list_signal_handling() end
  if have_newdir then
    devmsg('chdir:    ' .. util.quoteaf(newdir) .. '\n')
    if sys.chdir(cdup(newdir)) ~= 0 then
      die('cannot change directory to ' .. util.quoteaf(newdir) .. ': ' .. sys.errstr())
    end
  end
  if dev_debug then
    devmsg('executing: ' .. ops[oi] .. '\n')
    for k = oi, #ops do devmsg('   arg[' .. tostring(k - oi) .. ']= ' .. util.quote(ops[k]) .. '\n') end
  end
  local argv: sequence(cstring)
  for k = oi, #ops do argv:push(cdup(ops[k])) end
  argv:push(nilptr)
  util.flush()
  sys.execvp(argv[1], &argv[1])
  local e = sys.errno()
  util.err(util.quote(ops[oi]) .. ': ' .. sys.errstr())
  if e == sys.ENOENT then
    local p = ops[oi]
    for k = 1, #p do
      if isspace(p:byte(k)) then util.err('use -[v]S to pass options in shebang lines'); break end
    end
    return EXIT_ENOENT
  end
  return EXIT_CANNOT_INVOKE
end
