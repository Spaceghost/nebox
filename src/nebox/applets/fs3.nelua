-- install, df
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.modechange'
require 'nebox.longopts'
require 'nebox.applets.fs'

-- install ---------------------------------------------------------------------

-- df --------------------------------------------------------------------------
local Mount = @record{ dev: string, point: string, fstype: string }

local function mounts(): sequence(Mount)
  local out: sequence(Mount)
  local data, ok = util.readfile('/proc/self/mounts')
  if not ok then return out end
  for _, line in ipairs(util.lines(data)) do
    local f: sequence(string)
    for w in line:gmatch('%S+') do f:push(w) end
    if #f >= 3 then out:push((@Mount){dev = f[1], point = f[2], fstype = f[3]}) end
  end
  return out
end

local DfRow = @record{ cols: [5]string, point: string }

local function df_row(m: Mount, human: boolean, inodes: boolean): (DfRow, boolean)
  local row: DfRow
  local sf: sys.Statfs
  if sys.statfs(m.point, &sf) < 0 then return row, false end
  if sf.f_blocks == 0 and not inodes then return row, false end
  local bs = (@integer)(sf.f_frsize > 0 and sf.f_frsize or sf.f_bsize)
  local total, free, avail: integer
  if inodes then
    total = (@integer)(sf.f_files); free = (@integer)(sf.f_ffree); avail = free
  else
    total = (@integer)(sf.f_blocks) * bs // 1024
    free = (@integer)(sf.f_bfree) * bs // 1024
    avail = (@integer)(sf.f_bavail) * bs // 1024
  end
  local used = total - free
  local pct: integer = 0
  if used + avail > 0 then pct = (used * 100 + (used + avail) - 1) // (used + avail) end
  local unit: integer = inodes and 1 or 1024
  row.cols[0] = m.dev
  if human then
    row.cols[1] = util.human(total * unit); row.cols[2] = util.human(used * unit); row.cols[3] = util.human(avail * unit)
  else
    row.cols[1] = string.format('%d', total); row.cols[2] = string.format('%d', used); row.cols[3] = string.format('%d', avail)
  end
  if total == 0 then row.cols[4] = '-' else row.cols[4] = string.format('%d%%', pct) end
  row.point = m.point
  return row, true
end

local function df_print(rows: sequence(DfRow), heads: [5]string, human: boolean)
  if #rows == 0 then return end
  local w: [5]integer
  for k = 0, 4 do
    w[k] = (@integer)(heads[k].size)
    if human and k >= 1 and k <= 3 and w[k] < 5 then w[k] = 5 end
    for _, r in ipairs(rows) do if (@integer)(r.cols[k].size) > w[k] then w[k] = (@integer)(r.cols[k].size) end end
  end
  util.write(heads[0]); for _ = (@integer)(heads[0].size) + 1, w[0] do util.writebyte(32) end
  for k = 1, 4 do
    util.writebyte(32)
    for _ = (@integer)(heads[k].size) + 1, w[k] do util.writebyte(32) end
    util.write(heads[k])
  end
  util.line(' Mounted on')
  for _, r in ipairs(rows) do
    util.write(r.cols[0]); for _ = (@integer)(r.cols[0].size) + 1, w[0] do util.writebyte(32) end
    for k = 1, 4 do
      util.writebyte(32)
      for _ = (@integer)(r.cols[k].size) + 1, w[k] do util.writebyte(32) end
      util.write(r.cols[k])
    end
    util.write(' '); util.line(r.point)
  end
end

