-- find, install, df
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.modechange'
require 'nebox.longopts'
require 'nebox.applets.fs'
require 'nebox.applets.proc2'
require 'nebox.regex'

-- find ----------------------------------------------------------------------
-- Expression tree. Operators: N_AND N_OR N_NOT; everything else is a primary.
local N_AND: byte <comptime> = 1
local N_OR: byte <comptime> = 2
local N_NOT: byte <comptime> = 3
local N_TRUE: byte <comptime> = 4
local N_FALSE: byte <comptime> = 5
local N_NAME: byte <comptime> = 6
local N_PATH: byte <comptime> = 7
local N_TYPE: byte <comptime> = 8
local N_EMPTY: byte <comptime> = 9
local N_SIZE: byte <comptime> = 10
local N_NEWER: byte <comptime> = 11
local N_MTIME: byte <comptime> = 12
local N_MMIN: byte <comptime> = 13
local N_PERM: byte <comptime> = 14
local N_USER: byte <comptime> = 15
local N_GROUP: byte <comptime> = 16
local N_LINKS: byte <comptime> = 17
local N_INUM: byte <comptime> = 18
local N_PRINT: byte <comptime> = 19
local N_PRINT0: byte <comptime> = 20
local N_PRUNE: byte <comptime> = 21
local N_DELETE: byte <comptime> = 22
local N_EXEC: byte <comptime> = 23
local N_EXECPLUS: byte <comptime> = 24
local N_QUIT: byte <comptime> = 25
local N_REGEX: byte <comptime> = 26

local Node = @record{
  kind: byte, icase: boolean,
  left: integer, right: integer,
  s: string, n: integer, cmp: integer,   -- cmp: -1 less, 0 exact, 1 greater
  mode: cuint, permkind: byte,           -- 0 exact, 1 all (-), 2 any (/)
  argv: sequence(string),
  t: clong,
}

local Find = @record{
  nodes: sequence(Node), root: integer,
  maxdepth: integer, mindepth: integer, depthfirst: boolean,
  has_action: boolean, rc: integer, pruned: boolean, quit: boolean,
  args: sequence(string), pos: integer, err: string,
  plus: sequence(string), plusargv: sequence(string), hasplus: boolean,
  now: clong,
}

local find: Find

local function fnew(kind: byte): integer
  local n: Node
  n.kind = kind
  n.left = -1; n.right = -1
  find.nodes:push(n)
  return #find.nodes
end

local function fpeek(): string
  if find.pos > #find.args then return '' end
  return find.args[find.pos]
end

local function fnext(): string
  local a = fpeek()
  find.pos = find.pos + 1
  return a
end

local function need(opt: string): (string, boolean)
  if find.pos > #find.args then find.err = "missing argument to `" .. opt .. "'"; return '', false end
  return fnext(), true
end

-- Parse "+N" "-N" "N" into (n, cmp)
local function signed(s: string): (integer, integer, boolean)
  local cmp: integer = 0
  local body = s
  if s.size > 0 and s:byte(1) == 43 then cmp = 1; body = s:sub(2)
  elseif s.size > 0 and s:byte(1) == 45 then cmp = -1; body = s:sub(2) end
  local v, ok = util.toint(body)
  return v, cmp, ok
end

local function cmpmatch(v: integer, n: integer, cmp: integer): boolean
  if cmp > 0 then return v > n elseif cmp < 0 then return v < n end
  return v == n
end

function Find.parse_or(): integer <forwarddecl> end

function Find.parse_primary(): integer
  local a = fnext()
  if a == '(' then
    local e = Find.parse_or()
    if find.err.size > 0 then return -1 end
    if fnext() ~= ')' then find.err = "invalid expression; expected ')'"; return -1 end
    return e
  elseif a == '!' or a == '-not' then
    local e = Find.parse_primary()
    if find.err.size > 0 then return -1 end
    local n = fnew(N_NOT); find.nodes[n].left = e
    return n
  elseif a == '-name' or a == '-iname' or a == '-path' or a == '-ipath' or a == '-wholename' then
    local v, ok = need(a); if not ok then return -1 end
    local n = fnew((a == '-name' or a == '-iname') and N_NAME or N_PATH)
    find.nodes[n].s = v; find.nodes[n].icase = a == '-iname' or a == '-ipath'
    return n
  elseif a == '-regex' or a == '-iregex' then
    local v, ok = need(a); if not ok then return -1 end
    local n = fnew(N_REGEX); find.nodes[n].s = v; find.nodes[n].icase = a == '-iregex'
    return n
  elseif a == '-type' then
    local v, ok = need(a); if not ok then return -1 end
    if v.size ~= 1 or ('fdlcbps'):find(v, 1, true) <= 0 then find.err = "Unknown argument to -type: " .. v; return -1 end
    local n = fnew(N_TYPE); find.nodes[n].s = v
    return n
  elseif a == '-empty' then return fnew(N_EMPTY)
  elseif a == '-true' then return fnew(N_TRUE)
  elseif a == '-false' then return fnew(N_FALSE)
  elseif a == '-print' then find.has_action = true; return fnew(N_PRINT)
  elseif a == '-print0' then find.has_action = true; return fnew(N_PRINT0)
  elseif a == '-prune' then return fnew(N_PRUNE)
  elseif a == '-quit' then find.has_action = true; return fnew(N_QUIT)
  elseif a == '-delete' then find.has_action = true; find.depthfirst = true; return fnew(N_DELETE)
  elseif a == '-depth' then find.depthfirst = true; return fnew(N_TRUE)
  elseif a == '-maxdepth' or a == '-mindepth' then
    local v, ok = need(a); if not ok then return -1 end
    local d, dok = util.toint(v)
    if not dok or d < 0 then find.err = 'Expected a positive decimal integer argument to ' .. a .. ', but got ' .. v; return -1 end
    if a == '-maxdepth' then find.maxdepth = d else find.mindepth = d end
    return fnew(N_TRUE)
  elseif a == '-size' then
    local v, ok = need(a); if not ok then return -1 end
    local unit: integer = 512
    local last = v:byte(v.size)
    local body = v
    if last == 99 then unit = 1; body = v:sub(1, -2)
    elseif last == 107 then unit = 1024; body = v:sub(1, -2)
    elseif last == 77 then unit = 1024 * 1024; body = v:sub(1, -2)
    elseif last == 71 then unit = 1024 * 1024 * 1024; body = v:sub(1, -2)
    elseif last == 98 then body = v:sub(1, -2) end
    local num, cmp, nok = signed(body)
    if not nok then find.err = "Invalid argument `" .. v .. "' to -size"; return -1 end
    local n = fnew(N_SIZE); find.nodes[n].n = num; find.nodes[n].cmp = cmp; find.nodes[n].t = unit
    return n
  elseif a == '-newer' then
    local v, ok = need(a); if not ok then return -1 end
    local st: sys.Stat
    if sys.stat(v, &st) ~= 0 then find.err = "cannot stat '" .. v .. "'"; return -1 end
    local n = fnew(N_NEWER); find.nodes[n].t = st.st_mtim.tv_sec; find.nodes[n].n = st.st_mtim.tv_nsec
    return n
  elseif a == '-mtime' or a == '-mmin' then
    local v, ok = need(a); if not ok then return -1 end
    local num, cmp, nok = signed(v)
    if not nok then find.err = "Invalid argument `" .. v .. "' to " .. a; return -1 end
    local n = fnew(a == '-mtime' and N_MTIME or N_MMIN); find.nodes[n].n = num; find.nodes[n].cmp = cmp
    return n
  elseif a == '-perm' then
    local v, ok = need(a); if not ok then return -1 end
    local n = fnew(N_PERM)
    local body = v
    if v:byte(1) == 45 then find.nodes[n].permkind = 1; body = v:sub(2)
    elseif v:byte(1) == 47 then find.nodes[n].permkind = 2; body = v:sub(2) end
    -- GNU find: an octal or symbolic mode, mode_adjust(0, false, 0, MODE)
    local ch, mok = modechange.compile(body)
    if not mok then find.err = "invalid mode `" .. v .. "'"; return -1 end
    find.nodes[n].mode = modechange.adjust(0, false, 0, ch)
    return n
  elseif a == '-user' or a == '-group' then
    local v, ok = need(a); if not ok then return -1 end
    local id, iok = util.toint(v)
    if not iok then
      if a == '-user' then id = util.userid(v) else id = util.groupid(v) end
      if id < 0 then find.err = "`" .. v .. "' is not the name of a known " .. (a == '-user' and 'user' or 'group'); return -1 end
    end
    local n = fnew(a == '-user' and N_USER or N_GROUP); find.nodes[n].n = id
    return n
  elseif a == '-links' or a == '-inum' then
    local v, ok = need(a); if not ok then return -1 end
    local num, cmp, nok = signed(v)
    if not nok then find.err = "Invalid argument `" .. v .. "' to " .. a; return -1 end
    local n = fnew(a == '-links' and N_LINKS or N_INUM); find.nodes[n].n = num; find.nodes[n].cmp = cmp
    return n
  elseif a == '-exec' or a == '-execdir' or a == '-ok' then
    local argv: sequence(string)
    local plus = false
    local terminated = false
    while find.pos <= #find.args do
      local t = fnext()
      if t == ';' then terminated = true; break end
      if t == '+' and #argv > 0 and argv[#argv] == '{}' then argv:remove(#argv); plus = true; terminated = true; break end
      argv:push(t)
    end
    if not terminated or #argv == 0 then find.err = "missing argument to `" .. a .. "'"; return -1 end
    find.has_action = true
    local n = fnew(plus and N_EXECPLUS or N_EXEC); find.nodes[n].argv = argv
    if plus then find.hasplus = true; find.plusargv = argv end
    return n
  elseif a == '' then
    find.err = 'invalid expression'; return -1
  end
  find.err = "unknown predicate `" .. a .. "'"
  return -1
end

function Find.parse_and(): integer
  local left = Find.parse_primary()
  if find.err.size > 0 then return -1 end
  while find.pos <= #find.args do
    local t = fpeek()
    if t == '-o' or t == '-or' or t == ')' then break end
    if t == '-a' or t == '-and' then fnext() end
    local right = Find.parse_primary()
    if find.err.size > 0 then return -1 end
    local n = fnew(N_AND); find.nodes[n].left = left; find.nodes[n].right = right
    left = n
  end
  return left
end

function Find.parse_or(): integer
  local left = Find.parse_and()
  if find.err.size > 0 then return -1 end
  while find.pos <= #find.args do
    local t = fpeek()
    if t ~= '-o' and t ~= '-or' then break end
    fnext()
    local right = Find.parse_and()
    if find.err.size > 0 then return -1 end
    local n = fnew(N_OR); find.nodes[n].left = left; find.nodes[n].right = right
    left = n
  end
  return left
end

local function print_path(path: string, nul: boolean)
  util.write(path); util.writebyte(nul and 0 or 10)
end

local function run_plus()
  if #find.plus == 0 then return end
  local argv: sequence(string)
  for _, a in ipairs(find.plusargv) do argv:push(a) end
  for _, p in ipairs(find.plus) do argv:push(p) end
  if spawn_wait(argv) ~= 0 then find.rc = 1 end
  find.plus:clear()
end

local function eval(ni: integer, path: string, st: *sys.Stat): boolean
  local n = &find.nodes[ni]
  local k = n.kind
  if k == N_AND then return eval(n.left, path, st) and eval(n.right, path, st)
  elseif k == N_OR then return eval(n.left, path, st) or eval(n.right, path, st)
  elseif k == N_NOT then return not eval(n.left, path, st)
  elseif k == N_TRUE then return true
  elseif k == N_FALSE then return false
  elseif k == N_NAME then return util.glob(n.s, util.basename(path), n.icase)
  elseif k == N_PATH then return util.glob(n.s, path, n.icase)
  elseif k == N_REGEX then
    local prog, err = regex.compile('^\\(' .. n.s .. '\\)$', false, n.icase)
    if err.size > 0 then return false end
    return prog:test(path)
  elseif k == N_TYPE then
    local t = st.st_mode & sys.S_IFMT
    local c = n.s:byte(1)
    if c == 102 then return t == sys.S_IFREG elseif c == 100 then return t == sys.S_IFDIR
    elseif c == 108 then return t == sys.S_IFLNK elseif c == 99 then return t == sys.S_IFCHR
    elseif c == 98 then return t == sys.S_IFBLK elseif c == 112 then return t == sys.S_IFIFO
    else return t == sys.S_IFSOCK end
  elseif k == N_EMPTY then
    local t = st.st_mode & sys.S_IFMT
    if t == sys.S_IFREG then return st.st_size == 0 end
    if t == sys.S_IFDIR then
      local names, ok = util.readnames(path, true)
      if not ok then return false end
      for _, nm in ipairs(names) do if nm ~= '.' and nm ~= '..' then return false end end
      return true
    end
    return false
  elseif k == N_SIZE then
    local units = (st.st_size + n.t - 1) // n.t
    return cmpmatch(units, n.n, n.cmp)
  elseif k == N_NEWER then
    return st.st_mtim.tv_sec > n.t or (st.st_mtim.tv_sec == n.t and st.st_mtim.tv_nsec > n.n)
  elseif k == N_MTIME then
    local age = (find.now - st.st_mtim.tv_sec) // 86400
    return cmpmatch(age, n.n, n.cmp)
  elseif k == N_MMIN then
    local age = (find.now - st.st_mtim.tv_sec) // 60
    return cmpmatch(age, n.n, n.cmp)
  elseif k == N_PERM then
    local bits = st.st_mode & 0xFFF
    if n.permkind == 0 then return bits == n.mode
    elseif n.permkind == 1 then return (bits & n.mode) == n.mode end
    return (bits & n.mode) ~= 0 or n.mode == 0
  elseif k == N_USER then return (@integer)(st.st_uid) == n.n
  elseif k == N_GROUP then return (@integer)(st.st_gid) == n.n
  elseif k == N_LINKS then return cmpmatch((@integer)(st.st_nlink), n.n, n.cmp)
  elseif k == N_INUM then return cmpmatch((@integer)(st.st_ino), n.n, n.cmp)
  elseif k == N_PRINT then print_path(path, false); return true
  elseif k == N_PRINT0 then print_path(path, true); return true
  elseif k == N_PRUNE then
    if (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then find.pruned = true end
    return true
  elseif k == N_QUIT then find.quit = true; return true
  elseif k == N_DELETE then
    local r: cint
    if (st.st_mode & sys.S_IFMT) == sys.S_IFDIR then r = sys.rmdir(path) else r = sys.unlink(path) end
    if r ~= 0 then util.err("cannot delete '" .. path .. "': " .. sys.errstr()); find.rc = 1; return false end
    return true
  elseif k == N_EXEC then
    local argv: sequence(string)
    for _, a in ipairs(n.argv) do
      if a:find('{}', 1, true) > 0 then
        local sb: stringbuilder
        local pos: isize = 1
        while true do
          local at = a:find('{}', pos, true)
          if at <= 0 then sb:write(a:sub(pos)); break end
          sb:write(a:sub(pos, at - 1)); sb:write(path); pos = at + 2
        end
        argv:push(sb:promote())
      else argv:push(a) end
    end
    return spawn_wait(argv) == 0
  elseif k == N_EXECPLUS then
    find.plus:push(path)
    return true
  end
  return false
end

local function visit(path: string, depth: integer)
  if find.quit then return end
  local st: sys.Stat
  if sys.lstat(path, &st) ~= 0 then
    util.err("'" .. path .. "': " .. sys.errstr()); find.rc = 1; return
  end
  local isdir = (st.st_mode & sys.S_IFMT) == sys.S_IFDIR
  find.pruned = false
  if not find.depthfirst and depth >= find.mindepth then
    eval(find.root, path, &st)
  end
  if isdir and not find.pruned and (find.maxdepth < 0 or depth < find.maxdepth) then
    local names, ok = util.readnames(path, true)
    if not ok then
      util.err("'" .. path .. "': " .. sys.errstr()); find.rc = 1
    else
      for _, nm in ipairs(names) do
        if nm == '.' or nm == '..' then continue end
        visit(util.join(path, nm), depth + 1)
        if find.quit then return end
      end
    end
  end
  if find.depthfirst and depth >= find.mindepth then
    eval(find.root, path, &st)
  end
end

global function applet_find(args: sequence(string)): integer
  find = (@Find){}
  find.maxdepth = -1
  local starts: sequence(string)
  local i: integer = 1
  while i <= #args do
    local a = args[i]
    if a == '-H' or a == '-L' or a == '-P' then i = i + 1; continue end
    if a.size > 0 and (a:byte(1) == 45 or a == '(' or a == '!' or a == ')') then break end
    starts:push(a); i = i + 1
  end
  if #starts == 0 then starts:push('.') end
  for k = i, #args do find.args:push(args[k]) end
  find.pos = 1
  if #find.args == 0 then
    find.root = fnew(N_TRUE)
  else
    find.root = Find.parse_or()
    if find.err.size == 0 and find.pos <= #find.args then find.err = "invalid expression; unexpected `" .. fpeek() .. "'" end
    if find.err.size > 0 then util.err(find.err); return 1 end
  end
  if not find.has_action then
    local p = fnew(N_PRINT)
    local n = fnew(N_AND); find.nodes[n].left = find.root; find.nodes[n].right = p
    find.root = n
  end
  local ts: sys.Timespec
  sys.clock_gettime(sys.CLOCK_REALTIME, &ts)
  find.now = ts.tv_sec
  for _, s in ipairs(starts) do
    visit(s, 0)
    if find.quit then break end
  end
  if find.hasplus then run_plus() end
  return find.rc
end

-- install ---------------------------------------------------------------------

-- df --------------------------------------------------------------------------
local Mount = @record{ dev: string, point: string, fstype: string }

local function mounts(): sequence(Mount)
  local out: sequence(Mount)
  local data, ok = util.readfile('/proc/self/mounts')
  if not ok then return out end
  for _, line in ipairs(util.lines(data)) do
    local f: sequence(string)
    for w in line:gmatch('%S+') do f:push(w) end
    if #f >= 3 then out:push((@Mount){dev = f[1], point = f[2], fstype = f[3]}) end
  end
  return out
end

local DfRow = @record{ cols: [5]string, point: string }

local function df_row(m: Mount, human: boolean, inodes: boolean): (DfRow, boolean)
  local row: DfRow
  local sf: sys.Statfs
  if sys.statfs(m.point, &sf) < 0 then return row, false end
  if sf.f_blocks == 0 and not inodes then return row, false end
  local bs = (@integer)(sf.f_frsize > 0 and sf.f_frsize or sf.f_bsize)
  local total, free, avail: integer
  if inodes then
    total = (@integer)(sf.f_files); free = (@integer)(sf.f_ffree); avail = free
  else
    total = (@integer)(sf.f_blocks) * bs // 1024
    free = (@integer)(sf.f_bfree) * bs // 1024
    avail = (@integer)(sf.f_bavail) * bs // 1024
  end
  local used = total - free
  local pct: integer = 0
  if used + avail > 0 then pct = (used * 100 + (used + avail) - 1) // (used + avail) end
  local unit: integer = inodes and 1 or 1024
  row.cols[0] = m.dev
  if human then
    row.cols[1] = util.human(total * unit); row.cols[2] = util.human(used * unit); row.cols[3] = util.human(avail * unit)
  else
    row.cols[1] = string.format('%d', total); row.cols[2] = string.format('%d', used); row.cols[3] = string.format('%d', avail)
  end
  if total == 0 then row.cols[4] = '-' else row.cols[4] = string.format('%d%%', pct) end
  row.point = m.point
  return row, true
end

local function df_print(rows: sequence(DfRow), heads: [5]string, human: boolean)
  if #rows == 0 then return end
  local w: [5]integer
  for k = 0, 4 do
    w[k] = (@integer)(heads[k].size)
    if human and k >= 1 and k <= 3 and w[k] < 5 then w[k] = 5 end
    for _, r in ipairs(rows) do if (@integer)(r.cols[k].size) > w[k] then w[k] = (@integer)(r.cols[k].size) end end
  end
  util.write(heads[0]); for _ = (@integer)(heads[0].size) + 1, w[0] do util.writebyte(32) end
  for k = 1, 4 do
    util.writebyte(32)
    for _ = (@integer)(heads[k].size) + 1, w[k] do util.writebyte(32) end
    util.write(heads[k])
  end
  util.line(' Mounted on')
  for _, r in ipairs(rows) do
    util.write(r.cols[0]); for _ = (@integer)(r.cols[0].size) + 1, w[0] do util.writebyte(32) end
    for k = 1, 4 do
      util.writebyte(32)
      for _ = (@integer)(r.cols[k].size) + 1, w[k] do util.writebyte(32) end
      util.write(r.cols[k])
    end
    util.write(' '); util.line(r.point)
  end
end

