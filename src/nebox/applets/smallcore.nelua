-- nproc, sleep and printenv: ports of GNU coreutils 9.1 src/nproc.c (with
-- gnulib nproc.c: OMP_NUM_THREADS/OMP_THREAD_LIMIT, the affinity mask for
-- the current count, /sys/devices/system/cpu for --all), src/sleep.c
-- (C-locale strtod numbers including inf and hex floats, one s/m/h/d
-- suffix, intervals summed, xnanosleep's endless sleep for infinity) and
-- src/printenv.c (-0, "a=b" operands silently skipped).
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'

local function c_exit(status: cint) <cimport 'exit', cinclude '<stdlib.h>', noreturn> end
local function c_sched_getaffinity(pid: cint, size: csize, mask: *[128]byte): cint <cimport 'sched_getaffinity', cinclude '<sched.h>'> end
local function c_strtod(s: cstring, endp: *cstring): float64 <cimport 'strtod', cinclude '<stdlib.h>'> end
local function c_nanosleep(req: *sys.Timespec, rem: *sys.Timespec): cint <cimport 'nanosleep', cinclude '<time.h>'> end
local environ: *[0]cstring <cimport 'environ', cinclude '<unistd.h>', nodecl>

local function usage_fail(prog: string, msg: string, status: cint)
  if #msg > 0 then util.err(msg) end
  util.flush()
  local m = "Try '" .. prog .. " --help' for more information.\n"
  sys.write(2, m.data, m.size)
  c_exit(status)
end

-- gnulib parse_omp_threads: the first number of a comma list, 0 if invalid.
local function parse_omp_threads(e: cstring): uint64
  if e == nilptr then return 0 end
  local s: string = (@string)(e)
  local p = 1
  while p <= #s and (s:byte(p) == 32 or (s:byte(p) >= 9 and s:byte(p) <= 13)) do p = p + 1 end
  if p > #s or s:byte(p) < 48 or s:byte(p) > 57 then return 0 end
  local v: uint64 = 0
  while p <= #s and s:byte(p) >= 48 and s:byte(p) <= 57 do v = v * 10 + s:byte(p) - 48; p = p + 1 end
  while p <= #s and (s:byte(p) == 32 or (s:byte(p) >= 9 and s:byte(p) <= 13)) do p = p + 1 end
  if p <= #s and s:byte(p) ~= 44 then return 0 end
  return v
end

local function nprocs_all(): uint64
  local names, ok = util.readnames('/sys/devices/system/cpu', true)
  local n: uint64 = 0
  if ok then
    for _, nm in ipairs(names) do
      if #nm > 3 and nm:sub(1, 3) == 'cpu' then
        local digits = true
        for k = 4, #nm do if nm:byte(k) < 48 or nm:byte(k) > 57 then digits = false; break end end
        if digits then n = n + 1 end
      end
    end
  end
  return n > 0 and n or 1
end

local function nprocs_current(): uint64
  local mask: [128]byte
  if c_sched_getaffinity(0, #mask, &mask) == 0 then
    local n: uint64 = 0
    for i = 0, #mask - 1 do
      local b = mask[i]
      while b ~= 0 do n = n + (b & 1); b = b >> 1 end
    end
    if n > 0 then return n end
  end
  return nprocs_all()
end

global function applet_nproc(args: sequence(string)): integer
  local ignore: uint64 = 0
  local all = false
  local longs: []util.LongOpt = {{'all', 0, 256}, {'ignore', 1, 257}, {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED}}
  local g = util.getopt(args, '', &longs, #longs)
  g.quiet = true
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 63 then usage_fail('nproc', g.errmsg, 1) end
    if c == util.UNSUPPORTED then usage_fail('nproc', "option '--" .. g.longname .. "' is not supported", 1) end
    if c == 256 then all = true
    elseif c == 257 then
      local ok, v, e = util.xdectoumax(g.optarg, 0, 0xffffffffffffffff, '', 'invalid number')
      if not ok then util.err(e); util.flush(); c_exit(1) end
      ignore = v
    end
  end
  local ops = g:operands()
  if #ops > 0 then usage_fail('nproc', 'extra operand ' .. util.quote(ops[1]), 1) end
  local n: uint64
  if all then
    n = nprocs_all()
  else
    local threads: uint64 = parse_omp_threads(sys.getenv('OMP_NUM_THREADS'))
    local limit: uint64 = parse_omp_threads(sys.getenv('OMP_THREAD_LIMIT'))
    if limit == 0 then limit = (@uint64)(-1) end
    if threads ~= 0 then n = threads < limit and threads or limit
    else
      n = nprocs_current()
      if limit < n then n = limit end
    end
  end
  if ignore < n then n = n - ignore else n = 1 end
  util.write(tostring(n) .. '\n')
  if not util.flush() then util.err('write error: ' .. sys.errstr()); return 1 end
  return 0
end

global function applet_sleep(args: sequence(string)): integer
  local longs: []util.LongOpt = {{'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED}}
  local g = util.getopt(args, '+', &longs, #longs)
  g.quiet = true
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == util.UNSUPPORTED then usage_fail('sleep', "option '--" .. g.longname .. "' is not supported", 1) end
    usage_fail('sleep', g.errmsg, 1)
  end
  local ops = g:operands()
  if #args == 0 then usage_fail('sleep', 'missing operand', 1) end
  local seconds: float64 = 0
  local ok = true
  for _, a in ipairs(ops) do
    local endp: cstring = nilptr
    sys.seterrno(0)
    local s = c_strtod(a, &endp)
    local consumed = (@usize)(endp) - (@usize)((@cstring)(a))
    local good = consumed > 0 and (sys.errno() == 0 or sys.errno() == 34)
    local rest = a:sub((@integer)(consumed) + 1)
    if good and not (0 <= s) then good = false end
    if good and #rest > 1 then good = false end
    if good then
      local suf: byte = #rest == 1 and rest:byte(1) or 0
      if suf == 0 or suf == 115 then
      elseif suf == 109 then s = s * 60
      elseif suf == 104 then s = s * 3600
      elseif suf == 100 then s = s * 86400
      else good = false end
    end
    if not good then
      util.err('invalid time interval ' .. util.quote(a))
      ok = false
    end
    seconds = seconds + s
  end
  if not ok then usage_fail('sleep', '', 1) end
  -- xnanosleep: an interval past what a timespec holds sleeps for good
  local limit: float64 = 9223372036854775807.0
  while true do
    local ts: sys.Timespec
    if seconds < limit then
      local whole = (@int64)(seconds)
      local frac = seconds - (@float64)(whole)
      local ns = (@int64)(frac * 1e9 + 0.999999999)
      if ns >= 1000000000 then whole = whole + 1; ns = ns - 1000000000 end
      ts.tv_sec = whole; ts.tv_nsec = ns
    else
      ts.tv_sec = 0x7fffffffffffffff; ts.tv_nsec = 999999999
    end
    local rem: sys.Timespec
    local r = c_nanosleep(&ts, &rem)
    if r == 0 then
      if seconds < limit then break end
    elseif sys.errno() == sys.EINTR then
      if seconds < limit then seconds = (@float64)(rem.tv_sec) + (@float64)(rem.tv_nsec) / 1e9 end
    else
      util.err('cannot read realtime clock: ' .. sys.errstr())
      util.flush()
      return 1
    end
  end
  return 0
end

global function applet_printenv(args: sequence(string)): integer
  local nul = false
  local longs: []util.LongOpt = {{'null', 0, 48}, {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED}}
  local g = util.getopt(args, '+iu:0', &longs, #longs)
  g.quiet = true
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 48 then nul = true
    elseif c == util.UNSUPPORTED then usage_fail('printenv', "option '--" .. g.longname .. "' is not supported", 2)
    else usage_fail('printenv', g.errmsg, 2) end
  end
  local ops = g:operands()
  local term: byte = nul and 0 or 10
  if #ops == 0 then
    local i = 0
    while environ[i] ~= nilptr do
      util.write((@string)(environ[i])); util.writebyte(term)
      i = i + 1
    end
    util.flush()
    return 0
  end
  local matches = 0
  for _, a in ipairs(ops) do
    local matched = false
    if a:find('=', 1, true) == 0 then
      local i = 0
      while environ[i] ~= nilptr do
        local e: string = (@string)(environ[i])
        if #e > #a and e:sub(1, #a) == a and e:byte(#a + 1) == 61 then
          util.write(e:sub(#a + 2)); util.writebyte(term)
          matched = true
        end
        i = i + 1
      end
      if matched then matches = matches + 1 end
    end
  end
  if not util.flush() then util.err('write error: ' .. sys.errstr()); return 2 end
  return matches == #ops and 0 or 1
end
