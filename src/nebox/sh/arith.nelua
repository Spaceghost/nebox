-- sh arithmetic expansion: signed 64-bit integers, the C operator set of
-- POSIX.1-2017 XCU 2.6.4 (plus the optional ++/-- and the comma operator),
-- variables read and assigned through hooks the interpreter installs.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'

## local function B(c) return string.byte(c) end

global sharith = @record{}

global sharith.getvar: function(name: string): string
global sharith.setvar: function(name: string, value: string)

local A = @record{
  src: string,
  pos: usize,
  err: string,
  -- current token
  tk: integer,      -- 0 eof, 1 number, 2 name, 3 operator
  num: integer,
  name: string,
  op: string,
}

local function is_digit(c: byte): boolean return c >= 48 and c <= 57 end
local function is_alpha(c: byte): boolean return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 end

local function fail(a: *A, msg: string)
  if a.err.size == 0 then a.err = msg end
  a.tk = 0
end

-- Parse an integer constant; `ok` false when the text is not one.
function sharith.parse_int(s: string): (integer, boolean)
  local i: usize = 1
  while i <= s.size and (s:byte(i) == 32 or s:byte(i) == 9 or s:byte(i) == 10) do i = i + 1 end
  local neg = false
  if i <= s.size and (s:byte(i) == #[B'-']# or s:byte(i) == #[B'+']#) then
    neg = s:byte(i) == #[B'-']#
    i = i + 1
  end
  if i > s.size then return 0, false end
  local base: uint64 = 10
  if s:byte(i) == #[B'0']# and i < s.size and (s:byte(i + 1) == #[B'x']# or s:byte(i + 1) == #[B'X']#) then
    base = 16
    i = i + 2
    if i > s.size then return 0, false end
  elseif s:byte(i) == #[B'0']# and i < s.size then
    base = 8
    i = i + 1
  end
  local v: uint64 = 0
  local any = false
  while i <= s.size do
    local c = s:byte(i)
    local d: uint64
    if is_digit(c) then d = (@uint64)(c - 48)
    elseif c >= 97 and c <= 102 then d = (@uint64)(c - 87)
    elseif c >= 65 and c <= 70 then d = (@uint64)(c - 55)
    else break end
    if d >= base then return 0, false end
    v = v * base + d
    any = true
    i = i + 1
  end
  while i <= s.size and (s:byte(i) == 32 or s:byte(i) == 9 or s:byte(i) == 10) do i = i + 1 end
  if not any or i <= s.size then return 0, false end
  local r = (@integer)(v)
  if neg then r = (@integer)(0 - v) end
  return r, true
end

local function lex(a: *A)
  local s = a.src
  while a.pos < s.size do
    local c = s.data[a.pos]
    if c == 32 or c == 9 or c == 10 or c == 13 then a.pos = a.pos + 1 else break end
  end
  if a.pos >= s.size then a.tk = 0; return end
  local c = s.data[a.pos]
  if is_digit(c) then
    local start = a.pos
    while a.pos < s.size and (is_digit(s.data[a.pos]) or is_alpha(s.data[a.pos])) do a.pos = a.pos + 1 end
    local text = (@string){data = &s.data[start], size = a.pos - start}
    local v, ok = sharith.parse_int(text)
    if not ok then fail(a, 'Illegal number: ' .. text); return end
    a.tk = 1
    a.num = v
    return
  end
  if is_alpha(c) then
    local start = a.pos
    while a.pos < s.size and (is_digit(s.data[a.pos]) or is_alpha(s.data[a.pos])) do a.pos = a.pos + 1 end
    a.tk = 2
    a.name = string.copy((@string){data = &s.data[start], size = a.pos - start})
    return
  end
  -- operators, longest first
  local rest = (@string){data = &s.data[a.pos], size = s.size - a.pos}
  local ops3: []string = {'<<=', '>>='}
  local ops2: []string = {'++', '--', '<<', '>>', '<=', '>=', '==', '!=', '&&', '||', '+=', '-=', '*=', '/=', '%=', '&=', '^=', '|='}
  for i: integer = 0, < #ops3 do
    if rest.size >= 3 and rest:subview(1, 3) == ops3[i] then
      a.tk = 3; a.op = ops3[i]; a.pos = a.pos + 3; return
    end
  end
  for i: integer = 0, < #ops2 do
    if rest.size >= 2 and rest:subview(1, 2) == ops2[i] then
      a.tk = 3; a.op = ops2[i]; a.pos = a.pos + 2; return
    end
  end
  local singles: string = '+-*/%<>&|^!~?:(),='
  for i: usize = 1, singles.size do
    if c == singles:byte(i) then
      a.tk = 3; a.op = singles:sub(i, i); a.pos = a.pos + 1; return
    end
  end
  fail(a, 'expecting primary')
end

local function is_op(a: *A, op: string): boolean
  return a.tk == 3 and a.op == op
end

local function var_value(a: *A, name: string): integer
  local s = sharith.getvar(name)
  if s.size == 0 then return 0 end
  local v, ok = sharith.parse_int(s)
  if not ok then fail(a, 'Illegal number: ' .. s); return 0 end
  return v
end

local function assign(name: string, v: integer)
  sharith.setvar(name, string.format('%d', v))
end

local function wrap_add(x: integer, y: integer): integer return (@integer)((@uint64)(x) + (@uint64)(y)) end
local function wrap_sub(x: integer, y: integer): integer return (@integer)((@uint64)(x) - (@uint64)(y)) end
local function wrap_mul(x: integer, y: integer): integer return (@integer)((@uint64)(x) * (@uint64)(y)) end

local function binop(a: *A, op: string, x: integer, y: integer, active: boolean): integer
  if op == '+' then return wrap_add(x, y)
  elseif op == '-' then return wrap_sub(x, y)
  elseif op == '*' then return wrap_mul(x, y)
  elseif op == '/' or op == '%' then
    if y == 0 then
      if active then fail(a, 'division by zero') end
      return 0
    end
    if y == -1 then
      if op == '/' then return wrap_sub(0, x) end
      return 0
    end
    if op == '/' then return x // y + ((x % y ~= 0 and (x < 0) ~= (y < 0)) and 1 or 0) end
    local r = x % y
    if r ~= 0 and (r < 0) ~= (x < 0) then r = r - y end
    return r
  elseif op == '<<' then
    if y < 0 or y >= 64 then return 0 end
    return (@integer)((@uint64)(x) << (@uint64)(y))
  elseif op == '>>' then
    if y < 0 or y >= 64 then return x < 0 and -1 or 0 end
    return x >>> y
  elseif op == '<' then return x < y and 1 or 0
  elseif op == '<=' then return x <= y and 1 or 0
  elseif op == '>' then return x > y and 1 or 0
  elseif op == '>=' then return x >= y and 1 or 0
  elseif op == '==' then return x == y and 1 or 0
  elseif op == '!=' then return x ~= y and 1 or 0
  elseif op == '&' then return x & y
  elseif op == '^' then return x ~ y
  elseif op == '|' then return x | y
  end
  return 0
end

local function prec(op: string): integer
  if op == '*' or op == '/' or op == '%' then return 10 end
  if op == '+' or op == '-' then return 9 end
  if op == '<<' or op == '>>' then return 8 end
  if op == '<' or op == '<=' or op == '>' or op == '>=' then return 7 end
  if op == '==' or op == '!=' then return 6 end
  if op == '&' then return 5 end
  if op == '^' then return 4 end
  if op == '|' then return 3 end
  if op == '&&' then return 2 end
  if op == '||' then return 1 end
  return 0
end

local function parse_assign(a: *A, active: boolean): integer <forwarddecl> end
local function parse_comma(a: *A, active: boolean): integer <forwarddecl> end

-- Primary with postfix ++/--. Sets `lv` to the variable name when the
-- primary is a plain variable (so assignment can target it).
local function parse_primary(a: *A, active: boolean, lv: *string): integer
  $lv = ''
  if a.tk == 1 then
    local v = a.num
    lex(a)
    return v
  elseif a.tk == 2 then
    local name = a.name
    lex(a)
    if is_op(a, '++') or is_op(a, '--') then
      local v = var_value(a, name)
      if active then assign(name, is_op(a, '++') and wrap_add(v, 1) or wrap_sub(v, 1)) end
      lex(a)
      return v
    end
    $lv = name
    if active then return var_value(a, name) end
    return 0
  elseif is_op(a, '(') then
    lex(a)
    local v = parse_comma(a, active)
    if not is_op(a, ')') then fail(a, "expecting ')'"); return 0 end
    lex(a)
    return v
  end
  fail(a, 'expecting primary')
  return 0
end

local function parse_unary(a: *A, active: boolean, lv: *string): integer
  if a.tk == 3 then
    local tmp: string
    if a.op == '-' then lex(a); local v = parse_unary(a, active, &tmp); $lv = ''; return wrap_sub(0, v) end
    if a.op == '+' then lex(a); local v = parse_unary(a, active, &tmp); $lv = ''; return v end
    if a.op == '!' then lex(a); local v = parse_unary(a, active, &tmp); $lv = ''; return v == 0 and 1 or 0 end
    if a.op == '~' then lex(a); local v = parse_unary(a, active, &tmp); $lv = ''; return ~v end
    if a.op == '++' or a.op == '--' then
      local inc = a.op == '++'
      lex(a)
      if a.tk ~= 2 then fail(a, 'expecting primary'); return 0 end
      local name = a.name
      lex(a)
      local v = var_value(a, name)
      v = inc and wrap_add(v, 1) or wrap_sub(v, 1)
      if active then assign(name, v) end
      $lv = ''
      return v
    end
  end
  return parse_primary(a, active, lv)
end

-- Binary operators by precedence climbing; `lv` survives only for a lone primary.
local function parse_binary(a: *A, minprec: integer, active: boolean, lv: *string): integer
  local left = parse_unary(a, active, lv)
  while a.tk == 3 do
    local op = a.op
    local p = prec(op)
    if p == 0 or p < minprec then break end
    $lv = ''
    lex(a)
    if op == '&&' then
      local keep = left ~= 0
      local right = parse_binary(a, p + 1, active and keep, lv)
      left = (keep and right ~= 0) and 1 or 0
    elseif op == '||' then
      local keep = left == 0
      local right = parse_binary(a, p + 1, active and keep, lv)
      left = (not keep or right ~= 0) and 1 or 0
    else
      local right = parse_binary(a, p + 1, active, lv)
      left = binop(a, op, left, right, active)
    end
    $lv = ''
  end
  return left
end

local function parse_cond(a: *A, active: boolean, lv: *string): integer
  local c = parse_binary(a, 1, active, lv)
  if is_op(a, '?') then
    $lv = ''
    lex(a)
    local t = parse_assign(a, active and c ~= 0)
    if not is_op(a, ':') then fail(a, "expecting ':'"); return 0 end
    lex(a)
    local f = parse_assign(a, active and c == 0)
    return c ~= 0 and t or f
  end
  return c
end

function parse_assign(a: *A, active: boolean): integer
  local lv: string
  local v = parse_cond(a, active, &lv)
  if a.tk == 3 and a.op.size >= 1 and a.op:byte(a.op.size) == #[B'=']# and a.op ~= '==' and a.op ~= '!=' and a.op ~= '<=' and a.op ~= '>=' then
    if lv.size == 0 then fail(a, 'expecting primary'); return 0 end
    local op = a.op
    lex(a)
    local rhs = parse_assign(a, active)
    if op ~= '=' then
      v = binop(a, op:sub(1, op.size - 1), v, rhs, active)
    else
      v = rhs
    end
    if active then assign(lv, v) end
    return v
  end
  return v
end

function parse_comma(a: *A, active: boolean): integer
  local v = parse_assign(a, active)
  while is_op(a, ',') do
    lex(a)
    v = parse_assign(a, active)
  end
  return v
end

-- Evaluate; returns (value, error message). The message is empty on success.
function sharith.eval(expr: string): (integer, string)
  local a: A
  a.src = expr
  a.pos = 0
  a.err = ''
  lex(&a)
  if a.tk == 0 and a.err.size == 0 then
    return 0, ''
  end
  local v = parse_comma(&a, true)
  if a.err.size == 0 and a.tk ~= 0 then fail(&a, 'expecting EOF') end
  if a.err.size > 0 then
    return 0, 'arithmetic expression: ' .. a.err .. ': "' .. expr .. '"'
  end
  return v, ''
end
