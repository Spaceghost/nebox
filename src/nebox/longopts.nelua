-- GNU coreutils 9.1 long options for the applets that parse with util.parsel,
-- generated from coreutils' long_options tables. Names nebox does not
-- implement map to util.UNSUPPORTED, so abbreviations resolve as in GNU and
-- the option is refused by name.
## pragmas.nogc = true

require 'nebox.util'

global longopts = @record{}

global longopts.cat: []util.LongOpt = {
  {'number-nonblank', 0, 98}, {'number', 0, 110}, {'squeeze-blank', 0, 115},
  {'show-nonprinting', 0, 118}, {'show-ends', 0, 69}, {'show-tabs', 0, 84}, {'show-all', 0, 65},
  {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
}
global longopts.mkdir: []util.LongOpt = {
  {'mode', 1, 109}, {'parents', 0, 112}, {'verbose', 0, 118}, {'help', 0, util.UNSUPPORTED},
  {'version', 0, util.UNSUPPORTED},
}
global longopts.basename: []util.LongOpt = {
  {'multiple', 0, 97}, {'suffix', 1, 115}, {'zero', 0, 122}, {'help', 0, util.UNSUPPORTED},
  {'version', 0, util.UNSUPPORTED},
}
global longopts.dirname: []util.LongOpt = {
  {'zero', 0, 122}, {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
}
global longopts.fold: []util.LongOpt = {
  {'bytes', 0, 98}, {'spaces', 0, 115}, {'width', 1, 119}, {'help', 0, util.UNSUPPORTED},
  {'version', 0, util.UNSUPPORTED},
}
global longopts.uname: []util.LongOpt = {
  {'all', 0, 97}, {'kernel-name', 0, 115}, {'sysname', 0, 115}, {'nodename', 0, 110},
  {'kernel-release', 0, 114}, {'release', 0, 114}, {'kernel-version', 0, 118}, {'machine', 0, 109},
  {'processor', 0, 112}, {'hardware-platform', 0, 105}, {'operating-system', 0, 111},
  {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
}
global longopts.rmdir: []util.LongOpt = {
  {'ignore-fail-on-non-empty', 0, 201}, {'path', 0, 112}, {'parents', 0, 112}, {'verbose', 0, 118},
  {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
}
global longopts.tty: []util.LongOpt = {
  {'silent', 0, 115}, {'quiet', 0, 115}, {'help', 0, util.UNSUPPORTED},
  {'version', 0, util.UNSUPPORTED},
}
global longopts.pwd: []util.LongOpt = {
  {'logical', 0, 76}, {'physical', 0, 80}, {'help', 0, util.UNSUPPORTED},
  {'version', 0, util.UNSUPPORTED},
}
