  {'number-nonblank', 0, 98}, {'number', 0, 110}, {'squeeze-blank', 0, 115},
  {'show-nonprinting', 0, 118}, {'show-ends', 0, 69}, {'show-tabs', 0, 84}, {'show-all', 0, 65},
  {'help', 0, util.UNSUPPORTED}, {'version', 0, util.UNSUPPORTED},
}
