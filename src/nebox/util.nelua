-- Shared helpers: buffered stdout, diagnostics, option parsing, file I/O,
-- path and line utilities. Applets never touch stdio; everything is fd I/O.
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'stringbuilder'
require 'nebox.sys'

global util = @record{}

-- The applet name currently running, for diagnostics.
global util.applet: string = 'nebox'

-- Buffered output on fd 1.
local OUTCAP: usize <comptime> = 65536
local outbuf: [OUTCAP]byte
local outlen: usize = 0
local outfd: cint = 1

local function write_all(fd: cint, p: *[0]byte, n: usize): boolean
  local done: usize = 0
  while done < n do
    local r = sys.write(fd, &p[done], n - done)
    if r < 0 then
      if sys.errno() == sys.EINTR then continue end
      return false
    end
    done = done + (@usize)(r)
  end
  return true
end

function util.flush(): boolean
  if outlen == 0 then return true end
  local ok = write_all(outfd, &outbuf[0], outlen)
  outlen = 0
  return ok
end

function util.setout(fd: cint)
  util.flush()
  outfd = fd
end

function util.writebytes(p: *[0]byte, n: usize)
  if n >= OUTCAP then
    util.flush()
    write_all(outfd, p, n)
    return
  end
  if outlen + n > OUTCAP then util.flush() end
  for i: usize = 0, < n do outbuf[outlen + i] = p[i] end
  outlen = outlen + n
end

function util.write(s: string)
  util.writebytes(s.data, s.size)
end

function util.writebyte(b: byte)
  if outlen >= OUTCAP then util.flush() end
  outbuf[outlen] = b
  outlen = outlen + 1
end

function util.line(s: string)
  util.write(s)
  util.writebyte(10)
end

function util.writef(fmt: string, ...: varargs)
  util.write(string.format(fmt, ...))
end

-- Diagnostics go straight to fd 2, after stdout is flushed so ordering is sane.
function util.err(s: string)
  util.flush()
  local msg = util.applet .. ': ' .. s .. '\n'
  write_all(2, msg.data, msg.size)
end

function util.errf(fmt: string, ...: varargs)
  util.err(string.format(fmt, ...))
end

-- "name: strerror" style message for a failed call on `path`.
function util.perror(path: string)
  util.err(path .. ': ' .. sys.errstr())
end

function util.die(s: string): integer
  util.err(s)
  return 1
end

-- GNU quotearg's shell-escape styles in the C locale, as coreutils prints
-- file names in diagnostics: quoteaf (always quoted) and quotef (quoted only
-- when needed; a ':' also needs it). Bytes outside printable ASCII become
-- $'\ooo' pieces; a name with a single quote and no other trouble is
-- double-quoted.
local function shell_escape(s: string, always: boolean, colon: boolean): string
  local need = always or s.size == 0
  local ctrl, squote, dq_bad = false, false, false
  for i = 1, s.size do
    local c = s:byte(i)
    if c < 32 or c >= 127 then ctrl = true; need = true
    elseif c == 39 then squote = true; need = true
    elseif c == 32 or c == 33 or c == 34 or c == 36 or c == 38 or c == 40 or c == 41 or c == 42
        or c == 59 or c == 60 or c == 61 or c == 62 or c == 63 or c == 91 or c == 92 or c == 94
        or c == 96 or c == 124 then need = true
    elseif (c == 35 or c == 126) and i == 1 then need = true
    elseif c == 58 and colon then need = true end
    if c == 34 or c == 36 or c == 92 or c == 96 then dq_bad = true end
  end
  if not need then return s end
  local sb: stringbuilder
  if squote and not ctrl and not dq_bad then
    sb:write('"', s, '"')
    return sb:promote()
  end
  local inq = false   -- inside '...'
  local indollar = false
  sb:write("'"); inq = true
  for i = 1, s.size do
    local c = s:byte(i)
    if c < 32 or c >= 127 then
      if not indollar then
        if inq then sb:write("'"); inq = false end
        sb:write("$'"); indollar = true
      end
      if c == 7 then sb:write('\\a') elseif c == 8 then sb:write('\\b')
      elseif c == 9 then sb:write('\\t') elseif c == 10 then sb:write('\\n')
      elseif c == 11 then sb:write('\\v') elseif c == 12 then sb:write('\\f')
      elseif c == 13 then sb:write('\\r')
      else sb:writef('\\%03o', c) end
    else
      if indollar then sb:write("'"); indollar = false end
      if not inq then sb:write("'"); inq = true end
      if c == 39 then sb:write("'\\''") else sb:writebyte(c) end
    end
  end
  if inq or indollar then sb:write("'") end
  return sb:promote()
end

-- gnulib quote() in the C locale (locale_quoting_style): '...' with C escapes.
function util.quote(s: string): string
  local sb: stringbuilder
  sb:writebyte(39)
  for i = 1, #s do
    local c = s:byte(i)
    if c == 92 then sb:write('\\\\')
    elseif c == 39 then sb:write("\\'")
    elseif c == 7 then sb:write('\\a') elseif c == 8 then sb:write('\\b')
    elseif c == 12 then sb:write('\\f') elseif c == 10 then sb:write('\\n')
    elseif c == 13 then sb:write('\\r') elseif c == 9 then sb:write('\\t')
    elseif c == 11 then sb:write('\\v')
    elseif c < 32 or c > 126 then sb:writef('\\%03o', c)
    else sb:writebyte(c) end
  end
  sb:writebyte(39)
  return sb:promote()
end

function util.quoteaf(s: string): string return shell_escape(s, true, false) end
function util.quotef(s: string): string return shell_escape(s, false, true) end

-- GNU getopt_long, as glibc implements it: clustered short options, "x:"
-- required and "x::" optional arguments, long options with unique-prefix
-- abbreviation, "--name=value", and the three orderings (a leading '+' or
-- POSIXLY_CORRECT stops at the first operand; a leading '-' returns
-- operands in place as code 1; otherwise operands are set aside and
-- `operands()` returns them after the options). Errors are reported with
-- glibc's wording and returned as '?' (63).
global util.LongOpt = @record{name: string, has_arg: integer, val: integer}

global util.Getopt = @record{
  args: sequence(string),
  optind: integer,
  nextchar: string,
  optarg: string,
  has_optarg: boolean,
  shortopts: string,
  longopts: *[0]util.LongOpt,
  nlong: integer,
  mode: integer,       -- 0 permute, 1 require order, 2 return in order
  skipped: sequence(string),
  arg_index: integer,  -- index in args of the element the last option came from
  quiet: boolean,      -- keep errors in errmsg instead of printing them
  errmsg: string,
  longname: string,    -- the long option last matched
  was_long: boolean,   -- whether the last option returned was a long one
}

function util.getopt(args: sequence(string), shortopts: string, longopts: *[0]util.LongOpt, nlong: integer): util.Getopt
  local g: util.Getopt
  for i = 1, #args do g.args:push(args[i]) end
  g.optind = 1
  g.longopts = longopts
  g.nlong = nlong
  g.mode = 0
  local s = shortopts
  if #s > 0 and s:byte(1) == 45 then g.mode = 2; s = s:sub(2)
  elseif #s > 0 and s:byte(1) == 43 then g.mode = 1; s = s:sub(2)
  elseif sys.getenv('POSIXLY_CORRECT') ~= nilptr then g.mode = 1 end
  g.shortopts = s
  return g
end

-- The operands left after the last option.
function util.Getopt:operands(): sequence(string)
  local out: sequence(string)
  for i = 1, #self.skipped do out:push(self.skipped[i]) end
  for i = self.optind, #self.args do out:push(self.args[i]) end
  return out
end

local function getopt_err(g: *util.Getopt, s: string): integer
  if g.quiet then g.errmsg = s else util.err(s) end
  return 63
end

function util.Getopt:next(): integer
  self.was_long = false
  self.optarg = ''
  self.has_optarg = false
  if #self.nextchar == 0 then
    local a: string
    while true do
      if self.optind > #self.args then return -1 end
      a = self.args[self.optind]
      if a == '--' then
        self.optind = self.optind + 1
        -- everything after "--" is an operand, after any set aside
        return -1
      end
      if #a < 2 or a:byte(1) ~= 45 then
        if self.mode == 2 then
          self.optind = self.optind + 1
          self.optarg = a; self.has_optarg = true
          return 1
        elseif self.mode == 1 then
          return -1
        end
        self.skipped:push(a)
        self.optind = self.optind + 1
      else
        break
      end
    end
    self.arg_index = self.optind
    if a:byte(2) == 45 and self.nlong > 0 then
      self.optind = self.optind + 1
      local body = a:sub(3)
      local eq = body:find('=', 1, true)
      local name = eq > 0 and body:sub(1, eq - 1) or body
      local found = -1
      local exact = false
      local ambig = false
      -- glibc: an exact match wins; otherwise a prefix is ambiguous when a
      -- later match differs from the first in has_arg or val, and only the
      -- first match and the differing ones are listed
      local marked: [256]boolean
      for i = 0, < self.nlong do
        local ln = self.longopts[i].name
        if ln == name then found = i; exact = true; break end
      end
      if not exact then
        for i = 0, < self.nlong do
          local ln = self.longopts[i].name
          if #name <= #ln and ln:sub(1, #name) == name then
            if found < 0 then found = i
            elseif self.longopts[found].has_arg ~= self.longopts[i].has_arg
                   or self.longopts[found].val ~= self.longopts[i].val then
              ambig = true
              if i < 256 then marked[i] = true end
              if found < 256 then marked[found] = true end
            end
          end
        end
      end
      if ambig and not exact then
        local sb: stringbuilder
        sb:write("option '", a, "' is ambiguous; possibilities:")
        for i = 0, < self.nlong do
          if i < 256 and marked[i] then sb:write(" '--", self.longopts[i].name, "'") end
        end
        return getopt_err(self, sb:promote())
      end
      if found < 0 then return getopt_err(self, "unrecognized option '" .. a .. "'") end
      local o = self.longopts[found]
      self.longname = o.name
      self.was_long = true
      if eq > 0 then
        if o.has_arg == 0 then return getopt_err(self, "option '--" .. o.name .. "' doesn't allow an argument") end
        self.optarg = body:sub(eq + 1); self.has_optarg = true
      elseif o.has_arg == 1 then
        if self.optind > #self.args then return getopt_err(self, "option '--" .. o.name .. "' requires an argument") end
        self.optarg = self.args[self.optind]; self.has_optarg = true
        self.optind = self.optind + 1
      end
      return o.val
    end
    self.nextchar = a:sub(2)
    self.optind = self.optind + 1
  end
  local c = self.nextchar:byte(1)
  self.nextchar = self.nextchar:sub(2)
  local pos = c ~= 58 and self.shortopts:find(string.char(c), 1, true) or 0
  if pos <= 0 then
    return getopt_err(self, "invalid option -- '" .. string.char(c) .. "'")
  end
  if pos < #self.shortopts and self.shortopts:byte(pos + 1) == 58 then
    local optional = pos + 1 < #self.shortopts and self.shortopts:byte(pos + 2) == 58
    if #self.nextchar > 0 then
      self.optarg = self.nextchar; self.has_optarg = true
      self.nextchar = ''
    elseif not optional then
      if self.optind > #self.args then
        return getopt_err(self, "option requires an argument -- '" .. string.char(c) .. "'")
      end
      self.optarg = self.args[self.optind]; self.has_optarg = true
      self.optind = self.optind + 1
    end
  end
  return c
end

function util.hexval(c: byte): integer
  if c >= 48 and c <= 57 then return c - 48 end
  if c >= 97 and c <= 102 then return c - 87 end
  if c >= 65 and c <= 70 then return c - 55 end
  return -1
end

-- gnulib xstrtoumax: 0 LONGINT_OK, 1 LONGINT_OVERFLOW (value saturated),
-- 2 LONGINT_INVALID (no number, or a '-'), 3 LONGINT_INVALID_SUFFIX_CHAR
-- (with or without overflow). BASE is 10 or 0 (strtoumax's 0x/0 prefixes).
-- Suffixes: b=512, B=1024, c=1, w=2, k/K M/m G/g T/t P E Z Y in powers of
-- 1024, or of 1000 with a trailing B/D, or 1024 with iB, when SUFFIXES has '0'.
function util.xstrtoumax_base(s: string, base: integer, suffixes: string): (integer, uint64)
  local UMAX: uint64 = 0xffffffffffffffff
  local p = 1
  while p <= #s and (s:byte(p) == 32 or (s:byte(p) >= 9 and s:byte(p) <= 13)) do p = p + 1 end
  if p <= #s and s:byte(p) == 45 then return 2, 0 end
  if p <= #s and s:byte(p) == 43 then p = p + 1 end
  local b: uint64 = 10
  if base == 0 then
    if p + 1 <= #s and s:byte(p) == 48 and (s:byte(p + 1) == 120 or s:byte(p + 1) == 88)
        and p + 2 <= #s and util.hexval(s:byte(p + 2)) >= 0 then
      b = 16; p = p + 2
    elseif p <= #s and s:byte(p) == 48 then
      b = 8
    end
  end
  local start = p
  local v: uint64 = 0
  local ovf = false
  while p <= #s do
    local dv = util.hexval(s:byte(p))
    if dv < 0 or (@uint64)(dv) >= b then break end
    local d: uint64 = (@uint64)(dv)
    if ovf or v > (UMAX - d) // b then ovf = true; v = UMAX else v = v * b + d end
    p = p + 1
  end
  local function valid(c: byte): boolean
    return c ~= 0 and c ~= 48 and suffixes:find(string.char(c), 1, true) > 0
  end
  if p == start then
    local c: byte = p <= #s and s:byte(p) or 0
    if valid(c) then v = 1 else return 2, 0 end
  end
  if p <= #s then
    local c = s:byte(p)
    if not valid(c) then return 3, v end
    local base: uint64 = 1024
    local nsuf = 1
    local power = 0
    if suffixes:find('0', 1, true) > 0 and ('EGgkKMmPTtYZ'):find(string.char(c), 1, true) > 0 then
      local c1: byte = p + 1 <= #s and s:byte(p + 1) or 0
      if c1 == 105 and p + 2 <= #s and s:byte(p + 2) == 66 then nsuf = 3
      elseif c1 == 66 or c1 == 68 then base = 1000; nsuf = 2 end
    end
    local mul: uint64 = 1
    if c == 98 then mul = 512
    elseif c == 66 then mul = 1024
    elseif c == 99 then mul = 1
    elseif c == 119 then mul = 2
    else
      if c == 107 or c == 75 then power = 1 elseif c == 109 or c == 77 then power = 2
      elseif c == 71 or c == 103 then power = 3 elseif c == 84 or c == 116 then power = 4
      elseif c == 80 then power = 5 elseif c == 69 then power = 6 elseif c == 90 then power = 7
      elseif c == 89 then power = 8 else return 3, v end
      mul = 0
    end
    if mul ~= 0 then
      if v > UMAX // mul then ovf = true; v = UMAX else v = v * mul end
    else
      for _ = 1, power do
        if v ~= 0 and v > UMAX // base then ovf = true; v = UMAX else v = v * base end
      end
    end
    p = p + nsuf
    if p <= #s then return 3, v end
  end
  return ovf and 1 or 0, v
end

function util.xstrtoumax(s: string, suffixes: string): (integer, uint64)
  return util.xstrtoumax_base(s, 10, suffixes)
end

-- gnulib xstrtol_fatal's message for status ST (2 or more, or 1) of the
-- argument ARG to option OPT ("-B" or "--block-size").
function util.xstrtol_msg(st: integer, opt: string, arg: string): string
  if st == 1 then return opt .. " argument '" .. arg .. "' too large" end
  if st == 3 then return 'invalid suffix in ' .. opt .. " argument '" .. arg .. "'" end
  return 'invalid ' .. opt .. " argument '" .. arg .. "'"
end

-- gnulib xdectoumax: util.xstrtoumax within [MIN, MAX]. On failure it
-- returns false and GNU's message "MSG: 'S'[: strerror]".
function util.xdectoumax(s: string, min: uint64, max: uint64, suffixes: string, msg: string): (boolean, uint64, string)
  local st, v = util.xstrtoumax(s, suffixes)
  local function fail(t: string): (boolean, uint64, string) return false, 0, msg .. ': ' .. util.quote(s) .. t end
  if st >= 2 then return fail('') end
  if st == 1 then return fail(': Value too large for defined data type') end
  if v < min or v > max then
    return fail(v > 0x3fffffff and ': Value too large for defined data type' or ': Numerical result out of range')
  end
  return true, v, ''
end

-- gnulib XARGMATCH: an exact or unambiguous-prefix match of ARG among
-- NAMES (synonyms share a value in VALUES). On failure it reports GNU's
-- "invalid/ambiguous argument" lines and returns -1; the caller then prints
-- its usage hint.
function util.argmatch(context: string, arg: string, names: *[0]string, values: *[0]integer, n: integer): integer
  local found = -1
  local ambiguous = false
  for k = 0, < n do
    if names[k] == arg then return values[k] end
    if #arg <= #names[k] and names[k]:sub(1, #arg) == arg then
      if found < 0 then found = k
      elseif values[found] ~= values[k] then ambiguous = true end
    end
  end
  if found >= 0 and not ambiguous then return values[found] end
  util.err((ambiguous and 'ambiguous' or 'invalid') .. ' argument ' .. util.quote(arg) .. " for '" .. context .. "'")
  util.flush()
  local sb: stringbuilder
  sb:write('Valid arguments are:')
  for k = 0, < n do
    if k > 0 and values[k] == values[k - 1] then sb:write(", '", names[k], "'")
    else sb:write("\n  - '", names[k], "'") end
  end
  sb:write('\n')
  local m = sb:promote()
  sys.write(2, m.data, m.size)
  return -1
end

-- Option parsing: short flags only, POSIX style. `spec` lists the accepted
-- letters; a letter followed by ':' takes a value. Parsing stops at the first
-- operand, at "--", or at "-" (which is an operand).
global util.Opts = @record{
  set: [256]boolean,
  value: [256]string,
  operands: sequence(string),
  bad: string,  -- unknown option letter, or "" if none
  missing: string, -- option that lacked its value, or ""
  keys: sequence(byte),    -- every value-taking option seen, in order
  vals: sequence(string),  -- and its value
  order: sequence(byte),   -- every option seen, in order (for "the last one wins")
}

-- Every value given for a repeatable option such as grep -e.
function util.Opts:all(c: string): sequence(string)
  local out: sequence(string)
  local k = c:byte(1)
  for i = 1, #self.keys do
    if self.keys[i] == k then out:push(self.vals[i]) end
  end
  return out
end

function util.Opts:has(c: string): boolean
  return self.set[c:byte(1)]
end

function util.Opts:get(c: string): string
  return self.value[c:byte(1)]
end

function util.Opts:ok(): boolean
  return self.bad.size == 0 and self.missing.size == 0
end

local function spec_find(spec: string, c: byte): (boolean, boolean)
  for i: usize = 1, spec.size do
    if spec:byte(i) == c then
      local takes = i < spec.size and spec:byte(i + 1) == 58
      return true, takes
    end
  end
  return false, false
end

-- A long option GNU has and nebox does not implement maps to this code, so
-- abbreviations resolve exactly as in GNU and the option is refused by name.
global util.UNSUPPORTED: integer <comptime> = 255

-- GNU-style parsing through util.getopt: options may follow operands unless
-- the spec starts with '+' or POSIXLY_CORRECT is set; long options map to a
-- short letter or to a code of 128 and up.
function util.parsel(args: sequence(string), spec: string, longs: *[0]util.LongOpt, nlong: integer): util.Opts
  local o: util.Opts
  local g = util.getopt(args, spec, longs, nlong)
  g.quiet = true
  while true do
    local c = g:next()
    if c == -1 then break end
    if c == 63 and #g.errmsg > 0 then o.bad = g.errmsg; return o end
    if c == util.UNSUPPORTED then
      o.bad = "option '--" .. g.longname .. "' is not supported"
      return o
    end
    if c < 0 or c > 255 then continue end
    o.set[c] = true
    o.order:push((@byte)(c))
    if g.has_optarg then
      o.value[c] = g.optarg
      o.keys:push((@byte)(c)); o.vals:push(g.optarg)
    end
  end
  o.operands = g:operands()
  return o
end

function util.parse(args: sequence(string), spec: string): util.Opts
  return util.parsel(args, spec, nilptr, 0)
end

function util.optfail(o: util.Opts): integer
  if o.bad.size > 0 then return util.die(o.bad) end
  return util.die("option requires an argument -- '" .. o.missing .. "'")
end

-- Read a whole file descriptor into a string.
function util.readfd(fd: cint): (string, boolean)
  local sb: stringbuilder
  local chunk: [65536]byte
  while true do
    local r = sys.read(fd, &chunk[0], #chunk)
    if r < 0 then
      if sys.errno() == sys.EINTR then continue end
      return sb:promote(), false
    end
    if r == 0 then break end
    sb:write((@string){data=&chunk[0], size=(@usize)(r)})
  end
  return sb:promote(), true
end

-- Open an input operand; "-" is stdin. Returns fd or -1 (after reporting).
function util.openin(path: string): cint
  if path == '-' then return 0 end
  local fd = sys.open(path, sys.O_RDONLY, 0)
  if fd < 0 then util.perror(path) end
  return fd
end

function util.readfile(path: string): (string, boolean)
  local fd = util.openin(path)
  if fd < 0 then return '', false end
  local data, ok = util.readfd(fd)
  if not ok then util.perror(path) end
  if fd ~= 0 then sys.close(fd) end
  return data, ok
end

-- Stream an fd to stdout; returns false on read error.
function util.copyfd(fd: cint): boolean
  local chunk: [65536]byte
  while true do
    local r = sys.read(fd, &chunk[0], #chunk)
    if r < 0 then
      if sys.errno() == sys.EINTR then continue end
      return false
    end
    if r == 0 then return true end
    util.writebytes(&chunk[0], (@usize)(r))
  end
  return true
end

-- Split data into lines (views, no copies). A trailing newline does not
-- produce an empty final line.
function util.lines(data: string): sequence(string)
  local out: sequence(string)
  local start: usize = 0
  for i: usize = 0, < data.size do
    if data.data[i] == 10 then
      out:push((@string){data=&data.data[start], size=i - start})
      start = i + 1
    end
  end
  if start < data.size then
    out:push((@string){data=&data.data[start], size=data.size - start})
  end
  return out
end

-- Path helpers matching basename(1)/dirname(1).
function util.basename(path: string): string
  if path.size == 0 then return '' end
  local e: isize = (@isize)(path.size)
  while e > 1 and path:byte(e) == 47 do e = e - 1 end
  if e == 1 and path:byte(1) == 47 then return '/' end
  local s: isize = e
  while s > 1 and path:byte(s - 1) ~= 47 do s = s - 1 end
  return path:sub(s, e)
end

function util.dirname(path: string): string
  if path.size == 0 then return '.' end
  local e: isize = (@isize)(path.size)
  while e > 1 and path:byte(e) == 47 do e = e - 1 end
  while e > 0 and path:byte(e) ~= 47 do e = e - 1 end
  while e > 1 and path:byte(e) == 47 do e = e - 1 end
  if e == 0 then return '.' end
  return path:sub(1, e)
end

function util.join(dir: string, name: string): string
  if dir.size > 0 and dir:byte(dir.size) == 47 then return dir .. name end
  return dir .. '/' .. name
end

-- Parse a decimal integer operand, with optional leading '-'/'+'.
function util.toint(s: string): (integer, boolean)
  if s.size == 0 then return 0, false end
  local i: usize = 1
  local neg = false
  local c = s:byte(1)
  if c == 45 then neg = true; i = 2 elseif c == 43 then i = 2 end
  if i > s.size then return 0, false end
  local v: integer = 0
  while i <= s.size do
    c = s:byte(i)
    if c < 48 or c > 57 then return 0, false end
    v = v * 10 + (c - 48)
    i = i + 1
  end
  if neg then v = -v end
  return v, true
end

-- Integer with an optional size suffix (k, M, G, b) as head/tail accept.
function util.tosize(s: string): (integer, boolean)
  if s.size == 0 then return 0, false end
  local last = s:byte(s.size)
  local mult: integer = 1
  local body = s
  if last == 107 or last == 75 then mult = 1024; body = s:sub(1, -2)
  elseif last == 77 or last == 109 then mult = 1024 * 1024; body = s:sub(1, -2)
  elseif last == 71 or last == 103 then mult = 1024 * 1024 * 1024; body = s:sub(1, -2)
  elseif last == 98 then mult = 512; body = s:sub(1, -2) end
  local v, ok = util.toint(body)
  return v * mult, ok
end

function util.isdir(path: string): boolean
  local st: sys.Stat
  if sys.stat(path, &st) ~= 0 then return false end
  return (st.st_mode & sys.S_IFMT) == sys.S_IFDIR
end

function util.exists(path: string): boolean
  local st: sys.Stat
  return sys.lstat(path, &st) == 0
end

-- Stable merge sort on a sequence of strings with a less-than callback.
function util.sort(items: sequence(string), less: function(string, string): boolean)
  local n = #items
  if n < 2 then return end
  local tmp: sequence(string)
  tmp:resize((@usize)(n))
  local width: integer = 1
  while width < n do
    local i: integer = 1
    while i <= n do
      local mid = i + width
      local hi = i + 2 * width
      if mid > n + 1 then mid = n + 1 end
      if hi > n + 1 then hi = n + 1 end
      local a, b, k = i, mid, i
      while a < mid and b < hi do
        if less(items[b], items[a]) then tmp[k] = items[b]; b = b + 1
        else tmp[k] = items[a]; a = a + 1 end
        k = k + 1
      end
      while a < mid do tmp[k] = items[a]; a = a + 1; k = k + 1 end
      while b < hi do tmp[k] = items[b]; b = b + 1; k = k + 1 end
      i = hi
    end
    for j: integer = 1, n do items[j] = tmp[j] end
    width = width * 2
  end
  tmp:destroy()
end

-- Mode bits as ls -l shows them.
function util.modestr(mode: cuint): string
  local t: string = '-'
  local f = mode & sys.S_IFMT
  if f == sys.S_IFDIR then t = 'd'
  elseif f == sys.S_IFLNK then t = 'l'
  elseif f == sys.S_IFCHR then t = 'c'
  elseif f == sys.S_IFBLK then t = 'b'
  elseif f == sys.S_IFIFO then t = 'p'
  elseif f == sys.S_IFSOCK then t = 's' end
  local bits: [9]byte = {114, 119, 120, 114, 119, 120, 114, 119, 120}
  local out: [10]byte
  out[0] = t:byte(1)
  for i: integer = 0, 8 do
    local set = (mode >> (@cuint)(8 - i)) & 1 == 1
    out[i + 1] = set and bits[i] or 45
  end
  if mode & 0x800 ~= 0 then out[3] = (out[3] == 120) and 115 or 83 end
  if mode & 0x400 ~= 0 then out[6] = (out[6] == 120) and 115 or 83 end
  if mode & 0x200 ~= 0 then out[9] = (out[9] == 120) and 116 or 84 end
  return string.copy((@string){data=&out[0], size=10})
end

-- Expand backslash escapes as echo -e / printf do. Returns the string and
-- whether a \c (stop output) was seen.
function util.unescape(s: string): (string, boolean)
  local sb: stringbuilder
  local i: usize = 1
  while i <= s.size do
    local c = s:byte(i)
    if c == 92 and i < s.size then
      i = i + 1
      local e = s:byte(i)
      if e == 110 then sb:writebyte(10)
      elseif e == 116 then sb:writebyte(9)
      elseif e == 114 then sb:writebyte(13)
      elseif e == 97 then sb:writebyte(7)
      elseif e == 98 then sb:writebyte(8)
      elseif e == 102 then sb:writebyte(12)
      elseif e == 118 then sb:writebyte(11)
      elseif e == 101 then sb:writebyte(27)
      elseif e == 92 then sb:writebyte(92)
      elseif e == 99 then return sb:promote(), true
      elseif e == 48 or (e >= 49 and e <= 55) then
        -- \0NNN or \NNN octal
        local v: integer = 0
        local digits: integer = 0
        if e == 48 then i = i + 1 end
        while digits < 3 and i <= s.size do
          local d = s:byte(i)
          if d < 48 or d > 55 then break end
          v = v * 8 + (d - 48)
          i = i + 1
          digits = digits + 1
        end
        sb:writebyte((@byte)(v & 0xff))
        continue
      elseif e == 120 then
        local v: integer = 0
        local digits: integer = 0
        i = i + 1
        while digits < 2 and i <= s.size do
          local d = s:byte(i)
          local dv: integer = -1
          if d >= 48 and d <= 57 then dv = d - 48
          elseif d >= 97 and d <= 102 then dv = d - 87
          elseif d >= 65 and d <= 70 then dv = d - 55 end
          if dv < 0 then break end
          v = v * 16 + dv
          i = i + 1
          digits = digits + 1
        end
        if digits == 0 then sb:writebyte(92); sb:writebyte(120)
        else sb:writebyte((@byte)(v)) end
        continue
      else
        sb:writebyte(92); sb:writebyte(e)
      end
    else
      sb:writebyte(c)
    end
    i = i + 1
  end
  return sb:promote(), false
end

-- Name lookups from /etc/passwd and /etc/group (nelibc has no getpwuid).
-- Returns "" when the id is not listed.
local function lookup_name(file: string, id: integer): string
  local fd = sys.open(file, sys.O_RDONLY, 0)
  if fd < 0 then return '' end
  local data, ok = util.readfd(fd)
  sys.close(fd)
  if not ok then return '' end
  for _, line in ipairs(util.lines(data)) do
    -- name:x:id:...
    local c1 = line:find(':', 1, true)
    if c1 <= 0 then continue end
    local c2 = line:find(':', c1 + 1, true)
    if c2 <= 0 then continue end
    local c3 = line:find(':', c2 + 1, true)
    if c3 <= 0 then c3 = (@isize)(line.size) + 1 end
    local v, vok = util.toint(line:sub(c2 + 1, c3 - 1))
    if vok and v == id then return line:sub(1, c1 - 1) end
  end
  return ''
end

function util.username(uid: integer): string
  return lookup_name('/etc/passwd', uid)
end

function util.groupname(gid: integer): string
  return lookup_name('/etc/group', gid)
end

-- Name or the number when unknown.
function util.idname(name: string, id: integer): string
  if name.size > 0 then return name end
  return string.format('%d', id)
end

-- CPUs this process may run on, as nproc reports.
function util.cpucount(): integer
  local mask: [128]byte
  if sys.sched_getaffinity(0, 128, &mask[0]) ~= 0 then return 0 end
  local n: integer = 0
  for i: integer = 0, 127 do
    local b = mask[i]
    while b ~= 0 do n = n + (b & 1); b = b >> 1 end
  end
  return n
end

-- Reverse lookup: id for a user or group name, or -1 when absent.
local function lookup_id(file: string, name: string): integer
  local fd = sys.open(file, sys.O_RDONLY, 0)
  if fd < 0 then return -1 end
  local data, ok = util.readfd(fd)
  sys.close(fd)
  if not ok then return -1 end
  for _, line in ipairs(util.lines(data)) do
    local c1 = line:find(':', 1, true)
    if c1 <= 0 or line:sub(1, c1 - 1) ~= name then continue end
    local c2 = line:find(':', c1 + 1, true)
    if c2 <= 0 then continue end
    local c3 = line:find(':', c2 + 1, true)
    if c3 <= 0 then c3 = (@isize)(line.size) + 1 end
    local v, vok = util.toint(line:sub(c2 + 1, c3 - 1))
    if vok then return v end
  end
  return -1
end

function util.userid(name: string): integer return lookup_id('/etc/passwd', name) end
function util.groupid(name: string): integer return lookup_id('/etc/group', name) end

-- Write a number right-aligned in a field of the given width.
function util.padnum(v: integer, width: integer)
  local s = string.format('%d', v)
  for _ = (@integer)(s.size) + 1, width do util.writebyte(32) end
  util.write(s)
end

-- Size with a binary-unit suffix as du -h / ls -h print it (1024 base,
-- always one decimal below 10, rounded up).
function util.human(n: integer): string
  if n < 1024 then return string.format('%d', n) end
  local units: string = 'KMGTPE'
  local u: integer = 0
  local base: integer = 1024
  while n >= base * 1024 and u < 5 do base = base * 1024; u = u + 1 end
  local suffix = units:sub(u + 1, u + 1)
  local tenths = (n * 10 + base - 1) // base
  if tenths < 100 then return string.format('%d.%d%s', tenths // 10, tenths % 10, suffix) end
  return string.format('%d%s', (n + base - 1) // base, suffix)
end

-- Sorted directory entries; with `all`, dot entries (including . and ..) are kept.
function util.name_less(a: string, b: string): boolean
  return a < b
end

-- Directory entries in readdir order (what fts without a comparator sees).
function util.readnames_raw(dir: string): (sequence(string), boolean)
  local names: sequence(string)
  local d = sys.opendir(dir)
  if d == nilptr then return names, false end
  while true do
    local de = sys.readdir(d)
    if de == nilptr then break end
    names:push(string.copy(sys.cstr(&de.d_name)))
  end
  sys.closedir(d)
  return names, true
end

function util.readnames(dir: string, all: boolean): (sequence(string), boolean)
  local names: sequence(string)
  local d = sys.opendir(dir)
  if d == nilptr then return names, false end
  while true do
    local de = sys.readdir(d)
    if de == nilptr then break end
    local name = string.copy(sys.cstr(&de.d_name))
    if not all and name:byte(1) == 46 then continue end
    names:push(name)
  end
  sys.closedir(d)
  util.sort(names, util.name_less)
  return names, true
end

-- Shell-style glob match: * ? [set] [!set] and backslash escapes. `*` and
-- `?` match any byte including '/'. With `icase`, ASCII letters fold.
local function glob_at(pat: string, pi: usize, s: string, si: usize, icase: boolean): boolean
  while pi <= pat.size do
    local c = pat:byte(pi)
    if c == 42 then
      while pi <= pat.size and pat:byte(pi) == 42 do pi = pi + 1 end
      if pi > pat.size then return true end
      for k = si, s.size + 1 do
        if glob_at(pat, pi, s, k, icase) then return true end
      end
      return false
    end
    if si > s.size then return false end
    local b = s:byte(si)
    if c == 63 then
      pi = pi + 1; si = si + 1
    elseif c == 91 then
      local j = pi + 1
      local negate = false
      if j <= pat.size and (pat:byte(j) == 33 or pat:byte(j) == 94) then negate = true; j = j + 1 end
      local matched = false
      local first = true
      local closed = false
      while j <= pat.size do
        local d = pat:byte(j)
        if d == 93 and not first then closed = true; j = j + 1; break end
        first = false
        if d == 91 and j + 1 <= pat.size and pat:byte(j + 1) == 58 then
          local close = pat:find(':]', j + 2, true)
          if close > 0 then
            local name = pat:sub(j + 2, close - 1)
            local ok = false
            if name == 'alpha' then ok = (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
            elseif name == 'digit' then ok = b >= 48 and b <= 57
            elseif name == 'alnum' then ok = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57)
            elseif name == 'upper' then ok = b >= 65 and b <= 90
            elseif name == 'lower' then ok = b >= 97 and b <= 122
            elseif name == 'space' then ok = b == 32 or (b >= 9 and b <= 13)
            elseif name == 'punct' then ok = (b >= 33 and b <= 47) or (b >= 58 and b <= 64) or (b >= 91 and b <= 96) or (b >= 123 and b <= 126)
            end
            if ok then matched = true end
            j = (@usize)(close) + 2
            continue
          end
        end
        if d == 92 and j < pat.size then j = j + 1; d = pat:byte(j) end
        local lo, hi = d, d
        if j + 2 <= pat.size and pat:byte(j + 1) == 45 and pat:byte(j + 2) ~= 93 then
          hi = pat:byte(j + 2); j = j + 2
        end
        local bb = b
        if icase then
          if bb >= 65 and bb <= 90 then bb = bb + 32 end
          if lo >= 65 and lo <= 90 then lo = lo + 32 end
          if hi >= 65 and hi <= 90 then hi = hi + 32 end
        end
        if bb >= lo and bb <= hi then matched = true end
        j = j + 1
      end
      if not closed then
        -- unterminated bracket: literal '['
        if b ~= 91 then return false end
        pi = pi + 1; si = si + 1
      else
        if matched == negate then return false end
        pi = j; si = si + 1
      end
    else
      if c == 92 and pi < pat.size then pi = pi + 1; c = pat:byte(pi) end
      local bb = b
      if icase then
        if bb >= 65 and bb <= 90 then bb = bb + 32 end
        if c >= 65 and c <= 90 then c = c + 32 end
      end
      if bb ~= c then return false end
      pi = pi + 1; si = si + 1
    end
  end
  return si > s.size
end

function util.glob(pat: string, s: string, icase: boolean): boolean
  return glob_at(pat, 1, s, 1, icase)
end
