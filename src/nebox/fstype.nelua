-- Linux file system type names from GNU coreutils 9.1 stat.c human_fstype
-- (generated from its "case S_MAGIC_...: /* 0x... */" table).
## pragmas.nogc = true

require 'string'

global fstype = @record{}

function fstype.name(t: uint64): string
