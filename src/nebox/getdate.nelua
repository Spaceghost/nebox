-- parse-datetime: a port of gnulib's lib/parse-datetime.y as GNU coreutils
-- 9.1 builds it (parse_datetime2 with --debug output; struct tm with
-- tm_zone and tm_gmtoff). The bison grammar is a hand-written parser with
-- the same productions, the same shift preference in the grammar's 31
-- shift/reduce conflicts and bison's default reductions, so items are
-- reduced (and their --debug lines printed) and lookahead tokens read
-- (and "unknown word" reported) in the order the generated parser does
-- them. yylex, lookup_word and its tables (local zone abbreviations from
-- the current and the next three quarters' localtime, military zones, the
-- 19-character word buffer, the period-dropping retry), the TZ="..."
-- prefix, digits_to_date_time, time_zone_hhmm, to_hour, to_tm_year,
-- apply_relative_time and every intmax_t/int overflow check
-- (__builtin_*_overflow, as gnulib's intprops does it) are ported as
-- written, as are parse_datetime_body's steps and messages.
--
-- Time zones work as gnulib's time_rz does: a zone is a TZ value (or none,
-- for unset TZ) that localtime_rz/mktime_z switch the environment to and
-- back, with nelibc's localtime_r doing the conversion. mktime is a port of
-- the glibc/gnulib mktime.c that GNU date runs (__mktime_internal with its
-- process-wide offset guess, spring-forward gap handling and tm_isdst
-- search), so out-of-range fields, skipped and repeated wall times and a
-- requested DST flag resolve as they do in glibc.
## pragmas.nogc = true

require 'string'
require 'stringbuilder'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.clock'

##[==[
cemitdecl[[
#include <stdint.h>
#include <stdbool.h>
static inline bool nebox_pd_add(int64_t *r, int64_t a, int64_t b) { return __builtin_add_overflow(a, b, r); }
static inline bool nebox_pd_sub(int64_t *r, int64_t a, int64_t b) { return __builtin_sub_overflow(a, b, r); }
static inline bool nebox_pd_mul(int64_t *r, int64_t a, int64_t b) { return __builtin_mul_overflow(a, b, r); }
static inline bool nebox_pd_add32(int *r, int64_t a, int64_t b) { return __builtin_add_overflow(a, b, r); }
static inline bool nebox_pd_sub32(int *r, int64_t a, int64_t b) { return __builtin_sub_overflow(a, b, r); }
]]
]==]
local function ckd_add(r: *int64, a: int64, b: int64): boolean <cimport 'nebox_pd_add', nodecl> end
local function ckd_sub(r: *int64, a: int64, b: int64): boolean <cimport 'nebox_pd_sub', nodecl> end
local function ckd_mul(r: *int64, a: int64, b: int64): boolean <cimport 'nebox_pd_mul', nodecl> end
local function ckd_add32(r: *cint, a: int64, b: int64): boolean <cimport 'nebox_pd_add32', nodecl> end
local function ckd_sub32(r: *cint, a: int64, b: int64): boolean <cimport 'nebox_pd_sub32', nodecl> end
local function c_tzset() <cimport 'tzset', cinclude '<time.h>'> end

local EOVERFLOW: cint <comptime> = 75

local function b2i(b: boolean): int32
  if b then return 1 end
  return 0
end

----------------------------------------------------------------------------
-- time_rz: timezone_t as a TZ setting

global util.Tz = @record{set: boolean, name: string}

-- tzalloc: NAME nil means TZ unset.
function util.tzalloc(name: cstring): util.Tz
  local tz: util.Tz
  if name ~= nilptr then
    local s: string = name
    tz.set = true
    tz.name = string.copy(s)
  end
  return tz
end

local function change_env(set: boolean, name: string)
  if set then sys.setenv('TZ', name, 1) else sys.unsetenv('TZ') end
  c_tzset()
end

-- set_tz: switch to TZ unless it is already in effect; OLD gets the
-- previous setting. True when the environment changed.
local function set_tz(tz: *util.Tz, old: *util.Tz): boolean
  local env = sys.getenv('TZ')
  if env ~= nilptr then
    local es: string = env
    if tz.set and tz.name == es then return false end
    old.set = true
    old.name = string.copy(es)
  else
    if not tz.set then return false end
    old.set = false
    old.name = ''
  end
  change_env(tz.set, tz.name)
  return true
end

local function revert_tz(changed: boolean, old: *util.Tz)
  if not changed then return end
  change_env(old.set, old.name)
  if old.set then old.name:destroy() end
end

-- save_abbr: zone names outlive the TZ setting they came from
local zone_pool: sequence(string)
local function save_abbr(tm: *sys.Tm)
  if tm.tm_zone == nilptr then return end
  local z: string = tm.tm_zone
  for i = 1, #zone_pool do
    if zone_pool[i] == z then tm.tm_zone = (@cstring)(zone_pool[i].data); return end
  end
  local c = string.copy(z)
  zone_pool:push(c)
  tm.tm_zone = (@cstring)(c.data)
end

function util.localtime_rz(tz: *util.Tz, t: int64, tm: *sys.Tm): boolean
  local old: util.Tz
  local ch = set_tz(tz, &old)
  local tt: clong = t
  local ok = sys.localtime_r(&tt, tm) ~= nilptr
  if ok then save_abbr(tm) end
  revert_tz(ch, &old)
  return ok
end

----------------------------------------------------------------------------
-- mktime.c (__mktime_internal, as glibc 2.36 and gnulib have it)

local mon_yday: [2][13]int32 = {
  {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365},
  {0, 31, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335, 366},
}

local function leapyear(year: int64): boolean
  return (year & 3) == 0 and (year %%% 100 ~= 0 or ((year /// 100) & 3) == ((-19) & 3))
end

local function isdst_differ(a: int32, b: int32): boolean
  return ((a == 0) ~= (b == 0)) and 0 <= a and 0 <= b
end

local function ydhms_diff(year1: int64, yday1: int64, hour1: int32, min1: int32, sec1: int32,
    year0: int32, yday0: int32, hour0: int32, min0: int32, sec0: int32): int64
  local a4: int32 = (@int32)((year1 // 4) + 475 - b2i((year1 & 3) == 0))
  local b4: int32 = (@int32)((year0 // 4) + 475 - b2i((year0 & 3) == 0))
  local a100: int32 = (a4 + b2i(a4 < 0)) /// 25 - b2i(a4 < 0)
  local b100: int32 = (b4 + b2i(b4 < 0)) /// 25 - b2i(b4 < 0)
  local a400: int32 = a100 // 4
  local b400: int32 = b100 // 4
  local leaps: int32 = (a4 - b4) - (a100 - b100) + (a400 - b400)
  local years: int64 = year1 - year0
  local days: int64 = 365 * years + yday1 - yday0 + leaps
  local hours: int64 = 24 * days + hour1 - hour0
  local minutes: int64 = 60 * hours + min1 - min0
  return 60 * minutes + sec1 - sec0
end

local function tm_diff(year: int64, yday: int64, hour: int32, min: int32, sec: int32, tp: *sys.Tm): int64
  return ydhms_diff(year, yday, hour, min, sec, tp.tm_year, tp.tm_yday, tp.tm_hour, tp.tm_min, tp.tm_sec)
end

local function convert_time(t: int64, tm: *sys.Tm): boolean
  local x: clong = t
  return sys.localtime_r(&x, tm) ~= nilptr
end

local function ranged_convert(t: *int64, tp: *sys.Tm): boolean
  local t1: int64 = $t
  if convert_time(t1, tp) then return true end
  local bad: int64 = t1
  local ok: int64 = 0
  local oktm: sys.Tm
  oktm.tm_sec = -1
  while true do
    local mid: int64 = (ok // 2) + (bad // 2) + ((ok | bad) & 1)
    if mid == ok or mid == bad then break end
    if convert_time(mid, tp) then ok = mid; oktm = $tp else bad = mid end
  end
  if oktm.tm_sec < 0 then return false end
  $t = ok
  $tp = oktm
  return true
end

local localtime_offset: int64 = 0

local function mktime_internal(tp: *sys.Tm, offset: *int64): int64
  local tm: sys.Tm
  local remaining_probes = 6
  local sec: int32 = tp.tm_sec
  local min: int32 = tp.tm_min
  local hour: int32 = tp.tm_hour
  local mday: int32 = tp.tm_mday
  local mon: int32 = tp.tm_mon
  local year_requested: int32 = tp.tm_year
  local isdst: int32 = tp.tm_isdst
  local dst2: int32 = 0
  local mon_remainder: int32 = mon %%% 12
  local negative_mon_remainder: int32 = b2i(mon_remainder < 0)
  local mon_years: int32 = mon /// 12 - negative_mon_remainder
  local year: int64 = (@int64)(year_requested) + mon_years
  local myd: int32 = mon_yday[leapyear(year) and 1 or 0][mon_remainder + 12 * negative_mon_remainder] - 1
  local yday: int64 = (@int64)(myd) + mday
  local off: int64 = $offset
  local sec_requested: int32 = sec
  if sec < 0 then sec = 0 end
  if 59 < sec then sec = 59 end
  local negative_offset_guess: int32 = (@int32)((@int64)(0) - off)
  local t0: int64 = ydhms_diff(year, yday, hour, min, sec, 70, 0, 0, 0, negative_offset_guess)
  local t: int64 = t0
  local t1: int64 = t0
  local t2: int64 = t0
  local found = false
  while true do
    if not ranged_convert(&t, &tm) then return -1 end
    local dt = tm_diff(year, yday, hour, min, sec, &tm)
    if dt == 0 then break end
    if t == t1 and t ~= t2 and (tm.tm_isdst < 0 or
        (isdst < 0 and dst2 <= b2i(tm.tm_isdst ~= 0)) or
        (isdst >= 0 and ((isdst ~= 0) ~= (tm.tm_isdst ~= 0)))) then
      -- oscillating around a spring-forward gap
      found = true
      break
    end
    remaining_probes = remaining_probes - 1
    if remaining_probes == 0 then sys.seterrno(EOVERFLOW); return -1 end
    t1 = t2; t2 = t; t = t + dt; dst2 = b2i(tm.tm_isdst ~= 0)
  end
  if not found and isdst_differ(isdst, tm.tm_isdst) then
    local dst_difference: int32 = b2i(isdst == 0) - b2i(tm.tm_isdst == 0)
    local stride: int32 = 601200
    local duration_max: int32 = 457243209
    local delta_bound: int32 = duration_max // 2 + stride
    local delta: int32 = stride
    while delta < delta_bound and not found do
      local direction: int32 = -1
      while direction <= 1 do
        local ot: int64
        if not ckd_add(&ot, t, (@int64)(delta) * direction) then
          local otm: sys.Tm
          if not ranged_convert(&ot, &otm) then return -1 end
          if not isdst_differ(isdst, otm.tm_isdst) then
            local gt: int64 = ot + tm_diff(year, yday, hour, min, sec, &otm)
            if convert_time(gt, &tm) then
              t = gt
              found = true
              break
            end
          end
        end
        direction = direction + 2
      end
      delta = delta + stride
    end
    if not found then
      t = t + 3600 * dst_difference
      if not convert_time(t, &tm) then sys.seterrno(EOVERFLOW); return -1 end
    end
  end
  $offset = (t - t0) - negative_offset_guess
  if sec_requested ~= tm.tm_sec then
    local sec_adjustment: int64 = b2i(sec == 0 and tm.tm_sec == 60)
    sec_adjustment = sec_adjustment - sec
    sec_adjustment = sec_adjustment + sec_requested
    if ckd_add(&t, t, sec_adjustment) then sys.seterrno(EOVERFLOW); return -1 end
    if not convert_time(t, &tm) then return -1 end
  end
  $tp = tm
  return t
end

-- glibc mktime: tzset, then __mktime_internal over localtime_r
function util.mktime(tp: *sys.Tm): int64
  c_tzset()
  return mktime_internal(tp, &localtime_offset)
end

function util.mktime_z(tz: *util.Tz, tm: *sys.Tm): int64
  local old: util.Tz
  local ch = set_tz(tz, &old)
  local tm1: sys.Tm
  tm1.tm_sec = tm.tm_sec; tm1.tm_min = tm.tm_min; tm1.tm_hour = tm.tm_hour
  tm1.tm_mday = tm.tm_mday; tm1.tm_mon = tm.tm_mon; tm1.tm_year = tm.tm_year
  tm1.tm_yday = -1
  tm1.tm_isdst = tm.tm_isdst
  local t = util.mktime(&tm1)
  local ok = 0 <= tm1.tm_yday
  if ok then save_abbr(&tm1) end
  revert_tz(ch, &old)
  if ok then
    $tm = tm1
    return t
  end
  return -1
end

----------------------------------------------------------------------------
-- posixtm.c: [[CC]YY]MMDDhhmm[.ss] and MMDDhhmm[[CC]YY][.ss]

global util.PDS_TRAILING_YEAR: integer <comptime> = 1
global util.PDS_CENTURY: integer <comptime> = 2
global util.PDS_SECONDS: integer <comptime> = 4
global util.PDS_PRE_2000: integer <comptime> = 8

local function isdigit(c: byte): boolean return c >= 48 and c <= 57 end
local function isspace(c: byte): boolean return c == 32 or (c >= 9 and c <= 13) end
local function isalpha(c: byte): boolean return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) end

local function pds_year(tm: *sys.Tm, pair: *[6]integer, at: integer, n: integer, bits: integer): boolean
  if n == 1 then
    tm.tm_year = pair[at]
    if pair[at] <= 68 then
      if (bits & util.PDS_PRE_2000) ~= 0 then return false end
      tm.tm_year = tm.tm_year + 100
    end
  elseif n == 2 then
    if (bits & util.PDS_CENTURY) == 0 then return false end
    tm.tm_year = pair[at] * 100 + pair[at + 1] - 1900
  else
    local ts: sys.Timespec
    sys.clock_gettime(sys.CLOCK_REALTIME, &ts)
    local now: clong = ts.tv_sec
    local t: sys.Tm
    if sys.localtime_r(&now, &t) == nilptr then return false end
    tm.tm_year = t.tm_year
  end
  return true
end

local function posix_time_parse(tm: *sys.Tm, s: string, bits: integer): boolean
  local s_len = #s
  local len = s_len
  local dot = 0
  if (bits & util.PDS_SECONDS) ~= 0 then
    dot = s:find('.', 1, true)
    if dot > 0 then
      len = dot - 1
      if s_len - len ~= 3 then return false end
    end
  end
  if not (8 <= len and len <= 12 and len % 2 == 0) then return false end
  for i = 1, len do if not isdigit(s:byte(i)) then return false end end
  len = len // 2
  local pair: [6]integer
  for i = 0, len - 1 do pair[i] = 10 * (s:byte(2 * i + 1) - 48) + s:byte(2 * i + 2) - 48 end
  local p = 0
  if (bits & util.PDS_TRAILING_YEAR) == 0 then
    if not pds_year(tm, &pair, p, len - 4, bits) then return false end
    p = p + len - 4
    len = 4
  end
  tm.tm_mon = pair[p] - 1
  tm.tm_mday = pair[p + 1]
  tm.tm_hour = pair[p + 2]
  tm.tm_min = pair[p + 3]
  p = p + 4
  len = len - 4
  if (bits & util.PDS_TRAILING_YEAR) ~= 0 then
    if not pds_year(tm, &pair, p, len, bits) then return false end
  end
  if dot == 0 then tm.tm_sec = 0
  elseif isdigit(s:byte(dot + 1)) and isdigit(s:byte(dot + 2)) then
    tm.tm_sec = 10 * (s:byte(dot + 1) - 48) + s:byte(dot + 2) - 48
  else
    return false
  end
  return true
end

-- posixtime: the time, or false for an invalid one (a seconds field of 60
-- is the next second)
function util.posixtime(s: string, bits: integer): (boolean, int64)
  local tm0: sys.Tm
  local leapsec: int64 = 0
  if not posix_time_parse(&tm0, s, bits) then return false, 0 end
  while true do
    local tm1: sys.Tm
    tm1.tm_sec = tm0.tm_sec; tm1.tm_min = tm0.tm_min; tm1.tm_hour = tm0.tm_hour
    tm1.tm_mday = tm0.tm_mday; tm1.tm_mon = tm0.tm_mon; tm1.tm_year = tm0.tm_year
    tm1.tm_wday = -1; tm1.tm_isdst = -1
    local t = util.mktime(&tm1)
    if tm1.tm_wday < 0 then return false, 0 end
    if tm0.tm_year == tm1.tm_year and tm0.tm_mon == tm1.tm_mon and tm0.tm_mday == tm1.tm_mday
        and tm0.tm_hour == tm1.tm_hour and tm0.tm_min == tm1.tm_min and tm0.tm_sec == tm1.tm_sec then
      return true, t + leapsec
    end
    if tm0.tm_sec ~= 60 then return false, 0 end
    tm0.tm_sec = 59
    leapsec = 1
  end
  return false, 0
end

