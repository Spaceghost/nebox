-- Date strings for `date -d` (and `touch -d`), a subset of gnulib's
-- parse-datetime as GNU date 9.1 reads it. Items, in any order, separated by
-- blanks; case does not matter:
--   @SECONDS[.FRACTION]                     (alone)
--   YYYY-MM-DD, MM/DD/YYYY, MM/DD            calendar date
--   HH:MM[:SS[.FRACTION]] [am|pm] [ZONE]     time of day; also YYYY-MM-DDTHH:MM...
--   ZONE: Z, UTC, UT, GMT, +HH, +HHMM, +HH:MM (and -), after a time or alone
--   now, today, yesterday, tomorrow
--   a weekday (monday or mon; "next"/"last" before it move by a week)
--   [+|-]N UNIT[s] [ago], next/last/this UNIT; UNIT is year, month,
--   fortnight, week, day, hour, minute (min), second (sec)
-- Semantics follow parse-datetime: a date without a time means midnight; a
-- time without a date means today; with neither, the current time
-- (nanoseconds included). Years, months and days are added to the broken-down
-- time and normalized like mktime; hours, minutes and seconds are added to
-- the resulting count of seconds. A zone makes the date and time UTC plus
-- that offset; otherwise they are local wall time.
-- Not understood: month names, ordinal words ("third"), "week" numbers,
-- named time zones other than UTC/UT/GMT/Z, and "DST".
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.clock'

local function days_from_civil(y: integer, m: integer, d: integer): integer
  if m <= 2 then y = y - 1 end
  local era = (y >= 0 and y or y - 399) // 400
  local yoe = y - era * 400
  local mp = (m + 9) % 12
  local doy = (153 * mp + 2) // 5 + d - 1
  local doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
  return era * 146097 + doe - 719468
end

local function civil_from_days(z: integer): (integer, integer, integer)
  z = z + 719468
  local era = (z >= 0 and z or z - 146096) // 146097
  local doe = z - era * 146097
  local yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
  local y = yoe + era * 400
  local doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
  local mp = (5 * doy + 2) // 153
  local d = doy - (153 * mp + 2) // 5 + 1
  local m = mp < 10 and mp + 3 or mp - 9
  if m <= 2 then y = y + 1 end
  return y, m, d
end

local function valid_date(y: integer, m: integer, d: integer): boolean
  if m < 1 or m > 12 or d < 1 then return false end
  local mdays: []integer = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
  local n = mdays[m - 1]
  if m == 2 and (y % 4 == 0 and (y % 100 ~= 0 or y % 400 == 0)) then n = 29 end
  return d <= n
end

local function lower(s: string): string
  local sb: stringbuilder
  for i: usize = 0, < s.size do
    local c = s.data[i]
    if c >= 65 and c <= 90 then c = c + 32 end
    sb:writebyte(c)
  end
  return sb:promote()
end

local function isdigit(c: byte): boolean return c >= 48 and c <= 57 end

local function all_digits(s: string): boolean
  if s.size == 0 then return false end
  for i: usize = 0, < s.size do if not isdigit(s.data[i]) then return false end end
  return true
end

local function num(s: string): integer
  local v = 0
  for i: usize = 0, < s.size do v = v * 10 + (s.data[i] - 48) end
  return v
end

-- digits of a fraction as nanoseconds (truncated to nine digits)
local function frac_ns(s: string): integer
  local ns = 0
  local n = 0
  for i: usize = 0, < s.size do
    if n < 9 then ns = ns * 10 + (s.data[i] - 48); n = n + 1 end
  end
  while n < 9 do ns = ns * 10; n = n + 1 end
  return ns
end

local WEEKDAYS: []string = {'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'}

local function weekday_of(w: string): integer
  for i = 0, < 7 do
    local full = WEEKDAYS[i]
    if w == full or w == full:sub(1, 3) or (w.size == 4 and w == full:sub(1, 4) and (i == 2 or i == 3 or i == 4)) then
      return i
    end
  end
  if w == 'wednes' or w == 'thur' or w == 'thurs' or w == 'tues' then
    if w == 'wednes' then return 3 elseif w == 'tues' then return 2 else return 4 end
  end
  return -1
end

local function unit_of(w: string): integer
  if w:sub(-1) == 's' and w.size > 3 and w ~= 'secs' and w ~= 'mins' then w = w:sub(1, -2) end
  if w == 'year' then return 1 elseif w == 'month' then return 2 elseif w == 'fortnight' then return 3
  elseif w == 'week' then return 4 elseif w == 'day' then return 5 elseif w == 'hour' then return 6
  elseif w == 'minute' or w == 'min' or w == 'mins' then return 7
  elseif w == 'second' or w == 'sec' or w == 'secs' then return 8 end
  return 0
end

-- Items are separated by blanks and commas; "YYYY-MM-DDTHH:MM..." splits at
-- the T. Signs stay with their number ("+2", "-0500").
local function tokens(s: string): sequence(string)
  local out: sequence(string)
  local i: usize = 0
  while i < s.size do
    local c = s.data[i]
    if c == 32 or c == 9 or c == 44 then
      i = i + 1
    else
      local j = i
      while j < s.size and s.data[j] ~= 32 and s.data[j] ~= 9 and s.data[j] ~= 44 do j = j + 1 end
      local w = s:sub((@isize)(i) + 1, (@isize)(j))
      local t = w:find('t', 1, true)
      if t > 1 and isdigit(w.data[t - 2]) and t < (@isize)(w.size) and isdigit(w.data[t]) then
        out:push(w:sub(1, t - 1))
        out:push(w:sub(t + 1))
      else
        out:push(w)
      end
      i = j
    end
  end
  return out
end

-- A zone item: offset in seconds east of UTC.
local function parse_zone(w: string): (integer, boolean)
  if w == 'z' or w == 'utc' or w == 'ut' or w == 'gmt' then return 0, true end
  if w.size < 2 or (w.data[0] ~= 43 and w.data[0] ~= 45) then return 0, false end
  local sign = w.data[0] == 45 and -1 or 1
  local body = w:sub(2)
  local hh, mm = 0, 0
  local colon = body:find(':', 1, true)
  if colon > 0 then
    local a, b = body:sub(1, colon - 1), body:sub(colon + 1)
    if not all_digits(a) or not all_digits(b) or a.size > 2 or b.size ~= 2 then return 0, false end
    hh, mm = num(a), num(b)
  elseif all_digits(body) and body.size <= 2 then
    hh = num(body)
  elseif all_digits(body) and body.size == 4 then
    hh, mm = num(body:sub(1, 2)), num(body:sub(3, 4))
  else
    return 0, false
  end
  if hh > 24 or mm > 59 then return 0, false end
  return sign * (hh * 3600 + mm * 60), true
end

-- Parse `s` relative to now (now_t, now_ns). Returns seconds, nanoseconds, ok.
function util.getdate(s: string, now_t: integer, now_ns: integer): (integer, integer, boolean)
  local ls = lower(s)
  -- @SECONDS[.FRACTION]
  if ls.size > 1 and ls.data[0] == 64 then
    local body = ls:sub(2)
    local neg = false
    if body.size > 0 and (body.data[0] == 45 or body.data[0] == 43) then neg = body.data[0] == 45; body = body:sub(2) end
    local dot = body:find('.', 1, true)
    local ip, fp = body, ''
    if dot > 0 then ip = body:sub(1, dot - 1); fp = body:sub(dot + 1) end
    if not all_digits(ip) or (dot > 0 and fp.size > 0 and not all_digits(fp)) then return 0, 0, false end
    local t, ns = num(ip), frac_ns(fp)
    if neg then
      t = -t
      if ns > 0 then t = t - 1; ns = 1000000000 - ns end
    end
    return t, ns, true
  end
  local now, okn = util.breaktime(now_t, now_ns, false)
  if not okn then return 0, 0, false end
  local y, mo, d = (@integer)(now.tm.tm_year) + 1900, (@integer)(now.tm.tm_mon) + 1, (@integer)(now.tm.tm_mday)
  local hh, mi, ss, ns = (@integer)(now.tm.tm_hour), (@integer)(now.tm.tm_min), (@integer)(now.tm.tm_sec), now_ns
  local have_date, have_time, have_zone, have_wday = false, false, false, false
  local zone = 0
  local wday, wday_ord = -1, 0
  local rel: [9]integer
  local toks = tokens(ls)
  local i = 1
  local last_rel_unit = 0
  local last_rel_val = 0
  local prev_time = false
  while i <= #toks do
    local w = toks[i]
    local after_time = prev_time
    prev_time = false
    local colon = w:find(':', 1, true)
    local slash = w:find('/', 1, true)
    local dash = w:find('-', 2, true)
    if w == 'now' or w == 'today' then
      -- no change
    elseif w == 'yesterday' then rel[5] = rel[5] - 1
    elseif w == 'tomorrow' then rel[5] = rel[5] + 1
    elseif w == 'ago' then
      if last_rel_unit == 0 then return 0, 0, false end
      rel[last_rel_unit] = rel[last_rel_unit] - 2 * last_rel_val
      last_rel_unit = 0
    elseif colon > 0 and isdigit(w.data[0]) then
      -- HH:MM[:SS[.FRAC]] with an optional zone glued on (+0100, Z)
      local body = w
      if body:sub(-1) == 'z' then body = body:sub(1, -2); zone = 0; have_zone = true end
      local zpos = 0
      for k: usize = 1, < body.size do
        local c = body.data[k]
        if (c == 43 or c == 45) and zpos == 0 then zpos = (@integer)(k) end
      end
      if zpos > 0 then
        local z, okz = parse_zone(body:sub(zpos + 1))
        if not okz then return 0, 0, false end
        zone = z; have_zone = true
        body = body:sub(1, zpos)
      end
      local parts: sequence(string)
      local st: usize = 0
      for k: usize = 0, < body.size do
        if body.data[k] == 58 then parts:push(body:sub((@isize)(st) + 1, (@isize)(k))); st = k + 1 end
      end
      parts:push(body:sub((@isize)(st) + 1))
      if #parts < 2 or #parts > 3 then return 0, 0, false end
      local secpart = #parts == 3 and parts[3] or '0'
      local dot = secpart:find('.', 1, true)
      local fp = ''
      if dot <= 0 then dot = secpart:find(',', 1, true) end
      if dot > 0 then fp = secpart:sub(dot + 1); secpart = secpart:sub(1, dot - 1) end
      if not all_digits(parts[1]) or not all_digits(parts[2]) or not all_digits(secpart) or
         (fp.size > 0 and not all_digits(fp)) or parts[1].size > 2 or parts[2].size ~= 2 then
        return 0, 0, false
      end
      hh, mi, ss, ns = num(parts[1]), num(parts[2]), num(secpart), frac_ns(fp)
      if hh > 23 or mi > 59 or ss > 60 then return 0, 0, false end
      have_time = true
      -- am/pm
      if i < #toks and (toks[i + 1] == 'am' or toks[i + 1] == 'pm' or toks[i + 1] == 'a.m.' or toks[i + 1] == 'p.m.') then
        if hh < 1 or hh > 12 then return 0, 0, false end
        local pm = toks[i + 1]:byte(1) == 112
        if hh == 12 then hh = 0 end
        if pm then hh = hh + 12 end
        i = i + 1
      end
      prev_time = not have_zone
    elseif slash > 0 then
      -- MM/DD[/YYYY]
      local a = w:sub(1, slash - 1)
      local rest = w:sub(slash + 1)
      local s2 = rest:find('/', 1, true)
      local b, c = rest, ''
      if s2 > 0 then b = rest:sub(1, s2 - 1); c = rest:sub(s2 + 1) end
      if not all_digits(a) or not all_digits(b) or (s2 > 0 and not all_digits(c)) then return 0, 0, false end
      mo, d = num(a), num(b)
      if s2 > 0 then
        y = num(c)
        if c.size <= 2 then y = y < 69 and y + 2000 or y + 1900 end
      end
      if not valid_date(y, mo, d) then return 0, 0, false end
      have_date = true
      if not have_time then hh = 0; mi = 0; ss = 0; ns = 0 end
    elseif dash > 0 and isdigit(w.data[0]) then
      -- YYYY-MM-DD
      local p1 = w:find('-', 1, true)
      local rest = w:sub(p1 + 1)
      local p2 = rest:find('-', 1, true)
      if p2 <= 0 then return 0, 0, false end
      local a, b, c = w:sub(1, p1 - 1), rest:sub(1, p2 - 1), rest:sub(p2 + 1)
      if not all_digits(a) or not all_digits(b) or not all_digits(c) then return 0, 0, false end
      y, mo, d = num(a), num(b), num(c)
      if not valid_date(y, mo, d) then return 0, 0, false end
      have_date = true
      if not have_time then hh = 0; mi = 0; ss = 0; ns = 0 end
    elseif (w.data[0] == 43 or w.data[0] == 45) and after_time then
      -- parse-datetime reads a signed number right after a time as its zone,
      -- even when a unit follows ("01:30 +1 hour" is 01:30 UTC+1, plus an hour)
      local z, okz = parse_zone(w)
      if not okz then return 0, 0, false end
      zone = z; have_zone = true
    elseif w == 'z' or w == 'utc' or w == 'ut' or w == 'gmt' then
      zone = 0; have_zone = true
    elseif w == 'next' or w == 'last' or w == 'this' or all_digits(w) or
           ((w.data[0] == 43 or w.data[0] == 45) and w.size > 1 and all_digits(w:sub(2))) then
      local n: integer
      if w == 'next' then n = 1 elseif w == 'last' then n = -1 elseif w == 'this' then n = 0
      elseif w.data[0] == 45 then n = -num(w:sub(2))
      elseif w.data[0] == 43 then n = num(w:sub(2))
      else n = num(w) end
      if i == #toks then
        -- a bare number: four digits alone are a year, otherwise invalid here
        return 0, 0, false
      end
      local nxt = toks[i + 1]
      local u = unit_of(nxt)
      local wd = weekday_of(nxt)
      if u > 0 then
        rel[u] = rel[u] + n
        last_rel_unit = u; last_rel_val = n
        i = i + 1
      elseif wd >= 0 and (w == 'next' or w == 'last' or w == 'this') then
        wday = wd; wday_ord = n; have_wday = true
        i = i + 1
      else
        return 0, 0, false
      end
    elseif unit_of(w) > 0 then
      local u = unit_of(w)
      rel[u] = rel[u] + 1
      last_rel_unit = u; last_rel_val = 1
    elseif weekday_of(w) >= 0 then
      wday = weekday_of(w); wday_ord = 0; have_wday = true
    else
      return 0, 0, false
    end
    i = i + 1
  end
  if have_wday and not have_time then hh = 0; mi = 0; ss = 0; ns = 0 end
  if (have_date or have_wday) and not have_time then ns = 0 end
  -- parse-datetime's order: the day of the week first (only without an
  -- explicit date), then years, months and days on the broken-down time
  -- (normalized like mktime), then hours, minutes and seconds as a count
  local days = days_from_civil(y, mo, 1) + (d - 1)
  if have_wday and not have_date then
    local cur = (days + 4) % 7   -- 1970-01-01 was a Thursday
    local delta = (wday - cur + 7) % 7
    local adj = (wday_ord > 0 and cur ~= wday) and 1 or 0
    days = days + delta + 7 * (wday_ord - adj)
  end
  y, mo, d = civil_from_days(days)
  y = y + rel[1]
  mo = mo + rel[2]
  local my = (mo - 1) // 12
  y = y + my
  mo = mo - my * 12
  days = days_from_civil(y, mo, 1) + (d - 1) + rel[5] + 7 * rel[4] + 14 * rel[3]
  y, mo, d = civil_from_days(days)
  local t: integer
  if have_zone then
    t = days * 86400 + hh * 3600 + mi * 60 + ss - zone
  else
    local okl: boolean
    t, okl = util.localsecs(y, mo, d, hh, mi, ss)
    if not okl then return 0, 0, false end
  end
  t = t + rel[6] * 3600 + rel[7] * 60 + rel[8]
  return t, ns, true
end
