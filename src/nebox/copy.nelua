-- GNU coreutils 9.1 src/copy.c and src/cp-hash.c, shared by cp, mv and
-- install: copy_internal with its same_file_ok, overwrite and backup
-- rules, copy_reg (copy_file_range, FICLONE reflinks, SEEK_DATA/SEEK_HOLE
-- extent copies and hole punching for --sparse, the u+w window for xattrs,
-- dangling-symlink refusal), copy_dir over names in inode order (gnulib
-- savedir SAVEDIR_SORT_FASTREAD), hard-link preservation through the
-- source dev/ino map, special files, symlinks (including --update's
-- identical-target shortcut), ownership/mode/timestamp preservation with
-- the restrictive temporary modes, xattrs as libattr copies them under
-- /etc/xattr.conf's defaults, and un-backup on failure. ACLs: the mode is
-- applied and a source system.posix_acl_* attribute copied as is. SELinux
-- contexts are not supported (the build has no libselinux).
## pragmas.nogc = true

require 'string'
require 'sequence'
require 'hashmap'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.backup'
require 'nebox.canonicalize'

local function c_exit(status: cint) <cimport 'exit', cinclude '<stdlib.h>', noreturn> end
local function c_openat(fd: cint, path: cstring, flags: cint, mode: cuint): cint <cimport 'openat', cinclude '<fcntl.h>'> end
local function c_fstatat(fd: cint, path: cstring, st: *sys.Stat, flags: cint): cint <cimport 'fstatat', cinclude '<sys/stat.h>'> end
local function c_mkdirat(fd: cint, path: cstring, mode: cuint): cint <cimport 'mkdirat', cinclude '<sys/stat.h>'> end
local function c_mknodat(fd: cint, path: cstring, mode: cuint, dev: culong): cint <cimport 'mknodat', cinclude '<sys/stat.h>'> end
local function c_mkfifoat(fd: cint, path: cstring, mode: cuint): cint <cimport 'mkfifoat', cinclude '<sys/stat.h>'> end
local function c_unlinkat(fd: cint, path: cstring, flags: cint): cint <cimport 'unlinkat', cinclude '<unistd.h>'> end
local function c_renameat(ofd: cint, old: cstring, nfd: cint, new: cstring): cint <cimport 'renameat', cinclude '<stdio.h>'> end
local c_renameat2 = sys.renameat2
local function c_symlinkat(target: cstring, nfd: cint, new: cstring): cint <cimport 'symlinkat', cinclude '<unistd.h>'> end
local function c_linkat(ofd: cint, old: cstring, nfd: cint, new: cstring, flags: cint): cint <cimport 'linkat', cinclude '<unistd.h>'> end
local function c_readlinkat(fd: cint, path: cstring, buf: pointer, n: csize): clong <cimport 'readlinkat', cinclude '<unistd.h>'> end
local function c_fchmodat(fd: cint, path: cstring, mode: cuint, flags: cint): cint <cimport 'fchmodat', cinclude '<sys/stat.h>'> end
local function c_fchownat(fd: cint, path: cstring, uid: cuint, gid: cuint, flags: cint): cint <cimport 'fchownat', cinclude '<unistd.h>'> end
local function c_fchown(fd: cint, uid: cuint, gid: cuint): cint <cimport 'fchown', cinclude '<unistd.h>'> end
local function c_fchmod(fd: cint, mode: cuint): cint <cimport 'fchmod', cinclude '<sys/stat.h>'> end
local function c_utimensat(fd: cint, path: cstring, ts: *[2]sys.Timespec, flags: cint): cint <cimport 'utimensat', cinclude '<sys/stat.h>'> end
local function c_futimens(fd: cint, ts: *[2]sys.Timespec): cint <cimport 'futimens', cinclude '<sys/stat.h>'> end
local function c_faccessat(fd: cint, path: cstring, mode: cint, flags: cint): cint <cimport 'faccessat', cinclude '<unistd.h>'> end
local function c_ioctl(fd: cint, req: culong, arg: clong): cint <cimport 'ioctl', cinclude '<sys/ioctl.h>'> end
local function c_copy_file_range(i: cint, io: pointer, o: cint, oo: pointer, n: csize, flags: cuint): clong <cimport 'copy_file_range', cinclude '<unistd.h>'> end
local function c_fallocate(fd: cint, mode: cint, off: clong, len: clong): cint <cimport 'fallocate', cinclude '<fcntl.h>'> end
local function c_ftruncate(fd: cint, len: clong): cint <cimport 'ftruncate', cinclude '<unistd.h>'> end
