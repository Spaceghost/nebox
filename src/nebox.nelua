## if THESEUS_BOOT then
require 'theseus.earlyboot'
## end

local Applet = @record{name: string, run: function(sequence(string)): integer}

local applets: []Applet = {
  {'[', applet_test}, {'arch', applet_arch}, {'awk', applet_awk}, {'b2sum', applet_b2sum}, {'base32', applet_base32}, {'base64', applet_base64},
  {'basenc', applet_basenc}, {'basename', applet_basename},
  {'cat', applet_cat}, {'chgrp', applet_chgrp}, {'chmod', applet_chmod},
  {'chown', applet_chown}, {'chroot', applet_chroot}, {'cksum', applet_cksum}, {'cmp', applet_cmp}, {'comm', applet_comm},
  {'cp', applet_cp}, {'csplit', applet_csplit}, {'cut', applet_cut}, {'date', applet_date}, {'dd', applet_dd},
  {'df', applet_df}, {'diff', applet_diff}, {'dir', applet_dir}, {'dircolors', applet_dircolors}, {'dirname', applet_dirname}, {'dnsdomainname', applet_hostname},
  {'domainname', applet_hostname}, {'du', applet_du},
  {'echo', applet_echo}, {'env', applet_env}, {'expand', applet_expand}, {'expr', applet_expr},
  {'factor', applet_factor}, {'false', applet_false}, {'find', applet_find}, {'fmt', applet_fmt},
  {'fold', applet_fold}, {'free', applet_free}, {'grep', applet_grep},
  {'groups', applet_groups}, {'gunzip', applet_gunzip}, {'gzip', applet_gzip}, {'hd', applet_hd}, {'head', applet_head}, {'hexdump', applet_hexdump},
  {'hostid', applet_hostid}, {'hostname', applet_hostname}, {'id', applet_id}, {'install', applet_install}, {'join', applet_join},
  {'kill', applet_kill}, {'link', applet_link}, {'ln', applet_ln}, {'logname', applet_logname}, {'ls', applet_ls},
  {'md5sum', applet_md5sum}, {'mkdir', applet_mkdir}, {'mkfifo', applet_mkfifo}, {'mknod', applet_mknod}, {'mktemp', applet_mktemp},
  {'mount', applet_mount}, {'mv', applet_mv}, {'nice', applet_nice}, {'nisdomainname', applet_hostname}, {'nl', applet_nl}, {'nohup', applet_nohup}, {'nproc', applet_nproc}, {'nsh', applet_nsh}, {'od', applet_od},
  {'paste', applet_paste}, {'patch', applet_patch}, {'pathchk', applet_pathchk}, {'pinky', applet_pinky}, {'printenv', applet_printenv}, {'printf', applet_printf},
  {'pwd', applet_pwd}, {'readlink', applet_readlink}, {'realpath', applet_realpath},
  {'rev', applet_rev}, {'rm', applet_rm}, {'rmdir', applet_rmdir}, {'sed', applet_sed},
  {'seq', applet_seq}, {'setsid', applet_setsid}, {'sh', applet_sh}, {'sha1sum', applet_sha1sum}, {'sha224sum', applet_sha224sum}, {'sha256sum', applet_sha256sum},
  {'sha384sum', applet_sha384sum}, {'sha512sum', applet_sha512sum},
  {'shuf', applet_shuf}, {'sleep', applet_sleep}, {'sort', applet_sort},
  {'split', applet_split}, {'stat', applet_stat}, {'strings', applet_strings}, {'sum', applet_sum},
  {'sync', applet_sync}, {'tac', applet_tac}, {'tail', applet_tail}, {'tar', applet_tar}, {'tee', applet_tee},
  {'test', applet_test}, {'timeout', applet_timeout}, {'touch', applet_touch},
  {'tr', applet_tr}, {'true', applet_true}, {'truncate', applet_truncate},
  {'tsort', applet_tsort}, {'tty', applet_tty}, {'umount', applet_umount},
  {'uname', applet_uname}, {'unexpand', applet_unexpand}, {'uniq', applet_uniq}, {'unlink', applet_unlink}, {'uptime', applet_uptime}, {'users', applet_users}, {'vdir', applet_vdir}, {'wc', applet_wc},
  {'which', applet_which}, {'who', applet_who}, {'whoami', applet_whoami}, {'xargs', applet_xargs},
  {'yes', applet_yes}, {'ypdomainname', applet_hostname}, {'zcat', applet_zcat},
}

## if THESEUS_BOOT then
local boot_applets: []Applet = {
  {'init', theseus_boot.init},
}
local applet_count <comptime> = #applets + #boot_applets
## else
local applet_count <comptime> = #applets
## end

local function applet_at(index: integer): Applet
  ## if THESEUS_BOOT then
  if index >= #applets then return boot_applets[index - #applets] end
  ## end
  return applets[index]
end

local function find(name: string): integer
  for i: integer = 0, < applet_count do
    if applet_at(i).name == name then return i end
  end
  return -1
end

local function usage(): integer
  util.line('usage: nebox APPLET [ARGUMENT...]')
  util.line('       nebox --list')
  util.line('       nebox --install [-s] DIR')
  util.line('')
  util.line('Applets:')
  for i: integer = 0, < applet_count do
    util.write(i % 8 == 0 and '  ' or ' ')
    util.write(applet_at(i).name)
    if i % 8 == 7 or i == applet_count - 1 then util.writebyte(10) end
  end
  return 0
end

-- Create one link per applet in DIR, pointing at this binary.
local function install(dir: string, symbolic: boolean): integer
  local buf: [4096]byte
  local n = sys.readlink('/proc/self/exe', &buf[0], #buf)
  if n <= 0 then return util.die('cannot resolve /proc/self/exe: ' .. sys.errstr()) end
  local self = string.copy((@string){data=&buf[0], size=(@usize)(n)})
  if not util.isdir(dir) and sys.mkdir(dir, 0x1FF) ~= 0 then
    return util.die("cannot create directory '" .. dir .. "': " .. sys.errstr())
  end
  local rc: integer = 0
  for i: integer = 0, < applet_count do
    local link = util.join(dir, applet_at(i).name)
    sys.unlink(link)
    local r: cint
    if symbolic then r = sys.symlink(self, link) else r = sys.link(self, link) end
    if r ~= 0 then util.err("cannot link '" .. link .. "': " .. sys.errstr()); rc = 1 end
  end
  return rc
end

local function main(): integer
  local name = util.basename(arg[0])
  if name == '-sh' or name == '-nsh' then name = name:sub(2) end
  local first: integer = 1
  if name == 'nebox' or find(name) < 0 then
    if #arg < 1 then return usage() end
    name = arg[1]
    first = 2
    if name == '--list' then
      for i: integer = 0, < applet_count do util.line(applet_at(i).name) end
      return 0
    elseif name == '--install' then
      local symbolic = false
      if first <= #arg and arg[first] == '-s' then symbolic = true; first = first + 1 end
      if first > #arg then return util.die('--install needs a directory') end
      return install(arg[first], symbolic)
    elseif name == '--help' or name == '-h' then
      return usage()
    end
  end
  local idx = find(name)
  if idx < 0 then
    util.err(name .. ': applet not found')
    return 127
  end
  nlocale.init()
  util.applet = name
  local args: sequence(string)
  for i: integer = first, #arg do args:push(arg[i]) end
  return applet_at(idx).run(args)
end

local rc = main()
if not util.flush() then
  if rc == 0 then rc = 1 end
end
sys._exit((@cint)(rc))
