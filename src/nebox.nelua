-- nebox: a toybox-style multicall binary written in Nelua against nelibc.
-- The applet is chosen from argv[0]'s basename; when that is "nebox" the
-- first operand names the applet.
## pragmas.nogc = true

require 'arg'
require 'string'
require 'sequence'
require 'nebox.sys'
require 'nebox.util'
require 'nebox.clock'
require 'nebox.applets.text'
require 'nebox.applets.fs'
require 'nebox.applets.proc'
require 'nebox.applets.text2'
require 'nebox.applets.fs2'
require 'nebox.applets.proc2'
require 'nebox.applets.sed'
require 'nebox.applets.fs3'
require 'nebox.applets.text3'
require 'nebox.applets.dd'
require 'nebox.applets.join'
require 'nebox.applets.digest'
require 'nebox.applets.basenc'
require 'nebox.applets.tr'
require 'nebox.applets.cut'
require 'nebox.applets.uniq'
require 'nebox.applets.head'
require 'nebox.applets.tail'
require 'nebox.applets.nlcp'
require 'nebox.applets.timeout'
require 'nebox.applets.tee'
require 'nebox.applets.split'
require 'nebox.applets.shuf'
require 'nebox.applets.stat'
require 'nebox.applets.rm'
require 'nebox.applets.ln'
require 'nebox.applets.df'
require 'nebox.applets.du'
require 'nebox.applets.chown'
require 'nebox.applets.cp'
require 'nebox.applets.mv'
require 'nebox.applets.install'
require 'nebox.applets.touch'
require 'nebox.applets.truncate'
require 'nebox.applets.echo'
require 'nebox.applets.smallcore'
require 'nebox.applets.tac'
require 'nebox.applets.tsort'
require 'nebox.applets.test'
require 'nebox.applets.env'
require 'nebox.applets.printf'
require 'nebox.applets.expr'
require 'nebox.applets.mktemp'
require 'nebox.applets.realpath'
require 'nebox.applets.id'
require 'nebox.applets.wc'
require 'nebox.applets.expand'
require 'nebox.applets.awk'
require 'nebox.applets.sh'
require 'nebox.applets.diff'
require 'nebox.applets.patch'

local Applet = @record{name: string, run: function(sequence(string)): integer}

local applets: []Applet = {
  {'[', applet_test}, {'awk', applet_awk}, {'b2sum', applet_b2sum}, {'base32', applet_base32}, {'base64', applet_base64},
  {'basenc', applet_basenc}, {'basename', applet_basename},
  {'cat', applet_cat}, {'chgrp', applet_chgrp}, {'chmod', applet_chmod},
  {'chown', applet_chown}, {'cksum', applet_cksum}, {'cmp', applet_cmp}, {'comm', applet_comm},
  {'cp', applet_cp}, {'cut', applet_cut}, {'date', applet_date}, {'dd', applet_dd},
  {'df', applet_df}, {'diff', applet_diff}, {'dirname', applet_dirname}, {'du', applet_du},
  {'echo', applet_echo}, {'env', applet_env}, {'expand', applet_expand}, {'expr', applet_expr},
  {'factor', applet_factor}, {'false', applet_false}, {'find', applet_find},
  {'fold', applet_fold}, {'free', applet_free}, {'grep', applet_grep},
  {'groups', applet_groups}, {'head', applet_head}, {'hexdump', applet_hexdump},
  {'hostname', applet_hostname}, {'id', applet_id}, {'install', applet_install}, {'join', applet_join},
  {'kill', applet_kill}, {'link', applet_link}, {'ln', applet_ln}, {'ls', applet_ls},
  {'md5sum', applet_md5sum}, {'mkdir', applet_mkdir}, {'mktemp', applet_mktemp},
  {'mv', applet_mv}, {'nl', applet_nl}, {'nproc', applet_nproc}, {'nsh', applet_nsh}, {'od', applet_od},
  {'paste', applet_paste}, {'patch', applet_patch}, {'printenv', applet_printenv}, {'printf', applet_printf},
  {'pwd', applet_pwd}, {'readlink', applet_readlink}, {'realpath', applet_realpath},
  {'rev', applet_rev}, {'rm', applet_rm}, {'rmdir', applet_rmdir}, {'sed', applet_sed},
  {'seq', applet_seq}, {'sh', applet_sh}, {'sha1sum', applet_sha1sum}, {'sha224sum', applet_sha224sum}, {'sha256sum', applet_sha256sum},
  {'sha384sum', applet_sha384sum}, {'sha512sum', applet_sha512sum},
  {'shuf', applet_shuf}, {'sleep', applet_sleep}, {'sort', applet_sort},
  {'split', applet_split}, {'stat', applet_stat}, {'strings', applet_strings}, {'sum', applet_sum},
  {'sync', applet_sync}, {'tac', applet_tac}, {'tail', applet_tail}, {'tee', applet_tee},
  {'test', applet_test}, {'timeout', applet_timeout}, {'touch', applet_touch},
  {'tr', applet_tr}, {'true', applet_true}, {'truncate', applet_truncate},
  {'tsort', applet_tsort}, {'tty', applet_tty}, {'unexpand', applet_unexpand},
  {'uname', applet_uname}, {'uniq', applet_uniq}, {'unlink', applet_unlink}, {'wc', applet_wc},
  {'which', applet_which}, {'whoami', applet_whoami}, {'xargs', applet_xargs},
  {'yes', applet_yes},
}

local function find(name: string): integer
  for i: integer = 0, < #applets do
    if applets[i].name == name then return i end
  end
  return -1
end

local function usage(): integer
  util.line('usage: nebox APPLET [ARGUMENT...]')
  util.line('       nebox --list')
  util.line('       nebox --install [-s] DIR')
  util.line('')
  util.line('Applets:')
  for i: integer = 0, < #applets do
    util.write(i % 8 == 0 and '  ' or ' ')
    util.write(applets[i].name)
    if i % 8 == 7 or i == #applets - 1 then util.writebyte(10) end
  end
  return 0
end

-- Create one link per applet in DIR, pointing at this binary.
local function install(dir: string, symbolic: boolean): integer
  local buf: [4096]byte
  local n = sys.readlink('/proc/self/exe', &buf[0], #buf)
  if n <= 0 then return util.die('cannot resolve /proc/self/exe: ' .. sys.errstr()) end
  local self = string.copy((@string){data=&buf[0], size=(@usize)(n)})
  if not util.isdir(dir) and sys.mkdir(dir, 0x1FF) ~= 0 then
    return util.die("cannot create directory '" .. dir .. "': " .. sys.errstr())
  end
  local rc: integer = 0
  for i: integer = 0, < #applets do
    local link = util.join(dir, applets[i].name)
    sys.unlink(link)
    local r: cint
    if symbolic then r = sys.symlink(self, link) else r = sys.link(self, link) end
    if r ~= 0 then util.err("cannot link '" .. link .. "': " .. sys.errstr()); rc = 1 end
  end
  return rc
end

local function main(): integer
  local name = util.basename(arg[0])
  local first: integer = 1
  if name == 'nebox' or find(name) < 0 then
    if #arg < 1 then return usage() end
    name = arg[1]
    first = 2
    if name == '--list' then
      for i: integer = 0, < #applets do util.line(applets[i].name) end
      return 0
    elseif name == '--install' then
      local symbolic = false
      if first <= #arg and arg[first] == '-s' then symbolic = true; first = first + 1 end
      if first > #arg then return util.die('--install needs a directory') end
      return install(arg[first], symbolic)
    elseif name == '--help' or name == '-h' then
      return usage()
    end
  end
  local idx = find(name)
  if idx < 0 then
    util.err(name .. ': applet not found')
    return 127
  end
  util.applet = name
  local args: sequence(string)
  for i: integer = first, #arg do args:push(arg[i]) end
  return applets[idx].run(args)
end

local rc = main()
if not util.flush() then
  if rc == 0 then rc = 1 end
end
sys._exit((@cint)(rc))
