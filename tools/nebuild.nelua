-- A file dependency runner for the standalone distribution bootstrap.
## pragmas.nogc = true

require 'arg'
require 'hashmap'
require 'io'
require 'nebuild.sys'
require 'os'
require 'sequence'
require 'string'
require 'stringbuilder'

local SYS_flock: clong <cimport, nodecl, cinclude '<sys/syscall.h>'>
local function syscall(number: clong, ...: cvarargs): clong <cimport, cinclude '<nelibc_syscall.h>'> end

local stamp_suffix = '.nebuild-command'
local Edge = @record{
  output: string,
  inputs: sequence(string),
  command: string,
  signature: string,
  visiting: boolean,
  planned: boolean,
  waiting: usize,
  consumers: sequence(usize),
  generation: string,
}

local edges: sequence(Edge)
local producers: hashmap(string, usize)
local defaults: sequence(string)
local order: sequence(usize)

local function fail(message: string): void <noreturn>
  io.stderr:write('nebuild: ' .. message .. '\n')
  os.exit(1)
end

local function lock_build_directory()
  local fd = sys.open('.', sys.O_RDONLY | sys.O_DIRECTORY, 0)
  if fd < 0 then fail('cannot open build directory: ' .. sys.errstr()) end
  -- Linux LOCK_EX | LOCK_NB. Keep the descriptor open through each recipe.
  if syscall(SYS_flock, (@clong)(fd), 6_clong, 0_clong, 0_clong, 0_clong, 0_clong) ~= 0 then
    fail('cannot lock build directory: ' .. sys.errstr())
  end
end

local function file_status(path: string, status: *sys.Stat): boolean
  if sys.stat(path, status) == 0 then return true end
  if sys.errno() == sys.ENOENT then return false end
  fail(path .. ': ' .. sys.errstr())
  return false
end

local function valid_path(path: string): boolean
  if #path == 0 or path:sub(-1) == '/' or path:sub(-#stamp_suffix) == stamp_suffix then
    return false
  end
  local absolute = path:sub(1, 1) == '/'
  local components = '/' .. path:sub(absolute and 2 or 1) .. '/'
  return components:find('//', 1, true) == 0 and
    components:find('/./', 1, true) == 0 and components:find('/../', 1, true) == 0
end

local function read_manifest(path: string)
  local input, reason = io.open(path, 'rb')
  if not input then fail(path .. ': ' .. reason) end
  local contents = input:read('a')
  if not input:close() then fail('cannot close ' .. path) end
  if contents:find(string.char(0), 1, true) ~= 0 then fail(path .. ': NUL byte') end

  local pending: usize = 0
  local line_number = 0
  local offset: isize = 1
  while offset <= (@isize)(#contents) do
    local newline = contents:find('\n', offset, true)
    if newline == 0 then newline = (@isize)(#contents) + 1 end
    local line = contents:sub(offset, newline - 1)
    offset = newline + 1
    line_number = line_number + 1
    local location = path .. ':' .. tostring(line_number) .. ': '

    if pending ~= 0 then
      if line:sub(1, 1) ~= '\t' or #line <= 1 then fail(location .. 'expected a tab-prefixed command') end
      local edge = &edges[pending]
      edge.command = line:sub(2)
      edge.signature = edge.signature .. '\n' .. edge.command
      pending = 0
    elseif #line > 0 and line:sub(1, 1) ~= '#' then
      local words: sequence(string)
      local first: isize = 1
      local length = (@isize)(#line)
      while first <= length do
        local last = first
        while last <= length and line:byte(last) ~= 32 and line:byte(last) ~= 9 do
          last = last + 1
        end
        if last > first then words:push(line:sub(first, last - 1)) end
        first = last + 1
      end

      if #words == 0 then
        -- Allow blank lines containing spaces.
      elseif (words[1] == 'build' or words[1] == 'default') and #words >= 2 then
        for index: usize = 2, #words do
          if not valid_path(words[index]) then fail(location .. 'invalid path ' .. words[index]) end
        end
        if words[1] == 'build' then
          local output = words[2]
          if producers[output] ~= 0 then fail(location .. 'duplicate output ' .. output) end
          if output == path then fail(location .. 'manifest is a build output') end
          local edge: Edge = {output = output, signature = line}
          for index: usize = 3, #words do edge.inputs:push(words[index]) end
          edges:push(edge)
          pending = #edges
          producers[output] = pending
        else
          for index: usize = 2, #words do defaults:push(words[index]) end
        end
      else
        fail(location .. 'expected build or default')
      end
      words:destroy()
    end
  end
  if pending ~= 0 then fail(path .. ': missing command for ' .. edges[pending].output) end
end

local function visit(index: usize)
  local edge = &edges[index]
  if edge.visiting then fail('dependency cycle at ' .. edge.output) end
  if edge.planned then return end
  edge.visiting = true
  for i: usize = 1, #edge.inputs do
    local input = edge.inputs[i]
    local producer = producers[input]
    if producer ~= 0 then
      visit(producer)
      edge.waiting = edge.waiting + 1
      edges[producer].consumers:push(index)
    else
      local info: sys.Stat
      if not file_status(input, &info) then fail('missing input ' .. input .. ' for ' .. edge.output) end
    end
  end
  edge.visiting = false
  edge.planned = true
  order:push(index)
end

local function plan(target: string)
  local index = producers[target]
  if index == 0 then fail('unknown target ' .. target) end
  visit(index)
end

local record_prefix = 'nebuild 2 '
local invocation: string

local function build_generation(): string
  if #invocation == 0 then
    local random: [2]uint64
    if sys.getrandom(&random[0], 16, 1) == 16 then -- GRND_NONBLOCK
      invocation = tostring(random[0]) .. '.' .. tostring(random[1])
    else
      -- Early boot and older kernels can run recipes before random bytes are ready.
      local wall: sys.Timespec
      local uptime: sys.Timespec
      if sys.clock_gettime(0, &wall) ~= 0 or sys.clock_gettime(sys.CLOCK_MONOTONIC, &uptime) ~= 0 then
        fail('cannot identify build invocation: ' .. sys.errstr())
      end
      invocation = tostring(wall.tv_sec) .. '.' .. tostring(wall.tv_nsec) .. '.' ..
        tostring(uptime.tv_sec) .. '.' .. tostring(uptime.tv_nsec) .. '.' .. tostring(sys.getpid())
    end
  end
  return invocation
end

local function needs_build(edge: *Edge): boolean
  local info: sys.Stat
  local exists = file_status(edge.output, &info)
  if exists and (info.st_mode & sys.S_IFMT) ~= sys.S_IFREG then fail('expected file output ' .. edge.output) end

  -- Capture the inputs before starting the recipe. A modification while the
  -- command runs will still be visible to the next invocation.
  local signature: stringbuilder
  signature:write(edge.signature)
  for i: usize = 1, #edge.inputs do
    local path = edge.inputs[i]
    if not file_status(path, &info) then fail('missing input ' .. path .. ' for ' .. edge.output) end
    signature:write('\n', info.st_dev, ' ', info.st_ino, ' ', info.st_mode, ' ', info.st_size,
      ' ', info.st_mtim.tv_sec, '.', info.st_mtim.tv_nsec, ' ', info.st_ctim.tv_sec, '.', info.st_ctim.tv_nsec)
    local producer = producers[path]
    if producer ~= 0 then signature:write(' ', edges[producer].generation) end
  end
  edge.signature = signature:promote()
  if not exists then return true end
  local input = io.open(edge.output .. stamp_suffix, 'rb')
  if not input then return true end
  local previous = input:read('a')
  local closed = input:close()
  local newline = previous:find('\n', 1, true)
  if not closed or newline <= (@isize)(#record_prefix + 1) or
      previous:sub(1, #record_prefix) ~= record_prefix or previous:sub(newline + 1) ~= edge.signature then return true end
  edge.generation = previous:sub(#record_prefix + 1, newline - 1)
  return false
end

local function launch(edge: *Edge): cint
  local stamp = edge.output .. stamp_suffix
  -- Invalidate the previous completion record before starting the recipe.
  if sys.unlink(stamp) ~= 0 and sys.errno() ~= sys.ENOENT then fail(stamp .. ': ' .. sys.errstr()) end
  print(edge.command)
  io.stdout:flush()
  local pid = sys.fork()
  if pid == 0 then
    local argv: [4]cstring = {'sh', '-c', (@cstring)(edge.command), nilptr}
    sys.execvp('/bin/sh', (@*[0]cstring)(&argv))
    sys._exit(127)
  end
  return pid
end

local function record_completion(edge: *Edge)
  local info: sys.Stat
  if not file_status(edge.output, &info) or (info.st_mode & sys.S_IFMT) ~= sys.S_IFREG then
    fail('command did not produce file ' .. edge.output)
  end
  local stamp = edge.output .. stamp_suffix
  local output, reason = io.open(stamp, 'wb')
  if not output then fail(stamp .. ': ' .. reason) end
  edge.generation = build_generation()
  local written = output:write(record_prefix .. edge.generation .. '\n' .. edge.signature)
  local closed = output:close()
  if not written or not closed then
    sys.unlink(stamp)
    fail('cannot record command for ' .. edge.output)
  end
end

local function release(edge: *Edge, ready: *sequence(usize))
  for i: usize = 1, #edge.consumers do
    local consumer = edge.consumers[i]
    local next_edge = &edges[consumer]
    next_edge.waiting = next_edge.waiting - 1
    if next_edge.waiting == 0 then ready:push(consumer) end
  end
end

local function run(jobs: usize)
  local ready: sequence(usize)
  for i: usize = 1, #order do
    local index = order[i]
    if edges[index].waiting == 0 then ready:push(index) end
  end

  local children: hashmap(cint, usize)
  local head: usize = 1
  local failure: string
  while (head <= #ready and #failure == 0) or children.size > 0 do
    while head <= #ready and children.size < jobs and #failure == 0 do
      local index = ready[head]
      head = head + 1
      local edge = &edges[index]
      if needs_build(edge) then
        local pid = launch(edge)
        if pid < 0 then
          failure = 'cannot start ' .. edge.output .. ': ' .. sys.errstr()
        else
          children[pid] = index
        end
      else
        release(edge, &ready)
      end
    end
    if children.size > 0 then
      local status: cint
      local pid = sys.waitpid(-1, &status, 0)
      while pid < 0 and sys.errno() == sys.EINTR do pid = sys.waitpid(-1, &status, 0) end
      if pid < 0 then fail('wait: ' .. sys.errstr()) end
      local index = children[pid]
      children:remove(pid)
      local edge = &edges[index]
      if status == 0 then
        record_completion(edge)
        release(edge, &ready)
      elseif #failure == 0 then
        failure = 'command failed for ' .. edge.output
      end
    end
  end
  if #failure > 0 then fail(failure) end
end

local function job_count(value: string): usize
  local count: usize = 0
  for i: usize = 1, #value do
    local digit = value:byte(i)
    if digit < 48 or digit > 57 or count > ((@usize)(-1) - 9) // 10 then fail('invalid job count ' .. value) end
    count = count * 10 + (@usize)(digit - 48)
  end
  if count == 0 then fail('job count must be positive') end
  return count
end

local jobs: usize = 1
local manifest: usize = 1
if #arg >= 2 and arg[1] == '-j' then
  jobs = job_count(arg[2])
  manifest = 3
end
if #arg < manifest then fail('usage: nebuild [-j JOBS] MANIFEST [TARGET ...]') end
lock_build_directory()
read_manifest(arg[manifest])
if #arg > manifest then
  for i: usize = manifest + 1, #arg do plan(arg[i]) end
else
  if #defaults == 0 then fail('no default target') end
  for i: usize = 1, #defaults do plan(defaults[i]) end
end
run(jobs)
